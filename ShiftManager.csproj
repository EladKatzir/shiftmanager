<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- B-026: Enable XML documentation for Swagger API docs -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ShiftManager.Tests/**" />
    <Content Remove="ShiftManager.Tests/**" />
    <EmbeddedResource Remove="ShiftManager.Tests/**" />
    <None Remove="ShiftManager.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ShiftManager.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude ALL item types from output/build/temp directories to prevent
         .cs files in publish output (e.g. Data/SeedData/) from being compiled -->
    <Compile Remove="Backups/**" />
    <Compile Remove="FinalProductPublish/**" />
    <Compile Remove="ProjectPublish/**" />
    <Compile Remove="ProjectPublish_BACKUP_*/**" />
    <Compile Remove="ProductionReady/**" />
    <Compile Remove="TestPublish*/**" />
    <Compile Remove="TestPub*/**" />
    <Compile Remove="packages/**" />
    <Compile Remove=".claude/**" />
    <Compile Remove="docs/**" />
    <Compile Remove="logs/**" />
    <Content Remove="Backups/**" />
    <Content Remove="FinalProductPublish/**" />
    <Content Remove="ProjectPublish/**" />
    <Content Remove="ProjectPublish_BACKUP_*/**" />
    <Content Remove="ProductionReady/**" />
    <Content Remove="TestPublish*/**" />
    <Content Remove="TestPub*/**" />
    <Content Remove="packages/**" />
    <Content Remove=".claude/**" />
    <Content Remove="docs/**" />
    <Content Remove="logs/**" />
    <EmbeddedResource Remove="Backups/**" />
    <EmbeddedResource Remove="FinalProductPublish/**" />
    <EmbeddedResource Remove="ProjectPublish/**" />
    <EmbeddedResource Remove="ProjectPublish_BACKUP_*/**" />
    <EmbeddedResource Remove="ProductionReady/**" />
    <EmbeddedResource Remove="TestPublish*/**" />
    <EmbeddedResource Remove="TestPub*/**" />
    <EmbeddedResource Remove="packages/**" />
    <EmbeddedResource Remove=".claude/**" />
    <EmbeddedResource Remove="docs/**" />
    <EmbeddedResource Remove="logs/**" />
    <None Remove="Backups/**" />
    <None Remove="FinalProductPublish/**" />
    <None Remove="ProjectPublish/**" />
    <None Remove="ProjectPublish_BACKUP_*/**" />
    <None Remove="ProductionReady/**" />
    <None Remove="TestPublish*/**" />
    <None Remove="TestPub*/**" />
    <None Remove="packages/**" />
    <None Remove=".claude/**" />
    <None Remove="docs/**" />
    <None Remove="logs/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- B-026: Swagger/OpenAPI support -->
    <PackageReference Include="LigerShark.WebOptimizer.Core" Version="3.0.422" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <!-- Schedule Export & Print feature -->
    <PackageReference Include="QuestPDF" Version="2024.10.0" />
    <PackageReference Include="ClosedXML" Version="0.102.2" />
    <!-- Project-wide error-handling overhaul: structured logging with rolling-file persistence
         for air-gapped IIS deployments. Console + EventLog providers retained via Serilog sinks. -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.EventLog" Version="4.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.4" />
  </ItemGroup>
</Project>
