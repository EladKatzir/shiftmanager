{
  "App": {
    "BaseUrl": "http://localhost:5000"
  },
  "ConnectionStrings": {
    "Default": "Data Source=app.db"
  },
  "_SerilogComment": "Structured logging via Serilog. Program.cs uses UseSerilog(), which REPLACES Microsoft.Extensions.Logging — only the 'Serilog' section below is read at runtime. Do not re-add a 'Logging:LogLevel' block; it will be silently ignored. File sink is air-gap-safe rolling persistence under App_Data/logs/. EventLog sink only attaches on Windows.",
  "_LogLevelPolicy": "Override matching is longest-prefix on SourceContext. 'Microsoft' acts as a deny-by-default umbrella; opt specific Microsoft.* categories back in by adding a more-specific override.",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.EventLog" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "ShiftManager": "Information",
        "ShiftManager.Middleware": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "App_Data/logs/shiftmanager-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-ddTHH:mm:ss.fffzzz} [{Level:u3}] [{CorrelationId}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "EventLog",
        "Args": {
          "source": "ShiftManager",
          "logName": "Application",
          "manageEventSource": false,
          "restrictedToMinimumLevel": "Warning"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "_BackupComment": "Automated SQLite backup schedule. Directory is relative to app root. ScheduledTime in 24h UTC format.",
  "Backup": {
    "Directory": "Backups",
    "ScheduledTime": "03:00"
  },
  "_FeaturesComment_1": "IMPORTANT: This 'Features' section is LEGACY configuration. It is ONLY read for 'EnforceCompanyScope' (used by CompanyIdInterceptor due to Singleton/Scoped DI conflict).",
  "_FeaturesComment_2": "ALL OTHER feature flags (FF_EXCEL_CALENDARS, FF_API_ENABLED, etc.) are stored in the DATABASE and managed via Owner > Feature Flags page.",
  "_FeaturesComment_3": "The DB flags are seeded on first run by Data/SeedData/FeatureFlagSeed.cs (all enabled by default). To change them after first run, use the admin UI — NOT this file.",
  "Features": {
    "EnforceCompanyScope": true,
    "EnableDirectorRole": true,
    "EnforceRankEligibility": true,
    "AllowPublicSignup": true,
    "EnableApiKeyManagement": true,
    "EnableDailyNotifications": true,
    "ExcelCalendars": true,
    "ExcelCalendarShifts": true,
    "ExcelCalendarChores": true,
    "ExcelCalendarOnCall": true,
    "ExcelCalendarOverview": true,
    "FriendshipsEnabled": true,
    "EnableDutyRotation": true,
    "Api": {
      "Users": {
        "ListEnabled": true,
        "GetEnabled": true,
        "CreateEnabled": true,
        "UpdateEnabled": true
      },
      "Shifts": {
        "ListEnabled": true,
        "GetEnabled": true
      },
      "TimeOff": {
        "ListEnabled": true,
        "GetEnabled": true,
        "CreateEnabled": true,
        "ApproveEnabled": true,
        "DeclineEnabled": true
      },
      "Notifications": {
        "ListEnabled": true,
        "GetEnabled": true,
        "MarkReadEnabled": true,
        "MarkAllReadEnabled": true
      },
      "Analytics": {
        "SummaryEnabled": true
      },
      "AuditLogs": {
        "ListEnabled": true
      },
      "SwapRequests": {
        "ListEnabled": true,
        "GetEnabled": true,
        "CreateEnabled": true,
        "ApproveEnabled": true,
        "DeclineEnabled": true,
        "DeleteEnabled": true
      },
      "Chores": {
        "ListEnabled": true,
        "GetEnabled": true,
        "CreateEnabled": true,
        "UpdateEnabled": true,
        "DeleteEnabled": true
      },
      "OnDuty": {
        "ListEnabled": true,
        "GetEnabled": true,
        "CreateEnabled": true,
        "UpdateEnabled": true,
        "DeleteEnabled": true
      },
      "Feedback": {
        "ListEnabled": true,
        "GetEnabled": true,
        "CreateEnabled": true,
        "UpdateStatusEnabled": true,
        "DeleteEnabled": true
      }
    }
  },
  "_EmailComment": "SMTP-compatible email API; disabled by default for air-gapped environments. Set Enabled=true and configure ApiKey/ApiUrl for production.",
  "Email": {
    "Enabled": false,
    "ApiKey": "",
    "ApiUrl": "https://api.yourcompany.com/v1/mail/send",
    "FromAddress": "noreply@example.com"
  },
  "_GriffinComment": "Military SSO integration; set Enabled=true and configure URLs for production environments.",
  "Griffin": {
    "Enabled": false,
    "BaseUrl": "http://griffin-auth.example.mil",
    "TokenConsumerUrl": "http://localhost:5000/Auth/GriffinCallback",
    "AutoProvisionUsers": true,
    "DefaultProvisionedRole": "Employee",
    "TimeoutSeconds": 10
  },

  "_SeedingComment": "Configure database seeding below. Change Owner password for production!",
