{
  "ConnectionStrings": {
    "Default": "Data Source=app.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "Features": {
    "EnforceCompanyScope": true,
    "EnableDirectorRole": true,
    "AllowPublicSignup": true,
    "EnableApiKeyManagement": true,
    "Api": {
      "Users": {
        "ListEnabled": false,
        "GetEnabled": false,
        "CreateEnabled": false,
        "UpdateEnabled": false
      },
      "Shifts": {
        "ListEnabled": false,
        "GetEnabled": false
      },
      "TimeOff": {
        "ListEnabled": false,
        "GetEnabled": false,
        "CreateEnabled": false,
        "ApproveEnabled": false,
        "DeclineEnabled": false
      },
      "Notifications": {
        "ListEnabled": false,
        "GetEnabled": false,
        "MarkReadEnabled": false,
        "MarkAllReadEnabled": false
      },
      "Analytics": {
        "SummaryEnabled": false
      },
      "AuditLogs": {
        "ListEnabled": false
      }
    }
  },
  "Email": {
    "Enabled": false,
    "ApiKey": "",
    "ApiUrl": "https://api.yourcompany.com/v1/mail/send",
    "FromAddress": "noreply@example.com"
  }
}
