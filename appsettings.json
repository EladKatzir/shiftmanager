{
  "App": {
    "BaseUrl": "http://localhost:5000"
  },
  "ConnectionStrings": {
    "Default": "Data Source=app.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ShiftManager": "Information",
      "ShiftManager.Middleware": "Information"
    }
  },
  "AllowedHosts": "*",
  "_BackupComment": "Automated SQLite backup schedule. Directory is relative to app root. ScheduledTime in 24h UTC format.",
  "Backup": {
    "Directory": "Backups",
    "RetentionDays": 7,
    "ScheduledTime": "03:00"
  },
  "_FeaturesComment": "Fallback values; authoritative source is IFeatureFlagService (DB-backed) after Section 1 migration. CompanyIdInterceptor still reads EnforceCompanyScope from here.",
  "Features": {
    "EnforceCompanyScope": true,
    "EnableDirectorRole": true,
    "EnforceRankEligibility": true,
    "AllowPublicSignup": true,
    "EnableApiKeyManagement": true,
    "EnableDailyNotifications": true,
    "ExcelCalendars": true,
    "ExcelCalendarShifts": true,
    "ExcelCalendarChores": true,
    "ExcelCalendarOnCall": true,
    "ExcelCalendarOverview": true,
    "FriendshipsEnabled": true,
    "EnableDutyRotation": true,
    "Api": {
      "Users": {
        "ListEnabled": true,
        "GetEnabled": true,
        "CreateEnabled": true,
        "UpdateEnabled": true
      },
      "Shifts": {
        "ListEnabled": true,
        "GetEnabled": true
      },
      "TimeOff": {
        "ListEnabled": true,
        "GetEnabled": true,
        "CreateEnabled": true,
        "ApproveEnabled": true,
        "DeclineEnabled": true
      },
      "Notifications": {
        "ListEnabled": true,
        "GetEnabled": true,
        "MarkReadEnabled": true,
        "MarkAllReadEnabled": true
      },
      "Analytics": {
        "SummaryEnabled": true
      },
      "AuditLogs": {
        "ListEnabled": true
      },
      "SwapRequests": {
        "ListEnabled": true,
        "GetEnabled": true,
        "CreateEnabled": true,
        "ApproveEnabled": true,
        "DeclineEnabled": true,
        "DeleteEnabled": true
      },
      "Chores": {
        "ListEnabled": true,
        "GetEnabled": true,
        "CreateEnabled": true,
        "UpdateEnabled": true,
        "DeleteEnabled": true
      },
      "OnDuty": {
        "ListEnabled": true,
        "GetEnabled": true,
        "CreateEnabled": true,
        "UpdateEnabled": true,
        "DeleteEnabled": true
      },
      "Feedback": {
        "ListEnabled": true,
        "GetEnabled": true,
        "CreateEnabled": true,
        "UpdateStatusEnabled": true,
        "DeleteEnabled": true
      }
    }
  },
  "_EmailComment": "SMTP-compatible email API; disabled by default for air-gapped environments. Set Enabled=true and configure ApiKey/ApiUrl for production.",
  "Email": {
    "Enabled": false,
    "ApiKey": "",
    "ApiUrl": "https://api.yourcompany.com/v1/mail/send",
    "FromAddress": "noreply@example.com"
  },
  "_GriffinComment": "Military SSO integration; set Enabled=true and configure URLs for production environments.",
  "Griffin": {
    "Enabled": false,
    "BaseUrl": "http://griffin-auth.example.mil",
    "TokenConsumerUrl": "http://localhost:5000/Auth/GriffinCallback",
    "AutoProvisionUsers": true,
    "DefaultProvisionedRole": "Employee",
    "TimeoutSeconds": 10
  },

  "_SeedingComment": "Configure database seeding below. Change Owner password for production!",
  "Seeding": {
    "Owner": {
      "Email": "admin@local",
      "Password": "admin123",
      "DisplayName": "מנהל מערכת"
    },
    "AdditionalMolecules": [],
    "AdditionalCompanies": [],
    "AdditionalDepartments": []
  }
}
