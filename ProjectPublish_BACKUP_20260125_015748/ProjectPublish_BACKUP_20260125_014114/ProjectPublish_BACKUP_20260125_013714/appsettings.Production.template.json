{
  // ============================================================================
  // ShiftManager Production Configuration Template
  // ============================================================================
  // Copy this file to 'appsettings.Production.json' and update with your values
  // DO NOT commit appsettings.Production.json to version control!
  // ============================================================================

  "ConnectionStrings": {
    // Production database connection string
    // For SQLite: "Data Source=/path/to/production.db"
    // For PostgreSQL: "Host=localhost;Database=shiftmanager;Username=myuser;Password=mypass"
    // For SQL Server: "Server=localhost;Database=shiftmanager;User Id=sa;Password=mypass"
    "Default": "Data Source=/var/lib/shiftmanager/production.db"
  },

  "Logging": {
    "LogLevel": {
      // Production logging levels - reduce noise
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  // Allowed hosts for production (comma-separated)
  // Example: "yourcompany.com,www.yourcompany.com,shiftmanager.yourcompany.com"
  "AllowedHosts": "*",

  "Features": {
    // Enforce company scope filtering (recommended: true for production)
    "EnforceCompanyScope": true,

    // Enable director role functionality
    "EnableDirectorRole": true,

    // Allow public user signup (set false for invite-only)
    "AllowPublicSignup": false,

    // Enable API key management features
    "EnableApiKeyManagement": true,

    // Enable background job for daily email notifications (set false to disable if email service fails)
    "EnableDailyNotifications": true,

    // API endpoint feature flags
    "Api": {
      "Users": {
        "ListEnabled": true,
        "GetEnabled": true,
        "CreateEnabled": true,
        "UpdateEnabled": true
      },
      "Shifts": {
        "ListEnabled": true,
        "GetEnabled": true
      },
      "TimeOff": {
        "ListEnabled": true,
        "GetEnabled": true,
        "CreateEnabled": true,
        "ApproveEnabled": true,
        "DeclineEnabled": true
      },
      "Notifications": {
        "ListEnabled": true,
        "GetEnabled": true,
        "MarkReadEnabled": true,
        "MarkAllReadEnabled": true
      },
      "Analytics": {
        "SummaryEnabled": true
      },
      "AuditLogs": {
        "ListEnabled": true
      }
    }
  },

  // ============================================================================
  // EMAIL CONFIGURATION
  // ============================================================================
  // NOTE: Database configuration (per-company) takes precedence over this.
  // Use the Admin Config UI (https://yourapp.com/Admin/Config) to configure
  // email settings per company with encrypted API keys.
  //
  // This configuration serves as a fallback if database config is not set.
  //
  // RECOMMENDED APPROACH:
  // - For single-tenant: Use environment variables (see below)
  // - For multi-tenant: Use Admin Config UI for per-company settings
  // ============================================================================

  "Email": {
    // Enable email notifications (true/false)
    "Enabled": true,

    // API Key for email service authentication
    // SECURITY: Use environment variable instead: EMAIL__APIKEY
    // Example: export EMAIL__APIKEY="your-production-key-here"
    "ApiKey": "",

    // Email API endpoint URL
    // Can also use environment variable: EMAIL__APIURL
    "ApiUrl": "https://api.yourcompany.com/v1/mail/send",

    // From email address for outgoing emails
    // Can also use environment variable: EMAIL__FROMADDRESS
    "FromAddress": "noreply@yourcompany.com"
  }

  // ============================================================================
  // ENVIRONMENT VARIABLE CONFIGURATION (RECOMMENDED FOR PRODUCTION)
  // ============================================================================
  // Set these environment variables instead of hardcoding sensitive values:
  //
  // Linux/macOS:
  //   export EMAIL__ENABLED=true
  //   export EMAIL__APIKEY="your-api-key-here"
  //   export EMAIL__APIURL="https://api.yourcompany.com/v1/mail/send"
  //   export EMAIL__FROMADDRESS="noreply@yourcompany.com"
  //   export CONNECTIONSTRINGS__DEFAULT="Data Source=/var/lib/shiftmanager/production.db"
  //
  // Windows:
  //   set EMAIL__ENABLED=true
  //   set EMAIL__APIKEY=your-api-key-here
  //   set EMAIL__APIURL=https://api.yourcompany.com/v1/mail/send
  //   set EMAIL__FROMADDRESS=noreply@yourcompany.com
  //   set CONNECTIONSTRINGS__DEFAULT=Data Source=C:\ShiftManager\production.db
  //
  // Docker:
  //   docker run -e EMAIL__ENABLED=true \
  //              -e EMAIL__APIKEY="your-api-key-here" \
  //              -e EMAIL__APIURL="https://api.yourcompany.com/v1/mail/send" \
  //              -e EMAIL__FROMADDRESS="noreply@yourcompany.com" \
  //              yourimage
  //
  // Kubernetes Secret:
  //   apiVersion: v1
  //   kind: Secret
  //   metadata:
  //     name: shiftmanager-config
  //   stringData:
  //     EMAIL__APIKEY: "your-api-key-here"
  //     EMAIL__APIURL: "https://api.yourcompany.com/v1/mail/send"
  // ============================================================================
}
