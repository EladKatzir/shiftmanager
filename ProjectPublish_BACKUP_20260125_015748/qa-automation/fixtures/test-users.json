{
  "description": "Test user credentials for ShiftManager QA automation",
  "note": "SECURITY: Actual passwords should be stored in environment variables. See .env.example for setup.",
  "envVarMapping": {
    "owner": {"email": "OWNER_EMAIL", "password": "OWNER_PASSWORD"},
    "director": {"email": "DIRECTOR_EMAIL", "password": "DIRECTOR_PASSWORD"},
    "manager": {"email": "MANAGER_EMAIL", "password": "MANAGER_PASSWORD"},
    "assigner": {"email": "ASSIGNER_EMAIL", "password": "ASSIGNER_PASSWORD"},
    "employee": {"email": "EMPLOYEE_EMAIL", "password": "EMPLOYEE_PASSWORD"},
    "trainee": {"email": "TRAINEE_EMAIL", "password": "TRAINEE_PASSWORD"}
  },
  "users": {
    "owner": {
      "email": "owner@test.com",
      "passwordEnvVar": "OWNER_PASSWORD",
      "role": "Owner",
      "displayName": "Owner",
      "permissions": [
        "all"
      ]
    },
    "director": {
      "email": "director@local",
      "passwordEnvVar": "DIRECTOR_PASSWORD",
      "role": "Director",
      "displayName": "Test Director",
      "permissions": [
        "cross-company-view",
        "view-as-manager",
        "admin-hub"
      ],
      "prerequisites": {
        "featureFlag": "EnableDirectorRole",
        "value": true
      }
    },
    "manager": {
      "email": "manager@test.local",
      "passwordEnvVar": "MANAGER_PASSWORD",
      "role": "Manager",
      "displayName": "Test Manager",
      "permissions": [
        "admin-hub",
        "user-management",
        "shift-management"
      ],
      "creationMethod": "manual",
      "notes": "Create via /Admin/Users as Owner"
    },
    "assigner": {
      "email": "assigner@test.local",
      "passwordEnvVar": "ASSIGNER_PASSWORD",
      "role": "Assigner",
      "displayName": "Test Assigner",
      "permissions": [
        "edit-chores",
        "edit-shifts"
      ],
      "creationMethod": "manual",
      "notes": "Create via /Admin/Users as Manager or Owner"
    },
    "employee": {
      "email": "employee@test.local",
      "passwordEnvVar": "EMPLOYEE_PASSWORD",
      "role": "Employee",
      "displayName": "Test Employee",
      "permissions": [
        "view-own-schedule",
        "create-requests",
        "view-public"
      ],
      "creationMethod": "signup",
      "notes": "Create via /Auth/Signup (requires AllowPublicSignup=true)"
    },
    "trainee": {
      "email": "trainee@test.local",
      "passwordEnvVar": "TRAINEE_PASSWORD",
      "role": "Trainee",
      "displayName": "Test Trainee",
      "permissions": [
        "view-own-schedule",
        "view-public"
      ],
      "creationMethod": "manual",
      "notes": "Create via /Admin/Users as Manager or Owner"
    }
  },
  "testCompanies": {
    "primary": {
      "id": 1,
      "name": "Default Company",
      "slug": "default"
    },
    "secondary": {
      "name": "Test Corp",
      "slug": "test-corp",
      "displayName": "Test Corporation",
      "notes": "Created automatically when EnableDirectorRole=true"
    }
  }
}
