@model ShiftManager.Models.ViewModels.DecisionRibbonViewModel
@using ShiftManager.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer

@* Decision Ribbon - Signature Phase 1 feature showing pending approvals *@
<div class="decision-ribbon">
    <a href="/Requests" class="decision-ribbon-btn @(Model.PendingCount > 0 ? "has-pending" : "")" loc-title="@(Model.PendingCount > 0 ? "DecisionRibbon_ActionRequired" : "DecisionRibbon_AllClear")">
        @if (Model.PendingCount > 0)
        {
            <span class="ribbon-badge" loc-aria-label="DecisionRibbon_PendingCount">@Model.PendingCount</span>
            <span><loc key="DecisionRibbon_ActionRequired" /></span>
        }
        else
        {
            <span>✓ <loc key="DecisionRibbon_AllClear" /></span>
        }
    </a>
</div>
