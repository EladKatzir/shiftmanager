@model List<string>

@if (Model.Count > 0)
{
    <div class="system-alerts" style="position: sticky; top: 0; z-index: 1050;">
        @foreach (var alert in Model)
        {
            var isCritical = alert.StartsWith("CRITICAL:");
            var isSecurity = alert.StartsWith("SECURITY:");
            var isDismissable = !isCritical && !isSecurity;
            var bgColor = isCritical || isSecurity ? "var(--danger, #dc3545)" : "var(--warning, #ffc107)";
            var textColor = isCritical || isSecurity ? "white" : "black";

            <div class="system-alert-item" style="padding: 0.5rem 1rem; background: @bgColor; color: @textColor; font-size: 0.85rem; text-align: center; border-bottom: 1px solid rgba(0,0,0,0.1); position: relative;">
                @alert
                @if (isDismissable)
                {
                    <button type="button" onclick="this.parentElement.remove(); if(!document.querySelector('.system-alert-item')) this.closest('.system-alerts')?.remove();"
                            style="position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); background: none; border: none; color: @textColor; cursor: pointer; font-size: 1.1rem; line-height: 1; padding: 0.25rem; opacity: 0.7;"
                            onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.7'"
                            aria-label="Dismiss">×</button>
                }
            </div>
        }
    </div>
}
