@model ShiftManager.ViewComponents.OwnerCompanySelectorViewModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@inject IStringLocalizer<SharedResources> Localizer

@if (Model.Companies.Any())
{
    <div class="owner-company-selector" style="margin-bottom: 1rem; padding: 0.75rem; background: var(--surface); border: 1px solid var(--border); border-radius: 8px;">
        <form method="post" action="/Owner/SelectCompany" style="display: flex; align-items: center; gap: 0.5rem;">
            @Html.AntiForgeryToken()
            <label style="font-weight: 600; color: var(--text); display: flex; align-items: center; gap: 0.5rem;">
                <span style="font-size: 1.25rem;">🏢</span>
                <span><loc key="OwnerSelector_ManagingCompany" /></span>
            </label>

            <select name="companyId"
                    onchange="this.form.submit()"
                    style="flex: 1; padding: 0.5rem; border: 1px solid var(--border); border-radius: 4px; background: var(--background); color: var(--text); font-size: 0.9rem;">
                @foreach (var company in Model.Companies)
                {
                    var isHome = company.Id == Model.HomeCompanyId;
                    var isSelected = company.Id == Model.SelectedCompanyId;
                    var displayName = company.Name + (isHome ? $" {Localizer["OwnerSelector_Home"]}" : "");

                    <option value="@company.Id" selected="@isSelected">
                        @displayName
                    </option>
                }
            </select>

            @if (Model.SelectedCompanyId.HasValue && Model.SelectedCompanyId != Model.HomeCompanyId)
            {
                <button type="submit"
                        formaction="/Owner/ClearCompanySelection"
                        style="padding: 0.5rem 0.75rem; background: var(--danger); color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 600;"
                        loc-title="OwnerSelector_ClearSelectionTooltip">
                    ✕
                </button>
            }
        </form>
    </div>
}
