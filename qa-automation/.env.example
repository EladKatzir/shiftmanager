# ShiftManager QA Automation Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env files to source control

# Application URL
APP_URL=http://localhost:5000

# =============================================================================
# Legacy Test Users (from TestDataSeeder.cs)
# These are the original test users - use E2E Test Users for new tests
# =============================================================================

# Owner credentials (highest privilege level)
OWNER_EMAIL=admin@local
OWNER_PASSWORD=admin123

# Director credentials
DIRECTOR_EMAIL=director@local
DIRECTOR_PASSWORD=director123

# Manager credentials
MANAGER_EMAIL=manager@test.local
MANAGER_PASSWORD=Manager123!

# Assigner credentials
ASSIGNER_EMAIL=assigner@test.local
ASSIGNER_PASSWORD=Assigner123!

# Employee credentials
EMPLOYEE_EMAIL=employee@test.local
EMPLOYEE_PASSWORD=Employee123!

# Trainee credentials
TRAINEE_EMAIL=trainee@test.local
TRAINEE_PASSWORD=Trainee123!

# =============================================================================
# E2E Test Users (from TestDataSeed.cs - B-041)
# These are the recommended test users for new Playwright E2E tests
# See docs/TEST-DATA.md for the full test data strategy
# =============================================================================

# E2E Test Owner - Full system access
TEST_OWNER_EMAIL=test.owner@shifty.test
TEST_OWNER_PASSWORD=TestOwner123!

# E2E Test Director - Multi-company access
TEST_DIRECTOR_EMAIL=test.director@shifty.test
TEST_DIRECTOR_PASSWORD=TestDirector123!

# E2E Test Manager - Single company management
TEST_MANAGER_EMAIL=test.manager@shifty.test
TEST_MANAGER_PASSWORD=TestManager123!

# E2E Test Member - Personal calendar access
TEST_MEMBER_EMAIL=test.member@shifty.test
TEST_MEMBER_PASSWORD=TestMember123!

# E2E Test Assigner - Shift/chore assignment
TEST_ASSIGNER_EMAIL=test.assigner@shifty.test
TEST_ASSIGNER_PASSWORD=TestAssigner123!

# E2E Test NoGrants - Minimal permissions (edge case)
TEST_NOGRANTS_EMAIL=test.nogrants@shifty.test
TEST_NOGRANTS_PASSWORD=TestNoGrants123!
