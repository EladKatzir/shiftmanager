@page "{code:int}"
@model StatusCodeModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Code == 404
        ? Localizer["Error_PageNotFound"].Value
        : Localizer["Error_GenericTitle"].Value;
}

<div class="card" style="max-width: 600px; margin: 2rem auto; text-align: center; padding: 2rem;">
    <div style="font-size: 4rem; font-weight: 700; color: var(--text-muted); margin-bottom: 1rem;">
        @Model.Code
    </div>
    @if (Model.Code == 404)
    {
        <h2><loc key="Error_PageNotFound">Page Not Found</loc></h2>
        <p style="color: var(--text-muted); margin-bottom: 1.5rem;">
            <loc key="Error_PageNotFoundDesc">The page you're looking for doesn't exist or has been moved.</loc>
        </p>
    }
    else if (Model.Code == 403)
    {
        <h2><loc key="Error_Forbidden">Access Denied</loc></h2>
        <p style="color: var(--text-muted); margin-bottom: 1.5rem;">
            <loc key="Error_ForbiddenDesc">You don't have permission to access this page.</loc>
        </p>
    }
    else
    {
        <h2><loc key="Error_GenericTitle">Something Went Wrong</loc></h2>
        <p style="color: var(--text-muted); margin-bottom: 1.5rem;">
            <loc key="Error_GenericDesc">An unexpected error occurred. Please try again.</loc>
        </p>
    }
    <a href="/" class="btn btn-primary" style="margin-bottom: 1.5rem;">
        <loc key="Error_BackToHome">Back to Home</loc>
    </a>

    @* Diagnostic info for unexpected status codes (visible to admins/developers) *@
    @if (Model.Code != 404 && Model.Code != 403)
    {
        <details style="margin-top: 1rem; text-align: left; font-size: 0.8rem; color: var(--text-muted);">
            <summary style="cursor: pointer; margin-bottom: 0.5rem;"><loc key="Error_DiagnosticInfo">Diagnostic Info</loc></summary>
            <div style="background: var(--surface-soft); padding: 0.75rem; border-radius: 0.5rem; font-family: monospace; word-break: break-all;">
                <div><strong>@Localizer["Diagnostic_Status"]:</strong> @Model.Code</div>
                <div><strong>@Localizer["Diagnostic_Time"]:</strong> @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss") UTC</div>
                <div><strong>@Localizer["Diagnostic_Path"]:</strong> @HttpContext.Request.Headers["Referer"].ToString()</div>
                <div><strong>@Localizer["Diagnostic_Method"]:</strong> @HttpContext.Request.Method</div>
                @if (User?.Identity?.IsAuthenticated == true)
                {
                    <div><strong>@Localizer["Diagnostic_User"]:</strong> @User.Identity.Name</div>
                }
            </div>
        </details>
    }
</div>
