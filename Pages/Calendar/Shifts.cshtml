@page
@model ShiftManager.Pages.Calendar.ShiftsModel
@using ShiftManager.ViewComponents
@using ShiftManager.Pages.Shared
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@inject IStringLocalizer<SharedResources> Localizer
@inject ShiftManager.Services.ILocalizationService Localization
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["ShiftsCalendar"];
    // Distribution-list filter param, appended to hand-built nav links so the selection persists across
    // week navigation / mode toggles (the JS navigators already preserve it via URLSearchParams).
    var dlParam = string.IsNullOrEmpty(Model.DistributionListIds)
        ? ""
        : $"&DistributionListIds={Uri.EscapeDataString(Model.DistributionListIds)}";
    // Calendar tab (לשונית) param, appended to hand-built nav links so the active tab persists across
    // week navigation / mode toggles. Only emitted when the molecule actually has tabs; Tab=0 = "Main".
    var tabParam = Model.AvailableTabs.Any() ? $"&Tab={Model.Tab ?? 0}" : "";
}

@* Breadcrumb *@
@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Calendars"], Url = "/Calendar/Month" },
    new BreadcrumbItem { Label = Localizer["ShiftsCalendar"], IsActive = true }
})

<div class="cal-page @(Model.DraftMode && Model.ActiveDraftId != null ? "cal-page--draft" : "")" data-ui-version="v2">
    @* Toolbar — Row 1: Selectors + Date Nav + Print *@
    <div class="cal-toolbar">
        <div class="cal-toolbar__row">
            <div class="cal-toolbar__selector cal-toolbar__primary">
                <label for="moleculeSelect">@Localizer["Molecule"]</label>
                <select id="moleculeSelect" class="form-select" onchange="updateCalendarFilters()">
                    @foreach (var molecule in Model.AvailableMolecules)
                    {
                        var isSelected = molecule.Id == Model.MoleculeId;
                        <option value="@molecule.Id" selected="@isSelected">@molecule.DisplayName</option>
                    }
                </select>
            </div>

            @if (!Model.IsTechMolecule)
            {
            <div class="cal-toolbar__selector">
                <label for="jobTypeSelect">@Localizer["JobType"]</label>
                <select id="jobTypeSelect" class="form-select" onchange="updateCalendarFilters()">
                    @foreach (var jobType in Model.AvailableJobTypes)
                    {
                        var isSelected = jobType.Id == Model.JobTypeId;
                        <option value="@jobType.Id" selected="@isSelected">@jobType.DisplayName</option>
                    }
                </select>
            </div>
            }

            <div class="cal-toolbar__selector cal-toolbar__primary">
                <label for="viewModeSelect">@Localizer["ViewMode"]</label>
                <select id="viewModeSelect" class="form-select" onchange="updateCalendarFilters()">
                    <option value="week" selected="@(Model.ViewMode == "week")">@Localizer["Week"]</option>
                    <option value="next7" selected="@(Model.ViewMode == "next7")">@Localizer["Next7Days"]</option>
                    <option value="2weeks" selected="@(Model.ViewMode == "2weeks")">@Localizer["TwoWeeks"]</option>
                    <option value="month" selected="@(Model.ViewMode == "month")">@Localizer["Month"]</option>
                </select>
            </div>

            <div class="cal-toolbar__date-nav cal-toolbar__primary">
                <a href="?MoleculeId=@Model.MoleculeId&JobTypeId=@Model.JobTypeId&Start=@Model.PreviousStart&ViewMode=@Model.ViewMode&Mode=@Model.Mode@dlParam@(tabParam)"
                   class="btn btn-ghost cal-toolbar__nav-btn"
                   data-cal-nav="prev"
                   title="@Localizer["Previous"]">
                    <span class="nav-icon">&larr;</span>
                    <span class="nav-text">@Localizer["Previous"]</span>
                </a>

                <div class="cal-toolbar__date-display">
                    <input type="date"
                           id="datePickerInput"
                           value="@Model.StartDate.ToString("yyyy-MM-dd")"
                           onclick="if(this.showPicker)this.showPicker()"
                           onchange="navigateToDate(this.value)"
                           class="cal-toolbar__date-picker" />
                    <span class="cal-toolbar__date-label">
                        @Localization.FormatMediumDate(Model.StartDate) - @Localization.FormatMediumDate(Model.EndDate)
                    </span>
                </div>

                <a href="?MoleculeId=@Model.MoleculeId&JobTypeId=@Model.JobTypeId&Start=@Model.NextStart&ViewMode=@Model.ViewMode&Mode=@Model.Mode@dlParam@(tabParam)"
                   class="btn btn-ghost cal-toolbar__nav-btn"
                   data-cal-nav="next"
                   title="@Localizer["Next"]">
                    <span class="nav-text">@Localizer["Next"]</span>
                    <span class="nav-icon">&rarr;</span>
                </a>
            </div>

            <button type="button" class="btn btn-secondary cal-toolbar__print" onclick="window.print()" title="@Localizer["Print"]">
                <span class="btn-icon"><icon name="printer" /></span>
                <span class="btn-text">@Localizer["Print"]</span>
            </button>

            @* Justice — in-context analytics drawer (Phase 2). Renders BOTH a toolbar button
               (in-place) AND a fixed-position drawer (out-of-flow). The button is gated by
               <require-grant key="ViewJusticeTable"> inside the partial. *@
            @{
                var justicePanelModel = new ShiftManager.Pages.Shared.JusticePanelModel
                {
                    CalendarKind = "shifts",
                    DataEndpoint = $"/Calendar/Shifts?handler=Justice&MoleculeId={Model.MoleculeId}&JobTypeId={Model.JobTypeId}&Start={Model.StartDate:yyyy-MM-dd}",
                    ButtonTitle = Localizer["Justice_Panel_Button"].Value,
                    RibbonAria = Localizer["Justice_EquityRibbon_Aria"].Value,
                    CloseLabel = Localizer["Justice_Panel_Close"].Value
                };
            }
            <partial name="_JusticePanel" model="justicePanelModel" />

            @* Mobile-only Tools overflow trigger — surfaces controls hidden at <768px. *@
            <button type="button"
                    class="btn btn-ghost cal-toolbar__overflow-trigger"
                    loc-aria-label="Calendar_Tools_Overflow_AriaLabel"
                    onclick="window.CalendarToolsOverflow && window.CalendarToolsOverflow.open()">
                <loc key="Calendar_Tools_Overflow_Label" />
                <span aria-hidden="true">▾</span>
            </button>
        </div>

        @* Row 2: Mode toggles + Filter + Just Mine *@
        <div class="cal-toolbar__controls">
            <div class="cal-toolbar__toggle-group">
                @* @(dlParam) — NOT @dlParam: "Mode=shift@dlParam" trips Razor's email-address heuristic
                   (alphanumeric@alphanumeric), so @dlParam would render literally and Mode would bind as
                   "shift@dlParam"/"user@dlParam" — matching neither branch and leaving the calendar stuck on
                   by-shift. The parenthesised form forces a code transition. (Issue 2) *@
                <a href="?MoleculeId=@Model.MoleculeId&JobTypeId=@Model.JobTypeId&Start=@Model.StartDate.ToString("yyyy-MM-dd")&ViewMode=@Model.ViewMode&Mode=shift@(dlParam)@(tabParam)"
                   class="btn @(Model.Mode == "shift" ? "btn-primary" : "btn-ghost")">
                    @Localizer["ByShift"]
                </a>
                <a href="?MoleculeId=@Model.MoleculeId&JobTypeId=@Model.JobTypeId&Start=@Model.StartDate.ToString("yyyy-MM-dd")&ViewMode=@Model.ViewMode&Mode=user@(dlParam)@(tabParam)"
                   class="btn @(Model.Mode == "user" ? "btn-primary" : "btn-ghost")">
                    @Localizer["ByUser"]
                </a>
            </div>

            @if (Model.CalendarData.Groups != null)
            {
                <div class="group-toggle-buttons" style="display: inline-flex; gap: var(--space-1); margin-inline-start: var(--space-2);">
                    <button type="button" class="btn btn--sm btn--outline" onclick="collapseAllGroups()">
                        <span>&#9650;</span> @Localizer["CollapseAll"]
                    </button>
                    <button type="button" class="btn btn--sm btn--outline" onclick="expandAllGroups()">
                        <span>&#9660;</span> @Localizer["ExpandAll"]
                    </button>
                </div>
            }

            @if (Model.CanEdit)
            {
                <div class="cal-toolbar__toggle-group">
                    <a href="?MoleculeId=@Model.MoleculeId&JobTypeId=@Model.JobTypeId&Start=@Model.StartDate.ToString("yyyy-MM-dd")&ViewMode=@Model.ViewMode&Mode=@Model.Mode&CapacityMode=@(!Model.CapacityMode)@dlParam@(tabParam)"
                       class="btn @(Model.CapacityMode ? "btn-primary" : "btn-ghost")">
                        @Localizer["CapacityMode"]
                    </a>
                </div>
            }

            <span class="cal-toolbar__separator"></span>

            <div class="cal-toolbar__toggle-group">
                <button type="button" class="btn btn-ghost" onclick="openFilterModal()">
                    <span class="btn-icon"><icon name="search" /></span>
                    @Localizer["Filter"]
                </button>
                <a href="?MoleculeId=@Model.MoleculeId&JobTypeId=@Model.JobTypeId&Start=@Model.StartDate.ToString("yyyy-MM-dd")&ViewMode=@Model.ViewMode&Mode=@Model.Mode&JustMine=@(!Model.JustMine)@dlParam@(tabParam)"
                   class="btn @(Model.JustMine ? "btn-primary" : "btn-ghost")">
                    @Localizer["JustMine"]
                </a>
            </div>

            @* Draft Mode controls (Epic 4) — assigners can stage roster changes privately, then commit. *@
            @if (Model.CanEdit && Model.MoleculeId.HasValue)
            {
                <span class="cal-toolbar__separator"></span>
                <div class="cal-toolbar__toggle-group">
                    @if (!Model.DraftMode || Model.ActiveDraftId == null)
                    {
                        <button type="button" class="btn btn-ghost" id="enterDraftBtn"
                                data-molecule-id="@Model.MoleculeId" data-job-type-id="@(Model.JobTypeId?.ToString() ?? "")"
                                data-week-start="@Model.StartDate.ToString("yyyy-MM-dd")" data-week-end="@Model.EndDate.ToString("yyyy-MM-dd")">
                            <span class="btn-icon"><icon name="pencil" /></span>
                            @Localizer["Draft_Enter"]
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary" id="commitDraftBtn" data-draft-id="@Model.ActiveDraftId">
                            <span class="btn-icon"><icon name="check" /></span>
                            @Localizer["Draft_Commit"]
                        </button>
                        <button type="button" class="btn btn-ghost" id="discardDraftBtn" data-draft-id="@Model.ActiveDraftId">
                            @Localizer["Draft_Discard"]
                        </button>
                    }
                </div>
            }

            @* Distribution Lists control — by-user view only. The dropdown (filter) is open to everyone;
               the "+" manage button is gated by CanManageLists. Selection persists via DistributionListIds.
               Phase 3.1: the תפוצות button is hidden because the feature is currently inactive.
               To re-enable, change the condition below back to: @@(Model.Mode == "user"). *@
            @if (false)
            {
                <span class="cal-toolbar__separator"></span>
                <div class="cal-toolbar__toggle-group dl-control" id="dlControl" data-molecule-id="@Model.MoleculeId">
                    <div class="dl-dropdown">
                        <button type="button" id="dlDropdownToggle"
                                class="btn @(Model.SelectedDistributionListIds.Any() ? "btn-primary" : "btn-ghost")"
                                aria-haspopup="true" aria-expanded="false"
                                onclick="window.DistributionLists && window.DistributionLists.toggleDropdown()">
                            <span class="btn-icon"><icon name="users" /></span>
                            <loc key="DistributionLists" />
                            @if (Model.SelectedDistributionListIds.Any())
                            {
                                <span class="dl-badge">@Model.SelectedDistributionListIds.Count</span>
                            }
                        </button>
                        <div class="dl-dropdown__menu" id="dlDropdownMenu" hidden>
                            @if (Model.AvailableDistributionLists.Any())
                            {
                                <div class="dl-dropdown__list">
                                    @foreach (var list in Model.AvailableDistributionLists)
                                    {
                                        <label class="dl-dropdown__item">
                                            <input type="checkbox" class="dl-checkbox" value="@list.Id"
                                                   @(Model.SelectedDistributionListIds.Contains(list.Id) ? "checked" : "") />
                                            <span class="dl-dropdown__item-name">@list.Name</span>
                                            <span class="dl-dropdown__item-count">@string.Format(Localizer["DistributionList_MemberCount"].Value, list.MemberCount)</span>
                                        </label>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="dl-dropdown__empty"><loc key="DistributionList_NoLists" /></p>
                            }
                            <div class="dl-dropdown__footer">
                                <button type="button" class="btn btn-ghost btn--sm"
                                        onclick="window.DistributionLists && window.DistributionLists.clearSelection()">
                                    <loc key="DistributionList_Clear" />
                                </button>
                                <button type="button" class="btn btn-primary btn--sm"
                                        onclick="window.DistributionLists && window.DistributionLists.applySelection()">
                                    <loc key="DistributionList_Apply" />
                                </button>
                            </div>
                        </div>
                    </div>
                    @if (Model.CanManageLists)
                    {
                        <button type="button" class="btn btn-ghost dl-manage-btn"
                                onclick="window.DistributionLists && window.DistributionLists.openManager()"
                                loc-title="DistributionList_Manage" loc-aria-label="DistributionList_Manage">
                            <span class="btn-icon">+</span>
                        </button>
                    }
                </div>
            }

            @if (Model.CanWriteNote)
            {
                <button type="button" id="quickEntryToggle" class="btn btn-ghost quick-entry-toggle"
                        data-can-assign="@Model.CanEdit.ToString().ToLowerInvariant()"
                        onclick="window.CalendarQuickEntry && window.CalendarQuickEntry.toggle()"
                        title="@Localizer["QuickEntry_Toggle"]">
                    <span class="btn-icon"><icon name="zap" /></span>
                    <loc key="QuickEntry_Toggle" />
                </button>
                <button type="button" id="quickEntryHelp" class="btn btn-ghost quick-entry-help-btn"
                        onclick="window.CalendarQuickEntry && window.CalendarQuickEntry.showHelp()"
                        loc-title="QuickEntry_HelpTitle"
                        loc-aria-label="QuickEntry_HelpTitle">
                    <span class="btn-icon">?</span>
                </button>
            }
        </div>
    </div>

    @* Sticky readonly banner — pinned as second tier below the toolbar.
       Moved OUT of the ExcelCalendarTable component so it lives in .cal-page
       scope and can stick relative to the page, not the calendar viewport. *@
    <partial name="_CalendarReadonlyBanner" model="@(new CalendarReadonlyBannerModel
    {
        IsReadOnly = Model.CalendarData.IsReadOnly,
        RequiredGrantNameKeys = Model.CalendarData.RequiredGrantNameKeys
    })" />

    @* Draft Mode sandbox banner (Epic 4) — makes the sandbox state unmistakable. *@
    @if (Model.DraftMode && Model.ActiveDraftId != null)
    {
        <div class="cal-draft-banner" role="status">
            <span class="cal-draft-banner__icon" aria-hidden="true"><icon name="pencil" /></span>
            <span class="cal-draft-banner__text">@Localizer["Draft_BannerText"]</span>
        </div>
    }

    @* Calendar tabs (לשונית) — molecule sub-calendars, admin-defined in Blueprints. Switching is a
       view filter (everyone in the molecule sees all tabs). Own row above the grid; hidden when the
       molecule has no tabs. Tab=0 = "Main" (untagged shifts). *@
    @if (Model.AvailableTabs.Any())
    {
        var tabBaseQ = $"?MoleculeId={Model.MoleculeId}&JobTypeId={Model.JobTypeId}&Start={Model.StartDate:yyyy-MM-dd}&ViewMode={Model.ViewMode}&Mode={Model.Mode}{dlParam}";
        <div class="cal-tabs" role="tablist" aria-label="@Localizer["ShiftsCalendar"]">
            <a href="@(tabBaseQ)&Tab=0" role="tab"
               aria-selected="@((!Model.Tab.HasValue).ToString().ToLowerInvariant())"
               class="cal-tab @(!Model.Tab.HasValue ? "cal-tab--active" : "")">@Localizer["Calendar_Tab_Main"]</a>
            @foreach (var t in Model.AvailableTabs)
            {
                var active = Model.Tab == t.Id;
                <a href="@(tabBaseQ)&Tab=@t.Id" role="tab"
                   aria-selected="@active.ToString().ToLowerInvariant()"
                   class="cal-tab @(active ? "cal-tab--active" : "")">
                    @if (!string.IsNullOrEmpty(t.Color))
                    {
                        <span class="cal-tab__dot" style="background:@t.Color"></span>
                    }
                    @t.DisplayName
                </a>
            }
        </div>
    }

    @* Calendar Table *@
    @if (Model.CalendarData.Rows.Any())
    {
        @await Component.InvokeAsync("ExcelCalendarTable", Model.CalendarData)
    }
    else
    {
        <div class="cal-empty">
            <div class="cal-empty__icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
            </div>
            <h3 class="cal-empty__title">@Localizer["Calendar_Empty_NoShifts"]</h3>
            <p class="cal-empty__message">
                @if (!Model.MoleculeId.HasValue)
                {
                    @Localizer["Calendar_Empty_SelectMolecule"]
                }
                else if (!Model.AvailableJobTypes.Any())
                {
                    @Localizer["Calendar_Empty_NoJobTypes"]
                }
                else if (!Model.JobTypeId.HasValue)
                {
                    @Localizer["Calendar_Empty_SelectJobType"]
                }
                else
                {
                    @Localizer["Calendar_Empty_NoShiftsForSelection"]
                }
            </p>
        </div>
    }

    @* Mobile Tools overflow sheet — clones of the hidden toolbar controls
       are injected at open() time so the originals remain the source of
       truth (event handlers and form bindings unmodified). *@
    <div id="calendarToolsSheet" class="bottom-sheet calendar-tools-sheet" hidden aria-modal="true" role="dialog">
        <div class="bottom-sheet__content">
            <div class="bottom-sheet__header">
                <h3><loc key="Calendar_Tools_Overflow_Label" /></h3>
                <button type="button" class="bottom-sheet__close"
                        loc-aria-label="Aria_CloseDialog"
                        onclick="window.CalendarToolsOverflow && window.CalendarToolsOverflow.close()">×</button>
            </div>
            <div class="bottom-sheet__body" id="calendarToolsSheetBody">
                @* Cloned controls are injected here at open() time so server state stays source of truth *@
            </div>
        </div>
    </div>
</div>

@* Filter Modal — triggered by the People/Shifts column header (and the toolbar Filter button). *@
<div id="filterModal" class="cal-filter-modal" style="display: none;" onclick="if(event.target===this) closeFilterModal()">
    <div class="cal-filter-modal__dialog">
        <div class="cal-filter-modal__header">
            <h3><loc key="Filter" /></h3>
            <button type="button" class="cal-filter-modal__close" onclick="closeFilterModal()" loc-aria-label="Aria_CloseDialog">&times;</button>
        </div>
        @* Sticky search + Only Me stay pinned while the category list scrolls. *@
        <div class="cal-filter-modal__sticky">
            <input type="text" id="filterSearchInput" class="form-control"
                   placeholder="@Localizer["Filter_SearchPlaceholder"]"
                   oninput="applyFilter()"
                   onkeydown="if(event.key==='Enter'){event.preventDefault(); applyFilter();}" />
            <a id="filterOnlyMeBtn"
               href="?MoleculeId=@Model.MoleculeId&JobTypeId=@Model.JobTypeId&Start=@Model.StartDate.ToString("yyyy-MM-dd")&ViewMode=@Model.ViewMode&Mode=@Model.Mode&JustMine=@((!Model.JustMine).ToString().ToLowerInvariant())@dlParam@(tabParam)"
               class="btn btn-sm @(Model.JustMine ? "btn-primary" : "btn-ghost")">
                <span class="btn-icon"><icon name="user" /></span> @Localizer["JustMine"]
            </a>
        </div>
        <div class="cal-filter-modal__body">
            <p class="cal-filter-modal__section-label"><loc key="Filter_CategoriesLabel" /></p>
            <div id="filterCategoryList" class="cal-filter-categories">
                @* Checkboxes injected by populateCategoryFilters() from the rendered group headers *@
            </div>
        </div>
        <div class="cal-filter-modal__footer">
            <button type="button" class="btn btn-ghost" onclick="clearFilter()"><loc key="Filter_Clear" /></button>
            <button type="button" class="btn btn-primary" onclick="closeFilterModal()"><loc key="Button_Done" /></button>
        </div>
    </div>
</div>

@* Distribution-list manager + editor modals — only when the user can manage lists (the filter dropdown
   itself is server-rendered in the toolbar and needs no modal). *@
@if (Model.Mode == "user" && Model.CanManageLists)
{
    <partial name="_DistributionListModals" />
}

@* Hidden select for bottom-sheet dropdown (Strategy 1 in getAvailableUsers) *@
@if (Model.Mode == "user")
{
    @* User-mode: rows are users, so the dropdown offers shift types to assign *@
    <select id="assigneeSelect-shifts" data-role="assignee-select" data-item-type="shifttype" style="display:none">
        @foreach (var st in Model.ShiftTypes)
        {
            var stName = Model.LocalizedShiftTypeNames.GetValueOrDefault(st.Id, st.Name);
            <option value="@st.Id" data-key="@st.Key">@stName (@st.Start.ToString("HH:mm")-@st.End.ToString("HH:mm"))</option>
        }
    </select>
}
else
{
    @* Shift-mode: rows are shift types, so the dropdown offers users to assign *@
    <select id="assigneeSelect-shifts" data-role="assignee-select" data-item-type="user" style="display:none">
        @foreach (var user in Model.Users)
        {
            <option value="@user.Id">@user.DisplayName</option>
        }
    </select>
}

@* Hidden select for trainee assignment dropdown *@
@if (Model.Trainees.Any())
{
    <select id="traineeSelect" data-role="trainee-select" style="display:none">
        @foreach (var trainee in Model.Trainees)
        {
            <option value="@trainee.Id">@trainee.DisplayName</option>
        }
    </select>
}

@* Hidden selects for Quick Entry autocomplete (chore types + duty types) *@
@if (Model.Mode == "user")
{
    var isHebrew = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("he");
    <select id="choreTypeSelect-quickentry" style="display:none" data-role="quickentry-choretype">
        @foreach (var ct in Model.ChoreTypes)
        {
            var ctName = isHebrew && !string.IsNullOrWhiteSpace(ct.NameHe) ? ct.NameHe : ct.NameEn ?? ct.DisplayName;
            <option value="@ct.Id" data-color="@ct.Color">@ctName</option>
        }
    </select>
    <select id="dutyTypeSelect-quickentry" style="display:none" data-role="quickentry-dutytype">
        @foreach (var dt in Model.DutyTypes)
        {
            var dtName = isHebrew ? dt.NameHe : dt.NameEn;
            <option value="@dt.TypeValue" data-icon="@dt.Icon" data-color="@dt.Color">@dtName</option>
        }
    </select>
}

@section Styles {
    <style>
        /* Calendar tabs (לשונית) — Excel-style sub-calendar strip above the grid. Reuses the Team-page
           pill tokens: contrast-safe active (--primary-contrast on --primary), RTL-safe (flexbox +
           logical margins), theme-aware via design tokens, horizontal-scroll past the viewport. */
        .cal-tabs {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.375rem;
            margin: 0.5rem 0 0;
            padding-bottom: 0.5rem;
            overflow-x: auto;
        }
        .cal-tab {
            display: inline-flex;
            align-items: center;
            padding: 0.375rem 0.85rem;
            border-radius: 999px;
            background: var(--surface-soft);
            color: var(--text);
            font-size: 0.85rem;
            font-weight: 500;
            text-decoration: none;
            border: 1px solid transparent;
            white-space: nowrap;
        }
        .cal-tab:hover { border-color: var(--border); }
        .cal-tab--active {
            background: var(--primary);
            color: var(--primary-contrast);
            font-weight: 600;
        }
        .cal-tab__dot {
            width: 0.5rem;
            height: 0.5rem;
            border-radius: 50%;
            display: inline-block;
            margin-inline-end: 0.375rem;
            border: 1px solid rgba(0, 0, 0, 0.15);
        }

        /* "Busy elsewhere" ghost: a by-user chip for a shift that lives on ANOTHER tab. Greyed and
           non-interactive (view-only) so the tab reads as a separate calendar, while the person's
           cross-tab commitment stays visible. Conflict/rest/hours still count it (server-side). */
        .excel-calendar__assignment.is-busy-elsewhere {
            opacity: 0.45;
            filter: grayscale(0.75);
            pointer-events: none;
        }
    </style>
}

@section Scripts {
    <script>
        window.CalendarPageConfig = {
            isTechMolecule: @(Model.IsTechMolecule ? "true" : "false"),
            categoryEligibilityEnabled: @(Model.CategoryEligibilityEnabled ? "true" : "false"),
            moleculeId: @(Model.MoleculeId ?? 0)
        };
    </script>
    <script src="~/js/calendar-lazy-rows.js" asp-append-version="true"></script>
    <script src="~/js/calendar-sticky-shadows.js" asp-append-version="true"></script>
    <script src="~/js/calendar-inline-edit.js" asp-append-version="true"></script>
    <script src="~/js/calendar-bottom-sheet.js" asp-append-version="true"></script>
    <script src="~/js/calendar-keyboard-nav.js" asp-append-version="true"></script>
    <script src="~/js/calendar-tools-overflow.js" asp-append-version="true"></script>

    @* Justice in-context drawer (Phase 2) *@
    <link rel="stylesheet" href="~/css/justice-panel.css" asp-append-version="true" />
    <script src="~/js/justice-panel.js" asp-append-version="true" defer></script>
    <link rel="stylesheet" href="~/css/calendar-quick-entry.css" asp-append-version="true" />
    <script src="~/js/calendar-quick-entry.js" asp-append-version="true"></script>
    <script src="~/js/calendar-row-reorder.js" asp-append-version="true"></script>
    <script src="~/js/excel-calendar-groups.js" asp-append-version="true"></script>
    @* Distribution lists: filter dropdown (all users) + manager/editor modals (managers) — by-user view only *@
    @if (Model.Mode == "user")
    {
        <link rel="stylesheet" href="~/css/distribution-lists.css" asp-append-version="true" />
        <script src="~/js/distribution-lists.js" asp-append-version="true"></script>
    }
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/calendar-realtime.js" asp-append-version="true"></script>
    <script>
        // Initialize real-time updates
        document.addEventListener('DOMContentLoaded', function() {
            CalendarRealtime.initialize({
                calendarType: 'shifts',
                scope: {
                    moleculeId: @Model.MoleculeId,
                    jobTypeId: @(Model.JobTypeId?.ToString() ?? "null")
                },
                onRefresh: refreshCalendarData,
                handlers: {
                    onAssignmentChanged: handleAssignmentChanged,
                    onCapacityChanged: handleCapacityChanged
                }
            });
        });

        // SECURITY FIX: Escape HTML entities including single quotes for safe innerHTML rendering
        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML.replace(/'/g, '&#39;');
        }

        // Refresh calendar data via AJAX
        async function refreshCalendarData() {
            const startDate = '@Model.StartDate.ToString("yyyy-MM-dd")';
            const endDate = '@Model.EndDate.ToString("yyyy-MM-dd")';
            const moleculeId = @Model.MoleculeId;
            const jobTypeId = @(Model.JobTypeId?.ToString() ?? "0");
            const tabParam = @(Model.AvailableTabs.Any() ? (Model.Tab ?? 0).ToString() : "null");

            try {
                let url = `/Api/Calendar/GetShiftsData?moleculeId=${moleculeId}&startDate=${startDate}&endDate=${endDate}`;
                if (jobTypeId) url += `&jobTypeId=${jobTypeId}`;
                if (tabParam !== null) url += `&tab=${tabParam}`;
                const response = await fetch(url, { credentials: 'same-origin' });

                if (!response.ok) throw new Error('Failed to refresh');

                const result = await response.json();
                if (result.success) {
                    updateCalendarCells(result.data);
                }
            } catch (error) {
                console.error('Shadow refresh failed:', error);
            }
        }

        // Update calendar cells with new data
        function updateCalendarCells(data) {
            const cellsById = new Map(data.cells.map(c => [c.shiftInstanceId, c]));

            document.querySelectorAll('.excel-cell[data-shift-instance-id]').forEach(cell => {
                const instanceId = parseInt(cell.dataset.shiftInstanceId);
                const cellData = cellsById.get(instanceId);
                if (cellData) {
                    updateSingleCell(cell, cellData);
                }
            });
        }

        // Update a single cell's content
        function updateSingleCell(cell, cellData) {
            // Update assignment count badge
            const badge = cell.querySelector('.excel-cell__count');
            if (badge) {
                badge.textContent = `${cellData.assignedCount}/${cellData.capacity}`;
                badge.classList.toggle('excel-cell__count--full', cellData.assignedCount >= cellData.capacity);
            }

            // Update assignment list
            const assignmentList = cell.querySelector('.excel-cell__assignments');
            if (assignmentList) {
                assignmentList.innerHTML = cellData.assignments
                    .map(a => `<span class="excel-cell__assignee" data-user-id="${a.userId}">${escapeHtml(a.userName)}</span>`)
                    .join('');
            }
        }

        // Handle real-time assignment change
        function handleAssignmentChanged(evt) {
            const cell = document.querySelector(`[data-shift-instance-id="${evt.shiftInstanceId}"]`);
            if (cell) {
                refreshCalendarData(); // Full refresh for now
            }
        }

        // Handle real-time capacity change
        function handleCapacityChanged(evt) {
            refreshCalendarData(); // Full refresh for now
        }

        // Update calendar with new filter selections
        function updateCalendarFilters() {
            const moleculeId = document.getElementById('moleculeSelect').value;
            const jobTypeSelect = document.getElementById('jobTypeSelect');
            const jobTypeId = jobTypeSelect ? jobTypeSelect.value : '';
            const viewMode = document.getElementById('viewModeSelect').value;

            const params = new URLSearchParams(window.location.search);
            // Switching molecule → drop the tab so the new molecule falls back to its OWN remembered tab
            // (an old molecule's tab id is meaningless here; the server would ignore it anyway).
            if (String(moleculeId) !== '@(Model.MoleculeId ?? 0)') {
                params.delete('Tab');
            }
            params.set('MoleculeId', moleculeId);
            if (jobTypeId) {
                params.set('JobTypeId', jobTypeId);
            } else {
                params.delete('JobTypeId'); // Tech molecules — no JobType filter
            }
            params.set('ViewMode', viewMode);

            window.location.href = window.location.pathname + '?' + params.toString();
        }

        // Navigate to a specific date
        function navigateToDate(dateStr) {
            const params = new URLSearchParams(window.location.search);
            params.set('Start', dateStr);
            window.location.href = window.location.pathname + '?' + params.toString();
        }

        // --- Filter modal: sticky search + per-category visibility toggles + Only Me ---
        // Group IDs whose accordion is currently hidden via an unchecked category checkbox.
        var disabledGroups = new Set();

        function openFilterModal() {
            var modal = document.getElementById('filterModal');
            modal.style.display = 'flex';
            modal.classList.add('is-open');
            populateCategoryFilters();
            var input = document.getElementById('filterSearchInput');
            if (input) { setTimeout(function () { input.focus(); }, 0); }
        }
        window.openFilterModal = openFilterModal;

        function closeFilterModal() {
            var modal = document.getElementById('filterModal');
            modal.classList.remove('is-open');
            modal.style.display = 'none';
        }
        window.closeFilterModal = closeFilterModal;

        // Build a checkbox per rendered group (category accordions + company/"Other" groups).
        function populateCategoryFilters() {
            var container = document.getElementById('filterCategoryList');
            if (!container) return;
            container.innerHTML = '';
            var headers = document.querySelectorAll('tr.excel-calendar__group-header');
            if (headers.length === 0) {
                var empty = document.createElement('p');
                empty.className = 'cal-filter-empty';
                empty.textContent = '@Localizer["Filter_NoGroups"].Value.Trim()';
                container.appendChild(empty);
                return;
            }
            headers.forEach(function (h) {
                var gid = h.getAttribute('data-group-id') || '';
                if (!gid) return;
                var name = (h.querySelector('.excel-calendar__group-name')?.textContent || gid).trim();
                var label = document.createElement('label');
                label.className = 'cal-filter-cat-item';
                var cb = document.createElement('input');
                cb.type = 'checkbox';
                cb.checked = !disabledGroups.has(gid);
                cb.value = gid;
                cb.addEventListener('change', function () {
                    if (this.checked) disabledGroups.delete(gid); else disabledGroups.add(gid);
                    applyFilter();
                });
                var span = document.createElement('span');
                span.textContent = name;
                label.appendChild(cb);
                label.appendChild(span);
                container.appendChild(label);
            });
        }

        // Combined filter: a row shows when it matches the search text AND its group is enabled.
        function applyFilter() {
            var query = (document.getElementById('filterSearchInput')?.value || '').trim().toLowerCase();
            document.querySelectorAll('tr[data-row-id]').forEach(function (row) {
                if (row.classList.contains('excel-calendar__group-header')) return;
                var groupId = row.getAttribute('data-group-id') || '';
                var label = (row.querySelector('.excel-calendar__row-label')?.textContent || '').toLowerCase();
                var names = Array.from(row.querySelectorAll('.excel-calendar__assignment-name'))
                    .map(function (el) { return el.textContent.toLowerCase(); }).join(' ');
                var matchesSearch = !query || label.indexOf(query) !== -1 || names.indexOf(query) !== -1;
                var groupEnabled = !disabledGroups.has(groupId);
                row.style.display = (matchesSearch && groupEnabled) ? '' : 'none';
            });
            // Hide the header of any disabled group entirely.
            document.querySelectorAll('tr.excel-calendar__group-header').forEach(function (h) {
                var gid = h.getAttribute('data-group-id') || '';
                h.style.display = disabledGroups.has(gid) ? 'none' : '';
            });
            window.updateGroupCounts && window.updateGroupCounts();
        }
        window.applyFilter = applyFilter;

        function clearFilter() {
            disabledGroups.clear();
            var input = document.getElementById('filterSearchInput');
            if (input) input.value = '';
            applyFilter();
            populateCategoryFilters();
        }
        window.clearFilter = clearFilter;

        // The People/Shifts column header (the "אנשים ▾" / "משמרות ▾" token) opens the filter modal.
        // Re-wire after every full-grid refresh since the header element is replaced.
        function wireFilterHeader() {
            document.querySelectorAll('.excel-calendar__corner[data-mode]').forEach(function (th) {
                if (th.dataset.filterWired === '1') return;
                th.dataset.filterWired = '1';
                th.style.cursor = 'pointer';
                th.setAttribute('role', 'button');
                th.setAttribute('tabindex', '0');
                th.addEventListener('click', openFilterModal);
                th.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openFilterModal(); }
                });
            });
        }
        document.addEventListener('DOMContentLoaded', wireFilterHeader);
        document.addEventListener('calendar:grid-refreshed', function () { wireFilterHeader(); applyFilter(); });

        // --- Draft Mode (Epic 4): the active sandbox id (read by calendar-inline-edit.js to stage assigns) ---
        window.__draftSessionId = @(Model.DraftMode && Model.ActiveDraftId != null ? Model.ActiveDraftId.Value.ToString() : "null");

        (function () {
            function draftToken() {
                var t = document.querySelector('input[name="__RequestVerificationToken"]');
                return t ? t.value : '';
            }
            function draftPost(handler, body) {
                return fetch('/Calendar/Table?handler=' + handler, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': draftToken() },
                    credentials: 'same-origin',
                    body: JSON.stringify(body)
                });
            }
            function exitDraftUrl() {
                var p = new URLSearchParams(window.location.search);
                p.delete('DraftMode');
                return window.location.pathname + '?' + p.toString();
            }
            var fail = '@(Localizer["Error_FailedToUpdate"].Value.Trim())';

            var enterBtn = document.getElementById('enterDraftBtn');
            if (enterBtn) enterBtn.addEventListener('click', async function () {
                enterBtn.disabled = true;
                try {
                    var resp = await draftPost('EnterDraft', {
                        moleculeId: parseInt(enterBtn.dataset.moleculeId),
                        jobTypeId: enterBtn.dataset.jobTypeId ? parseInt(enterBtn.dataset.jobTypeId) : null,
                        weekStart: enterBtn.dataset.weekStart,
                        weekEnd: enterBtn.dataset.weekEnd
                    });
                    var data = await resp.json();
                    if (data.success) {
                        var p = new URLSearchParams(window.location.search);
                        p.set('DraftMode', 'true');
                        window.location.href = window.location.pathname + '?' + p.toString();
                    } else { window.FeedbackModal.show('error', fail); enterBtn.disabled = false; }
                } catch (e) { console.error(e); enterBtn.disabled = false; }
            });

            var commitBtn = document.getElementById('commitDraftBtn');
            if (commitBtn) commitBtn.addEventListener('click', async function () {
                commitBtn.disabled = true;
                try {
                    var resp = await draftPost('CommitDraft', { draftSessionId: parseInt(commitBtn.dataset.draftId) });
                    var data = await resp.json();
                    // Per-cell policy (Spec F): the session commits even when some cells are skipped. Clean
                    // commit → return to live. Partial commit → report which cells were skipped/unauthorized.
                    if (!data.success) { window.FeedbackModal.show('error', fail); commitBtn.disabled = false; return; }
                    var skipped = data.skipped || [], unauthorized = data.unauthorized || [], issues = data.issues || [];
                    if (skipped.length === 0 && unauthorized.length === 0 && issues.length === 0) {
                        window.location.href = exitDraftUrl(); return;
                    }
                    var coord = function (c) { return c.label || (c.rowId + ' @@ ' + c.date); };
                    var lines = [];
                    skipped.forEach(function (c) { lines.push('@(Localizer["Draft_CommitSkippedLabel"].Value.Trim()) ' + coord(c)); });
                    unauthorized.forEach(function (c) { lines.push('@(Localizer["Draft_CommitUnauthorizedLabel"].Value.Trim()) ' + coord(c)); });
                    issues.forEach(function (i) { lines.push('@(Localizer["Draft_CommitIssueLabel"].Value.Trim()) ' + coord(i) + ' — ' + i.message); });
                    window.FeedbackModal.show('warning', '@(Localizer["Draft_CommitPartialMessage"].Value.Trim())', {
                        detail: lines.join('\n'),
                        action: { label: '@(Localizer["Draft_ReturnToLive"].Value.Trim())', url: exitDraftUrl() }
                    });
                    commitBtn.disabled = false;
                } catch (e) { console.error(e); commitBtn.disabled = false; }
            });

            var discardBtn = document.getElementById('discardDraftBtn');
            if (discardBtn) discardBtn.addEventListener('click', async function () {
                discardBtn.disabled = true;
                try {
                    var resp = await draftPost('DiscardDraft', { draftSessionId: parseInt(discardBtn.dataset.draftId) });
                    var data = await resp.json();
                    if (data.success) { window.location.href = exitDraftUrl(); return; }
                    discardBtn.disabled = false;
                } catch (e) { console.error(e); discardBtn.disabled = false; }
            });
        })();

        // Keyboard navigation
        document.addEventListener('keydown', function(e) {
            // Left arrow - previous period
            if (e.key === 'ArrowLeft' && e.altKey) {
                document.querySelector('.cal-toolbar__nav-btn:first-child')?.click();
            }
            // Right arrow - next period
            if (e.key === 'ArrowRight' && e.altKey) {
                document.querySelector('.cal-toolbar__nav-btn:last-child')?.click();
            }
            // P key - print
            if (e.key === 'p' && e.ctrlKey) {
                e.preventDefault();
                window.print();
            }
        });
    </script>
}

@* All toolbar/layout CSS is now in wwwroot/css/calendar.css (.cal-toolbar, .cal-empty, .cal-filter-modal) *@
