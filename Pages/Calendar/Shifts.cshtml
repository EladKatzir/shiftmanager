@page
@model ShiftManager.Pages.Calendar.ShiftsModel
@using ShiftManager.ViewComponents
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@inject IStringLocalizer<SharedResources> Localizer
@inject ShiftManager.Services.ILocalizationService Localization
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["ShiftsCalendar"];
}

@* Breadcrumb *@
@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Calendars"], Url = "/Calendar/Month" },
    new BreadcrumbItem { Label = Localizer["ShiftsCalendar"], IsActive = true }
})

<div class="cal-page" data-ui-version="v2">
    @* Toolbar — Row 1: Selectors + Date Nav + Print *@
    <div class="cal-toolbar">
        <div class="cal-toolbar__row">
            <div class="cal-toolbar__selector">
                <label for="moleculeSelect">@Localizer["Molecule"]</label>
                <select id="moleculeSelect" class="form-select" onchange="updateCalendarFilters()">
                    @foreach (var molecule in Model.AvailableMolecules)
                    {
                        var isSelected = molecule.Id == Model.MoleculeId;
                        <option value="@molecule.Id" selected="@isSelected">@molecule.DisplayName</option>
                    }
                </select>
            </div>

            @if (!Model.IsTechMolecule)
            {
            <div class="cal-toolbar__selector">
                <label for="jobTypeSelect">@Localizer["JobType"]</label>
                <select id="jobTypeSelect" class="form-select" onchange="updateCalendarFilters()">
                    @foreach (var jobType in Model.AvailableJobTypes)
                    {
                        var isSelected = jobType.Id == Model.JobTypeId;
                        <option value="@jobType.Id" selected="@isSelected">@jobType.DisplayName</option>
                    }
                </select>
            </div>
            }

            <div class="cal-toolbar__selector">
                <label for="viewModeSelect">@Localizer["ViewMode"]</label>
                <select id="viewModeSelect" class="form-select" onchange="updateCalendarFilters()">
                    <option value="week" selected="@(Model.ViewMode == "week")">@Localizer["Week"]</option>
                    <option value="2weeks" selected="@(Model.ViewMode == "2weeks")">@Localizer["TwoWeeks"]</option>
                    <option value="month" selected="@(Model.ViewMode == "month")">@Localizer["Month"]</option>
                </select>
            </div>

            <div class="cal-toolbar__date-nav">
                <a href="?MoleculeId=@Model.MoleculeId&JobTypeId=@Model.JobTypeId&Start=@Model.PreviousStart&ViewMode=@Model.ViewMode&Mode=@Model.Mode"
                   class="btn btn-ghost cal-toolbar__nav-btn"
                   title="@Localizer["Previous"]">
                    <span class="nav-icon">&larr;</span>
                    <span class="nav-text">@Localizer["Previous"]</span>
                </a>

                <div class="cal-toolbar__date-display">
                    <input type="date"
                           id="datePickerInput"
                           value="@Model.StartDate.ToString("yyyy-MM-dd")"
                           onchange="navigateToDate(this.value)"
                           class="cal-toolbar__date-picker" />
                    <span class="cal-toolbar__date-label">
                        @Localization.FormatMediumDate(Model.StartDate) - @Localization.FormatMediumDate(Model.EndDate)
                    </span>
                </div>

                <a href="?MoleculeId=@Model.MoleculeId&JobTypeId=@Model.JobTypeId&Start=@Model.NextStart&ViewMode=@Model.ViewMode&Mode=@Model.Mode"
                   class="btn btn-ghost cal-toolbar__nav-btn"
                   title="@Localizer["Next"]">
                    <span class="nav-text">@Localizer["Next"]</span>
                    <span class="nav-icon">&rarr;</span>
                </a>
            </div>

            <button type="button" class="btn btn-secondary cal-toolbar__print" onclick="window.print()" title="@Localizer["Print"]">
                <span class="btn-icon"><icon name="printer" /></span>
                <span class="btn-text">@Localizer["Print"]</span>
            </button>
        </div>

        @* Row 2: Mode toggles + Filter + Just Mine *@
        <div class="cal-toolbar__controls">
            <div class="cal-toolbar__toggle-group">
                <a href="?MoleculeId=@Model.MoleculeId&JobTypeId=@Model.JobTypeId&Start=@Model.StartDate.ToString("yyyy-MM-dd")&ViewMode=@Model.ViewMode&Mode=shift"
                   class="btn @(Model.Mode == "shift" ? "btn-primary" : "btn-ghost")">
                    @Localizer["ByShift"]
                </a>
                <a href="?MoleculeId=@Model.MoleculeId&JobTypeId=@Model.JobTypeId&Start=@Model.StartDate.ToString("yyyy-MM-dd")&ViewMode=@Model.ViewMode&Mode=user"
                   class="btn @(Model.Mode == "user" ? "btn-primary" : "btn-ghost")">
                    @Localizer["ByUser"]
                </a>
            </div>

            @if (Model.CalendarData.Groups != null)
            {
                <div class="group-toggle-buttons" style="display: inline-flex; gap: var(--space-1); margin-inline-start: var(--space-2);">
                    <button type="button" class="btn btn--sm btn--outline" onclick="collapseAllGroups()">
                        <span>&#9650;</span> @Localizer["CollapseAll"]
                    </button>
                    <button type="button" class="btn btn--sm btn--outline" onclick="expandAllGroups()">
                        <span>&#9660;</span> @Localizer["ExpandAll"]
                    </button>
                </div>
            }

            @if (Model.CanEdit)
            {
                <div class="cal-toolbar__toggle-group">
                    <a href="?MoleculeId=@Model.MoleculeId&JobTypeId=@Model.JobTypeId&Start=@Model.StartDate.ToString("yyyy-MM-dd")&ViewMode=@Model.ViewMode&Mode=@Model.Mode&CapacityMode=@(!Model.CapacityMode)"
                       class="btn @(Model.CapacityMode ? "btn-primary" : "btn-ghost")">
                        @Localizer["CapacityMode"]
                    </a>
                </div>
            }

            <span class="cal-toolbar__separator"></span>

            <div class="cal-toolbar__toggle-group">
                <button type="button" class="btn btn-ghost" onclick="openFilterModal()">
                    <span class="btn-icon"><icon name="search" /></span>
                    @Localizer["Filter"]
                </button>
                <a href="?MoleculeId=@Model.MoleculeId&JobTypeId=@Model.JobTypeId&Start=@Model.StartDate.ToString("yyyy-MM-dd")&ViewMode=@Model.ViewMode&Mode=@Model.Mode&JustMine=@(!Model.JustMine)"
                   class="btn @(Model.JustMine ? "btn-primary" : "btn-ghost")">
                    @Localizer["JustMine"]
                </a>
            </div>

            @if (Model.CanWriteNote)
            {
                <button type="button" id="quickEntryToggle" class="btn btn-ghost quick-entry-toggle"
                        data-can-assign="@Model.CanEdit.ToString().ToLowerInvariant()"
                        onclick="window.CalendarQuickEntry && window.CalendarQuickEntry.toggle()"
                        title="@Localizer["QuickEntry_Toggle"]">
                    <span class="btn-icon"><icon name="zap" /></span>
                    <loc key="QuickEntry_Toggle" />
                </button>
                <button type="button" id="quickEntryHelp" class="btn btn-ghost quick-entry-help-btn"
                        onclick="window.CalendarQuickEntry && window.CalendarQuickEntry.showHelp()"
                        loc-title="QuickEntry_HelpTitle"
                        loc-aria-label="QuickEntry_HelpTitle">
                    <span class="btn-icon">?</span>
                </button>
            }
        </div>
    </div>

    @* Calendar Table *@
    @if (Model.CalendarData.Rows.Any())
    {
        @await Component.InvokeAsync("ExcelCalendarTable", Model.CalendarData)
    }
    else
    {
        <div class="cal-empty">
            <div class="cal-empty__icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
            </div>
            <h3 class="cal-empty__title">@Localizer["Calendar_Empty_NoShifts"]</h3>
            <p class="cal-empty__message">
                @if (!Model.MoleculeId.HasValue)
                {
                    @Localizer["Calendar_Empty_SelectMolecule"]
                }
                else if (!Model.AvailableJobTypes.Any())
                {
                    @Localizer["Calendar_Empty_NoJobTypes"]
                }
                else if (!Model.JobTypeId.HasValue)
                {
                    @Localizer["Calendar_Empty_SelectJobType"]
                }
                else
                {
                    @Localizer["Calendar_Empty_NoShiftsForSelection"]
                }
            </p>
        </div>
    }
</div>

@* Filter Modal *@
<div id="filterModal" class="cal-filter-modal" style="display: none;" onclick="if(event.target===this) closeFilterModal()">
    <div class="cal-filter-modal__dialog">
        <div class="cal-filter-modal__header">
            <h3><loc key="Filter" /></h3>
            <button type="button" class="cal-filter-modal__close" onclick="closeFilterModal()" loc-aria-label="Aria_CloseDialog">&times;</button>
        </div>
        <div class="cal-filter-modal__body">
            <div class="form-group">
                <label for="filterSearchInput"><loc key="Filter_SearchLabel" /></label>
                <input type="text" id="filterSearchInput" class="form-control"
                       placeholder="@Localizer["Filter_SearchPlaceholder"]"
                       onkeydown="if(event.key==='Enter'){event.preventDefault(); applyFilter();}" />
            </div>
        </div>
        <div class="cal-filter-modal__footer">
            <button type="button" class="btn btn-ghost" onclick="clearFilter()"><loc key="Filter_Clear" /></button>
            <button type="button" class="btn btn-primary" onclick="applyFilter()"><loc key="Filter_Apply" /></button>
        </div>
    </div>
</div>

@* Hidden select for bottom-sheet dropdown (Strategy 1 in getAvailableUsers) *@
@if (Model.Mode == "user")
{
    @* User-mode: rows are users, so the dropdown offers shift types to assign *@
    <select id="assigneeSelect-shifts" data-role="assignee-select" data-item-type="shifttype" style="display:none">
        @foreach (var st in Model.ShiftTypes)
        {
            var stName = Model.LocalizedShiftTypeNames.GetValueOrDefault(st.Id, st.Name);
            <option value="@st.Id" data-key="@st.Key">@stName (@st.Start.ToString("HH:mm")-@st.End.ToString("HH:mm"))</option>
        }
    </select>
}
else
{
    @* Shift-mode: rows are shift types, so the dropdown offers users to assign *@
    <select id="assigneeSelect-shifts" data-role="assignee-select" data-item-type="user" style="display:none">
        @foreach (var user in Model.Users)
        {
            <option value="@user.Id">@user.DisplayName</option>
        }
    </select>
}

@* Hidden select for trainee assignment dropdown *@
@if (Model.Trainees.Any())
{
    <select id="traineeSelect" data-role="trainee-select" style="display:none">
        @foreach (var trainee in Model.Trainees)
        {
            <option value="@trainee.Id">@trainee.DisplayName</option>
        }
    </select>
}

@* Hidden selects for Quick Entry autocomplete (chore types + duty types) *@
@if (Model.Mode == "user")
{
    var isHebrew = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("he");
    <select id="choreTypeSelect-quickentry" style="display:none" data-role="quickentry-choretype">
        @foreach (var ct in Model.ChoreTypes)
        {
            var ctName = isHebrew && !string.IsNullOrWhiteSpace(ct.NameHe) ? ct.NameHe : ct.NameEn ?? ct.DisplayName;
            <option value="@ct.Id" data-color="@ct.Color">@ctName</option>
        }
    </select>
    <select id="dutyTypeSelect-quickentry" style="display:none" data-role="quickentry-dutytype">
        @foreach (var dt in Model.DutyTypes)
        {
            var dtName = isHebrew ? dt.NameHe : dt.NameEn;
            <option value="@dt.TypeValue" data-icon="@dt.Icon" data-color="@dt.Color">@dtName</option>
        }
    </select>
}

@section Scripts {
    <script>
        window.CalendarPageConfig = {
            isTechMolecule: @(Model.IsTechMolecule ? "true" : "false"),
            moleculeId: @(Model.MoleculeId ?? 0)
        };
    </script>
    <script src="~/js/calendar-lazy-rows.js" asp-append-version="true"></script>
    <script src="~/js/calendar-inline-edit.js" asp-append-version="true"></script>
    <script src="~/js/calendar-bottom-sheet.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/calendar-quick-entry.css" asp-append-version="true" />
    <script src="~/js/calendar-quick-entry.js" asp-append-version="true"></script>
    <script src="~/js/excel-calendar-groups.js" asp-append-version="true"></script>
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/calendar-realtime.js" asp-append-version="true"></script>
    <script>
        // Initialize real-time updates
        document.addEventListener('DOMContentLoaded', function() {
            CalendarRealtime.initialize({
                calendarType: 'shifts',
                scope: {
                    moleculeId: @Model.MoleculeId,
                    jobTypeId: @(Model.JobTypeId?.ToString() ?? "null")
                },
                onRefresh: refreshCalendarData,
                handlers: {
                    onAssignmentChanged: handleAssignmentChanged,
                    onCapacityChanged: handleCapacityChanged
                }
            });
        });

        // SECURITY FIX: Escape HTML entities including single quotes for safe innerHTML rendering
        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML.replace(/'/g, '&#39;');
        }

        // Refresh calendar data via AJAX
        async function refreshCalendarData() {
            const startDate = '@Model.StartDate.ToString("yyyy-MM-dd")';
            const endDate = '@Model.EndDate.ToString("yyyy-MM-dd")';
            const moleculeId = @Model.MoleculeId;
            const jobTypeId = @(Model.JobTypeId?.ToString() ?? "0");

            try {
                let url = `/Api/Calendar/GetShiftsData?moleculeId=${moleculeId}&startDate=${startDate}&endDate=${endDate}`;
                if (jobTypeId) url += `&jobTypeId=${jobTypeId}`;
                const response = await fetch(url, { credentials: 'same-origin' });

                if (!response.ok) throw new Error('Failed to refresh');

                const result = await response.json();
                if (result.success) {
                    updateCalendarCells(result.data);
                }
            } catch (error) {
                console.error('Shadow refresh failed:', error);
            }
        }

        // Update calendar cells with new data
        function updateCalendarCells(data) {
            const cellsById = new Map(data.cells.map(c => [c.shiftInstanceId, c]));

            document.querySelectorAll('.excel-cell[data-shift-instance-id]').forEach(cell => {
                const instanceId = parseInt(cell.dataset.shiftInstanceId);
                const cellData = cellsById.get(instanceId);
                if (cellData) {
                    updateSingleCell(cell, cellData);
                }
            });
        }

        // Update a single cell's content
        function updateSingleCell(cell, cellData) {
            // Update assignment count badge
            const badge = cell.querySelector('.excel-cell__count');
            if (badge) {
                badge.textContent = `${cellData.assignedCount}/${cellData.capacity}`;
                badge.classList.toggle('excel-cell__count--full', cellData.assignedCount >= cellData.capacity);
            }

            // Update assignment list
            const assignmentList = cell.querySelector('.excel-cell__assignments');
            if (assignmentList) {
                assignmentList.innerHTML = cellData.assignments
                    .map(a => `<span class="excel-cell__assignee" data-user-id="${a.userId}">${escapeHtml(a.userName)}</span>`)
                    .join('');
            }
        }

        // Handle real-time assignment change
        function handleAssignmentChanged(evt) {
            const cell = document.querySelector(`[data-shift-instance-id="${evt.shiftInstanceId}"]`);
            if (cell) {
                refreshCalendarData(); // Full refresh for now
            }
        }

        // Handle real-time capacity change
        function handleCapacityChanged(evt) {
            refreshCalendarData(); // Full refresh for now
        }

        // Update calendar with new filter selections
        function updateCalendarFilters() {
            const moleculeId = document.getElementById('moleculeSelect').value;
            const jobTypeSelect = document.getElementById('jobTypeSelect');
            const jobTypeId = jobTypeSelect ? jobTypeSelect.value : '';
            const viewMode = document.getElementById('viewModeSelect').value;

            const params = new URLSearchParams(window.location.search);
            params.set('MoleculeId', moleculeId);
            if (jobTypeId) {
                params.set('JobTypeId', jobTypeId);
            } else {
                params.delete('JobTypeId'); // Tech molecules — no JobType filter
            }
            params.set('ViewMode', viewMode);

            window.location.href = window.location.pathname + '?' + params.toString();
        }

        // Navigate to a specific date
        function navigateToDate(dateStr) {
            const params = new URLSearchParams(window.location.search);
            params.set('Start', dateStr);
            window.location.href = window.location.pathname + '?' + params.toString();
        }

        // Filter modal
        function openFilterModal() {
            var modal = document.getElementById('filterModal');
            modal.style.display = 'flex';
            modal.classList.add('is-open');
            var input = document.getElementById('filterSearchInput');
            if (input) { input.value = ''; input.focus(); }
        }

        function closeFilterModal() {
            var modal = document.getElementById('filterModal');
            modal.classList.remove('is-open');
            modal.style.display = 'none';
        }

        function applyFilter() {
            var query = (document.getElementById('filterSearchInput').value || '').trim().toLowerCase();
            var rows = document.querySelectorAll('[data-row-id]');
            var hidden = 0;
            rows.forEach(function(row) {
                if (row.classList.contains('excel-calendar__group-header')) return;
                var label = (row.querySelector('.excel-calendar__row-label')?.textContent || '').toLowerCase();
                var names = Array.from(row.querySelectorAll('.excel-calendar__assignment-name'))
                    .map(function(el) { return el.textContent.toLowerCase(); }).join(' ');
                var match = !query || label.indexOf(query) !== -1 || names.indexOf(query) !== -1;
                row.style.display = match ? '' : 'none';
                if (!match) hidden++;
            });
            closeFilterModal();
        }

        function clearFilter() {
            document.querySelectorAll('[data-row-id]').forEach(function(row) {
                if (!row.classList.contains('excel-calendar__group-header')) {
                    row.style.display = '';
                }
            });
            closeFilterModal();
        }

        // Keyboard navigation
        document.addEventListener('keydown', function(e) {
            // Left arrow - previous period
            if (e.key === 'ArrowLeft' && e.altKey) {
                document.querySelector('.cal-toolbar__nav-btn:first-child')?.click();
            }
            // Right arrow - next period
            if (e.key === 'ArrowRight' && e.altKey) {
                document.querySelector('.cal-toolbar__nav-btn:last-child')?.click();
            }
            // P key - print
            if (e.key === 'p' && e.ctrlKey) {
                e.preventDefault();
                window.print();
            }
        });
    </script>
}

@* All toolbar/layout CSS is now in wwwroot/css/calendar.css (.cal-toolbar, .cal-empty, .cal-filter-modal) *@
