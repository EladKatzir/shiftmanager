@page
@model ShiftManager.Pages.Calendar.MonthModel
@using ShiftManager.ViewComponents
@using ShiftManager.Models.ViewModels
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["Calendar_MyCalendar"] + " - " + Localizer["Month"];
}

@* ✅ PHASE 20: Include calendar inline editing JavaScript *@
<script src="~/js/calendar-inline-edit.js" asp-append-version="true"></script>

@* ✅ PHASE 20: Breadcrumb with "My Calendar" branding *@
@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Calendar_MyCalendar"], Url = "/Calendar/Month" },
    new BreadcrumbItem { Label = Localizer["Month"], IsActive = true }
})

<div data-ui-version="v2">
<div class="calendar-header">
    <div class="header-main">
        <h2>
            <span class="calendar-icon">📅</span>
            @Model.CurrentMonth.ToString("MMMM yyyy")
        </h2>
        @* ✅ PHASE 20: Show My Items toggle *@
        <div class="calendar-controls">
            @await Component.InvokeAsync("ShowMyItemsToggle")
        </div>
    </div>

    @* ✅ PHASE 20: Navigation *@
    <div class="calendar-nav">
        <a class="btn btn-ghost" href="/Calendar/Month?year=@Model.Previous.MonthYear.Year&month=@Model.Previous.MonthYear.Month">
            <span class="nav-icon">←</span>
            <span class="nav-text">@Model.Previous.Label</span>
        </a>
        <a class="btn btn-primary" href="/Calendar/Month">
            <span class="nav-icon">📅</span>
            <span class="nav-text"><loc key="Today" /></span>
        </a>
        <a class="btn btn-ghost" href="/Calendar/Month?year=@Model.Next.MonthYear.Year&month=@Model.Next.MonthYear.Month">
            <span class="nav-text">@Model.Next.Label</span>
            <span class="nav-icon">→</span>
        </a>
    </div>

    @* ✅ PHASE 7: Contextual Metrics - Tactical Truth *@
    @if (Model.TotalItemCount > 0)
    {
        <div class="calendar-metrics">
            <div class="metric-item metric-shifts">
                <span class="metric-icon">📅</span>
                <div class="metric-content">
                    <span class="metric-value">@Model.VisibleShiftCount</span>
                    <span class="metric-label"><loc key="Calendar_Shifts" /></span>
                </div>
            </div>

            @if (Model.VisibleChoreCount > 0)
            {
                <div class="metric-item metric-shifts">
                    <span class="metric-icon">🧹</span>
                    <div class="metric-content">
                        <span class="metric-value">@Model.VisibleChoreCount</span>
                        <span class="metric-label"><loc key="Calendar_Chores" /></span>
                    </div>
                </div>
            }

            @if (Model.VisibleOnDutyCount > 0)
            {
                <div class="metric-item metric-shifts">
                    <span class="metric-icon">🎯</span>
                    <div class="metric-content">
                        <span class="metric-value">@Model.VisibleOnDutyCount</span>
                        <span class="metric-label"><loc key="Calendar_OnDuty" /></span>
                    </div>
                </div>
            }

            @if (Model.PendingItemsCount > 0)
            {
                <div class="metric-item metric-pending">
                    <span class="metric-icon">⏳</span>
                    <div class="metric-content">
                        <span class="metric-value">@Model.PendingItemsCount</span>
                        <span class="metric-label"><loc key="Calendar_Pending" /></span>
                    </div>
                </div>
            }

            @if (User.IsInRole("Owner") || User.IsInRole("Manager") || User.IsInRole("Director"))
            {
                <div class="metric-item metric-coverage">
                    <span class="metric-icon">✅</span>
                    <div class="metric-content">
                        <span class="metric-value">@Model.CoveragePercent%</span>
                        <span class="metric-label"><loc key="Calendar_Coverage" /></span>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* ✅ PHASE 20: View switcher (removed Table link) *@
<div class="calendar-view-switcher">
    <a class="btn btn-primary" href="/Calendar/Month"><loc key="Month" /></a>
    <a class="btn btn-ghost" href="/Calendar/Week"><loc key="Week" /></a>
    <a class="btn btn-ghost" href="/Calendar/Day"><loc key="Day" /></a>
</div>

@* ✅ PHASE 20: Quick actions for managers *@
@if (User.IsInRole("Owner") || User.IsInRole("Manager") || User.IsInRole("Director"))
{
    <div class="calendar-quick-actions">
        <span class="quick-actions-label"><loc key="Calendar_QuickActions" />:</span>
        <a class="btn btn-secondary btn-sm" href="/Calendar/Table">
            <span>📊</span>
            <loc key="Calendar_ManageShifts" />
        </a>
        <a class="btn btn-secondary btn-sm" href="/Public/Chores">
            <span>🧹</span>
            <loc key="Calendar_ManageChores" />
        </a>
        <a class="btn btn-secondary btn-sm" href="/Public/OnDuty">
            <span>🛡️</span>
            <loc key="Calendar_ManageOnDuty" />
        </a>
    </div>
}

@* Hidden template for assignee select (rendered once, cloned via JS) *@
<select id="assignee-options-template" style="display: none;">
    <option value=""><loc key="Calendar_SelectAssignee" /></option>
    @foreach (var user in Model.EligibleAssignees)
    {
        <option value="@user.Id">@user.DisplayName</option>
    }
</select>

@* ✅ PHASE 20: Unified calendar grid *@
<div class="calendar-grid">
    <!-- Weekday headers -->
    <div class="calendar-weekdays">
        <div class="weekday-header"><loc key="Sun" /></div>
        <div class="weekday-header"><loc key="Mon" /></div>
        <div class="weekday-header"><loc key="Tue" /></div>
        <div class="weekday-header"><loc key="Wed" /></div>
        <div class="weekday-header"><loc key="Thu" /></div>
        <div class="weekday-header"><loc key="Fri" /></div>
        <div class="weekday-header"><loc key="Sat" /></div>
    </div>

    @* ✅ PHASE 20: Render calendar cells with unified items *@
    @foreach (var week in Model.Weeks)
    {
        @foreach (var day in week)
        {
            var isCurrentMonth = day.Date.Month == Model.CurrentMonth.Month;
            var today = DateOnly.FromDateTime(DateTime.Today);
            var isToday = day.Date == today;
            var isPastDate = day.Date < today;
            var cellClass = "calendar-cell";
            if (!isCurrentMonth) { cellClass += " other-month"; }
            if (isToday) { cellClass += " today"; }
            if (isPastDate) { cellClass += " past-date"; }

            <div class="@cellClass" data-date="@day.Date.ToString("yyyy-MM-dd")">
                <div class="cell-date">
                    @day.Date.Day
                    @if (isToday)
                    {
                        <span class="today-indicator">•</span>
                    }
                </div>

                @* ✅ PHASE 20: Render items with density control *@
                <div class="cell-items">
                    @{
                        var visibleItems = day.Items.Take(3).ToList();
                        var hiddenCount = Math.Max(0, day.Items.Count - 3);
                    }

                    @foreach (var item in visibleItems)
                    {
                        <div class="calendar-item @item.ColorClass @(item.IsCurrentUser ? "personal" : "other")"
                             title="@item.Details"
                             data-item-type="@item.Type.ToString().ToLower()"
                             data-item-id="@item.EntityId">
                            <div class="item-header">
                                <span class="item-icon">@item.Icon</span>
                                <span class="item-title">@item.Title</span>
                                @* ✅ PHASE 20: Delete button for chores and on-duty (managers only) *@
                                @if (User.IsInRole("Owner") || User.IsInRole("Manager") || User.IsInRole("Director"))
                                {
                                    @if (item.Type == CalendarItemType.Chore || item.Type == CalendarItemType.OnDuty)
                                    {
                                        <button class="btn-delete-item"
                                                onclick="deleteItem('@item.Type.ToString().ToLower()', @item.EntityId)"
                                                loc-title="Delete">
                                            ×
                                        </button>
                                    }
                                    else if (item.Type == CalendarItemType.Shift)
                                    {
                                        <a href="@item.ManagementUrl" class="item-manage-link" loc-title="Calendar_ManageShift">
                                            <span class="manage-icon">⚙️</span>
                                        </a>
                                    }
                                }
                            </div>
                            <div class="item-assignee">@item.AssigneeName</div>
                            @if (!string.IsNullOrEmpty(item.TimeRange))
                            {
                                <div class="item-time">@item.TimeRange</div>
                            }
                            @if (!string.IsNullOrEmpty(item.StaffingInfo))
                            {
                                <div class="item-staffing">@item.StaffingInfo</div>
                            }
                        </div>
                    }

                    @* ✅ PHASE 20: Show more button if > 3 items *@
                    @if (hiddenCount > 0)
                    {
                        <button class="show-more-btn"
                                onclick="toggleShowAll(this, '@day.Date.ToString("yyyy-MM-dd")')">
                            <span class="show-more-text">+@hiddenCount <loc key="Calendar_MoreItems" /></span>
                        </button>

                        @* Hidden items (shown when expanded) *@
                        <div class="hidden-items" style="display: none;">
                            @foreach (var item in day.Items.Skip(3))
                            {
                                <div class="calendar-item @item.ColorClass @(item.IsCurrentUser ? "personal" : "other")"
                                     title="@item.Details"
                                     data-item-type="@item.Type.ToString().ToLower()"
                                     data-item-id="@item.EntityId">
                                    <div class="item-header">
                                        <span class="item-icon">@item.Icon</span>
                                        <span class="item-title">@item.Title</span>
                                        @* ✅ PHASE 20: Delete button for chores and on-duty (managers only) *@
                                        @if (User.IsInRole("Owner") || User.IsInRole("Manager") || User.IsInRole("Director"))
                                        {
                                            @if (item.Type == CalendarItemType.Chore || item.Type == CalendarItemType.OnDuty)
                                            {
                                                <button class="btn-delete-item"
                                                        onclick="deleteItem('@item.Type.ToString().ToLower()', @item.EntityId)"
                                                        loc-title="Delete">
                                                    ×
                                                </button>
                                            }
                                            else if (item.Type == CalendarItemType.Shift)
                                            {
                                                <a href="@item.ManagementUrl" class="item-manage-link" loc-title="Calendar_ManageShift">
                                                    <span class="manage-icon">⚙️</span>
                                                </a>
                                            }
                                        }
                                    </div>
                                    <div class="item-assignee">@item.AssigneeName</div>
                                    @if (!string.IsNullOrEmpty(item.TimeRange))
                                    {
                                        <div class="item-time">@item.TimeRange</div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.StaffingInfo))
                                    {
                                        <div class="item-staffing">@item.StaffingInfo</div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @* ✅ PHASE 20: Quick-add form (managers only) *@
                    @if (User.IsInRole("Owner") || User.IsInRole("Manager") || User.IsInRole("Director"))
                    {
                        <div class="quick-add-container">
                            <button class="btn-quick-add" onclick="toggleQuickAdd('chore', '@day.Date.ToString("yyyy-MM-dd")')">
                                + <loc key="Calendar_AddChore" />
                            </button>
                            <button class="btn-quick-add" onclick="toggleQuickAdd('onduty', '@day.Date.ToString("yyyy-MM-dd")')">
                                + <loc key="Calendar_AddOnDuty" />
                            </button>
                        </div>

                        <div id="quickAddForm-@day.Date.ToString("yyyy-MM-dd")" class="quick-add-form hidden" data-type="">
                            <select id="assigneeSelect-@day.Date.ToString("yyyy-MM-dd")" class="form-select form-select-sm assignee-select-clone">
                                @* Options will be cloned from template via JavaScript *@
                            </select>

                            <div id="choreFields-@day.Date.ToString("yyyy-MM-dd")" class="hidden">
                                <input type="text"
                                       id="choreTitle-@day.Date.ToString("yyyy-MM-dd")"
                                       loc-placeholder="Calendar_ChoreTitle"
                                       class="form-control form-control-sm"
                                       maxlength="200" />
                            </div>

                            <div id="ondutyFields-@day.Date.ToString("yyyy-MM-dd")" class="hidden">
                                <select id="ondutyType-@day.Date.ToString("yyyy-MM-dd")" class="form-select form-select-sm">
                                    <option value="0"><loc key="OnDuty_Hakam" /></option>
                                    <option value="1"><loc key="OnDuty_Lead" /></option>
                                    @foreach (var customType in Model.CustomOnDutyTypes)
                                    {
                                        var cultureName = System.Globalization.CultureInfo.CurrentUICulture.Name;
                                        var displayName = cultureName.StartsWith("he") ? customType.NameHe : customType.NameEn;
                                        <option value="@customType.TypeValue">@displayName</option>
                                    }
                                </select>
                            </div>

                            <div class="quick-add-actions">
                                <button class="btn btn-sm btn-primary" onclick="submitQuickAdd('@day.Date.ToString("yyyy-MM-dd")')">
                                    <loc key="Add" />
                                </button>
                                <button class="btn btn-sm btn-ghost" onclick="toggleQuickAdd('', '@day.Date.ToString("yyyy-MM-dd")')">
                                    <loc key="Cancel" />
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>
</div>

@* ✅ PHASE 20: JavaScript for show more/less functionality *@
@section Scripts {
    <script>
        // Clone assignee options from template to all dropdowns (performance optimization)
        document.addEventListener('DOMContentLoaded', function() {
            const template = document.getElementById('assignee-options-template');
            if (template) {
                const selects = document.querySelectorAll('.assignee-select-clone');
                selects.forEach(select => {
                    // Clone all options from template
                    const options = template.querySelectorAll('option');
                    options.forEach(option => {
                        select.appendChild(option.cloneNode(true));
                    });
                });
            }
        });

        // ✅ PHASE 20: Toggle showing all items in a day cell
        function toggleShowAll(button, dateStr) {
            const cell = document.querySelector(`[data-date="${dateStr}"]`);
            if (!cell) return;

            const hiddenItems = cell.querySelector('.hidden-items');
            const btnText = button.querySelector('.show-more-text');

            if (hiddenItems.style.display === 'none') {
                // Show all
                hiddenItems.style.display = 'block';
                button.classList.add('expanded');
                btnText.textContent = '<loc key="Calendar_ShowLess" />';
            } else {
                // Hide extra items
                hiddenItems.style.display = 'none';
                button.classList.remove('expanded');
                const hiddenCount = hiddenItems.querySelectorAll('.calendar-item').length;
                btnText.textContent = `+${hiddenCount} <loc key="Calendar_MoreItems" />`;
            }
        }
    </script>
}

@* ✅ PHASE 20: Page-specific styles *@
@section Styles {
    <style>
        /* ✅ PHASE 20: Calendar item cards */
        .calendar-item {
            position: relative;
            background: var(--bg);
            border: 2px solid var(--border);
            border-radius: 8px;
            padding: 8px;
            margin-bottom: 6px;
            font-size: 0.85rem;
            transition: all 0.2s ease;
        }

        .calendar-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        /* ✅ PHASE 20: Personal items highlighted */
        .calendar-item.personal {
            border-width: 3px;
            border-color: var(--primary);
            background: linear-gradient(135deg, var(--bg), rgba(var(--primary-rgb), 0.05));
            font-weight: 600;
        }

        /* ✅ PHASE 20: Other items muted */
        .calendar-item.other {
            opacity: 0.7;
        }

        /* ✅ PHASE 20: Type-specific colors */
        .calendar-item.shift-morning { border-left: 4px solid #FF6B6B; }
        .calendar-item.shift-middle { border-left: 4px solid #4ECDC4; }
        .calendar-item.shift-noon { border-left: 4px solid #FFE66D; }
        .calendar-item.shift-night { border-left: 4px solid #95E1D3; }
        .calendar-item.chore-green { border-left: 4px solid #51CF66; }
        .calendar-item.onduty-hakam { border-left: 4px solid #845EC2; }
        .calendar-item.onduty-lead { border-left: 4px solid #FF9671; }

        .item-header {
            display: flex;
            align-items: center;
            gap: 4px;
            margin-bottom: 4px;
        }

        .item-icon {
            font-size: 1rem;
        }

        .item-title {
            font-weight: 600;
            flex: 1;
        }

        .item-assignee {
            color: var(--text);
            font-size: 0.8rem;
        }

        .item-time, .item-staffing {
            color: var(--muted);
            font-size: 0.75rem;
            margin-top: 2px;
        }

        .item-manage-link {
            position: absolute;
            top: 4px;
            right: 4px;
            opacity: 0;
            transition: opacity 0.2s;
        }

        .calendar-item:hover .item-manage-link {
            opacity: 1;
        }

        .manage-icon {
            font-size: 0.9rem;
        }

        /* ✅ PHASE 20: Show more button */
        .show-more-btn {
            width: 100%;
            padding: 6px;
            background: var(--surface);
            border: 1px dashed var(--border);
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.8rem;
            color: var(--primary);
            transition: all 0.2s;
        }

        .show-more-btn:hover {
            background: var(--surface-soft);
            border-color: var(--primary);
        }

        .show-more-btn.expanded {
            background: var(--primary);
            color: white;
            border-style: solid;
        }

        .hidden-items {
            margin-top: 6px;
        }

        /* ✅ PHASE 20: Quick actions bar */
        .calendar-quick-actions {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 1rem;
            background: var(--surface-soft);
            border-radius: 8px;
            margin-bottom: 1rem;
        }

        .quick-actions-label {
            font-weight: 600;
            color: var(--muted);
            margin-right: 0.5rem;
        }

        /* ✅ PHASE 20: Calendar controls */
        .calendar-controls {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .today-indicator {
            color: var(--primary);
            font-size: 1.5rem;
            margin-left: 4px;
        }
    </style>
}
