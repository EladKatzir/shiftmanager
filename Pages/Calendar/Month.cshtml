@page
@model ShiftManager.Pages.Calendar.MonthModel
@using ShiftManager.ViewComponents
@using ShiftManager.Models.ViewModels
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["Calendar_MyCalendar"] + " - " + Localizer["Month"];
}

@* ✅ PHASE 20: Include calendar inline editing JavaScript *@
<script src="~/js/calendar-inline-edit.js" asp-append-version="true"></script>

@* ✅ PHASE 20: Breadcrumb with "My Calendar" branding *@
@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Calendar_MyCalendar"], Url = "/Calendar/Month" },
    new BreadcrumbItem { Label = Localizer["Month"], IsActive = true }
})

@* B-007: Calendar Skeleton Loading Container *@
<div class="calendar-skeleton-container" data-calendar-skeleton-container>
    @await Component.InvokeAsync("CalendarSkeleton", new { viewType = "month", cellCount = 35 })
    <div data-ui-version="v2" data-calendar-content class="calendar-content">
<div class="calendar-header">
    <div class="header-main">
        <h2>
            <span class="calendar-icon"><i data-lucide="calendar"></i></span>
            @Model.CurrentMonth.ToString("MMMM yyyy")
        </h2>
        @* ✅ PHASE 20: Show My Items toggle *@
        <div class="calendar-controls">
            @await Component.InvokeAsync("ShowMyItemsToggle")

            @* Export dropdown *@
            <div class="export-dropdown no-print" id="exportDropdown">
                <button type="button" class="btn btn-secondary" id="exportBtn" aria-haspopup="true" aria-expanded="false">
                    <i data-lucide="download"></i>
                    <span><loc key="Export" /></span>
                </button>
                <div class="dropdown-menu" id="exportMenu" role="menu">
                    <button type="button" class="dropdown-item" data-format="pdf" role="menuitem">
                        <i data-lucide="file-text"></i>
                        <span>PDF</span>
                    </button>
                    <button type="button" class="dropdown-item" data-format="excel" role="menuitem">
                        <i data-lucide="file-spreadsheet"></i>
                        <span>Excel</span>
                    </button>
                    <button type="button" class="dropdown-item" data-format="csv" role="menuitem">
                        <i data-lucide="file"></i>
                        <span>CSV</span>
                    </button>
                    <div class="dropdown-divider"></div>
                    <button type="button" class="dropdown-item" id="printBtn" role="menuitem">
                        <i data-lucide="printer"></i>
                        <span><loc key="Action_Print" /></span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* ✅ PHASE 20: Navigation *@
    <div class="calendar-nav">
        <a class="btn btn-ghost" href="/Calendar/Month?year=@Model.Previous.MonthYear.Year&month=@Model.Previous.MonthYear.Month">
            <span class="nav-icon">←</span>
            <span class="nav-text">@Model.Previous.Label</span>
        </a>
        <a class="btn btn-primary" href="/Calendar/Month">
            <span class="nav-icon"><i data-lucide="calendar-check"></i></span>
            <span class="nav-text"><loc key="Today" /></span>
        </a>
        <a class="btn btn-ghost" href="/Calendar/Month?year=@Model.Next.MonthYear.Year&month=@Model.Next.MonthYear.Month">
            <span class="nav-text">@Model.Next.Label</span>
            <span class="nav-icon">→</span>
        </a>
    </div>

    @* ✅ PHASE 7: Contextual Metrics - Tactical Truth *@
    @if (Model.TotalItemCount > 0)
    {
        <div class="calendar-metrics">
            <div class="metric-item metric-shifts">
                <span class="metric-icon"><i data-lucide="calendar"></i></span>
                <div class="metric-content">
                    <span class="metric-value">@Model.VisibleShiftCount</span>
                    <span class="metric-label"><loc key="Calendar_Shifts" /></span>
                </div>
            </div>

            @if (Model.VisibleChoreCount > 0)
            {
                <div class="metric-item metric-shifts">
                    <span class="metric-icon"><i data-lucide="brush"></i></span>
                    <div class="metric-content">
                        <span class="metric-value">@Model.VisibleChoreCount</span>
                        <span class="metric-label"><loc key="Calendar_Chores" /></span>
                    </div>
                </div>
            }

            @if (Model.VisibleOnDutyCount > 0)
            {
                <div class="metric-item metric-shifts">
                    <span class="metric-icon"><i data-lucide="target"></i></span>
                    <div class="metric-content">
                        <span class="metric-value">@Model.VisibleOnDutyCount</span>
                        <span class="metric-label"><loc key="Calendar_OnDuty" /></span>
                    </div>
                </div>
            }

            @if (Model.PendingItemsCount > 0)
            {
                <div class="metric-item metric-pending">
                    <span class="metric-icon"><i data-lucide="clock"></i></span>
                    <div class="metric-content">
                        <span class="metric-value">@Model.PendingItemsCount</span>
                        <span class="metric-label"><loc key="Calendar_Pending" /></span>
                    </div>
                </div>
            }

            <require-grant key="ViewAnalytics">
            <div class="metric-item metric-coverage">
                <span class="metric-icon"><i data-lucide="check-circle"></i></span>
                <div class="metric-content">
                    <span class="metric-value">@Model.CoveragePercent%</span>
                    <span class="metric-label"><loc key="Calendar_Coverage" /></span>
                </div>
            </div>
            </require-grant>
        </div>
    }
</div>

@* ✅ PHASE 20: View switcher (removed Table link) *@
<div class="calendar-view-switcher">
    <a class="btn btn-primary" href="/Calendar/Month"><loc key="Month" /></a>
    <a class="btn btn-ghost" href="/Calendar/Week"><loc key="Week" /></a>
    <a class="btn btn-ghost" href="/Calendar/Day"><loc key="Day" /></a>
</div>

@* ✅ UI Overhaul: Scope Switcher (Mine/Company/Molecule) - reads from URL/cookie *@
@await Component.InvokeAsync("ScopeSwitcher", new { calendarType = "shifts" })

@* ✅ PHASE 20: Quick actions - Grant protected *@
<require-grant key="ViewShifts,ViewChores,ViewDuties" mode="any">
<div class="calendar-quick-actions">
    <span class="quick-actions-label"><loc key="Calendar_QuickActions" />:</span>
    <require-grant key="ViewShifts">
    <a class="btn btn-secondary btn-sm" href="/Calendar/Table">
        <i data-lucide="bar-chart-3" class="btn-icon"></i>
        <loc key="Calendar_ManageShifts" />
    </a>
    </require-grant>
    <require-grant key="ViewChores">
    <a class="btn btn-secondary btn-sm" href="/Public/Chores">
        <i data-lucide="brush" class="btn-icon"></i>
        <loc key="Calendar_ManageChores" />
    </a>
    </require-grant>
    <require-grant key="ViewDuties">
    <a class="btn btn-secondary btn-sm" href="/Public/OnDuty">
        <i data-lucide="shield" class="btn-icon"></i>
        <loc key="Calendar_ManageOnDuty" />
    </a>
    </require-grant>
</div>
</require-grant>

@* Hidden template for assignee select (rendered once, cloned via JS) *@
<select id="assignee-options-template" class="calendar-template-hidden">
    <option value="">@Localizer["Calendar_SelectAssignee"]</option>
    @foreach (var user in Model.EligibleAssignees)
    {
        <option value="@user.Id">@user.DisplayName</option>
    }
</select>

@* ✅ UI Overhaul: Overall empty state for month view *@
@if (Model.TotalItemCount == 0)
{
    <div class="calendar-empty">
        <div class="calendar-empty__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
                <line x1="9" y1="14" x2="15" y2="14"></line>
                <line x1="9" y1="18" x2="15" y2="18"></line>
            </svg>
        </div>
        <h3 class="calendar-empty__title"><loc key="Calendar_Empty_NoShiftsMonth" /></h3>
        <p class="calendar-empty__message">
            @if (Model.ShowMyItemsOnly)
            {
                <loc key="Calendar_Empty_Subtitle_Mine" />
            }
            else
            {
                <loc key="Calendar_Empty_Subtitle_All" />
            }
        </p>
        <div class="calendar-empty__actions">
            @if (Model.ShowMyItemsOnly)
            {
                <a href="/Calendar/Month?year=@Model.CurrentMonth.Year&month=@Model.CurrentMonth.Month&showMyItems=false" class="btn btn-secondary">
                    <loc key="Calendar_Empty_Action_ViewAll" />
                </a>
            }
            <require-grant key="AssignAlhutShifts,AssignTextShifts,AssignBRShifts,AssignTechShifts" mode="any">
            <a href="/Calendar/Table" class="btn btn-primary">
                <loc key="Calendar_Empty_Action_CreateShift" />
            </a>
            </require-grant>
            @{
                var todayMonth = new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1);
            }
            @if (Model.CurrentMonth != todayMonth)
            {
                <a href="/Calendar/Month" class="btn btn-ghost">
                    <loc key="Calendar_Empty_Action_GoToToday" />
                </a>
            }
        </div>
    </div>
}

@* A-013: Screen reader announcer for keyboard navigation *@
<div id="calendar-announcer" class="sr-only" aria-live="polite" aria-atomic="true"></div>

@* ✅ PHASE 20: Unified calendar grid *@
@* A-004: Responsive calendar grid with abbreviated day names for mobile *@
<div class="calendar-grid @(Model.TotalItemCount == 0 ? "calendar-grid--empty" : "")" role="grid" aria-label="@Localizer["Calendar_MonthView"]">
    <!-- Weekday headers with responsive abbreviations -->
    <!-- data-day-full: Full name, data-day-abbr: 3-letter, data-day-letter: single letter for mobile -->
    <div class="calendar-weekdays" role="row">
        <div class="weekday-header" role="columnheader" data-day-full="Sunday" data-day-abbr="Sun" data-day-letter="S">
            <span class="day-full"><loc key="Sun" /></span>
            <span class="day-abbr" aria-hidden="true">S</span>
        </div>
        <div class="weekday-header" role="columnheader" data-day-full="Monday" data-day-abbr="Mon" data-day-letter="M">
            <span class="day-full"><loc key="Mon" /></span>
            <span class="day-abbr" aria-hidden="true">M</span>
        </div>
        <div class="weekday-header" role="columnheader" data-day-full="Tuesday" data-day-abbr="Tue" data-day-letter="T">
            <span class="day-full"><loc key="Tue" /></span>
            <span class="day-abbr" aria-hidden="true">T</span>
        </div>
        <div class="weekday-header" role="columnheader" data-day-full="Wednesday" data-day-abbr="Wed" data-day-letter="W">
            <span class="day-full"><loc key="Wed" /></span>
            <span class="day-abbr" aria-hidden="true">W</span>
        </div>
        <div class="weekday-header" role="columnheader" data-day-full="Thursday" data-day-abbr="Thu" data-day-letter="T">
            <span class="day-full"><loc key="Thu" /></span>
            <span class="day-abbr" aria-hidden="true">T</span>
        </div>
        <div class="weekday-header" role="columnheader" data-day-full="Friday" data-day-abbr="Fri" data-day-letter="F">
            <span class="day-full"><loc key="Fri" /></span>
            <span class="day-abbr" aria-hidden="true">F</span>
        </div>
        <div class="weekday-header" role="columnheader" data-day-full="Saturday" data-day-abbr="Sat" data-day-letter="S">
            <span class="day-full"><loc key="Sat" /></span>
            <span class="day-abbr" aria-hidden="true">S</span>
        </div>
    </div>

    @* ✅ PHASE 20: Render calendar cells with unified items *@
    @foreach (var week in Model.Weeks)
    {
        @foreach (var day in week)
        {
            var isCurrentMonth = day.Date.Month == Model.CurrentMonth.Month;
            var today = DateOnly.FromDateTime(DateTime.Today);
            var isToday = day.Date == today;
            var isPastDate = day.Date < today;
            var cellClass = "calendar-cell";
            if (!isCurrentMonth) { cellClass += " other-month"; }
            if (isToday) { cellClass += " today"; }
            if (isPastDate) { cellClass += " past-date"; }

            <div class="@cellClass" role="gridcell" tabindex="@(isToday ? "0" : "-1")" data-date="@day.Date.ToString("yyyy-MM-dd")" data-day-name="@day.Date.ToString("ddd")" aria-label="@day.Date.ToString("MMMM d, yyyy")">
                <div class="cell-date">
                    @day.Date.Day
                    @if (isToday)
                    {
                        <span class="today-indicator">•</span>
                    }
                </div>

                @* ✅ PHASE 20: Render items with density control *@
                <div class="cell-items">
                    @{
                        var visibleItems = day.Items.Take(3).ToList();
                        var hiddenCount = Math.Max(0, day.Items.Count - 3);
                    }

                    @foreach (var item in visibleItems)
                    {
                        <div class="calendar-item @item.ColorClass @(item.IsCurrentUser ? "personal" : "other")"
                             title="@item.Details"
                             data-item-type="@item.Type.ToString().ToLower()"
                             data-item-id="@item.EntityId">
                            <div class="item-header">
                                <span class="item-icon">@item.Icon</span>
                                <span class="item-title">@item.Title</span>
                                @* ✅ PHASE 20: Delete button for chores and on-duty - Grant protected *@
                                @if (item.Type == CalendarItemType.Chore)
                                {
                                    <require-grant key="AssignChores">
                                    <button class="btn-delete-item"
                                            onclick="deleteItem('@item.Type.ToString().ToLower()', @item.EntityId)"
                                            loc-title="Delete">
                                        ×
                                    </button>
                                    </require-grant>
                                }
                                else if (item.Type == CalendarItemType.OnDuty)
                                {
                                    <require-grant key="AssignHakamDuties,AssignKatzinDuties" mode="any">
                                    <button class="btn-delete-item"
                                            onclick="deleteItem('@item.Type.ToString().ToLower()', @item.EntityId)"
                                            loc-title="Delete">
                                        ×
                                    </button>
                                    </require-grant>
                                }
                                else if (item.Type == CalendarItemType.Shift)
                                {
                                    <require-grant key="AssignAlhutShifts,AssignTextShifts,AssignBRShifts,AssignTechShifts" mode="any">
                                    <a href="@item.ManagementUrl" class="item-manage-link" loc-title="Calendar_ManageShift">
                                        <span class="manage-icon">⚙️</span>
                                    </a>
                                    </require-grant>
                                }
                            </div>
                            <div class="item-assignee">@item.AssigneeName</div>
                            @if (!string.IsNullOrEmpty(item.TimeRange))
                            {
                                <div class="item-time">@item.TimeRange</div>
                            }
                            @if (!string.IsNullOrEmpty(item.StaffingInfo))
                            {
                                <div class="item-staffing">@item.StaffingInfo</div>
                            }
                        </div>
                    }

                    @* ✅ PHASE 20: Show more button if > 3 items *@
                    @if (hiddenCount > 0)
                    {
                        <button class="show-more-btn"
                                onclick="toggleShowAll(this, '@day.Date.ToString("yyyy-MM-dd")')">
                            <span class="show-more-text">+@hiddenCount <loc key="Calendar_MoreItems" /></span>
                        </button>

                        @* Hidden items (shown when expanded) *@
                        <div class="hidden-items calendar-hidden-items">
                            @foreach (var item in day.Items.Skip(3))
                            {
                                <div class="calendar-item @item.ColorClass @(item.IsCurrentUser ? "personal" : "other")"
                                     title="@item.Details"
                                     data-item-type="@item.Type.ToString().ToLower()"
                                     data-item-id="@item.EntityId">
                                    <div class="item-header">
                                        <span class="item-icon">@item.Icon</span>
                                        <span class="item-title">@item.Title</span>
                                        @* ✅ PHASE 20: Delete button for chores and on-duty - Grant protected *@
                                        @if (item.Type == CalendarItemType.Chore)
                                        {
                                            <require-grant key="AssignChores">
                                            <button class="btn-delete-item"
                                                    onclick="deleteItem('@item.Type.ToString().ToLower()', @item.EntityId)"
                                                    loc-title="Delete">
                                                ×
                                            </button>
                                            </require-grant>
                                        }
                                        else if (item.Type == CalendarItemType.OnDuty)
                                        {
                                            <require-grant key="AssignHakamDuties,AssignKatzinDuties" mode="any">
                                            <button class="btn-delete-item"
                                                    onclick="deleteItem('@item.Type.ToString().ToLower()', @item.EntityId)"
                                                    loc-title="Delete">
                                                ×
                                            </button>
                                            </require-grant>
                                        }
                                        else if (item.Type == CalendarItemType.Shift)
                                        {
                                            <require-grant key="AssignAlhutShifts,AssignTextShifts,AssignBRShifts,AssignTechShifts" mode="any">
                                            <a href="@item.ManagementUrl" class="item-manage-link" loc-title="Calendar_ManageShift">
                                                <span class="manage-icon">⚙️</span>
                                            </a>
                                            </require-grant>
                                        }
                                    </div>
                                    <div class="item-assignee">@item.AssigneeName</div>
                                    @if (!string.IsNullOrEmpty(item.TimeRange))
                                    {
                                        <div class="item-time">@item.TimeRange</div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.StaffingInfo))
                                    {
                                        <div class="item-staffing">@item.StaffingInfo</div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @* ✅ PHASE 20: Quick-add form - Grant protected *@
                    <require-grant key="AssignChores,AssignHakamDuties,AssignKatzinDuties" mode="any">
                    <div class="quick-add-container">
                        <require-grant key="AssignChores">
                        <button class="btn-quick-add" onclick="toggleQuickAdd('chore', '@day.Date.ToString("yyyy-MM-dd")')">
                            + <loc key="Calendar_AddChore" />
                        </button>
                        </require-grant>
                        <require-grant key="AssignHakamDuties,AssignKatzinDuties" mode="any">
                        <button class="btn-quick-add" onclick="toggleQuickAdd('onduty', '@day.Date.ToString("yyyy-MM-dd")')">
                            + <loc key="Calendar_AddOnDuty" />
                        </button>
                        </require-grant>
                    </div>
                    </require-grant>

                        <div id="quickAddForm-@day.Date.ToString("yyyy-MM-dd")" class="quick-add-form hidden" data-type="">
                            <select id="assigneeSelect-@day.Date.ToString("yyyy-MM-dd")" class="form-select form-select-sm assignee-select-clone">
                                @* Options will be cloned from template via JavaScript *@
                            </select>

                            <div id="choreFields-@day.Date.ToString("yyyy-MM-dd")" class="hidden">
                                <input type="text"
                                       id="choreTitle-@day.Date.ToString("yyyy-MM-dd")"
                                       loc-placeholder="Calendar_ChoreTitle"
                                       class="form-control form-control-sm"
                                       maxlength="200" />
                            </div>

                            <div id="ondutyFields-@day.Date.ToString("yyyy-MM-dd")" class="hidden">
                                <select id="ondutyType-@day.Date.ToString("yyyy-MM-dd")" class="form-select form-select-sm">
                                    <option value="0">@Localizer["OnDuty_Hakam"]</option>
                                    <option value="1">@Localizer["OnDuty_Lead"]</option>
                                    @foreach (var customType in Model.CustomOnDutyTypes)
                                    {
                                        var cultureName = System.Globalization.CultureInfo.CurrentUICulture.Name;
                                        var displayName = cultureName.StartsWith("he") ? customType.NameHe : customType.NameEn;
                                        <option value="@customType.TypeValue">@displayName</option>
                                    }
                                </select>
                            </div>

                            <div class="quick-add-actions">
                                <button class="btn btn-sm btn-primary" onclick="submitQuickAdd('@day.Date.ToString("yyyy-MM-dd")')">
                                    <loc key="Add" />
                                </button>
                                <button class="btn btn-sm btn-ghost" onclick="toggleQuickAdd('', '@day.Date.ToString("yyyy-MM-dd")')">
                                    <loc key="Cancel" />
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>
</div>
    </div>@* End calendar-content *@
</div>@* End calendar-skeleton-container *@

@* ✅ PHASE 20: JavaScript for show more/less functionality *@
@section Scripts {
    <script>
        // Export dropdown functionality
        (function() {
            'use strict';

            var exportBtn = document.getElementById('exportBtn');
            var exportMenu = document.getElementById('exportMenu');
            var printBtn = document.getElementById('printBtn');

            if (!exportBtn || !exportMenu) return;

            // Toggle dropdown menu visibility
            exportBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                var isExpanded = exportMenu.classList.toggle('show');
                exportBtn.setAttribute('aria-expanded', isExpanded);
            });

            // Close dropdown when clicking outside
            document.addEventListener('click', function(e) {
                if (!e.target.closest('#exportDropdown')) {
                    exportMenu.classList.remove('show');
                    exportBtn.setAttribute('aria-expanded', 'false');
                }
            });

            // Close on escape
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && exportMenu.classList.contains('show')) {
                    exportMenu.classList.remove('show');
                    exportBtn.setAttribute('aria-expanded', 'false');
                    exportBtn.focus();
                }
            });

            // Print button handler
            if (printBtn) {
                printBtn.addEventListener('click', function() {
                    exportMenu.classList.remove('show');
                    exportBtn.setAttribute('aria-expanded', 'false');
                    window.print();
                });
            }

            // Export handlers
            var formatMap = { pdf: 0, excel: 1, csv: 2 };
            var startDate = '@Model.StartDate.ToString("yyyy-MM-dd")';
            var endDate = '@Model.EndDate.ToString("yyyy-MM-dd")';

            document.querySelectorAll('[data-format]').forEach(function(btn) {
                btn.addEventListener('click', async function() {
                    var format = this.dataset.format;

                    var request = {
                        format: formatMap[format],
                        period: 1, // Month
                        startDate: startDate,
                        endDate: endDate,
                        includeEmployeeNames: true,
                        includeChores: true,
                        includeOnDuty: true
                    };

                    try {
                        // Show loading state
                        btn.disabled = true;
                        btn.innerHTML = '<i data-lucide="loader-2" class="spin"></i> <span>@Localizer["Loading"]</span>';
                        if (typeof lucide !== 'undefined') lucide.createIcons();

                        var response = await fetch('/Api/ScheduleExport', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'same-origin',
                            body: JSON.stringify(request)
                        });

                        if (response.ok) {
                            var blob = await response.blob();
                            var url = URL.createObjectURL(blob);
                            var a = document.createElement('a');
                            a.href = url;
                            var ext = format === 'excel' ? 'xlsx' : format;
                            a.download = 'schedule-' + startDate + '.' + ext;
                            document.body.appendChild(a);
                            a.click();
                            document.body.removeChild(a);
                            URL.revokeObjectURL(url);

                            // Show success toast if available
                            if (window.showToast) {
                                window.showToast('@Localizer["Success_ExportDownloaded"]', 'success');
                            }
                        } else {
                            console.error('Export failed:', response.statusText);
                            if (window.showToast) {
                                window.showToast('@Localizer["Error_ExportFailed"]' + response.statusText, 'error');
                            }
                        }
                    } catch (error) {
                        console.error('Export failed:', error);
                        if (window.showToast) {
                            window.showToast('@Localizer["Error_ExportFailed"]' + error.message, 'error');
                        }
                    } finally {
                        // Restore button state
                        btn.disabled = false;
                        var iconName = format === 'pdf' ? 'file-text' : (format === 'excel' ? 'file-spreadsheet' : 'file');
                        btn.innerHTML = '<i data-lucide="' + iconName + '"></i> <span>' + format.toUpperCase() + '</span>';
                        if (typeof lucide !== 'undefined') lucide.createIcons();

                        // Close dropdown
                        exportMenu.classList.remove('show');
                        exportBtn.setAttribute('aria-expanded', 'false');
                    }
                });
            });
        })();

        // Clone assignee options from template to all dropdowns (performance optimization)
        document.addEventListener('DOMContentLoaded', function() {
            const template = document.getElementById('assignee-options-template');
            if (template) {
                const selects = document.querySelectorAll('.assignee-select-clone');
                selects.forEach(select => {
                    // Clone all options from template
                    const options = template.querySelectorAll('option');
                    options.forEach(option => {
                        select.appendChild(option.cloneNode(true));
                    });
                });
            }

            // B-007: Signal calendar content is ready
            const calendarContent = document.querySelector('[data-calendar-content]');
            if (calendarContent && window.CalendarSkeleton) {
                window.CalendarSkeleton.signalReady(calendarContent);
            }
        });

        // ✅ PHASE 20: Toggle showing all items in a day cell
        function toggleShowAll(button, dateStr) {
            const cell = document.querySelector(`[data-date="${dateStr}"]`);
            if (!cell) return;

            const hiddenItems = cell.querySelector('.hidden-items');
            const btnText = button.querySelector('.show-more-text');

            if (!hiddenItems.classList.contains('is-visible')) {
                // Show all
                hiddenItems.classList.add('is-visible');
                button.classList.add('expanded');
                btnText.textContent = '@Localizer["Calendar_ShowLess"]';
            } else {
                // Hide extra items
                hiddenItems.classList.remove('is-visible');
                button.classList.remove('expanded');
                const hiddenCount = hiddenItems.querySelectorAll('.calendar-item').length;
                btnText.textContent = `+${hiddenCount} @Localizer["Calendar_MoreItems"]`;
            }
        }

        // B-037: Initialize calendar keyboard navigation
        document.addEventListener('DOMContentLoaded', function() {
            const calendarGrid = document.querySelector('.calendar-grid');
            if (calendarGrid && window.KeyboardNav) {
                window.KeyboardNav.initCalendar({
                    grid: calendarGrid,
                    cellSelector: '.calendar-cell:not(.other-month)',
                    onNavigate: function(cell) {
                        // Announce date to screen readers
                        const date = cell.getAttribute('data-date');
                        if (date) {
                            const dateObj = new Date(date);
                            const announcement = dateObj.toLocaleDateString(undefined, {
                                weekday: 'long',
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric'
                            });
                            // Update ARIA live region if present
                            const liveRegion = document.getElementById('calendar-announcer');
                            if (liveRegion) {
                                liveRegion.textContent = announcement;
                            }
                        }
                    },
                    onSelect: function(cell) {
                        // Click the first clickable element in the cell
                        const dateLink = cell.querySelector('.calendar-item, button, a');
                        if (dateLink) {
                            dateLink.click();
                        } else {
                            // If no items, trigger quick add if available
                            const quickAddBtn = cell.querySelector('[onclick*="toggleQuickAdd"]');
                            if (quickAddBtn) {
                                quickAddBtn.click();
                            }
                        }
                    }
                });
            }
        });
    </script>
}

