@page
@model ShiftManager.Pages.Calendar.ChoresModel
@using ShiftManager.ViewComponents
@using ShiftManager.Pages.Shared
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@inject IStringLocalizer<SharedResources> Localizer
@inject ShiftManager.Services.ILocalizationService Localization
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["ChoresCalendar"];
    var _isHebrewLocale = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("he");
    string LocalizeCt(ShiftManager.Models.ChoreType ct) =>
        _isHebrewLocale && !string.IsNullOrWhiteSpace(ct.NameHe) ? ct.NameHe : ct.NameEn ?? ct.DisplayName;
}

@* Breadcrumb *@
@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Calendars"], Url = "/Calendar/Month" },
    new BreadcrumbItem { Label = Localizer["ChoresCalendar"], IsActive = true }
})

<div class="cal-page" data-ui-version="v2" data-justice-molecule-id="@Model.MoleculeId">
    @* Toolbar — Row 1: Selectors + Date Nav + Print *@
    <div class="cal-toolbar">
        <div class="cal-toolbar__row">
            <div class="cal-toolbar__selector cal-toolbar__primary">
                <label for="moleculeSelect">@Localizer["Molecule"]</label>
                <select id="moleculeSelect" class="form-select" onchange="updateCalendarFilters()">
                    @foreach (var molecule in Model.AvailableMolecules)
                    {
                        var isSelected = molecule.Id == Model.MoleculeId;
                        <option value="@molecule.Id" selected="@isSelected">@molecule.DisplayName</option>
                    }
                </select>
            </div>

            @if (Model.ChoreTypes.Any())
            {
                <div class="cal-toolbar__selector">
                    <label for="choreTypeSelect">@Localizer["ChoreType"]</label>
                    <select id="choreTypeSelect" class="form-select" onchange="updateCalendarFilters()">
                        <option value="">@Localizer["All"]</option>
                        @foreach (var choreType in Model.ChoreTypes)
                        {
                            var isSelected = choreType.Id == Model.ChoreTypeFilter;
                            <option value="@choreType.Id" selected="@isSelected">@LocalizeCt(choreType)</option>
                        }
                    </select>
                </div>
            }

            <div class="cal-toolbar__selector cal-toolbar__primary">
                <label for="viewModeSelect">@Localizer["ViewMode"]</label>
                <select id="viewModeSelect" class="form-select" onchange="updateCalendarFilters()">
                    <option value="week" selected="@(Model.ViewMode == "week")">@Localizer["Week"]</option>
                    <option value="next7" selected="@(Model.ViewMode == "next7")">@Localizer["Next7Days"]</option>
                    <option value="2weeks" selected="@(Model.ViewMode == "2weeks")">@Localizer["TwoWeeks"]</option>
                    <option value="month" selected="@(Model.ViewMode == "month")">@Localizer["Month"]</option>
                </select>
            </div>

            <div class="cal-toolbar__date-nav cal-toolbar__primary">
                <a href="?MoleculeId=@Model.MoleculeId&Start=@Model.PreviousStart&ViewMode=@Model.ViewMode&ChoreTypeFilter=@Model.ChoreTypeFilter"
                   class="btn btn-ghost cal-toolbar__nav-btn"
                   data-cal-nav="prev"
                   title="@Localizer["Previous"]">
                    <span class="nav-icon">&larr;</span>
                    <span class="nav-text">@Localizer["Previous"]</span>
                </a>

                <div class="cal-toolbar__date-display">
                    <input type="date"
                           id="datePickerInput"
                           value="@Model.StartDate.ToString("yyyy-MM-dd")"
                           onclick="if(this.showPicker)this.showPicker()"
                           onchange="navigateToDate(this.value)"
                           class="cal-toolbar__date-picker" />
                    <span class="cal-toolbar__date-label">
                        @Localization.FormatMediumDate(Model.StartDate) - @Localization.FormatMediumDate(Model.EndDate)
                    </span>
                </div>

                <a href="?MoleculeId=@Model.MoleculeId&Start=@Model.NextStart&ViewMode=@Model.ViewMode&ChoreTypeFilter=@Model.ChoreTypeFilter"
                   class="btn btn-ghost cal-toolbar__nav-btn"
                   data-cal-nav="next"
                   title="@Localizer["Next"]">
                    <span class="nav-text">@Localizer["Next"]</span>
                    <span class="nav-icon">&rarr;</span>
                </a>
            </div>

            <button type="button" class="btn btn-secondary cal-toolbar__print" onclick="window.print()" title="@Localizer["Print"]">
                <span class="btn-icon"><icon name="printer" /></span>
                <span class="btn-text">@Localizer["Print"]</span>
            </button>

            @* Justice — in-context drawer (Phase 2) *@
            @{
                // Phase 5: thread the active chore-category filter into the drawer's fetch endpoint so
                // the drawer narrows consistently with the page-level category selector below.
                var justiceEndpoint = $"/Calendar/Chores?handler=Justice&MoleculeId={Model.MoleculeId}&Start={Model.StartDate:yyyy-MM-dd}";
                if (Model.ChoreCategoryFilter.HasValue)
                {
                    justiceEndpoint += $"&ChoreCategoryFilter={Model.ChoreCategoryFilter.Value}";
                }
                var justicePanelModel = new ShiftManager.Pages.Shared.JusticePanelModel
                {
                    CalendarKind = "chores",
                    DataEndpoint = justiceEndpoint,
                    ButtonTitle = Localizer["Justice_Panel_Button"].Value,
                    RibbonAria = Localizer["Justice_EquityRibbon_Aria"].Value,
                    CloseLabel = Localizer["Justice_Panel_Close"].Value
                };
            }
            <partial name="_JusticePanel" model="justicePanelModel" />

            @* Phase 5: chore-category selector for the Justice drawer (narrows weighted-minute fairness). *@
            @if (Model.ChoreCategories.Count > 0)
            {
                <require-grant key="ViewJusticeTable">
                    <div class="cal-toolbar__selector">
                        <label for="chore-cat-select"><loc key="Justice_Filter_ChoreCategory" /></label>
                        <select id="chore-cat-select" class="form-select"
                                onchange="(function(sel){ var url = new URL(window.location.href); if (sel.value) { url.searchParams.set('ChoreCategoryFilter', sel.value); } else { url.searchParams.delete('ChoreCategoryFilter'); } window.location.href = url.toString(); })(this)">
                            <option value="" selected="@(Model.ChoreCategoryFilter == null)">@Localizer["Justice_Filter_AllChoreCategories"]</option>
                            @foreach (var cat in Model.ChoreCategories)
                            {
                                <option value="@cat.Id" selected="@(Model.ChoreCategoryFilter == cat.Id)">@cat.DisplayName</option>
                            }
                        </select>
                    </div>
                </require-grant>
            }

            @* Mobile-only Tools overflow trigger — surfaces controls hidden at <768px. *@
            <button type="button"
                    class="btn btn-ghost cal-toolbar__overflow-trigger"
                    loc-aria-label="Calendar_Tools_Overflow_AriaLabel"
                    onclick="window.CalendarToolsOverflow && window.CalendarToolsOverflow.open()">
                <loc key="Calendar_Tools_Overflow_Label" />
                <span aria-hidden="true">▾</span>
            </button>
        </div>

        @* Row 2: Filter + Just Mine + Legend *@
        <div class="cal-toolbar__controls">
            <div class="cal-toolbar__toggle-group">
                <button type="button" class="btn btn-ghost" onclick="openFilterModal()">
                    <span class="btn-icon"><icon name="search" /></span>
                    @Localizer["Filter"]
                </button>
                <a href="?MoleculeId=@Model.MoleculeId&Start=@Model.StartDate.ToString("yyyy-MM-dd")&ViewMode=@Model.ViewMode&ChoreTypeFilter=@Model.ChoreTypeFilter&JustMine=@(!Model.JustMine)"
                   class="btn @(Model.JustMine ? "btn-primary" : "btn-ghost")">
                    @Localizer["JustMine"]
                </a>
            </div>

            @if (Model.CanWriteNote)
            {
                <button type="button" id="quickEntryToggle" class="btn btn-ghost quick-entry-toggle"
                        data-can-assign="@Model.CanEdit.ToString().ToLowerInvariant()"
                        onclick="window.CalendarQuickEntry && window.CalendarQuickEntry.toggle()"
                        title="@Localizer["QuickEntry_Toggle"]">
                    <span class="btn-icon"><icon name="zap" /></span>
                    <loc key="QuickEntry_Toggle" />
                </button>
                <button type="button" id="quickEntryHelp" class="btn btn-ghost quick-entry-help-btn"
                        onclick="window.CalendarQuickEntry && window.CalendarQuickEntry.showHelp()"
                        loc-title="QuickEntry_HelpTitle"
                        loc-aria-label="QuickEntry_HelpTitle">
                    <span class="btn-icon">?</span>
                </button>
            }

            @if (Model.ChoreTypes.Any())
            {
                <div class="cal-toolbar__legend">
                    @{ var choreTypeIndex = 0; }
                    @foreach (var choreType in Model.ChoreTypes)
                    {
                        var patternClass = $"chore-pattern-{choreTypeIndex % 6}";
                        <div class="cal-toolbar__legend-item">
                            <span class="cal-toolbar__legend-color @patternClass" style="background-color: @(choreType.Color ?? "#6B7280")"></span>
                            <span class="cal-toolbar__legend-label">@LocalizeCt(choreType)</span>
                        </div>
                        choreTypeIndex++;
                    }
                </div>
            }
        </div>
    </div>

    @* Sticky readonly banner — pinned as second tier below the toolbar.
       Moved OUT of the ExcelCalendarTable component so it lives in .cal-page
       scope and can stick relative to the page, not the calendar viewport. *@
    <partial name="_CalendarReadonlyBanner" model="@(new CalendarReadonlyBannerModel
    {
        IsReadOnly = Model.CalendarData.IsReadOnly,
        RequiredGrantNameKeys = Model.CalendarData.RequiredGrantNameKeys
    })" />

    @* Calendar Table *@
    @if (Model.CalendarData.Rows.Any())
    {
        @await Component.InvokeAsync("ExcelCalendarTable", Model.CalendarData)
    }
    else
    {
        <div class="cal-empty">
            <div class="cal-empty__icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 11l3 3L22 4"></path>
                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                </svg>
            </div>
            <h3 class="cal-empty__title">@Localizer["Calendar_Empty_NoChores"]</h3>
            <p class="cal-empty__message">
                @Localizer["Calendar_Empty_NoChoresMessage"]
            </p>
        </div>
    }

    @* Hidden select for bottom-sheet user dropdown (Strategy 1 in getAvailableUsers) *@
    @* data-quickentry-skip: Quick Entry should NOT load users as suggestions on Chores — only chore types *@
    <select id="assigneeSelect-chores" data-role="assignee-select" data-item-type="user" data-quickentry-skip="true" style="display:none">
        @foreach (var user in Model.Users)
        {
            <option value="@user.Id">@user.DisplayName</option>
        }
    </select>

    @* Hidden select for Quick Entry chore type autocomplete *@
    <select id="choreTypeSelect-quickentry" style="display:none" data-role="quickentry-choretype">
        @foreach (var ct in Model.ChoreTypes)
        {
            <option value="@ct.Id" data-color="@(ct.Color ?? "#6B7280")">@LocalizeCt(ct)</option>
        }
    </select>

    @* Mobile Tools overflow sheet — clones of the hidden toolbar controls
       are injected at open() time so the originals remain the source of
       truth (event handlers and form bindings unmodified). *@
    <div id="calendarToolsSheet" class="bottom-sheet calendar-tools-sheet" hidden aria-modal="true" role="dialog">
        <div class="bottom-sheet__content">
            <div class="bottom-sheet__header">
                <h3><loc key="Calendar_Tools_Overflow_Label" /></h3>
                <button type="button" class="bottom-sheet__close"
                        loc-aria-label="Aria_CloseDialog"
                        onclick="window.CalendarToolsOverflow && window.CalendarToolsOverflow.close()">×</button>
            </div>
            <div class="bottom-sheet__body" id="calendarToolsSheetBody">
                @* Cloned controls are injected here at open() time so server state stays source of truth *@
            </div>
        </div>
    </div>

</div>

@* Filter Modal (consistent with Shifts page) *@
<div id="filterModal" class="cal-filter-modal" style="display: none;" onclick="if(event.target===this) closeFilterModal()">
    <div class="cal-filter-modal__dialog">
        <div class="cal-filter-modal__header">
            <h3><loc key="Filter" /></h3>
            <button type="button" class="cal-filter-modal__close" onclick="closeFilterModal()" loc-aria-label="Aria_CloseDialog">&times;</button>
        </div>
        <div class="cal-filter-modal__body">
            <div class="form-group">
                <label for="filterSearchInput"><loc key="Filter_SearchLabel" /></label>
                <input type="text" id="filterSearchInput" class="form-control"
                       placeholder="@Localizer["Filter_SearchPlaceholder"]"
                       onkeydown="if(event.key==='Enter'){event.preventDefault(); applyFilter();}" />
            </div>
        </div>
        <div class="cal-filter-modal__footer">
            <button type="button" class="btn btn-ghost" onclick="clearFilter()"><loc key="Filter_Clear" /></button>
            <button type="button" class="btn btn-primary" onclick="applyFilter()"><loc key="Filter_Apply" /></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Shared calendar config consumed by calendar-bottom-sheet.js (busy + eligibility decoration).
        // Chores are molecule-scoped and never "Tech" (a shift concept), so isTechMolecule is always false.
        window.CalendarPageConfig = {
            isTechMolecule: false,
            moleculeId: @(Model.MoleculeId ?? 0)
        };
    </script>
    <script src="~/js/calendar-lazy-rows.js" asp-append-version="true"></script>
    <script src="~/js/calendar-sticky-shadows.js" asp-append-version="true"></script>
    <script src="~/js/calendar-inline-edit.js" asp-append-version="true"></script>
    <script src="~/js/eligibility-chip.js" asp-append-version="true"></script>
    <script src="~/js/calendar-bottom-sheet.js" asp-append-version="true"></script>
    <script src="~/js/calendar-keyboard-nav.js" asp-append-version="true"></script>
    <script src="~/js/calendar-tools-overflow.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/calendar-quick-entry.css" asp-append-version="true" />
    <script src="~/js/calendar-quick-entry.js" asp-append-version="true"></script>
    <script src="~/js/calendar-row-reorder.js" asp-append-version="true"></script>
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/calendar-realtime.js" asp-append-version="true"></script>

    @* Justice in-context drawer (Phase 2) *@
    <link rel="stylesheet" href="~/css/justice-panel.css" asp-append-version="true" />
    <script src="~/js/justice-panel.js" asp-append-version="true" defer></script>
    <script>
        // Initialize real-time updates
        document.addEventListener('DOMContentLoaded', function() {
            CalendarRealtime.initialize({
                calendarType: 'chores',
                scope: {
                    moleculeId: @Model.MoleculeId
                },
                onRefresh: refreshCalendarData,
                handlers: {
                    onChoreChanged: handleChoreChanged
                }
            });
        });

        // Refresh calendar data via AJAX
        async function refreshCalendarData() {
            const startDate = '@Model.StartDate.ToString("yyyy-MM-dd")';
            const endDate = '@Model.EndDate.ToString("yyyy-MM-dd")';
            const moleculeId = @Model.MoleculeId;

            try {
                const response = await fetch(
                    `/Api/Calendar/GetChoresData?moleculeId=${moleculeId}&startDate=${startDate}&endDate=${endDate}`,
                    { credentials: 'same-origin' }
                );

                if (!response.ok) throw new Error('Failed to refresh');

                const result = await response.json();
                if (result.success) {
                    // Full page refresh for now - cell update logic can be added later
                    location.reload();
                }
            } catch (error) {
                console.error('Shadow refresh failed:', error);
            }
        }

        // Handle real-time chore change
        function handleChoreChanged(evt) {
            refreshCalendarData();
        }

        // Update calendar with new filter selections
        function updateCalendarFilters() {
            const moleculeId = document.getElementById('moleculeSelect').value;
            const choreTypeSelect = document.getElementById('choreTypeSelect');
            const choreTypeFilter = choreTypeSelect ? choreTypeSelect.value : '';
            const viewMode = document.getElementById('viewModeSelect').value;

            const params = new URLSearchParams(window.location.search);
            params.set('MoleculeId', moleculeId);
            if (choreTypeFilter) {
                params.set('ChoreTypeFilter', choreTypeFilter);
            } else {
                params.delete('ChoreTypeFilter');
            }
            params.set('ViewMode', viewMode);

            window.location.href = window.location.pathname + '?' + params.toString();
        }

        // Navigate to a specific date
        function navigateToDate(dateStr) {
            const params = new URLSearchParams(window.location.search);
            params.set('Start', dateStr);
            window.location.href = window.location.pathname + '?' + params.toString();
        }

        // Filter modal
        function openFilterModal() {
            var modal = document.getElementById('filterModal');
            modal.style.display = 'flex';
            modal.classList.add('is-open');
            var input = document.getElementById('filterSearchInput');
            if (input) { input.value = ''; input.focus(); }
        }

        function closeFilterModal() {
            var modal = document.getElementById('filterModal');
            modal.classList.remove('is-open');
            modal.style.display = 'none';
        }

        function applyFilter() {
            var query = (document.getElementById('filterSearchInput').value || '').trim().toLowerCase();
            var rows = document.querySelectorAll('[data-row-id]');
            rows.forEach(function(row) {
                if (row.classList.contains('excel-calendar__group-header')) return;
                var label = (row.querySelector('.excel-calendar__row-label')?.textContent || '').toLowerCase();
                var names = Array.from(row.querySelectorAll('.excel-calendar__assignment-name'))
                    .map(function(el) { return el.textContent.toLowerCase(); }).join(' ');
                var match = !query || label.indexOf(query) !== -1 || names.indexOf(query) !== -1;
                row.style.display = match ? '' : 'none';
            });
            closeFilterModal();
            window.updateGroupCounts && window.updateGroupCounts();
        }

        function clearFilter() {
            document.querySelectorAll('[data-row-id]').forEach(function(row) {
                if (!row.classList.contains('excel-calendar__group-header')) {
                    row.style.display = '';
                }
            });
            closeFilterModal();
            window.updateGroupCounts && window.updateGroupCounts();
        }

        // Keyboard navigation
        document.addEventListener('keydown', function(e) {
            // Left arrow - previous period
            if (e.key === 'ArrowLeft' && e.altKey) {
                document.querySelector('.cal-toolbar__nav-btn:first-child')?.click();
            }
            // Right arrow - next period
            if (e.key === 'ArrowRight' && e.altKey) {
                document.querySelector('.cal-toolbar__nav-btn:last-child')?.click();
            }
            // P key - print
            if (e.key === 'p' && e.ctrlKey) {
                e.preventDefault();
                window.print();
            }
        });
    </script>
}

@section Styles {
    <style>
        /* Colorblind-accessible patterns for chore types — page-specific */
        .chore-pattern-0 { background-image: repeating-linear-gradient(45deg, transparent, transparent 2px, rgba(255,255,255,0.5) 2px, rgba(255,255,255,0.5) 4px) !important; }
        .chore-pattern-1 { background-image: radial-gradient(circle, rgba(255,255,255,0.6) 1px, transparent 1px) !important; background-size: 5px 5px !important; }
        .chore-pattern-2 { background-image: repeating-linear-gradient(-45deg, transparent, transparent 2px, rgba(255,255,255,0.5) 2px, rgba(255,255,255,0.5) 4px) !important; }
        .chore-pattern-3 { background-image: repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(255,255,255,0.5) 3px, rgba(255,255,255,0.5) 5px) !important; }
        .chore-pattern-4 { background-image: repeating-linear-gradient(45deg, transparent, transparent 2px, rgba(255,255,255,0.5) 2px, rgba(255,255,255,0.5) 4px), repeating-linear-gradient(-45deg, transparent, transparent 2px, rgba(255,255,255,0.5) 2px, rgba(255,255,255,0.5) 4px) !important; }
        .chore-pattern-5 { background-image: repeating-linear-gradient(90deg, transparent, transparent 3px, rgba(255,255,255,0.5) 3px, rgba(255,255,255,0.5) 5px) !important; }
    </style>
}
