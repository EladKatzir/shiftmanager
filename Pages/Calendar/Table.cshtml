<script>
let currentSlot = null;
let currentAmount = 1;
let currentCell = null;
const MAX_AMOUNT = 10;
const MIN_AMOUNT = 1;

// Busy users data per date (serialized from server)
const busyUsersByDate = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BusyUsersByDate));

// Molecule mode context — passed to POST handlers that need it
const currentMoleculeId = @(Model.MoleculeId.HasValue ? Model.MoleculeId.Value.ToString() : "null");
const currentJobTypeId = @(Model.JobTypeId.HasValue ? Model.JobTypeId.Value.ToString() : "null");
const isMoleculeMode = @(Model.IsMoleculeMode ? "true" : "false");

// Localized strings — SECURITY FIX: Use Json.Serialize for proper JS-context escaping (prevents XSS via admin localization overrides)
const i18n = {
    numberOfPeopleNeeded: @Html.Raw(Json.Serialize(Localizer["NumberOfPeopleNeeded"].Value)),
    adjustRequiredHeadcount: @Html.Raw(Json.Serialize(Localizer["AdjustRequiredHeadcount"].Value)),
    addTrainee: @Html.Raw(Json.Serialize(Localizer["AddTrainee"].Value)),
    changeTrainee: @Html.Raw(Json.Serialize(Localizer["ChangeTrainee"].Value)),
    selectEmployee: @Html.Raw(Json.Serialize(Localizer["SelectEmployee"].Value)),
    assignEmployeeToSlot: @Html.Raw(Json.Serialize(Localizer["AssignEmployeeToSlot"].Value)),
    failedToAddTrainee: @Html.Raw(Json.Serialize(Localizer["FailedToAddTrainee"].Value)),
    removeTraineeConfirm: @Html.Raw(Json.Serialize(Localizer["RemoveTraineeConfirm"].Value)),
    failedToRemoveTrainee: @Html.Raw(Json.Serialize(Localizer["FailedToRemoveTrainee"].Value)),
    failedToChangeUser: @Html.Raw(Json.Serialize(Localizer["FailedToChangeUser"].Value)),
    removeUserConfirm: @Html.Raw(Json.Serialize(Localizer["RemoveUserConfirm"].Value)),
    failedToRemoveUser: @Html.Raw(Json.Serialize(Localizer["FailedToRemoveUser"].Value)),
    deleteShift: @Html.Raw(Json.Serialize(Localizer["DeleteShift"].Value)),
    deleteShiftConfirm: @Html.Raw(Json.Serialize(Localizer["DeleteShiftConfirm"].Value)),
    failedToDeleteShift: @Html.Raw(Json.Serialize(Localizer["FailedToDeleteShift"].Value)),
    resetToProgramConfirm: @Html.Raw(Json.Serialize(Localizer["Calendar_ResetToProgramConfirm"].Value)),
    loadingEmployees: @Html.Raw(Json.Serialize(Localizer["Calendar_LoadingEmployees"].Value)),
    roster: @Html.Raw(Json.Serialize(Localizer["Roster"].Value)),
    overrideWarningsFound: @Html.Raw(Json.Serialize(Localizer["Calendar_OverrideWarningsFound"].Value)),
    overrideProceedAnyway: @Html.Raw(Json.Serialize(Localizer["Calendar_ProceedAnyway"].Value))
};

// Override warning handler — re-sends the request with the overrideToken if user confirms
async function retryWithOverride(result, handlerUrl, originalBody, headers) {
    var messages = result.warnings.map(function(w) { return '• ' + w.message; }).join('\n');
    var prompt = i18n.overrideWarningsFound + '\n\n' + messages + '\n\n' + i18n.overrideProceedAnyway;
    if (!confirm(prompt)) return null;

    originalBody.overrideToken = result.overrideToken;
    var response = await fetch(handlerUrl, {
        method: 'POST',
        headers: headers,
        credentials: 'same-origin',
        body: JSON.stringify(originalBody)
    });
    if (!response.ok) throw new Error('Request failed: ' + response.status);
    return await response.json();
}

// Shift Row Editing Functions
function toggleEditMode(shiftTypeId, isEdit) {
    const displayElem = document.getElementById(`metadata-${shiftTypeId}`);
    const editElem = document.getElementById(`metadata-edit-${shiftTypeId}`);
    const editBtn = document.getElementById(`edit-btn-${shiftTypeId}`);
    const saveBtn = document.getElementById(`save-btn-${shiftTypeId}`);
    const cancelBtn = document.getElementById(`cancel-btn-${shiftTypeId}`);

    if (isEdit) {
        displayElem.style.display = 'none';
        editElem.style.display = 'flex';
        editBtn.style.display = 'none';
        saveBtn.style.display = 'inline-block';
        cancelBtn.style.display = 'inline-block';
    } else {
        displayElem.style.display = 'flex';
        editElem.style.display = 'none';
        editBtn.style.display = 'inline-block';
        saveBtn.style.display = 'none';
        cancelBtn.style.display = 'none';
    }
}

async function saveShiftMetadata(shiftTypeId) {
    const name = document.getElementById(`name-${shiftTypeId}`).value;
    const start = document.getElementById(`start-${shiftTypeId}`).value;
    const end = document.getElementById(`end-${shiftTypeId}`).value;

    if (!name || !start || !end) {
        window.FeedbackModal.show('warning', '@Localizer["Error_PleaseFillAllFields"].Value.Trim()');
        return;
    }

    try {
        const csrfToken1 = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const headers1 = {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        };
        if (csrfToken1) headers1['RequestVerificationToken'] = csrfToken1;

        const response = await fetch('/Calendar/Table?handler=UpdateShiftMetadata', {
            method: 'POST',
            headers: headers1,
            credentials: 'same-origin',
            body: JSON.stringify({
                shiftTypeId: shiftTypeId,
                name: name,
                startTime: start,
                endTime: end
            })
        });

        if (!response.ok) {
            throw new Error(`Request failed: ${response.status}`);
        }

        const result = await response.json();

        if (result.success) {
            location.reload();
        } else {
            window.FeedbackModal.show('error', '@Localizer["Error_Prefix"].Value.Trim()' + result.error);
        }
    } catch (error) {
        console.error('Error updating shift metadata:', error);
        window.FeedbackModal.show('error', '@Localizer["Error_FailedToUpdateShiftMetadata"].Value.Trim()');
    }
}

// Add Shift Row Modal Functions
function showAddShiftRowModal() {
    document.getElementById('addShiftRowModal').classList.add('show');
}

function closeAddShiftRowModal() {
    document.getElementById('addShiftRowModal').classList.remove('show');
    document.getElementById('newShiftName').value = '';
    document.getElementById('newShiftStart').value = '09:00';
    document.getElementById('newShiftEnd').value = '17:00';
}

async function createCustomShiftRow() {
    const name = document.getElementById('newShiftName').value;
    const start = document.getElementById('newShiftStart').value;
    const end = document.getElementById('newShiftEnd').value;

    if (!name || !start || !end) {
        window.FeedbackModal.show('warning', '@Localizer["Error_PleaseFillAllFields"].Value.Trim()');
        return;
    }

    try {
        const csrfToken2 = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const headers2 = {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        };
        if (csrfToken2) headers2['RequestVerificationToken'] = csrfToken2;

        const response = await fetch('/Calendar/Table?handler=CreateCustomShiftType', {
            method: 'POST',
            headers: headers2,
            credentials: 'same-origin',
            body: JSON.stringify({
                name: name,
                startTime: start,
                endTime: end,
                moleculeId: isMoleculeMode ? currentMoleculeId : null,
                jobTypeId: isMoleculeMode ? currentJobTypeId : null
            })
        });

        if (!response.ok) {
            throw new Error(`Request failed: ${response.status}`);
        }

        const result = await response.json();

        if (result.success) {
            closeAddShiftRowModal();
            location.reload();
        } else {
            window.FeedbackModal.show('error', '@Localizer["Error_Prefix"].Value.Trim()' + result.error);
        }
    } catch (error) {
        console.error('Error creating custom shift row:', error);
        window.FeedbackModal.show('error', '@Localizer["Error_FailedToCreateShiftRow"].Value.Trim()');
    }
}

// Close menus when clicking outside
document.addEventListener('click', function(event) {
    const contextMenu = document.getElementById('slotContextMenu');
    const dropdown = document.getElementById('employeeDropdown');
    const modal = document.getElementById('amountPickerModal');

    if (contextMenu && !event.target.closest('#slotContextMenu') && !event.target.closest('.assignment-slot')) {
        contextMenu.classList.remove('show');
    }
    if (dropdown && !event.target.closest('#employeeDropdown') && !event.target.closest('#slotContextMenu')) {
        dropdown.classList.remove('show');
    }
});

// Amount Picker Functions
let currentInstanceId = null;

function showAmountPicker(btn, event) {
    event.stopPropagation();
    currentCell = btn.closest('.assignment-cell');
    currentInstanceId = null; // New shift instance
    currentAmount = 1;
    document.getElementById('amountDisplay').textContent = currentAmount;
    document.getElementById('amountPickerModal').querySelector('.modal-header').textContent = i18n.numberOfPeopleNeeded;
    updateAmountButtons();
    document.getElementById('amountPickerModal').classList.add('show');
}

function showAdjustHeadcount(instanceId, event) {
    event.stopPropagation();

    // Find the cell containing this instance
    const slotsDiv = event.target.closest('.assignment-slots');
    currentCell = slotsDiv.closest('.assignment-cell');
    currentInstanceId = instanceId;

    // Count current slots
    const currentSlots = slotsDiv.querySelectorAll('.assignment-slot').length;
    currentAmount = currentSlots;

    document.getElementById('amountDisplay').textContent = currentAmount;
    document.getElementById('amountPickerModal').querySelector('.modal-header').textContent = i18n.adjustRequiredHeadcount;
    updateAmountButtons();
    document.getElementById('amountPickerModal').classList.add('show');
}

function closeAmountPicker() {
    document.getElementById('amountPickerModal').classList.remove('show');
    currentCell = null;
    currentInstanceId = null;
}

function adjustAmount(delta) {
    currentAmount = Math.max(MIN_AMOUNT, Math.min(MAX_AMOUNT, currentAmount + delta));
    document.getElementById('amountDisplay').textContent = currentAmount;
    updateAmountButtons();
}

function updateAmountButtons() {
    document.getElementById('decreaseBtn').disabled = currentAmount <= MIN_AMOUNT;
    document.getElementById('increaseBtn').disabled = currentAmount >= MAX_AMOUNT;
}

async function createAssignmentSlots(forceRemoval = false) {
    if (!currentCell) return;

    const shiftTypeId = currentCell.getAttribute('data-shift-type');
    const date = currentCell.getAttribute('data-date');

    try {
        let response;

        if (currentInstanceId) {
            // Update existing shift instance
            const csrfToken3 = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const headers3 = {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            };
            if (csrfToken3) headers3['RequestVerificationToken'] = csrfToken3;

            response = await fetch('/Calendar/Table?handler=UpdateShiftStaffing', {
                method: 'POST',
                headers: headers3,
                credentials: 'same-origin',
                body: JSON.stringify({
                    shiftInstanceId: currentInstanceId,
                    staffingRequired: currentAmount,
                    forceRemoval: forceRemoval
                })
            });
        } else {
            // Get-or-create shift instance (idempotent - no "already exists" error)
            const csrfToken4 = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const headers4 = {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            };
            if (csrfToken4) headers4['RequestVerificationToken'] = csrfToken4;

            response = await fetch('/Calendar/Table?handler=EnsureShiftInstance', {
                method: 'POST',
                headers: headers4,
                credentials: 'same-origin',
                body: JSON.stringify({
                    shiftTypeId: parseInt(shiftTypeId),
                    date: date,
                    staffingRequired: currentAmount
                })
            });
        }

        if (!response.ok) {
            throw new Error(`Request failed: ${response.status}`);
        }

        const result = await response.json();

        if (result.success) {
            closeAmountPicker();
            location.reload();
        } else if (result.requiresConfirmation) {
            // Show confirmation dialog for removing assigned employees
            if (confirm(result.message)) {
                // User confirmed - retry with force removal
                await createAssignmentSlots(true);
            }
        } else {
            window.FeedbackModal.show('error', '@Localizer["Error_Prefix"].Value.Trim()' + result.error);
        }
    } catch (error) {
        console.error('Error updating shift slots:', error);
        window.FeedbackModal.show('error', '@Localizer["Error_FailedToUpdateShiftSlots"].Value.Trim()');
    }
}

// Slot Click Handlers
function handleSlotClick(slot, event) {
    event.stopPropagation();
    currentSlot = slot;

    const contextMenu = document.getElementById('slotContextMenu');
    const hasTrainee = slot.getAttribute('data-has-trainee') === 'true';

    // Update menu items based on slot state
    document.getElementById('traineeMenuLabel').textContent = hasTrainee ? i18n.changeTrainee : i18n.addTrainee;
    document.getElementById('removeTraineeItem').style.display = hasTrainee ? 'block' : 'none';

    // Close dropdown if open
    document.getElementById('employeeDropdown').classList.remove('show');

    // Position and show menu
    positionMenuNearSlot(contextMenu, slot);
    contextMenu.classList.add('show');
}

function handleUnassignedSlotClick(slot, event) {
    event.stopPropagation();
    currentSlot = slot;

    const assignmentId = slot.getAttribute('data-assignment-id');
    showEmployeeDropdown((employeeId, employeeName) => {
        assignUserToSlot(assignmentId, employeeId);
    });
}

function positionMenuNearSlot(menu, slot) {
    const rect = slot.getBoundingClientRect();
    menu.style.position = 'fixed';
    menu.style.top = (rect.bottom + 5) + 'px';
    menu.style.left = rect.left + 'px';
}

// Employee Dropdown Functions
function showAddTraineeMenu(event) {
    event.stopPropagation();
    if (!currentSlot) return;

    const assignmentId = currentSlot.getAttribute('data-assignment-id');
    showEmployeeDropdown((employeeId, employeeName) => {
        addTrainee(assignmentId, employeeId, employeeName);
    });
}

function showChangeUserMenu(event) {
    event.stopPropagation();
    if (!currentSlot) return;

    const assignmentId = currentSlot.getAttribute('data-assignment-id');
    showEmployeeDropdown((employeeId, employeeName) => {
        changeUser(assignmentId, employeeId, employeeName);
    });
}

function showEmployeeDropdown(callback) {
    const contextMenu = document.getElementById('slotContextMenu');
    const dropdown = document.getElementById('employeeDropdown');

    // Close context menu
    contextMenu.classList.remove('show');

    // Position dropdown near current slot
    if (currentSlot) {
        positionMenuNearSlot(dropdown, currentSlot);
    }

    // Get already assigned users in this cell to filter them out
    const cell = currentSlot ? currentSlot.closest('.assignment-cell') : null;
    const assignedUserIds = new Set();

    if (cell) {
        const slots = cell.querySelectorAll('.assignment-slot[data-user-id]');
        slots.forEach(slot => {
            const userId = slot.getAttribute('data-user-id');
            if (userId && userId !== 'null' && userId !== '') {
                assignedUserIds.add(userId);
            }
        });
    }

    // Set up click handlers for employee options
    const options = dropdown.querySelectorAll('.employee-option');
    options.forEach(option => {
        const newOption = option.cloneNode(true);
        option.parentNode.replaceChild(newOption, option);

        const employeeId = newOption.getAttribute('data-employee-id');

        // Hide options for users already assigned in this cell
        if (assignedUserIds.has(employeeId)) {
            newOption.style.display = 'none';
        } else {
            newOption.style.display = 'block';

            // Apply busy status if we have date information
            const cellDate = cell ? cell.getAttribute('data-date') : null;
            if (cellDate && busyUsersByDate[cellDate]) {
                const busyStatus = busyUsersByDate[cellDate][employeeId];
                if (busyStatus) {
                    // Apply CSS class based on busy reason
                    if (busyStatus.CssClass) {
                        newOption.classList.add(busyStatus.CssClass);
                    }
                    // Update display text to show busy status
                    const employeeName = newOption.getAttribute('data-employee-name');
                    if (busyStatus.DisplayText) {
                        newOption.textContent = `${employeeName} (${busyStatus.DisplayText})`;
                    }
                }
            }

            newOption.addEventListener('click', function(e) {
                e.stopPropagation();
                const employeeName = this.getAttribute('data-employee-name');
                dropdown.classList.remove('show');
                callback(parseInt(employeeId), employeeName);
            });
        }
    });

    dropdown.classList.add('show');
}

async function addTrainee(assignmentId, traineeId, traineeName) {
    const contextMenu = document.getElementById('slotContextMenu');
    contextMenu.classList.remove('show');

    try {
        const csrfToken5 = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const headers5 = {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        };
        if (csrfToken5) headers5['RequestVerificationToken'] = csrfToken5;

        var body5 = { assignmentId: parseInt(assignmentId), traineeUserId: traineeId };
        const response = await fetch('/Calendar/Table?handler=AddTrainee', {
            method: 'POST',
            headers: headers5,
            credentials: 'same-origin',
            body: JSON.stringify(body5)
        });

        if (!response.ok) {
            throw new Error(`Request failed: ${response.status}`);
        }

        var result = await response.json();

        if (result.requiresOverride) {
            result = await retryWithOverride(result, '/Calendar/Table?handler=AddTrainee', body5, headers5);
            if (!result) return;
        }

        if (result.success) {
            // Update DOM immediately
            if (currentSlot) {
                currentSlot.setAttribute('data-has-trainee', 'true');
                currentSlot.setAttribute('data-trainee-id', traineeId);

                const contentDiv = currentSlot.querySelector('.assignment-slot-content > div:first-child');
                if (contentDiv) {
                    // Find existing trainee div or create new one
                    let traineeDiv = contentDiv.querySelector('.trainee-user');
                    if (!traineeDiv) {
                        // Add comma and trainee
                        const primaryUserDiv = contentDiv.querySelector('.primary-user');
                        if (primaryUserDiv) {
                            const comma = document.createTextNode(', ');
                            traineeDiv = document.createElement('div');
                            traineeDiv.className = 'trainee-user';
                            traineeDiv.textContent = traineeName;

                            contentDiv.appendChild(comma);
                            contentDiv.appendChild(traineeDiv);
                        }
                    } else {
                        // Update existing trainee
                        traineeDiv.textContent = traineeName;
                    }
                }

                // Update context menu label
                document.getElementById('traineeMenuLabel').textContent = i18n.changeTrainee;
                document.getElementById('removeTraineeItem').style.display = 'block';
            }
        } else {
            window.FeedbackModal.show('error', '@Localizer["Error_Prefix"].Value.Trim()' + (result.error || ''), result.fix ? { action: { label: result.fix.label, url: result.fix.url } } : undefined);
        }
    } catch (error) {
        console.error('Error adding trainee:', error);
        window.FeedbackModal.show('error', i18n.failedToAddTrainee);
    }
}

async function removeTrainee(event) {
    event.stopPropagation();
    if (!currentSlot) return;

    if (!confirm(i18n.removeTraineeConfirm)) {
        return;
    }

    const assignmentId = currentSlot.getAttribute('data-assignment-id');

    try {
        const csrfToken6 = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const headers6 = {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        };
        if (csrfToken6) headers6['RequestVerificationToken'] = csrfToken6;

        const response = await fetch('/Calendar/Table?handler=RemoveTrainee', {
            method: 'POST',
            headers: headers6,
            credentials: 'same-origin',
            body: JSON.stringify({
                assignmentId: parseInt(assignmentId)
            })
        });

        if (!response.ok) {
            throw new Error(`Request failed: ${response.status}`);
        }

        const result = await response.json();

        if (result.success) {
            location.reload();
        } else {
            window.FeedbackModal.show('error', '@Localizer["Error_Prefix"].Value.Trim()' + result.error);
        }
    } catch (error) {
        console.error('Error removing trainee:', error);
        window.FeedbackModal.show('error', i18n.failedToRemoveTrainee);
    }
}

async function assignUserToSlot(assignmentId, userId) {
    try {
        const csrfToken7 = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const headers7 = {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        };
        if (csrfToken7) headers7['RequestVerificationToken'] = csrfToken7;

        var body7 = { assignmentId: parseInt(assignmentId), userId: userId };
        const response = await fetch('/Calendar/Table?handler=AssignUserToSlot', {
            method: 'POST',
            headers: headers7,
            credentials: 'same-origin',
            body: JSON.stringify(body7)
        });

        if (!response.ok) {
            throw new Error(`Request failed: ${response.status}`);
        }

        var result = await response.json();

        if (result.requiresOverride) {
            result = await retryWithOverride(result, '/Calendar/Table?handler=AssignUserToSlot', body7, headers7);
            if (!result) return;
        }

        if (result.success) {
            location.reload();
        } else {
            window.FeedbackModal.show('error', '@Localizer["Error_Prefix"].Value.Trim()' + (result.error || ''), result.fix ? { action: { label: result.fix.label, url: result.fix.url } } : undefined);
        }
    } catch (error) {
        console.error('Error assigning user to slot:', error);
        window.FeedbackModal.show('error', '@Localizer["Error_FailedToAssignUser"].Value.Trim()');
    }
}

