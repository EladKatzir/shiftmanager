async function removeUser(event) {
    event.stopPropagation();
    if (!currentSlot) return;

    if (!confirm(i18n.removeUserConfirm)) {
        return;
    }

    const assignmentId = currentSlot.getAttribute('data-assignment-id');
    const contextMenu = document.getElementById('slotContextMenu');
    contextMenu.classList.remove('show');

    try {
        const csrfToken9 = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const headers9 = {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        };
        if (csrfToken9) headers9['RequestVerificationToken'] = csrfToken9;

        const response = await fetch('/Calendar/Table?handler=ClearAssignment', {
            method: 'POST',
            headers: headers9,
            credentials: 'same-origin',
            body: JSON.stringify({
                assignmentId: parseInt(assignmentId)
            })
        });

        if (!response.ok) {
            throw new Error(`Request failed: ${response.status}`);
        }

        const result = await response.json();

        if (result.success) {
            // Update DOM immediately - convert to unassigned slot
            currentSlot.classList.add('unassigned');
            currentSlot.removeAttribute('data-user-id');
            currentSlot.removeAttribute('data-has-trainee');
            currentSlot.removeAttribute('data-trainee-id');
            currentSlot.setAttribute('aria-label', i18n.assignEmployeeToSlot);
            currentSlot.setAttribute('onclick', 'handleUnassignedSlotClick(this, event)');

            const content = currentSlot.querySelector('.assignment-slot-content');
            content.innerHTML = `<div>${i18n.selectEmployee}</div><div class="slot-actions">👤</div>`;
        } else {
            window.FeedbackModal.show('error', '@Localizer["Error_Prefix"].Value.Trim()' + result.error);
        }
    } catch (error) {
        console.error('Error removing user:', error);
        window.FeedbackModal.show('error', i18n.failedToRemoveUser);
    }
}

