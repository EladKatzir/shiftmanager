// ============= KEYBOARD NAVIGATION =============

// Track currently focused cell for keyboard navigation
let focusedCell = null;

// Initialize keyboard navigation
document.addEventListener('DOMContentLoaded', function() {
    initializeKeyboardNavigation();
    initializeMenuKeyboardNav();
});

// B-037: Initialize keyboard navigation for action menus
function initializeMenuKeyboardNav() {
    // Context menu keyboard navigation
    const contextMenu = document.getElementById('slotContextMenu');
    if (contextMenu && window.KeyboardNav) {
        window.KeyboardNav.initMenu({
            menu: contextMenu,
            itemSelector: '.action-menu-item:not([style*="display: none"])',
            onClose: function() {
                contextMenu.classList.remove('show');
                // Return focus to the slot that opened the menu
                if (currentSlot) {
                    currentSlot.focus();
                }
            }
        });
    }

    // Employee dropdown keyboard navigation
    const employeeDropdown = document.getElementById('employeeDropdown');
    if (employeeDropdown && window.KeyboardNav) {
        window.KeyboardNav.initMenu({
            menu: employeeDropdown,
            itemSelector: '.employee-option',
            onClose: function() {
                employeeDropdown.classList.remove('show');
                if (currentSlot) {
                    currentSlot.focus();
                }
            }
        });
    }
}

function initializeKeyboardNavigation() {
    const cells = document.querySelectorAll('.assignment-cell');

    cells.forEach(cell => {
        // Make cells focusable
        cell.setAttribute('tabindex', '0');

        // Add focus styling
        cell.addEventListener('focus', function() {
            focusedCell = this;
            this.style.outline = '2px solid var(--primary)';
            this.style.outlineOffset = '-2px';
        });

        cell.addEventListener('blur', function() {
            this.style.outline = '';
            this.style.outlineOffset = '';
        });

        // Handle keyboard events on cells
        cell.addEventListener('keydown', handleCellKeydown);
    });

    // Also handle keyboard on slots
    const slots = document.querySelectorAll('.assignment-slot');
    slots.forEach(slot => {
        slot.addEventListener('keydown', handleSlotKeydown);
    });
}

function handleCellKeydown(event) {
    const cell = event.currentTarget;

    // Handle arrow keys
    if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(event.key)) {
        event.preventDefault();
        navigateCell(cell, event.key);
        return;
    }

    // Handle Enter key on cells
    if (event.key === 'Enter') {
        event.preventDefault();

        // Check if cell is empty (has add-assignment-btn)
        const addBtn = cell.querySelector('.add-assignment-btn');
        if (addBtn) {
            showAmountPicker(addBtn, event);
        } else {
            // Cell has slots - focus first slot
            const firstSlot = cell.querySelector('.assignment-slot');
            if (firstSlot) {
                firstSlot.focus();
            }
        }
    }
}

function handleSlotKeydown(event) {
    const slot = event.currentTarget;

    // Handle Enter key on slots
    if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();

        if (slot.classList.contains('unassigned')) {
            handleUnassignedSlotClick(slot, event);
        } else {
            handleSlotClick(slot, event);
        }
        return;
    }

    // Handle Escape key to go back to cell
    if (event.key === 'Escape') {
        event.preventDefault();
        const cell = slot.closest('.assignment-cell');
        if (cell) {
            cell.focus();
        }

        // Close any open menus
        document.getElementById('slotContextMenu')?.classList.remove('show');
        document.getElementById('employeeDropdown')?.classList.remove('show');
        return;
    }

    // Handle arrow keys within slots
    if (['ArrowUp', 'ArrowDown'].includes(event.key)) {
        event.preventDefault();
        navigateSlots(slot, event.key);
        return;
    }

    // Arrow left/right go back to cell navigation
    if (['ArrowLeft', 'ArrowRight'].includes(event.key)) {
        event.preventDefault();
        const cell = slot.closest('.assignment-cell');
        if (cell) {
            cell.focus();
            navigateCell(cell, event.key);
        }
    }
}

function navigateCell(currentCell, direction) {
    const allCells = Array.from(document.querySelectorAll('.assignment-cell'));
    const currentIndex = allCells.indexOf(currentCell);

    if (currentIndex === -1) return;

    let targetCell = null;

    if (direction === 'ArrowLeft') {
        // Move to previous cell in row
        targetCell = allCells[currentIndex - 1];
    } else if (direction === 'ArrowRight') {
        // Move to next cell in row
        targetCell = allCells[currentIndex + 1];
    } else if (direction === 'ArrowUp' || direction === 'ArrowDown') {
        // Calculate grid dimensions
        const currentRow = currentCell.closest('tr');
        const currentCellIndex = Array.from(currentRow.cells).indexOf(currentCell);

        // Find target row
        const allRows = Array.from(document.querySelectorAll('.shift-table tbody tr'));
        const currentRowIndex = allRows.indexOf(currentRow);

        const targetRowIndex = direction === 'ArrowUp'
            ? currentRowIndex - 1
            : currentRowIndex + 1;

        if (targetRowIndex >= 0 && targetRowIndex < allRows.length) {
            const targetRow = allRows[targetRowIndex];
            targetCell = targetRow.cells[currentCellIndex];
        }
    }

    if (targetCell && targetCell.classList.contains('assignment-cell')) {
        targetCell.focus();
    }
}

function navigateSlots(currentSlot, direction) {
    const slotsContainer = currentSlot.closest('.assignment-slots');
    if (!slotsContainer) return;

    const allSlots = Array.from(slotsContainer.querySelectorAll('.assignment-slot'));
    const currentIndex = allSlots.indexOf(currentSlot);

    if (currentIndex === -1) return;

    let targetSlot = null;

    if (direction === 'ArrowUp' && currentIndex > 0) {
        targetSlot = allSlots[currentIndex - 1];
    } else if (direction === 'ArrowDown' && currentIndex < allSlots.length - 1) {
        targetSlot = allSlots[currentIndex + 1];
    }

    if (targetSlot) {
        targetSlot.focus();
    }
}

// Add Escape key handler for modals
document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
        // Close amount picker modal
        const amountModal = document.getElementById('amountPickerModal');
        if (amountModal && amountModal.classList.contains('show')) {
            closeAmountPicker();
        }

        // Close add shift row modal
        const addShiftModal = document.getElementById('addShiftRowModal');
        if (addShiftModal && addShiftModal.classList.contains('show')) {
            closeAddShiftRowModal();
        }

        // Close context menu
        const contextMenu = document.getElementById('slotContextMenu');
        if (contextMenu && contextMenu.classList.contains('show')) {
            contextMenu.classList.remove('show');
        }

        // Close employee dropdown
        const dropdown = document.getElementById('employeeDropdown');
        if (dropdown && dropdown.classList.contains('show')) {
            dropdown.classList.remove('show');
        }
    }
});

