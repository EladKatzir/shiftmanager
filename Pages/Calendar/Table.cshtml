@section Scripts {
    @* Ops Console Scheduler JavaScript *@
    <script src="~/js/roster-dock.js" asp-append-version="true"></script>
    <script src="~/js/calendar-radar.js" asp-append-version="true"></script>
    <script src="~/js/calendar-fill-handle.js" asp-append-version="true"></script>
    <script>
        // G-07: Keyboard accessibility for assignment slots (Enter/Space to activate, arrow keys to navigate)
        document.addEventListener('keydown', function(e) {
            const slot = e.target.closest('.assignment-slot');
            if (!slot) return;
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                slot.click();
            }
            if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
                e.preventDefault();
                const slots = Array.from(document.querySelectorAll('.assignment-slot[tabindex="0"]'));
                const idx = slots.indexOf(slot);
                const next = e.key === 'ArrowDown' ? slots[idx + 1] : slots[idx - 1];
                if (next) next.focus();
            }
        });

        // B-007: Signal calendar content is ready
        document.addEventListener('DOMContentLoaded', function() {
            const calendarContent = document.querySelector('[data-calendar-content]');
            if (calendarContent && window.CalendarSkeleton) {
                window.CalendarSkeleton.signalReady(calendarContent);
            }
        });
    </script>
}
