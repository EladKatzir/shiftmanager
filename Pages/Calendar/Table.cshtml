/**
 * Reset a detached ShiftInstance back to its Program defaults.
 */
async function resetToProgram(instanceId, event) {
    event.stopPropagation();

    if (!confirm(i18n.resetToProgramConfirm)) {
        return;
    }

    try {
        const csrfToken11 = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const headers11 = {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        };
        if (csrfToken11) headers11['RequestVerificationToken'] = csrfToken11;

        const response = await fetch('/Calendar/Table?handler=ResetInstanceToProgram', {
            method: 'POST',
            headers: headers11,
            credentials: 'same-origin',
            body: JSON.stringify({
                shiftInstanceId: instanceId
            })
        });

        if (!response.ok) {
            throw new Error(`Request failed: ${response.status}`);
        }

        const result = await response.json();

        if (result.success) {
            // Reload page to show updated state
            location.reload();
        } else {
            window.FeedbackModal.show('error', '@Localizer["Error_Prefix"].Value.Trim()' + result.error);
        }
    } catch (error) {
        console.error('Error resetting shift to Program:', error);
        window.FeedbackModal.show('error', '@Localizer["Error_FailedToResetShift"].Value.Trim()');
    }
}

/**
 * Detach a ShiftInstance from its Program (mark as manually modified).
 * This is automatically called when staffing is adjusted on a Program-generated shift.
 */
async function detachFromProgram(instanceId, reason) {
    try {
        const csrfToken12 = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const headers12 = {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        };
        if (csrfToken12) headers12['RequestVerificationToken'] = csrfToken12;

        const response = await fetch('/Calendar/Table?handler=DetachInstance', {
            method: 'POST',
            headers: headers12,
            credentials: 'same-origin',
            body: JSON.stringify({
                shiftInstanceId: instanceId,
                reason: reason
            })
        });

        if (!response.ok) {
            throw new Error(`Request failed: ${response.status}`);
        }

        const result = await response.json();

        if (result.success) {
            return true;
        } else {
            console.error('Failed to detach instance:', result.error);
            return false;
        }
    } catch (error) {
        console.error('Error detaching shift from Program:', error);
        return false;
    }
}

// Molecule mode navigation
function updateMoleculeFilter() {
    const moleculeSelect = document.getElementById('moleculeSelect');
    const jobTypeSelect = document.getElementById('jobTypeSelect');
    const moleculeId = moleculeSelect ? moleculeSelect.value : '';
    const jobTypeId = jobTypeSelect ? jobTypeSelect.value : '';

    let url = '/Calendar/Table?view=@Model.ViewMode&start=@Model.StartDate.ToString("yyyy-MM-dd")';
    if (moleculeId) {
        url += '&MoleculeId=' + moleculeId;
        if (jobTypeId) {
            url += '&JobTypeId=' + jobTypeId;
        }
    }
    window.location.href = url;
}

