@page
@model ShiftManager.Pages.Calendar.OnCallModel
@using ShiftManager.ViewComponents
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@inject IStringLocalizer<SharedResources> Localizer
@inject ShiftManager.Services.ILocalizationService Localization
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["OnDutyCalendar"];
}

@* Breadcrumb *@
@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Calendars"], Url = "/Calendar/Month" },
    new BreadcrumbItem { Label = Localizer["OnDutyCalendar"], IsActive = true }
})

<div class="oncall-calendar" data-ui-version="v2">
    @* Toolbar *@
    <div class="oncall-calendar__toolbar">
        <div class="oncall-calendar__toolbar-row">
            @* Area selector *@
            @if (Model.AvailableAreas.Any())
            {
                <div class="oncall-calendar__selector">
                    <label for="areaSelect">@Localizer["Area"]</label>
                    <select id="areaSelect" class="form-select" onchange="updateCalendarFilters()">
                        <option value="">@Localizer["AllAreas"]</option>
                        @foreach (var area in Model.AvailableAreas)
                        {
                            var isSelected = area.Id == Model.AreaId;
                            <option value="@area.Id" selected="@isSelected">@area.DisplayName</option>
                        }
                    </select>
                </div>
            }

            @* Duty type filter *@
            @if (Model.DutyTypes.Any())
            {
                <div class="oncall-calendar__selector">
                    <label for="dutyTypeSelect">@Localizer["OnDutyType"]</label>
                    <select id="dutyTypeSelect" class="form-select" onchange="updateCalendarFilters()">
                        <option value="">@Localizer["All"]</option>
                        @foreach (var dutyType in Model.DutyTypes)
                        {
                            var isSelected = dutyType.TypeValue == Model.DutyTypeFilter;
                            <option value="@dutyType.TypeValue" selected="@isSelected">@dutyType.Icon @dutyType.Name</option>
                        }
                    </select>
                </div>
            }

            @* View mode selector *@
            <div class="oncall-calendar__selector">
                <label for="viewModeSelect">@Localizer["ViewMode"]</label>
                <select id="viewModeSelect" class="form-select" onchange="updateCalendarFilters()">
                    <option value="week" selected="@(Model.ViewMode == "week")">@Localizer["Week"]</option>
                    <option value="2weeks" selected="@(Model.ViewMode == "2weeks")">@Localizer["TwoWeeks"]</option>
                    <option value="month" selected="@(Model.ViewMode == "month")">@Localizer["Month"]</option>
                </select>
            </div>
        </div>

        <div class="oncall-calendar__toolbar-row">
            @* Date navigation *@
            <div class="oncall-calendar__date-nav">
                <a href="?AreaId=@Model.AreaId&Start=@Model.PreviousStart&ViewMode=@Model.ViewMode&DutyTypeFilter=@Model.DutyTypeFilter"
                   class="btn btn-ghost oncall-calendar__nav-btn"
                   title="@Localizer["Previous"]">
                    <span class="nav-icon">&larr;</span>
                    <span class="nav-text">@Localizer["Previous"]</span>
                </a>

                <div class="oncall-calendar__date-display">
                    <input type="date"
                           id="datePickerInput"
                           value="@Model.StartDate.ToString("yyyy-MM-dd")"
                           onchange="navigateToDate(this.value)"
                           class="oncall-calendar__date-picker" />
                    <span class="oncall-calendar__date-label">
                        @Localization.FormatMediumDate(Model.StartDate) - @Localization.FormatMediumDate(Model.EndDate)
                    </span>
                </div>

                <a href="?AreaId=@Model.AreaId&Start=@Model.NextStart&ViewMode=@Model.ViewMode&DutyTypeFilter=@Model.DutyTypeFilter"
                   class="btn btn-ghost oncall-calendar__nav-btn"
                   title="@Localizer["Next"]">
                    <span class="nav-text">@Localizer["Next"]</span>
                    <span class="nav-icon">&rarr;</span>
                </a>
            </div>

            @* Action buttons *@
            <div class="oncall-calendar__actions">
                <button type="button" class="btn btn-secondary" onclick="window.print()" title="@Localizer["Print"]">
                    <span class="btn-icon">&#128438;</span>
                    <span class="btn-text">@Localizer["Print"]</span>
                </button>
            </div>
        </div>

        <div class="oncall-calendar__toolbar-row">
            @* Toggle buttons *@
            <div class="oncall-calendar__toggles">
                @* Just Mine filter *@
                <div class="oncall-calendar__toggle-group">
                    <a href="?AreaId=@Model.AreaId&Start=@Model.StartDate.ToString("yyyy-MM-dd")&ViewMode=@Model.ViewMode&DutyTypeFilter=@Model.DutyTypeFilter&JustMine=@(!Model.JustMine)"
                       class="btn @(Model.JustMine ? "btn-primary" : "btn-ghost")">
                        @Localizer["JustMine"]
                    </a>
                </div>

                @* Show Friends toggle *@
                <div class="oncall-calendar__toggle-group">
                    <button id="friendsToggle" type="button" class="btn btn-ghost" onclick="toggleFriendsHighlight()">
                        <span>🤝</span> <loc key="ShowFriends" />
                    </button>
                </div>
            </div>

            @* Legend for duty types *@
            @if (Model.DutyTypes.Any())
            {
                <div class="oncall-calendar__legend">
                    @foreach (var dutyType in Model.DutyTypes.Where(dt => !dt.IsBackupType))
                    {
                        <div class="oncall-calendar__legend-item">
                            <span class="oncall-calendar__legend-color" style="background-color: @dutyType.Color"></span>
                            <span class="oncall-calendar__legend-label">@dutyType.Icon @dutyType.Name</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @* Calendar Table *@
    @if (Model.CalendarData.Rows.Any())
    {
        @await Component.InvokeAsync("ExcelCalendarTable", Model.CalendarData)
    }
    else
    {
        <div class="oncall-calendar__empty">
            <div class="oncall-calendar__empty-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
            </div>
            <h3 class="oncall-calendar__empty-title">@Localizer["Calendar_Empty_NoOnDuty"]</h3>
            <p class="oncall-calendar__empty-message">
                @Localizer["Calendar_Empty_NoOnDutyMessage"]
            </p>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/calendar-lazy-rows.js" asp-append-version="true"></script>
    <script src="~/js/calendar-bottom-sheet.js" asp-append-version="true"></script>
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/calendar-realtime.js" asp-append-version="true"></script>
    <script>
        // Initialize real-time updates
        document.addEventListener('DOMContentLoaded', function() {
            const areaId = @(Model.AreaId ?? 0);
            if (areaId > 0) {
                CalendarRealtime.initialize({
                    calendarType: 'oncall',
                    scope: {
                        areaId: areaId
                    },
                    onRefresh: refreshCalendarData,
                    handlers: {
                        onOnCallChanged: handleOnCallChanged
                    }
                });
            }
        });

        // Refresh calendar data via AJAX
        async function refreshCalendarData() {
            const startDate = '@Model.StartDate.ToString("yyyy-MM-dd")';
            const endDate = '@Model.EndDate.ToString("yyyy-MM-dd")';
            const areaId = @(Model.AreaId ?? 0);

            if (areaId <= 0) return;

            try {
                const response = await fetch(
                    `/Api/Calendar/GetOnCallData?areaId=${areaId}&startDate=${startDate}&endDate=${endDate}`,
                    { credentials: 'same-origin' }
                );

                if (!response.ok) throw new Error('Failed to refresh');

                const result = await response.json();
                if (result.success) {
                    // Full page refresh for now
                    location.reload();
                }
            } catch (error) {
                console.error('Shadow refresh failed:', error);
            }
        }

        // Handle real-time on-call change
        function handleOnCallChanged(evt) {
            refreshCalendarData();
        }

        // Update calendar with new filter selections
        function updateCalendarFilters() {
            const areaSelect = document.getElementById('areaSelect');
            const areaId = areaSelect ? areaSelect.value : '';
            const dutyTypeSelect = document.getElementById('dutyTypeSelect');
            const dutyTypeFilter = dutyTypeSelect ? dutyTypeSelect.value : '';
            const viewMode = document.getElementById('viewModeSelect').value;

            const params = new URLSearchParams(window.location.search);
            if (areaId) {
                params.set('AreaId', areaId);
            } else {
                params.delete('AreaId');
            }
            if (dutyTypeFilter) {
                params.set('DutyTypeFilter', dutyTypeFilter);
            } else {
                params.delete('DutyTypeFilter');
            }
            params.set('ViewMode', viewMode);

            window.location.href = window.location.pathname + '?' + params.toString();
        }

        // Navigate to a specific date
        function navigateToDate(dateStr) {
            const params = new URLSearchParams(window.location.search);
            params.set('Start', dateStr);
            window.location.href = window.location.pathname + '?' + params.toString();
        }

        // Keyboard navigation
        document.addEventListener('keydown', function(e) {
            // Left arrow - previous period
            if (e.key === 'ArrowLeft' && e.altKey) {
                document.querySelector('.oncall-calendar__nav-btn:first-child')?.click();
            }
            // Right arrow - next period
            if (e.key === 'ArrowRight' && e.altKey) {
                document.querySelector('.oncall-calendar__nav-btn:last-child')?.click();
            }
            // P key - print
            if (e.key === 'p' && e.ctrlKey) {
                e.preventDefault();
                window.print();
            }
        });
    </script>
}

@section Styles {
    <style>
        /* On-Call Calendar Layout */
        .oncall-calendar {
            padding: 1rem;
        }

        .oncall-calendar__toolbar {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1rem;
            margin-bottom: 1.5rem;
        }

        .oncall-calendar__toolbar-row {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .oncall-calendar__toolbar-row:last-child {
            margin-bottom: 0;
        }

        /* Selectors */
        .oncall-calendar__selector {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
            min-width: 150px;
        }

        .oncall-calendar__selector label {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .oncall-calendar__selector .form-select {
            padding: 0.5rem 0.75rem;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--bg);
            min-height: 38px;
        }

        /* Date Navigation */
        .oncall-calendar__date-nav {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .oncall-calendar__nav-btn {
            display: flex;
            align-items: center;
            gap: 0.25rem;
            min-height: 38px;
        }

        .oncall-calendar__date-display {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            position: relative;
        }

        .oncall-calendar__date-picker {
            position: absolute;
            opacity: 0;
            width: 100%;
            height: 100%;
            cursor: pointer;
        }

        .oncall-calendar__date-label {
            font-weight: 600;
            font-size: 0.95rem;
            padding: 0.5rem 1rem;
            background: var(--surface-soft);
            border-radius: 6px;
            cursor: pointer;
        }

        /* Actions */
        .oncall-calendar__actions {
            margin-left: auto;
        }

        .oncall-calendar__actions .btn-icon {
            font-size: 1.1rem;
        }

        /* Toggles */
        .oncall-calendar__toggles {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .oncall-calendar__toggle-group {
            display: flex;
            background: var(--surface-soft);
            border-radius: 6px;
            overflow: hidden;
        }

        .oncall-calendar__toggle-group .btn {
            border-radius: 6px;
            border: none;
            min-height: 36px;
        }

        /* Legend */
        .oncall-calendar__legend {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            margin-left: auto;
        }

        .oncall-calendar__legend-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.85rem;
        }

        .oncall-calendar__legend-color {
            width: 12px;
            height: 12px;
            border-radius: 3px;
        }

        .oncall-calendar__legend-label {
            color: var(--muted);
        }

        /* Empty State */
        .oncall-calendar__empty {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 4rem 2rem;
            background: var(--surface);
            border-radius: 12px;
            border: 2px dashed var(--border);
        }

        .oncall-calendar__empty-icon {
            color: var(--muted);
            opacity: 0.5;
            margin-bottom: 1.5rem;
        }

        .oncall-calendar__empty-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--text);
            margin: 0 0 0.75rem 0;
        }

        .oncall-calendar__empty-message {
            color: var(--muted);
            font-size: 0.95rem;
            margin: 0;
            max-width: 400px;
            line-height: 1.5;
        }

        /* Row colors based on duty type */
        .oncall-calendar :deep([data-row-id^="dutytype-"]) {
            border-left: 4px solid var(--row-color, var(--border));
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .oncall-calendar__toolbar-row {
                flex-direction: column;
                align-items: stretch;
            }

            .oncall-calendar__selector {
                width: 100%;
            }

            .oncall-calendar__date-nav {
                width: 100%;
                justify-content: space-between;
            }

            .oncall-calendar__actions {
                margin-left: 0;
                width: 100%;
            }

            .oncall-calendar__actions .btn {
                width: 100%;
                justify-content: center;
            }

            .oncall-calendar__toggles {
                width: 100%;
            }

            .oncall-calendar__toggle-group {
                flex: 1;
            }

            .oncall-calendar__toggle-group .btn {
                flex: 1;
                justify-content: center;
            }

            .oncall-calendar__legend {
                margin-left: 0;
                width: 100%;
                justify-content: flex-start;
            }

            .oncall-calendar__nav-btn .nav-text {
                display: none;
            }
        }

        @@media (max-width: 480px) {
            .oncall-calendar {
                padding: 0.5rem;
            }

            .oncall-calendar__toolbar {
                padding: 0.75rem;
            }

            .oncall-calendar__date-label {
                font-size: 0.85rem;
                padding: 0.375rem 0.75rem;
            }
        }

        /* Print styles */
        @@media print {
            .oncall-calendar__toolbar {
                display: none;
            }

            .oncall-calendar {
                padding: 0;
            }
        }
    </style>
}
