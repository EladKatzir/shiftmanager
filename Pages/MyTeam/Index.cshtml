@page
@model ShiftManager.Pages.MyTeam.IndexModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["MyGroups"];
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["MyGroups"], IsActive = true }
})

<div data-ui-version="v2">

@section Styles {
    <style>
        /* Page Header */
        .page-header {
            margin-bottom: 2rem;
        }

        .page-title {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text);
            margin: 0 0 0.5rem 0;
            line-height: 1.2;
        }

        .page-subtitle {
            font-size: 1rem;
            color: var(--text-muted);
            margin: 0;
            line-height: 1.5;
        }

        /* Container */
        .myteam-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        /* Top Action Bar */
        .myteam-topbar {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1.25rem 1.5rem;
            margin-bottom: 1.5rem;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            box-shadow: var(--shadow-sm);
        }

        .calendar-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--text);
            margin: 0;
        }

        .topbar-actions {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.625rem 1.25rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: var(--surface-soft);
            color: var(--text);
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.15s ease;
            text-decoration: none;
        }

        .btn:hover {
            background: var(--surface-elevated);
            border-color: var(--primary);
            transform: translateY(-1px);
            box-shadow: var(--shadow-sm);
        }

        .btn-primary {
            background: var(--primary);
            color: var(--primary-contrast);
            border-color: var(--primary);
        }

        .btn-primary:hover {
            background: var(--primary-hover);
            border-color: var(--primary-hover);
            box-shadow: var(--shadow-md);
        }

        /* Week Navigation */
        .week-nav {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            padding: 1.25rem 1.5rem;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            margin-bottom: 1.5rem;
            box-shadow: var(--shadow-sm);
            flex-wrap: wrap;
        }

        .week-nav .btn {
            white-space: nowrap;
            flex-shrink: 0;
        }

        .week-range {
            font-size: 1.125rem;
            font-weight: 600;
            color: var(--text);
            min-width: 250px;
            text-align: center;
        }

        /* Week View Container */
        .week-view-container {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        /* Day Headers Row */
        .day-headers {
            display: grid;
            grid-template-columns: 200px repeat(7, 1fr);
            gap: 0.75rem;
            padding: 0 1rem;
            margin-bottom: 0.5rem;
        }

        .day-header {
            text-align: center;
            font-weight: 600;
            font-size: 0.8125rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .day-header:first-child {
            text-align: start;
        }

        /* Member Card */
        .member-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1.25rem;
            transition: all 0.2s ease;
            box-shadow: var(--shadow-sm);
        }

        .member-card:hover {
            box-shadow: var(--shadow-md);
            transform: translateY(-2px);
        }

        .member-card-content {
            display: grid;
            grid-template-columns: 200px repeat(7, 1fr);
            gap: 0.75rem;
            align-items: center;
        }

        /* Member Info Section */
        .member-info-section {
            display: flex;
            align-items: center;
            gap: 0.875rem;
            padding-right: 1rem;
        }

        .member-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: var(--primary);
            color: var(--primary-contrast);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 1rem;
            flex-shrink: 0;
            box-shadow: var(--shadow-sm);
        }

        .member-details {
            flex: 1;
            min-width: 0;
        }

        .member-name {
            font-weight: 600;
            font-size: 0.9375rem;
            color: var(--text);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-bottom: 0.125rem;
        }

        .member-role {
            font-size: 0.8125rem;
            color: var(--text-muted);
        }

        /* Day Cell */
        .day-cell {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 70px;
        }

        /* Status Badge */
        .status-badge {
            display: inline-flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 0.25rem;
            padding: 0.625rem 0.875rem;
            border-radius: 8px;
            font-size: 0.8125rem;
            font-weight: 500;
            transition: all 0.2s ease;
            border: 1px solid transparent;
            min-height: 56px;
            width: 100%;
            text-align: center;
        }

        .status-badge.clickable {
            cursor: pointer;
        }

        .status-badge.clickable:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

        .status-badge-content {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            justify-content: center;
        }

        .status-icon {
            font-size: 1.125rem;
            line-height: 1;
        }

        .status-label {
            line-height: 1.2;
        }

        .status-badge.free {
            background: var(--surface-soft);
            color: var(--text-muted);
            border-color: var(--border);
        }

        .status-badge.vacation {
            background: var(--info-soft);
            color: var(--info);
            border-color: var(--info);
        }

        [data-theme="dark"] .status-badge.vacation {
            background: var(--info-soft);
            color: var(--info);
            border-color: var(--info);
        }

        .status-badge.vacation-partial {
            background: var(--info-soft);
            color: var(--info);
            border-color: var(--info);
            font-size: 0.75rem;
        }

        [data-theme="dark"] .status-badge.vacation-partial {
            background: var(--info-soft);
            color: var(--info);
            border-color: var(--info);
        }

        .status-badge.after-partial {
            background: var(--warning-soft);
            color: var(--warning);
            border-color: var(--warning);
            font-size: 0.75rem;
        }

        [data-theme="dark"] .status-badge.after-partial {
            background: var(--warning-soft);
            color: var(--warning);
            border-color: var(--warning);
        }

        .status-badge.onduty {
            background: var(--danger-soft);
            color: var(--danger);
            border-color: var(--danger);
        }

        [data-theme="dark"] .status-badge.onduty {
            background: var(--danger-soft);
            color: var(--danger);
            border-color: var(--danger);
        }

        .status-badge.shift {
            background: var(--accent-soft);
            color: var(--accent);
            border-color: var(--accent);
        }

        [data-theme="dark"] .status-badge.shift {
            background: var(--accent-soft);
            color: var(--accent);
            border-color: var(--accent);
        }

        .status-badge.chore {
            background: var(--warning-soft);
            color: var(--warning);
            border-color: var(--warning);
        }

        [data-theme="dark"] .status-badge.chore {
            background: var(--warning-soft);
            color: var(--warning);
            border-color: var(--warning);
        }

        .status-time {
            font-size: 0.75rem;
            opacity: 0.85;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: var(--shadow-sm);
        }

        .empty-state-icon {
            font-size: 4rem;
            margin-bottom: 1rem;
            opacity: 0.5;
        }

        .empty-state h3 {
            font-size: 1.5rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 0.5rem;
        }

        .empty-state p {
            font-size: 1rem;
            color: var(--text-muted);
            margin-bottom: 1.5rem;
        }

        /* Modals */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(4px);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        .modal.active {
            display: flex;
        }

        .modal-content {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            max-width: 600px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: var(--shadow-lg);
            animation: modalFadeIn 0.2s ease;
        }

        .modal-content.large {
            max-width: 900px;
        }

        @@keyframes modalFadeIn {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .modal-header {
            padding: 1.5rem 1.75rem;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--surface-soft);
            border-radius: 16px 16px 0 0;
        }

        .modal-header h2 {
            margin: 0;
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--text);
        }

        .modal-close {
            background: none;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: var(--text-muted);
            padding: 0;
            width: 2rem;
            height: 2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
            transition: all 0.15s ease;
        }

        .modal-close:hover {
            background: var(--surface-elevated);
            color: var(--text);
        }

        .modal-body {
            padding: 1.75rem;
        }

        .modal-footer {
            padding: 1.5rem 1.75rem;
            border-top: 1px solid var(--border);
            display: flex;
            gap: 0.75rem;
            justify-content: flex-end;
            background: var(--surface-soft);
            border-radius: 0 0 16px 16px;
        }

        /* Calendar Cards (for switcher) */
        .calendar-list {
            display: flex;
            flex-direction: column;
            gap: 0.875rem;
        }

        .calendar-card {
            padding: 1.25rem;
            background: var(--surface-soft);
            border: 2px solid var(--border);
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .calendar-card:hover {
            border-color: var(--primary);
            background: var(--surface-elevated);
            box-shadow: var(--shadow-sm);
        }

        .calendar-card.active {
            border-color: var(--primary);
            background: var(--primary-bg);
        }

        .calendar-info h3 {
            margin: 0 0 0.25rem 0;
            font-size: 1rem;
            font-weight: 600;
            color: var(--text);
        }

        .calendar-meta {
            font-size: 0.8125rem;
            color: var(--text-muted);
        }

        .calendar-actions {
            display: flex;
            gap: 0.5rem;
        }

        .icon-btn {
            padding: 0.5rem;
            background: none;
            border: 1px solid var(--border);
            border-radius: 6px;
            cursor: pointer;
            color: var(--text);
            transition: all 0.15s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .icon-btn:hover {
            background: var(--surface);
            border-color: var(--primary);
            transform: translateY(-1px);
        }

        /* Form Elements */
        .form-group {
            margin-bottom: 1.25rem;
        }

        .form-label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 500;
            font-size: 0.875rem;
            color: var(--text);
        }

        .form-input {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: var(--bg);
            color: var(--text);
            font-size: 0.9375rem;
            transition: all 0.15s ease;
        }

        .form-input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--primary-bg);
        }

        /* Member Selector - Two Pane */
        .member-selector {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.25rem;
        }

        .member-pane {
            border: 1px solid var(--border);
            border-radius: 10px;
            overflow: hidden;
            background: var(--surface-soft);
        }

        .pane-header {
            padding: 1rem 1.25rem;
            background: var(--surface-elevated);
            border-bottom: 1px solid var(--border);
            font-weight: 600;
            font-size: 0.875rem;
            color: var(--text);
        }

        .pane-search {
            padding: 0.875rem 1rem;
            border: none;
            border-bottom: 1px solid var(--border);
            background: var(--bg);
            color: var(--text);
            width: 100%;
            font-size: 0.875rem;
        }

        .pane-search:focus {
            outline: none;
            border-bottom-color: var(--primary);
        }

        .member-list {
            max-height: 400px;
            overflow-y: auto;
        }

        .member-item {
            padding: 0.875rem 1.25rem;
            border-bottom: 1px solid var(--border);
            cursor: pointer;
            transition: all 0.15s ease;
            display: flex;
            align-items: center;
            gap: 0.875rem;
        }

        .member-item:hover {
            background: var(--surface-elevated);
        }

        .member-item.selected {
            background: var(--primary-bg);
            border-left: 3px solid var(--primary);
        }

        .member-checkbox {
            width: 1.25rem;
            height: 1.25rem;
            cursor: pointer;
        }

        .member-info {
            flex: 1;
            min-width: 0;
        }

        .member-email {
            font-size: 0.8125rem;
            color: var(--text-muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Loading State */
        .loading {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem;
            color: var(--text-muted);
        }

        .spinner {
            border: 3px solid var(--border);
            border-top-color: var(--primary);
            border-radius: 50%;
            width: 2.5rem;
            height: 2.5rem;
            animation: spin 0.8s linear infinite;
        }

        @@keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Desktop/Mobile visibility helpers */
        .desktop-only {
            display: contents;
        }

        .mobile-only {
            display: none;
        }

        /* Responsive */
        @@media (max-width: 1200px) {
            .day-headers,
            .member-card-content {
                grid-template-columns: 160px repeat(7, 1fr);
            }

            .status-badge {
                font-size: 0.75rem;
                padding: 0.5rem 0.625rem;
                min-height: 50px;
            }

            .day-header {
                font-size: 0.75rem;
            }
        }

        @@media (max-width: 968px) {
            /* Switch to mobile layout */
            .desktop-only {
                display: none !important;
            }

            .mobile-only {
                display: grid;
            }

            .day-headers {
                display: none;
            }

            .member-card-content {
                grid-template-columns: 1fr;
                gap: 1rem;
            }

            .member-info-section {
                padding-right: 0;
                border-bottom: 1px solid var(--border);
                padding-bottom: 1rem;
            }

            .day-cell {
                min-height: auto;
            }

            .days-grid {
                grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
                gap: 0.75rem;
            }

            .day-cell-mobile {
                display: flex;
                flex-direction: column;
                gap: 0.5rem;
            }

            .day-label-mobile {
                font-size: 0.75rem;
                font-weight: 600;
                color: var(--text-muted);
                text-transform: uppercase;
                text-align: center;
            }

            .status-badge {
                font-size: 0.75rem;
                min-height: 55px;
            }
        }

        @@media (max-width: 768px) {
            .member-selector {
                grid-template-columns: 1fr;
            }

            .topbar-actions {
                width: 100%;
            }

            .btn {
                flex: 1;
            }

            .days-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .myteam-topbar {
                flex-direction: column;
                align-items: stretch;
            }

            .calendar-title {
                text-align: center;
                margin-bottom: 0.5rem;
            }

            .week-nav {
                flex-wrap: wrap;
            }

            .week-range {
                width: 100%;
                order: -1;
                margin-bottom: 0.5rem;
            }
        }

        @@media (max-width: 480px) {
            .member-avatar {
                width: 36px;
                height: 36px;
                font-size: 0.875rem;
            }

            .member-name {
                font-size: 0.875rem;
            }

            .days-grid {
                grid-template-columns: 1fr;
            }

            .page-title {
                font-size: 1.75rem;
            }

            .btn span:not(.icon) {
                display: none;
            }
        }
    </style>
}

<!-- Page Header -->
<div class="page-header">
    <h1 class="page-title"><loc key="MyGroups" /></h1>
    <p class="page-subtitle"><loc key="MyGroupsSubtitle" /></p>
    <p class="page-instruction" style="font-size: 0.9rem; color: var(--text-muted); margin-top: 0.5rem;"><loc key="MyGroupsExplanation" /></p>
</div>

<div class="myteam-container">
    <!-- Top Action Bar -->
    <div class="myteam-topbar">
        <h2 class="calendar-title" id="calendarName"><loc key="Loading" />...</h2>
        <div class="topbar-actions">
            <button class="btn" id="btnSwitchCalendar">
                <span class="icon">⟳</span>
                <span><loc key="SwitchCalendar" /></span>
            </button>
            <button class="btn" id="btnConfigureMembers">
                <span class="icon">⚙️</span>
                <span><loc key="ConfigureMembers" /></span>
            </button>
            <button class="btn btn-primary" id="btnNewCalendar">
                <span class="icon">+</span>
                <span><loc key="NewCalendar" /></span>
            </button>
        </div>
    </div>

    <!-- Week Navigation -->
    <div class="week-nav">
        <button class="btn" id="btnPrevWeek">&larr; <loc key="PreviousWeek" /></button>
        <div class="week-range" id="weekRange"><loc key="Loading" />...</div>
        <button class="btn" id="btnThisWeek"><loc key="ThisWeek" /></button>
        <button class="btn" id="btnNextWeek"><loc key="NextWeek" /> &rarr;</button>
    </div>

    <!-- Week Grid -->
    <div id="weekGridContainer">
        <div class="loading">
            <div class="spinner"></div>
        </div>
    </div>

    <!-- Empty State (hidden by default) -->
    <div class="empty-state" id="emptyState" style="display: none;">
        <div class="empty-state-icon">📅</div>
        <h3><loc key="NoGroupMembers" /></h3>
        <p><loc key="AddGroupMembersToStart" /></p>
        <button class="btn btn-primary" onclick="document.getElementById('btnConfigureMembers').click()">
            <span class="icon">⚙️</span>
            <span><loc key="ConfigureMembers" /></span>
        </button>
    </div>
</div>

<!-- Calendar Switcher Modal -->
<div class="modal" id="modalSwitchCalendar">
    <div class="modal-content">
        <div class="modal-header">
            <h2><loc key="MyCalendars" /></h2>
            <button class="modal-close" onclick="closeModal('modalSwitchCalendar')" loc-aria-label="Aria_CloseDialog">&times;</button>
        </div>
        <div class="modal-body">
            <div id="calendarListContainer">
                <div class="loading">
                    <div class="spinner"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create/Rename Calendar Modal -->
<div class="modal" id="modalCalendarForm">
    <div class="modal-content">
        <div class="modal-header">
            <h2 id="calendarFormTitle"><loc key="NewCalendar" /></h2>
            <button class="modal-close" onclick="closeModal('modalCalendarForm')" loc-aria-label="Aria_CloseDialog">&times;</button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label class="form-label" for="inputCalendarName"><loc key="CalendarName" /></label>
                <input type="text" id="inputCalendarName" class="form-input"
                       placeholder="@Localizer["CalendarNamePlaceholder"]" maxlength="60">
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn" onclick="closeModal('modalCalendarForm')">@Localizer["Cancel"]</button>
            <button class="btn btn-primary" id="btnSaveCalendar"><loc key="Save" /></button>
        </div>
    </div>
</div>

<!-- Configure Members Modal -->
<div class="modal" id="modalConfigureMembers">
    <div class="modal-content large">
        <div class="modal-header">
            <h2><loc key="ConfigureGroupMembers" /></h2>
            <button class="modal-close" onclick="closeModal('modalConfigureMembers')" loc-aria-label="Aria_CloseDialog">&times;</button>
        </div>
        <div class="modal-body">
            <div id="memberSelectorContainer">
                <div class="loading">
                    <div class="spinner"></div>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn" onclick="closeModal('modalConfigureMembers')">@Localizer["Cancel"]</button>
            <button class="btn btn-primary" id="btnSaveMembers"><loc key="SaveChanges" /></button>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal" id="modalDeleteConfirm">
    <div class="modal-content">
        <div class="modal-header">
            <h2><loc key="DeleteCalendar" /></h2>
            <button class="modal-close" onclick="closeModal('modalDeleteConfirm')" loc-aria-label="Aria_CloseDialog">&times;</button>
        </div>
        <div class="modal-body">
            <p><loc key="ConfirmDeleteCalendar" /> "<span id="deleteCalendarName"></span>"?</p>
            <p style="color: var(--text-muted); font-size: 0.875rem; margin-top: 0.5rem;"><loc key="DeleteCalendarNote" /></p>
        </div>
        <div class="modal-footer">
            <button class="btn" onclick="closeModal('modalDeleteConfirm')">@Localizer["Cancel"]</button>
            <button class="btn" style="background: var(--danger); color: var(--danger-text); border-color: var(--danger);"
                    id="btnConfirmDelete"><loc key="Delete" /></button>
        </div>
    </div>
</div>
</div>

