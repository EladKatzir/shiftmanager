@page
@using Microsoft.AspNetCore.Authorization
@model ShiftManager.Pages.Scheduling.Eligibility.IndexModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<ShiftManager.Resources.SharedResources> L
@inject IAuthorizationService Authz
@{
    Layout = "_Layout";
    ViewData["Title"] = L["Nav2_EligibilityHome_Title"];
    // Each card carries its destination page's policy; render it only if the user is authorized
    // for that destination (visibility == access — no click-into-403 inside this page either).
    var cards = new[]
    {
        (href: "/Owner/Blueprints", icon: "layers", key: "Nav2_Blueprints", policy: "Grant:ManagerHomeAccess"),
        (href: "/Admin/Organization/ChoreTypes", icon: "list-checks", key: "Nav2_ChoreTypes", policy: "Grant:EditChoreTypes"),
        (href: "/Admin/Users", icon: "users", key: "People", policy: "Grant:ManagerHomeAccess"),
    };
}

<p class="lead" style="max-width:62ch;">@L["Nav2_EligibilityHome_Intro"]</p>

<div class="elig-home-grid">
    @foreach (var c in cards)
    {
        if ((await Authz.AuthorizeAsync(User, c.policy)).Succeeded)
        {
            <a class="elig-home-card" href="@c.href">
                <span class="elig-home-card__icon"><i data-lucide="@c.icon"></i></span>
                <span class="elig-home-card__title">@L[c.key]</span>
            </a>
        }
    }
</div>

<style>
    .elig-home-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; margin-top: 1.25rem; }
    .elig-home-card { display: flex; flex-direction: column; gap: 0.6rem; padding: 1.25rem; border: 1px solid var(--border); border-radius: 0.75rem; background: var(--surface); color: var(--text); text-decoration: none; transition: border-color 0.15s ease, transform 0.15s ease; }
    .elig-home-card:hover { border-color: var(--primary); transform: translateY(-2px); }
    .elig-home-card__icon { color: var(--primary); }
    .elig-home-card__title { font-weight: 600; }
</style>
