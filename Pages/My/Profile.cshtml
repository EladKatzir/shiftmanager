@page
@model ShiftManager.Pages.My.ProfileModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
    var isOwner = User.IsInRole("Owner");
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["MyProfile"], IsActive = true }
})

<h2>@Localizer["MyProfile"]</h2>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="card" style="background-color: var(--success); color: var(--success-text); margin-bottom: 1rem;">
        ✓ @Model.SuccessMessage
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="card" style="background-color: var(--danger); color: var(--danger-text); margin-bottom: 1rem;">
        ✗ @Model.ErrorMessage
    </div>
}

<form method="post" enctype="multipart/form-data">
    <div class="card">
        <h3 style="margin-top:0">@Localizer["Avatar"]</h3>

        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
            @if (!string.IsNullOrEmpty(Model.AvatarUrl))
            {
                <img src="@Model.AvatarUrl" alt="@Localizer["Avatar"]" style="width: 100px; height: 100px; border-radius: 50%; object-fit: cover;" />
            }
            else
            {
                <div style="width: 100px; height: 100px; border-radius: 50%; background-color: var(--primary); color: var(--primary-text); display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: bold;">
                    @Model.InitialsForAvatar
                </div>
            }

            <div style="flex: 1;">
                <label>@Localizer["UploadNewAvatar"] (max 5MB, JPEG/PNG)</label>
                <input type="file" name="AvatarFile" accept=".jpg,.jpeg,.png" />

                @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                {
                    <button type="submit" asp-page-handler="DeleteAvatar" class="btn-secondary" style="margin-top: 0.5rem;">
                        @Localizer["DeleteAvatar"]
                    </button>
                }
            </div>
        </div>
    </div>

    <div class="card">
        <h3 style="margin-top:0">@Localizer["PersonalInformation"]</h3>

        <label>@Localizer["DisplayName"] *</label>
        <input type="text" asp-for="DisplayName" required />

        <label>@Localizer["PreferredName"]</label>
        <input type="text" asp-for="PreferredName" placeholder="@Localizer["PreferredName"]" />

        <label>@Localizer["Phone"]</label>
        <input type="tel" asp-for="Phone" placeholder="050-1234567" />

        <label>@Localizer["City"]</label>
        <input type="text" asp-for="City" />

        <label>@Localizer["DateOfBirth"]</label>
        <input type="date" asp-for="DateOfBirth" />
    </div>

    <div class="card">
        <h3 style="margin-top:0">@Localizer["ProfessionalInformation"]</h3>

        @if (!isOwner)
        {
            <div style="background-color: rgba(var(--primary-rgb), 0.1); color: var(--text); padding: 0.75rem; border-radius: 0.25rem; margin-bottom: 1rem; border-left: 3px solid var(--primary);">
                ℹ️ @Localizer["ManagerOnlyFields"]
            </div>
        }

        <label>
            @Localizer["Department"]
            @if (!isOwner)
            {
                <span style="color: var(--muted); font-size: 0.875rem;">🔒</span>
            }
        </label>
        @if (isOwner)
        {
            <input type="text" asp-for="Department" placeholder="@Localizer["Department"]" />
        }
        else
        {
            <input type="text" value="@Model.Department" readonly style="background-color: var(--surface); cursor: not-allowed;" />
        }

        <label>
            @Localizer["JobTitle"]
            @if (!isOwner)
            {
                <span style="color: var(--muted); font-size: 0.875rem;">🔒</span>
            }
        </label>
        @if (isOwner)
        {
            <input type="text" asp-for="JobTitle" placeholder="@Localizer["JobTitle"]" />
        }
        else
        {
            <input type="text" value="@Model.JobTitle" readonly style="background-color: var(--surface); cursor: not-allowed;" />
        }

        <label>
            @Localizer["HireDate"]
            @if (!isOwner)
            {
                <span style="color: var(--muted); font-size: 0.875rem;">🔒</span>
            }
        </label>
        @if (isOwner)
        {
            <input type="date" asp-for="HireDate" />
        }
        else
        {
            <input type="text" value="@Model.HireDate?.ToString("yyyy-MM-dd")" readonly style="background-color: var(--surface); cursor: not-allowed;" />
        }

        <label>@Localizer["Skills"]</label>
        <input type="text" asp-for="Skills" placeholder="@Localizer["SkillsPlaceholder"]" />

        <label>@Localizer["Certifications"]</label>
        <input type="text" asp-for="Certifications" placeholder="@Localizer["CertificationsPlaceholder"]" />
    </div>

    <div class="card">
        <h3 style="margin-top:0">@Localizer["EmergencyContact"]</h3>

        <label>@Localizer["EmergencyContactName"]</label>
        <input type="text" asp-for="EmergencyContactName" />

        <label>@Localizer["EmergencyContactPhone"]</label>
        <input type="tel" asp-for="EmergencyContactPhone" placeholder="050-1234567" />

        <label>@Localizer["EmergencyContactRelation"]</label>
        <input type="text" asp-for="EmergencyContactRelation" />
    </div>

    <div style="display: flex; gap: 0.5rem;">
        <button type="submit" class="btn-primary">@Localizer["SaveChanges"]</button>
        <a href="/My" class="btn-secondary">@Localizer["Cancel"]</a>
    </div>
</form>
