@page
@model ShiftManager.Pages.My.IndexModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["MyOverview"];
    var today = DateOnly.FromDateTime(DateTime.Today);
    var tomorrow = today.AddDays(1);
    var weekEnd = today.AddDays(7);
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["MyOverview"], IsActive = true }
})

<style>
/* Overview Top Bar */
.overview-topbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 1rem;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.topbar-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
}

.time-range-switcher {
    display: flex;
    gap: 0.5rem;
    align-items: center;
}

.time-range-switcher .btn-group {
    display: flex;
    gap: 0.25rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.25rem;
    background: var(--bg);
}

.time-range-switcher .btn-group .btn {
    padding: 0.5rem 1rem;
    border: none;
    background: transparent;
    color: var(--text);
    border-radius: 0.375rem;
    cursor: pointer;
    transition: all 0.2s;
}

.time-range-switcher .btn-group .btn.active {
    background: var(--primary);
    color: var(--primary-contrast);
}

.time-range-switcher .btn-group .btn:hover:not(.active) {
    background: var(--surface);
}

.type-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
}

.type-filters label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 2rem;
    cursor: pointer;
    background: var(--bg);
    transition: all 0.2s;
    color: var(--text);
    font-size: 0.9rem;
}

.type-filters label:hover {
    border-color: var(--primary);
    background: var(--surface);
}

.type-filters input[type="checkbox"] {
    margin: 0;
}

.legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    font-size: 0.85rem;
    color: var(--muted);
}

.legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
}

.legend-dot.vacation { background: var(--info); }
.legend-dot.onduty { background: var(--danger); }
.legend-dot.shift { background: var(--accent); }
.legend-dot.chore { background: var(--warning); }

/* View Toggle */
.view-toggle {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
}

.view-toggle .btn {
    flex: 1;
    padding: 0.75rem;
    text-align: center;
}

.view-toggle .btn.active {
    background: var(--primary);
    color: var(--primary-contrast);
    border-color: var(--primary);
}

/* Timeline */
.timeline-section {
    margin-bottom: 2rem;
}

.timeline-section h3 {
    margin: 0 0 1rem 0;
    color: var(--text);
    font-size: 1.1rem;
    font-weight: 600;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--border);
}

.timeline {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.timeline-item {
    display: flex;
    align-items: stretch;
    gap: 1rem;
    padding: 1rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    transition: all 0.2s;
    cursor: pointer;
    position: relative;
}

.timeline-item:hover {
    border-color: var(--primary);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transform: translateY(-1px);
}

.timeline-item.filtered {
    display: none;
}

.item-colorbar {
    width: 4px;
    border-radius: 2px;
    flex-shrink: 0;
}

.item-colorbar.vacation { background: var(--info); }
.item-colorbar.onduty { background: var(--danger); }
.item-colorbar.shift { background: var(--accent); }
.item-colorbar.chore { background: var(--warning); }

.item-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
}

.item-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.item-title {
    font-weight: 600;
    color: var(--text);
    font-size: 1rem;
}

.item-time {
    color: var(--muted);
    font-size: 0.9rem;
}

.item-meta {
    color: var(--muted);
    font-size: 0.85rem;
}

.item-date {
    color: var(--muted);
    font-size: 0.85rem;
    white-space: nowrap;
}

.conflict-badge {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background: var(--warning);
    color: var(--warning-text);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
}

/* Empty State */
.empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--muted);
}

.empty-state-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
}

.empty-state-title {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--text);
}

.empty-state-text {
    font-size: 1rem;
    margin-bottom: 1rem;
}

/* Stats Section */
.stats-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
}

.stats-header h3 {
    margin: 0;
}

.stats-toggle {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
}

.stats-chart {
    position: relative;
    width: 100%;
    height: 300px;
}

.stats-chart canvas {
    display: block;
    width: 100%;
    height: 100%;
}

/* Detail Drawer */
.drawer {
    position: fixed;
    right: -400px;
    top: 0;
    width: 400px;
    height: 100vh;
    background: var(--surface);
    border-left: 1px solid var(--border);
    box-shadow: -2px 0 10px rgba(0, 0, 0, 0.1);
    transition: right 0.3s ease;
    z-index: 1000;
    display: flex;
    flex-direction: column;
}

.drawer.open {
    right: 0;
}

.drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 999;
    display: none;
}

.drawer-overlay.open {
    display: block;
}

.drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem;
    border-bottom: 1px solid var(--border);
}

.drawer-header h3 {
    margin: 0;
    color: var(--text);
}

.drawer-close {
    background: transparent;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--muted);
    padding: 0.25rem;
    line-height: 1;
}

.drawer-close:hover {
    color: var(--text);
}

.drawer-content {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
}

.drawer-detail-row {
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
}

.drawer-detail-row:last-child {
    border-bottom: none;
}

.drawer-detail-label {
    font-weight: 600;
    color: var(--muted);
    font-size: 0.85rem;
    margin-bottom: 0.25rem;
}

.drawer-detail-value {
    color: var(--text);
    font-size: 1rem;
}

/* Responsive */
@@media (max-width: 768px) {
    .topbar-row {
        flex-direction: column;
        align-items: stretch;
    }

    .time-range-switcher,
    .type-filters,
    .legend {
        justify-content: center;
    }

    .drawer {
        width: 100%;
        right: -100%;
    }
}
</style>

<h2><loc key="MyOverview" /></h2>

<!-- Top Bar -->
<div class="overview-topbar">
    <div class="topbar-row">
        <!-- Time Range Switcher -->
        <div class="time-range-switcher">
            <span style="color: var(--muted); font-size: 0.9rem;"><loc key="TimeRangeSwitcher" />:</span>
            <div class="btn-group">
                <a href="?range=week&view=@Model.CurrentView.ToString().ToLower()" class="btn @(Model.CurrentTimeRange == ShiftManager.Pages.My.IndexModel.TimeRange.Week ? "active" : "")"><loc key="Week" /></a>
                <a href="?range=month&view=@Model.CurrentView.ToString().ToLower()" class="btn @(Model.CurrentTimeRange == ShiftManager.Pages.My.IndexModel.TimeRange.Month ? "active" : "")"><loc key="Month" /></a>
            </div>
        </div>

        <!-- Legend -->
        <div class="legend">
            <span style="font-weight: 600; color: var(--text);"><loc key="Legend" />:</span>
            <div class="legend-item">
                <span class="legend-dot vacation"></span>
                <span><loc key="Vacations" /></span>
            </div>
            <div class="legend-item">
                <span class="legend-dot onduty"></span>
                <span><loc key="OnDuty" /></span>
            </div>
            <div class="legend-item">
                <span class="legend-dot shift"></span>
                <span><loc key="Shifts" /></span>
            </div>
            <div class="legend-item">
                <span class="legend-dot chore"></span>
                <span><loc key="Chores" /></span>
            </div>
        </div>
    </div>

    <!-- Type Filters -->
    <div class="topbar-row">
        <span style="color: var(--muted); font-size: 0.9rem;"><loc key="Filters" />:</span>
        <div class="type-filters">
            <label>
                <input type="checkbox" data-filter="vacation" checked>
                <span><loc key="Vacations" /></span>
            </label>
            <label>
                <input type="checkbox" data-filter="onduty" checked>
                <span><loc key="OnDuty" /></span>
            </label>
            <label>
                <input type="checkbox" data-filter="shift" checked>
                <span><loc key="Shifts" /></span>
            </label>
            <label>
                <input type="checkbox" data-filter="chore" checked>
                <span><loc key="Chores" /></span>
            </label>
        </div>
    </div>
</div>

<!-- Timeline Feed -->
<div class="card">
    <!-- View Toggle -->
    <div class="view-toggle">
        <a href="?range=@Model.CurrentTimeRange.ToString().ToLower()&view=upcoming" class="btn @(Model.CurrentView == ShiftManager.Pages.My.IndexModel.ViewMode.Upcoming ? "active" : "")"><loc key="Upcoming" /></a>
        <a href="?range=@Model.CurrentTimeRange.ToString().ToLower()&view=all" class="btn @(Model.CurrentView == ShiftManager.Pages.My.IndexModel.ViewMode.All ? "active" : "")"><loc key="All" /></a>
        <a href="?range=@Model.CurrentTimeRange.ToString().ToLower()&view=past30days" class="btn @(Model.CurrentView == ShiftManager.Pages.My.IndexModel.ViewMode.Past30Days ? "active" : "")"><loc key="Past30Days" /></a>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="empty-state">
            <div class="empty-state-icon">📅</div>
            <div class="empty-state-title"><loc key="NothingHereYet" /></div>
            <div class="empty-state-text"><loc key="InDateRange" />: @Model.RangeStart.ToString("yyyy-MM-dd") - @Model.RangeEnd.ToString("yyyy-MM-dd")</div>
        </div>
    }
    else
    {
        var todayItems = Model.Items.Where(i => i.Date == today).ToList();
        var tomorrowItems = Model.Items.Where(i => i.Date == tomorrow).ToList();
        var thisWeekItems = Model.Items.Where(i => i.Date > tomorrow && i.Date <= weekEnd).ToList();
        var laterItems = Model.Items.Where(i => i.Date > weekEnd || i.Date < today).ToList();

        @if (todayItems.Any())
        {
            <div class="timeline-section">
                <h3><loc key="Today" /> — @today.ToString("yyyy-MM-dd")</h3>
                <div class="timeline">
                    @foreach (var item in todayItems)
                    {
                        @await Html.PartialAsync("_TimelineItem", item)
                    }
                </div>
            </div>
        }

        @if (tomorrowItems.Any())
        {
            <div class="timeline-section">
                <h3><loc key="Tomorrow" /> — @tomorrow.ToString("yyyy-MM-dd")</h3>
                <div class="timeline">
                    @foreach (var item in tomorrowItems)
                    {
                        @await Html.PartialAsync("_TimelineItem", item)
                    }
                </div>
            </div>
        }

        @if (thisWeekItems.Any())
        {
            <div class="timeline-section">
                <h3><loc key="ThisWeek" /></h3>
                <div class="timeline">
                    @foreach (var item in thisWeekItems)
                    {
                        @await Html.PartialAsync("_TimelineItem", item)
                    }
                </div>
            </div>
        }

        @if (laterItems.Any())
        {
            <div class="timeline-section">
                <h3>@(Model.CurrentView == ShiftManager.Pages.My.IndexModel.ViewMode.Past30Days ? Localizer["Past"] : Localizer["Later"])</h3>
                <div class="timeline">
                    @foreach (var item in laterItems)
                    {
                        @await Html.PartialAsync("_TimelineItem", item)
                    }
                </div>
            </div>
        }

        <!-- Empty state for filtered -->
        <div id="filteredEmptyState" class="empty-state" style="display: none;">
            <div class="empty-state-icon">🔍</div>
            <div class="empty-state-title"><loc key="NoItemsMatch" /></div>
            <div class="empty-state-text"><loc key="ClearFilters" /></div>
        </div>
    }
</div>

<!-- Stats Section -->
<div class="card">
    <div class="stats-header">
        <h3><loc key="MyStatsForThisPeriod" /></h3>
        <button id="statsToggle" class="btn stats-toggle"><loc key="ToggleCountHours" /></button>
    </div>
    <div class="stats-chart">
        <canvas id="statsChart"></canvas>
    </div>
</div>

<!-- Detail Drawer -->
<div class="drawer-overlay" id="drawerOverlay" onclick="closeDrawer()"></div>
<div class="drawer" id="detailDrawer">
    <div class="drawer-header">
        <h3 id="drawerTitle"><loc key="Details" /></h3>
        <button class="drawer-close" onclick="closeDrawer()" loc-aria-label="Aria_CloseDialog">×</button>
    </div>
    <div class="drawer-content" id="drawerContent">
        <!-- Content will be injected by JavaScript -->
    </div>
</div>

@section Scripts {
<script>
// Stats data
const statsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Stats, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
const localizer = {
    vacations: '@Localizer["Vacations"]',
    onDuty: '@Localizer["OnDuty"]',
    shifts: '@Localizer["Shifts"]',
    chores: '@Localizer["Chores"]',
    count: '@Localizer["Count"]',
    hours: '@Localizer["Hours"]',
    details: '@Localizer["Details"]',
    date: '@Localizer["Date"]',
    title: '@Localizer["Title"]',
    time: '@Localizer["Time"]',
    metadata: '@Localizer["Metadata"]',
    conflict: '@Localizer["Conflict"]',
    day: '@Localizer["Day"]',
    days: '@Localizer["Days"]'
};

// Filter functionality
document.querySelectorAll('.type-filters input[type="checkbox"]').forEach(checkbox => {
    checkbox.addEventListener('change', applyFilters);
});

function applyFilters() {
    const filters = {
        vacation: document.querySelector('[data-filter="vacation"]').checked,
        onduty: document.querySelector('[data-filter="onduty"]').checked,
        shift: document.querySelector('[data-filter="shift"]').checked,
        chore: document.querySelector('[data-filter="chore"]').checked
    };

    const items = document.querySelectorAll('.timeline-item');
    let visibleCount = 0;

    items.forEach(item => {
        const type = item.dataset.type;
        if (filters[type]) {
            item.classList.remove('filtered');
            visibleCount++;
        } else {
            item.classList.add('filtered');
        }
    });

    // Show/hide empty state
    const emptyState = document.getElementById('filteredEmptyState');
    if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
    }

    // Hide section headers if all items filtered
    document.querySelectorAll('.timeline-section').forEach(section => {
        const sectionItems = section.querySelectorAll('.timeline-item:not(.filtered)');
        section.style.display = sectionItems.length === 0 ? 'none' : 'block';
    });
}

// Drawer functionality
function openDrawer(itemData) {
    const drawer = document.getElementById('detailDrawer');
    const overlay = document.getElementById('drawerOverlay');
    const title = document.getElementById('drawerTitle');
    const content = document.getElementById('drawerContent');

    title.textContent = itemData.title;

    let html = '';
    html += `<div class="drawer-detail-row"><div class="drawer-detail-label">${localizer.date}</div><div class="drawer-detail-value">${itemData.date}${itemData.endDate ? ' - ' + itemData.endDate : ''}</div></div>`;
    if (itemData.timeRange) {
        html += `<div class="drawer-detail-row"><div class="drawer-detail-label">${localizer.time}</div><div class="drawer-detail-value">${itemData.timeRange}</div></div>`;
    }
    if (itemData.metadata) {
        html += `<div class="drawer-detail-row"><div class="drawer-detail-label">${localizer.metadata}</div><div class="drawer-detail-value">${itemData.metadata}</div></div>`;
    }
    if (itemData.conflict) {
        html += `<div class="drawer-detail-row"><div class="drawer-detail-label">${localizer.conflict}</div><div class="drawer-detail-value" style="color: var(--warning);">⚠ ${localizer.conflict}</div></div>`;
    }

    content.innerHTML = html;
    drawer.classList.add('open');
    overlay.classList.add('open');
}

function closeDrawer() {
    const drawer = document.getElementById('detailDrawer');
    const overlay = document.getElementById('drawerOverlay');
    drawer.classList.remove('open');
    overlay.classList.remove('open');
}

// Stats chart
let currentStatsMode = 'count';
const canvas = document.getElementById('statsChart');
const ctx = canvas.getContext('2d');

function drawStatsChart(mode) {
    const data = mode === 'count' ? [
        { label: localizer.vacations, value: statsData.vacationCount, color: getComputedStyle(document.documentElement).getPropertyValue('--info').trim() || '#58a6ff' },
        { label: localizer.onDuty, value: statsData.onDutyCount, color: getComputedStyle(document.documentElement).getPropertyValue('--danger').trim() || '#ff6b6b' },
        { label: localizer.shifts, value: statsData.shiftCount, color: getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#9b59b6' },
        { label: localizer.chores, value: statsData.choreCount, color: getComputedStyle(document.documentElement).getPropertyValue('--warning').trim() || '#ffd54f' }
    ] : [
        { label: localizer.vacations, value: statsData.vacationHours, color: getComputedStyle(document.documentElement).getPropertyValue('--info').trim() || '#58a6ff' },
        { label: localizer.onDuty, value: statsData.onDutyHours, color: getComputedStyle(document.documentElement).getPropertyValue('--danger').trim() || '#ff6b6b' },
        { label: localizer.shifts, value: statsData.shiftHours, color: getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#9b59b6' },
        { label: localizer.chores, value: statsData.choreHours, color: getComputedStyle(document.documentElement).getPropertyValue('--warning').trim() || '#ffd54f' }
    ];

    // Get CSS colors
    const textColor = getComputedStyle(document.documentElement).getPropertyValue('--text').trim() || '#000';
    const mutedColor = getComputedStyle(document.documentElement).getPropertyValue('--muted').trim() || '#666';
    const borderColor = getComputedStyle(document.documentElement).getPropertyValue('--border').trim() || '#ddd';

    // Set canvas size
    const container = canvas.parentElement;
    const dpr = window.devicePixelRatio || 1;
    const rect = container.getBoundingClientRect();
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    ctx.scale(dpr, dpr);

    const w = rect.width;
    const h = rect.height;
    const padding = { top: 20, right: 20, bottom: 60, left: 60 };
    const chartWidth = w - padding.left - padding.right;
    const chartHeight = h - padding.top - padding.bottom;

    // Clear canvas
    ctx.clearRect(0, 0, w, h);

    // Calculate max value
    const maxValue = Math.max(...data.map(d => d.value), 1);
    const yAxisMax = Math.ceil(maxValue * 1.1);

    // Draw y-axis gridlines
    ctx.strokeStyle = borderColor;
    ctx.lineWidth = 1;
    ctx.font = '12px system-ui, -apple-system, sans-serif';
    ctx.fillStyle = mutedColor;

    const ySteps = 5;
    for (let i = 0; i <= ySteps; i++) {
        const value = (yAxisMax / ySteps) * i;
        const y = padding.top + chartHeight - (value / yAxisMax) * chartHeight;

        ctx.globalAlpha = 0.2;
        ctx.beginPath();
        ctx.moveTo(padding.left, y);
        ctx.lineTo(padding.left + chartWidth, y);
        ctx.stroke();

        ctx.globalAlpha = 1;
        ctx.textAlign = 'right';
        ctx.textBaseline = 'middle';
        ctx.fillText(Math.round(value).toString(), padding.left - 10, y);
    }

    // Draw bars
    const barWidth = (chartWidth / data.length) * 0.6;
    const barGap = (chartWidth / data.length) * 0.4;

    data.forEach((item, i) => {
        const x = padding.left + (i * chartWidth / data.length) + barGap / 2;
        const barHeight = (item.value / yAxisMax) * chartHeight;
        const y = padding.top + chartHeight - barHeight;

        // Draw bar
        ctx.fillStyle = item.color;
        ctx.fillRect(x, y, barWidth, barHeight);

        // Draw value on top
        ctx.fillStyle = textColor;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'bottom';
        ctx.font = 'bold 14px system-ui, -apple-system, sans-serif';
        ctx.fillText(item.value.toFixed(mode === 'hours' ? 1 : 0), x + barWidth / 2, y - 5);

        // Draw label
        ctx.font = '12px system-ui, -apple-system, sans-serif';
        ctx.fillStyle = mutedColor;
        ctx.textBaseline = 'top';
        ctx.fillText(item.label, x + barWidth / 2, padding.top + chartHeight + 10);
    });

    // Draw axes
    ctx.strokeStyle = borderColor;
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(padding.left, padding.top + chartHeight);
    ctx.lineTo(padding.left + chartWidth, padding.top + chartHeight);
    ctx.stroke();

    ctx.beginPath();
    ctx.moveTo(padding.left, padding.top);
    ctx.lineTo(padding.left, padding.top + chartHeight);
    ctx.stroke();

    // Y-axis label
    ctx.save();
    ctx.translate(15, padding.top + chartHeight / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    ctx.fillStyle = textColor;
    ctx.font = 'bold 12px system-ui, -apple-system, sans-serif';
    ctx.fillText(mode === 'count' ? localizer.count : localizer.hours, 0, 0);
    ctx.restore();
}

// Toggle stats mode
document.getElementById('statsToggle').addEventListener('click', () => {
    currentStatsMode = currentStatsMode === 'count' ? 'hours' : 'count';
    drawStatsChart(currentStatsMode);
});

// Initial chart draw
drawStatsChart(currentStatsMode);

// Redraw on resize
let resizeTimer;
window.addEventListener('resize', () => {
