@model ShiftManager.Pages.My.IndexModel.TimelineItem
@inject ShiftManager.Services.ILocalizationService Localization
@{
    var typeClass = Model.Type.ToString().ToLower();
    var iconName = Model.Type switch
    {
        ShiftManager.Pages.My.IndexModel.ItemType.Vacation => "palm-tree",
        ShiftManager.Pages.My.IndexModel.ItemType.OnDuty => "siren",
        ShiftManager.Pages.My.IndexModel.ItemType.Shift => "moon",
        ShiftManager.Pages.My.IndexModel.ItemType.Chore => "brush",
        _ => "clipboard-list"
    };
}

<div class="timeline-item" data-type="@typeClass"
     onclick='openDrawer({
         title: "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.Title))",
         date: "@Model.Date.ToString("yyyy-MM-dd")",
         endDate: "@(Model.EndDate?.ToString("yyyy-MM-dd") ?? "")",
         timeRange: "@(Model.TimeRange ?? "")",
         metadata: "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.Metadata ?? ""))",
         conflict: @(Model.HasConflict ? "true" : "false")
     })'>
    <div class="item-colorbar @typeClass"></div>
    <div class="item-icon"><icon name="@iconName" /></div>
    <div class="item-content">
        <div class="item-title">@Model.Title</div>
        @if (!string.IsNullOrEmpty(Model.TimeRange))
        {
            <div class="item-time">@Model.TimeRange</div>
        }
        @if (!string.IsNullOrEmpty(Model.Metadata))
        {
            <div class="item-meta">@Model.Metadata</div>
        }
    </div>
    <div class="item-date">@Localization.FormatShortDate(Model.Date)</div>
    @if (Model.HasConflict)
    {
        <span class="conflict-badge"><icon name="alert-triangle" /> <loc key="Conflict" /></span>
    }
</div>
