@page
@model ShiftManager.Pages.My.NotificationCenterModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@inject ShiftManager.Services.ILocalizationService Localization
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["NotificationCenter"];
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["NotificationCenter"], IsActive = true }
})

<div style="max-width: 1200px; margin: 0 auto;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem;">
        <h2 style="color: var(--text); margin: 0;"><loc key="NotificationCenter" /></h2>

        @if (Model.Notifications.Any(n => !n.IsRead))
        {
            <form method="post" asp-page-handler="MarkAllAsRead" style="display: inline;">
                @Html.AntiForgeryToken()
                <button type="submit" style="background: var(--primary); color: var(--primary-contrast); border: none; padding: 0.5rem 1rem; border-radius: 0.5rem; font-size: 0.9rem; cursor: pointer;">
                    @Localizer["MarkAllAsRead", Model.UnreadCount]
                </button>
            </form>
        }
    </div>

    @* Inline alerts removed - feedback now flows through the unified _Layout.cshtml bridge *@

    @* ===== Email preferences (notifications overhaul Phase 2) ===== *@
    <div style="border: 1px solid var(--border); border-radius: 0.5rem; padding: 1rem 1.25rem; margin-bottom: 1.5rem; background: var(--surface);">
        <h3 style="margin: 0 0 0.25rem; color: var(--text);">@Localizer["NotifPrefs_Title"]</h3>
        <p style="margin: 0 0 1rem; color: var(--text); opacity: 0.7; font-size: 0.9rem;">@Localizer["NotifPrefs_EngagementLabel"]</p>

        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            @foreach (var opt in new[]
            {
                (Mode: ShiftManager.Models.Support.EngagementMode.Engaged, Label: Localizer["NotifPrefs_Engaged"].Value, Desc: Localizer["NotifPrefs_EngagedDesc"].Value),
                (Mode: ShiftManager.Models.Support.EngagementMode.Quiet, Label: Localizer["NotifPrefs_Quiet"].Value, Desc: Localizer["NotifPrefs_QuietDesc"].Value)
            })
            {
                var isCurrent = Model.EngagementMode == opt.Mode;
                <form method="post" asp-page-handler="SetEngagement" style="flex: 1; min-width: 230px; margin: 0;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="mode" value="@((int)opt.Mode)" />
                    <button type="submit" style="width: 100%; text-align: start; cursor: pointer; border-radius: 0.5rem; padding: 0.75rem; color: var(--text); border: 2px solid @(isCurrent ? "var(--primary)" : "var(--border)"); background: @(isCurrent ? "var(--primary-soft)" : "var(--surface)");">
                        <strong>@opt.Label @(isCurrent ? "✓" : "")</strong>
                        <div style="font-size: 0.8rem; opacity: 0.75; margin-top: 0.25rem;">@opt.Desc</div>
                    </button>
                </form>
            }
        </div>

        <h4 style="margin: 1.25rem 0 0.25rem; color: var(--text);">@Localizer["NotifPrefs_MuteTitle"]</h4>
        <p style="margin: 0 0 0.75rem; color: var(--text); opacity: 0.7; font-size: 0.85rem;">@Localizer["NotifPrefs_MuteDesc"]</p>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.35rem;">
            @foreach (var cat in Model.Categories)
            {
                <form method="post" asp-page-handler="ToggleMute" style="margin: 0;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="category" value="@cat.Category" />
                    <input type="hidden" name="muted" value="@((!cat.Muted).ToString().ToLowerInvariant())" />
                    <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; padding: 0.35rem 0.5rem; border-radius: 0.4rem;">
                        <input type="checkbox" @(cat.Muted ? "" : "checked") onchange="this.form.submit()" />
                        <span style="color: var(--text);">@cat.Label</span>
                    </label>
                </form>
            }
        </div>
    </div>

    @if (Model.Notifications.Any())
    {
        <div class="notification-list">
            @foreach (var notification in Model.Notifications)
            {
                <div class="notification-item @notification.CssClass @(notification.IsRead ? "read" : "unread")"
                     style="border: 1px solid var(--border); border-radius: 0.5rem; margin-bottom: 1rem; padding: 1rem; background: var(--surface); position: relative;">

                    <!-- Unread indicator -->
                    @if (!notification.IsRead)
                    {
                        <div class="unread-indicator" style="position: absolute; top: 1rem; right: 1rem; width: 8px; height: 8px; background: var(--primary); border-radius: 50%;"></div>
                    }

                    <div style="display: flex; align-items: flex-start; gap: 1rem;">
                        <!-- Icon -->
                        @* notification.Icon: Lucide name ("calendar") or legacy emoji. Ascii-name → <icon>, else raw. *@
                        <div class="notification-icon" style="flex-shrink: 0; margin-top: 0.25rem;">
                            @if (!string.IsNullOrEmpty(notification.Icon) && System.Text.RegularExpressions.Regex.IsMatch(notification.Icon, "^[a-z][a-z0-9-]*$"))
                            {
                                <icon name="@notification.Icon" size="lg" />
                            }
                            else
                            {
                                <span style="font-size: 1.5rem;">@notification.Icon</span>
                            }
                        </div>

                        <!-- Content -->
                        <div style="flex: 1; min-width: 0;">
                            <h4 style="margin: 0 0 0.5rem 0; color: var(--text); font-size: 1rem;">
                                @notification.Title
                            </h4>
                            <p style="margin: 0 0 0.75rem 0; color: var(--text); line-height: 1.4;">
                                @notification.Message
                            </p>
                            <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 0.75rem;">
                                <small style="color: var(--muted);">
                                    @Localization.FormatMediumDate(notification.CreatedAt) @Localization.FormatTime(notification.CreatedAt)
                                </small>
                                @if (notification.IsRead && notification.ReadAt.HasValue)
                                {
                                    <small style="color: var(--muted);">
                                        @Localizer["Read"] @Localization.FormatShortDate(notification.ReadAt.Value) @Localization.FormatTime(notification.ReadAt.Value)
                                    </small>
                                }
                            </div>

                            <!-- Actions -->
                            <div style="display: flex; gap: 0.5rem;">
                                @if (!string.IsNullOrEmpty(notification.DeepLink))
                                {
                                    <a href="@notification.DeepLink" style="background: var(--info); color: var(--info-text); border: none; padding: 0.25rem 0.75rem; border-radius: 0.25rem; font-size: 0.8rem; cursor: pointer; text-decoration: none; display: inline-block;">
                                        @Localizer["View"]
                                    </a>
                                }
                                @if (!notification.IsRead)
                                {
                                    <form method="post" asp-page-handler="MarkAsRead" style="display: inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@notification.Id" />
                                        <button type="submit" style="background: var(--primary); color: var(--primary-contrast); border: none; padding: 0.25rem 0.75rem; border-radius: 0.25rem; font-size: 0.8rem; cursor: pointer;">
                                            @Localizer["MarkAsRead"]
                                        </button>
                                    </form>
                                }

                                <form method="post" asp-page-handler="Delete" style="display: inline;"
                                      data-confirm-modal
                                      data-confirm-title="@Localizer["DeleteConfirm_Title"]"
                                      data-confirm-message="@Localizer["DeleteConfirm"]"
                                      data-confirm-action="@Localizer["Delete"]"
                                      data-confirm-level="danger">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@notification.Id" />
                                    <button type="submit" style="background: var(--danger); color: var(--danger-text); border: none; padding: 0.25rem 0.75rem; border-radius: 0.25rem; font-size: 0.8rem; cursor: pointer;">
                                        @Localizer["Delete"]
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state" style="text-align: center; padding: 4rem 2rem; color: var(--muted);">
            <div style="color: var(--text-muted); margin-bottom: 1rem;"><icon name="inbox" size="2xl" /></div>
            <h3 style="margin: 0 0 0.5rem 0; color: var(--text);"><loc key="NoNotifications" /></h3>
            <p style="margin: 0;"><loc key="AllCaughtUp" /></p>
        </div>
    }
</div>

<style>
    .notification-item.unread {
        border-left: 4px solid var(--primary);
        background: var(--surface);
    }

    .notification-item.read {
        opacity: 0.8;
    }

    .notification-approved {
        border-left-color: var(--success) !important;
    }

    .notification-declined {
        border-left-color: var(--danger) !important;
    }

    .notification-shift-added {
        border-left-color: var(--info) !important;
    }

    .notification-shift-removed {
        border-left-color: var(--warning) !important;
    }

    .notification-item button:hover {
        opacity: 0.9;
        transform: translateY(-1px);
        transition: all 0.2s ease;
    }

    .notification-icon {
        filter: grayscale(0.3);
    }

    .notification-item.unread .notification-icon {
        filter: none;
    }
</style>