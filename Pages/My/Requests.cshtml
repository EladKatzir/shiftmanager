@page
@model ShiftManager.Pages.My.RequestsModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["MyRequests"], IsActive = true }
})

<div style="max-width: 1000px; margin: 0 auto;">
    <h2 style="color: var(--text); margin-bottom: 2rem;">@Localizer["MyRequests"]</h2>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-success" style="margin-bottom: 2rem; padding: 1rem; background: var(--success); color: white; border-radius: 0.5rem;">
            @Model.Message
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger" style="margin-bottom: 2rem; padding: 1rem; background: var(--danger); color: white; border-radius: 0.5rem;">
            @Model.Error
        </div>
    }

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2rem;">
        <!-- Time Off Request Form -->
        <div class="card" style="padding: 2rem;">
            <h3 style="color: var(--primary); margin-top: 0; margin-bottom: 1.5rem;">@Localizer["RequestTimeOff"]</h3>
            <form method="post" asp-page-handler="TimeOff">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" style="color: var(--danger); margin-bottom: 1rem; font-size: 0.9rem;"></div>
                <div style="margin-bottom: 1rem;">
                    <label asp-for="TimeOffRequest.Type" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text);">@Localizer["VacationType"]</label>
                    <select asp-for="TimeOffRequest.Type" id="vacationType" style="width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: 0.5rem; background: var(--surface);">
                        <option value="0">@Localizer["RegularVacation"]</option>
                        <option value="1">@Localizer["AfterDutyVacation"]</option>
                    </select>
                    <span asp-validation-for="TimeOffRequest.Type" style="color: var(--danger); font-size: 0.8rem;"></span>
                    <p style="color: var(--muted); font-size: 0.85rem; margin-top: 0.25rem;">@Localizer["VacationTypeDescription"]</p>
                </div>
                <div style="margin-bottom: 1rem;">
                    <label asp-for="TimeOffRequest.StartDate" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text);">@Localizer["StartDate"]</label>
                    <input asp-for="TimeOffRequest.StartDate" id="startDate" type="date" style="width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: 0.5rem; background: var(--surface);" />
                    <span asp-validation-for="TimeOffRequest.StartDate" style="color: var(--danger); font-size: 0.8rem;"></span>
                </div>
                <div id="endDateContainer" style="margin-bottom: 1rem;">
                    <label asp-for="TimeOffRequest.EndDate" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text);">@Localizer["EndDate"]</label>
                    <input asp-for="TimeOffRequest.EndDate" id="endDate" type="date" style="width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: 0.5rem; background: var(--surface);" />
                    <span asp-validation-for="TimeOffRequest.EndDate" style="color: var(--danger); font-size: 0.8rem;"></span>
                </div>
                <div style="margin-bottom: 1rem;">
                    <label asp-for="TimeOffRequest.ApproverId" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text);">@Localizer["SpecificApprover"] (@Localizer["Optional"])</label>
                    <select asp-for="TimeOffRequest.ApproverId" style="width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: 0.5rem; background: var(--surface);">
                        <option value="">@Localizer["AnyManager"]</option>
                        @foreach (var approver in Model.AvailableApprovers)
                        {
                            <option value="@approver.Id">@approver.Name (@Localizer[approver.Role])</option>
                        }
                    </select>
                    <span asp-validation-for="TimeOffRequest.ApproverId" style="color: var(--danger); font-size: 0.8rem;"></span>
                    <p style="color: var(--muted); font-size: 0.85rem; margin-top: 0.25rem;">@Localizer["ApproverDescription"]</p>
                </div>
                <div style="margin-bottom: 1.5rem;">
                    <label asp-for="TimeOffRequest.Reason" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text);">@Localizer["Reason"]</label>
                    <textarea asp-for="TimeOffRequest.Reason" rows="3" style="width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: 0.5rem; background: var(--surface); resize: vertical;" placeholder="@Localizer["TimeOffReasonPlaceholder"]"></textarea>
                    <span asp-validation-for="TimeOffRequest.Reason" style="color: var(--danger); font-size: 0.8rem;"></span>
                </div>
                <button type="submit" style="background: var(--primary); color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 0.5rem; font-weight: 600; cursor: pointer; width: 100%;">@Localizer["SubmitTimeOffRequest"]</button>
            </form>
        </div>

        <!-- Shift Swap Request Form -->
        <div class="card" style="padding: 2rem;">
            <h3 style="color: var(--primary); margin-top: 0; margin-bottom: 1.5rem;">@Localizer["RequestShiftSwap"]</h3>
            @if (Model.AvailableShifts.Any())
            {
                <form method="post" asp-page-handler="Swap">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" style="color: var(--danger); margin-bottom: 1rem; font-size: 0.9rem;"></div>
                    <div style="margin-bottom: 1.5rem;">
                        <label asp-for="SwapRequest.ShiftId" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text);">@Localizer["SelectYourShiftToSwap"]</label>
                        <select asp-for="SwapRequest.ShiftId" style="width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: 0.5rem; background: var(--surface);">
                            <option value="0">@Localizer["ChooseAShift"]</option>
                            @foreach (var shift in Model.AvailableShifts)
                            {
                                <option value="@shift.ShiftId">@shift.Date.ToString("yyyy-MM-dd") - @shift.ShiftTypeName (@shift.StartTime.ToString("HH:mm") - @shift.EndTime.ToString("HH:mm"))</option>
                            }
                        </select>
                        <span asp-validation-for="SwapRequest.ShiftId" style="color: var(--danger); font-size: 0.8rem;"></span>
                    </div>
                    <div style="margin-bottom: 1.5rem;">
                        <p style="color: var(--muted); font-size: 0.9rem; margin: 0;">@Localizer["SwapRequestDescription"]</p>
                    </div>
                    <button type="submit" style="background: var(--primary); color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 0.5rem; font-weight: 600; cursor: pointer; width: 100%;">@Localizer["RequestShiftSwap"]</button>
                </form>
            }
            else
            {
                <p style="color: var(--muted); text-align: center; margin: 2rem 0;">@Localizer["NoUpcomingShiftsForSwapping"]</p>
            }
        </div>
    </div>

    <!-- My Requests Status -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
        <!-- Time Off Requests -->
        <div class="card" style="padding: 2rem;">
            <h3 style="color: var(--text); margin-top: 0; margin-bottom: 1.5rem;">@Localizer["MyTimeOffRequests"]</h3>
            @if (Model.MyTimeOffRequests.Any())
            {
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="border-bottom: 1px solid var(--border);">
                                <th style="text-align: left; padding: 0.75rem 0; color: var(--text); font-weight: 600;">@Localizer["Dates"]</th>
                                <th style="text-align: left; padding: 0.75rem 0; color: var(--text); font-weight: 600;">@Localizer["Status"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in Model.MyTimeOffRequests)
                            {
                                <tr style="border-bottom: 1px solid var(--border);">
                                    <td style="padding: 0.75rem 0; color: var(--text);">
                                        @request.StartDate.ToString("MMM dd") - @request.EndDate.ToString("MMM dd, yyyy")
                                        <br><small style="color: var(--muted);">@request.Reason</small>
                                    </td>
                                    <td style="padding: 0.75rem 0;">
                                        <span style="padding: 0.25rem 0.5rem; border-radius: 0.25rem; font-size: 0.8rem; font-weight: 600;
                                            background: @(request.Status == "Pending" ? "var(--focus)" : request.Status == "Approved" ? "var(--success)" : "var(--danger)");
                                            color: white;">@request.Status</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p style="color: var(--muted); text-align: center; margin: 2rem 0;">@Localizer["NoTimeOffRequestsYet"]</p>
            }
        </div>

        <!-- Swap Requests -->
        <div class="card" style="padding: 2rem;">
            <h3 style="color: var(--text); margin-top: 0; margin-bottom: 1.5rem;">@Localizer["MySwapRequests"]</h3>
            @if (Model.MySwapRequests.Any())
            {
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="border-bottom: 1px solid var(--border);">
                                <th style="text-align: left; padding: 0.75rem 0; color: var(--text); font-weight: 600;">@Localizer["Shift"]</th>
                                <th style="text-align: left; padding: 0.75rem 0; color: var(--text); font-weight: 600;">@Localizer["Status"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in Model.MySwapRequests)
                            {
                                <tr style="border-bottom: 1px solid var(--border);">
                                    <td style="padding: 0.75rem 0; color: var(--text);">
                                        @request.ShiftDate.ToString("MMM dd, yyyy")
                                        <br><small style="color: var(--muted);">@request.ShiftTypeName</small>
                                    </td>
                                    <td style="padding: 0.75rem 0;">
                                        <span style="padding: 0.25rem 0.5rem; border-radius: 0.25rem; font-size: 0.8rem; font-weight: 600;
                                            background: @(request.Status == "Pending" ? "var(--focus)" : request.Status == "Approved" ? "var(--success)" : "var(--danger)");
                                            color: white;">@request.Status</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p style="color: var(--muted); text-align: center; margin: 2rem 0;">@Localizer["NoSwapRequestsYet"]</p>
            }
        </div>
    </div>
</div>

<script>
    // Handle vacation type change to show/hide end date
    document.addEventListener('DOMContentLoaded', function() {
        const vacationType = document.getElementById('vacationType');
        const endDateContainer = document.getElementById('endDateContainer');
        const startDate = document.getElementById('startDate');
        const endDate = document.getElementById('endDate');

        function updateEndDateVisibility() {
            if (vacationType.value === '1') { // After-duty vacation
                endDateContainer.style.display = 'none';
                // Set end date to same as start date for After type
                if (startDate.value) {
                    endDate.value = startDate.value;
                }
            } else { // Regular vacation
                endDateContainer.style.display = 'block';
            }
        }

        // Update visibility on page load
        updateEndDateVisibility();

        // Update visibility when type changes
        vacationType.addEventListener('change', updateEndDateVisibility);

        // Keep end date synced with start date for After type
        startDate.addEventListener('change', function() {
            if (vacationType.value === '1') { // After-duty vacation
                endDate.value = startDate.value;
            }
        });
    });
</script>

