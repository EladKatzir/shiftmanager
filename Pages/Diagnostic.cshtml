@page
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@model ShiftManager.Pages.DiagnosticModel
@{
    ViewData["Title"] = Localizer["SystemDiagnostics"];
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["SystemDiagnostics"], IsActive = true }
})

<div style="max-width: 1200px; margin: 0 auto;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem;">
        <h1 style="margin: 0; color: var(--text);">🔧 @Localizer["SystemDiagnostics"]</h1>
    </div>

    <div style="background: var(--warning); color: #000; padding: 1rem; border-radius: 8px; margin-bottom: 2rem; border-left: 4px solid #d97706;">
        <strong>⚠️ Admin Only:</strong> @Localizer["MultiTenantDebugInfo"]
    </div>

    <!-- Filter Section -->
    <div class="card" style="margin-bottom: 1.5rem;">
        <h2 style="margin-top: 0; color: var(--primary); display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.5rem;">
            <span>🔍</span>
            <span>@Localizer["Filter"]</span>
        </h2>
        <form method="get" style="display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 1rem; align-items: end;">
            <div>
                <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text);">
                    @Localizer["SelectUser"]
                </label>
                <select name="SelectedUserId" style="width: 100%; padding: 0.5rem; border: 1px solid var(--border); border-radius: 4px; background: var(--surface); color: var(--text);">
                    <option value="">@Localizer["SelectUserPlaceholder"]</option>
                    @foreach (var user in Model.AllUsers)
                    {
                        <option value="@user.Id" selected="@(Model.SelectedUserId == user.Id)">
                            @user.Email (@user.DisplayName)
                        </option>
                    }
                </select>
            </div>

            <div>
                <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text);">
                    @Localizer["StartDate"]
                </label>
                <input type="date" name="StartDate" value="@Model.StartDate" style="width: 100%; padding: 0.5rem; border: 1px solid var(--border); border-radius: 4px; background: var(--surface); color: var(--text);" />
            </div>

            <div>
                <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text);">
                    @Localizer["EndDate"]
                </label>
                <input type="date" name="EndDate" value="@Model.EndDate" style="width: 100%; padding: 0.5rem; border: 1px solid var(--border); border-radius: 4px; background: var(--surface); color: var(--text);" />
            </div>

            <div>
                <button type="submit" class="btn btn-primary" style="font-weight: 600; font-size: 1rem; padding: 0.65rem 2rem; box-shadow: 0 2px 8px rgba(0, 123, 255, 0.3);">
                    🔎 @Localizer["Apply"]
                </button>
            </div>
        </form>
    </div>

    <!-- Companies Section -->
    <div class="card" style="margin-bottom: 1.5rem;">
        <h2 style="margin-top: 0; color: var(--primary); display: flex; align-items: center; gap: 0.5rem;">
            <span>🏢</span>
            <span>@Localizer["CompaniesInSystem"]</span>
        </h2>
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse;">
                <thead style="background: var(--primary); color: var(--primary-text);">
                    <tr>
                        <th style="padding: 0.75rem; text-align: left;">ID</th>
                        <th style="padding: 0.75rem; text-align: left;">@Localizer["Name"]</th>
                        <th style="padding: 0.75rem; text-align: left;">@Localizer["Slug"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Companies)
                    {
                        <tr class="diagnostic-row">
                            <td style="padding: 0.75rem; color: var(--text);">@c.Id</td>
                            <td style="padding: 0.75rem; font-weight: 600; color: var(--text);">@c.Name</td>
                            <td style="padding: 0.75rem; font-family: monospace; color: var(--muted);">@c.Slug</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- User Information Section -->
    <div class="card" style="margin-bottom: 1.5rem;">
        <h2 style="margin-top: 0; color: var(--primary); display: flex; align-items: center; gap: 0.5rem;">
            <span>👤</span>
            <span>@Localizer["UserInformation"]</span>
        </h2>
        @if (Model.UserInfo != null)
        {
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
                <div>
                    <div style="font-size: 0.875rem; color: var(--muted); margin-bottom: 0.25rem;">@Localizer["Email"]</div>
                    <div style="font-weight: 600; color: var(--text);">@Model.UserInfo.Email</div>
                </div>
                <div>
                    <div style="font-size: 0.875rem; color: var(--muted); margin-bottom: 0.25rem;">@Localizer["CompanyId"]</div>
                    <div style="font-weight: 600; color: var(--text);">@Model.UserInfo.CompanyId</div>
                </div>
                <div>
                    <div style="font-size: 0.875rem; color: var(--muted); margin-bottom: 0.25rem;">@Localizer["Role"]</div>
                    <div style="font-weight: 600; color: var(--text);">@Model.UserInfo.Role</div>
                </div>
            </div>
        }
        else
        {
            <p style="color: var(--muted); text-align: center; padding: 1rem;">
                @Localizer["SelectUserToViewAssignments"]
            </p>
        }
    </div>

    <!-- Shift Instances Section -->
    <div class="card" style="margin-bottom: 1.5rem;">
        <h2 style="margin-top: 0; color: var(--primary); display: flex; align-items: center; gap: 0.5rem;">
            <span>📅</span>
            <span>@Localizer["ShiftInstancesForOctober2025"]</span>
            <span style="font-size: 0.875rem; font-weight: normal; color: var(--muted);">
                (@Model.ShiftInstances.Count items)
            </span>
        </h2>
        <div style="overflow-x: auto;">
            @if (Model.ShiftInstances.Any())
            {
                <table style="width: 100%; border-collapse: collapse;">
                    <thead style="background: var(--primary); color: var(--primary-text);">
                        <tr>
                            <th style="padding: 0.75rem; text-align: left;">@Localizer["InstanceId"]</th>
                            <th style="padding: 0.75rem; text-align: left;">@Localizer["CompanyId"]</th>
                            <th style="padding: 0.75rem; text-align: left;">@Localizer["WorkDate"]</th>
                            <th style="padding: 0.75rem; text-align: left;">@Localizer["ShiftKey"]</th>
                            <th style="padding: 0.75rem; text-align: left;">@Localizer["Staffing"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var si in Model.ShiftInstances)
                        {
                            <tr class="diagnostic-row">
                                <td style="padding: 0.75rem; color: var(--text);">@si.Id</td>
                                <td style="padding: 0.75rem; color: var(--text);">@si.CompanyId</td>
                                <td style="padding: 0.75rem; color: var(--text);">@si.WorkDate</td>
                                <td style="padding: 0.75rem;">
                                    <span style="font-family: monospace; background: var(--bg); color: var(--text); display: inline-block; padding: 0.25rem 0.5rem; border-radius: 4px; border: 1px solid var(--border);">@si.ShiftKey</span>
                                </td>
                                <td style="padding: 0.75rem; font-weight: 600; color: var(--text);">@si.Staffing</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p style="color: var(--muted); text-align: center; padding: 1rem;">
                    No shift instances found for the selected date range.
                </p>
            }
        </div>
    </div>

    <!-- Assignments Section -->
    <div class="card" style="margin-bottom: 1.5rem;">
        <h2 style="margin-top: 0; color: var(--primary); display: flex; align-items: center; gap: 0.5rem;">
            <span>✅</span>
            <span>@Localizer["UserAssignments"]</span>
            @if (Model.UserInfo != null)
            {
                <span style="font-size: 0.875rem; font-weight: normal; color: var(--muted);">
                    (@Model.UserInfo.Email - @Model.Assignments.Count)
                </span>
            }
        </h2>
        <div style="overflow-x: auto;">
            @if (Model.SelectedUserId.HasValue)
            {
                @if (Model.Assignments.Any())
                {
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead style="background: var(--primary); color: var(--primary-text);">
                            <tr>
                                <th style="padding: 0.75rem; text-align: left;">@Localizer["AssignmentId"]</th>
                                <th style="padding: 0.75rem; text-align: left;">@Localizer["UserId"]</th>
                                <th style="padding: 0.75rem; text-align: left;">@Localizer["CompanyId"]</th>
                                <th style="padding: 0.75rem; text-align: left;">@Localizer["InstanceId"]</th>
                                <th style="padding: 0.75rem; text-align: left;">@Localizer["WorkDate"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sa in Model.Assignments)
                            {
                                <tr class="diagnostic-row">
                                    <td style="padding: 0.75rem; color: var(--text);">@sa.Id</td>
                                    <td style="padding: 0.75rem; color: var(--text);">@sa.UserId</td>
                                    <td style="padding: 0.75rem; color: var(--text);">@sa.CompanyId</td>
                                    <td style="padding: 0.75rem; color: var(--text);">@sa.InstanceId</td>
                                    <td style="padding: 0.75rem; color: var(--text);">@sa.WorkDate</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p style="color: var(--muted); text-align: center; padding: 1rem;">
                        No assignments found for this user in the selected date range.
                    </p>
                }
            }
            else
            {
                <p style="color: var(--muted); text-align: center; padding: 1rem;">
                    @Localizer["SelectUserToViewAssignments"]
                </p>
            }
        </div>
    </div>
</div>

<style>
    .diagnostic-row {
        border-bottom: 1px solid var(--border);
        transition: background-color 0.2s;
    }

    .diagnostic-row:hover {
        background-color: var(--bg);
    }

    button[type="submit"]:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(0, 123, 255, 0.4) !important;
    }

    button[type="submit"]:active {
        transform: translateY(0);
    }

    select, input[type="date"] {
        cursor: pointer;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    select:focus, input[type="date"]:focus {
        outline: none;
        border-color: var(--primary) !important;
        box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.1);
    }

    select:hover, input[type="date"]:hover {
        border-color: var(--primary);
    }
</style>
