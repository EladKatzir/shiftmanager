@page
@model ShiftManager.Pages.IndexModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@inject IStringLocalizer<SharedResources> Localizer
@inject ShiftManager.Services.ILocalizationService Localization
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["Dashboard_MissionOverview"];
}

<div class="app-content" data-ui-version="v2">
    @* Stat Cards Grid *@
    <div class="dashboard-stats">
        @if (Model.IsAdmin)
        {
            @* Admin View: Team-wide metrics *@
            <div class="stat-card stat-card-1">
                <div class="stat-icon"><i data-lucide="calendar"></i></div>
                <div class="stat-content">
                    <div class="stat-value">@Model.UpcomingShiftsCount</div>
                    <div class="stat-label"><loc key="Dashboard_UpcomingShifts" /></div>
                    <div class="stat-desc"><loc key="Dashboard_UpcomingShifts_Desc" /></div>
                </div>
            </div>

            <div class="stat-card stat-card-2">
                <div class="stat-icon"><i data-lucide="clipboard-list"></i></div>
                <div class="stat-content">
                    <div class="stat-value">@Model.PendingRequestsCount</div>
                    <div class="stat-label"><loc key="Dashboard_PendingRequests" /></div>
                    <div class="stat-desc"><loc key="Dashboard_PendingRequests_Desc" /></div>
                </div>
            </div>

            <div class="stat-card stat-card-3">
                <div class="stat-icon"><i data-lucide="users"></i></div>
                <div class="stat-content">
                    <div class="stat-value">@Model.TeamMembersCount</div>
                    <div class="stat-label"><loc key="Dashboard_TeamMembers" /></div>
                    <div class="stat-desc"><loc key="Dashboard_TeamMembers_Desc" /></div>
                </div>
            </div>

            <div class="stat-card stat-card-4">
                <div class="stat-icon"><i data-lucide="bell"></i></div>
                <div class="stat-content">
                    <div class="stat-value">@Model.UnreadNotificationsCount</div>
                    <div class="stat-label"><loc key="Dashboard_Notifications" /></div>
                    <div class="stat-desc"><loc key="Dashboard_Notifications_Desc" /></div>
                </div>
            </div>
        }
        else
        {
            @* Employee View: Personal metrics *@
            <div class="stat-card stat-card-1">
                <div class="stat-icon"><i data-lucide="calendar"></i></div>
                <div class="stat-content">
                    <div class="stat-value">@Model.UpcomingShiftsCount</div>
                    <div class="stat-label"><loc key="Dashboard_UpcomingShifts" /></div>
                    <div class="stat-desc"><loc key="Dashboard_UpcomingShifts_Desc" /></div>
                </div>
            </div>

            <div class="stat-card stat-card-2">
                <div class="stat-icon"><i data-lucide="clipboard-list"></i></div>
                <div class="stat-content">
                    <div class="stat-value">@Model.PendingRequestsCount</div>
                    <div class="stat-label"><loc key="Dashboard_MyPendingRequests" /></div>
                    <div class="stat-desc"><loc key="Dashboard_MyPendingRequests_Desc" /></div>
                </div>
            </div>

            <div class="stat-card stat-card-3">
                <div class="stat-icon"><i data-lucide="users"></i></div>
                <div class="stat-content">
                    <div class="stat-value">@Model.TeamMembersCount</div>
                    <div class="stat-label"><loc key="Dashboard_TeamMembers" /></div>
                    <div class="stat-desc"><loc key="Dashboard_TeamMembers_Desc" /></div>
                </div>
            </div>

            <div class="stat-card stat-card-4">
                <div class="stat-icon"><i data-lucide="bell"></i></div>
                <div class="stat-content">
                    <div class="stat-value">@Model.UnreadNotificationsCount</div>
                    <div class="stat-label"><loc key="Dashboard_Notifications" /></div>
                    <div class="stat-desc"><loc key="Dashboard_Notifications_Desc" /></div>
                </div>
            </div>
        }
    </div>

    @* Next Shift Highlight (Employee Only) *@
    @if (!Model.IsAdmin && Model.NextShiftDate.HasValue)
    {
        <div class="next-shift-highlight">
            <div class="next-shift-icon"><i data-lucide="star"></i></div>
            <div class="next-shift-content">
                <div class="next-shift-label"><loc key="Dashboard_NextShift" /></div>
                <div class="next-shift-details">
                    <strong>@Model.NextShiftType</strong>
                    @Localizer["Dashboard_NextShift_On"]
                    <strong>@Model.NextShiftDate.Value.ToString("dddd, MMMM dd")</strong>
                </div>
            </div>
        </div>
    }
    else if (!Model.IsAdmin && !Model.NextShiftDate.HasValue)
    {
        <div class="next-shift-highlight next-shift-empty">
            <div class="next-shift-icon"><i data-lucide="inbox"></i></div>
            <div class="next-shift-content">
                <div class="next-shift-label"><loc key="Dashboard_NextShift" /></div>
                <div class="next-shift-details"><loc key="Dashboard_NoShiftsScheduled" /></div>
            </div>
        </div>
    }

    @* Announcements Feed *@
    <div class="dashboard-section">
        <h2 class="dashboard-section-title"><loc key="Dashboard_Announcements" /></h2>
        <div class="card announcements-card">
            <div class="card-body">
                @if (Model.RecentAnnouncements.Any())
                {
                    @foreach (var announcement in Model.RecentAnnouncements.Take(5))
                    {
                        <div class="announcement-item @(announcement.IsPinned ? "pinned" : "")">
                            @if (announcement.IsPinned)
                            {
                                <i data-lucide="pin" class="pin-icon"></i>
                            }
                            <div class="announcement-title">@announcement.Title</div>
                            <div class="announcement-meta">
                                @announcement.Creator?.DisplayName • @Localization.FormatShortMonthDay(announcement.CreatedAt.ToLocalTime())
                            </div>
                            <div class="announcement-content">@announcement.Content</div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i data-lucide="megaphone"></i>
                        <p><loc key="Dashboard_NoAnnouncements" /></p>
                    </div>
                }
            </div>
        </div>
    </div>

    @* Quick Actions Grid *@
    <div class="dashboard-section">
        <h2 class="dashboard-section-title"><loc key="Dashboard_QuickActions" /></h2>
        <div class="quick-actions-grid">
            @if (Model.IsAdmin)
            {
                @* Admin Quick Actions *@
                <a href="/Calendar/Month" class="quick-action-card">
                    <div class="quick-action-icon"><i data-lucide="calendar"></i></div>
                    <div class="quick-action-label"><loc key="Dashboard_ViewCalendar" /></div>
                </a>

                <a href="/Requests/Index" class="quick-action-card">
                    <div class="quick-action-icon"><i data-lucide="clipboard-list"></i></div>
                    <div class="quick-action-label"><loc key="Dashboard_ManageRequests" /></div>
                </a>

                <a href="@(Model.UserRole == ShiftManager.Models.Support.UserRole.Manager ? "/MyTeam/Index" : "/Admin/Users")" class="quick-action-card">
                    <div class="quick-action-icon"><i data-lucide="users"></i></div>
                    <div class="quick-action-label"><loc key="Dashboard_ViewTeam" /></div>
                </a>

                <a href="/Admin/Analytics" class="quick-action-card">
                    <div class="quick-action-icon"><i data-lucide="bar-chart-3"></i></div>
                    <div class="quick-action-label"><loc key="Dashboard_ViewAnalytics" /></div>
                </a>
            }
            else
            {
                @* Employee Quick Actions *@
                <a href="/Calendar/Month" class="quick-action-card">
                    <div class="quick-action-icon"><i data-lucide="calendar"></i></div>
                    <div class="quick-action-label"><loc key="Dashboard_ViewSchedule" /></div>
                </a>

                <a href="/My/Requests" class="quick-action-card">
                    <div class="quick-action-icon"><i data-lucide="clipboard-list"></i></div>
                    <div class="quick-action-label"><loc key="Dashboard_SubmitRequest" /></div>
                </a>

                <a href="/MyTeam/Index" class="quick-action-card">
                    <div class="quick-action-icon"><i data-lucide="users"></i></div>
                    <div class="quick-action-label"><loc key="Dashboard_ViewTeam" /></div>
                </a>

                <a href="/My/Profile" class="quick-action-card">
                    <div class="quick-action-icon"><i data-lucide="user"></i></div>
                    <div class="quick-action-label"><loc key="Dashboard_MyProfile" /></div>
                </a>
            }
        </div>
    </div>
</div>
