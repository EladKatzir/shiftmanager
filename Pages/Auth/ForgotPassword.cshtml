@page
@model ShiftManager.Pages.Auth.ForgotPasswordModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
}

<div class="card" style="max-width:480px; margin:auto">
    <h2>@Localizer["ForgotPassword"]</h2>

    <p style="color: #666; margin-bottom: 1.5rem;">
        Enter your email address and phone number to receive a temporary password.
    </p>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert" style="background-color: var(--success); color: var(--success-text); padding: 1rem; border-radius: 0.5rem; margin-bottom: 1rem;">
            ✓ @Model.SuccessMessage
        </div>
        <div style="text-align: center; margin-top: 1rem;">
            <a href="/Auth/Login" class="btn btn-primary">@Localizer["BackToLogin"]</a>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert" style="background-color: var(--danger); color: var(--danger-text); padding: 1rem; border-radius: 0.5rem; margin-bottom: 1rem;">
                ✗ @Model.ErrorMessage
            </div>
        }

        <form method="post">
            @Html.AntiForgeryToken()
            <div style="display:grid; gap:.75rem; margin-top:.75rem">
                <label>
                    @Localizer["Email"] *<br />
                    <input class="input"
                           asp-for="Email"
                           type="email"
                           required
                           placeholder="your.email@example.com"
                           autocomplete="email" />
                </label>

                <label>
                    @Localizer["Phone"] *<br />
                    <input class="input"
                           asp-for="Phone"
                           type="tel"
                           required
                           placeholder="050-1234567"
                           autocomplete="tel" />
                </label>

                <div style="background-color: #fff3cd; border-left: 4px solid #ffc107; padding: 0.75rem; border-radius: 0.25rem; margin-top: 0.5rem;">
                    <small style="color: #856404;">
                        <strong>⚠️ Security Note:</strong> Both your email and phone number must match our records exactly. A temporary password will be sent to your registered email address.
                    </small>
                </div>

                <button class="btn btn-primary" type="submit" style="margin-top: 0.5rem;">
                    @Localizer["SendTemporaryPassword"]
                </button>
            </div>
        </form>

        <div style="text-align:center; margin-top:1.5rem; padding-top: 1rem; border-top: 1px solid #e0e0e0;">
            <a href="/Auth/Login" style="color: var(--primary); text-decoration: none;">
                ← @Localizer["BackToLogin"]
            </a>
        </div>
    }
</div>
