@page
@model ShiftManager.Pages.Auth.ForgotPasswordModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
}

<div class="card" style="max-width:480px; margin:auto">
    <h2><loc key="PasswordManagement" /></h2>

    @* ✅ SUB-PHASE 18.14: Show temporary password success message at top if generated *@
    @if (!string.IsNullOrEmpty(Model.GeneratedTempPassword))
    {
        <div class="card card--status-success" style="margin-bottom: 1.5rem;">
            <h3 class="card-title"><loc key="TemporaryPasswordGenerated" /></h3>
            <p style="margin-bottom: 0.75rem;"><loc key="TemporaryPasswordInstructions" /></p>
            <div style="background: var(--surface-soft); padding: 1rem; border-radius: 0.5rem; margin-bottom: 1rem;">
                <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--text-muted);"><loc key="YourTemporaryPassword" />:</label>
                <div style="display: flex; gap: 0.5rem; align-items: center;">
                    <code id="tempPasswordValue" style="flex: 1; background: var(--bg); padding: 0.75rem; border-radius: 0.375rem; font-size: 1.125rem; font-weight: 600; letter-spacing: 0.5px; user-select: all;">@Model.GeneratedTempPassword</code>
                    <button type="button" class="btn btn-secondary" id="copyTempPasswordBtn" onclick="copyTempPassword()" style="white-space: nowrap;">
                        📋 <loc key="CopyPassword" />
                    </button>
                </div>
            </div>
            <div style="background-color: var(--warning-soft); border-inline-start: 4px solid var(--warning); padding: 0.75rem; border-radius: 0.25rem;">
                <small style="color: var(--warning);">
                    <strong>⚠️ <loc key="Important" />:</strong> <loc key="ChangePasswordAfterLogin_WithForm" />
                </small>
            </div>
        </div>
    }

    @* ✅ SUB-PHASE 18.14: CARD 1 - Reset Password (Forgot Password) - Always visible *@
    <div class="card" style="margin-bottom: 1.5rem;">
        <h3 class="card-title"><loc key="ForgotPassword" /></h3>

        @* ✅ PHASE 18: Localized description *@
        <p style="color: var(--text-muted); margin-bottom: 1rem; font-size: 0.875rem;">
            <loc key="ForgotPassword_Description" />
        </p>

        @if (!string.IsNullOrEmpty(Model.Success))
        {
            <div class="alert" style="background-color: var(--success); color: var(--success-text); padding: 1rem; border-radius: 0.5rem; margin-bottom: 1rem;">
                ✓ @Model.Success
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="alert" style="background-color: var(--danger); color: var(--danger-text); padding: 1rem; border-radius: 0.5rem; margin-bottom: 1rem;">
                ✗ @Model.Error
            </div>
        }

        <form method="post">
            @Html.AntiForgeryToken()
            <div style="display:grid; gap:.75rem">
                <label>
                    <loc key="Email" /> *<br />
                    <input class="input"
                           asp-for="Email"
                           type="email"
                           required
                           placeholder="your.email@example.com"
                           autocomplete="email" />
                </label>

                <label>
                    <loc key="Phone" /> *<br />
                    <input class="input"
                           asp-for="Phone"
                           type="tel"
                           required
                           placeholder="050-1234567"
                           autocomplete="tel" />
                </label>

                @* ✅ PHASE 18: Localized security note *@
                <div style="background-color: var(--warning-soft); border-inline-start: 4px solid var(--warning); padding: 0.75rem; border-radius: 0.25rem; margin-top: 0.5rem;">
                    <small style="color: var(--warning);">
                        <strong>⚠️ <loc key="SecurityNote" />:</strong> <loc key="ForgotPassword_SecurityNote" />
                    </small>
                </div>

                <button class="btn btn-primary" type="submit" style="margin-top: 0.5rem;">
                    <loc key="SendTemporaryPassword" />
                </button>
            </div>
        </form>
    </div>

    @* ✅ SUB-PHASE 18.14: CARD 2 - Change Password - Always visible *@
    <div class="card" style="background-color: var(--surface-soft); margin-bottom: 1.5rem;">
        <h3 class="card-title"><loc key="ChangePassword" /></h3>

        <p style="color: var(--text-muted); margin-bottom: 1rem; font-size: 0.875rem;">
            If you already know your current password and want to change it, use this form.
        </p>

        @if (!string.IsNullOrEmpty(Model.PasswordChangeSuccess))
        {
            <div class="alert" style="background-color: var(--success); color: var(--success-text); padding: 1rem; border-radius: 0.5rem; margin-bottom: 1rem;">
                ✓ @Model.PasswordChangeSuccess
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.PasswordChangeError))
        {
            <div class="alert" style="background-color: var(--danger); color: var(--danger-text); padding: 1rem; border-radius: 0.5rem; margin-bottom: 1rem;">
                ✗ @Model.PasswordChangeError
            </div>
        }

        <form method="post" asp-page-handler="ChangePassword">
            @Html.AntiForgeryToken()
            <div style="display:grid; gap:.75rem">
                <label>
                    <loc key="Email" /> *<br />
                    <input class="input"
                           asp-for="ChangeEmail"
                           type="email"
                           required
                           placeholder="your.email@example.com"
                           autocomplete="email" />
                </label>

                <label>
                    <loc key="OldPassword" /> *<br />
                    <input class="input"
                           asp-for="OldPassword"
                           type="password"
                           required
                           placeholder="••••••••"
                           autocomplete="current-password" />
                </label>

                <label>
                    <loc key="NewPassword" /> *<br />
                    <input class="input"
                           asp-for="NewPassword"
                           type="password"
                           required
                           placeholder="••••••••"
                           minlength="6"
                           autocomplete="new-password" />
                    <small style="color: var(--text-muted); display: block; margin-top: 0.25rem;">
                        <loc key="NewPasswordTooShort" />
                    </small>
                </label>

                <button class="btn btn-primary" type="submit" style="margin-top: 0.5rem;">
                    <loc key="ChangePasswordButton" />
                </button>
            </div>
        </form>
    </div>

    @* ✅ SUB-PHASE 18.14: Back to Login link - Always visible *@
    <div style="text-align:center; padding-top: 1rem; border-top: 1px solid var(--border);">
        <a href="/Auth/Login" style="color: var(--primary); text-decoration: none;">
            ← <loc key="BackToLogin" />
        </a>
    </div>
</div>

@* ✅ PHASE 18: Copy to clipboard JavaScript *@
@if (!string.IsNullOrEmpty(Model.GeneratedTempPassword))
{
    <script>
    function copyTempPassword() {
        const passwordElement = document.getElementById('tempPasswordValue');
        const button = document.getElementById('copyTempPasswordBtn');

        if (!passwordElement) return;

        var copiedText = '@Localizer["Copied"]';

        // Use modern Clipboard API
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(passwordElement.textContent).then(() => {
                // Show success feedback
                const originalText = button.innerHTML;
                button.innerHTML = '✓ ' + copiedText + '!';
                button.style.background = 'var(--success)';

                // Reset button after 2 seconds
                setTimeout(() => {
                    button.innerHTML = originalText;
                    button.style.background = '';
                }, 2000);
            }).catch(err => {
                console.error('Failed to copy password:', err);
                alert('@Localizer["Error_FailedToCopyPassword"]');
            });
        } else {
            // Fallback for older browsers
            const textArea = document.createElement('textarea');
            textArea.value = passwordElement.textContent;
            textArea.style.position = 'fixed';
            textArea.style.left = '-999999px';
            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();

            try {
                document.execCommand('copy');
                const originalText = button.innerHTML;
                button.innerHTML = '✓ ' + copiedText + '!';
                button.style.background = 'var(--success)';

                setTimeout(() => {
                    button.innerHTML = originalText;
                    button.style.background = '';
                }, 2000);
            } catch (err) {
                console.error('Fallback copy failed:', err);
                alert('@Localizer["Error_FailedToCopyPassword"]');
            }

            document.body.removeChild(textArea);
        }
    }
    </script>
}
