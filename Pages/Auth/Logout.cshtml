@page
@model ShiftManager.Pages.Auth.LogoutModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" dir="@(System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Localizer["Auth_LoggedOutTitle"] - Shift Manager</title>
    <link rel="stylesheet" href="~/css/site.css" />
    @if (Model.LoggedOut)
    {
        <meta http-equiv="refresh" content="3;url=/Auth/Login">
    }
</head>
<body>
    <main role="main" style="display: flex; align-items: center; justify-content: center; min-height: 100vh; background: var(--bg);">
        <div style="text-align: center; padding: 3rem; background: var(--surface); border-radius: 1rem; border: 1px solid var(--border); box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1); max-width: 400px;">
            @if (Model.LoggedOut)
            {
                <div style="color: var(--success); font-size: 3rem; margin-bottom: 1rem;" aria-hidden="true">✓</div>
                <h1 style="color: var(--text); margin-bottom: 1rem; font-size: 1.5rem;"><loc key="Auth_SuccessfullyLoggedOut" /></h1>
                <p style="color: var(--muted); margin-bottom: 2rem;"><loc key="Auth_SecurelyLoggedOutMessage" /></p>
                <p style="color: var(--muted); font-size: 0.9rem;" aria-live="polite"><loc key="Auth_RedirectingToLogin" /></p>
                <a href="/Auth/Login" style="display: inline-block; margin-top: 1rem; padding: 0.75rem 1.5rem; background: var(--primary); color: var(--primary-contrast); text-decoration: none; border-radius: 0.5rem; font-weight: 500;"><loc key="Auth_GoToLoginNow" /></a>
            }
            else
            {
                <h1 style="color: var(--text); font-size: 1.5rem;"><loc key="Auth_LoggingOut" /></h1>
                <p style="color: var(--muted);" aria-live="polite"><loc key="Auth_PleaseWaitLoggingOut" /></p>
            }
        </div>
    </main>
</body>
</html>