@page
@model ShiftManager.Pages.Auth.GriffinCallbackModel
@{
    ViewData["Title"] = "Griffin ADFS Authentication";
}

<div class="container mt-5">
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading">Authentication Failed</h4>
            <p>@Model.Error</p>
            <hr>
            <a href="/Auth/Login" class="btn btn-primary">Return to Login</a>
        </div>
    }
    else if (!string.IsNullOrEmpty(Model.PendingMessage))
    {
        <div class="alert alert-warning" role="alert">
            <h4 class="alert-heading">Account Pending Approval</h4>
            <p>@Model.PendingMessage</p>
            <p>Please contact your administrator to activate your account.</p>
            <hr>
            <a href="/Auth/Login" class="btn btn-primary">Return to Login</a>
        </div>
    }
    else
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="sr-only">Authenticating...</span>
            </div>
            <p class="mt-3">Completing authentication...</p>
        </div>
    }
</div>
