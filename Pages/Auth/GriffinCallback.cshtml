@page
@model ShiftManager.Pages.Auth.GriffinCallbackModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@inject IStringLocalizer<SharedResources> _localizer
@{
    ViewData["Title"] = "Griffin ADFS Authentication";
}

<script>
// Some SSO providers deliver tokens in URL fragments instead of query params.
// We re-emit the value as a query parameter and let the server-side handler take over.
// The token value is shape-checked client-side here AND server-side in OnGetAsync —
// belt-and-suspenders so a junk fragment can't reach the GriffinService HTTP layer.
(function () {
    if (!window.location.hash) return;
    if (window.location.search.indexOf('token=') !== -1) return;
    if (window.location.search.indexOf('HashedToken=') !== -1) return;
    var params = new URLSearchParams(window.location.hash.substring(1));
    var t = params.get('token') || params.get('HashedToken');
    if (!t) return;
    // Bounded length + base64url-style alphabet. Rejecting here avoids navigating to
    // a URL that the server will only refuse. Mirrors IsAcceptableInboundToken in
    // GriffinCallback.cshtml.cs — keep the two in sync.
    if (t.length === 0 || t.length > 4000) return;
    if (!/^[A-Za-z0-9_\-.=]+$/.test(t)) return;
    window.location.href = '/Auth/GriffinCallback?token=' + encodeURIComponent(t);
})();
</script>
<div class="container mt-5">
    @if (!string.IsNullOrEmpty(Model.FailureErrorToken))
    {
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading">@Model.FailureTitle</h4>
            <p class="mb-2">@Model.FailureDetail</p>
            <p class="mb-2"><strong>@_localizer["Auth_GriffinError_RemediationLabel"]:</strong> @Model.FailureRemediation</p>
            <hr>
            <p class="mb-2">
                <code>@Model.FailureErrorToken</code>
                <br />
                <small class="text-muted">@_localizer["Auth_GriffinError_CodeHelp"]</small>
            </p>
            <a href="/Auth/Login" class="btn btn-primary"><loc key="Button_ReturnToLogin">Return to Login</loc></a>
        </div>
    }
    else if (!string.IsNullOrEmpty(Model.Error))
    {
        @* Fallback — GriffinNotEnabled and other non-classified errors still go through the old Error channel *@
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading"><loc key="Auth_AuthenticationFailed">Authentication Failed</loc></h4>
            <p>@Model.Error</p>
            <hr>
            <a href="/Auth/Login" class="btn btn-primary"><loc key="Button_ReturnToLogin">Return to Login</loc></a>
        </div>
    }
    else if (!string.IsNullOrEmpty(Model.PendingMessage))
    {
        <div class="alert alert-warning" role="alert">
            <h4 class="alert-heading"><loc key="Auth_AccountPendingApproval">Account Pending Approval</loc></h4>
            <p>@Model.PendingMessage</p>
            <p><loc key="ContactAdminToActivate">Please contact your administrator to activate your account.</loc></p>
            <hr>
            <a href="/Auth/Login" class="btn btn-primary"><loc key="Button_ReturnToLogin">Return to Login</loc></a>
        </div>
    }
    else
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="sr-only">Authenticating...</span>
            </div>
            <p class="mt-3"><loc key="Auth_CompletingAuthentication" /></p>
        </div>
    }
</div>
