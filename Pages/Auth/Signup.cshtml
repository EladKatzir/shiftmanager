@page
@model ShiftManager.Pages.Auth.SignupModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.Models.Support
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
}
<div class="card" style="max-width:480px; margin:auto">
    <h2><loc key="RequestAccess" /></h2>

    @if (!string.IsNullOrEmpty(Model.PendingRequestMessage))
    {
        <div class="card" style="background:var(--success-bg, #d4edda); color:var(--success-text, #155724); border-color:var(--success, #c3e6cb); padding:1rem; margin-bottom:1rem">
            <strong>✓ @Localizer["RequestSubmitted"]</strong>
            <p style="margin:.5rem 0 0 0">@Model.PendingRequestMessage</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="small" style="color:var(--danger); margin-bottom:.75rem">@Model.Error</div>
    }

    <form method="post" asp-page="./Signup">
        @Html.AntiForgeryToken()
        <div style="display:grid; gap:.75rem; margin-top:.75rem">
            <label>
                @Localizer["Email"]<br />
                <input class="input" asp-for="Email" type="email" required />
                <div id="emailSuggestion" style="display: none;
                     margin-top: 0.25rem;
                     padding: 0.5rem;
                     background: var(--primary-bg);
                     border: 1px solid var(--primary);
                     border-radius: 6px;
                     cursor: pointer;
                     font-size: 0.875rem;
                     color: var(--primary);"></div>
            </label>

            <label>
                @Localizer["DisplayName"]<br />
                <input class="input" asp-for="DisplayName" required />
            </label>

            <label>
                @Localizer["PasswordMinCharacters"]<br />
                <input class="input" asp-for="Password" type="password" minlength="6" required />
            </label>

            <label>
                @Localizer["Company"]<br />
                <select class="input" asp-for="CompanyId" required>
                    <option value=""><loc key="SelectCompany" /></option>
                    @foreach (var company in Model.AvailableCompanies)
                    {
                        <option value="@company.Id">@company.Name</option>
                    }
                </select>
            </label>

            <label>
                @Localizer["RequestedRole"]<br />
                <select class="input" asp-for="RequestedRole" required>
                    <option value="@((int)UserRole.Employee)"><loc key="Employee" /></option>
                    <option value="@((int)UserRole.Manager)"><loc key="Manager" /></option>
                    <option value="@((int)UserRole.Director)"><loc key="Director" /></option>
                    <option value="@((int)UserRole.Trainee)"><loc key="Trainee" /></option>
                    <option value="@((int)UserRole.Assigner)"><loc key="Assigner" /></option>
                </select>
                <small style="color:var(--muted, #6c757d)"><loc key="RequestNeedsApproval" /></small>
            </label>

            <button class="btn btn-primary" type="submit"><loc key="SubmitRequest" /></button>
        </div>
    </form>

    <div class="small" style="margin-top:1rem; text-align:center">
        @Localizer["AlreadyHaveAccount"] <a href="/Auth/Login"><loc key="LoginHere" /></a>
    </div>
</div>

@section Scripts {
    <script>
        // Email domain suggestion
        (function() {
            const emailInput = document.querySelector('input[name="Email"]');
            const suggestionDiv = document.getElementById('emailSuggestion');
            const suggestionText = '@Html.Raw(Localizer["EmailDomainSuggestion"].Value.Replace("@", "@@"))';

            if (emailInput && suggestionDiv) {
                emailInput.addEventListener('input', function(e) {
                    const value = e.target.value.trim();

                    // Show suggestion when typing without @@
                    if (value.length > 0 && value.indexOf('@@') === -1) {
                        suggestionDiv.textContent = suggestionText.replace('{0}', value);
                        suggestionDiv.style.display = 'block';
                    } else {
                        suggestionDiv.style.display = 'none';
                    }
                });

                suggestionDiv.addEventListener('click', function() {
                    const currentValue = emailInput.value.trim();
                    emailInput.value = currentValue + '@@d360.dom';
                    suggestionDiv.style.display = 'none';
                    emailInput.focus();
                });
            }
        })();
    </script>
}
