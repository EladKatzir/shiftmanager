@page
@model ShiftManager.Pages.Auth.SignupModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.Models.Support
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" dir="@(System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Localizer["RequestAccess"] - @Localizer["AppName"]</title>
    <link rel="stylesheet" href="~/css/tokens.css" />
    <link rel="stylesheet" href="~/css/auth.css" />
    <link rel="icon" type="image/svg+xml" href="~/images/shifty-logo.svg" />
    <!-- TEMPORARY: Figma capture script for design export -->
    <script src="https://mcp.figma.com/mcp/html-to-design/capture.js" async></script>
</head>
<body>
    <div class="auth-layout">
        <!-- Hero Panel -->
        <div class="auth-hero">
            <!-- Floating decorative elements (hidden from screen readers) -->
            <span class="auth-hero__float" aria-hidden="true">🗓️</span>
            <span class="auth-hero__float" aria-hidden="true">⏰</span>
            <span class="auth-hero__float" aria-hidden="true">👥</span>
            <span class="auth-hero__float" aria-hidden="true">📊</span>
            <span class="auth-hero__float" aria-hidden="true">✓</span>

            <div class="auth-hero__content">
                <img src="~/images/shifty-logo.svg" alt="Shifty Logo" class="auth-hero__logo" />
                <h1 class="auth-hero__title"><loc key="AppName" /></h1>
                <p class="auth-hero__tagline"><loc key="Auth_SignupTagline" /></p>
            </div>
        </div>

        <!-- Form Panel -->
        <main class="auth-form-panel" role="main">
            <div class="auth-form-container">
                <div class="auth-form-header">
                    <h1><loc key="RequestAccess" /></h1>
                    <p><loc key="Auth_SignupSubtitle" /></p>
                </div>

                @* Success message for pending request *@
                @if (!string.IsNullOrEmpty(Model.PendingRequestMessage))
                {
                    <div class="auth-alert auth-alert--info" style="background: var(--success-soft); border-color: var(--success); color: var(--success);">
                        <span class="auth-alert__icon">✓</span>
                        <div class="auth-alert__content">
                            <div class="auth-alert__title">@Localizer["RequestSubmitted"]</div>
                            <div>@Model.PendingRequestMessage</div>
                        </div>
                    </div>
                }

                @* Error message *@
                @if (!string.IsNullOrEmpty(Model.Error))
                {
                    <div class="auth-alert auth-alert--error">
                        <span class="auth-alert__icon">❌</span>
                        <div class="auth-alert__content">@Model.Error</div>
                    </div>
                }

                @if (!Model.IsPublicSignupEnabled)
                {
                    <div class="auth-alert auth-alert--warning">
                        <span class="auth-alert__icon">🔒</span>
                        <div class="auth-alert__content">
                            <div class="auth-alert__title"><loc key="Auth_SignupDisabledTitle" /></div>
                            <div><loc key="Auth_SignupDisabledMessage" /></div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Progress Steps -->
                    <div class="auth-steps">
                        <div class="auth-step is-active" data-step="1">
                            <span class="auth-step__number">1</span>
                            <span><loc key="Auth_StepAccount" /></span>
                        </div>
                        <div class="auth-step" data-step="2">
                            <span class="auth-step__number">2</span>
                            <span><loc key="Auth_StepUnit" /></span>
                        </div>
                        <div class="auth-step" data-step="3">
                            <span class="auth-step__number">3</span>
                            <span><loc key="Auth_StepRole" /></span>
                        </div>
                    </div>

                    <!-- Signup Form -->
                    <form method="post" asp-page="./Signup" class="auth-form" id="signupForm">
                        @Html.AntiForgeryToken()

                        <!-- Step 1: Account Details -->
                        <div class="auth-field">
                            <label class="auth-field__label" for="Email"><loc key="Email" /></label>
                            <input type="email"
                                   id="Email"
                                   name="Email"
                                   class="auth-field__input"
                                   value="@Model.Email"
                                   placeholder="@Localizer["Auth_EmailPlaceholder"]"
                                   autocomplete="email"
                                   required />
                            <div id="emailSuggestion" class="auth-field__suggestion"></div>
                        </div>

                        <div class="auth-field">
                            <label class="auth-field__label" for="DisplayName"><loc key="DisplayName" /></label>
                            <input type="text"
                                   id="DisplayName"
                                   name="DisplayName"
                                   class="auth-field__input"
                                   value="@Model.DisplayName"
                                   placeholder="@Localizer["Auth_NamePlaceholder"]"
                                   autocomplete="name"
                                   required />
                        </div>

                        <div class="auth-field">
                            <label class="auth-field__label" for="Password"><loc key="PasswordMinCharacters" /></label>
                            <input type="password"
                                   id="Password"
                                   name="Password"
                                   class="auth-field__input"
                                   placeholder="@Localizer["Auth_PasswordPlaceholder"]"
                                   autocomplete="new-password"
                                   minlength="6"
                                   required />
                        </div>

                        <!-- Step 2: Unit (Molecule + JobType) -->
                        <div class="auth-field" id="moleculeField">
                            <label class="auth-field__label" for="MoleculeId"><loc key="Auth_SelectMolecule" /></label>
                            <select id="MoleculeId"
                                    name="MoleculeId"
                                    class="auth-field__select"
                                    required>
                                <option value="">@Localizer["Auth_ChooseMolecule"]</option>
                                @foreach (var molecule in Model.AvailableMolecules)
                                {
                                    <option value="@molecule.Id" data-area-id="@molecule.AreaId"
                                            data-type="@((int)molecule.Type)"
                                            selected="@(Model.MoleculeId == molecule.Id)">
                                        @(molecule.DisplayName ?? molecule.Name)
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="auth-field" id="jobTypeField">
                            <label class="auth-field__label" for="JobTypeId"><loc key="Auth_SelectJobType" /></label>
                            <select id="JobTypeId"
                                    name="JobTypeId"
                                    class="auth-field__select"
                                    disabled
                                    required>
                                <option value="">@Localizer["Auth_ChooseJobTypeFirst"]</option>
                            </select>
                            <span asp-validation-for="JobTypeId" style="color: var(--danger); font-size: var(--text-tiny);"></span>
                            <div id="jobTypeLoading" style="display: none; margin-top: 0.5rem; color: var(--text-muted); font-size: var(--text-small);">
                                <loc key="Loading" />...
                            </div>
                        </div>

                        <!-- Step 3: Role + Company -->
                        <div class="auth-field">
                            <label class="auth-field__label" for="RequestedRole"><loc key="RequestedRole" /></label>
                            <select id="RequestedRole"
                                    name="RequestedRole"
                                    class="auth-field__select"
                                    required>
                                <option value="">@Localizer["Loading"]...</option>
                            </select>
                            <input type="hidden" id="RequestedRoleTemplateId" name="RequestedRoleTemplateId" value="@Model.RequestedRoleTemplateId" />
                            <small style="color: var(--text-muted); font-size: var(--text-tiny); display: block; margin-top: var(--space-1);">
                                <loc key="RequestNeedsApproval" />
                            </small>
                        </div>

                        <div class="auth-field" id="companyField">
                            <label class="auth-field__label" id="companyLabel" for="CompanyId"><loc key="Company" /></label>
                            <select id="CompanyId"
                                    name="CompanyId"
                                    class="auth-field__select"
                                    disabled
                                    required>
                                <option value="">@Localizer["Auth_ChooseRoleFirst"]</option>
                            </select>
                            <div id="companyLoading" style="display: none; margin-top: 0.5rem; color: var(--text-muted); font-size: var(--text-small);">
                                <loc key="Loading" />...
                            </div>
                        </div>

                        @* Hidden field for DepartmentId (populated by JS for Tech molecules) *@
                        <input type="hidden" id="DepartmentId" name="DepartmentId" value="@(Model.DepartmentId > 0 ? Model.DepartmentId.ToString() : "")" />

                        <div id="directorHqHint" class="auth-field" style="display: none; color: var(--info); font-size: var(--text-small);">
                            @Localizer["Auth_DirectorAutoHQ"]
                        </div>

                        <button type="submit" class="auth-submit">
                            <loc key="SubmitRequest" />
                        </button>
                    </form>
                }

                <!-- Login Link -->
                <div class="auth-secondary" style="margin-top: var(--space-6); text-align: center;">
                    <span style="color: var(--text-muted);">@Localizer["AlreadyHaveAccount"]</span>
                    <a href="/Auth/Login" style="color: var(--primary); text-decoration: none; font-weight: 500; margin-inline-start: var(--space-1);">
                        <loc key="LoginHere" />
                    </a>
                </div>
            </div>
        </main>
    </div>

    <script>
        // Apply saved theme
        (function() {
            var saved = localStorage.getItem('theme');
            if (saved) {
                document.documentElement.setAttribute('data-theme', saved);
            } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();

        // Email domain suggestion
        (function() {
            var emailInput = document.getElementById('Email');
            var suggestionDiv = document.getElementById('emailSuggestion');
            // SECURITY FIX: Use Json.Serialize for proper JS-context escaping (prevents XSS via localization overrides)
            var suggestionText = @Html.Raw(Json.Serialize(Localizer["EmailDomainSuggestion"].Value));

            if (emailInput && suggestionDiv) {
                emailInput.addEventListener('input', function(e) {
                    var value = e.target.value.trim();

                    if (value.length > 0 && value.indexOf('@@') === -1) {
                        suggestionDiv.textContent = suggestionText.replace('{0}', value);
                        suggestionDiv.classList.add('is-visible');
                    } else {
                        suggestionDiv.classList.remove('is-visible');
                    }
                });

                suggestionDiv.addEventListener('click', function() {
                    var currentValue = emailInput.value.trim();
                    emailInput.value = currentValue + '@@d360.dom';
                    suggestionDiv.classList.remove('is-visible');
                    emailInput.focus();
                });
            }
        })();

        // Cascading dropdowns: Molecule -> JobType -> Role -> Company
        (function() {
            var roleSelect = document.getElementById('RequestedRole');
            var templateIdInput = document.getElementById('RequestedRoleTemplateId');
            var moleculeSelect = document.getElementById('MoleculeId');
            var companySelect = document.getElementById('CompanyId');
            var companyField = document.getElementById('companyField');
            var companyLabel = document.getElementById('companyLabel');
            var jobTypeSelect = document.getElementById('JobTypeId');
            var jobTypeField = document.getElementById('jobTypeField');
            var departmentIdInput = document.getElementById('DepartmentId');
            var companyLoading = document.getElementById('companyLoading');
            var jobTypeLoading = document.getElementById('jobTypeLoading');
            var directorHqHint = document.getElementById('directorHqHint');
            var steps = document.querySelectorAll('.auth-step');

            if (!moleculeSelect || !companySelect || !roleSelect) return;

            var DIRECTOR_VALUE = '@((int)UserRole.Director)';
            var AREAADMIN_VALUE = '@((int)UserRole.AreaAdmin)';
            var MOLECULE_TYPE_TECH = '1';
            var isHebrew = document.documentElement.lang === 'he';
            var savedRole = '@((int)Model.RequestedRole)';
            var savedTemplateId = '@(Model.RequestedRoleTemplateId?.ToString() ?? "")';
            var savedCompanyId = '@(Model.CompanyId > 0 ? Model.CompanyId.ToString() : "")';
            var savedJobTypeId = '@(Model.JobTypeId > 0 ? Model.JobTypeId.ToString() : "")';
            var savedDepartmentId = '@(Model.DepartmentId > 0 ? Model.DepartmentId.ToString() : "")';
            var currentMoleculeIsTech = false;

            // Full list of role templates (loaded once, filtered per molecule type)
            var allRoleTemplates = [];

            // RoleScopeLevel constants (from Models/Support/RoleScopeLevel.cs)
            // Tech molecules: hide CompanyJobType (2) and MoleculeJobType (5) — these require a job type
            // Workforce molecules: hide Department (3) — workforce doesn't use departments
            var SCOPE_COMPANY_JOBTYPE = 2;
            var SCOPE_DEPARTMENT = 3;
            var SCOPE_MOLECULE_JOBTYPE = 5;

            // Track company value when switching to Director role (Bug 2 fix)
            var savedCompanyValue = '';

            // ──────────────────────────────────────────────
            // Role Templates: load once, filter per molecule
            // ──────────────────────────────────────────────

            fetch('/Api/Signup/GetSignupOptions?handler=RoleTemplates', { credentials: 'same-origin' })
                .then(function(r) {
                    if (!r.ok) throw new Error('Request failed: ' + r.status);
                    return r.json();
                })
                .then(function(data) {
                    if (!data.roleTemplates || data.roleTemplates.length === 0) return;
                    allRoleTemplates = data.roleTemplates;
                    // If a molecule is already selected (post-back), apply filtering immediately
                    if (moleculeSelect.value) {
                        filterRoleTemplatesForMoleculeType(isMoleculeTech());
                    } else {
                        populateRoleDropdown(allRoleTemplates);
                    }
                })
                .catch(function() {
                    // Fallback: keep current state (page will have empty dropdown)
                });

            // Populate role dropdown from a (potentially filtered) list of templates
            function populateRoleDropdown(templates) {
                var previousTemplateId = templateIdInput ? templateIdInput.value : '';
                roleSelect.innerHTML = '';
                // Add placeholder option
                var placeholder = document.createElement('option');
                placeholder.value = '';
                placeholder.textContent = '@Localizer["Auth_SelectRole"].Value.Trim()';
                roleSelect.appendChild(placeholder);

                templates.forEach(function(rt) {
                    var opt = document.createElement('option');
                    opt.value = rt.derivedUserRole != null ? rt.derivedUserRole.toString() : '';
                    opt.setAttribute('data-template-id', rt.id);
                    var name = isHebrew ? (rt.displayNameHE || rt.displayNameEN) : (rt.displayNameEN || rt.displayNameHE);
                    opt.textContent = name || rt.displayName || rt.key;
                    // Restore selection from form post-back or previous selection
                    var matchId = previousTemplateId || savedTemplateId;
                    if (matchId && rt.id.toString() === matchId) {
                        opt.selected = true;
                    } else if (!matchId && rt.derivedUserRole != null && rt.derivedUserRole.toString() === savedRole) {
                        opt.selected = true;
                    }
                    roleSelect.appendChild(opt);
                });
                syncTemplateId();
                // Fire change to update company field based on selected role
                roleSelect.dispatchEvent(new Event('change'));
            }

            // Filter role templates based on molecule type
            function filterRoleTemplatesForMoleculeType(isTech) {
                if (allRoleTemplates.length === 0) return;
                var filtered = allRoleTemplates.filter(function(rt) {
                    if (isTech) {
                        // Tech: exclude job-type-specific workforce roles (Lead, Director)
                        return rt.scopeLevel !== SCOPE_COMPANY_JOBTYPE && rt.scopeLevel !== SCOPE_MOLECULE_JOBTYPE;
                    } else {
                        // Workforce/Helper: exclude department-scoped roles
                        return rt.scopeLevel !== SCOPE_DEPARTMENT;
                    }
                });
                populateRoleDropdown(filtered);
            }

            // ──────────────────────────────────────────────
            // Sync hidden RequestedRoleTemplateId
            // ──────────────────────────────────────────────

            function syncTemplateId() {
                var selected = roleSelect.options[roleSelect.selectedIndex];
                if (selected && templateIdInput) {
                    templateIdInput.value = selected.getAttribute('data-template-id') || '';
                }
            }
            roleSelect.addEventListener('change', function() { syncTemplateId(); });

            function isDirectorOrAreaAdmin() {
                return roleSelect.value === DIRECTOR_VALUE || roleSelect.value === AREAADMIN_VALUE;
            }

            // ──────────────────────────────────────────────
            // Step indicator management
            // ──────────────────────────────────────────────

            function updateSteps(currentStep) {
                steps.forEach(function(step, index) {
                    var stepNum = index + 1;
                    step.classList.remove('is-active', 'is-complete');
                    if (stepNum < currentStep) {
                        step.classList.add('is-complete');
                    } else if (stepNum === currentStep) {
                        step.classList.add('is-active');
                    }
                });
            }

            var emailInput = document.getElementById('Email');
            var displayNameInput = document.getElementById('DisplayName');
            var passwordInput = document.getElementById('Password');

            function checkProgress() {
                // Step 1: Account details
                var hasEmail = emailInput && emailInput.value.includes('@@');
                var hasName = displayNameInput && displayNameInput.value.length >= 2;
                var hasPassword = passwordInput && passwordInput.value.length >= 6;

                if (!hasEmail || !hasName || !hasPassword) {
                    updateSteps(1);
                    return;
                }

                // Step 2: Molecule + JobType (Tech molecules skip JobType)
                var hasMolecule = moleculeSelect.value !== '';
                var hasJobType = currentMoleculeIsTech || (jobTypeSelect && jobTypeSelect.value !== '');
                if (!hasMolecule || !hasJobType) {
                    updateSteps(2);
                    return;
                }

                // Step 3: Role + Company (Director/AreaAdmin skips Company)
                var hasRole = roleSelect.value !== '';
                var hasCompany = isDirectorOrAreaAdmin() || (companySelect.value !== '');
                if (!hasRole || !hasCompany) {
                    updateSteps(3);
                    return;
                }

                updateSteps(4); // All complete
            }

            if (emailInput) emailInput.addEventListener('input', checkProgress);
            if (displayNameInput) displayNameInput.addEventListener('input', checkProgress);
            if (passwordInput) passwordInput.addEventListener('input', checkProgress);

            // ──────────────────────────────────────────────
            // Detect molecule type
            // ──────────────────────────────────────────────

            function isMoleculeTech() {
                var selected = moleculeSelect.options[moleculeSelect.selectedIndex];
                return selected && selected.getAttribute('data-type') === MOLECULE_TYPE_TECH;
            }

            // ──────────────────────────────────────────────
            // Load job types for selected molecule's area
            // ──────────────────────────────────────────────

            async function loadJobTypesForMolecule(moleculeId) {
                if (!jobTypeSelect) return;

                // Reset job type dropdown
                jobTypeSelect.innerHTML = '<option value="">@Localizer["Auth_ChooseJobTypeFirst"].Value.Trim()</option>';
                jobTypeSelect.disabled = true;

                if (!moleculeId) return;

                jobTypeLoading.style.display = 'block';
                try {
                    var response = await fetch('/Api/Signup/GetSignupOptions?handler=JobTypes&moleculeId=' + moleculeId, { credentials: 'same-origin' });
                    if (!response.ok) throw new Error('Request failed: ' + response.status);
                    var data = await response.json();

                    if (data.jobTypes && data.jobTypes.length > 0) {
                        jobTypeSelect.innerHTML = '<option value="">@Localizer["Auth_SelectJobType"].Value.Trim()</option>';
                        data.jobTypes.forEach(function(jobType) {
                            var option = document.createElement('option');
                            option.value = jobType.id;
                            option.textContent = jobType.name;
                            if (jobType.key) {
                                option.dataset.key = jobType.key;
                            }
                            if (jobType.color) {
                                option.style.color = jobType.color;
                            }
                            // Restore selection from post-back
                            if (savedJobTypeId && jobType.id.toString() === savedJobTypeId) {
                                option.selected = true;
                            }
                            jobTypeSelect.appendChild(option);
                        });
                        jobTypeSelect.disabled = false;
                    } else {
                        jobTypeSelect.innerHTML = '<option value="">@Localizer["Auth_NoJobTypesAvailable"].Value.Trim()</option>';
                    }
                } catch (error) {
                    console.error('Error fetching job types:', error);
                    jobTypeSelect.innerHTML = '<option value="">@Localizer["Error_LoadingData"].Value.Trim()</option>';
                } finally {
                    jobTypeLoading.style.display = 'none';
                }
            }

            // ──────────────────────────────────────────────
            // Load companies or departments for the company dropdown
            // (triggered by role change, not molecule change)
            // ──────────────────────────────────────────────

            async function loadCompaniesForMolecule(moleculeId) {
                if (!moleculeId) return;

                // Reset company dropdown
                companySelect.innerHTML = '<option value="">@Localizer["Loading"].Value.Trim()...</option>';
                companySelect.disabled = true;
                if (departmentIdInput) departmentIdInput.value = '';
                companyLoading.style.display = 'block';

                if (currentMoleculeIsTech) {
                    // Fetch departments for Tech molecules
                    if (companyLabel) companyLabel.textContent = '@Localizer["Department"].Value.Trim()';
                    try {
                        var response = await fetch('/Api/Signup/GetSignupOptions?handler=Departments&moleculeId=' + moleculeId, { credentials: 'same-origin' });
                        if (!response.ok) throw new Error('Request failed: ' + response.status);
                        var data = await response.json();

                        if (data.departments && data.departments.length > 0) {
                            companySelect.innerHTML = '<option value="">@Localizer["Auth_SelectDepartment"].Value.Trim()</option>';
                            data.departments.forEach(function(dept) {
                                var option = document.createElement('option');
                                option.value = dept.id;
                                option.textContent = dept.name;
                                if (savedDepartmentId && dept.id.toString() === savedDepartmentId) {
                                    option.selected = true;
                                }
                                companySelect.appendChild(option);
                            });
                            companySelect.disabled = false;
                        } else {
                            companySelect.innerHTML = '<option value="">@Localizer["Auth_NoDepartmentsAvailable"].Value.Trim()</option>';
                        }
                    } catch (error) {
                        console.error('Error fetching departments:', error);
                        companySelect.innerHTML = '<option value="">@Localizer["Error_LoadingData"].Value.Trim()</option>';
                    } finally {
                        companyLoading.style.display = 'none';
                    }
                } else {
                    // Fetch companies for Workforce molecules
                    if (companyLabel) companyLabel.textContent = '@Localizer["Company"].Value.Trim()';
                    try {
                        var response = await fetch('/Api/Signup/GetSignupOptions?handler=Companies&moleculeId=' + moleculeId, { credentials: 'same-origin' });
                        if (!response.ok) throw new Error('Request failed: ' + response.status);
                        var data = await response.json();

                        if (data.companies && data.companies.length > 0) {
                            companySelect.innerHTML = '<option value="">@Localizer["SelectCompany"].Value.Trim()</option>';
                            data.companies.forEach(function(company) {
                                var option = document.createElement('option');
                                option.value = company.id;
                                option.textContent = company.name;
                                if (savedCompanyId && company.id.toString() === savedCompanyId) {
                                    option.selected = true;
                                }
                                companySelect.appendChild(option);
                            });
                            companySelect.disabled = false;
                        } else {
                            companySelect.innerHTML = '<option value="">@Localizer["Auth_NoCompaniesAvailable"].Value.Trim()</option>';
                        }
                    } catch (error) {
                        console.error('Error fetching companies:', error);
                        companySelect.innerHTML = '<option value="">@Localizer["Error_LoadingData"].Value.Trim()</option>';
                    } finally {
                        companyLoading.style.display = 'none';
                    }
                }
            }

            // ──────────────────────────────────────────────
            // Molecule change handler
            // Cascade: loads JobTypes (Workforce) + filters RoleTemplates
            // Company loading is deferred to role change handler
            // ──────────────────────────────────────────────

            moleculeSelect.addEventListener('change', function() {
                var moleculeId = this.value;
                currentMoleculeIsTech = isMoleculeTech();

                // Filter role templates by molecule type (Tech vs Workforce/Helper)
                filterRoleTemplatesForMoleculeType(currentMoleculeIsTech);

                // Reset company dropdown — will be populated after role selection
                companySelect.innerHTML = '<option value="">@Localizer["Auth_ChooseRoleFirst"].Value.Trim()</option>';
                companySelect.disabled = true;
                if (departmentIdInput) departmentIdInput.value = '';

                // Update label and job type visibility based on molecule type
                if (currentMoleculeIsTech) {
                    if (companyLabel) companyLabel.textContent = '@Localizer["Department"].Value.Trim()';
                    if (jobTypeField) jobTypeField.style.display = 'none';
                    if (jobTypeSelect) { jobTypeSelect.required = false; jobTypeSelect.disabled = true; }
                } else {
                    if (companyLabel) companyLabel.textContent = '@Localizer["Company"].Value.Trim()';
                    if (jobTypeField) jobTypeField.style.display = '';
                    if (jobTypeSelect) jobTypeSelect.required = true;
                    // Load job types for this molecule's area
                    loadJobTypesForMolecule(moleculeId);
                }

                checkProgress();
            });

            // ──────────────────────────────────────────────
            // Role change handler (MAJOR: now loads companies)
            // Cascade: Director/AreaAdmin hides company, others load companies
            // ──────────────────────────────────────────────

            roleSelect.addEventListener('change', function() {
                if (isDirectorOrAreaAdmin()) {
                    // Director/AreaAdmin: hide company field, auto-HQ
                    if (companySelect.value) {
                        savedCompanyValue = companySelect.value;
                    }
                    companyField.style.display = 'none';
                    companySelect.required = false;
                    companySelect.disabled = true;
                    companySelect.value = '';
                    if (directorHqHint) directorHqHint.style.display = 'block';
                } else if (roleSelect.value !== '') {
                    // Non-Director role selected: show and load company/department dropdown
                    companyField.style.display = '';
                    companySelect.required = true;
                    if (directorHqHint) directorHqHint.style.display = 'none';

                    if (moleculeSelect.value) {
                        // Bug 2 fix: if we already have options loaded, try to restore saved value
                        if (savedCompanyValue && companySelect.options.length > 1 && companySelect.querySelector('option[value="' + savedCompanyValue + '"]')) {
                            companySelect.disabled = false;
                            companySelect.value = savedCompanyValue;
                        } else {
                            // Load companies/departments for the selected molecule
                            loadCompaniesForMolecule(moleculeSelect.value);
                        }
                    } else {
                        // No molecule selected yet — show placeholder
                        companySelect.innerHTML = '<option value="">@Localizer["Auth_ChooseRoleFirst"].Value.Trim()</option>';
                        companySelect.disabled = true;
                    }
                } else {
                    // No role selected (placeholder) — reset company to waiting state
                    companyField.style.display = '';
                    companySelect.innerHTML = '<option value="">@Localizer["Auth_ChooseRoleFirst"].Value.Trim()</option>';
                    companySelect.disabled = true;
                    companySelect.required = true;
                    if (directorHqHint) directorHqHint.style.display = 'none';
                }
                checkProgress();
            });

            // ──────────────────────────────────────────────
            // Company/Department change -> sync hidden fields
            // ──────────────────────────────────────────────

            companySelect.addEventListener('change', function() {
                if (currentMoleculeIsTech && departmentIdInput) {
                    // For Tech molecules, the dropdown holds department IDs
                    departmentIdInput.value = companySelect.value;
                } else {
                    if (departmentIdInput) departmentIdInput.value = '';
                }
                checkProgress();
            });

            // JobType change -> update progress
            if (jobTypeSelect) {
                jobTypeSelect.addEventListener('change', function() {
                    checkProgress();
                });
            }

            // ──────────────────────────────────────────────
            // Post-back restoration: re-trigger cascading dropdowns
            // Molecule change loads JobTypes + filters roles,
            // then role change loads companies
            // ──────────────────────────────────────────────

            if (moleculeSelect.value) {
                currentMoleculeIsTech = isMoleculeTech();

                // Update job type visibility for Tech molecules
                if (currentMoleculeIsTech) {
                    if (jobTypeField) jobTypeField.style.display = 'none';
                    if (jobTypeSelect) { jobTypeSelect.required = false; jobTypeSelect.disabled = true; }
                } else {
                    if (jobTypeField) jobTypeField.style.display = '';
                    if (jobTypeSelect) jobTypeSelect.required = true;
                    loadJobTypesForMolecule(moleculeSelect.value);
                }

                // Role templates are loaded asynchronously — the fetch callback above
                // will call filterRoleTemplatesForMoleculeType which calls populateRoleDropdown
                // which fires roleSelect change, which loads companies.
                // So we don't need to manually trigger here — the async chain handles it.
            }
        })();
    </script>
</body>
</html>
