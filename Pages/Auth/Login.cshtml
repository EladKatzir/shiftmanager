@page
@model ShiftManager.Pages.Auth.LoginModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" dir="@(System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Localizer["Login"] - @Localizer["AppName"]</title>
    <link rel="stylesheet" href="~/css/tokens.css" />
    <link rel="stylesheet" href="~/css/auth.css" />
    <link rel="icon" type="image/svg+xml" href="~/images/shifty-logo.svg" />
</head>
<body>
    <div class="auth-layout">
        <!-- Hero Panel -->
        <div class="auth-hero">
            <!-- Floating decorative elements (hidden from screen readers) -->
            <span class="auth-hero__float" aria-hidden="true">🗓️</span>
            <span class="auth-hero__float" aria-hidden="true"><icon name="clock" /></span>
            <span class="auth-hero__float" aria-hidden="true"><icon name="users" /></span>
            <span class="auth-hero__float" aria-hidden="true"><icon name="bar-chart-2" /></span>
            <span class="auth-hero__float" aria-hidden="true"><icon name="check" /></span>

            <div class="auth-hero__content">
                <img src="~/images/shifty-logo.svg" alt="Shifty Logo" class="auth-hero__logo" />
                <h1 class="auth-hero__title"><loc key="AppName" /></h1>
                <p class="auth-hero__tagline"><loc key="Auth_HeroTagline" /></p>
            </div>
        </div>

        <!-- Form Panel -->
        <main class="auth-form-panel" role="main">
            <!-- Auth Controls (Language + Theme Toggle) -->
            <div class="auth-controls">
                <button class="auth-control-btn" id="authLanguageToggle" aria-label="@Localizer["ToggleLanguage"]" title="@Localizer["ToggleLanguage"]">
                    <span class="auth-control-icon"><icon name="globe" /></span>
                    <span class="auth-control-text">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "he" ? "En" : "עב")</span>
                </button>
                <button class="auth-control-btn" id="authThemeToggle" aria-label="@Localizer["ToggleTheme"]" title="@Localizer["ToggleTheme"]">
                    <span class="auth-control-icon"><icon name="moon" /></span>
                </button>
            </div>
            <div class="auth-form-container">
                <div class="auth-form-header">
                    <h1><loc key="Auth_WelcomeBack" /></h1>
                    <p><loc key="Auth_SignInToContinue" /></p>
                </div>

                @* Show JavaScript alert if user was redirected due to auth requirement *@
                @if (Model.ShowAuthPrompt)
                {
                    <div class="auth-alert auth-alert--info">
                        <span class="auth-alert__icon">ℹ️</span>
                        <div class="auth-alert__content">@Localizer["PleaseSignInToContinue"]</div>
                    </div>
                }

                @* Account lockout alert *@
                @if (Model.IsAccountLocked && Model.LockoutMinutesRemaining.HasValue)
                {
                    <div class="auth-alert auth-alert--error">
                        <span class="auth-alert__icon"><icon name="lock" /></span>
                        <div class="auth-alert__content">
                            <div class="auth-alert__title">@Localizer["Login_AccountLocked_Title"]</div>
                            <div id="lockoutMessage">@Localizer["Login_AccountLocked_Message", Model.LockoutMinutesRemaining.Value]</div>
                        </div>
                    </div>
                }
                @* Warning after 3+ failed attempts *@
                else if (Model.ShowLockoutWarning && !Model.IsAccountLocked)
                {
                    <div class="auth-alert auth-alert--warning">
                        <span class="auth-alert__icon"><icon name="alert-triangle" /></span>
                        <div class="auth-alert__content">@Localizer["Login_FailedAttempts_Warning"]</div>
                    </div>
                }

                @* Error message *@
                @if (!string.IsNullOrEmpty(Model.Error))
                {
                    <div class="auth-alert auth-alert--error">
                        <span class="auth-alert__icon"><icon name="x" /></span>
                        <div class="auth-alert__content">@Model.Error</div>
                    </div>
                }

                <!-- ADFS Login Button (only shown when Griffin is configured and reachable) -->
                @if (Model.ShowGriffinButton)
                {
                    <div class="auth-adfs">
                        <form method="post" asp-page-handler="Griffin" asp-route-returnUrl="@Model.ReturnUrl">
                            <button type="submit" class="auth-adfs__btn">
                                <span class="auth-adfs__icon"><icon name="shield" /></span>
                                <span><loc key="LoginWithADFS" /></span>
                            </button>
                        </form>
                    </div>
                }
                else if (Model.ShowGriffinUnavailableMessage)
                {
                    <div class="auth-adfs">
                        <div class="auth-adfs__warning">
                            <span><icon name="alert-triangle" /></span>
                            <span>@Localizer["LoginWithADFS_Unavailable"]</span>
                        </div>
                    </div>
                }

                @* Regular login section — wrapped so FF_HIDE_REGULAR_LOGIN can hide the
                   form, divider, forgot-password, and request-access links as one unit.
                   Initially hidden ONLY when both the flag is on AND ADFS is actually
                   available — otherwise the user would be locked out with no way in. *@
                @{
                    var hideRegularLoginInitially = Model.HideRegularLogin && Model.ShowGriffinButton;
                }
                <div id="regularLoginSection" style="@(hideRegularLoginInitially ? "display:none;" : null)">
                    @if (Model.ShowGriffinButton)
                    {
                        <!-- Divider -->
                        <div class="auth-divider">
                            <span><loc key="Auth_OrContinueWith" /></span>
                        </div>
                    }

                    <!-- Login Form -->
                    <form method="post" asp-page="./Login" class="auth-form">
                        @Html.AntiForgeryToken()

                        <div class="auth-field">
                            <label class="auth-field__label" for="Email"><loc key="Email" /></label>
                            <input type="email"
                                   id="Email"
                                   name="Email"
                                   class="auth-field__input"
                                   value="@Model.Email"
                                   placeholder="@Localizer["Auth_EmailPlaceholder"]"
                                   autocomplete="email"
                                   required />
                            <div id="emailSuggestion" class="auth-field__suggestion"></div>
                        </div>

                        <div class="auth-field">
                            <label class="auth-field__label" for="Password"><loc key="Password" /></label>
                            <input type="password"
                                   id="Password"
                                   name="Password"
                                   class="auth-field__input"
                                   placeholder="@Localizer["Auth_PasswordPlaceholder"]"
                                   autocomplete="current-password"
                                   required />
                        </div>

                        <div class="auth-forgot">
                            <a href="/Auth/ForgotPassword" class="auth-forgot__link">
                                @Localizer["ForgotPassword"]?
                            </a>
                        </div>

                        <button type="submit" class="auth-submit" @(Model.IsAccountLocked ? "disabled" : "")>
                            <loc key="Login" />
                        </button>

                        <!-- Signup Link (inside form for identical width — <a> doesn't trigger submit) -->
                        <a href="/Auth/Signup" class="auth-secondary__link">
                            <loc key="RequestAccess" />
                        </a>
                    </form>
                </div>
            </div>
        </main>
    </div>

    <script>
        // Apply saved theme
        (function() {
            const saved = localStorage.getItem('theme');
            if (saved) {
                document.documentElement.setAttribute('data-theme', saved);
            } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();

        // Theme Toggle
        (function() {
            const themeToggle = document.getElementById('authThemeToggle');
            if (themeToggle) {
                themeToggle.addEventListener('click', function() {
                    const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
                    const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
                    document.documentElement.setAttribute('data-theme', newTheme);
                    localStorage.setItem('theme', newTheme);
                });
            }
        })();

        // Language Toggle
        (function() {
            const langToggle = document.getElementById('authLanguageToggle');
            if (langToggle) {
                langToggle.addEventListener('click', function() {
                    const currentLang = document.documentElement.lang;
                    const newLang = currentLang.startsWith('he') ? 'en-US' : 'he-IL';
                    const expires = new Date();
                    expires.setFullYear(expires.getFullYear() + 1);
                    document.cookie = `.AspNetCore.Culture=c=${newLang}|uic=${newLang}; expires=${expires.toUTCString()}; path=/`;
                    // Dual-write marker: records deliberate intent. Mirror of the write in
                    // Pages/Shared/Components/LanguageToggle/Default.cshtml — keep both in sync.
                    document.cookie = `.culture_explicit=v2; expires=${expires.toUTCString()}; path=/; SameSite=Lax`;
                    window.location.reload();
                });
            }
        })();

        // FF_HIDE_REGULAR_LOGIN escape hatch: Ctrl+click (or ⌘+click on Mac) on the
        // Shifty logo reveals the regular email/password form. Intentionally has no
        // visible affordance — the obscurity IS the security model. Admins with local
        // passwords are the intended audience; ADFS-provisioned users have empty
        // PasswordHash and would be rejected even if they discovered the gesture.
        (function() {
            const logo = document.querySelector('.auth-hero__logo');
            const section = document.getElementById('regularLoginSection');
            if (!logo || !section) return;
            // Only attach when the section starts hidden — otherwise the gesture is a no-op
            // and we don't want to interfere with normal logo clicks (none today, but still).
            if (section.style.display !== 'none') return;

            logo.addEventListener('click', function(e) {
                if (e.ctrlKey || e.metaKey) {
                    e.preventDefault();
                    section.style.display = '';
                    const emailField = document.getElementById('Email');
                    if (emailField) emailField.focus();
                }
            });
        })();

        // Email domain suggestion
        (function() {
            const emailInput = document.getElementById('Email');
            const suggestionDiv = document.getElementById('emailSuggestion');
            // SECURITY FIX: Use Json.Serialize for proper JS-context escaping (prevents XSS via localization overrides)
            const suggestionText = @Html.Raw(Json.Serialize(Localizer["EmailDomainSuggestion"].Value));

            if (emailInput && suggestionDiv) {
                emailInput.addEventListener('input', function(e) {
                    const value = e.target.value.trim();

                    if (value.length > 0 && value.indexOf('@@') === -1) {
                        suggestionDiv.textContent = suggestionText.replace('{0}', value);
                        suggestionDiv.classList.add('is-visible');
                    } else {
                        suggestionDiv.classList.remove('is-visible');
                    }
                });

                suggestionDiv.addEventListener('click', function() {
                    const currentValue = emailInput.value.trim();
                    emailInput.value = currentValue + '@@d360.dom';
                    suggestionDiv.classList.remove('is-visible');
                    emailInput.focus();
                });
            }
        })();

        // Lockout countdown timer
        @if (Model.IsAccountLocked && Model.LockoutMinutesRemaining.HasValue)
        {
            @:
            @:(function() {
            @:    const lockoutMessageEl = document.getElementById('lockoutMessage');
            @:    if (!lockoutMessageEl) return;
            @:
            @:    let minutesRemaining = @Model.LockoutMinutesRemaining.Value;
            @:    const lockoutRetryMessage = @Html.Raw(Json.Serialize(Localizer["Login_Lockout_RetryNow"].Value));
            @:    const lockoutCountdownTemplate = @Html.Raw(Json.Serialize(Localizer["Login_Lockout_Countdown"].Value));
            @:
            @:    const updateCountdown = () => {
            @:        if (minutesRemaining <= 0) {
            @:            lockoutMessageEl.textContent = lockoutRetryMessage;
            @:            const alertEl = lockoutMessageEl.closest('.auth-alert');
            @:            if (alertEl) {
            @:                alertEl.classList.remove('auth-alert--error');
            @:                alertEl.classList.add('auth-alert--info');
            @:            }
            @:            return;
            @:        }
            @:        lockoutMessageEl.textContent = lockoutCountdownTemplate.replace('{0}', Math.ceil(minutesRemaining));
            @:    };
            @:
            @:    const timer = setInterval(() => {
            @:        minutesRemaining = Math.max(0, minutesRemaining - 0.17);
            @:        if (minutesRemaining < 0.5) {
            @:            minutesRemaining = 0;
            @:            clearInterval(timer);
            @:        }
            @:        updateCountdown();
            @:    }, 10000);
            @:
            @:    updateCountdown();
            @:})();
        }
    </script>
</body>
</html>
