@page
@model ShiftManager.Pages.Auth.LoginModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
}

@* ✅ PHASE 18: Show JavaScript alert if user was redirected due to auth requirement *@
@if (Model.ShowAuthPrompt)
{
    <script>
        window.addEventListener('DOMContentLoaded', function() {
            alert(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["PleaseSignInToContinue"].Value)));
        });
    </script>
}

@* Griffin ADFS login option (always visible) *@
<div style="max-width:420px; margin:auto">
    <div class="card mb-4">
        <div class="card-body text-center">
            <h5 class="card-title"><loc key="LoginWithADFS" /></h5>
            <p class="text-muted"><loc key="LoginWithADFS_Description" /></p>
            <form method="post" asp-page-handler="Griffin" asp-route-returnUrl="@Model.ReturnUrl">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="fas fa-shield-alt"></i> @Localizer["LoginWithADFS"]
                </button>
            </form>
        </div>
    </div>

    <div class="text-center mb-3">
        <span class="text-muted">— OR —</span>
    </div>

    @if (Model.ShowGriffinUnavailableMessage)
    {
        <div class="alert alert-warning" role="alert">
            <i class="fas fa-exclamation-triangle"></i>
            @Localizer["LoginWithADFS_Unavailable"]
        </div>
    }
</div>

<div class="card" style="max-width:420px; margin:auto">
    <h2><loc key="Login" /></h2>
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="small" style="color:var(--danger)">@Model.Error</div>
    }
   <form method="post" asp-page="./Login">
    @Html.AntiForgeryToken()
    <div style="display:grid; gap:.75rem; margin-top:.75rem">
        <label><loc key="Email" /><br /><input class="input" asp-for="Email" />
        <div id="emailSuggestion" style="display: none;
             margin-top: 0.25rem;
             padding: 0.5rem;
             background: var(--primary-bg);
             border: 1px solid var(--primary);
             border-radius: 6px;
             cursor: pointer;
             font-size: 0.875rem;
             color: var(--primary);"></div>
        </label>
        <label><loc key="Password" /><br /><input class="input" asp-for="Password" type="password" /></label>

        <div style="text-align: right; margin-top: -0.5rem;">
            <a href="/Auth/ForgotPassword" style="font-size: 0.875rem; color: var(--primary);">
                @Localizer["ForgotPassword"]?
            </a>
        </div>

        <button class="btn btn-primary" type="submit"><loc key="Login" /></button>

        @* ✅ SUB-PHASE 18.14 REVISED: Request access button below login *@
        <a href="/Auth/Signup" class="btn btn-secondary" style="margin-top: 0.5rem; text-align: center; width: 100%; display: block;">
            @Localizer["RequestAccess"]
        </a>
    </div>
</form>
</div>

@section Scripts {
    <script>
        // Email domain suggestion
        (function() {
            const emailInput = document.querySelector('input[name="Email"]');
            const suggestionDiv = document.getElementById('emailSuggestion');
            const suggestionText = '@Html.Raw(Localizer["EmailDomainSuggestion"].Value.Replace("@", "@@"))';

            if (emailInput && suggestionDiv) {
                emailInput.addEventListener('input', function(e) {
                    const value = e.target.value.trim();

                    // Show suggestion when typing without @@
                    if (value.length > 0 && value.indexOf('@@') === -1) {
                        suggestionDiv.textContent = suggestionText.replace('{0}', value);
                        suggestionDiv.style.display = 'block';
                    } else {
                        suggestionDiv.style.display = 'none';
                    }
                });

                suggestionDiv.addEventListener('click', function() {
                    const currentValue = emailInput.value.trim();
                    emailInput.value = currentValue + '@@d360.dom';
                    suggestionDiv.style.display = 'none';
                    emailInput.focus();
                });
            }
        })();
    </script>
}
