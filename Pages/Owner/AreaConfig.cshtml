@page
@model ShiftManager.Pages.Owner.AreaConfigModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@inject ShiftManager.Services.ILocalizationService Localization
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["Owner_AreaConfig"];
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Owner_AdminPanel"], Url = "/Owner/Index" },
    new BreadcrumbItem { Label = Localizer["Owner_AreaConfig"], IsActive = true }
})

<div class="area-config-container">
    <div class="page-header">
        <h1>
            <span class="page-icon">🏪</span>
            <loc key="Owner_AreaConfig" />
        </h1>
        <p class="page-subtitle"><loc key="Owner_AreaConfig_Desc" /></p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Success))
    {
        <div class="alert alert-success">
            <span>✓</span>
            <span>@Model.Success</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-error">
            <span>✗</span>
            <span>@Model.Error</span>
        </div>
    }

    @if (Model.Areas.Any())
    {
        <div class="areas-grid">
            @foreach (var area in Model.Areas)
            {
                <div class="area-card @(area.IsActive ? "" : "area-card--inactive")">
                    <div class="area-card__header">
                        <div class="area-card__title">
                            <h3>@area.Name</h3>
                            <span class="area-card__project">@area.ProjectName</span>
                        </div>
                        @if (!area.IsActive)
                        {
                            <span class="status-badge status-badge--inactive"><loc key="Inactive" /></span>
                        }
                    </div>

                    <div class="area-card__settings">
                        <div class="setting-row">
                            <div class="setting-label">
                                <span class="setting-icon">😴</span>
                                <loc key="AreaConfig_RestHours" />
                            </div>
                            <div class="setting-value">@area.DefaultRestHours <loc key="Hours" /></div>
                        </div>
                        <div class="setting-row">
                            <div class="setting-label">
                                <span class="setting-icon">⏱️</span>
                                <loc key="AreaConfig_WeeklyCap" />
                            </div>
                            <div class="setting-value">@area.DefaultWeeklyCap <loc key="Hours" /></div>
                        </div>
                    </div>

                    @if (area.LastUpdated.HasValue)
                    {
                        <div class="area-card__meta">
                            <loc key="LastUpdated" />: @Localization.FormatMediumDate(area.LastUpdated.Value)
                        </div>
                    }

                    <div class="area-card__actions">
                        <button class="btn btn-secondary btn-sm" data-area-name="@area.Name" onclick="openEditModal(@area.Id, this.dataset.areaName, @area.DefaultRestHours, @area.DefaultWeeklyCap)">
                            ✏️ <loc key="EditSettings" />
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state__icon">🗂️</div>
            <p><loc key="NoAreasFound" /></p>
            <a href="/Admin/Organization/Areas" class="btn btn-primary">
                <loc key="ManageAreas" />
            </a>
        </div>
    }
</div>

<!-- Edit Modal -->
<div id="editModal" class="modal" style="display: none;">
    <div class="modal-backdrop" onclick="closeEditModal()"></div>
    <div class="modal-content">
        <div class="modal-header">
            <h2><loc key="EditAreaSettings" /></h2>
            <button class="modal-close" onclick="closeEditModal()">×</button>
        </div>
        <form method="post" asp-page-handler="UpdateSettings">
            <div class="modal-body">
                <input type="hidden" name="EditAreaId" id="editAreaId" />

                <p class="modal-area-name" id="modalAreaName"></p>

                <div class="form-group">
                    <label for="DefaultRestHours">
                        <span class="setting-icon">😴</span>
                        <loc key="AreaConfig_RestHours" />
                    </label>
                    <input type="number" id="DefaultRestHours" name="DefaultRestHours"
                           class="form-input" min="0" max="24" required />
                    <span class="form-hint"><loc key="AreaConfig_RestHours_Hint" /></span>
                </div>

                <div class="form-group">
                    <label for="DefaultWeeklyCap">
                        <span class="setting-icon">⏱️</span>
                        <loc key="AreaConfig_WeeklyCap" />
                    </label>
                    <input type="number" id="DefaultWeeklyCap" name="DefaultWeeklyCap"
                           class="form-input" min="0" max="168" required />
                    <span class="form-hint"><loc key="AreaConfig_WeeklyCap_Hint" /></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeEditModal()">
                    <loc key="Cancel" />
                </button>
                <button type="submit" class="btn btn-primary">
                    <loc key="SaveChanges" />
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function openEditModal(areaId, areaName, restHours, weeklyCap) {
    document.getElementById('editAreaId').value = areaId;
    document.getElementById('modalAreaName').textContent = areaName;
    document.getElementById('DefaultRestHours').value = restHours;
    document.getElementById('DefaultWeeklyCap').value = weeklyCap;
    document.getElementById('editModal').style.display = 'flex';
    document.body.style.overflow = 'hidden';
}

function closeEditModal() {
    document.getElementById('editModal').style.display = 'none';
    document.body.style.overflow = '';
}

// Close modal on Escape key
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeEditModal();
    }
});
</script>

<style>
.area-config-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
}

.page-header {
    margin-bottom: 2rem;
}

.page-header h1 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.5rem 0;
    font-size: 2rem;
}

.page-icon {
    font-size: 2.5rem;
}

.page-subtitle {
    color: var(--text-muted);
    margin: 0;
}

.alert {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-radius: 10px;
    margin-bottom: 1.5rem;
    font-weight: 500;
}

.alert-success {
    background: var(--success-soft);
    color: var(--success);
}

.alert-error {
    background: var(--danger-soft);
    color: var(--danger);
}

.areas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
}

.area-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    transition: box-shadow 0.2s, transform 0.2s;
}

.area-card:hover {
    box-shadow: var(--shadow-md);
}

.area-card--inactive {
    opacity: 0.7;
}

.area-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
}

.area-card__title h3 {
    margin: 0 0 0.25rem 0;
    font-size: 1.125rem;
}

.area-card__project {
    color: var(--text-muted);
    font-size: 0.875rem;
}

.status-badge {
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
}

.status-badge--inactive {
    background: var(--surface-soft);
    color: var(--text-muted);
}

.area-card__settings {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
}

.setting-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0.75rem;
    background: var(--surface-soft);
    border-radius: 8px;
}

.setting-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.875rem;
}

.setting-icon {
    font-size: 1rem;
}

.setting-value {
    font-weight: 600;
    color: var(--text);
}

.area-card__meta {
    color: var(--text-muted);
    font-size: 0.75rem;
    margin-bottom: 1rem;
}

.area-card__actions {
    display: flex;
    gap: 0.5rem;
}

.btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
    border: 1px solid var(--border);
}

.btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
}

.btn-primary {
    background: var(--primary);
    color: var(--primary-contrast);
    border-color: var(--primary);
}

.btn-secondary {
    background: var(--surface);
    color: var(--text);
}

.btn:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
}

/* Modal */
.modal {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
}

.modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
}

.modal-content {
    position: relative;
    background: var(--surface);
    border-radius: 12px;
    width: 100%;
    max-width: 480px;
    margin: 1rem;
    box-shadow: var(--shadow-lg);
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border);
}

.modal-header h2 {
    margin: 0;
    font-size: 1.25rem;
}

.modal-close {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-soft);
    border: none;
    border-radius: 6px;
    font-size: 1.25rem;
    cursor: pointer;
    color: var(--text-muted);
}

.modal-close:hover {
    background: var(--surface);
    color: var(--text);
}

.modal-body {
    padding: 1.5rem;
}

.modal-area-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--primary);
    margin: 0 0 1.5rem 0;
    padding: 0.75rem;
    background: var(--primary-soft);
    border-radius: 8px;
    text-align: center;
}

.form-group {
    margin-bottom: 1.25rem;
}

.form-group label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    font-weight: 500;
}

.form-input {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 1rem;
    background: var(--surface-soft);
    color: var(--text);
}

.form-input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: var(--focus-ring);
}

.form-hint {
    display: block;
    margin-top: 0.375rem;
    font-size: 0.75rem;
    color: var(--text-muted);
}

.modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--border);
}

.empty-state {
    text-align: center;
    padding: 3rem 2rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
}

.empty-state__icon {
    font-size: 3rem;
    margin-bottom: 1rem;
}

.empty-state p {
    color: var(--text-muted);
    margin-bottom: 1.5rem;
}

@@media (max-width: 768px) {
    .area-config-container {
        padding: 1rem;
    }

    .page-header h1 {
        font-size: 1.5rem;
    }

    .areas-grid {
        grid-template-columns: 1fr;
    }
}
</style>
