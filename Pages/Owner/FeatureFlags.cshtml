@page
@model ShiftManager.Pages.Owner.FeatureFlagsModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["Owner_FeatureFlags"];
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Owner_AdminPanel"], Url = "/Owner/Index" },
    new BreadcrumbItem { Label = Localizer["Owner_FeatureFlags"], IsActive = true }
})

<div class="feature-flags-container">
    <div class="page-header">
        <h1>
            <span class="page-icon"><i data-lucide="flag"></i></span>
            @Localizer["Owner_FeatureFlags"]
        </h1>
        <p class="page-subtitle"><loc key="FeatureFlags_Subtitle" /></p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-success">
            @Model.Message
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger">
            @Model.Error
        </div>
    }

    <form method="post">
        @foreach (var category in Model.FlagsByCategory)
        {
            <div class="feature-category">
                <div class="category-header" onclick="this.parentElement.classList.toggle('collapsed')">
                    <h2>@category.Key</h2>
                    <span class="category-count">@category.Value.Count <loc key="FeatureFlags_Flags" /></span>
                    <span class="category-toggle"><i data-lucide="chevron-down"></i></span>
                </div>
                <div class="category-body">
                    <div class="feature-flags-grid">
                        @foreach (var flag in category.Value)
                        {
                            <div class="feature-flag-card @(flag.IsEnabled ? "flag-enabled" : "")">
                                <div class="flag-header">
                                    <div>
                                        <h3>@flag.Name</h3>
                                        @if (!string.IsNullOrEmpty(flag.Description))
                                        {
                                            <p>@flag.Description</p>
                                        }
                                    </div>
                                    <label class="toggle-switch">
                                        <input type="checkbox"
                                               name="flag_@flag.Name"
                                               value="true"
                                               checked="@flag.IsEnabled" />
                                        <span class="toggle-slider"></span>
                                    </label>
                                </div>
                                <div class="flag-meta">
                                    <span class="flag-status @(flag.IsEnabled ? "status-on" : "status-off")">
                                        @(flag.IsEnabled ? Localizer["Status_Enabled"] : Localizer["Status_Disabled"])
                                    </span>
                                    @if (flag.UpdatedAt != default)
                                    {
                                        <span class="flag-updated" title="@flag.UpdatedAt.ToString("yyyy-MM-dd HH:mm:ss UTC")">
                                            <loc key="FeatureFlags_Updated" />: @flag.UpdatedAt.ToString("MM/dd HH:mm")
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                <i data-lucide="save"></i> <loc key="Button_SaveChanges" />
            </button>
            <button type="button" class="btn btn-ghost" onclick="location.reload()">
                <i data-lucide="rotate-ccw"></i> <loc key="Button_Reset" />
            </button>
            <span class="form-actions-hint"><loc key="FeatureFlags_ChangesImmediate" /></span>
        </div>
    </form>
</div>

<style>
.feature-flags-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
}

.feature-category {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    margin-bottom: 1.5rem;
    overflow: hidden;
}

.feature-category.collapsed .category-body {
    display: none;
}

.feature-category.collapsed .category-toggle {
    transform: rotate(-90deg);
}

.category-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 2rem;
    cursor: pointer;
    user-select: none;
    border-bottom: 1px solid var(--border);
}

.category-header:hover {
    background: var(--hover);
}

.category-header h2 {
    margin: 0;
    font-size: 1.25rem;
    flex: 1;
}

.category-count {
    font-size: 0.875rem;
    color: var(--muted);
}

.category-toggle {
    transition: transform 0.2s;
    color: var(--muted);
}

.category-body {
    padding: 1.5rem 2rem;
}

.feature-flags-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: 1rem;
}

.feature-flag-card {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem;
    transition: border-color 0.2s;
}

.feature-flag-card.flag-enabled {
    border-color: var(--primary);
    border-inline-start: 3px solid var(--primary);
}

.flag-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 1rem;
    margin-bottom: 0.75rem;
}

.flag-header h3 {
    margin: 0 0 0.375rem 0;
    font-size: 0.8125rem;
    font-family: 'Consolas', 'Monaco', monospace;
    word-break: break-all;
}

.flag-header p {
    margin: 0;
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.4;
}

.toggle-switch {
    position: relative;
    display: inline-block;
    width: 52px;
    height: 28px;
    flex-shrink: 0;
}

.toggle-switch input {
    opacity: 0;
    width: 0;
    height: 0;
}

.toggle-slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--border);
    transition: .3s;
    border-radius: 28px;
}

.toggle-slider:before {
    position: absolute;
    content: "";
    height: 20px;
    width: 20px;
    left: 4px;
    bottom: 4px;
    background-color: var(--surface);
    transition: .3s;
    border-radius: 50%;
}

input:checked + .toggle-slider {
    background-color: var(--primary);
}

input:checked + .toggle-slider:before {
    transform: translateX(24px);
}

.flag-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.flag-status {
    font-size: 0.75rem;
    font-weight: 600;
}

.status-on {
    color: var(--success);
}

.status-off {
    color: var(--muted);
}

.flag-updated {
    font-size: 0.75rem;
    color: var(--muted);
}

.form-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
}

.form-actions-hint {
    font-size: 0.8125rem;
    color: var(--muted);
    margin-inline-start: auto;
}

.alert-success {
    background: var(--success-soft, rgba(34, 197, 94, 0.1));
    border: 1px solid var(--success);
    color: var(--success);
    padding: 1rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
}

.alert-danger {
    background: var(--danger-soft);
    border: 1px solid var(--danger);
    color: var(--danger);
    padding: 1rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
}
</style>
