@page
@model ShiftManager.Pages.Owner.BackupModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["Owner_Backup"];
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Owner_AdminPanel"], Url = "/Owner/Index" },
    new BreadcrumbItem { Label = Localizer["Owner_Backup"], IsActive = true }
})

@* Owner Company Selector *@
@await Component.InvokeAsync("OwnerCompanySelector")

<div class="backup-container">
    <div class="page-header">
        <h1>
            <span class="page-icon">💾</span>
            @Localizer["Owner_Backup"]
        </h1>
        <p class="page-subtitle">Create and manage database backups</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Success))
    {
        <div class="alert alert-success">
            <strong>✅ Success:</strong> @Model.Success
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-error">
            <strong>❌ Error:</strong> @Model.Error
        </div>
    }

    <div class="backup-actions-card">
        <h2>🔧 Backup Actions</h2>
        <form method="post" asp-page-handler="CreateBackup">
            <button type="submit" class="btn btn-primary">💾 Create New Backup</button>
        </form>
        <p class="help-text">
            Creates a snapshot of the current database. Backups are stored in the Backups folder.
        </p>
    </div>

    <div class="backups-list-card">
        <h2>📦 Available Backups</h2>

        @if (!Model.Backups.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">📦</div>
                <p>No backups found</p>
                <small>Create your first backup using the button above</small>
            </div>
        }
        else
        {
            <div class="backups-table-wrapper">
                <table class="backups-table">
                    <thead>
                        <tr>
                            <th>File Name</th>
                            <th>Size</th>
                            <th>Created Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var backup in Model.Backups)
                        {
                            <tr>
                                <td>
                                    <span class="file-icon">💾</span>
                                    <span class="file-name">@backup.FileName</span>
                                </td>
                                <td>@backup.SizeFormatted</td>
                                <td>@backup.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>
                                    <div class="action-buttons">
                                        <a href="/Owner/Backup?handler=DownloadBackup&backupFileName=@backup.FileName"
                                           class="btn-action btn-download"
                                           title="Download">
                                            ⬇️
                                        </a>
                                        <form method="post" asp-page-handler="RestoreBackup" style="display: inline;">
                                            <input type="hidden" name="backupFileName" value="@backup.FileName" />
                                            <button type="submit"
                                                    class="btn-action btn-restore"
                                                    title="Restore"
                                                    onclick="return confirm('Are you sure you want to restore this backup? The current database will be backed up first.')">
                                                ♻️
                                            </button>
                                        </form>
                                        <form method="post" asp-page-handler="DeleteBackup" style="display: inline;">
                                            <input type="hidden" name="backupFileName" value="@backup.FileName" />
                                            <button type="submit"
                                                    class="btn-action btn-delete"
                                                    title="Delete"
                                                    onclick="return confirm('Are you sure you want to delete this backup?')">
                                                🗑️
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="info-card">
        <h3>ℹ️ Important Information</h3>
        <ul>
            <li><strong>Automatic Backups:</strong> Backups are created manually using the button above.</li>
            <li><strong>Before Restore:</strong> The current database is automatically backed up before any restore operation.</li>
            <li><strong>Application Restart:</strong> After restoring a backup, restart the application for changes to take effect.</li>
            <li><strong>Storage Location:</strong> Backups are stored in the <code>Backups</code> folder in the application root.</li>
            <li><strong>Download:</strong> You can download backups to store them externally for additional safety.</li>
        </ul>
    </div>
</div>

<style>
.backup-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
}

.backup-actions-card,
.backups-list-card,
.info-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 2rem;
}

.backup-actions-card h2,
.backups-list-card h2 {
    margin: 0 0 1rem 0;
    font-size: 1.25rem;
}

.help-text {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.875rem;
}

.empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--muted);
}

.empty-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
}

.backups-table-wrapper {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 8px;
}

.backups-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
}

.backups-table thead {
    background: var(--background);
}

.backups-table th {
    padding: 0.75rem;
    text-align: left;
    font-weight: 600;
    border-bottom: 2px solid var(--border);
}

.backups-table td {
    padding: 0.75rem;
    border-bottom: 1px solid var(--border);
}

.backups-table tbody tr:hover {
    background: var(--background);
}

.file-name {
    font-family: 'Consolas', 'Monaco', monospace;
    font-size: 0.875rem;
}

.action-buttons {
    display: flex;
    gap: 0.5rem;
}

.btn-action {
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--background);
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.2s;
    text-decoration: none;
}

.btn-action:hover {
    transform: scale(1.1);
}

.btn-download:hover {
    background: var(--primary);
    border-color: var(--primary);
}

.btn-restore:hover {
    background: var(--success, #10b981);
    border-color: var(--success, #10b981);
}

.btn-delete:hover {
    background: var(--danger, #ef4444);
    border-color: var(--danger, #ef4444);
}

.info-card h3 {
    margin: 0 0 1rem 0;
    font-size: 1rem;
}

.info-card ul {
    margin: 0;
    padding-left: 1.5rem;
}

.info-card li {
    margin-bottom: 0.5rem;
    color: var(--muted);
}

.info-card code {
    background: var(--background);
    padding: 0.125rem 0.25rem;
    border-radius: 4px;
    font-family: 'Consolas', 'Monaco', monospace;
    font-size: 0.875rem;
}

.alert {
    padding: 1rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
}

.alert-success {
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid var(--success, #10b981);
    color: var(--success, #10b981);
}

.alert-error {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid var(--danger, #ef4444);
    color: var(--danger, #ef4444);
}
</style>
