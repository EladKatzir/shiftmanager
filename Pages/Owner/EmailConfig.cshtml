@page
@model ShiftManager.Pages.Owner.EmailConfigModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["Owner_EmailConfig"];
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Owner_AdminPanel"], Url = "/Owner/Index" },
    new BreadcrumbItem { Label = Localizer["Owner_EmailConfig"], IsActive = true }
})

<div class="email-config-container">
    <div class="page-header">
        <h1>
            <span class="page-icon">📧</span>
            @Localizer["Owner_EmailConfig"]
        </h1>
        <p class="page-subtitle">Configure email notifications for the system</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Success))
    {
        <div class="alert alert-success">
            <strong>✅ Success:</strong> @Model.Success
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-error">
            <strong>❌ Error:</strong> @Model.Error
        </div>
    }

    <form method="post">
        <div class="config-card">
            <div class="card-header">
                <h2>📧 Email Service Configuration</h2>
                <div class="form-group-inline">
                    <label class="toggle-label">
                        <input type="checkbox" asp-for="EmailEnabled" class="toggle-checkbox" />
                        <span class="toggle-text">@(Model.EmailEnabled ? "Enabled" : "Disabled")</span>
                    </label>
                </div>
            </div>

            <div class="card-body">
                <div class="form-group">
                    <label asp-for="EmailApiUrl">API URL</label>
                    <input asp-for="EmailApiUrl" class="form-control" placeholder="https://api.yourcompany.com/v1/mail/send" />
                    <small class="form-text">The endpoint URL for your email service API</small>
                </div>

                <div class="form-group">
                    <label asp-for="EmailApiKey">
                        API Key
                        @if (Model.HasExistingKey)
                        {
                            <span class="badge badge-success">✅ Configured</span>
                        }
                    </label>
                    <input asp-for="EmailApiKey" type="password" class="form-control"
                           placeholder="@(Model.HasExistingKey ? "••••••••••••" : "Enter API key")" />
                    <small class="form-text">
                        @if (Model.HasExistingKey)
                        {
                            <span>Leave blank to keep existing key. Enter new key to update.</span>
                        }
                        else
                        {
                            <span>Your email service API key (stored encrypted)</span>
                        }
                    </small>
                </div>

                <div class="form-group">
                    <label asp-for="EmailFromAddress">From Address</label>
                    <input asp-for="EmailFromAddress" type="email" class="form-control" placeholder="noreply@example.com" />
                    <small class="form-text">The email address that will appear as the sender</small>
                </div>
            </div>

            <div class="card-footer">
                <button type="submit" class="btn btn-primary">💾 Save Configuration</button>
                <button type="button" class="btn btn-secondary" onclick="location.href='/Owner/EmailConfig?handler=Test'">
                    📨 Send Test Email
                </button>
            </div>
        </div>
    </form>

    @* Test Email Section *@
    @if (Model.EmailEnabled && Model.HasExistingKey)
    {
        <div class="config-card">
            <div class="card-header">
                <h2>🧪 Test Email</h2>
            </div>
            <div class="card-body">
                <p>Send a test email to verify your configuration is working correctly.</p>
                <form method="post" asp-page-handler="SendTest">
                    <div class="form-group">
                        <label for="testEmail">Recipient Email</label>
                        <input type="email" name="testEmail" class="form-control" placeholder="test@example.com" required />
                    </div>
                    <button type="submit" class="btn btn-secondary">📨 Send Test Email</button>
                </form>
            </div>
        </div>
    }

    @* Test Diagnostics *@
    @if (!string.IsNullOrEmpty(Model.TestDiagnostics))
    {
        <div class="config-card">
            <div class="card-header">
                <h2>🔍 Test Email Diagnostics</h2>
            </div>
            <div class="card-body">
                <div class="diagnostics-output">
                    <pre>@Model.TestDiagnostics</pre>
                </div>
            </div>
        </div>
    }

    @* Recent Email Logs *@
    <div class="config-card">
        <div class="card-header">
            <h2>📋 Recent Email Logs</h2>
            <div class="header-actions">
                <a href="/Owner/EmailConfig?handler=ExportLogsJson&count=100" class="btn btn-secondary btn-sm">
                    📥 Export JSON (100)
                </a>
                <a href="/Owner/EmailConfig?handler=ExportLogsCsv&count=100" class="btn btn-secondary btn-sm">
                    📥 Export CSV (100)
                </a>
            </div>
        </div>
        <div class="card-body">
            @if (Model.RecentLogs.Any())
            {
                <table class="logs-table">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Recipient</th>
                            <th>Subject</th>
                            <th>Status</th>
                            <th>Duration</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.RecentLogs)
                        {
                            <tr class="@(log.Success ? "log-success" : "log-failure")">
                                <td>@log.Timestamp.ToString("MM/dd HH:mm")</td>
                                <td>@log.RecipientEmail</td>
                                <td>@(log.EmailSubject.Length > 30 ? log.EmailSubject.Substring(0, 30) + "..." : log.EmailSubject)</td>
                                <td>
                                    @if (log.Success)
                                    {
                                        <span class="status-badge status-success">✅ @log.ResponseStatusCode</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-failure">❌ @(log.ResponseStatusCode?.ToString() ?? "N/A")</span>
                                    }
                                </td>
                                <td>@log.DurationMs ms</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="empty-state">No email logs yet. Send a test email to see diagnostics.</p>
            }
        </div>
    </div>

    @* Recent Failures *@
    @if (Model.RecentFailures.Any())
    {
        <div class="config-card">
            <div class="card-header">
                <h2>⚠️ Recent Failures</h2>
            </div>
            <div class="card-body">
                @foreach (var log in Model.RecentFailures)
                {
                    <div class="failure-item">
                        <div class="failure-header">
                            <strong>@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</strong>
                            <span>@log.RecipientEmail</span>
                        </div>
                        <div class="failure-error">@log.ErrorMessage</div>
                    </div>
                }
            </div>
        </div>
    }

    @* Email Status *@
    <div class="config-card">
        <div class="card-header">
            <h2>📊 Email Statistics</h2>
        </div>
        <div class="card-body">
            <div class="stats-grid">
                <div class="stat-item">
                    <div class="stat-value">@Model.TotalEmailsSent</div>
                    <div class="stat-label">Total Sent</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value">@Model.EmailsToday</div>
                    <div class="stat-label">Sent Today</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value">@Model.FailedEmails</div>
                    <div class="stat-label">Failed</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value">@(Model.LastEmailSent?.ToString("g") ?? "Never")</div>
                    <div class="stat-label">Last Sent</div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.email-config-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem;
}

.config-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    margin-bottom: 2rem;
}

.card-header {
    padding: 1.5rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.card-header h2 {
    margin: 0;
    font-size: 1.25rem;
}

.card-body {
    padding: 1.5rem;
}

.card-footer {
    padding: 1.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    gap: 1rem;
}

.form-group {
    margin-bottom: 1.5rem;
}

.form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
}

.form-control {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 1rem;
    background: var(--background);
}

.form-control:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

.form-text {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: var(--muted);
}

.toggle-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
}

.toggle-checkbox {
    width: 3rem;
    height: 1.5rem;
    cursor: pointer;
}

.toggle-text {
    font-weight: 600;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
}

.stat-item {
    text-align: center;
    padding: 1rem;
    background: var(--background);
    border-radius: 8px;
}

.stat-value {
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--primary);
    margin-bottom: 0.25rem;
}

.stat-label {
    font-size: 0.875rem;
    color: var(--muted);
}

.alert {
    padding: 1rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
}

.alert-success {
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid var(--success, #10b981);
    color: var(--success, #10b981);
}

.alert-error {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid var(--danger, #ef4444);
    color: var(--danger, #ef4444);
}

/* Diagnostics */
.diagnostics-output {
    background: #f5f5f5;
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    max-height: 500px;
    overflow-y: auto;
}

.diagnostics-output pre {
    margin: 0;
    font-family: 'Courier New', monospace;
    font-size: 0.875rem;
    white-space: pre-wrap;
    word-wrap: break-word;
}

/* Logs Table */
.logs-table {
    width: 100%;
    border-collapse: collapse;
}

.logs-table th,
.logs-table td {
    padding: 0.75rem;
    text-align: left;
    border-bottom: 1px solid #e5e7eb;
}

.logs-table th {
    background: var(--background);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--muted);
}

.log-success {
    background: rgba(16, 185, 129, 0.05);
}

.log-failure {
    background: rgba(239, 68, 68, 0.05);
}

.status-badge {
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.875rem;
    font-weight: 500;
}

.status-success {
    background: rgba(16, 185, 129, 0.2);
    color: #059669;
}

.status-failure {
    background: rgba(239, 68, 68, 0.2);
    color: #dc2626;
}

/* Failures */
.failure-item {
    padding: 1rem;
    background: rgba(239, 68, 68, 0.1);
    border-left: 4px solid #dc2626;
    border-radius: 4px;
    margin-bottom: 0.5rem;
}

.failure-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
}

.failure-error {
    color: #dc2626;
    font-weight: 500;
}

/* Empty State */
.empty-state {
    text-align: center;
    padding: 2rem;
    color: var(--muted);
    font-style: italic;
}

/* Header Actions */
.header-actions {
    display: flex;
    gap: 0.5rem;
}

.btn-sm {
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
}
</style>
