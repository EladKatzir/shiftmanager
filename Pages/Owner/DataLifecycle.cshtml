@page
@model ShiftManager.Pages.Owner.DataLifecycleModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@using ShiftManager.Services
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = "Data Lifecycle";
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Owner_AdminPanel"], Url = "/Owner/Index" },
    new BreadcrumbItem { Label = "Data Lifecycle", IsActive = true }
})

@* Owner Company Selector *@
@await Component.InvokeAsync("OwnerCompanySelector")

<div class="data-lifecycle-container">
    <div class="page-header">
        <h1>
            <span class="page-icon">📦</span>
            Data Lifecycle Management
        </h1>
        <p class="page-subtitle">Archive, Purge, and Re-Import historical data</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Success))
    {
        <div class="alert alert-success">
            <strong>✅ Success:</strong> @Model.Success
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger">
            <strong>❌ Error:</strong> @Model.Error
        </div>
    }

    @* Latest Archive Info *@
    @if (Model.LatestArchiveMetadata != null)
    {
        <div class="info-banner">
            <div class="info-icon">ℹ️</div>
            <div class="info-content">
                <strong>Latest Archive:</strong> Created @Model.LatestArchiveMetadata.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss"),
                cutoff date: @Model.LatestArchiveMetadata.CutoffDate.ToString("yyyy-MM-dd"),
                @Model.LatestArchiveMetadata.RowCounts.Values.Sum() total records
            </div>
        </div>
    }

    @* Bootstrap Nav Tabs *@
    <ul class="nav nav-tabs" id="dataLifecycleTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Model.ActiveTab == "archive" ? "active" : "")"
                    id="archive-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#archive"
                    type="button"
                    role="tab"
                    aria-controls="archive"
                    aria-selected="@(Model.ActiveTab == "archive" ? "true" : "false")">
                📥 Create Archive
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Model.ActiveTab == "purge" ? "active" : "")"
                    id="purge-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#purge"
                    type="button"
                    role="tab"
                    aria-controls="purge"
                    aria-selected="@(Model.ActiveTab == "purge" ? "true" : "false")">
                🗑️ Purge Data
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Model.ActiveTab == "import" ? "active" : "")"
                    id="import-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#import"
                    type="button"
                    role="tab"
                    aria-controls="import"
                    aria-selected="@(Model.ActiveTab == "import" ? "true" : "false")">
                📤 Re-Import Archive
            </button>
        </li>
    </ul>

    <div class="tab-content" id="dataLifecycleTabContent">
        @* Tab 1: Create Archive *@
        <div class="tab-pane fade @(Model.ActiveTab == "archive" ? "show active" : "")"
             id="archive"
             role="tabpanel"
             aria-labelledby="archive-tab">

            <div class="tab-panel-content">
                <h2>📥 Create Archive</h2>
                <p>Export historical data in two formats: CSV (human-readable) and NDJSON (re-importable).</p>

                <form method="post" asp-page-handler="Preview">
                    <div class="form-section">
                        <div class="form-group">
                            <label asp-for="ArchiveCutoffDate">Cutoff Date (export data BEFORE this date)</label>
                            <input type="date" asp-for="ArchiveCutoffDate" class="form-control" />
                            <small class="form-text">Only records before this date will be archived</small>
                        </div>

                        <div class="form-group">
                            <label>Data Types to Archive</label>
                            <div class="checkbox-group">
                                <label class="checkbox-label">
                                    <input type="checkbox" asp-for="IncludeShifts" />
                                    Shifts (ShiftInstance + ShiftAssignment)
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" asp-for="IncludeSwapRequests" />
                                    Swap Requests
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" asp-for="IncludeTimeOff" />
                                    Time Off Requests
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" asp-for="IncludeChores" />
                                    Chores
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" asp-for="IncludeOnDuty" />
                                    On Duty
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="button-group">
                        <button type="submit" class="btn btn-secondary">
                            🔍 Preview Counts
                        </button>
                    </div>
                </form>

                @if (Model.Preview != null)
                {
                    <div class="preview-section">
                        <h3>📊 Preview Results</h3>
                        <div class="stats-grid">
                            @foreach (var count in Model.Preview.Counts)
                            {
                                <div class="stat-card">
                                    <div class="stat-value">@count.Value</div>
                                    <div class="stat-label">@count.Key</div>
                                </div>
                            }
                        </div>
                        <div class="preview-summary">
                            <strong>Total Records:</strong> @Model.Preview.Counts.Values.Sum()<br />
                            <strong>Estimated Size:</strong> ~@((Model.Preview.EstimatedSizeBytes / 1024.0 / 1024.0).ToString("F2")) MB
                        </div>

                        @if (Model.Preview.Warnings.Any())
                        {
                            <div class="warnings-section">
                                <h4>⚠️ Warnings:</h4>
                                <ul>
                                    @foreach (var warning in Model.Preview.Warnings)
                                    {
                                        <li>@warning</li>
                                    }
                                </ul>
                            </div>
                        }

                        <form method="post" asp-page-handler="CreateArchive">
                            <input type="hidden" asp-for="ArchiveCutoffDate" />
                            <input type="hidden" asp-for="IncludeShifts" />
                            <input type="hidden" asp-for="IncludeSwapRequests" />
                            <input type="hidden" asp-for="IncludeTimeOff" />
                            <input type="hidden" asp-for="IncludeChores" />
                            <input type="hidden" asp-for="IncludeOnDuty" />
                            <button type="submit" class="btn btn-primary">
                                📦 Create Archive
                            </button>
                        </form>
                    </div>
                }

                @if (Model.LastArchive != null && Model.LastArchive.Success)
                {
                    <div class="download-section">
                        <h3>⬇️ Download Archives</h3>
                        <div class="download-cards">
                            <div class="download-card">
                                <div class="download-header">
                                    <span class="download-icon">📄</span>
                                    <div>
                                        <h4>CSV Export (Human-Readable)</h4>
                                        <p>Size: @((Model.LastArchive.CsvZipSizeBytes / 1024.0 / 1024.0).ToString("F2")) MB</p>
                                    </div>
                                </div>
                                <a href="?handler=DownloadCsv" class="btn btn-primary">
                                    📥 Download CSV ZIP
                                </a>
                            </div>

                            <div class="download-card">
                                <div class="download-header">
                                    <span class="download-icon">🔄</span>
                                    <div>
                                        <h4>NDJSON Export (Re-Importable)</h4>
                                        <p>Size: @((Model.LastArchive.NdjsonZipSizeBytes / 1024.0 / 1024.0).ToString("F2")) MB</p>
                                    </div>
                                </div>
                                <a href="?handler=DownloadNdjson" class="btn btn-primary">
                                    📥 Download NDJSON ZIP
                                </a>
                            </div>
                        </div>

                        <div class="hash-section">
                            <label>SHA-256 Hash (for integrity verification):</label>
                            <code class="hash-display">@Model.LastArchive.Sha256Hash</code>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Tab 2: Purge Data *@
        <div class="tab-pane fade @(Model.ActiveTab == "purge" ? "show active" : "")"
             id="purge"
             role="tabpanel"
             aria-labelledby="purge-tab">

            <div class="tab-panel-content">
                <h2>🗑️ Purge Historical Data</h2>

                @if (!Model.HasFreshArchive)
                {
                    <div class="alert alert-warning">
                        <strong>⚠️ Warning:</strong> You must create a fresh archive with the exact same cutoff date and data type selection before purging.
                        Go to the "Create Archive" tab first.
                    </div>
                }

                <div class="danger-notice">
                    <div class="danger-icon">⚠️</div>
                    <div class="danger-content">
                        <strong>DESTRUCTIVE OPERATION</strong><br />
                        This will permanently delete historical data from the database.
                        A pre-purge backup will be created automatically.
                    </div>
                </div>

                <form method="post" asp-page-handler="Purge">
                    <div class="form-section">
                        <div class="form-group">
                            <label asp-for="PurgeCutoffDate">Cutoff Date (delete data BEFORE this date)</label>
                            <input type="date" asp-for="PurgeCutoffDate" class="form-control" />
                            <small class="form-text">Only records before this date will be deleted</small>
                        </div>

                        <div class="form-group">
                            <label>Data Types to Purge</label>
                            <div class="checkbox-group">
                                <label class="checkbox-label">
                                    <input type="checkbox" asp-for="PurgeShifts" />
                                    Shifts (ShiftInstance + ShiftAssignment)
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" asp-for="PurgeSwapRequests" />
                                    Swap Requests
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" asp-for="PurgeTimeOff" />
                                    Time Off Requests (+ OFFLINE shifts)
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" asp-for="PurgeChores" />
                                    Chores
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" asp-for="PurgeOnDuty" />
                                    On Duty
                                </label>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Safety Confirmations</label>
                            <div class="checkbox-group">
                                <label class="checkbox-label">
                                    <input type="checkbox" asp-for="ArchiveConfirmed" required />
                                    <strong>I have exported/archived this data</strong> (required)
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" asp-for="RunVacuum" />
                                    Run VACUUM after purge (reclaim disk space)
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" asp-for="HardDeleteOnDuty" />
                                    <strong>Hard delete</strong> OnDuty rows (default: soft delete)
                                </label>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Typed Confirmation</label>
                            <div class="confirmation-hint">
                                Type exactly: <code>@Model.ExpectedConfirmation</code>
                            </div>
                            <input type="text" asp-for="TypedConfirmation" class="form-control" placeholder="@Model.ExpectedConfirmation" required />
                        </div>
                    </div>

                    <div class="button-group">
                        <button type="submit" class="btn btn-danger" @(!Model.HasFreshArchive ? "disabled" : "")>
                            🗑️ Purge Data
                        </button>
                    </div>
                </form>

                @if (Model.LastPurgeResult != null && Model.LastPurgeResult.Success)
                {
                    <div class="purge-results">
                        <h3>✅ Purge Results</h3>
                        <div class="stats-grid">
                            @foreach (var count in Model.LastPurgeResult.DeletedCounts)
                            {
                                <div class="stat-card">
                                    <div class="stat-value">@count.Value</div>
                                    <div class="stat-label">@count.Key Deleted</div>
                                </div>
                            }
                        </div>
                        <div class="purge-summary">
                            <strong>Total Deleted:</strong> @Model.LastPurgeResult.DeletedCounts.Values.Sum()<br />
                            <strong>DB Size Before:</strong> @((Model.LastPurgeResult.DbSizeBeforeBytes / 1024.0 / 1024.0).ToString("F2")) MB<br />
                            <strong>DB Size After:</strong> @((Model.LastPurgeResult.DbSizeAfterBytes / 1024.0 / 1024.0).ToString("F2")) MB<br />
                            <strong>Space Saved:</strong> @(((Model.LastPurgeResult.DbSizeBeforeBytes - Model.LastPurgeResult.DbSizeAfterBytes) / 1024.0 / 1024.0).ToString("F2")) MB<br />
                            <strong>Duration:</strong> @Model.LastPurgeResult.Duration.TotalSeconds.ToString("F1")s<br />
                            <strong>Backup:</strong> @System.IO.Path.GetFileName(Model.LastPurgeResult.BackupPath)
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Tab 3: Re-Import Archive *@
        <div class="tab-pane fade @(Model.ActiveTab == "import" ? "show active" : "")"
             id="import"
             role="tabpanel"
             aria-labelledby="import-tab">

            <div class="tab-panel-content">
                <h2>📤 Re-Import Archive</h2>
                <p>Upload and re-import a previously exported NDJSON archive.</p>

                <form method="post" asp-page-handler="ValidateArchive" enctype="multipart/form-data">
                    <div class="form-section">
                        <div class="form-group">
                            <label asp-for="UploadedArchive">Select Archive ZIP File</label>
                            <input type="file" asp-for="UploadedArchive" class="form-control" accept=".zip" required />
                            <small class="form-text">Upload the NDJSON ZIP file (archive_import_*.zip)</small>
                        </div>
                    </div>

                    <div class="button-group">
                        <button type="submit" class="btn btn-secondary">
                            🔍 Validate Archive
                        </button>
                    </div>
                </form>

                @if (Model.ValidationResult != null)
                {
                    <div class="validation-results">
                        <h3>📋 Validation Results</h3>

                        @if (!Model.ValidationResult.IsValid)
                        {
                            <div class="alert alert-danger">
                                <strong>❌ Validation Failed</strong>
                                <ul>
                                    @foreach (var error in Model.ValidationResult.Errors)
                                    {
                                        <li>@error</li>
                                    }
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success">
                                <strong>✅ Validation Passed</strong>
                            </div>

                            <div class="validation-info">
                                <p><strong>Company Match:</strong> @(Model.ValidationResult.CompanyMatch ? "✅ Yes" : "❌ No")</p>
                                <p><strong>Archive Company:</strong> @Model.ValidationResult.ArchiveCompanyName</p>
                                <p><strong>Current Company:</strong> @Model.ValidationResult.CurrentCompanyName</p>
                            </div>

                            @if (Model.ValidationResult.MissingUsers.Any())
                            {
                                <div class="alert alert-warning">
                                    <strong>⚠️ Missing Users (@Model.ValidationResult.MissingUsers.Count):</strong>
                                    <ul>
                                        @foreach (var email in Model.ValidationResult.MissingUsers.Take(10))
                                        {
                                            <li>@email</li>
                                        }
                                        @if (Model.ValidationResult.MissingUsers.Count > 10)
                                        {
                                            <li>... and @(Model.ValidationResult.MissingUsers.Count - 10) more</li>
                                        }
                                    </ul>
                                    <p>You can choose to skip records with missing users or cancel the import.</p>
                                </div>
                            }

                            @if (Model.ValidationResult.Warnings.Any())
                            {
                                <div class="warnings-section">
                                    <h4>⚠️ Warnings:</h4>
                                    <ul>
                                        @foreach (var warning in Model.ValidationResult.Warnings)
                                        {
                                            <li>@warning</li>
                                        }
                                    </ul>
                                </div>
                            }

                            <form method="post" asp-page-handler="Import">
                                <div class="form-section">
                                    <div class="form-group">
                                        <label>Conflict Policy</label>
                                        <select asp-for="ConflictPolicy" class="form-control">
                                            <option value="@ImportConflictPolicy.SkipDuplicates">Skip Duplicates (Recommended)</option>
                                            <option value="@ImportConflictPolicy.OverwriteExisting">Overwrite Existing</option>
                                            <option value="@ImportConflictPolicy.FailOnConflict">Fail on Conflict</option>
                                        </select>
                                    </div>

                                    @if (Model.ValidationResult.MissingUsers.Any())
                                    {
                                        <div class="form-group">
                                            <label class="checkbox-label">
                                                <input type="checkbox" asp-for="SkipMissingUsers" />
                                                Skip records with missing users
                                            </label>
                                        </div>
                                    }
                                </div>

                                <div class="button-group">
                                    <button type="submit" class="btn btn-primary">
                                        📤 Import Data
                                    </button>
                                </div>
                            </form>
                        }
                    </div>
                }

                @if (Model.LastImportResult != null)
                {
                    <div class="import-results">
                        <h3>@(Model.LastImportResult.Success ? "✅" : "❌") Import Results</h3>

                        @if (!Model.LastImportResult.Success)
                        {
                            <div class="alert alert-danger">
                                <strong>Error:</strong> @Model.LastImportResult.Error
                            </div>
                        }
                        else
                        {
                            <div class="stats-grid">
                                @foreach (var stat in Model.LastImportResult.Stats)
                                {
                                    <div class="stat-card">
                                        <div class="stat-header">@stat.Key</div>
                                        <div class="stat-breakdown">
                                            <span class="stat-inserted">✅ @stat.Value.Inserted inserted</span>
                                            <span class="stat-skipped">⏭️ @stat.Value.Skipped skipped</span>
                                            <span class="stat-failed">❌ @stat.Value.Failed failed</span>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="import-summary">
                                <strong>Total Inserted:</strong> @Model.LastImportResult.Stats.Values.Sum(s => s.Inserted)<br />
                                <strong>Total Skipped:</strong> @Model.LastImportResult.Stats.Values.Sum(s => s.Skipped)<br />
                                <strong>Total Failed:</strong> @Model.LastImportResult.Stats.Values.Sum(s => s.Failed)<br />
                                <strong>Duration:</strong> @Model.LastImportResult.Duration.TotalSeconds.ToString("F1")s
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
.data-lifecycle-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
}

.page-header {
    margin-bottom: 30px;
}

.page-icon {
    font-size: 2em;
    margin-right: 10px;
}

.page-subtitle {
    color: #666;
    margin-top: 5px;
}

.info-banner {
    display: flex;
    align-items: center;
    background: #e3f2fd;
    border-left: 4px solid #2196f3;
    padding: 15px;
    margin-bottom: 20px;
    border-radius: 4px;
}

.info-icon {
    font-size: 24px;
    margin-right: 15px;
}

.danger-notice {
    display: flex;
    align-items: center;
    background: #fff3cd;
    border-left: 4px solid #ff9800;
    padding: 15px;
    margin-bottom: 20px;
    border-radius: 4px;
}

.danger-icon {
    font-size: 32px;
    margin-right: 15px;
}

.nav-tabs {
    border-bottom: 2px solid #dee2e6;
    margin-bottom: 0;
}

.nav-tabs .nav-link {
    color: #495057;
    font-weight: 500;
    padding: 12px 24px;
}

.nav-tabs .nav-link.active {
    color: #2196f3;
    border-color: #dee2e6 #dee2e6 #fff;
    border-bottom: 2px solid #2196f3;
}

.tab-panel-content {
    padding: 30px;
    background: #fff;
    border: 1px solid #dee2e6;
    border-top: none;
    border-radius: 0 0 4px 4px;
}

.form-section {
    margin-bottom: 25px;
}

.checkbox-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.checkbox-label {
    display: flex;
    align-items: center;
    gap: 8px;
}

.button-group {
    margin-top: 20px;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 15px;
    margin: 20px 0;
}

.stat-card {
    background: #f8f9fa;
    padding: 20px;
    border-radius: 8px;
    text-align: center;
}

.stat-value {
    font-size: 2em;
    font-weight: bold;
    color: #2196f3;
}

.stat-label {
    font-size: 0.9em;
    color: #666;
    margin-top: 5px;
}

.preview-section, .purge-results, .import-results, .download-section, .validation-results {
    margin-top: 30px;
    padding: 20px;
    background: #f8f9fa;
    border-radius: 8px;
}

.download-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin: 20px 0;
}

.download-card {
    background: #fff;
    padding: 20px;
    border: 1px solid #dee2e6;
    border-radius: 8px;
}

.download-header {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 15px;
}

.download-icon {
    font-size: 2em;
}

.hash-section {
    margin-top: 20px;
}

.hash-display {
    display: block;
    background: #fff;
    padding: 10px;
    border: 1px solid #dee2e6;
    border-radius: 4px;
    font-family: monospace;
    font-size: 0.9em;
    word-break: break-all;
    margin-top: 5px;
}

.confirmation-hint {
    background: #fff3cd;
    padding: 10px;
    border-radius: 4px;
    margin-bottom: 10px;
}

.stat-breakdown {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin-top: 10px;
    font-size: 0.9em;
}

.stat-header {
    font-weight: bold;
    color: #333;
}

.validation-info {
    background: #fff;
    padding: 15px;
    border-radius: 4px;
    margin: 15px 0;
}
</style>

<script>
// Persist active tab across postbacks
document.addEventListener('DOMContentLoaded', function() {
    var activeTab = '@Model.ActiveTab';
    if (activeTab) {
        var tabEl = document.getElementById(activeTab + '-tab');
        if (tabEl) {
            var tab = new bootstrap.Tab(tabEl);
            tab.show();
        }
    }
});
</script>
