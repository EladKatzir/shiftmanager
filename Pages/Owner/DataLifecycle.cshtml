@page
@model ShiftManager.Pages.Owner.DataLifecycleModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@using ShiftManager.Services
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["Owner_DataLifecycle"];
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Owner_AdminPanel"], Url = "/Owner/Index" },
    new BreadcrumbItem { Label = Localizer["Owner_DataLifecycle"], IsActive = true }
})

@* Owner Company Selector *@
@await Component.InvokeAsync("OwnerCompanySelector")

<div class="data-lifecycle-container">
    <div class="page-header">
        <h1>
            <span class="page-icon"><icon name="folder" /></span>
            <loc key="Owner_DataLifecycle" />
        </h1>
        <p class="page-subtitle"><loc key="Owner_DataLifecycle_Subtitle" /></p>
    </div>

    @* Inline alerts removed - feedback now flows through the unified _Layout.cshtml bridge *@

    @* Latest Archive Info *@
    @if (Model.LatestArchiveMetadata != null)
    {
        <div class="info-banner">
            <div class="info-icon">ℹ️</div>
            <div class="info-content">
                <strong>@Localizer["Owner_DataLifecycle_LatestArchive"]:</strong> @Localizer["Owner_DataLifecycle_LatestArchive_Created"] @Model.LatestArchiveMetadata.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss"),
                @Localizer["Owner_DataLifecycle_LatestArchive_CutoffDate"]: @Model.LatestArchiveMetadata.CutoffDate.ToString("yyyy-MM-dd"),
                @Model.LatestArchiveMetadata.RowCounts.Values.Sum() @Localizer["Owner_DataLifecycle_LatestArchive_TotalRecords"]
            </div>
        </div>
    }

    @* Bootstrap Nav Tabs *@
    <ul class="nav nav-tabs" id="dataLifecycleTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Model.ActiveTab == "archive" ? "active" : "")"
                    id="archive-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#archive"
                    type="button"
                    role="tab"
                    aria-controls="archive"
                    aria-selected="@(Model.ActiveTab == "archive" ? "true" : "false")">
                <icon name="download" /> <loc key="Owner_DataLifecycle_CreateArchive" />
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Model.ActiveTab == "purge" ? "active" : "")"
                    id="purge-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#purge"
                    type="button"
                    role="tab"
                    aria-controls="purge"
                    aria-selected="@(Model.ActiveTab == "purge" ? "true" : "false")">
                <icon name="trash-2" /> <loc key="Owner_DataLifecycle_PurgeData" />
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Model.ActiveTab == "import" ? "active" : "")"
                    id="import-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#import"
                    type="button"
                    role="tab"
                    aria-controls="import"
                    aria-selected="@(Model.ActiveTab == "import" ? "true" : "false")">
                <icon name="upload" /> <loc key="Owner_DataLifecycle_ReImport" />
            </button>
        </li>
    </ul>

    <div class="tab-content" id="dataLifecycleTabContent">
        @* Tab 1: Create Archive *@
        <div class="tab-pane fade @(Model.ActiveTab == "archive" ? "show active" : "")"
             id="archive"
             role="tabpanel"
             aria-labelledby="archive-tab">

            <div class="tab-panel-content">
                <h2><icon name="download" /> <loc key="Owner_DataLifecycle_CreateArchive" /></h2>
                <p><loc key="Owner_DataLifecycle_CreateArchive_Desc" /></p>

                <form method="post" asp-page-handler="Preview">
                    <div class="form-section">
                        <div class="form-group">
                            <label asp-for="ArchiveCutoffDate"><loc key="Owner_DataLifecycle_CutoffDate" /></label>
                            <input type="date" asp-for="ArchiveCutoffDate" class="form-control" />
                            <small class="form-text"><loc key="Owner_DataLifecycle_CutoffDate_Help" /></small>
                        </div>

                        <div class="form-group">
                            <label><loc key="Owner_DataLifecycle_DataTypes" /></label>
                            <div class="checkbox-group">
                                <label class="checkbox-label">
                                    <input type="checkbox" asp-for="IncludeShifts" />
                                    <loc key="Owner_DataLifecycle_Shifts" />
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" asp-for="IncludeSwapRequests" />
                                    <loc key="Owner_DataLifecycle_SwapRequests" />
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" asp-for="IncludeTimeOff" />
                                    <loc key="Owner_DataLifecycle_TimeOff" />
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" asp-for="IncludeChores" />
                                    <loc key="Owner_DataLifecycle_Chores" />
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" asp-for="IncludeOnDuty" />
                                    <loc key="Owner_DataLifecycle_OnDuty" />
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="button-group">
                        <button type="submit" class="btn btn-secondary">
                            <icon name="search" /> <loc key="Owner_DataLifecycle_PreviewCounts" />
                        </button>
                    </div>
                </form>

                @if (Model.Preview != null)
                {
                    <div class="preview-section">
                        <h3><icon name="bar-chart-2" /> <loc key="Owner_DataLifecycle_PreviewResults" /></h3>
                        <div class="stats-grid">
                            @foreach (var count in Model.Preview.Counts)
                            {
                                <div class="stat-card">
                                    <div class="stat-value">@count.Value</div>
                                    <div class="stat-label">@count.Key</div>
                                </div>
                            }
                        </div>
                        <div class="preview-summary">
                            <strong><loc key="Owner_DataLifecycle_TotalRecords" />:</strong> @Model.Preview.Counts.Values.Sum()<br />
                            <strong><loc key="Owner_DataLifecycle_EstimatedSize" />:</strong> ~@((Model.Preview.EstimatedSizeBytes / 1024.0 / 1024.0).ToString("F2")) MB
                        </div>

                        @if (Model.Preview.Warnings.Any())
                        {
                            <div class="warnings-section">
                                <h4><icon name="alert-triangle" /> <loc key="Owner_DataLifecycle_Warnings" />:</h4>
                                <ul>
                                    @foreach (var warning in Model.Preview.Warnings)
                                    {
                                        <li>@warning</li>
                                    }
                                </ul>
                            </div>
                        }

                        <form method="post" asp-page-handler="CreateArchive">
                            <input type="hidden" asp-for="ArchiveCutoffDate" />
                            <input type="hidden" asp-for="IncludeShifts" />
                            <input type="hidden" asp-for="IncludeSwapRequests" />
                            <input type="hidden" asp-for="IncludeTimeOff" />
                            <input type="hidden" asp-for="IncludeChores" />
                            <input type="hidden" asp-for="IncludeOnDuty" />
                            <button type="submit" class="btn btn-primary">
                                <icon name="folder" /> <loc key="Owner_DataLifecycle_CreateArchive" />
                            </button>
                        </form>
                    </div>
                }

                @if (Model.LastArchive != null && Model.LastArchive.Success)
                {
                    <div class="download-section">
                        <h3><icon name="download" /> <loc key="Owner_DataLifecycle_DownloadArchives" /></h3>
                        <div class="download-cards">
                            <div class="download-card">
                                <div class="download-header">
                                    <span class="download-icon"><icon name="file-text" /></span>
                                    <div>
                                        <h4><loc key="Owner_DataLifecycle_CsvExport" /></h4>
                                        <p><loc key="Owner_DataLifecycle_Size" />: @((Model.LastArchive.CsvZipSizeBytes / 1024.0 / 1024.0).ToString("F2")) MB</p>
                                    </div>
                                </div>
                                <a href="?handler=DownloadCsv" class="btn btn-primary">
                                    <icon name="download" /> <loc key="Owner_DataLifecycle_DownloadCsvZip" />
                                </a>
                            </div>

                            <div class="download-card">
                                <div class="download-header">
                                    <span class="download-icon"><icon name="refresh-cw" /></span>
                                    <div>
                                        <h4><loc key="Owner_DataLifecycle_NdjsonExport" /></h4>
                                        <p><loc key="Owner_DataLifecycle_Size" />: @((Model.LastArchive.NdjsonZipSizeBytes / 1024.0 / 1024.0).ToString("F2")) MB</p>
                                    </div>
                                </div>
                                <a href="?handler=DownloadNdjson" class="btn btn-primary">
                                    <icon name="download" /> <loc key="Owner_DataLifecycle_DownloadNdjsonZip" />
                                </a>
                            </div>
                        </div>

                        <div class="hash-section">
                            <label><loc key="Owner_DataLifecycle_Sha256Hash" />:</label>
                            <code class="hash-display">@Model.LastArchive.Sha256Hash</code>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Tab 2: Purge Data *@
        <div class="tab-pane fade @(Model.ActiveTab == "purge" ? "show active" : "")"
             id="purge"
             role="tabpanel"
             aria-labelledby="purge-tab">

            <div class="tab-panel-content">
                <h2><icon name="trash-2" /> <loc key="Owner_DataLifecycle_PurgeHistoricalData" /></h2>

                @if (!Model.HasFreshArchive)
                {
                    <div class="alert alert-warning">
                        <strong><icon name="alert-triangle" /> <loc key="Warning" />:</strong> <loc key="Owner_DataLifecycle_PurgeWarning" />
                    </div>
                }

                <div class="danger-notice">
                    <div class="danger-icon"><icon name="alert-triangle" size="xl" /></div>
                    <div class="danger-content">
                        <strong><loc key="Owner_DataLifecycle_DestructiveOperation" /></strong><br />
                        <loc key="Owner_DataLifecycle_DestructiveOperation_Desc" />
                    </div>
                </div>

                <form method="post" asp-page-handler="Purge">
                    <div class="form-section">
                        <div class="form-group">
                            <label asp-for="PurgeCutoffDate"><loc key="Owner_DataLifecycle_PurgeCutoffDate" /></label>
                            <input type="date" asp-for="PurgeCutoffDate" class="form-control" />
                            <small class="form-text"><loc key="Owner_DataLifecycle_PurgeCutoffDate_Help" /></small>
                        </div>

                        <div class="form-group">
                            <label><loc key="Owner_DataLifecycle_DataTypesToPurge" /></label>
                            <div class="checkbox-group">
                                <label class="checkbox-label">
                                    <input type="checkbox" asp-for="PurgeShifts" />
                                    <loc key="Owner_DataLifecycle_Shifts" />
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" asp-for="PurgeSwapRequests" />
                                    <loc key="Owner_DataLifecycle_SwapRequests" />
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" asp-for="PurgeTimeOff" />
                                    <loc key="Owner_DataLifecycle_TimeOffPurge" />
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" asp-for="PurgeChores" />
                                    <loc key="Owner_DataLifecycle_Chores" />
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" asp-for="PurgeOnDuty" />
                                    <loc key="Owner_DataLifecycle_OnDuty" />
                                </label>
                            </div>
                        </div>

                        <div class="form-group">
                            <label><loc key="Owner_DataLifecycle_SafetyConfirmations" /></label>
                            <div class="checkbox-group">
                                <label class="checkbox-label">
                                    <input type="checkbox" asp-for="ArchiveConfirmed" required />
                                    <strong><loc key="Owner_DataLifecycle_ArchiveConfirmed" /></strong> (<loc key="Required" />)
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" asp-for="RunVacuum" />
                                    <loc key="Owner_DataLifecycle_RunVacuum" />
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" asp-for="HardDeleteOnDuty" />
                                    <strong><loc key="Owner_DataLifecycle_HardDelete" /></strong> <loc key="Owner_DataLifecycle_HardDelete_Desc" />
                                </label>
                            </div>
                        </div>

                        <div class="form-group">
                            <label><loc key="Owner_DataLifecycle_TypedConfirmation" /></label>
                            <div class="confirmation-hint">
                                <loc key="Owner_DataLifecycle_TypeExactly" />: <code>@Model.ExpectedConfirmation</code>
                            </div>
                            <input type="text" asp-for="TypedConfirmation" class="form-control" placeholder="@Model.ExpectedConfirmation" required />
                        </div>
                    </div>

                    <div class="button-group">
                        <button type="submit" class="btn btn-danger" @(!Model.HasFreshArchive ? "disabled" : "")>
                            <icon name="trash-2" /> <loc key="Owner_DataLifecycle_PurgeData" />
                        </button>
                    </div>
                </form>

                @if (Model.LastPurgeResult != null && Model.LastPurgeResult.Success)
                {
                    <div class="purge-results">
                        <h3><icon name="check" /> <loc key="Owner_DataLifecycle_PurgeResults" /></h3>
                        <div class="stats-grid">
                            @foreach (var count in Model.LastPurgeResult.DeletedCounts)
                            {
                                <div class="stat-card">
                                    <div class="stat-value">@count.Value</div>
                                    <div class="stat-label">@count.Key <loc key="Deleted" /></div>
                                </div>
                            }
                        </div>
                        <div class="purge-summary">
                            <strong><loc key="Owner_DataLifecycle_TotalDeleted" />:</strong> @Model.LastPurgeResult.DeletedCounts.Values.Sum()<br />
                            <strong><loc key="Owner_DataLifecycle_DbSizeBefore" />:</strong> @((Model.LastPurgeResult.DbSizeBeforeBytes / 1024.0 / 1024.0).ToString("F2")) MB<br />
                            <strong><loc key="Owner_DataLifecycle_DbSizeAfter" />:</strong> @((Model.LastPurgeResult.DbSizeAfterBytes / 1024.0 / 1024.0).ToString("F2")) MB<br />
                            <strong><loc key="Owner_DataLifecycle_SpaceSaved" />:</strong> @(((Model.LastPurgeResult.DbSizeBeforeBytes - Model.LastPurgeResult.DbSizeAfterBytes) / 1024.0 / 1024.0).ToString("F2")) MB<br />
                            <strong><loc key="Duration" />:</strong> @Model.LastPurgeResult.Duration.TotalSeconds.ToString("F1")s<br />
                            <strong><loc key="Owner_Backup" />:</strong> @System.IO.Path.GetFileName(Model.LastPurgeResult.BackupPath)
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Tab 3: Re-Import Archive *@
        <div class="tab-pane fade @(Model.ActiveTab == "import" ? "show active" : "")"
             id="import"
             role="tabpanel"
             aria-labelledby="import-tab">

            <div class="tab-panel-content">
                <h2><icon name="upload" /> <loc key="Owner_DataLifecycle_ReImport" /></h2>
                <p><loc key="Owner_DataLifecycle_ReImport_Desc" /></p>

                <form method="post" asp-page-handler="ValidateArchive" enctype="multipart/form-data">
                    <div class="form-section">
                        <div class="form-group">
                            <label asp-for="UploadedArchive"><loc key="Owner_DataLifecycle_SelectArchive" /></label>
                            <input type="file" asp-for="UploadedArchive" class="form-control" accept=".zip" required />
                            <small class="form-text"><loc key="Owner_DataLifecycle_SelectArchive_Help" /></small>
                        </div>
                    </div>

                    <div class="button-group">
                        <button type="submit" class="btn btn-secondary">
                            <icon name="search" /> <loc key="Owner_DataLifecycle_ValidateArchive" />
                        </button>
                    </div>
                </form>

                @if (Model.ValidationResult != null)
                {
                    <div class="validation-results">
                        <h3><icon name="file-text" /> <loc key="Owner_DataLifecycle_ValidationResults" /></h3>

                        @if (!Model.ValidationResult.IsValid)
                        {
                            <div class="alert alert-danger">
                                <strong><icon name="x" /> <loc key="Owner_DataLifecycle_ValidationFailed" /></strong>
                                <ul>
                                    @foreach (var error in Model.ValidationResult.Errors)
                                    {
                                        <li>@error</li>
                                    }
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success">
                                <strong><icon name="check" /> <loc key="Owner_DataLifecycle_ValidationPassed" /></strong>
                            </div>

                            <div class="validation-info">
                                <p><strong><loc key="Owner_DataLifecycle_CompanyMatch" />:</strong> @(Model.ValidationResult.CompanyMatch ? "✅ " + Localizer["Yes"] : "❌ " + Localizer["No"])</p>
                                <p><strong><loc key="Owner_DataLifecycle_ArchiveCompany" />:</strong> @Model.ValidationResult.ArchiveCompanyName</p>
                                <p><strong><loc key="Owner_DataLifecycle_CurrentCompany" />:</strong> @Model.ValidationResult.CurrentCompanyName</p>
                            </div>

                            @if (Model.ValidationResult.MissingUsers.Any())
                            {
                                <div class="alert alert-warning">
                                    <strong><icon name="alert-triangle" /> <loc key="Owner_DataLifecycle_MissingUsers" /> (@Model.ValidationResult.MissingUsers.Count):</strong>
                                    <ul>
                                        @foreach (var email in Model.ValidationResult.MissingUsers.Take(10))
                                        {
                                            <li>@email</li>
                                        }
                                        @if (Model.ValidationResult.MissingUsers.Count > 10)
                                        {
                                            <li>... <loc key="And" /> @(Model.ValidationResult.MissingUsers.Count - 10) <loc key="More" /></li>
                                        }
                                    </ul>
                                    <p><loc key="Owner_DataLifecycle_MissingUsers_Help" /></p>
                                </div>
                            }

                            @if (Model.ValidationResult.Warnings.Any())
                            {
                                <div class="warnings-section">
                                    <h4><icon name="alert-triangle" /> <loc key="Owner_DataLifecycle_Warnings" />:</h4>
                                    <ul>
                                        @foreach (var warning in Model.ValidationResult.Warnings)
                                        {
                                            <li>@warning</li>
                                        }
                                    </ul>
                                </div>
                            }

                            <form method="post" asp-page-handler="Import">
                                <div class="form-section">
                                    <div class="form-group">
                                        <label><loc key="Owner_DataLifecycle_ConflictPolicy" /></label>
                                        <select asp-for="ConflictPolicy" class="form-control">
                                            <option value="@ImportConflictPolicy.SkipDuplicates">@Localizer["Owner_DataLifecycle_SkipDuplicates"]</option>
                                            <option value="@ImportConflictPolicy.OverwriteExisting">@Localizer["Owner_DataLifecycle_OverwriteExisting"]</option>
                                            <option value="@ImportConflictPolicy.FailOnConflict">@Localizer["Owner_DataLifecycle_FailOnConflict"]</option>
                                        </select>
                                    </div>

                                    @if (Model.ValidationResult.MissingUsers.Any())
                                    {
                                        <div class="form-group">
                                            <label class="checkbox-label">
                                                <input type="checkbox" asp-for="SkipMissingUsers" />
                                                <loc key="Owner_DataLifecycle_SkipMissingUsers" />
                                            </label>
                                        </div>
                                    }
                                </div>

                                <div class="button-group">
                                    <button type="submit" class="btn btn-primary">
                                        <icon name="upload" /> <loc key="Owner_DataLifecycle_ImportData" />
                                    </button>
                                </div>
                            </form>
                        }
                    </div>
                }

                @if (Model.LastImportResult != null)
                {
                    <div class="import-results">
                        <h3>@(Model.LastImportResult.Success ? "✅" : "❌") <loc key="Owner_DataLifecycle_ImportResults" /></h3>

                        @if (!Model.LastImportResult.Success)
                        {
                            <div class="alert alert-danger">
                                <strong><loc key="Error" />:</strong> @Model.LastImportResult.Error
                            </div>
                        }
                        else
                        {
                            <div class="stats-grid">
                                @foreach (var stat in Model.LastImportResult.Stats)
                                {
                                    <div class="stat-card">
                                        <div class="stat-header">@stat.Key</div>
                                        <div class="stat-breakdown">
                                            <span class="stat-inserted"><icon name="check" /> @stat.Value.Inserted <loc key="Inserted" /></span>
                                            <span class="stat-skipped"><icon name="chevron-right" /> @stat.Value.Skipped <loc key="Skipped" /></span>
                                            <span class="stat-failed"><icon name="x" /> @stat.Value.Failed <loc key="Failed" /></span>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="import-summary">
                                <strong><loc key="Owner_DataLifecycle_TotalInserted" />:</strong> @Model.LastImportResult.Stats.Values.Sum(s => s.Inserted)<br />
                                <strong><loc key="Owner_DataLifecycle_TotalSkipped" />:</strong> @Model.LastImportResult.Stats.Values.Sum(s => s.Skipped)<br />
                                <strong><loc key="Owner_DataLifecycle_TotalFailed" />:</strong> @Model.LastImportResult.Stats.Values.Sum(s => s.Failed)<br />
                                <strong><loc key="Duration" />:</strong> @Model.LastImportResult.Duration.TotalSeconds.ToString("F1")s
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
.data-lifecycle-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
}

.page-header {
    margin-bottom: 30px;
}

.page-icon {
    font-size: 2em;
    margin-right: 10px;
}

.page-subtitle {
    color: var(--text-muted);
    margin-top: 5px;
}

.info-banner {
    display: flex;
    align-items: center;
    background: var(--info-soft);
    border-left: 4px solid var(--info);
    padding: 15px;
    margin-bottom: 20px;
    border-radius: 4px;
}

.info-icon {
    font-size: 24px;
    margin-right: 15px;
}

.danger-notice {
    display: flex;
    align-items: center;
    background: var(--warning-soft);
    border-left: 4px solid var(--warning);
    padding: 15px;
    margin-bottom: 20px;
    border-radius: 4px;
}

.danger-icon {
    font-size: 32px;
    margin-right: 15px;
}

.nav-tabs {
    border-bottom: 2px solid var(--border);
    margin-bottom: 0;
}

.nav-tabs .nav-link {
    color: var(--text);
    font-weight: 500;
    padding: 12px 24px;
}

.nav-tabs .nav-link.active {
    color: var(--primary);
    border-color: var(--border) var(--border) var(--surface);
    border-bottom: 2px solid var(--primary);
}

.tab-panel-content {
    padding: 30px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: none;
    border-radius: 0 0 4px 4px;
}

.form-section {
    margin-bottom: 25px;
}

.checkbox-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.checkbox-label {
    display: flex;
    align-items: center;
    gap: 8px;
}

.button-group {
    margin-top: 20px;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 15px;
    margin: 20px 0;
}

.stat-card {
    background: var(--surface-soft);
    padding: 20px;
    border-radius: 8px;
    text-align: center;
}

.stat-value {
    font-size: 2em;
    font-weight: bold;
    color: var(--primary);
}

.stat-label {
    font-size: 0.9em;
    color: var(--text-muted);
    margin-top: 5px;
}

.preview-section, .purge-results, .import-results, .download-section, .validation-results {
    margin-top: 30px;
    padding: 20px;
    background: var(--surface-soft);
    border-radius: 8px;
}

.download-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin: 20px 0;
}

.download-card {
    background: var(--surface);
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 8px;
}

.download-header {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 15px;
}

.download-icon {
    font-size: 2em;
}

.hash-section {
    margin-top: 20px;
}

.hash-display {
    display: block;
    background: var(--surface);
    padding: 10px;
    border: 1px solid var(--border);
    border-radius: 4px;
    font-family: monospace;
    font-size: 0.9em;
    word-break: break-all;
    margin-top: 5px;
}

.confirmation-hint {
    background: var(--warning-soft);
    padding: 10px;
    border-radius: 4px;
    margin-bottom: 10px;
}

.stat-breakdown {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin-top: 10px;
    font-size: 0.9em;
}

.stat-header {
    font-weight: bold;
    color: var(--text);
}

.validation-info {
    background: var(--surface);
    padding: 15px;
    border-radius: 4px;
    margin: 15px 0;
}
</style>

<script>
// Tab switching without Bootstrap JS
document.addEventListener('DOMContentLoaded', function() {
    var tabs = document.querySelectorAll('#dataLifecycleTabs .nav-link');
    tabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
            // Deactivate all tabs and panes
            tabs.forEach(function(t) {
                t.classList.remove('active');
                t.setAttribute('aria-selected', 'false');
            });
            document.querySelectorAll('#dataLifecycleTabContent .tab-pane').forEach(function(p) {
                p.classList.remove('show', 'active');
            });
            // Activate clicked tab and target pane
            this.classList.add('active');
            this.setAttribute('aria-selected', 'true');
            var target = document.querySelector(this.dataset.bsTarget);
            if (target) target.classList.add('show', 'active');
        });
    });

    // Persist active tab across postbacks
    var activeTab = '@Model.ActiveTab';
    if (activeTab) {
        var tabEl = document.getElementById(activeTab + '-tab');
        if (tabEl) tabEl.click();
    }
});
</script>
