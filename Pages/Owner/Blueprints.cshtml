@page
@model ShiftManager.Pages.Owner.BlueprintsModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@inject ShiftManager.Services.ILocalizationService Localization
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["Blueprints_Title"];
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Owner_AdminPanel"], Url = "/Owner/Index" },
    new BreadcrumbItem { Label = Localizer["Section_Blueprints"], IsActive = true }
})

<div style="margin-bottom: 1rem; display: flex; gap: 0.5rem;">
    <a href="/Owner/Programs" class="btn btn-sm btn-secondary">
        <loc key="Nav_ShiftPlans" />
    </a>
    <a href="/Owner/MasterPrograms" class="btn btn-sm btn-secondary">
        <loc key="Nav_MasterPrograms" />
    </a>
</div>

@* Owner Company Selector *@
@await Component.InvokeAsync("OwnerCompanySelector")

@* Molecule Selector *@
@if (Model.AvailableMolecules.Any())
{
    <div class="card" style="margin-bottom: 1rem; padding: 0.75rem;">
        <form method="get" style="display: flex; align-items: center; gap: 0.75rem;">
            <label for="SelectedMoleculeId" style="white-space: nowrap; font-weight: 600;">
                <loc key="Molecule">Molecule</loc>:
            </label>
            <select name="SelectedMoleculeId" id="SelectedMoleculeId" class="form-control" style="max-width: 250px;"
                    onchange="this.form.submit()">
                @foreach (var mol in Model.AvailableMolecules)
                {
                    <option value="@mol.Id" selected="@(Model.SelectedMoleculeId == mol.Id)">@mol.DisplayName</option>
                }
            </select>
        </form>
    </div>
}

<div class="feature-flags-container">
    <div class="page-header">
        <h1>
            <span class="page-icon"><icon name="file-text" /></span>
            <loc key="Blueprints_Title">Shift Blueprints</loc>
        </h1>
        <p class="page-subtitle"><loc key="Blueprints_Subtitle">Manage shift type definitions with bilingual names</loc></p>
    </div>

    @* Inline alerts removed - feedback now flows through the unified _Layout.cshtml bridge *@

    @* MIGRATION HELPER: Populate NameKeys (one-time after OpsConsoleScheduler migration) *@
    @if (Model.MissingNameKeyShifts.Any())
    {
        <div class="alert alert-warning namekey-banner" id="missingNameKeyBanner" data-banner="namekeys">
            <button type="button" class="namekey-banner__dismiss" onclick="dismissNameKeyBanner()"
                    title="@Localizer["Blueprints_Dismiss"]" aria-label="@Localizer["Blueprints_Dismiss"]">&times;</button>
            <strong>@Localizer["Blueprints_MigrationRequired"]</strong>
            @Localizer["Blueprints_MigrationDesc"]
            <div class="namekey-banner__list">
                <span class="namekey-banner__list-label">@Localizer["Blueprints_MissingNameKeysLabel"]</span>
                <ul>
                    @foreach (var st in Model.MissingNameKeyShifts)
                    {
                        <li><code>@st.Key</code></li>
                    }
                </ul>
            </div>
            <button type="button" class="btn btn-sm btn-warning" onclick="openAddNameKeysModal()" style="margin-top: 8px;">
                <icon name="settings" /> <loc key="Blueprints_PopulateNameKeys" />
            </button>
        </div>
    }

    @* Create New ShiftType Section *@
    <div class="feature-category">
        <h2><icon name="plus" /> <loc key="Blueprints_CreateNew">Create New Shift Type</loc></h2>
        <form method="post" asp-page-handler="CreateShiftType">
            <div class="form-group-grid" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
                <div class="form-group">
                    <label asp-for="NewShiftNameEn"><loc key="Label_EnglishName">English Name</loc></label>
                    <input type="text" asp-for="NewShiftNameEn" class="form-control"
                           placeholder="@Localizer["Blueprints_EnglishNamePlaceholder"]" required />
                </div>

                <div class="form-group">
                    <label asp-for="NewShiftNameHe"><loc key="Label_HebrewName">Hebrew Name</loc></label>
                    <input type="text" asp-for="NewShiftNameHe" class="form-control"
                           placeholder="@Localizer["Blueprints_HebrewNamePlaceholder"]" required dir="rtl" />
                </div>

                <div class="form-group">
                    <label asp-for="NewShiftStart"><loc key="Label_StartTime">Start Time</loc></label>
                    <input type="time" asp-for="NewShiftStart" class="form-control" required />
                </div>

                <div class="form-group">
                    <label asp-for="NewShiftEnd"><loc key="Label_EndTime">End Time</loc></label>
                    <input type="time" asp-for="NewShiftEnd" class="form-control" required />
                </div>

                <div class="form-group">
                    <label asp-for="NewShiftScope"><loc key="Blueprints_Scope">Scope</loc></label>
                    <select asp-for="NewShiftScope" class="form-control" id="scopeSelector">
                        @if (Model.CanCreateMoleculeScope)
                        {
                            <option value="1">🟢 @Localizer["ShiftScope_Molecule"]</option>
                        }
                        <option value="0">🔵 @Localizer["ShiftScope_Company"]</option>
                        @if (Model.CanCreateAreaScope)
                        {
                            <option value="2">🟠 @Localizer["ShiftScope_Area"]</option>
                        }
                    </select>
                </div>

                @if (Model.AvailableMolecules.Any())
                {
                    <div class="form-group">
                        <label asp-for="NewShiftMoleculeId"><loc key="Molecule">Molecule</loc></label>
                        <select asp-for="NewShiftMoleculeId" class="form-control">
                            @foreach (var mol in Model.AvailableMolecules)
                            {
                                <option value="@mol.Id" selected="@(Model.SelectedMoleculeId == mol.Id)">@mol.DisplayName</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label asp-for="NewShiftJobTypeId"><loc key="JobType">Job Type</loc></label>
                        <select asp-for="NewShiftJobTypeId" class="form-control">
                            <option value=""><loc key="Blueprints_NoJobType">No Job Type</loc></option>
                            @foreach (var jt in Model.AvailableJobTypes)
                            {
                                <option value="@jt.Id">@jt.DisplayName</option>
                            }
                        </select>
                    </div>

                    <div class="form-group" id="companySelector" style="display: none;">
                        <label asp-for="NewShiftCompanyId"><loc key="Company">Company</loc></label>
                        <select asp-for="NewShiftCompanyId" class="form-control" id="companyDropdown">
                            <option value=""><loc key="Blueprints_SelectCompany">Select Company</loc></option>
                        </select>
                    </div>
                }
            </div>

            <button type="submit" class="btn btn-primary">
                <icon name="plus" /> <loc key="Button_CreateShiftType">Create Shift Type</loc>
            </button>
        </form>
    </div>

    @* Existing ShiftTypes Table *@
    <div class="feature-category">
        <h2><icon name="file-text" /> <loc key="Blueprints_ExistingTypes">Existing Shift Types</loc></h2>

        @if (Model.ShiftTypes.Count == 0)
        {
            <div class="alert alert-info">
                <loc key="Blueprints_NoShiftTypes" />
            </div>
        }
        else
        {
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th><loc key="ShiftType" /></th>
                        <th><loc key="Blueprints_EnglishName" /></th>
                        <th><loc key="Blueprints_HebrewName" /></th>
                        <th><loc key="Blueprints_TimeRange" /></th>
                        <th><loc key="Type" /></th>
                        <th><loc key="Blueprints_Scope" /></th>
                        <th><loc key="Blueprints_Category" /></th>
                        <th><loc key="Blueprints_ShiftRules" /></th>
                        <th><loc key="Actions" /></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var shiftType in Model.ShiftTypes)
                    {
                        <tr data-shift-id="@shiftType.Id">
                            <td>
                                <strong>@shiftType.Key</strong>
                                @if (shiftType.IsOffline)
                                {
                                    <span class="badge badge-secondary"><loc key="Offline" /></span>
                                }
                                @* 3b: nudge admins to categorize assignable shift types so the user-picker can filter them. *@
                                @if (shiftType.CategoryId == null && shiftType.JobTypeId != null
                                     && !shiftType.IsOffline && shiftType.Key != "HOME")
                                {
                                    <span class="badge badge-warning"
                                          title="@Localizer["Admin_ShiftType_NoCategory_Tooltip"]">
                                        <loc key="Admin_ShiftType_NoCategory_Badge" />
                                    </span>
                                }
                            </td>
                            <td>
                                @if (shiftType.Scope == ShiftManager.Models.Support.ShiftScope.Company && !string.IsNullOrWhiteSpace(shiftType.NameKey))
                                {
                                    <span class="editable-name"
                                          data-shift-id="@shiftType.Id"
                                          data-lang="en">
                                        <loc key="@shiftType.NameKey" />
                                    </span>
                                }
                                else
                                {
                                    <span class="editable-name"
                                          data-shift-id="@shiftType.Id"
                                          data-lang="en">
                                        @(shiftType.NameEn ?? shiftType.Key)
                                    </span>
                                }
                            </td>
                            <td dir="rtl">
                                @if (shiftType.Scope == ShiftManager.Models.Support.ShiftScope.Company && !string.IsNullOrWhiteSpace(shiftType.NameKey))
                                {
                                    <span class="editable-name"
                                          data-shift-id="@shiftType.Id"
                                          data-lang="he">
                                        <loc key="@shiftType.NameKey" culture="he-IL" />
                                    </span>
                                }
                                else
                                {
                                    <span class="editable-name"
                                          data-shift-id="@shiftType.Id"
                                          data-lang="he">
                                        @(shiftType.NameHe ?? shiftType.NameEn ?? shiftType.Key)
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="editable-time" data-shift-id="@shiftType.Id">
                                    @Localization.FormatTime(shiftType.Start) - @Localization.FormatTime(shiftType.End)
                                </span>
                            </td>
                            <td>
                                @if (shiftType.Key.StartsWith("CUSTOM_"))
                                {
                                    <span class="badge badge-info"><loc key="Blueprints_Custom" /></span>
                                }
                                else
                                {
                                    <span class="badge badge-success"><loc key="Blueprints_Predefined" /></span>
                                }
                            </td>
                            <td>
                                @switch (shiftType.Scope)
                                {
                                    case ShiftManager.Models.Support.ShiftScope.Area:
                                        <span class="badge badge--scope-area">@Localizer["ShiftScope_Area"]</span>
                                        @if (shiftType.Area != null) { <small>@shiftType.Area.DisplayName</small> }
                                        break;
                                    case ShiftManager.Models.Support.ShiftScope.Molecule:
                                        <span class="badge badge--scope-molecule">@Localizer["ShiftScope_Molecule"]</span>
                                        @if (shiftType.Molecule != null) { <small>@shiftType.Molecule.DisplayName</small> }
                                        break;
                                    case ShiftManager.Models.Support.ShiftScope.Company:
                                        <span class="badge badge--scope-company">@Localizer["ShiftScope_Company"]</span>
                                        @if (shiftType.Company != null) { <small>@shiftType.Company.DisplayName</small> }
                                        break;
                                }
                                @if (shiftType.JobType != null)
                                {
                                    <span class="badge badge-secondary" style="margin-inline-start: 4px;">@shiftType.JobType.DisplayName</span>
                                }
                            </td>
                            <td>
                                @{
                                    var resolvedMolId = shiftType.MoleculeId ?? shiftType.Company?.MoleculeId;
                                    var inSelectedMolecule = resolvedMolId != null && resolvedMolId == Model.SelectedMoleculeId;
                                    var currentCat = Model.Categories.FirstOrDefault(c => c.Id == shiftType.CategoryId);
                                }
                                @if (Model.CanManageCategories && inSelectedMolecule)
                                {
                                    <select class="form-control form-control-sm js-shift-category"
                                            data-shift-id="@shiftType.Id" style="min-width: 130px;">
                                        <option value="">@Localizer["Blueprints_NoCategory"]</option>
                                        @foreach (var cat in Model.Categories)
                                        {
                                            <option value="@cat.Id" selected="@(shiftType.CategoryId == cat.Id)">@cat.DisplayName</option>
                                        }
                                    </select>
                                }
                                else if (currentCat != null)
                                {
                                    <span>@currentCat.DisplayName</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @{
                                    var isPresenceShift = shiftType.IsOffline || shiftType.IsHome;
                                }
                                <label class="checkbox-inline d-block" title="@Localizer["Blueprints_IsBlocking_Tooltip"]">
                                    <input type="checkbox" class="js-shift-flag" data-shift-id="@shiftType.Id" data-flag="blocking"
                                           checked="@shiftType.IsBlocking" disabled="@isPresenceShift" />
                                    <loc key="Blueprints_IsBlocking" />
                                </label>
                                <label class="checkbox-inline d-block" title="@Localizer["Blueprints_CountsTowardHours_Tooltip"]">
                                    <input type="checkbox" class="js-shift-flag" data-shift-id="@shiftType.Id" data-flag="counts"
                                           checked="@shiftType.CountsTowardHourLimits" disabled="@isPresenceShift" />
                                    <loc key="Blueprints_CountsTowardHours" />
                                </label>
                                @if (isPresenceShift)
                                {
                                    <small class="text-muted d-block">@Localizer["Blueprints_PresenceExempt"]</small>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(shiftType.NameKey))
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-secondary edit-name-btn"
                                            data-shift-id="@shiftType.Id"
                                            data-name-key="@shiftType.NameKey">
                                        <icon name="pencil" /> @Localizer["Blueprints_EditName"]
                                    </button>
                                }

                                <button type="button"
                                        class="btn btn-sm btn-secondary edit-time-btn"
                                        data-shift-id="@shiftType.Id"
                                        data-start="@shiftType.Start.ToString("HH:mm")"
                                        data-end="@shiftType.End.ToString("HH:mm")">
                                    <icon name="clock" /> @Localizer["Blueprints_EditTime"]
                                </button>

                                @* ✅ P1-4: Allow deleting ALL shift types with usage warning *@
                                <button type="button" class="btn btn-sm btn-danger" data-shift-name="@shiftType.Name"
                                        onclick="confirmDeleteShiftType(@shiftType.Id, this.dataset.shiftName)">
                                    <icon name="trash-2" /> <loc key="Delete" />
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @* Shift Categories Section — functional groupings (e.g. "Yekev") that own shift elements *@
    @if (Model.CanManageCategories && Model.SelectedMoleculeId.HasValue)
    {
        <div class="feature-category">
            <h2><icon name="layers" /> <loc key="Blueprints_Categories">Shift Categories</loc></h2>
            <p class="page-subtitle"><loc key="Blueprints_CategoriesDesc">Group shift elements into functional categories. Users who do shifts are organized by these categories on the calendar.</loc></p>

            <form method="post" asp-page-handler="CreateCategory"
                  style="display: flex; gap: 0.75rem; align-items: flex-end; flex-wrap: wrap; margin-bottom: 1rem;">
                <input type="hidden" name="moleculeId" value="@Model.SelectedMoleculeId" />
                <div class="form-group" style="margin: 0;">
                    <label asp-for="NewCategoryName"><loc key="Blueprints_CategoryName">Category Name</loc></label>
                    <input asp-for="NewCategoryName" class="form-control" maxlength="100" autocomplete="off" />
                </div>
                <div class="form-group" style="margin: 0;">
                    <label asp-for="NewCategoryColor"><loc key="Blueprints_CategoryColor">Color</loc></label>
                    <input asp-for="NewCategoryColor" type="color" class="form-control" value="#3B82F6" style="width: 56px; padding: 2px;" />
                </div>
                <button type="submit" class="btn btn-primary">
                    <icon name="plus" /> <loc key="Blueprints_AddCategory">Add Category</loc>
                </button>
            </form>

            @if (Model.Categories.Any())
            {
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th><loc key="Blueprints_CategoryName" /></th>
                            <th><loc key="Actions" /></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in Model.Categories)
                        {
                            <tr data-category-id="@cat.Id">
                                <td>
                                    <span class="cat-color-dot" aria-hidden="true"
                                          style="display:inline-block; width:12px; height:12px; border-radius:50%; margin-inline-end:6px; vertical-align:middle; background:@(string.IsNullOrWhiteSpace(cat.Color) ? "#888" : cat.Color);"></span>
                                    <span class="js-cat-name">@cat.DisplayName</span>
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-secondary js-rename-cat"
                                            data-id="@cat.Id" data-name="@cat.DisplayName" data-color="@cat.Color">
                                        <icon name="pencil" /> <loc key="Rename">Rename</loc>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-danger js-delete-cat"
                                            data-id="@cat.Id" data-name="@cat.DisplayName">
                                        <icon name="trash-2" /> <loc key="Delete" />
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-info"><loc key="Blueprints_NoCategories">No categories yet. Create one above to start grouping shifts.</loc></div>
            }

            @* Hidden form used to POST a confirmed category deletion *@
            <form method="post" asp-page-handler="DeleteCategory" id="deleteCategoryForm" style="display: none;">
                <input type="hidden" name="categoryId" id="deleteCategoryId" />
                <input type="hidden" name="confirmed" id="deleteCategoryConfirmed" value="false" />
            </form>
        </div>
    }
</div>

@* Rename Category Modal *@
<div id="renameCategoryModal" class="blueprint-modal" style="display: none;" role="dialog" aria-modal="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h3><loc key="Blueprints_RenameCategory">Rename Category</loc></h3>
                <button type="button" class="close-modal" onclick="closeRenameCategoryModal()" loc-aria-label="Aria_CloseDialog">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="renameCategoryId" />
                <div class="form-group">
                    <label for="renameCategoryName"><loc key="Blueprints_CategoryName">Category Name</loc></label>
                    <input type="text" id="renameCategoryName" class="form-control" maxlength="100" required />
                </div>
                <div class="form-group">
                    <label for="renameCategoryColor"><loc key="Blueprints_CategoryColor">Color</loc></label>
                    <input type="color" id="renameCategoryColor" class="form-control" style="width: 56px; padding: 2px;" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeRenameCategoryModal()"><loc key="Button_Cancel">Cancel</loc></button>
                <button type="button" class="btn btn-primary" onclick="saveCategoryName()"><loc key="Button_Save">Save</loc></button>
            </div>
        </div>
    </div>
</div>

@* Delete Category Confirmation Modal *@
<div id="deleteCategoryModal" class="blueprint-modal" style="display: none;" role="dialog" aria-modal="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h3><loc key="Blueprints_DeleteCategory">Delete Category</loc></h3>
                <button type="button" class="close-modal" onclick="closeDeleteCategoryModal()" loc-aria-label="Aria_CloseDialog">&times;</button>
            </div>
            <div class="modal-body">
                <p><strong><loc key="Blueprints_Category">Category</loc>:</strong> <span id="deleteCategoryDisplayName"></span></p>
                <div id="deleteCategoryUsage" style="display:none; background: var(--warning-soft); padding: 12px; margin: 12px 0; border-radius: 5px; border-inline-start: 4px solid var(--warning);" role="alert">
                    <p id="deleteCategoryUsageText"></p>
                    <p><loc key="Blueprints_DeleteCategoryUsageNote">Deleting it will un-categorize those shifts and remove the user mappings.</loc></p>
                </div>
                <p style="margin-top: 12px;"><strong><loc key="Blueprints_ConfirmDeleteQuestion">Are you sure you want to delete this?</loc></strong></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeDeleteCategoryModal()"><loc key="Button_Cancel">Cancel</loc></button>
                <button type="button" class="btn btn-danger" onclick="proceedDeleteCategory()"><loc key="Button_ConfirmDelete">Confirm Delete</loc></button>
            </div>
        </div>
    </div>
</div>

@* Edit Name Modal *@
<div id="editNameModal" class="blueprint-modal" style="display: none;">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h3><loc key="Modal_EditShiftTypeName">Edit Shift Type Name</loc></h3>
                <button type="button" class="close-modal" onclick="closeEditNameModal()" loc-aria-label="Aria_CloseDialog">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editNameShiftId" />

                <div class="form-group">
                    <label for="editNameEn"><loc key="Label_EnglishName">English Name</loc></label>
                    <input type="text" id="editNameEn" class="form-control" required />
                </div>

                <div class="form-group">
                    <label for="editNameHe"><loc key="Label_HebrewName">Hebrew Name</loc></label>
                    <input type="text" id="editNameHe" class="form-control" required dir="rtl" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeEditNameModal()"><loc key="Button_Cancel">Cancel</loc></button>
                <button type="button" class="btn btn-primary" onclick="saveShiftName()"><loc key="Button_Save">Save</loc></button>
            </div>
        </div>
    </div>
</div>

@* Add Name Keys Modal (inline replacement for the old PopulateNameKeys redirect) *@
<div id="addNameKeysModal" class="blueprint-modal" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="addNameKeysTitle">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="addNameKeysTitle"><loc key="Blueprints_AddNameKeysTitle">Add Name Keys</loc></h3>
                <button type="button" class="close-modal" onclick="closeAddNameKeysModal()" loc-aria-label="Aria_CloseDialog">&times;</button>
            </div>
            <div class="modal-body">
                <p>@Localizer["Blueprints_AddNameKeysDesc"]</p>
                <ul class="namekey-preview">
                    @foreach (var st in Model.MissingNameKeyShifts)
                    {
                        <li><code>@st.Key</code> &rarr; <code>ShiftType_@(st.Key)_Name</code></li>
                    }
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeAddNameKeysModal()"><loc key="Button_Cancel">Cancel</loc></button>
                <button type="button" class="btn btn-primary" id="addNameKeysConfirm" onclick="confirmAddNameKeys()"><loc key="Blueprints_AddNameKeysConfirm">Add Name Keys</loc></button>
            </div>
        </div>
    </div>
</div>

@* Edit Time Modal *@
<div id="editTimeModal" class="blueprint-modal" style="display: none;">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h3><loc key="Modal_EditShiftTimes">Edit Shift Times</loc></h3>
                <button type="button" class="close-modal" onclick="closeEditTimeModal()" loc-aria-label="Aria_CloseDialog">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editTimeShiftId" />

                <div class="form-group">
                    <label for="editStartTime"><loc key="Label_StartTime">Start Time</loc></label>
                    <input type="time" id="editStartTime" class="form-control" required />
                </div>

                <div class="form-group">
                    <label for="editEndTime"><loc key="Label_EndTime">End Time</loc></label>
                    <input type="time" id="editEndTime" class="form-control" required />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeEditTimeModal()"><loc key="Button_Cancel">Cancel</loc></button>
                <button type="button" class="btn btn-primary" onclick="saveShiftTimes()"><loc key="Button_Save">Save</loc></button>
            </div>
        </div>
    </div>
</div>

@* ✅ P1-4: Delete Confirmation Modal with Enhanced Testability *@
<div id="deleteConfirmModal" class="blueprint-modal" style="display: none;"
     data-modal-state="hidden"
     role="dialog"
     aria-labelledby="deleteModalTitle"
     aria-modal="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="deleteModalTitle"><loc key="Modal_ConfirmShiftTypeDeletion">Confirm Shift Type Deletion</loc></h3>
                <button type="button" class="close-modal" onclick="closeDeleteConfirmModal()" loc-aria-label="Aria_CloseButton">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="deleteShiftTypeId" />
                <input type="hidden" id="deleteShiftTypeName" />

                <div id="deleteLoadingMessage" style="text-align: center; padding: 20px;" data-loading="true">
                    <div class="spinner" style="display: inline-block; width: 20px; height: 20px; border: 3px solid var(--surface-soft); border-top: 3px solid var(--text); border-radius: 50%; animation: spin 1s linear infinite;"></div>
                    <p><loc key="Blueprints_CheckingUsage" /></p>
                </div>

                <div id="deleteConfirmMessage" style="display: none;" data-content-ready="false">
                    <p><strong>@Localizer["ShiftType"]:</strong> <span id="deleteDisplayName"></span></p>

                    <div id="programUsageWarning" style="display: none; background: var(--warning-soft); padding: 15px; margin: 15px 0; border-radius: 5px; border-inline-start: 4px solid var(--warning);" role="alert">
                        <p><strong>@Localizer["Blueprints_CannotDelete"]</strong></p>
                        <p>@Localizer["Blueprints_UsedByPrograms_Before"]<strong><span id="programUsageCount"></span></strong> @Localizer["Blueprints_UsedByPrograms_After"]</p>
                        <p><loc key="Blueprints_RemoveFromProgramsFirst" /></p>
                    </div>

                    <div id="instanceUsageWarning" style="display: none; background: var(--warning-soft); padding: 15px; margin: 15px 0; border-radius: 5px; border-inline-start: 4px solid var(--warning);" role="alert">
                        <p><strong>@Localizer["Warning"]</strong></p>
                        <p>@Localizer["Blueprints_UsedByInstances_Before"]<strong><span id="instanceUsageCount"></span></strong> @Localizer["Blueprints_UsedByInstances_After"]</p>
                        <p>@Localizer["Blueprints_DeletionWarning"]</p>
                    </div>

                    <div id="noUsageMessage" style="display: none; background: var(--success-soft); padding: 15px; margin: 15px 0; border-radius: 5px; border-inline-start: 4px solid var(--success);" role="status">
                        <p><strong>@Localizer["Blueprints_SafeToDelete"]</strong></p>
                        <p><loc key="Blueprints_NotInUse" /></p>
                    </div>

                    <p style="margin-top: 15px;"><strong>@Localizer["Blueprints_ConfirmDeleteQuestion"]</strong></p>
                </div>

                <div id="deleteErrorMessage" style="display: none; background: var(--danger-soft); padding: 15px; margin: 15px 0; border-radius: 5px; border-inline-start: 4px solid var(--danger);" role="alert" data-error-state="false">
                    <p><strong>@Localizer["Error"]</strong></p>
                    <p id="deleteErrorText"></p>
                    <button type="button" class="btn btn-sm btn-secondary" onclick="retryCheckUsage()" style="margin-top: 10px;"><loc key="Button_Retry">Retry</loc></button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeDeleteConfirmModal()"><loc key="Button_Cancel">Cancel</loc></button>
                <button type="button" id="deleteConfirmButton" class="btn btn-danger" onclick="proceedDeleteShiftType()" style="display: none;" data-can-submit="false"><loc key="Button_ConfirmDelete">Confirm Delete</loc></button>
            </div>
        </div>
    </div>
</div>

@* Scope selector JS for create form *@

<style>
    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>

@section Scripts {
    <script>
        // Scope selector: show/hide Company dropdown based on selected scope
        const scopeSelector = document.getElementById('scopeSelector');
        const companySelector = document.getElementById('companySelector');
        const companyDropdown = document.getElementById('companyDropdown');
        if (scopeSelector) {
            scopeSelector.addEventListener('change', async function() {
                const scope = parseInt(this.value);
                if (scope === 0 && companySelector) { // Company scope
                    companySelector.style.display = '';
                    // Load companies for selected molecule
                    const molId = document.querySelector('[name="NewShiftMoleculeId"]')?.value;
                    if (molId && companyDropdown) {
                        try {
                            const resp = await fetch(`/Api/Hierarchy/GetCompanies?moleculeId=${molId}`);
                            const data = await resp.json();
                            companyDropdown.innerHTML = '<option value="">Select Company</option>';
                            (data.companies || []).forEach(c => {
                                const opt = document.createElement('option');
                                opt.value = c.id;
                                opt.textContent = c.name;
                                companyDropdown.appendChild(opt);
                            });
                        } catch(e) { console.error('Failed to load companies', e); }
                    }
                } else if (companySelector) {
                    companySelector.style.display = 'none';
                }
            });
        }

        // --- Missing NameKey banner + inline "Add Name Keys" modal ---
        const NAMEKEY_BANNER_DISMISS_KEY = 'blueprints-namekey-banner-dismissed';

        function dismissNameKeyBanner() {
            const banner = document.getElementById('missingNameKeyBanner');
            if (banner) banner.style.display = 'none';
            try { sessionStorage.setItem(NAMEKEY_BANNER_DISMISS_KEY, '1'); } catch (e) { /* private mode */ }
        }
        window.dismissNameKeyBanner = dismissNameKeyBanner;

        // Honor a prior dismissal for this session.
        document.addEventListener('DOMContentLoaded', function () {
            try {
                if (sessionStorage.getItem(NAMEKEY_BANNER_DISMISS_KEY) === '1') {
                    const banner = document.getElementById('missingNameKeyBanner');
                    if (banner) banner.style.display = 'none';
                }
            } catch (e) { /* private mode */ }
        });

        function openAddNameKeysModal() {
            const m = document.getElementById('addNameKeysModal');
            if (!m) return;
            m.style.display = 'flex';
            m.classList.add('is-open');
        }
        window.openAddNameKeysModal = openAddNameKeysModal;

        function closeAddNameKeysModal() {
            const m = document.getElementById('addNameKeysModal');
            if (!m) return;
            m.classList.remove('is-open');
            m.style.display = 'none';
        }
        window.closeAddNameKeysModal = closeAddNameKeysModal;

        async function confirmAddNameKeys() {
            const btn = document.getElementById('addNameKeysConfirm');
            if (btn) btn.disabled = true;
            try {
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const response = await fetch('/Owner/Blueprints?handler=AddNamekeys', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': tokenInput ? tokenInput.value : ''
                    }
                });

                let result = null;
                try { result = await response.json(); } catch (e) { /* non-JSON body */ }

                if (response.ok && result && result.success) {
                    closeAddNameKeysModal();
                    location.reload();
                    return;
                }
                const serverError = result && result.error ? result.error : null;
                window.FeedbackModal.show('error', serverError || '@Localizer["Error_FailedToUpdate"].Value.Trim()');
            } catch (err) {
                console.error('Failed to add name keys', err);
                window.FeedbackModal.show('error', '@Localizer["Error_FailedToUpdate"].Value.Trim()');
            } finally {
                if (btn) btn.disabled = false;
            }
        }
        window.confirmAddNameKeys = confirmAddNameKeys;

        // Backdrop click closes the add-name-keys modal (only present when there are missing keys).
        (function () {
            const m = document.getElementById('addNameKeysModal');
            if (m) {
                m.addEventListener('click', function (e) {
                    if (e.target === this) closeAddNameKeysModal();
                });
            }
        })();

        // Edit Name Modal
        document.querySelectorAll('.edit-name-btn').forEach(btn => {
            btn.addEventListener('click', async function() {
                const shiftId = this.dataset.shiftId;
                const nameKey = this.dataset.nameKey;

                document.getElementById('editNameShiftId').value = shiftId;

                // Fetch current values via localization API
                try {
                    const enValue = await window.Localization.get(nameKey, 'en-US');
                    const heValue = await window.Localization.get(nameKey, 'he-IL');

                    document.getElementById('editNameEn').value = enValue || '';
                    document.getElementById('editNameHe').value = heValue || '';
                } catch (err) {
                    console.error('Failed to fetch localization values', err);
                }

                var m = document.getElementById('editNameModal');
                m.style.display = 'flex';
                m.classList.add('is-open');
            });
        });

        function closeEditNameModal() {
            var m = document.getElementById('editNameModal');
            m.classList.remove('is-open');
            m.style.display = 'none';
        }

        async function saveShiftName() {
            const shiftId = document.getElementById('editNameShiftId').value;
            const nameEn = document.getElementById('editNameEn').value;
            const nameHe = document.getElementById('editNameHe').value;

            // FeedbackModal is globally loaded by _Layout.cshtml.
            function showError(msg) {
                window.FeedbackModal.show('error', msg);
            }

            if (!nameEn || !nameHe) {
                showError('@Localizer["Error_BothNamesRequired"].Value.Trim()');
                return;
            }

            try {
                const response = await fetch('/Owner/Blueprints?handler=UpdateShiftName', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ shiftTypeId: shiftId, nameEn, nameHe })
                });

                // Try to read the server's JSON body even on non-2xx so the specific reason
                // (e.g. "This isn't a BR shift") reaches the user instead of a generic fallback.
                let result = null;
                try { result = await response.json(); } catch (e) { /* non-JSON body */ }

                if (response.ok && result && result.success) {
                    closeEditNameModal();
                    location.reload(); // Refresh to show updated names
                    return;
                }

                const serverError = result && result.error ? result.error : null;
                const fallback = '@Localizer["Error_FailedToUpdate"].Value.Trim()';
                showError(serverError || fallback);
            } catch (err) {
                console.error('Failed to save shift name', err);
                showError('@Localizer["Error_FailedToSaveShiftName"].Value.Trim()');
            }
        }

        // Edit Time Modal
        document.querySelectorAll('.edit-time-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const shiftId = this.dataset.shiftId;
                const start = this.dataset.start;
                const end = this.dataset.end;

                document.getElementById('editTimeShiftId').value = shiftId;
                document.getElementById('editStartTime').value = start;
                document.getElementById('editEndTime').value = end;

                var m = document.getElementById('editTimeModal');
                m.style.display = 'flex';
                m.classList.add('is-open');
            });
        });

        function closeEditTimeModal() {
            var m = document.getElementById('editTimeModal');
            m.classList.remove('is-open');
            m.style.display = 'none';
        }

        async function saveShiftTimes() {
            const shiftId = document.getElementById('editTimeShiftId').value;
            const startTime = document.getElementById('editStartTime').value;
            const endTime = document.getElementById('editEndTime').value;

            if (!startTime || !endTime) {
                window.FeedbackModal.show('warning', '@Localizer["Error_BothTimesRequired"].Value.Trim()');
                return;
            }

            try {
                const response = await fetch('/Owner/Blueprints?handler=UpdateShiftTimes', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ shiftTypeId: shiftId, startTime, endTime })
                });

                if (!response.ok) {
                    throw new Error(`Request failed: ${response.status}`);
                }

                const result = await response.json();

                if (result.success) {
                    closeEditTimeModal();
                    location.reload(); // Refresh to show updated times
                } else {
                    window.FeedbackModal.show('error', '@Localizer["Error_Prefix"].Value.Trim()' + (result.error || '@Localizer["Error_FailedToUpdate"].Value.Trim()'));
                }
            } catch (err) {
                console.error('Failed to save shift times', err);
                window.FeedbackModal.show('error', '@Localizer["Error_FailedToSaveShiftTimes"].Value.Trim()');
            }
        }

        // Modal backdrop click
        document.getElementById('editNameModal').addEventListener('click', function(e) {
            if (e.target === this) closeEditNameModal();
        });

        document.getElementById('editTimeModal').addEventListener('click', function(e) {
            if (e.target === this) closeEditTimeModal();
        });

        document.getElementById('deleteConfirmModal').addEventListener('click', function(e) {
            if (e.target === this) closeDeleteConfirmModal();
        });

        // ✅ P1-4: Enhanced Delete Confirmation Modal with State Management

        // Cache anti-forgery token on page load
        let cachedAntiForgeryToken = null;
        document.addEventListener('DOMContentLoaded', function() {
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            if (tokenInput) {
                cachedAntiForgeryToken = tokenInput.value;
            }
        });

        async function confirmDeleteShiftType(shiftTypeId, shiftTypeName) {
            const modal = document.getElementById('deleteConfirmModal');

            // Store parameters for retry
            modal.dataset.shiftTypeId = shiftTypeId;
            modal.dataset.shiftTypeName = shiftTypeName;

            // Reset modal state
            modal.setAttribute('data-modal-state', 'loading');
            document.getElementById('deleteShiftTypeId').value = shiftTypeId;
            document.getElementById('deleteShiftTypeName').value = shiftTypeName;
            document.getElementById('deleteDisplayName').textContent = shiftTypeName;

            // Reset UI elements
            document.getElementById('deleteLoadingMessage').style.display = 'block';
            document.getElementById('deleteConfirmMessage').style.display = 'none';
            document.getElementById('deleteErrorMessage').style.display = 'none';
            document.getElementById('deleteConfirmButton').style.display = 'none';
            document.getElementById('deleteConfirmButton').setAttribute('data-can-submit', 'false');

            // Show modal
            modal.style.display = 'flex';
            modal.classList.add('is-open');

            // Focus trap for accessibility
            const closeButton = modal.querySelector('.close-modal');
            if (closeButton) closeButton.focus();

            // Perform usage check with timeout
            await checkShiftTypeUsage(shiftTypeId);
        }

        async function checkShiftTypeUsage(shiftTypeId) {
            const modal = document.getElementById('deleteConfirmModal');

            try {
                // Create abort controller for timeout (10 second timeout)
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 10000);

                const response = await fetch(
                    `/Owner/Blueprints?handler=CheckShiftTypeUsage&shiftTypeId=${shiftTypeId}`,
                    { signal: controller.signal }
                );

                clearTimeout(timeoutId);

                if (!response.ok) {
                    throw new Error(`Server returned ${response.status}: ${response.statusText}`);
                }

                const result = await response.json();

                if (result.error) {
                    throw new Error(result.error);
                }

                // Transition to ready state
                modal.setAttribute('data-modal-state', 'ready');
                document.getElementById('deleteLoadingMessage').style.display = 'none';
                document.getElementById('deleteConfirmMessage').style.display = 'block';
                document.getElementById('deleteConfirmMessage').setAttribute('data-content-ready', 'true');

                // Show appropriate warning/message
                const programCount = result.programCount || 0;
                const instanceCount = result.instanceCount || 0;

                // Reset all warnings
                document.getElementById('programUsageWarning').style.display = 'none';
                document.getElementById('instanceUsageWarning').style.display = 'none';
                document.getElementById('noUsageMessage').style.display = 'none';

                if (programCount > 0) {
                    // Cannot delete - used by programs
                    modal.setAttribute('data-modal-state', 'blocked');
                    document.getElementById('programUsageCount').textContent = programCount;
                    document.getElementById('programUsageWarning').style.display = 'block';
                    document.getElementById('deleteConfirmButton').style.display = 'none';
                    document.getElementById('deleteConfirmButton').setAttribute('data-can-submit', 'false');
                } else if (instanceCount > 0) {
                    // Can delete with warning - used by shift instances
                    modal.setAttribute('data-modal-state', 'ready-with-warning');
                    document.getElementById('instanceUsageCount').textContent = instanceCount;
                    document.getElementById('instanceUsageWarning').style.display = 'block';
                    document.getElementById('deleteConfirmButton').style.display = 'block';
                    document.getElementById('deleteConfirmButton').setAttribute('data-can-submit', 'true');
                } else {
                    // Safe to delete - not used anywhere
                    modal.setAttribute('data-modal-state', 'ready-safe');
                    document.getElementById('noUsageMessage').style.display = 'block';
                    document.getElementById('deleteConfirmButton').style.display = 'block';
                    document.getElementById('deleteConfirmButton').setAttribute('data-can-submit', 'true');
                }
            } catch (err) {
                // Handle errors gracefully with retry option
                console.error('Failed to check shift type usage:', err);

                modal.setAttribute('data-modal-state', 'error');
                document.getElementById('deleteLoadingMessage').style.display = 'none';
                document.getElementById('deleteErrorMessage').style.display = 'block';
                document.getElementById('deleteErrorMessage').setAttribute('data-error-state', 'true');

                let errorMessage = 'Failed to check usage. ';
                if (err.name === 'AbortError') {
                    errorMessage += 'Request timed out. Please try again.';
                } else if (err.message) {
                    errorMessage += err.message;
                } else {
                    errorMessage += 'Please check your connection and try again.';
                }

                document.getElementById('deleteErrorText').textContent = errorMessage;
            }
        }

        function retryCheckUsage() {
            const modal = document.getElementById('deleteConfirmModal');
            const shiftTypeId = modal.dataset.shiftTypeId;
            const shiftTypeName = modal.dataset.shiftTypeName;

            if (shiftTypeId && shiftTypeName) {
                confirmDeleteShiftType(parseInt(shiftTypeId), shiftTypeName);
            }
        }

        function closeDeleteConfirmModal() {
            const modal = document.getElementById('deleteConfirmModal');
            modal.classList.remove('is-open');
            modal.style.display = 'none';
            modal.setAttribute('data-modal-state', 'hidden');
        }

        // Keyboard support for accessibility
        document.addEventListener('keydown', function(e) {
            const modal = document.getElementById('deleteConfirmModal');
            if (modal && modal.classList.contains('is-open') && e.key === 'Escape') {
                closeDeleteConfirmModal();
            }
        });

        async function proceedDeleteShiftType() {
            const modal = document.getElementById('deleteConfirmModal');
            const confirmButton = document.getElementById('deleteConfirmButton');
            const shiftTypeId = document.getElementById('deleteShiftTypeId').value;
            const shiftTypeName = document.getElementById('deleteShiftTypeName').value;

            // Validate button can submit
            if (confirmButton.getAttribute('data-can-submit') !== 'true') {
                console.error('Delete button clicked but submission not allowed');
                return;
            }

            try {
                // Update UI to show submitting state
                modal.setAttribute('data-modal-state', 'submitting');
                confirmButton.disabled = true;
                confirmButton.textContent = '@Localizer["Deleting"].Value.Trim()';

                // Verify we have the anti-forgery token
                if (!cachedAntiForgeryToken) {
                    throw new Error('Security token not found. Please refresh the page and try again.');
                }

                // Create form and submit
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Owner/Blueprints?handler=DeleteShiftType';

                // Add anti-forgery token
                const tokenInput = document.createElement('input');
                tokenInput.type = 'hidden';
                tokenInput.name = '__RequestVerificationToken';
                tokenInput.value = cachedAntiForgeryToken;
                form.appendChild(tokenInput);

                // Add shiftTypeId
                const idInput = document.createElement('input');
                idInput.type = 'hidden';
                idInput.name = 'shiftTypeId';
                idInput.value = shiftTypeId;
                form.appendChild(idInput);

                // Add confirmation flag
                const confirmInput = document.createElement('input');
                confirmInput.type = 'hidden';
                confirmInput.name = 'confirmed';
                confirmInput.value = 'true';
                form.appendChild(confirmInput);

                // Submit form
                document.body.appendChild(form);
                form.submit();

                // Note: Page will navigate away, so no need to reset state
            } catch (err) {
                console.error('Failed to delete shift type:', err);

                // Show error in modal instead of alert
                modal.setAttribute('data-modal-state', 'submit-error');
                document.getElementById('deleteErrorText').textContent = err.message || 'Failed to submit deletion request';
                document.getElementById('deleteErrorMessage').style.display = 'block';
                document.getElementById('deleteConfirmMessage').style.display = 'none';

                // Re-enable button
                confirmButton.disabled = false;
                confirmButton.textContent = '@Localizer["ConfirmDelete"].Value.Trim()';
            }
        }

        // ---------------------------------------------------------------------------
        // Shift Categories: assign-to-shift, rename, delete
        // ---------------------------------------------------------------------------
        function blueprintsToken() {
            const t = document.querySelector('input[name="__RequestVerificationToken"]');
            return t ? t.value : '';
        }

        // Assign a shift type to a category (or clear) on dropdown change.
        document.querySelectorAll('.js-shift-category').forEach(sel => {
            sel.addEventListener('change', async function () {
                const shiftTypeId = parseInt(this.dataset.shiftId, 10);
                const raw = this.value;
                const categoryId = raw === '' ? null : parseInt(raw, 10);
                this.disabled = true;
                try {
                    const resp = await fetch('/Owner/Blueprints?handler=AssignShiftCategory', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': blueprintsToken() },
                        body: JSON.stringify({ shiftTypeId, categoryId })
                    });
                    let result = null;
                    try { result = await resp.json(); } catch (e) { /* non-JSON */ }
                    if (resp.ok && result && result.success) {
                        window.Toast && window.Toast.success
                            ? window.Toast.success('@Localizer["Blueprints_CategoryAssigned"].Value.Trim()')
                            : null;
                    } else {
                        window.FeedbackModal.show('error', (result && result.error) || '@Localizer["Error_FailedToUpdate"].Value.Trim()');
                    }
                } catch (err) {
                    console.error('Failed to assign category', err);
                    window.FeedbackModal.show('error', '@Localizer["Error_FailedToUpdate"].Value.Trim()');
                } finally {
                    this.disabled = false;
                }
            });
        });

        // Issue 1: toggle "is blocking" / "counts toward hours" on a shift type.
        // Both flags are sent together (the DTO carries both); a failed save reverts the checkbox.
        document.querySelectorAll('.js-shift-flag').forEach(cb => {
            cb.addEventListener('change', async function () {
                const shiftTypeId = parseInt(this.dataset.shiftId, 10);
                const row = this.closest('tr');
                const isBlocking = row.querySelector('.js-shift-flag[data-flag="blocking"]').checked;
                const countsTowardHourLimits = row.querySelector('.js-shift-flag[data-flag="counts"]').checked;
                try {
                    const resp = await fetch('/Owner/Blueprints?handler=UpdateShiftFlags', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': blueprintsToken() },
                        body: JSON.stringify({ shiftTypeId, isBlocking, countsTowardHourLimits })
                    });
                    let result = null;
                    try { result = await resp.json(); } catch (e) { /* non-JSON */ }
                    if (resp.ok && result && result.success) {
                        window.Toast && window.Toast.success
                            ? window.Toast.success('@Localizer["Blueprints_SettingsSaved"].Value.Trim()')
                            : null;
                    } else {
                        this.checked = !this.checked; // revert on failure
                        window.FeedbackModal.show('error', (result && result.error) || '@Localizer["Error_FailedToUpdate"].Value.Trim()');
                    }
                } catch (err) {
                    this.checked = !this.checked; // revert on failure
                    console.error('Failed to update shift flags', err);
                    window.FeedbackModal.show('error', '@Localizer["Error_FailedToUpdate"].Value.Trim()');
                }
            });
        });

        // Rename category modal
        document.querySelectorAll('.js-rename-cat').forEach(btn => {
            btn.addEventListener('click', function () {
                document.getElementById('renameCategoryId').value = this.dataset.id;
                document.getElementById('renameCategoryName').value = this.dataset.name || '';
                document.getElementById('renameCategoryColor').value = this.dataset.color || '#3B82F6';
                const m = document.getElementById('renameCategoryModal');
                m.style.display = 'flex';
                m.classList.add('is-open');
            });
        });

        function closeRenameCategoryModal() {
            const m = document.getElementById('renameCategoryModal');
            m.classList.remove('is-open');
            m.style.display = 'none';
        }
        window.closeRenameCategoryModal = closeRenameCategoryModal;

        async function saveCategoryName() {
            const categoryId = parseInt(document.getElementById('renameCategoryId').value, 10);
            const name = document.getElementById('renameCategoryName').value.trim();
            const color = document.getElementById('renameCategoryColor').value;
            if (!name) {
                window.FeedbackModal.show('warning', '@Localizer["Blueprints_CategoryNameRequired"].Value.Trim()');
                return;
            }
            try {
                const resp = await fetch('/Owner/Blueprints?handler=RenameCategory', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': blueprintsToken() },
                    body: JSON.stringify({ categoryId, name, color })
                });
                let result = null;
                try { result = await resp.json(); } catch (e) { /* non-JSON */ }
                if (resp.ok && result && result.success) {
                    closeRenameCategoryModal();
                    location.reload();
                    return;
                }
                window.FeedbackModal.show('error', (result && result.error) || '@Localizer["Error_FailedToUpdate"].Value.Trim()');
            } catch (err) {
                console.error('Failed to rename category', err);
                window.FeedbackModal.show('error', '@Localizer["Error_FailedToUpdate"].Value.Trim()');
            }
        }
        window.saveCategoryName = saveCategoryName;

        // Delete category — fetch usage, confirm, then submit the hidden form with confirmed=true.
        document.querySelectorAll('.js-delete-cat').forEach(btn => {
            btn.addEventListener('click', async function () {
                const id = this.dataset.id;
                const name = this.dataset.name || '';
                document.getElementById('deleteCategoryDisplayName').textContent = name;
                const usageBox = document.getElementById('deleteCategoryUsage');
                const usageText = document.getElementById('deleteCategoryUsageText');
                usageBox.style.display = 'none';
                usageText.textContent = '';
                document.getElementById('deleteCategoryId').value = id;

                const m = document.getElementById('deleteCategoryModal');
                m.style.display = 'flex';
                m.classList.add('is-open');

                try {
                    const resp = await fetch(`/Owner/Blueprints?handler=CheckCategoryUsage&categoryId=${id}`);
                    const result = await resp.json();
                    if (result && !result.error && (result.shiftTypeCount > 0 || result.memberCount > 0)) {
                        usageText.textContent =
                            '@Localizer["Blueprints_CategoryInUsePrefix"].Value.Trim() ' +
                            result.shiftTypeCount + ' @Localizer["Blueprints_ShiftsWord"].Value.Trim(), ' +
                            result.memberCount + ' @Localizer["Blueprints_UsersWord"].Value.Trim().';
                        usageBox.style.display = 'block';
                    }
                } catch (e) { console.error('usage check failed', e); }
            });
        });

        function closeDeleteCategoryModal() {
            const m = document.getElementById('deleteCategoryModal');
            m.classList.remove('is-open');
            m.style.display = 'none';
        }
        window.closeDeleteCategoryModal = closeDeleteCategoryModal;

        function proceedDeleteCategory() {
            document.getElementById('deleteCategoryConfirmed').value = 'true';
            document.getElementById('deleteCategoryForm').submit();
        }
        window.proceedDeleteCategory = proceedDeleteCategory;

        // Backdrop click closes the category modals
        ['renameCategoryModal', 'deleteCategoryModal'].forEach(idv => {
            const m = document.getElementById(idv);
            if (m) m.addEventListener('click', function (e) { if (e.target === this) { this.classList.remove('is-open'); this.style.display = 'none'; } });
        });
    </script>
}

