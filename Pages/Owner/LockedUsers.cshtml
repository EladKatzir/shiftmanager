@page
@model ShiftManager.Pages.Owner.LockedUsersModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = "Locked Users";
}

<div class="container py-4">
    <div class="page-header mb-4">
        <h1><loc key="LockedUsers_Title">Locked User Accounts</loc></h1>
        <p class="text-muted"><loc key="LockedUsers_Subtitle">View and unlock accounts that have been locked due to failed login attempts</loc></p>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (Model.LockedUsers.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <p class="text-muted mb-0"><loc key="LockedUsers_NoLockedUsers">No locked accounts found</loc></p>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th><loc key="LockedUsers_User">User</loc></th>
                            <th><loc key="LockedUsers_Email">Email</loc></th>
                            <th><loc key="LockedUsers_FailedAttempts">Failed Attempts</loc></th>
                            <th><loc key="LockedUsers_LastAttempt">Last Attempt</loc></th>
                            <th><loc key="LockedUsers_SourceIP">Source IP</loc></th>
                            <th><loc key="LockedUsers_Status">Status</loc></th>
                            <th><loc key="LockedUsers_Actions">Actions</loc></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.LockedUsers)
                        {
                            <tr>
                                <td>@user.DisplayName</td>
                                <td>@user.Email</td>
                                <td>@user.FailedAttempts</td>
                                <td>@(user.LastAttempt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                <td>@(user.LastFailedIp ?? "-")</td>
                                <td>
                                    @if (user.IsExpired)
                                    {
                                        <span class="badge bg-warning"><loc key="LockedUsers_RecentlyLocked">Recently Locked (expired)</loc></span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><loc key="LockedUsers_Locked">Locked</loc> - @user.MinutesRemaining <loc key="LockedUsers_MinRemaining">min remaining</loc></span>
                                    }
                                </td>
                                <td>
                                    <form method="post" asp-page-handler="Unlock" class="d-inline">
                                        <input type="hidden" name="userId" value="@user.UserId" />
                                        <button type="submit" class="btn btn-sm btn-primary">
                                            <loc key="LockedUsers_Unlock">Unlock</loc>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Rate-Limited Signup IPs Section -->
    <div class="page-header mb-4 mt-5">
        <h2><loc key="LockedUsers_RateLimitedSignups">Rate-Limited Signup IPs</loc></h2>
        <p class="text-muted"><loc key="LockedUsers_RateLimitedSubtitle">IPs that have exceeded the signup rate limit (50 attempts / 10 minutes)</loc></p>
    </div>

    @if (Model.RateLimitedSignups.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <p class="text-muted mb-0"><loc key="LockedUsers_NoRateLimitedIPs">No rate-limited IPs</loc></p>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th><loc key="LockedUsers_IPAddress">IP Address</loc></th>
                            <th><loc key="LockedUsers_Attempts">Attempts</loc></th>
                            <th><loc key="LockedUsers_LastAttempt">Last Attempt</loc></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.RateLimitedSignups)
                        {
                            <tr>
                                <td>@entry.Key.Replace("signup:ip:", "")</td>
                                <td>@entry.AttemptCount</td>
                                <td>@(entry.LastAttempt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer">
                <form method="post" asp-page-handler="ClearSignupRateLimits" class="d-inline">
                    <button type="submit" class="btn btn-warning" onclick="return confirm('@Localizer["LockedUsers_ConfirmClearRateLimits"].Value');">
                        <loc key="LockedUsers_ClearAll">Clear All</loc>
                    </button>
                </form>
            </div>
        </div>
    }

    <div class="mt-3">
        <a href="/Owner/Hub" class="btn btn-outline-secondary">
            <loc key="BackToOwnerHub">Back to Owner Hub</loc>
        </a>
    </div>
</div>
