@page
@model ShiftManager.Pages.Owner.EmailTemplatesModel
@using ShiftManager.ViewComponents
@using ShiftManager.Models.Support
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["Owner_EmailTemplates"];
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Owner_AdminPanel"], Url = "/Owner/Index" },
    new BreadcrumbItem { Label = Localizer["Owner_EmailTemplates"], IsActive = true }
})

@* Owner Company Selector *@
@await Component.InvokeAsync("OwnerCompanySelector")

<div class="email-templates-container">
    <div class="page-header">
        <h1>
            <span class="page-icon"><icon name="mail" /></span>
            <loc key="Owner_EmailTemplates" />
        </h1>
        <p class="page-subtitle"><loc key="EmailTemplates_Subtitle" /></p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.Error
            <button type="button" class="btn-close" onclick="this.parentElement.remove()" loc-aria-label="Aria_CloseButton"></button>
        </div>
    }

    <div class="info-box mb-4">
        <div class="info-icon">ℹ️</div>
        <div class="info-content">
            <strong><loc key="EmailTemplates_InfoTitle" /></strong>
            <p><loc key="EmailTemplates_InfoDescription" /></p>
        </div>
    </div>

    <div class="templates-grid">
        @foreach (var template in Model.Templates)
        {
            <div class="template-card @(template.IsEnabled ? "template-enabled" : "")">
                <div class="template-header">
                    <h3>@template.DisplayName</h3>
                    <span class="template-status">
                        @if (template.IsEnabled)
                        {
                            <span class="badge bg-success"><loc key="Status_Enabled" /></span>
                        }
                        else
                        {
                            <span class="badge bg-secondary"><loc key="Status_Disabled" /></span>
                        }
                    </span>
                </div>

                <div class="template-body">
                    @if (template.IsEnabled && !string.IsNullOrWhiteSpace(template.CustomMessage))
                    {
                        <div class="custom-message-preview">
                            <strong><loc key="EmailTemplates_CustomMessage" />:</strong>
                            <p class="preview-text">@template.CustomMessage</p>
                        </div>
                    }
                    else
                    {
                        <div class="default-message-preview">
                            <strong><loc key="EmailTemplates_DefaultMessage" />:</strong>
                            <p class="preview-text text-muted">@template.DefaultMessage</p>
                        </div>
                    }

                    <div class="template-variables">
                        <strong><loc key="EmailTemplates_AvailableVariables" />:</strong>
                        <div class="variable-tags">
                            @foreach (var variable in template.AvailableVariables)
                            {
                                <code class="variable-tag">{@variable}</code>
                            }
                        </div>
                    </div>
                </div>

                <div class="template-actions">
                    <button type="button" class="btn btn-primary btn-sm edit-template-btn"
                            data-template-type="@((int)template.Type)"
                            data-template-name="@template.DisplayName"
                            data-template-variables="@System.Text.Json.JsonSerializer.Serialize(template.AvailableVariables)"
                            data-template-default="@template.DefaultMessage"
                            data-template-custom="@template.CustomMessage"
                            data-template-enabled="@template.IsEnabled.ToString().ToLower()">
                        <loc key="Action_Edit" />
                    </button>
                    @if (template.IsEnabled)
                    {
                        <form method="post" asp-page-handler="ResetTemplate" class="d-inline"
                              data-confirm-modal
                              data-confirm-title="@Localizer["Confirm_ResetTemplate_Title"]"
                              data-confirm-message="@Localizer["Confirm_ResetTemplate"]"
                              data-confirm-action="@Localizer["Reset"]"
                              data-confirm-level="danger">
                            <input type="hidden" name="templateType" value="@((int)template.Type)" />
                            <button type="submit" class="btn btn-outline-secondary btn-sm">
                                <loc key="Action_ResetToDefault" />
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Edit Template Modal -->
<div class="modal" id="editModal" role="dialog" aria-labelledby="editModalLabel" aria-modal="true">
    <div class="modal-content large">
            <form method="post" asp-page-handler="SaveTemplate">
                <div class="modal-header">
                    <h5 class="modal-title" id="editModalLabel"><loc key="EmailTemplates_EditTemplate" /></h5>
                    <button type="button" class="modal-close" onclick="closeEditModal()" loc-aria-label="Aria_CloseButton">&times;</button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="EditingTemplateType" id="editingTemplateType" />

                    <div class="mb-3">
                        <label class="form-label"><strong id="templateName"></strong></label>
                    </div>

                    <div class="mb-3">
                        <label for="customMessage" class="form-label"><loc key="EmailTemplates_CustomMessage" /></label>
                        <textarea asp-for="CustomMessage" class="form-control" id="customMessage" rows="6"
                                  maxlength="2000" placeholder="@Localizer["EmailTemplates_MessagePlaceholder"]"></textarea>
                        <div class="form-text">
                            <loc key="EmailTemplates_CharacterCount" />: <span id="charCount">0</span> / 2000
                        </div>
                        <span asp-validation-for="CustomMessage" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input asp-for="IsEnabled" class="form-check-input" type="checkbox" id="isEnabled" />
                            <label class="form-check-label" for="isEnabled">
                                <loc key="EmailTemplates_EnableCustomTemplate" />
                            </label>
                        </div>
                    </div>

                    <div class="alert alert-info">
                        <strong><loc key="EmailTemplates_AvailableVariables" />:</strong>
                        <div id="availableVariables" class="mt-2"></div>
                        <small class="text-muted"><loc key="EmailTemplates_VariablesHelp" /></small>
                    </div>

                    <div class="alert alert-secondary">
                        <strong><loc key="EmailTemplates_DefaultMessage" />:</strong>
                        <p id="defaultMessage" class="mb-0 mt-2"></p>
                    </div>
                </div>
                <div class="modal-footer" style="flex-direction: column; gap: 0;">
                    <div style="display: flex; gap: var(--space-3); width: 100%; justify-content: flex-end; padding-bottom: var(--space-3);">
                        <button type="button" class="btn btn-secondary" onclick="closeEditModal()"><loc key="Action_Cancel" /></button>
                        <button type="submit" class="btn btn-primary"><loc key="Action_SaveChanges" /></button>
                    </div>
                    <div style="width: 100%; border-top: 1px solid var(--border); padding-top: var(--space-3);">
                        <div style="display: flex; align-items: center; gap: var(--space-3);">
                            <div style="flex: 1; font-size: var(--text-small); color: var(--text-muted);">
                                <loc key="ApplyToAllCompanies_Desc" />
                            </div>
                            <button type="submit" class="btn btn-warning btn-sm" formaction="?handler=ApplyToAllCompanies"
                                    data-confirm-modal
                                    data-confirm-title="@Localizer["Confirm_ApplyToAllCompanies_Title"]"
                                    data-confirm-message="@Localizer["Confirm_ApplyToAllCompanies"]"
                                    data-confirm-action="@Localizer["Apply"]"
                                    data-confirm-level="warning">
                                <loc key="ApplyToAllCompanies" />
                            </button>
                        </div>
                    </div>
                </div>
            </form>
    </div>
</div>

@section Scripts {
    <script>
        function loadTemplateForEdit(typeId, displayName, variablesJson, defaultMsg, customMsg, isEnabled) {
            document.getElementById('editingTemplateType').value = typeId;
            document.getElementById('templateName').textContent = displayName;
            document.getElementById('customMessage').value = customMsg;
            document.getElementById('isEnabled').checked = isEnabled;
            document.getElementById('defaultMessage').textContent = defaultMsg;

            // Update character count
            updateCharCount();

            // Display available variables
            const variables = JSON.parse(variablesJson);
            const variablesHtml = variables.map(v => `<code class="variable-tag">{${v}}</code>`).join(' ');
            document.getElementById('availableVariables').innerHTML = variablesHtml;
        }

        // XSS-safe: Read template data from data attributes instead of inline onclick
        function openEditModal() {
            document.getElementById('editModal').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeEditModal() {
            document.getElementById('editModal').classList.remove('active');
            document.body.style.overflow = '';
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeEditModal();
        });

        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.edit-template-btn').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    loadTemplateForEdit(
                        this.dataset.templateType,
                        this.dataset.templateName,
                        this.dataset.templateVariables,
                        this.dataset.templateDefault,
                        this.dataset.templateCustom,
                        this.dataset.templateEnabled === 'true'
                    );
                    openEditModal();
                });
            });
        });

        function updateCharCount() {
            const textarea = document.getElementById('customMessage');
            const count = textarea.value.length;
            document.getElementById('charCount').textContent = count;
        }

        // Update character count on input
        document.addEventListener('DOMContentLoaded', function() {
            const textarea = document.getElementById('customMessage');
            if (textarea) {
                textarea.addEventListener('input', updateCharCount);
            }
        });
    </script>

    <style>
        #editModal {
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(4px);
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        .email-templates-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }

        .templates-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .template-card {
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 20px;
            background: var(--surface);
            transition: box-shadow 0.3s;
        }

        .template-card:hover {
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .template-enabled {
            border-color: var(--success);
            border-width: 2px;
        }

        .template-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--border);
        }

        .template-header h3 {
            margin: 0;
            font-size: 1.1rem;
        }

        .template-body {
            margin-bottom: 15px;
        }

        .custom-message-preview,
        .default-message-preview {
            margin-bottom: 15px;
        }

        .preview-text {
            background: var(--surface-soft);
            padding: 10px;
            border-radius: 4px;
            margin-top: 5px;
            font-size: 0.9rem;
            white-space: pre-wrap;
            word-wrap: break-word;
        }

        .template-variables {
            margin-top: 15px;
        }

        .variable-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
            margin-top: 5px;
        }

        .variable-tag {
            background: var(--info-soft);
            color: var(--info);
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 0.85rem;
            border: 1px solid var(--accent-soft);
        }

        .template-actions {
            display: flex;
            gap: 10px;
        }

        .info-box {
            background: var(--info-soft);
            border: 1px solid var(--accent-soft);
            border-radius: 8px;
            padding: 15px;
            display: flex;
            gap: 15px;
        }

        .info-icon {
            font-size: 1.5rem;
        }

        .info-content {
            flex: 1;
        }

        .info-content p {
            margin: 5px 0 0 0;
            font-size: 0.9rem;
        }
    </style>
}
