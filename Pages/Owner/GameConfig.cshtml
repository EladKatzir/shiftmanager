@page
@model ShiftManager.Pages.Owner.GameConfigModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["GameConfig_Title"];
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Owner_AdminPanel"], Url = "/Owner/Index" },
    new BreadcrumbItem { Label = Localizer["GameConfig_Title"], IsActive = true }
})

@* Owner Company Selector *@
@await Component.InvokeAsync("OwnerCompanySelector")

<div class="feature-flags-container">
    <div class="page-header">
        <h1>
            <span class="page-icon">🎮</span>
            @Localizer["GameConfig_Title"]
        </h1>
        <p class="page-subtitle"><loc key="GameConfig_Subtitle" /></p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Success))
    {
        <div class="alert alert-success">
            <strong>✅ Success:</strong> @Model.Success
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger">
            <strong>❌ Error:</strong> @Model.Error
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.Warning))
    {
        <div class="alert alert-warning">
            <strong>⚠️ Warning:</strong> @Model.Warning
        </div>
    }

    <form method="post">
        @* Game Status *@
        <div class="feature-category">
            <h2>🎮 <loc key="GameConfig_GameStatus" /></h2>
            <div class="feature-flags-grid">
                <div class="feature-flag-card">
                    <div class="flag-header">
                        <div>
                            <h3><loc key="GameConfig_GameEnabled" /></h3>
                            <p><loc key="GameConfig_GameEnabled_Desc" /></p>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" asp-for="GameEnabled" />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                    <div class="flag-meta">
                        <span class="flag-status">@(Model.GameEnabled ? "✅ " + Localizer["GameConfig_Enabled"] : "❌ " + Localizer["GameConfig_Disabled"])</span>
                    </div>
                </div>
            </div>
        </div>

        @* Scoring Configuration *@
        <div class="feature-category">
            <h2>🎯 <loc key="GameConfig_ScoringConfiguration" /></h2>
            <div class="form-group-grid">
                <div class="form-group">
                    <label asp-for="PointsPer3Match"><loc key="GameConfig_Points3Match" /></label>
                    <input type="number" asp-for="PointsPer3Match" class="form-control" min="0" max="10000" />
                    <small class="form-text text-muted"><loc key="GameConfig_Points3Match_Desc" /></small>
                </div>

                <div class="form-group">
                    <label asp-for="PointsPer4Match"><loc key="GameConfig_Points4Match" /></label>
                    <input type="number" asp-for="PointsPer4Match" class="form-control" min="0" max="10000" />
                    <small class="form-text text-muted"><loc key="GameConfig_Points4Match_Desc" /></small>
                </div>

                <div class="form-group">
                    <label asp-for="PointsPer5PlusMatch"><loc key="GameConfig_Points5Match" /></label>
                    <input type="number" asp-for="PointsPer5PlusMatch" class="form-control" min="0" max="10000" />
                    <small class="form-text text-muted"><loc key="GameConfig_Points5Match_Desc" /></small>
                </div>
            </div>
        </div>

        @* Mega Combo Settings *@
        <div class="feature-category">
            <h2>🎆 <loc key="GameConfig_MegaComboSettings" /></h2>
            <div class="alert alert-info" style="margin-bottom: 1rem;">
                <strong>ℹ️ @Localizer["GameConfig_MegaCombo_HowItWorks"]</strong> @Localizer["GameConfig_MegaCombo_Explanation"]
            </div>

            <div class="form-group-grid">
                <div class="form-group">
                    <label asp-for="MegaComboMultiplier"><loc key="GameConfig_MegaCombo_Multiplier" /></label>
                    <input type="number" asp-for="MegaComboMultiplier" class="form-control" min="1" max="10" />
                    <small class="form-text text-muted"><loc key="GameConfig_MegaCombo_Multiplier_Desc" /></small>
                </div>

                <div class="form-group">
                    <label asp-for="MegaCombo3MatchMinLines"><loc key="GameConfig_MegaCombo_Min3Lines" /></label>
                    <input type="number" asp-for="MegaCombo3MatchMinLines" class="form-control" min="0" max="10" />
                    <small class="form-text text-muted"><loc key="GameConfig_MegaCombo_Min3Lines_Desc" /></small>
                </div>

                <div class="form-group">
                    <label asp-for="MegaCombo4MatchMinLines"><loc key="GameConfig_MegaCombo_Min4Lines" /></label>
                    <input type="number" asp-for="MegaCombo4MatchMinLines" class="form-control" min="0" max="10" />
                    <small class="form-text text-muted"><loc key="GameConfig_MegaCombo_Min4Lines_Desc" /></small>
                </div>

                <div class="form-group">
                    <label asp-for="MegaCombo5MatchMinLines"><loc key="GameConfig_MegaCombo_Min5Lines" /></label>
                    <input type="number" asp-for="MegaCombo5MatchMinLines" class="form-control" min="0" max="10" />
                    <small class="form-text text-muted"><loc key="GameConfig_MegaCombo_Min5Lines_Desc" /></small>
                </div>
            </div>
        </div>

        @* Grid Settings *@
        <div class="feature-category">
            <h2>📐 <loc key="GameConfig_GridSettings" /></h2>
            <div class="form-group-grid">
                <div class="form-group">
                    <label asp-for="GridSize"><loc key="GameConfig_GridSize" /></label>
                    <input type="number" asp-for="GridSize" class="form-control" min="4" max="10" />
                    <small class="form-text text-muted"><loc key="GameConfig_GridSize_Desc" /></small>
                </div>
            </div>
        </div>

        @* Milestone Configuration *@
        <div class="feature-category">
            <h2>🏆 <loc key="GameConfig_Milestones" /></h2>
            <div class="form-group">
                <label asp-for="Milestones"><loc key="GameConfig_Milestones_Label" /></label>
                <input type="text" asp-for="Milestones" class="form-control" placeholder="1000,2500,5000,7500,10000,15000,20000" />
                <small class="form-text text-muted"><loc key="GameConfig_Milestones_Desc" /></small>
            </div>

            @* Milestone Preview *@
            @if (!string.IsNullOrWhiteSpace(Model.Milestones))
            {
                <div class="milestone-preview">
                    <strong>@Localizer["GameConfig_Preview"]:</strong>
                    @foreach (var milestone in Model.Milestones.Split(',', StringSplitOptions.RemoveEmptyEntries))
                    {
                        if (int.TryParse(milestone.Trim(), out var val) && val > 0)
                        {
                            <span class="milestone-chip">🏆 @val.ToString("N0")</span>
                        }
                    }
                </div>
            }
        </div>

        @* Save Button *@
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                💾 @Localizer["GameConfig_SaveConfiguration"]
            </button>
            <a href="/Owner/Index" class="btn btn-secondary">
                ← @Localizer["GameConfig_BackToAdmin"]
            </a>
        </div>
    </form>
</div>

<style>
    .form-group-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5rem;
        margin-top: 1rem;
    }

    .form-group {
        margin-bottom: 0;
    }

    .form-group label {
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 0.5rem;
        display: block;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid var(--border);
        border-radius: 8px;
        font-size: 1rem;
        transition: border-color 0.2s;
    }

    .form-control:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }

    .form-text {
        font-size: 0.875rem;
        color: var(--text-secondary);
        margin-top: 0.25rem;
        display: block;
    }

    .milestone-preview {
        margin-top: 1rem;
        padding: 1rem;
        background: var(--surface-secondary);
        border-radius: 8px;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: center;
    }

    .milestone-chip {
        display: inline-block;
        padding: 0.5rem 1rem;
        background: linear-gradient(135deg, var(--warning) 0%, var(--warning-hover) 100%);
        color: var(--warning-text);
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.875rem;
        box-shadow: var(--shadow-sm);
    }

    .form-actions {
        margin-top: 2rem;
        display: flex;
        gap: 1rem;
        padding-top: 2rem;
        border-top: 1px solid var(--border);
    }

    .btn {
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        border: none;
        font-size: 1rem;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-block;
    }

    .btn-primary {
        background: var(--primary);
        color: white;
    }

    .btn-primary:hover {
        background: var(--primary-dark);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
    }

    .btn-secondary {
        background: var(--surface-secondary);
        color: var(--text-primary);
        border: 1px solid var(--border);
    }

    .btn-secondary:hover {
        background: var(--surface);
        transform: translateY(-1px);
    }
</style>
