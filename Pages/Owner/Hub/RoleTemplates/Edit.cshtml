@page
@model ShiftManager.Pages.Owner.Hub.RoleTemplates.EditModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@using ShiftManager.Models.Support
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = $"{Localizer["Edit"]} - {Model.Template?.Key ?? "Template"}";
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["OwnerHub_Title"], Url = "/Owner/Hub" },
    new BreadcrumbItem { Label = Localizer["RoleTemplates_Title"], Url = "/Owner/Hub/RoleTemplates" },
    new BreadcrumbItem { Label = Model.Template?.Key ?? "Edit", IsActive = true }
})

@if (Model.Template == null)
{
    <div class="alert alert-error"><loc key="RoleTemplates_NotFound">Template not found.</loc></div>
    return;
}

<div class="edit-template-container">
    <div class="page-header">
        <div class="page-header-row">
            <h1>
                <span class="page-icon">&#x1F464;</span>
                <span class="template-key-display">@Model.Template.Key</span>
                @if (Model.Template.IsSystem)
                {
                    <span class="badge badge-system"><loc key="RoleTemplates_SystemBadge">SYSTEM</loc></span>
                }
            </h1>
            <div class="header-stats">
                <span class="header-stat">@Model.UserCount <loc key="RoleTemplates_Users">users</loc></span>
                <span class="header-stat">@Model.TemplateGrants.Count <loc key="RoleTemplates_Grants">grants</loc></span>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error">@Model.ErrorMessage</div>
    }

    <!-- Tabs -->
    <div class="tabs-nav">
        <button class="tab-btn active" data-tab="metadata" onclick="switchTab('metadata', this)">
            <loc key="RoleTemplates_Tab_Metadata">Metadata</loc>
        </button>
        <button class="tab-btn" data-tab="grants" onclick="switchTab('grants', this)">
            <loc key="RoleTemplates_Tab_Grants">Grants</loc>
            <span class="tab-count">@Model.TemplateGrants.Count</span>
        </button>
        <button class="tab-btn" data-tab="labels" onclick="switchTab('labels', this)">
            <loc key="RoleTemplates_Tab_Labels">Job Type Labels</loc>
            <span class="tab-count">@Model.ExistingLabels.Count</span>
        </button>
    </div>

    <!-- Tab: Metadata -->
    <div class="tab-panel active" id="tab-metadata">
        <form method="post" asp-page-handler="Metadata" class="template-form">
            <input type="hidden" asp-for="Id" />

            <div class="form-card">
                <div class="form-grid">
                    <div class="form-group">
                        <label><loc key="RoleTemplates_Key">Key</loc></label>
                        <input type="text" value="@Model.Template.Key" disabled class="input-disabled" />
                        <span class="form-hint"><loc key="RoleTemplates_KeyImmutable">Key cannot be changed after creation</loc></span>
                    </div>

                    <div class="form-group">
                        <label for="DerivedUserRole"><loc key="RoleTemplates_DerivedRole">Derived Role</loc></label>
                        @if (Model.Template.IsSystem)
                        {
                            <input type="hidden" asp-for="DerivedUserRole" />
                            <input type="text" value="@Model.DerivedUserRole" disabled class="input-disabled" />
                            <span class="form-hint"><loc key="RoleTemplates_SystemDerivedRoleLocked">System template derived role cannot be changed</loc></span>
                        }
                        else
                        {
                            <select id="DerivedUserRole" asp-for="DerivedUserRole">
                                @foreach (var role in Enum.GetValues<UserRole>())
                                {
                                    <option value="@role">@role</option>
                                }
                            </select>
                        }
                    </div>

                    <div class="form-group">
                        <label for="DisplayNameEN"><loc key="RoleTemplates_DisplayNameEN">Display Name (English)</loc></label>
                        <input type="text" id="DisplayNameEN" asp-for="DisplayNameEN" maxlength="100" />
                    </div>

                    <div class="form-group">
                        <label for="DisplayNameHE"><loc key="RoleTemplates_DisplayNameHE">Display Name (Hebrew)</loc></label>
                        <input type="text" id="DisplayNameHE" asp-for="DisplayNameHE" maxlength="100" dir="rtl" />
                    </div>

                    <div class="form-group">
                        <label for="ScopeLevel"><loc key="RoleTemplates_Scope">Scope Level</loc></label>
                        @if (Model.Template.IsSystem)
                        {
                            <select id="ScopeLevel" asp-for="ScopeLevel" disabled="disabled">
                                @foreach (var scope in Enum.GetValues<RoleScopeLevel>())
                                {
                                    <option value="@scope">@scope</option>
                                }
                            </select>
                            <input type="hidden" name="ScopeLevel" value="@Model.ScopeLevel" />
                        }
                        else
                        {
                            <select id="ScopeLevel" asp-for="ScopeLevel">
                                @foreach (var scope in Enum.GetValues<RoleScopeLevel>())
                                {
                                    <option value="@scope">@scope</option>
                                }
                            </select>
                        }
                    </div>

                    <div class="form-group">
                        <label for="SortOrder"><loc key="RoleTemplates_SortOrder">Sort Order</loc></label>
                        <input type="number" id="SortOrder" asp-for="SortOrder" min="0" max="9999" />
                    </div>
                </div>

                <div class="form-row-checkboxes">
                    <label class="checkbox-label">
                        <input type="checkbox" asp-for="CanBeAssignedByDefault" />
                        <loc key="RoleTemplates_CanBeAssigned">Can be assigned by default</loc>
                    </label>
                    <label class="checkbox-label">
                        <input type="checkbox" asp-for="IsVisibleInSignup" />
                        <loc key="RoleTemplates_VisibleInSignup">Visible in public signup</loc>
                    </label>
                    <label class="checkbox-label">
                        <input type="checkbox" asp-for="IsActive" />
                        <loc key="RoleTemplates_Active">Active</loc>
                    </label>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary"><loc key="Save">Save</loc></button>
                </div>
            </div>
        </form>
    </div>

    <!-- Tab: Grants -->
    <div class="tab-panel" id="tab-grants">
        <div class="form-card">
            <div class="grants-header">
                <h2><loc key="RoleTemplates_AssignedGrants">Assigned Grants</loc></h2>
                <div class="add-grant-row">
                    <select id="grantTypeSelect">
                        <option value="">-- <loc key="RoleTemplates_SelectGrant">Select Grant</loc> --</option>
                        @foreach (var gt in Model.AllGrantTypes)
                        {
                            var already = Model.TemplateGrants.Any(tg => tg.GrantTypeId == gt.Id);
                            if (!already)
                            {
                                <option value="@gt.Id">@gt.Key (@Localizer[gt.NameKey])</option>
                            }
                        }
                    </select>
                    <button type="button" class="btn btn-primary btn-sm" onclick="addGrant()">
                        + <loc key="Add">Add</loc>
                    </button>
                </div>
            </div>

            <table class="data-table">
                <thead>
                    <tr>
                        <th><loc key="RoleTemplates_GrantKey">Grant</loc></th>
                        <th><loc key="RoleTemplates_Category">Category</loc></th>
                        <th><loc key="RoleTemplates_CanOwn">CanOwn</loc></th>
                        <th><loc key="RoleTemplates_CanGive">CanGive</loc></th>
                        <th><loc key="RoleTemplates_ScopeMode">Scope</loc></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="grantsTableBody">
                    @foreach (var g in Model.TemplateGrants)
                    {
                        <tr id="grant-row-@g.Id">
                            <td>
                                <span class="template-key">@g.GrantType.Key</span>
                                <br><span class="text-muted text-small">@Localizer[g.GrantType.NameKey]</span>
                            </td>
                            <td><span class="badge badge-scope">@g.GrantType.Category</span></td>
                            <td>@(g.CanOwn ? "Yes" : "No")</td>
                            <td>@(g.CanGive ? "Yes" : "No")</td>
                            <td>@g.ScopeMode</td>
                            <td>
                                <button type="button" class="btn btn-danger btn-sm"
                                        onclick="removeGrant(@g.Id)">X</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Model.TemplateGrants.Any())
            {
                <p class="empty-state"><loc key="RoleTemplates_NoGrants">No grants assigned to this template.</loc></p>
            }
        </div>
    </div>

    <!-- Tab: Job Type Labels -->
    <div class="tab-panel" id="tab-labels">
        <form method="post" asp-page-handler="Labels" class="template-form">
            <input type="hidden" asp-for="Id" />

            <div class="form-card">
                <h2><loc key="RoleTemplates_JobTypeLabels">Job Type Labels</loc></h2>
                <p class="section-desc"><loc key="RoleTemplates_JobTypeLabelsDesc">Override display name per job type</loc></p>

                <div id="labelsContainer">
                    @for (int i = 0; i < Model.ExistingLabels.Count; i++)
                    {
                        var label = Model.ExistingLabels[i];
                        <div class="label-row">
                            <select name="LabelJobTypeIds">
                                <option value="0">--</option>
                                @foreach (var jt in Model.AvailableJobTypes)
                                {
                                    if (jt.Id == label.JobTypeId)
                                    {
                                        <option value="@jt.Id" selected>@(jt.DisplayName ?? jt.Name)</option>
                                    }
                                    else
                                    {
                                        <option value="@jt.Id">@(jt.DisplayName ?? jt.Name)</option>
                                    }
                                }
                            </select>
                            <input type="text" name="LabelDisplayNamesEN" value="@label.DisplayNameEN" placeholder="English" />
                            <input type="text" name="LabelDisplayNamesHE" value="@label.DisplayNameHE" placeholder="Hebrew" dir="rtl" />
                            <button type="button" class="btn btn-danger btn-sm" onclick="this.closest('.label-row').remove()">X</button>
                        </div>
                    }
                </div>
                <button type="button" class="btn btn-outline btn-sm" onclick="addLabelRow()">
                    + <loc key="RoleTemplates_AddLabel">Add Label</loc>
                </button>

                <div class="form-actions" style="margin-top: 1rem;">
                    <button type="submit" class="btn btn-primary"><loc key="Save">Save Labels</loc></button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Styles {
<style>
.edit-template-container { max-width: 1100px; margin: 0 auto; padding: 2rem; }
.page-header { margin-bottom: 1.5rem; }
.page-header-row { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; }
.page-header h1 { display: flex; align-items: center; gap: 0.5rem; margin: 0; font-size: 1.75rem; }
.page-icon { font-size: 2rem; }
.template-key-display { font-family: monospace; }
.header-stats { display: flex; gap: 1.5rem; }
.header-stat { font-size: 0.9rem; color: var(--muted); }
.header-stat::first-line { font-weight: 600; color: var(--text); }

.tabs-nav { display: flex; gap: 0; border-bottom: 2px solid var(--border); margin-bottom: 1.5rem; }
.tab-btn {
    padding: 0.75rem 1.25rem; background: none; border: none; border-bottom: 2px solid transparent;
    margin-bottom: -2px; cursor: pointer; font-size: 0.9rem; font-weight: 500; color: var(--muted);
    display: flex; align-items: center; gap: 0.5rem; transition: all 0.15s ease;
}
.tab-btn:hover { color: var(--text); }
.tab-btn.active { color: var(--primary); border-bottom-color: var(--primary); }
.tab-count {
    background: var(--background); border: 1px solid var(--border); border-radius: 999px;
    padding: 0 0.4rem; font-size: 0.7rem; min-width: 1.25rem; text-align: center;
}
.tab-panel { display: none; }
.tab-panel.active { display: block; }

.form-card {
    background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
    padding: 1.5rem; margin-bottom: 1.5rem;
}
.form-card h2 { margin: 0 0 1rem 0; font-size: 1.1rem; }
.section-desc { color: var(--muted); font-size: 0.85rem; margin: -0.5rem 0 1rem 0; }

.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
@@media (max-width: 768px) { .form-grid { grid-template-columns: 1fr; } }
.form-group { display: flex; flex-direction: column; gap: 0.25rem; }
.form-group label { font-size: 0.85rem; font-weight: 600; }
.form-group input, .form-group select {
    padding: 0.5rem 0.75rem; border: 1px solid var(--border); border-radius: 8px;
    background: var(--background); font-size: 0.9rem;
}
.input-disabled { opacity: 0.6; cursor: not-allowed; }
.form-hint { font-size: 0.75rem; color: var(--muted); }

.form-row-checkboxes {
    display: flex; flex-wrap: wrap; gap: 1.5rem; margin-top: 1rem;
    padding-top: 1rem; border-top: 1px solid var(--border);
}
.checkbox-label { display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; cursor: pointer; }

.form-actions { display: flex; gap: 0.75rem; margin-top: 1rem; }

.grants-header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem; }
.grants-header h2 { margin: 0; }
.add-grant-row { display: flex; gap: 0.5rem; align-items: center; }
.add-grant-row select { padding: 0.4rem 0.6rem; border: 1px solid var(--border); border-radius: 6px; font-size: 0.85rem; min-width: 250px; }

.data-table { width: 100%; border-collapse: collapse; }
.data-table th, .data-table td { padding: 0.6rem 0.75rem; text-align: start; border-bottom: 1px solid var(--border); font-size: 0.85rem; }
.data-table th { font-weight: 600; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
.template-key { font-family: monospace; font-weight: 600; }
.text-muted { color: var(--muted); }
.text-small { font-size: 0.75rem; }

.badge { display: inline-block; padding: 0.15rem 0.5rem; border-radius: 4px; font-size: 0.7rem; font-weight: 600; }
.badge-system { background: var(--primary-light, #dbeafe); color: var(--primary); }
.badge-scope { background: var(--background); border: 1px solid var(--border); }

.label-row {
    display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 0.5rem;
    align-items: end; margin-bottom: 0.5rem;
}
@@media (max-width: 768px) { .label-row { grid-template-columns: 1fr; } }
.label-row select, .label-row input {
    padding: 0.5rem; border: 1px solid var(--border); border-radius: 6px;
    font-size: 0.85rem; background: var(--background);
}

.empty-state { color: var(--muted); text-align: center; padding: 2rem; font-style: italic; }

.btn {
    display: inline-flex; align-items: center; gap: 0.25rem;
    padding: 0.5rem 1rem; border-radius: 8px;
    font-size: 0.875rem; font-weight: 500; text-decoration: none;
    border: 1px solid transparent; cursor: pointer; transition: all 0.15s ease;
}
.btn-primary { background: var(--primary); color: white; border-color: var(--primary); }
.btn-primary:hover { opacity: 0.9; }
.btn-outline { background: transparent; color: var(--text); border-color: var(--border); }
.btn-outline:hover { border-color: var(--primary); color: var(--primary); }
.btn-sm { padding: 0.25rem 0.75rem; font-size: 0.8rem; }
.btn-danger { background: transparent; color: var(--danger, #ef4444); border-color: var(--danger, #ef4444); }
.btn-danger:hover { background: var(--danger, #ef4444); color: white; }

.alert { padding: 0.75rem 1rem; border-radius: 8px; margin-bottom: 1rem; font-size: 0.9rem; }
.alert-success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; }
.alert-error { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; }
</style>
}

@section Scripts {
<script>
var templateId = @Model.Id;
var antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

function switchTab(tabName, btn) {
    document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active'); });
    document.querySelectorAll('.tab-btn').forEach(function(b) { b.classList.remove('active'); });
    document.getElementById('tab-' + tabName)?.classList.add('active');
    btn.classList.add('active');
}

function addGrant() {
    var select = document.getElementById('grantTypeSelect');
    var grantTypeId = parseInt(select.value);
    if (!grantTypeId) return;

    fetch('?handler=AddGrant&id=' + templateId, {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': antiForgeryToken
        },
        body: JSON.stringify({ grantTypeId: grantTypeId, canOwn: true, canGive: false, scopeMode: 0 })
    })
    .then(function(r) {
        if (!r.ok) throw new Error('Request failed: ' + r.status);
        return r.json();
    })
    .then(function(data) {
        if (data.success) {
            window.location.reload();
        } else {
            alert(data.error || 'Failed to add grant');
        }
    })
    .catch(function(err) { alert('Error: ' + err.message); });
}

function removeGrant(grantId) {
    if (!confirm('Remove this grant from the template?')) return;

    fetch('?handler=RemoveGrant&id=' + templateId, {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': antiForgeryToken
        },
        body: JSON.stringify({ grantId: grantId })
    })
    .then(function(r) {
        if (!r.ok) throw new Error('Request failed: ' + r.status);
        return r.json();
    })
    .then(function(data) {
        if (data.success) {
            var row = document.getElementById('grant-row-' + grantId);
            if (row) row.remove();
        } else {
            alert(data.error || 'Failed to remove grant');
        }
    })
    .catch(function(err) { alert('Error: ' + err.message); });
}

var availableJobTypes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.AvailableJobTypes.Select(jt => new { jt.Id, Name = jt.DisplayName ?? jt.Name })));

function addLabelRow() {
    var container = document.getElementById('labelsContainer');
    var row = document.createElement('div');
    row.className = 'label-row';

    var select = document.createElement('select');
    select.name = 'LabelJobTypeIds';
    var defaultOpt = document.createElement('option');
    defaultOpt.value = '0';
    defaultOpt.textContent = '-- Select --';
    select.appendChild(defaultOpt);
    availableJobTypes.forEach(function(jt) {
        var opt = document.createElement('option');
        opt.value = jt.id;
        opt.textContent = jt.name;
        select.appendChild(opt);
    });

    var inputEN = document.createElement('input');
    inputEN.type = 'text';
    inputEN.name = 'LabelDisplayNamesEN';
    inputEN.placeholder = 'English';

    var inputHE = document.createElement('input');
    inputHE.type = 'text';
    inputHE.name = 'LabelDisplayNamesHE';
    inputHE.placeholder = 'Hebrew';
    inputHE.dir = 'rtl';

    var removeBtn = document.createElement('button');
    removeBtn.type = 'button';
    removeBtn.className = 'btn btn-danger btn-sm';
    removeBtn.textContent = 'X';
    removeBtn.onclick = function() { row.remove(); };

    row.appendChild(select);
    row.appendChild(inputEN);
    row.appendChild(inputHE);
    row.appendChild(removeBtn);
    container.appendChild(row);
}
</script>
}
