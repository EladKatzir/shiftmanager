@page
@model ShiftManager.Pages.Owner.SystemHealthModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["Owner_SystemHealth"];
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Owner_AdminPanel"], Url = "/Owner/Index" },
    new BreadcrumbItem { Label = Localizer["Owner_SystemHealth"], IsActive = true }
})

<div class="system-health-container">
    <div class="page-header">
        <h1>
            <span class="page-icon"><icon name="heart" /></span>
            @Localizer["Owner_SystemHealth"]
        </h1>
    </div>

    @* Overall Status *@
    <div class="health-status-card @(Model.OverallStatus == "Healthy" ? "status-healthy" : "status-warning")">
        <div class="status-icon">@(Model.OverallStatus == "Healthy" ? "✅" : "⚠️")</div>
        <div class="status-content">
            <h2>@Model.OverallStatus</h2>
            <p>@Localizer["Owner_SystemHealth_LastChecked"] @DateTime.Now.ToString("g")</p>
        </div>
        <button onclick="location.reload()" class="btn btn-ghost"><icon name="refresh-cw" /> @Localizer["Owner_SystemHealth_Refresh"]</button>
    </div>

    @* Security Warnings (fixes D-01, B-06, H-07, B-10) *@
    @if (Model.SecurityWarnings.Count > 0)
    {
        <div class="health-check-card" style="border: 2px solid var(--danger); background: var(--danger-bg, rgba(220,53,69,0.1)); margin-bottom: 1rem;">
            <div class="check-header">
                <h3><icon name="lock" /> @Localizer["Owner_SystemHealth_SecurityWarnings"]</h3>
                <span class="status-badge badge-error">@Localizer["Owner_SystemHealth_ActionRequired"]</span>
            </div>
            <div class="check-details">
                @foreach (var warning in Model.SecurityWarnings)
                {
                    <div class="detail-item" style="color: var(--danger, #dc3545); font-weight: 600;">
                        <span><icon name="alert-triangle" /> @warning</span>
                    </div>
                }
            </div>
        </div>
    }

    @* Health Checks Grid *@
    <div class="health-checks-grid">
        @* Database Health *@
        <div class="health-check-card">
            <div class="check-header">
                <h3><icon name="database" /> @Localizer["Owner_SystemHealth_Database"]</h3>
                <span class="status-badge @(Model.DatabaseHealthy ? "badge-success" : "badge-error")">
                    @(Model.DatabaseHealthy ? Localizer["Owner_SystemHealth_Healthy"] : Localizer["Owner_SystemHealth_Error"])
                </span>
            </div>
            <div class="check-details">
                <div class="detail-item">
                    <span class="label">@Localizer["Owner_SystemHealth_Size"]</span>
                    <span class="value">@Model.DatabaseSize</span>
                </div>
                <div class="detail-item">
                    <span class="label">@Localizer["Owner_SystemHealth_Tables"]</span>
                    <span class="value">@Model.TableCount</span>
                </div>
                <div class="detail-item">
                    <span class="label">@Localizer["Owner_SystemHealth_Records"]</span>
                    <span class="value">@Model.TotalRecords.ToString("N0")</span>
                </div>
            </div>
        </div>

        @* Memory Usage *@
        <div class="health-check-card">
            <div class="check-header">
                <h3><icon name="bar-chart-2" /> @Localizer["Owner_SystemHealth_Memory"]</h3>
                <span class="status-badge @(Model.MemoryHealthy ? "badge-success" : "badge-warning")">
                    @(Model.MemoryHealthy ? Localizer["Owner_SystemHealth_Healthy"] : Localizer["Owner_SystemHealth_High"])
                </span>
            </div>
            <div class="check-details">
                <div class="detail-item">
                    <span class="label">@Localizer["Owner_SystemHealth_Used"]</span>
                    <span class="value">@Model.MemoryUsedMB MB</span>
                </div>
                <div class="detail-item">
                    <span class="label">GC Gen 0:</span>
                    <span class="value">@Model.GCGen0Collections</span>
                </div>
                <div class="detail-item">
                    <span class="label">GC Gen 2:</span>
                    <span class="value">@Model.GCGen2Collections</span>
                </div>
            </div>
        </div>

        @* Application Uptime *@
        <div class="health-check-card">
            <div class="check-header">
                <h3><icon name="clock" /> @Localizer["Owner_SystemHealth_Uptime"]</h3>
                <span class="status-badge badge-info">@Localizer["Owner_SystemHealth_Running"]</span>
            </div>
            <div class="check-details">
                <div class="detail-item">
                    <span class="label">@Localizer["Owner_SystemHealth_Started"]</span>
                    <span class="value">@Model.StartTime.ToString("g")</span>
                </div>
                <div class="detail-item">
                    <span class="label">@Localizer["Owner_SystemHealth_Duration"]</span>
                    <span class="value">@Model.Uptime</span>
                </div>
                <div class="detail-item">
                    <span class="label">@Localizer["Owner_SystemHealth_Environment"]</span>
                    <span class="value">@Model.Environment</span>
                </div>
            </div>
        </div>

        @* Configuration Status *@
        <div class="health-check-card">
            <div class="check-header">
                <h3><icon name="settings" /> @Localizer["Owner_SystemHealth_Configuration"]</h3>
                <span class="status-badge badge-success">@Localizer["Owner_SystemHealth_OK"]</span>
            </div>
            <div class="check-details">
                <div class="detail-item">
                    <span class="label">@Localizer["Owner_SystemHealth_Email"]</span>
                    <span class="value">@(Model.EmailConfigured ? "✅ " + Localizer["Owner_SystemHealth_Configured"].Value : "❌ " + Localizer["Owner_SystemHealth_NotConfigured"].Value)</span>
                </div>
                <div class="detail-item">
                    <span class="label">@Localizer["Owner_SystemHealth_ADFS"]</span>
                    <span class="value">@(Model.AdfsConfigured ? "✅ " + Localizer["Owner_SystemHealth_Configured"].Value : "❌ " + Localizer["Owner_SystemHealth_NotConfigured"].Value)</span>
                </div>
                <div class="detail-item">
                    <span class="label">@Localizer["Owner_SystemHealth_DailyNotifications"]</span>
                    <span class="value">@(Model.DailyNotificationsEnabled ? "✅ " + Localizer["Owner_SystemHealth_Enabled"].Value : "⏸️ " + Localizer["Owner_SystemHealth_Disabled"].Value)</span>
                </div>
                <div class="detail-item">
                    <span class="label">@Localizer["Owner_SystemHealth_Companies"]</span>
                    <span class="value">@Model.CompanyCount</span>
                </div>
                <div class="detail-item">
                    <span class="label">@Localizer["Owner_SystemHealth_Users"]</span>
                    <span class="value">@Model.UserCount</span>
                </div>
            </div>
        </div>
    </div>

    @* Detailed Logs *@
    <div class="health-logs">
        <h2><icon name="file-text" /> @Localizer["Owner_SystemHealth_RecentLogs"]</h2>
        <div class="logs-stats">
            <div class="log-stat">
                <span class="log-count error">@Model.ErrorCount</span>
                <span class="log-label">@Localizer["Owner_SystemHealth_Errors"]</span>
            </div>
            <div class="log-stat">
                <span class="log-count warning">@Model.WarningCount</span>
                <span class="log-label">@Localizer["Owner_SystemHealth_Warnings"]</span>
            </div>
            <div class="log-stat">
                <span class="log-count info">@Model.InfoCount</span>
                <span class="log-label">@Localizer["Owner_SystemHealth_Info"]</span>
            </div>
        </div>
        @if (Model.ErrorCount > 0)
        {
            <div class="alert alert-warning">
                <strong><icon name="alert-triangle" /> @Localizer["Owner_SystemHealth_Attention"]</strong> @Model.ErrorCount @Localizer["Owner_SystemHealth_ErrorsDetected"]
            </div>
        }
    </div>
</div>

<style>
.system-health-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
}

.health-status-card {
    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
}

.health-status-card.status-healthy {
    border-color: var(--success);
    background: var(--success-soft);
}

.health-status-card.status-warning {
    border-color: var(--warning);
    background: var(--warning-soft);
}

.status-icon {
    font-size: 3rem;
}

.status-content h2 {
    margin: 0 0 0.25rem 0;
    font-size: 1.5rem;
}

.status-content p {
    margin: 0;
    color: var(--muted);
}

.health-checks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
}

.health-check-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
}

.check-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
}

.check-header h3 {
    margin: 0;
    font-size: 1.125rem;
}

.status-badge {
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
}

.badge-success {
    background: var(--success-soft);
    color: var(--success) !important;
}

.badge-error {
    background: var(--danger-soft);
    color: var(--danger) !important;
}

.badge-warning {
    background: var(--warning-soft);
    color: var(--warning) !important;
}

.badge-info {
    background: var(--primary-soft);
    color: var(--primary);
}

.check-details {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.detail-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.detail-item .label {
    color: var(--muted);
    font-size: 0.875rem;
}

.detail-item .value {
    font-weight: 600;
}

.health-logs {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
}

.health-logs h2 {
    margin: 0 0 1rem 0;
    font-size: 1.25rem;
}

.logs-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
}

.log-stat {
    text-align: center;
    padding: 1rem;
    background: var(--background);
    border-radius: 8px;
}

.log-count {
    display: block;
    font-size: 2rem;
    font-weight: bold;
    margin-bottom: 0.25rem;
}

.log-count.error {
    color: var(--danger);
}

.log-count.warning {
    color: var(--warning);
}

.log-count.info {
    color: var(--primary);
}

.log-label {
    font-size: 0.875rem;
    color: var(--muted);
}

.alert {
    padding: 1rem;
    border-radius: 8px;
    margin-top: 1rem;
}

.alert-warning {
    background: var(--warning-soft);
    border: 1px solid var(--warning);
    color: var(--warning);
}
</style>
