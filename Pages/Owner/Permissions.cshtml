@page
@model ShiftManager.Pages.Owner.PermissionsModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@inject ShiftManager.Services.ILocalizationService Localization
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["Owner_Permissions"];
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Owner_AdminPanel"], Url = "/Owner" },
    new BreadcrumbItem { Label = Localizer["Owner_Permissions"], IsActive = true }
})

<div class="permissions-container">
    <div class="page-header">
        <h1>
            <span class="page-icon">🔐</span>
            <loc key="Owner_Permissions" />
        </h1>
        <p class="page-subtitle"><loc key="Owner_Permissions_Desc" /></p>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon">📊</div>
            <div class="stat-content">
                <div class="stat-value">@Model.TotalGrants</div>
                <div class="stat-label"><loc key="Permissions_TotalGrants" /></div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">👥</div>
            <div class="stat-content">
                <div class="stat-value">@Model.UsersWithGrants</div>
                <div class="stat-label"><loc key="Permissions_UsersWithGrants" /></div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">🤖</div>
            <div class="stat-content">
                <div class="stat-value">@Model.AutoGrants</div>
                <div class="stat-label"><loc key="Permissions_AutoGrants" /></div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">✋</div>
            <div class="stat-content">
                <div class="stat-value">@Model.ManualGrants</div>
                <div class="stat-label"><loc key="Permissions_ManualGrants" /></div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="section-card">
        <h2 class="section-header"><loc key="QuickActions" /></h2>
        <div class="quick-actions">
            <a href="/Admin/Organization/Grants" class="action-card">
                <div class="action-icon">📋</div>
                <div class="action-content">
                    <h3><loc key="ViewAllGrants" /></h3>
                    <p><loc key="ViewAllGrants_Desc" /></p>
                </div>
                <div class="action-arrow">→</div>
            </a>
            <a href="/Admin/Organization/Grants/Assign" class="action-card">
                <div class="action-icon">➕</div>
                <div class="action-content">
                    <h3><loc key="AssignGrant" /></h3>
                    <p><loc key="AssignGrant_Desc" /></p>
                </div>
                <div class="action-arrow">→</div>
            </a>
            <a href="/Admin/Organization/Roles" class="action-card">
                <div class="action-icon">👔</div>
                <div class="action-content">
                    <h3><loc key="ManageRoles" /></h3>
                    <p><loc key="ManageRoles_Desc" /></p>
                </div>
                <div class="action-arrow">→</div>
            </a>
        </div>
    </div>

    <div class="two-column-grid">
        <!-- Grant Type Breakdown -->
        <div class="section-card">
            <h2 class="section-header"><loc key="Permissions_GrantTypeBreakdown" /></h2>
            @if (Model.GrantTypeStats.Any())
            {
                <div class="grant-type-list">
                    @foreach (var stat in Model.GrantTypeStats)
                    {
                        <div class="grant-type-item">
                            <div class="grant-type-name">@Localizer[stat.NameKey]</div>
                            <div class="grant-type-category">@stat.Category</div>
                            <div class="grant-type-count">@stat.Count</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="empty-state"><loc key="NoGrantsFound" /></p>
            }
        </div>

        <!-- Recent Grants -->
        <div class="section-card">
            <h2 class="section-header"><loc key="Permissions_RecentGrants" /></h2>
            @if (Model.RecentGrants.Any())
            {
                <div class="recent-grants-list">
                    @foreach (var grant in Model.RecentGrants)
                    {
                        <div class="recent-grant-item">
                            <div class="grant-user">@grant.UserName</div>
                            <div class="grant-type">@Localizer[grant.GrantTypeName]</div>
                            <div class="grant-meta">
                                @if (grant.IsAutoGrant)
                                {
                                    <span class="badge badge-auto"><loc key="Auto" /></span>
                                }
                                else
                                {
                                    <span class="badge badge-manual">@(grant.GrantedByName ?? Localizer["Manual"])</span>
                                }
                                <span class="grant-date">@Localization.FormatShortDate(grant.GrantedAt)</span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="empty-state"><loc key="NoGrantsFound" /></p>
            }
        </div>
    </div>
</div>

<style>
.permissions-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
}

.page-header {
    margin-bottom: 2rem;
}

.page-header h1 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.5rem 0;
    font-size: 2rem;
}

.page-icon {
    font-size: 2.5rem;
}

.page-subtitle {
    color: var(--text-muted);
    margin: 0;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
}

.stat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
}

.stat-icon {
    font-size: 2rem;
}

.stat-value {
    font-size: 1.75rem;
    font-weight: bold;
    color: var(--primary);
}

.stat-label {
    color: var(--text-muted);
    font-size: 0.875rem;
}

.section-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 2rem;
}

.section-header {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0 0 1.25rem 0;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
}

.quick-actions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
}

.action-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--surface-soft);
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
}

.action-card:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
}

.action-icon {
    font-size: 1.75rem;
    flex-shrink: 0;
}

.action-content {
    flex: 1;
}

.action-content h3 {
    margin: 0 0 0.25rem 0;
    font-size: 1rem;
}

.action-content p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.8125rem;
}

.action-arrow {
    font-size: 1.25rem;
    color: var(--text-muted);
}

.two-column-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 2rem;
}

.grant-type-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.grant-type-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem;
    background: var(--surface-soft);
    border-radius: 8px;
}

.grant-type-name {
    flex: 1;
    font-weight: 500;
}

.grant-type-category {
    color: var(--text-muted);
    font-size: 0.75rem;
    text-transform: uppercase;
}

.grant-type-count {
    background: var(--primary-soft);
    color: var(--primary);
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
}

.recent-grants-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.recent-grant-item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    background: var(--surface-soft);
    border-radius: 8px;
}

.grant-user {
    font-weight: 500;
    min-width: 120px;
}

.grant-type {
    color: var(--text-muted);
    font-size: 0.875rem;
    flex: 1;
}

.grant-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.badge {
    display: inline-flex;
    padding: 0.25rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
}

.badge-auto {
    background: var(--primary-soft);
    color: var(--primary);
}

.badge-manual {
    background: var(--success-soft);
    color: var(--success);
}

.grant-date {
    color: var(--text-muted);
    font-size: 0.75rem;
}

.empty-state {
    text-align: center;
    padding: 2rem;
    color: var(--text-muted);
}

@@media (max-width: 768px) {
    .permissions-container {
        padding: 1rem;
    }

    .page-header h1 {
        font-size: 1.5rem;
    }

    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .two-column-grid {
        grid-template-columns: 1fr;
    }
}
</style>
