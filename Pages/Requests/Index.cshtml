@page
@model ShiftManager.Pages.Requests.IndexModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@inject ShiftManager.Services.ILocalizationService Localization
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["Requests"];
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Requests"], IsActive = true }
})

<div data-ui-version="v2">

@section Styles {
    <style>
        /* Page Header */
        .page-header {
            margin-bottom: 2rem;
        }

        .page-header-title {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text);
            margin: 0 0 0.5rem 0;
            line-height: 1.2;
        }

        .page-subtitle {
            font-size: 1rem;
            color: var(--text-muted);
            margin: 0;
            line-height: 1.5;
        }

        .page-header-actions {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .page-header-content {
            flex: 1;
        }

        /* Error Alert */
        .alert-error {
            padding: 1rem 1.25rem;
            border-radius: 10px;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 0.9375rem;
            font-weight: 500;
            background: var(--danger);
            color: var(--danger-text);
            border: 1px solid rgba(var(--danger-rgb, 244, 67, 54), 0.3);
        }

        /* Section */
        .requests-section {
            margin-bottom: 2rem;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

        .section-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--text);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .count-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 1.75rem;
            height: 1.75rem;
            padding: 0 0.5rem;
            background: var(--primary);
            color: var(--primary-contrast);
            border-radius: 12px;
            font-size: 0.8125rem;
            font-weight: 600;
        }

        /* ✅ Phase 18: Tab Navigation */
        .tab-navigation {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 2rem;
            border-bottom: 2px solid var(--border);
            overflow-x: auto;
        }

        .tab-button {
            padding: 0.875rem 1.5rem;
            font-size: 0.9375rem;
            font-weight: 500;
            color: var(--text-muted);
            background: transparent;
            border: none;
            border-bottom: 3px solid transparent;
            cursor: pointer;
            transition: all 0.2s ease;
            white-space: nowrap;
            margin-bottom: -2px;
        }

        .tab-button:hover {
            color: var(--text);
            background: var(--surface-soft);
        }

        .tab-button.active {
            color: var(--primary);
            border-bottom-color: var(--primary);
            font-weight: 600;
        }

        .tab-button:focus {
            outline: 2px solid var(--primary);
            outline-offset: 2px;
        }

        .tab-button:focus:not(:focus-visible) {
            outline: none;
        }

        .tab-button:focus-visible {
            outline: 2px solid var(--primary);
            outline-offset: 2px;
        }

        .tab-panel {
            display: none;
        }

        .tab-panel.active {
            display: block;
        }

        /* Request Card */
        .request-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 1rem;
            transition: all 0.2s ease;
            box-shadow: var(--shadow-sm);
        }

        .request-card:hover {
            box-shadow: var(--shadow-md);
            transform: translateY(-2px);
        }

        .request-card:last-child {
            margin-bottom: 0;
        }

        .request-content {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 1.5rem;
        }

        .request-details {
            flex: 1;
            min-width: 0;
        }

        .request-user {
            font-size: 1rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.625rem;
        }

        .user-icon {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: var(--primary);
            color: var(--primary-contrast);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.875rem;
            font-weight: 600;
            flex-shrink: 0;
        }

        .request-info {
            display: flex;
            flex-direction: column;
            gap: 0.375rem;
        }

        .request-info-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.875rem;
            color: var(--text-muted);
        }

        .request-info-item .icon {
            font-size: 1rem;
            opacity: 0.7;
        }

        .request-info-item .label {
            font-weight: 500;
        }

        .request-reason {
            margin-top: 0.75rem;
            padding: 0.75rem;
            background: var(--surface-soft);
            border-radius: 8px;
            font-size: 0.875rem;
            color: var(--text-muted);
            border-left: 3px solid var(--primary);
        }

        /* Actions */
        .request-actions {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            flex-shrink: 0;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            padding: 0.625rem 1.25rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.15s ease;
            text-decoration: none;
            white-space: nowrap;
        }

        .btn-approve {
            background: var(--success);
            color: var(--success-text);
            border-color: var(--success);
        }

        .btn-approve:hover {
            background: var(--success-hover);
            border-color: var(--success-hover);
            transform: translateY(-1px);
            box-shadow: var(--shadow-md);
        }

        .btn-decline {
            background: var(--surface-soft);
            color: var(--text);
            border-color: var(--border);
        }

        .btn-decline:hover {
            background: var(--danger);
            color: var(--danger-text);
            border-color: var(--danger);
            transform: translateY(-1px);
            box-shadow: var(--shadow-sm);
        }

        .btn-secondary {
            background: var(--surface-soft);
            color: var(--text);
            border-color: var(--border);
        }

        .btn-secondary:hover {
            background: var(--surface-elevated);
            border-color: var(--primary);
            transform: translateY(-1px);
            box-shadow: var(--shadow-sm);
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 3rem 2rem;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: var(--shadow-sm);
        }

        .empty-state-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
            opacity: 0.5;
        }

        .empty-state-title {
            font-size: 1.125rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 0.5rem;
        }

        .empty-state-text {
            font-size: 0.9375rem;
            color: var(--text-muted);
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .request-content {
                flex-direction: column;
                gap: 1rem;
            }

            .request-actions {
                flex-direction: row;
                width: 100%;
            }

            .btn {
                flex: 1;
            }

            .page-header-actions {
                flex-direction: column;
                align-items: stretch;
            }

            .page-header-title {
                font-size: 1.75rem;
            }
        }

        @@media (max-width: 480px) {
            .request-card {
                padding: 1.25rem;
            }

            .page-header-title {
                font-size: 1.5rem;
            }

            .request-actions {
                flex-direction: column;
            }

            .btn {
                width: 100%;
            }
        }
    </style>
}

<!-- Page Header -->
<div class="page-header">
    <h2 class="page-header-title"><loc key="Requests" /></h2>
    @if (Model.IsManager)
    {
        <p class="page-subtitle"><loc key="ReviewAndApproveTeamRequests" /></p>
    }
    else
    {
        <p class="page-subtitle"><loc key="ViewYourRequests" /></p>
    }
</div>

<!-- Error/Success Messages -->
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert-error">
        <span style="font-size: 1.25rem;">✗</span>
        <span>@Model.Error</span>
    </div>
}
@if (!string.IsNullOrEmpty(Model.Message))
{
    <div style="padding: 1rem 1.25rem; border-radius: 10px; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem; font-size: 0.9375rem; font-weight: 500; background: var(--success); color: var(--success-text); border: 1px solid rgba(var(--success-rgb, 16, 185, 129), 0.3);">
        <span style="font-size: 1.25rem;">✓</span>
        <span>@Model.Message</span>
    </div>
}

<!-- ✅ Phase 18: Tab Navigation (WCAG 2.1 compliant) -->
<div class="tab-navigation" role="tablist" aria-label="@Localizer["Requests"]">
    <button class="tab-button active"
            id="tab-btn-timeoff"
            data-tab="timeoff"
            role="tab"
            aria-selected="true"
            aria-controls="tab-timeoff"
            tabindex="0">
        @Localizer["PendingTimeOffTab"]
        @if (Model.TimeOff.Any())
        {
            <span class="count-badge" style="margin-inline-start: 0.5rem;" aria-label="@Model.TimeOff.Count @Localizer["Requests"]">@Model.TimeOff.Count</span>
        }
    </button>
    <button class="tab-button"
            id="tab-btn-swaps"
            data-tab="swaps"
            role="tab"
            aria-selected="false"
            aria-controls="tab-swaps"
            tabindex="-1">
        @Localizer["PendingSwapsTab"]
        @if (Model.Swaps.Any())
        {
            <span class="count-badge" style="margin-inline-start: 0.5rem;" aria-label="@Model.Swaps.Count @Localizer["Requests"]">@Model.Swaps.Count</span>
        }
    </button>
    <button class="tab-button"
            id="tab-btn-approved"
            data-tab="approved"
            role="tab"
            aria-selected="false"
            aria-controls="tab-approved"
            tabindex="-1">
        @Localizer["ApprovedTimeOffTab"]
        @if (Model.ApprovedTimeOffs.Any())
        {
            <span class="count-badge" style="margin-inline-start: 0.5rem;" aria-label="@Model.ApprovedTimeOffs.Count @Localizer["Requests"]">@Model.ApprovedTimeOffs.Count</span>
        }
    </button>
</div>

<!-- ✅ Phase 18: Tab Panel 1 - Pending Time-Off -->
<div class="tab-panel active" id="tab-timeoff" role="tabpanel" aria-labelledby="tab-btn-timeoff" tabindex="0">
    <div class="requests-section">
        <div class="section-header">
            <h2 class="section-title">
                <span>📅</span>
                <span><loc key="PendingTimeOff" /></span>
                @if (Model.TimeOff.Any())
                {
                    <span class="count-badge">@Model.TimeOff.Count</span>
                }
            </h2>
        </div>

    @if (Model.TimeOff.Any())
    {
        foreach (var r in Model.TimeOff)
        {
            <div class="request-card">
                <div class="request-content">
                    <div class="request-details">
                        <div class="request-user">
                            <div class="user-icon">
                                @r.UserName.Substring(0, Math.Min(2, r.UserName.Length)).ToUpper()
                            </div>
                            <span>@r.UserName</span>
                        </div>

                        <div class="request-info">
                            <div class="request-info-item">
                                <span class="icon">📅</span>
                                <span class="label"><loc key="Dates" />:</span>
                                <span>@Localization.FormatMediumDate(r.StartDate) → @Localization.FormatMediumDate(r.EndDate)</span>
                            </div>
                            <div class="request-info-item">
                                <span class="icon">⏱️</span>
                                <span class="label"><loc key="Duration" />:</span>
                                <span>@((r.EndDate.DayNumber - r.StartDate.DayNumber + 1)) <loc key="Days" /></span>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(r.Reason))
                        {
                            <div class="request-reason">
                                <strong>@Localizer["Reason"]:</strong> @r.Reason
                            </div>
                        }
                    </div>

                    @if (Model.IsManager)
                    {
                    <div class="request-actions">
                        <form method="post" asp-page-handler="ApproveTimeOff" style="margin: 0;">
                            <input type="hidden" name="id" value="@r.Id" />
                            <button type="submit" class="btn btn-approve">
                                <span>✓</span>
                                <span><loc key="Approve" /></span>
                            </button>
                        </form>
                        <form method="post" asp-page-handler="DeclineTimeOff" style="margin: 0;">
                            <input type="hidden" name="id" value="@r.Id" />
                            <button type="submit" class="btn btn-decline">
                                <span>✗</span>
                                <span><loc key="Decline" /></span>
                            </button>
                        </form>
                    </div>
                    }
                    else
                    {
                    <div class="request-actions">
                        <div style="padding: 0.5rem 1rem; border-radius: 6px; font-size: 0.875rem; font-weight: 500; text-align: center; background: var(--warning-soft, #fff3cd); color: var(--warning, #856404);">
                            <loc key="PendingApproval" />
                        </div>
                    </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">✓</div>
            <div class="empty-state-title"><loc key="NoTimeOffRequestsYet" /></div>
            <div class="empty-state-text"><loc key="AllCaughtUp" /></div>
        </div>
    }
    </div>
</div>

<!-- ✅ Phase 18: Tab Panel 2 - Pending Swaps -->
<div class="tab-panel" id="tab-swaps" role="tabpanel" aria-labelledby="tab-btn-swaps" tabindex="0">
    <div class="requests-section">
        <div class="section-header">
            <h2 class="section-title">
                <span>🔄</span>
                <span><loc key="PendingSwaps" /></span>
                @if (Model.Swaps.Any())
                {
                    <span class="count-badge">@Model.Swaps.Count</span>
                }
            </h2>
        </div>

    @if (Model.Swaps.Any())
    {
        foreach (var s in Model.Swaps)
        {
            <div class="request-card">
                <div class="request-content">
                    <div class="request-details">
                        <div class="request-user">
                            <div class="user-icon">
                                @s.FromUser.Substring(0, Math.Min(2, s.FromUser.Length)).ToUpper()
                            </div>
                            <span>@s.FromUser</span>
                        </div>

                        <div class="request-info">
                            <div class="request-info-item">
                                <span class="icon">📅</span>
                                <span class="label"><loc key="Shift" />:</span>
                                <span>@s.When</span>
                            </div>
                            <div class="request-info-item">
                                <span class="icon">→</span>
                                <span class="label"><loc key="ProposedTo" />:</span>
                                <span>@s.ToUser</span>
                            </div>
                        </div>
                    </div>

                    @if (Model.IsManager)
                    {
                    <div class="request-actions">
                        <form method="post" asp-page-handler="ApproveSwap" style="margin: 0;">
                            <input type="hidden" name="id" value="@s.Id" />
                            <button type="submit" class="btn btn-approve">
                                <span>✓</span>
                                <span><loc key="Approve" /></span>
                            </button>
                        </form>
                        <form method="post" asp-page-handler="DeclineSwap" style="margin: 0;">
                            <input type="hidden" name="id" value="@s.Id" />
                            <button type="submit" class="btn btn-decline">
                                <span>✗</span>
                                <span><loc key="Decline" /></span>
                            </button>
                        </form>
                    </div>
                    }
                    else
                    {
                    <div class="request-actions">
                        <div style="padding: 0.5rem 1rem; border-radius: 6px; font-size: 0.875rem; font-weight: 500; text-align: center; background: var(--warning-soft, #fff3cd); color: var(--warning, #856404);">
                            <loc key="PendingApproval" />
                        </div>
                    </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">✓</div>
            <div class="empty-state-title"><loc key="NoSwapRequestsYet" /></div>
            <div class="empty-state-text"><loc key="AllCaughtUp" /></div>
        </div>
    }
    </div>
</div>

<!-- ✅ Phase 18: Tab Panel 3 - Approved Time-Off -->
<div class="tab-panel" id="tab-approved" role="tabpanel" aria-labelledby="tab-btn-approved" tabindex="0">
    <div class="requests-section">
        <div class="section-header">
            <h2 class="section-title">
                <span>📋</span>
                <span><loc key="ApprovedTimeOffRequests" /></span>
                @if (Model.ApprovedTimeOffs.Any())
                {
                    <span class="count-badge">@Model.ApprovedTimeOffs.Count</span>
                }
            </h2>
        </div>

        @if (Model.ApprovedTimeOffs.Any())
        {
            foreach (var timeOff in Model.ApprovedTimeOffs)
            {
                var days = timeOff.EndDate.DayNumber - timeOff.StartDate.DayNumber + 1;
                var isPast = timeOff.StartDate < DateOnly.FromDateTime(DateTime.Today);
                var isToday = timeOff.StartDate == DateOnly.FromDateTime(DateTime.Today);
                var isFuture = timeOff.StartDate > DateOnly.FromDateTime(DateTime.Today);

                <div class="request-card">
                    <div class="request-content">
                        <div class="request-details">
                            <div class="request-user">
                                <div class="user-icon">
                                    @timeOff.UserName.Substring(0, Math.Min(2, timeOff.UserName.Length)).ToUpper()
                                </div>
                                <span>@timeOff.UserName</span>
                            </div>

                            <div class="request-info">
                                <div class="request-info-item">
                                    <span class="icon">📅</span>
                                    <span class="label"><loc key="Dates" />:</span>
                                    <span>
                                        @Localization.FormatMediumDate(timeOff.StartDate)
                                        @if (timeOff.StartDate != timeOff.EndDate)
                                        {
                                            <text> → @Localization.FormatMediumDate(timeOff.EndDate)</text>
                                        }
                                    </span>
                                </div>
                                <div class="request-info-item">
                                    <span class="icon">⏱️</span>
                                    <span class="label"><loc key="Duration" />:</span>
                                    <span>@days @(days == 1 ? Localizer["Day"] : Localizer["Days"])</span>
                                </div>
                                <div class="request-info-item">
                                    <span class="icon">📝</span>
                                    <span class="label"><loc key="RequestedOn" />:</span>
                                    <span>@Localization.FormatDateTime(timeOff.CreatedAt)</span>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(timeOff.Reason))
                            {
                                <div class="request-reason">
                                    <strong>@Localizer["Reason"]:</strong> @timeOff.Reason
                                </div>
                            }
                            else
                            {
                                <div class="request-reason" style="font-style: italic; color: var(--text-muted);">
                                    @Localizer["NoReasonProvided"]
                                </div>
                            }
                        </div>

                        <div class="request-actions">
                            @if (Model.IsManager && isFuture)
                            {
                                <form method="post" asp-page-handler="DeleteTimeOff" style="margin: 0;"
                                      data-confirm-modal
                                      data-confirm-title="@Localizer["ConfirmDeleteTimeOff_Title"]"
                                      data-confirm-message="@string.Format(Localizer["ConfirmDeleteTimeOff"].Value, timeOff.UserName)"
                                      data-confirm-action="@Localizer["Delete"]"
                                      data-confirm-level="danger">
                                    <input type="hidden" name="id" value="@timeOff.Id" />
                                    <button type="submit" class="btn btn-decline">
                                        <span>🗑️</span>
                                        <span><loc key="Delete" /></span>
                                    </button>
                                </form>
                            }
                            else if (isFuture)
                            {
                                <div style="padding: 0.5rem 1rem; border-radius: 6px; font-size: 0.875rem; font-weight: 600; text-align: center; background: var(--success-soft); color: var(--success);">
                                    @Localizer["Approved"]
                                </div>
                            }
                            else
                            {
                                <div style="padding: 0.5rem 1rem; border-radius: 6px; font-size: 0.875rem; font-weight: 600; text-align: center;
                                            @(isToday ? "background: var(--success-soft); color: var(--success);" : "background: var(--surface-soft); color: var(--text-muted);")">
                                    @if (isToday)
                                    {
                                        @Localizer["ActiveToday"]
                                    }
                                    else
                                    {
                                        @Localizer["Past"]
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <div style="margin-top: 1.5rem; padding: 1rem; background: var(--surface-soft); border-inline-start: 4px solid var(--primary); border-radius: 8px;">
                <div style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.6;">
                    <strong style="color: var(--text);">@Localizer["Note"]:</strong> @Localizer["TimeOffDeletionNote"]
                </div>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon">📅</div>
                <div class="empty-state-title"><loc key="NoApprovedTimeOffRequestsTitle" /></div>
                <div class="empty-state-text"><loc key="NoApprovedTimeOffRequestsMessage" /></div>
            </div>
        }
    </div>
</div>
</div>

@section Scripts {
    <script>
        // ✅ Phase 18: Tab switching with URL hash support (WCAG 2.1 compliant)
        document.addEventListener('DOMContentLoaded', function() {
            const tabButtons = document.querySelectorAll('.tab-button[role="tab"]');
            const tabPanels = document.querySelectorAll('.tab-panel[role="tabpanel"]');
            const tabList = ['timeoff', 'swaps', 'approved'];

            function showTab(tabName, focusTab = false) {
                // Update buttons with ARIA attributes
                tabButtons.forEach(btn => {
                    const isActive = btn.dataset.tab === tabName;
                    btn.classList.toggle('active', isActive);
                    btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
                    btn.setAttribute('tabindex', isActive ? '0' : '-1');

                    if (isActive && focusTab) {
                        btn.focus();
                    }
                });

                // Update panels
                tabPanels.forEach(panel => {
                    const isActive = panel.id === 'tab-' + tabName;
                    panel.classList.toggle('active', isActive);
                    // Hide inactive panels from assistive technology
                    panel.setAttribute('aria-hidden', !isActive);
                });

                // Update URL hash (without triggering scroll)
                if (history.replaceState) {
                    history.replaceState(null, null, '#' + tabName);
                } else {
                    window.location.hash = tabName;
                }
            }

            // Handle tab button clicks
            tabButtons.forEach(btn => {
                btn.addEventListener('click', function() {
                    showTab(this.dataset.tab);
                });
            });

            // Keyboard navigation for tabs (WCAG 2.1.1)
            tabButtons.forEach((btn, index) => {
                btn.addEventListener('keydown', function(e) {
                    let newIndex = index;
                    const isRtl = document.documentElement.dir === 'rtl';

                    switch (e.key) {
                        case 'ArrowRight':
                            newIndex = isRtl ? index - 1 : index + 1;
                            break;
                        case 'ArrowLeft':
                            newIndex = isRtl ? index + 1 : index - 1;
                            break;
                        case 'Home':
                            newIndex = 0;
                            break;
                        case 'End':
                            newIndex = tabButtons.length - 1;
                            break;
                        default:
                            return; // Don't prevent default for other keys
                    }

                    e.preventDefault();

                    // Wrap around
                    if (newIndex < 0) newIndex = tabButtons.length - 1;
                    if (newIndex >= tabButtons.length) newIndex = 0;

                    showTab(tabList[newIndex], true);
                });
            });

            // Handle initial hash or default to first tab
            const hash = window.location.hash.substring(1);
            if (hash && tabList.includes(hash)) {
                showTab(hash);
            } else {
                // Ensure first tab is properly initialized
                showTab('timeoff');
            }

            // Handle browser back/forward buttons
            window.addEventListener('hashchange', function() {
                const hash = window.location.hash.substring(1);
                if (hash && tabList.includes(hash)) {
                    showTab(hash);
                }
            });
        });
    </script>
}
