@page
@model ShiftManager.Pages.Requests.Swaps.CreateModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["ProposeSwap"];
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Requests"], Url = "/Requests/Index" },
    new BreadcrumbItem { Label = Localizer["ProposeSwap"], IsActive = true }
})

<h2><loc key="ProposeSwap_Title">Propose Swap</loc></h2>

<div class="card" style="max-width:680px">
    <form method="post">
        <div style="display:grid; gap:.75rem">
            <label>@Localizer["Swap_MyAssignment"]<br />
                <select class="input" asp-for="SelectedAssignmentId">
                    <option value="">@Localizer["Swap_ChooseShift"]</option>
                    @foreach (var a in Model.MyAssignments)
                    {
                        <option value="@a.AssignmentId">@a.Label</option>
                    }
                </select>
            </label>
            <label>@Localizer["Swap_ProposedToUser"]<br />
                <select class="input" asp-for="ToUserId">
                    <option value="">@Localizer["Swap_ChooseUser"]</option>
                    @foreach (var u in Model.OtherUsers)
                    {
                        <option value="@u.Id">@u.DisplayName (@u.Email)</option>
                    }
                </select>
            </label>
            <button class="btn btn-primary" type="submit"><loc key="Button_Submit">Submit</loc></button>
        </div>
    </form>
</div>
