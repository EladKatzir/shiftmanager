@page
@model ShiftManager.Pages.Requests.TimeOff.CreateModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Requests"], Url = "/Requests/Index" },
    new BreadcrumbItem { Label = Localizer["RequestTimeOff"], IsActive = true }
})

<h2>@Localizer["RequestTimeOff"]</h2>
<div class="card" style="max-width:560px">
    <form method="post" id="timeOffForm">
        <div style="display:grid; gap:.75rem">
            <div>
                <label style="font-weight: 600; margin-bottom: 0.5rem;">@Localizer["TimeOffType"]</label>
                <div style="display: flex; gap: 1.5rem; margin-top: 0.5rem;">
                    <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                        <input type="radio" name="Type" value="0" checked onchange="updateDateFields()" style="cursor: pointer;" />
                        <span>@Localizer["Vacation"]</span>
                    </label>
                    <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                        <input type="radio" name="Type" value="1" onchange="updateDateFields()" style="cursor: pointer;" />
                        <span>@Localizer["After"]</span>
                    </label>
                </div>
                <small style="color: var(--muted); margin-top: 0.25rem; display: block;" id="typeDescription">
                    @Localizer["VacationDescription"]
                </small>
            </div>

            <label id="startDateLabel">@Localizer["StartDate"]<br /><input class="input" asp-for="StartDate" type="date" /></label>
            <label id="endDateLabel">@Localizer["EndDate"]<br /><input class="input" asp-for="EndDate" type="date" /></label>
            <label>@Localizer["ReasonOptional"]<br /><input class="input" asp-for="Reason" /></label>
            <button class="btn btn-primary" type="submit">@Localizer["Submit"]</button>
        </div>
    </form>
</div>

<script>
function updateDateFields() {
    const typeRadios = document.getElementsByName('Type');
    const startDateInput = document.querySelector('input[asp-for="StartDate"]');
    const endDateLabel = document.getElementById('endDateLabel');
    const startDateLabel = document.getElementById('startDateLabel');
    const typeDescription = document.getElementById('typeDescription');

    let selectedType = 0;
    for (const radio of typeRadios) {
        if (radio.checked) {
            selectedType = parseInt(radio.value);
            break;
        }
    }

    if (selectedType === 1) { // After
        // Hide end date field for "After" type
        endDateLabel.style.display = 'none';
        startDateLabel.innerHTML = '@Html.Raw(Localizer["Date"])' + '<br /><input class="input" asp-for="StartDate" type="date" />';
        typeDescription.textContent = '@Html.Raw(Localizer["AfterDescription"])';

        // Set EndDate to same as StartDate for "After" type
        const startDate = document.querySelector('input[name="StartDate"]');
        const endDate = document.querySelector('input[name="EndDate"]');
        if (startDate && endDate) {
            endDate.value = startDate.value;
        }
    } else { // Vacation
        // Show end date field for "Vacation" type
        endDateLabel.style.display = 'block';
        startDateLabel.innerHTML = '@Html.Raw(Localizer["StartDate"])' + '<br /><input class="input" asp-for="StartDate" type="date" />';
        typeDescription.textContent = '@Html.Raw(Localizer["VacationDescription"])';
    }
}

// Initialize on page load
document.addEventListener('DOMContentLoaded', updateDateFields);

// Sync EndDate with StartDate for "After" type
document.addEventListener('change', function(e) {
    if (e.target.name === 'StartDate') {
        const typeRadios = document.getElementsByName('Type');
        let selectedType = 0;
        for (const radio of typeRadios) {
            if (radio.checked) {
                selectedType = parseInt(radio.value);
                break;
            }
        }

        if (selectedType === 1) { // After
            const endDate = document.querySelector('input[name="EndDate"]');
            if (endDate) {
                endDate.value = e.target.value;
            }
        }
    }
});
</script>
