@model ShiftManager.ViewComponents.CalendarSkeletonModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@inject IStringLocalizer<SharedResources> Localizer

@* B-007: Calendar Skeleton Loading Component *@
<div class="calendar-skeleton"
     data-calendar-skeleton
     role="status"
     aria-busy="true"
     aria-live="polite"
     aria-label="@Localizer["Loading"]">

    @switch (Model.ViewType.ToLower())
    {
        case "month":
            @await Html.PartialAsync("~/Pages/Shared/Components/CalendarSkeleton/_MonthSkeleton.cshtml", Model)
            break;
        case "week":
            @await Html.PartialAsync("~/Pages/Shared/Components/CalendarSkeleton/_WeekSkeleton.cshtml", Model)
            break;
        case "day":
            @await Html.PartialAsync("~/Pages/Shared/Components/CalendarSkeleton/_DaySkeleton.cshtml", Model)
            break;
        case "table":
            @await Html.PartialAsync("~/Pages/Shared/Components/CalendarSkeleton/_TableSkeleton.cshtml", Model)
            break;
        default:
            @await Html.PartialAsync("~/Pages/Shared/Components/CalendarSkeleton/_MonthSkeleton.cshtml", Model)
            break;
    }

    <span class="visually-hidden">@Localizer["Loading"]</span>
</div>
