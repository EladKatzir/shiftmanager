@model ShiftManager.ViewComponents.LanguageToggleViewModel

<div class="language-toggle">
    <button class="action-btn language-btn" onclick="toggleLanguage('@Model.CurrentLanguage', '@Model.DefaultCulture', '@Model.AlternateCulture')"
            loc-aria-label="Language" loc-title="Language">
        <span class="language-icon"><icon name="globe" /></span>
        <span class="language-text">@(Model.IsHebrew ? "עב" : "En")</span>
    </button>
</div>

<script>
async function toggleLanguage(currentLang, defaultCulture, alternateCulture) {
    // Determine the target language based on company settings
    // If current is default, switch to alternate. Otherwise, switch to default.
    const newLang = currentLang === defaultCulture ? alternateCulture : defaultCulture;

    const expires = new Date();
    expires.setFullYear(expires.getFullYear() + 1);

    document.cookie = `.AspNetCore.Culture=c=${newLang}|uic=${newLang}; expires=${expires.toUTCString()}; path=/`;
    // Dual-write: marker cookie records deliberate intent so LegacyCultureCookieResetMiddleware
    // won't treat the culture cookie as auto-placed. MUST be kept in sync with Login.cshtml's
    // own language toggle — both writer sites must set both cookies together.
    document.cookie = `.culture_explicit=v2; expires=${expires.toUTCString()}; path=/; SameSite=Lax`;

    // Persist synchronously (#10) so the choice survives even if the user leaves before the
    // next request would have let PreferredLanguageLearningMiddleware passively learn it —
    // otherwise a fresh/cookieless browser later would never see it re-seeded at login.
    try {
        await fetch('/Api/My/Language', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                // Server-side CSRF gate for /Api/* — rejects 403 without this header.
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({ culture: newLang })
        });
    } catch (err) {
        // Non-fatal: the cookie write above already applies the language for this browser;
        // a failed sync just means the next-login re-seed won't have it yet.
        if (window.Logger) window.Logger.error('LanguageToggle', 'Persist failed', err);
    }

    // Reload the page to apply the new language
    window.location.reload();
}
</script>