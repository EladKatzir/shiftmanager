@model ShiftManager.ViewComponents.ExcelCalendarTableViewModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@inject IStringLocalizer<SharedResources> Localizer

@{
    var days = Enumerable.Range(0, (Model.EndDate.DayNumber - Model.StartDate.DayNumber) + 1)
        .Select(i => Model.StartDate.AddDays(i))
        .ToList();
    var today = DateOnly.FromDateTime(DateTime.Today);
    var isCompact = Model.ViewMode == "month";
    var culture = System.Globalization.CultureInfo.CurrentUICulture;
    var dayNames = culture.DateTimeFormat.DayNames;
    var shortDayNames = culture.DateTimeFormat.AbbreviatedDayNames;
    var hasWeeklyHours = Model.Rows.Any(r => r.WeeklyHours.HasValue);
    // #8: the rightmost per-user "Total" column now shows a shift COUNT (HasShiftCount/ShiftCount),
    // not summed hours. hasWeeklyHours/HasWeeklyHours are retained (passed through below) but no
    // longer drive the column or its colspan.
    var hasShiftCount = Model.Rows.Any(r => r.ShiftCount.HasValue);
    var totalColCount = days.Count + 1 + (hasShiftCount ? 1 : 0);
    // Column plan behind the <colgroup>. CalendarColumnPlanner guarantees Count == totalColCount,
    // which `table-layout: fixed` depends on — a mismatch silently misaligns every column.
    var isResizable = !string.IsNullOrEmpty(Model.ColumnWidthContextKey);
    var columnPlan = ShiftManager.ViewComponents.CalendarColumnPlanner.Build(
        days, hasShiftCount, isCompact, Model.ColumnWidths);

    // How many day notes fit INLINE in a date header, derived from the day column's resolved width.
    // This has to be decided server-side: CSS cannot read a <col> width, @container does not apply to
    // internal table elements, and `contain` is forbidden on the calendar's ancestor chain (it would
    // break the sticky headers). All day columns share one width key, so one value serves them all.
    //   <  90px (month default 60, or dragged narrow) -> 0; the trigger alone carries the count
    //   < 140px (week default 100)                    -> 1
    //   >= 140px                                      -> 2
    // ColumnWidths is empty when resizing is not enabled, so Width == DefaultWidth there and this
    // still matches what CSS actually renders.
    var dayNoteColumnWidth = columnPlan.FirstOrDefault(c => c.Key == "day")?.Width
        ?? (isCompact ? ShiftManager.ViewComponents.CalendarColumnPlanner.DefaultCompactDayWidth
                      : ShiftManager.ViewComponents.CalendarColumnPlanner.DefaultDayWidth);
    var inlineNoteCap = dayNoteColumnWidth < 90 ? 0 : (dayNoteColumnWidth < 140 ? 1 : 2);
    var dayNotesIsHebrew = culture.TwoLetterISOLanguageName == "he";
    var hasAnyDayNote = Model.DayNotes.Values.Any(l => l.Count > 0);
    const string dayNoteLineBreak = "\n"; // rendered as &#xA; — a line break in a native tooltip

    // AuthorName carries the resx KEY when the author has been deleted, so the service never returns
    // null and no view has to branch on a missing author.
    string DayNoteAuthor(ShiftManager.Services.DayNoteView n) =>
        n.AuthorName == "Calendar_DayNote_UnknownAuthor"
            ? Localizer["Calendar_DayNote_UnknownAuthor"].Value
            : n.AuthorName;

    // Both tab names travel from the service because it has no localizer; pick by culture the way the
    // tab strip does. A deactivated tab is still named, with a marker explaining why it cannot be
    // opened — hiding its notes instead would read as data loss.
    string DayNoteTabName(ShiftManager.Services.DayNoteView n)
    {
        var name = dayNotesIsHebrew ? n.TabNameHe : n.TabNameEn;
        if (string.IsNullOrEmpty(name)) return string.Empty;
        return n.TabIsActive
            ? name
            : name + " · " + Localizer["Calendar_DayNote_TabInactive"].Value;
    }

    // The delete rule lives on the view model (ExcelCalendarTableViewModel.CanDeleteDayNote) so it can
    // be unit-tested across every persona and kept provably equivalent to DeleteDayNote's 403. A rule
    // written inline here could only ever be checked by eye.
    bool CanDeleteDayNote(ShiftManager.Services.DayNoteView n) => Model.CanDeleteDayNote(n);

    string DayNoteDeleteLabel(ShiftManager.Services.DayNoteView n) =>
        string.Format(culture, Localizer["Calendar_DayNote_DeleteAriaLabel"].Value, DayNoteAuthor(n));

    // Text first, because the visible chip text is truncated with an ellipsis.
    string DayNoteTooltip(ShiftManager.Services.DayNoteView n)
    {
        var tip = n.Text + dayNoteLineBreak
                + string.Format(culture, Localizer["Calendar_DayNote_WrittenBy"].Value, DayNoteAuthor(n));
        var tab = DayNoteTabName(n);
        if (Model.DayNotesScopeIsAllTab && !string.IsNullOrEmpty(tab))
            tip += dayNoteLineBreak + string.Format(culture, Localizer["Calendar_DayNote_TabLabel"].Value, tab);
        return tip;
    }
}

<div class="excel-calendar @(isCompact ? "excel-calendar--compact" : "") @(isResizable ? "excel-calendar--resizable" : "")"
     data-calendar-type="@Model.CalendarType"
     data-start-date="@Model.StartDate.ToString("yyyy-MM-dd")"
     data-end-date="@Model.EndDate.ToString("yyyy-MM-dd")"
     data-readonly="@Model.IsReadOnly.ToString().ToLower()"
     data-reorder-context="@(Model.RowOrderContextKey ?? "")"
     data-width-context="@(Model.ColumnWidthContextKey ?? "")"
     data-min-col-width="@ShiftManager.ViewComponents.CalendarColumnPlanner.MinWidth"
     data-max-col-width="@ShiftManager.ViewComponents.CalendarColumnPlanner.MaxWidth">

    <table class="excel-calendar__table" role="grid" aria-rowcount="@Model.TotalRows">
        <colgroup>
            @foreach (var col in columnPlan)
            {
                @* Width is emitted only when resizing is enabled; otherwise the <col> carries no
                   width and the table keeps its original auto layout. *@
                <col class="@col.CssClass" data-col-key="@col.Key"
                     data-default-width="@col.DefaultWidth"
                     style="@(isResizable ? $"width:{col.Width}px" : null)" />
            }
        </colgroup>
        <thead class="excel-calendar__header">
            <tr aria-rowindex="1">
                @* data-mode is a future CSS/JS hook for mode-specific column styles
                   (e.g. .excel-calendar__corner[data-mode="users"] { ... } could add a
                   user-row indicator). No current consumers; do not remove as dead code. *@
                <th class="excel-calendar__corner" scope="col" data-mode="@Model.RowMode.ToLowerInvariant()">
                    <span class="visually-hidden"><loc key="Calendar_RowLabel_ColumnHeader" /></span>
                    <span class="excel-calendar__mode-token" aria-hidden="true">
                        <loc key="@Model.RowModeLabelKey" />
                        <span class="excel-calendar__mode-chevron">▾</span>
                    </span>
                    @if (isResizable)
                    {
                        <span class="excel-calendar__col-resizer" data-col-key="label"
                              aria-hidden="true"
                              title="@Localizer["Calendar_ResizeColumn"]"></span>
                    }
                </th>
                @foreach (var day in days)
                {
                    var dayIndex = (int)day.DayOfWeek;
                    var isToday = day == today;
                    var isWeekend = dayIndex == 5 || dayIndex == 6;
                    var showWeekend = Model.ViewMode == "month" && isWeekend;
                    var isPast = day < today;
                    var dayName = isCompact ? shortDayNames[dayIndex] : dayNames[dayIndex];

                    <th class="excel-calendar__header-day @(isToday ? "excel-calendar__header-day--today" : "") @(isPast ? "excel-calendar__header-day--past" : "") @(showWeekend ? "excel-calendar__header-day--weekend" : "")"
                        scope="col"
                        data-date="@day.ToString("yyyy-MM-dd")">
                        <span class="excel-calendar__day-name">@dayName</span>
                        <span class="excel-calendar__day-date">@day.ToString("dd/MM")</span>
                        @if (Model.DayNotes.TryGetValue(day, out var dayNotes) && dayNotes.Count > 0)
                        {
                            var noteDateKey = day.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
                            var inlineNotes = dayNotes.Take(inlineNoteCap).ToList();
                            var hiddenNoteCount = dayNotes.Count - inlineNotes.Count;

                            <div class="excel-calendar__day-notes" data-date="@noteDateKey">
                                @foreach (var dayNote in inlineNotes)
                                {
                                    @* aria-hidden: this is a TRUNCATED PREVIEW, and a <th> is re-announced on
                                       every grid cell the user traverses — repeating note prose here would make
                                       the calendar unusable with a screen reader. The full, untruncated copy of
                                       every note lives in the panel behind the trigger below, which is the
                                       keyboard and screen-reader path. *@
                                    <span class="excel-calendar__day-note" title="@DayNoteTooltip(dayNote)" aria-hidden="true">
                                        <span class="excel-calendar__day-note-icon">📝</span>
                                        @if (Model.DayNotesScopeIsAllTab && dayNote.TabId.HasValue)
                                        {
                                            @* A DOT, not the tab name: at a 100px column a named badge leaves
                                               about two glyphs for the note itself. The name is in the tooltip and
                                               spelled out in the panel. Mirrors .cal-tab__dot so a dot and its
                                               strip pill read as the same object. The colour is sanitised to a
                                               strict #RRGGBB in the service — ShiftTab.Color is not validated on
                                               write, and this lands inside a CSS declaration. *@
                                            <span class="excel-calendar__day-note-tab-dot"
                                                  style="@(dayNote.TabColor != null ? "background:" + dayNote.TabColor : null)"></span>
                                        }
                                        <bdi class="excel-calendar__day-note-text">@dayNote.Text</bdi>
                                        @if (CanDeleteDayNote(dayNote))
                                        {
                                            @* tabindex=-1: a focusable control inside an aria-hidden subtree is a
                                               violation. This × is a mouse shortcut; the keyboard delete path is
                                               the panel. *@
                                            <button type="button"
                                                    class="excel-calendar__day-note-delete"
                                                    data-note-id="@dayNote.Id"
                                                    tabindex="-1"
                                                    aria-label="@DayNoteDeleteLabel(dayNote)"
                                                    title="@Localizer["QuickEntry_DeleteDayNote"]">×</button>
                                        }
                                    </span>
                                }

                                @* Rendered whenever the day has >= 1 note, NOT only when notes are hidden.
                                   Under a literal "+N only" rule a one- or two-note day would have no focusable
                                   element at all, so its text would be unreachable by keyboard and screen reader
                                   — `title` is mouse-only and the chip is not focusable. *@
                                <button type="button"
                                        class="excel-calendar__day-notes-trigger"
                                        data-date="@noteDateKey"
                                        aria-haspopup="dialog"
                                        aria-expanded="false"
                                        aria-label="@string.Format(culture, Localizer["Calendar_DayNotes_TriggerAriaLabel"].Value, day.ToString("dd/MM"), dayNotes.Count)"
                                        title="@string.Format(culture, Localizer["Calendar_DayNotes_TriggerAriaLabel"].Value, day.ToString("dd/MM"), dayNotes.Count)">
                                    @if (inlineNoteCap == 0)
                                    {
                                        @* Nothing is shown inline, so "+N more" would be wrong — there is no
                                           "more" to add to. The icon plus the total is also far shorter, which
                                           matters at the 60px month-view column. *@
                                        <span aria-hidden="true">📝</span><span>@dayNotes.Count</span>
                                    }
                                    else if (hiddenNoteCount > 0)
                                    {
                                        <span class="excel-calendar__day-notes-trigger-label">@string.Format(culture, Localizer["QuickEntry_MoreItems"].Value, hiddenNoteCount)</span>
                                    }
                                    else
                                    {
                                        <span aria-hidden="true">📝</span><span>@dayNotes.Count</span>
                                    }
                                </button>

                                @* Inert source of truth for the panel: Razor renders and localizes it in full,
                                   the JS clones it. <template> content is not rendered, not focusable and not in
                                   the accessibility tree, so it costs the header nothing. *@
                                <template class="excel-calendar__day-notes-template" data-date="@noteDateKey">
                                    @foreach (var dayNote in dayNotes)
                                    {
                                        <li class="cal-day-notes__item" data-note-id="@dayNote.Id">
                                            @if (Model.DayNotesScopeIsAllTab && dayNote.TabId.HasValue)
                                            {
                                                <span class="visually-hidden">@string.Format(culture, Localizer["Calendar_DayNote_TabLabel"].Value, DayNoteTabName(dayNote))</span>
                                                <bdi class="cal-day-notes__tab @(dayNote.TabIsActive ? "" : "cal-day-notes__tab--inactive")"
                                                     style="@(dayNote.TabColor != null ? "border-color:" + dayNote.TabColor : null)"
                                                     aria-hidden="true">@DayNoteTabName(dayNote)</bdi>
                                            }
                                            <bdi class="cal-day-notes__text">@dayNote.Text</bdi>
                                            <span class="cal-day-notes__meta">@string.Format(culture, Localizer["Calendar_DayNote_WrittenBy"].Value, DayNoteAuthor(dayNote))</span>
                                            @if (CanDeleteDayNote(dayNote))
                                            {
                                                @* Named by author so the list does not read as "× × × ×". *@
                                                <button type="button" class="cal-day-notes__delete"
                                                        data-note-id="@dayNote.Id"
                                                        aria-label="@DayNoteDeleteLabel(dayNote)">×</button>
                                            }
                                        </li>
                                    }
                                </template>
                            </div>
                        }
                        @if (isResizable)
                        {
                            @* All day columns share one key, so dragging any day header sizes them
                               together and the width survives navigation to another week. *@
                            <span class="excel-calendar__col-resizer" data-col-key="day"
                                  aria-hidden="true"
                                  title="@Localizer["Calendar_ResizeColumn"]"></span>
                        }
                    </th>
                }
                @if (hasShiftCount)
                {
                    <th class="excel-calendar__header-total" scope="col">
                        <span class="excel-calendar__day-name">@Localizer["TotalShifts"]</span>
                        @if (isResizable)
                        {
                            <span class="excel-calendar__col-resizer" data-col-key="total"
                                  aria-hidden="true"
                                  title="@Localizer["Calendar_ResizeColumn"]"></span>
                        }
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @{ var ariaRowIndex = 2; }   @* thead is aria-rowindex="1", so body starts at 2 *@
            @if (Model.Groups != null)
            {
                var sortedGroups = Model.Groups.OrderBy(g => g.SortOrder).ToList();
                for (var gi = 0; gi < sortedGroups.Count; gi++)
                {
                    var group = sortedGroups[gi];
                    var hasNextGroup = gi < sortedGroups.Count - 1;
                    var nextGroupId = hasNextGroup ? sortedGroups[gi + 1].Id : "";

                    <tr class="excel-calendar__group-header@(group.IsCollapsed ? " is-collapsed" : "")"
                        data-group-id="@group.Id"
                        aria-rowindex="@ariaRowIndex">
                        <td colspan="@totalColCount" style="@(group.Color != null ? $"--group-color: {group.Color}" : "")">
                            <div class="excel-calendar__group-toggle">
                                <span class="excel-calendar__group-chevron @(group.IsCollapsed ? "excel-calendar__group-chevron--collapsed" : "")">▼</span>
                                <span class="excel-calendar__group-name" data-editable="true">@group.Name</span>
                                @if (group.MemberCount > 0)
                                {
                                    <span class="excel-calendar__group-count"
                                          data-group-total="@group.MemberCount">(@group.MemberCount)</span>
                                }
                                <span class="excel-calendar__group-grip" title="@Localizer["DragToReorder"]">⋮⋮</span>
                                @if (hasNextGroup)
                                {
                                    <button type="button"
                                            class="excel-calendar__next-group-btn"
                                            data-next-group="@nextGroupId"
                                            loc-aria-label="Calendar_NextGroup"
                                            loc-title="Calendar_NextGroup">
                                        ↓
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                    ariaRowIndex++;

                    foreach (var row in Model.Rows.Where(r => r.GroupId == group.Id))
                    {
                        @await Html.PartialAsync("~/Pages/Shared/Components/ExcelCalendarTable/_CalendarRow.cshtml", new ShiftManager.ViewComponents.ExcelCalendarRowViewModel
                        {
                            Row = row,
                            Days = days,
                            Today = today,
                            IsReadOnly = Model.IsReadOnly,
                        CanEnterTimeOff = Model.CanEnterTimeOff,
                        DraftSessionId = Model.DraftSessionId,
                            IsCollapsed = group.IsCollapsed,
                            HasWeeklyHours = hasWeeklyHours,
                            HasShiftCount = hasShiftCount,
                            RowIndex = ariaRowIndex
                        })
                        ariaRowIndex++;
                    }
                }

                @* Rows without group *@
                foreach (var row in Model.Rows.Where(r => r.GroupId == null))
                {
                    @await Html.PartialAsync("~/Pages/Shared/Components/ExcelCalendarTable/_CalendarRow.cshtml", new ShiftManager.ViewComponents.ExcelCalendarRowViewModel
                    {
                        Row = row,
                        Days = days,
                        Today = today,
                        IsReadOnly = Model.IsReadOnly,
                        CanEnterTimeOff = Model.CanEnterTimeOff,
                        DraftSessionId = Model.DraftSessionId,
                        IsCollapsed = false,
                        HasWeeklyHours = hasWeeklyHours,
                        HasShiftCount = hasShiftCount,
                        RowIndex = ariaRowIndex
                    })
                    ariaRowIndex++;
                }
            }
            else
            {
                foreach (var row in Model.Rows)
                {
                    @await Html.PartialAsync("~/Pages/Shared/Components/ExcelCalendarTable/_CalendarRow.cshtml", new ShiftManager.ViewComponents.ExcelCalendarRowViewModel
                    {
                        Row = row,
                        Days = days,
                        Today = today,
                        IsReadOnly = Model.IsReadOnly,
                        CanEnterTimeOff = Model.CanEnterTimeOff,
                        DraftSessionId = Model.DraftSessionId,
                        IsCollapsed = false,
                        HasWeeklyHours = hasWeeklyHours,
                        HasShiftCount = hasShiftCount,
                        RowIndex = ariaRowIndex
                    })
                    ariaRowIndex++;
                }
            }
        </tbody>
    </table>

    @if (hasAnyDayNote)
    {
        @* Day-notes panel, rendered ONCE per grid and moved to document.body by
           calendar-day-notes-panel.js on init. It cannot live where it is written, for three
           independent reasons:
             1. .excel-calendar__header is sticky WITH a z-index, which makes <thead> a stacking
                context — anything inside composites at that level and can never paint above a
                dropdown or a modal, no matter what z-index it is given.
             2. position:absolute inside the header is clipped by .excel-calendar's overflow:auto.
             3. position:fixed escapes the clip but then stops following the column on scroll.
           It also must not be a flow sibling after .excel-calendar inside .cal-page, because the
           flex math there assumes the calendar is the last child.

           Being inside .excel-calendar means a grid refresh replaces it, which is exactly what the
           JS expects: it re-portals from the fresh copy and re-renders an open panel in place rather
           than leaving a stale dialog attached to body. *@
        <div class="cal-day-notes modal modal--sm" id="calDayNotesPanel"
             role="dialog" aria-modal="true" tabindex="-1"
             aria-labelledby="calDayNotesTitle" hidden>
            <div class="modal__header">
                <h2 class="modal__title" id="calDayNotesTitle">@Localizer["Calendar_DayNotes_PanelTitle"]</h2>
                <button type="button" class="modal__close" id="calDayNotesClose"
                        aria-label="@Localizer["Close"]">×</button>
            </div>
            <div class="modal__body">
                <p class="cal-day-notes__date" id="calDayNotesDate"></p>
                @* No empty state: the panel only opens for a day that HAS notes, and it closes
                   itself the moment a delete empties the day. A hidden element for a state that
                   cannot occur is just a string nobody will ever translate correctly. *@
                <ul class="cal-day-notes__list" id="calDayNotesList"></ul>
            </div>
        </div>
        <div class="modal-backdrop" id="calDayNotesBackdrop" hidden></div>
    }
</div>
