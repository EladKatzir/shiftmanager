@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@inject IStringLocalizer<SharedResources> Localizer
@model dynamic

@{
    ShiftManager.ViewComponents.ExcelCalendarRow row = Model.Row;
    List<DateOnly> days = Model.Days;
    DateOnly today = Model.Today;
    bool isReadOnly = Model.IsReadOnly;
    bool isCollapsed = Model.IsCollapsed;
    bool hasWeeklyHours = Model.HasWeeklyHours;

    var style = row.Color != null ? $"--row-color: {row.Color}" : "";
    var hiddenStyle = isCollapsed ? "display: none;" : "";
}

<tr data-row-id="@row.Id"
    data-group-id="@(row.GroupId ?? "")"
    aria-rowindex="@Model.RowIndex"
    style="@style @hiddenStyle">
    <td class="excel-calendar__row-label">
        <div class="excel-calendar__row-label-content">
            <span class="excel-calendar__row-label-name">
                @if (!string.IsNullOrEmpty(row.Icon) && System.Text.RegularExpressions.Regex.IsMatch(row.Icon, "^[a-z][a-z0-9-]*$"))
                {
                    <span class="excel-calendar__row-icon"><icon name="@row.Icon" size="sm" /></span>
                }
                else if (!string.IsNullOrEmpty(row.Icon))
                {
                    @* Legacy emoji fallback for pre-migration data *@
                    <span class="excel-calendar__row-icon">@row.Icon</span>
                }
                @row.Label
                @if (!string.IsNullOrEmpty(row.CompanyName))
                {
                    <span class="company-badge" title="@row.CompanyName"><icon name="building-2" size="sm" /> @row.CompanyName</span>
                }
            </span>
            @if (!string.IsNullOrEmpty(row.SubLabel))
            {
                <span class="excel-calendar__row-sublabel">@row.SubLabel</span>
            }
        </div>
    </td>
    @{
        // Phase 2d: infer row kind from row.Id prefix. Used by the Justice drawer to know
        // whether a cell is a shift hole (capacity-based), a chore-eligible cell (JS-flipped
        // from focus list), or an onduty hole (always-empty future date).
        var rowKind = row.Id.StartsWith("user-") ? "chore"
                    : row.Id.StartsWith("dutytype-") ? "onduty"
                    : "shift";
    }
    @foreach (var day in days)
    {
        var cell = row.Cells.GetValueOrDefault(day);
        var isTodayCell = day == today;
        var isPastCell = day < today;

        // Phase 2b/2d: cell-marker logic by row kind.
        //   shift   → hole when Capacity < DefaultCapacity (server-side determinable)
        //   onduty  → hole when no real assignment on the date (typeable assignments only,
        //             excluding overlay items with Id=0 like text entries)
        //   chore   → eligibility marker only (JS promotes a subset to data-justice-hole="1"
        //             based on backend's ranked whereToFocus list, avoiding O(users×days) noise)
        var isJusticeHole = !isPastCell && !isReadOnly && (
            (rowKind == "shift"
                && cell?.Capacity != null
                && cell?.DefaultCapacity != null
                && cell.Capacity < cell.DefaultCapacity)
            ||
            (rowKind == "onduty"
                && (cell == null || !cell.Assignments.Any(a => a.Id > 0)))
        );

        var isJusticeEligible = !isPastCell && !isReadOnly && rowKind == "chore"
            && (cell == null
                || !cell.Assignments.Any(a => a.Id > 0
                                              && a.Role != "text-entry"
                                              && a.Role != "overview-note"));

        <td class="excel-calendar__cell @(isTodayCell ? "excel-calendar__cell--today" : "") @(isPastCell ? "excel-calendar__cell--past" : "") @(isReadOnly ? "excel-calendar__cell--readonly" : "")"
            data-row-id="@row.Id"
            data-date="@day.ToString("yyyy-MM-dd")"
            data-justice-hole="@(isJusticeHole ? "1" : "0")"
            data-justice-row-kind="@rowKind"
            data-justice-cell-eligible="@(isJusticeEligible ? "1" : "0")"
            role="gridcell"
            tabindex="0">

            @if (!isReadOnly)
            {
                <button type="button" class="excel-calendar__add-btn" aria-label="@Localizer["AddAssignment"]">+</button>
            }

            @if (cell?.Capacity != null && cell?.DefaultCapacity != null)
            {
                var isFull = cell.Capacity >= cell.DefaultCapacity;
                <div class="excel-calendar__capacity-badge @(isFull ? "excel-calendar__capacity-badge--full" : "")">
                    @cell.Capacity/@cell.DefaultCapacity
                </div>
            }

            <div class="excel-calendar__cell-content">
                @if (cell?.Assignments?.Any() == true)
                {
                    foreach (var assignment in cell.Assignments)
                    {
                        var roleColor = assignment.Role ?? "";
                        var assignStyle = !string.IsNullOrEmpty(roleColor) ? $"--_role-color: {roleColor}" : "";
                        // HOME unification (Task 22): pick source icon for HOME chips.
                        //   no source request → rotation → "repeat"
                        //   source request Type=0 (Vacation) → "plane"
                        //   source request Type=1 (After)    → "sunrise"
                        // Non-HOME assignments fall through to the legacy chip layout.
                        var isHomeChip = assignment.IsHome;
                        string? homeSourceIcon = null;
                        if (isHomeChip)
                        {
                            homeSourceIcon = assignment.SourceTimeOffRequestId == null
                                ? "repeat"
                                : assignment.SourceTimeOffRequestType == 0 ? "plane"
                                : assignment.SourceTimeOffRequestType == 1 ? "sunrise"
                                : "repeat";
                        }
                        var chipClass = isHomeChip ? "excel-calendar__assignment chip-home" : "excel-calendar__assignment";
                        <div class="@chipClass"
                             data-assignment-id="@assignment.Id"
                             data-user-id="@assignment.UserId"
                             data-trainee-id="@(assignment.TraineeUserId?.ToString() ?? "")"
                             data-trainee-name="@(assignment.TraineeName ?? "")"
                             data-role-color="@roleColor"
                             data-entry-type="@(roleColor == "text-entry" ? "text" : "")"
                             data-is-home="@(isHomeChip ? "1" : "0")"
                             data-source-request-id="@(assignment.SourceTimeOffRequestId?.ToString() ?? "")"
                             data-source-request-type="@(assignment.SourceTimeOffRequestType?.ToString() ?? "")"
                             style="@assignStyle"
                             title="@assignment.AssignmentTooltip">
                            @if (isHomeChip)
                            {
                                <span class="chip-icon" aria-hidden="true"><icon name="@homeSourceIcon" size="xs" /></span>
                                <span class="chip-icon" aria-hidden="true"><icon name="house" size="xs" /></span>
                                <span class="excel-calendar__assignment-name chip-label">@assignment.Name</span>
                                @if (!string.IsNullOrEmpty(assignment.ShiftStart) && !string.IsNullOrEmpty(assignment.ShiftEnd))
                                {
                                    <span class="chip-time">@assignment.ShiftStart&ndash;@assignment.ShiftEnd</span>
                                }
                            }
                            else
                            {
                                <span class="excel-calendar__assignment-name">@assignment.Name</span>
                            }
                            @if (!string.IsNullOrEmpty(assignment.SubLabel))
                            {
                                <span class="excel-calendar__assignment-note">@assignment.SubLabel</span>
                            }
                            @if (assignment.IsTrainee || assignment.IsTraineeShift)
                            {
                                <span class="excel-calendar__badge excel-calendar__badge--trainee" title="@Localizer["Trainee"]"><icon name="medal" size="sm" /></span>
                            }
                            @if (!string.IsNullOrEmpty(assignment.TraineeName))
                            {
                                <span class="excel-calendar__trainee-sub">
                                    <span class="excel-calendar__badge excel-calendar__badge--trainee" title="@Localizer["Trainee"]"><icon name="medal" size="sm" /></span>
                                    @assignment.TraineeName
                                </span>
                            }
                            @if (!isReadOnly && assignment.Id > 0)
                            {
                                <button type="button"
                                        class="excel-calendar__remove-btn"
                                        data-assignment-id="@assignment.Id"
                                        aria-label="@Localizer["Remove"] @assignment.Name"
                                        title="@Localizer["Remove"]">×</button>
                            }
                        </div>
                    }
                }
                else if (!string.IsNullOrEmpty(cell?.Note))
                {
                    <span class="excel-calendar__note">@cell.Note</span>
                }

                @if (cell?.Overlay != null)
                {
                    <div class="excel-calendar__badges">
                        @if (cell.Overlay.HasVacation)
                        {
                            <span class="excel-calendar__badge excel-calendar__badge--vacation" title="@Localizer["Vacation"]"><icon name="palm-tree" size="sm" /></span>
                        }
                        @if (cell.Overlay.HasTextEntry)
                        {
                            @foreach (var txt in cell.Overlay.TextEntryTexts)
                            {
                                <span class="excel-calendar__text-entry" title="@txt">@txt</span>
                            }
                        }
                        @if (cell.Overlay.HasOverviewNote)
                        {
                            <span class="excel-calendar__badge excel-calendar__badge--note" title="@cell.Overlay.OverviewNoteText"><icon name="clipboard-list" size="sm" /></span>
                        }
                    </div>
                }
            </div>
        </td>
    }
    @if (hasWeeklyHours)
    {
        <td class="excel-calendar__cell excel-calendar__cell--total">
            @if (row.WeeklyHours.HasValue)
            {
                <span class="excel-calendar__hours">@($"{row.WeeklyHours:0.#}h")</span>
            }
        </td>
    }
</tr>
