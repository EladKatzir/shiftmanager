@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@inject IStringLocalizer<SharedResources> Localizer
@model dynamic

@{
    ShiftManager.ViewComponents.ExcelCalendarRow row = Model.Row;
    List<DateOnly> days = Model.Days;
    DateOnly today = Model.Today;
    bool isReadOnly = Model.IsReadOnly;
    bool isCollapsed = Model.IsCollapsed;

    var style = row.Color != null ? $"--row-color: {row.Color}" : "";
    var hiddenStyle = isCollapsed ? "display: none;" : "";
}

<tr data-row-id="@row.Id" style="@style @hiddenStyle">
    <td class="excel-calendar__row-label">
        @row.Label
        @if (!string.IsNullOrEmpty(row.CompanyName))
        {
            <span class="company-badge" title="@row.CompanyName">🏢 @row.CompanyName</span>
        }
    </td>
    @foreach (var day in days)
    {
        var cell = row.Cells.GetValueOrDefault(day);
        var isTodayCell = day == today;
        var isPastCell = day < today;

        <td class="excel-calendar__cell @(isTodayCell ? "excel-calendar__cell--today" : "") @(isPastCell ? "excel-calendar__cell--past" : "") @(isReadOnly ? "excel-calendar__cell--readonly" : "")"
            data-row-id="@row.Id"
            data-date="@day.ToString("yyyy-MM-dd")"
            role="gridcell"
            tabindex="0">

            @if (!isReadOnly)
            {
                <button type="button" class="excel-calendar__add-btn" aria-label="@Localizer["AddAssignment"]">+</button>
            }

            @if (cell?.Capacity != null && cell?.DefaultCapacity != null)
            {
                var isFull = cell.Capacity >= cell.DefaultCapacity;
                <div class="excel-calendar__capacity-badge @(isFull ? "excel-calendar__capacity-badge--full" : "")">
                    @cell.Capacity/@cell.DefaultCapacity
                </div>
            }

            <div class="excel-calendar__cell-content">
                @if (cell?.Assignments?.Any() == true)
                {
                    foreach (var assignment in cell.Assignments)
                    {
                        var roleColor = assignment.Role ?? "";
                        var assignStyle = !string.IsNullOrEmpty(roleColor) ? $"--_role-color: {roleColor}" : "";
                        <div class="excel-calendar__assignment"
                             data-assignment-id="@assignment.Id"
                             data-user-id="@assignment.UserId"
                             data-trainee-id="@(assignment.TraineeUserId?.ToString() ?? "")"
                             data-trainee-name="@(assignment.TraineeName ?? "")"
                             data-role-color="@roleColor"
                             style="@assignStyle">
                            <span class="excel-calendar__assignment-name">@assignment.Name</span>
                            @if (assignment.IsTrainee)
                            {
                                <span class="excel-calendar__badge excel-calendar__badge--trainee" title="@Localizer["Trainee"]">🎓</span>
                            }
                            @if (!string.IsNullOrEmpty(assignment.TraineeName))
                            {
                                <span class="excel-calendar__trainee-sub">
                                    <span class="excel-calendar__badge excel-calendar__badge--trainee" title="@Localizer["Trainee"]">🎓</span>
                                    @assignment.TraineeName
                                </span>
                            }
                            @if (!isReadOnly && assignment.Id > 0)
                            {
                                <button type="button"
                                        class="excel-calendar__remove-btn"
                                        data-assignment-id="@assignment.Id"
                                        aria-label="@Localizer["Remove"] @assignment.Name"
                                        title="@Localizer["Remove"]">×</button>
                            }
                        </div>
                    }
                }
                else if (!string.IsNullOrEmpty(cell?.Note))
                {
                    <span class="excel-calendar__note">@cell.Note</span>
                }

                @if (cell?.Overlay != null)
                {
                    <div class="excel-calendar__badges">
                        @if (cell.Overlay.HasVacation)
                        {
                            <span class="excel-calendar__badge excel-calendar__badge--vacation" title="@Localizer["Vacation"]">🏖️</span>
                        }
                        @if (cell.Overlay.HasChore)
                        {
                            <span class="excel-calendar__badge excel-calendar__badge--chore" title="@Localizer["Chore"]">🧹</span>
                        }
                        @if (cell.Overlay.HasOnDuty)
                        {
                            <span class="excel-calendar__badge excel-calendar__badge--onduty" title="@Localizer["OnDuty"]">📞</span>
                        }
                    </div>
                }
            </div>
        </td>
    }
</tr>
