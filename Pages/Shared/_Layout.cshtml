    @* A-002: Sidebar Collapse State Persistence - Apply BEFORE first paint to prevent flash *@
    <script>
    (function() {
        'use strict';
        var SIDEBAR_COLLAPSED_KEY = 'shifty_sidebar_collapsed';
        var isCollapsed = localStorage.getItem(SIDEBAR_COLLAPSED_KEY) === 'true';
        
        // Write CSS class directly to <html> element before DOM is ready
        // This prevents flash of wrong state (FOUC)
        if (isCollapsed) {
            document.documentElement.classList.add('sidebar-initially-collapsed');
        }
        
        // Also add a class to disable transitions during initial render
        document.documentElement.classList.add('sidebar-no-transition');
        
        // Remove no-transition class after first paint
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function() {
                // Use requestAnimationFrame to ensure we're after first paint
                requestAnimationFrame(function() {
                    requestAnimationFrame(function() {
                        document.documentElement.classList.remove('sidebar-no-transition');
                    });
                });
            });
        } else {
            requestAnimationFrame(function() {
                requestAnimationFrame(function() {
                    document.documentElement.classList.remove('sidebar-no-transition');
                });
            });
        }
    })();
    </script>
    @* A-008: Widget Collapse State - Apply BEFORE first paint to prevent flash *@
    <script>
    (function() {
        'use strict';
        var STORAGE_PREFIX = 'shifty_widget_';

        // Early application of widget collapsed states to prevent FOUC
        // This runs synchronously before DOM is fully ready
        function applyWidgetStates() {
            var widgets = document.querySelectorAll('.widget[data-widget-id]');
            widgets.forEach(function(widget) {
                var widgetId = widget.dataset.widgetId;
                var key = STORAGE_PREFIX + widgetId + '_collapsed';
                var isCollapsed = localStorage.getItem(key);

                if (isCollapsed === 'true') {
                    widget.classList.add('is-collapsed');
                    var header = widget.querySelector(':scope > .widget__header');
                    if (header) {
                        header.setAttribute('aria-expanded', 'false');
                    }
                } else if (isCollapsed === 'false') {
                    widget.classList.remove('is-collapsed');
                    var header = widget.querySelector(':scope > .widget__header');
                    if (header) {
                        header.setAttribute('aria-expanded', 'true');
                    }
                }
            });
        }

        // Apply states as soon as possible and again on DOMContentLoaded
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', applyWidgetStates);
        } else {
            applyWidgetStates();
        }
    })();
    </script>
    @* Offline deployment diagnostic: Verify sidebar CSS loads correctly *@
    <script>
    (function() {
        window.addEventListener('DOMContentLoaded', function() {
            var sidebar = document.querySelector('.app-sidebar');
            if (sidebar) {
                var computed = window.getComputedStyle(sidebar);
                if (computed.display !== 'flex') {
                    console.error('[OFFLINE ERROR] Sidebar CSS not loaded!');
                    console.error('Expected display: flex, Got:', computed.display);
                    console.error('Check: 1) UNBLOCK_FILES.bat run? 2) Hard refresh browser (Ctrl+F5)');

                    // Show visual warning banner
                    var warning = document.createElement('div');
                    warning.style.cssText = 'position:fixed;top:0;left:0;right:0;background:var(--danger);color:var(--danger-text);padding:12px;text-align:center;z-index:9999;font-family:system-ui;font-size:14px';
                    warning.textContent = '⚠️ CSS Loading Issue - Press Ctrl+F5 to refresh. If issue persists, run UNBLOCK_FILES.bat';
                    document.body.insertBefore(warning, document.body.firstChild);
                } else {
                    console.log('[OK] Sidebar CSS loaded correctly (display: flex)');
                }
            }
        });
    })();
    </script>
</head>
