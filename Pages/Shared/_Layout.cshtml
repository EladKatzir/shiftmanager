@using System.Security.Claims
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using System.Globalization
@using ShiftManager.Services
@using ShiftManager.Data.SeedData
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject IStringLocalizer<SharedResources> Localizer
@inject IViewAsModeService ViewAsModeService
@inject IFeatureFlagService FeatureFlagService
@inject IAreaPaletteService AreaPaletteService
@{
    var user = HttpContextAccessor?.HttpContext?.User;
    var name = user?.FindFirst(ClaimTypes.Name)?.Value ?? "";
    var givenName = user?.FindFirst(ClaimTypes.GivenName)?.Value;
    var role = user?.FindFirst(ClaimTypes.Role)?.Value ?? "";
    var roleTemplateKey = user?.FindFirst("RoleTemplateKey")?.Value;
    var jobTypeName = user?.FindFirst("JobTypeName")?.Value;
    var roleDisplay = string.IsNullOrEmpty(role) ? ""
        : ShiftManager.Helpers.RoleDisplayHelper.GetRoleDisplayName(Localizer, roleTemplateKey ?? role, jobTypeName);
    // All authorization now uses grant-based <require-grant> tag helpers
    // Prefer GivenName claim (sourced from user.PreferredName ?? first-token-of-DisplayName) over
    // splitting Name — fixes the "שלום יחידה" greeting bug where Griffin's `name`/`cn` carried
    // the user's unit, and honors PreferredName (e.g. "Gabriel" → "Gabi"). Fallback splits the
    // Name claim for safety / non-Griffin auth paths.
    var firstName = !string.IsNullOrWhiteSpace(givenName)
        ? givenName
        : (name.Split(' ').FirstOrDefault() ?? name);
    var sidebarUserId = user?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var sidebarCompanyId = user?.FindFirst("CompanyId")?.Value;
    // Avatar URL only generated when user has an avatar (AvatarFileName claim set during login)
    var hasAvatar = !string.IsNullOrWhiteSpace(user?.FindFirst("AvatarFileName")?.Value);
    var sidebarAvatarUrl = hasAvatar && !string.IsNullOrWhiteSpace(sidebarUserId) && !string.IsNullOrWhiteSpace(sidebarCompanyId)
        ? $"/avatars/{sidebarCompanyId}/{sidebarUserId}_thumb.jpg"
        : null;
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var isHebrew = currentCulture.StartsWith("he");
    var direction = isHebrew ? "rtl" : "ltr";
    var lang = isHebrew ? "he" : "en";
    var isViewingAsManager = ViewAsModeService.IsViewingAsManager();
    var friendshipsEnabled = FeatureFlagService.IsEnabled(FeatureFlagSeed.Flags.FriendshipsEnabled);

    // Excel Calendar feature flags - use new URLs when enabled (sync cache-only reads)
    var excelCalendarsEnabled = FeatureFlagService.IsEnabled(FeatureFlagSeed.Flags.ExcelCalendars);
    var shiftsCalendarUrl = excelCalendarsEnabled && FeatureFlagService.IsEnabled(FeatureFlagSeed.Flags.ExcelCalendarShifts)
        ? "/Calendar/Shifts" : "/Calendar/Month";
    var shiftsTableUrl = excelCalendarsEnabled && FeatureFlagService.IsEnabled(FeatureFlagSeed.Flags.ExcelCalendarShifts)
        ? "/Calendar/Shifts" : "/Calendar/Table";
    var choresCalendarUrl = excelCalendarsEnabled && FeatureFlagService.IsEnabled(FeatureFlagSeed.Flags.ExcelCalendarChores)
        ? "/Calendar/Chores" : "/Public/Chores";
    var onCallCalendarUrl = excelCalendarsEnabled && FeatureFlagService.IsEnabled(FeatureFlagSeed.Flags.ExcelCalendarOnCall)
        ? "/Calendar/OnCall" : "/Public/OnDuty";
    var viewAsCompanyName = isViewingAsManager ? await ViewAsModeService.GetViewAsCompanyNameAsync() : null;
    var currentPath = HttpContextAccessor?.HttpContext?.Request.Path.Value ?? "";
}
