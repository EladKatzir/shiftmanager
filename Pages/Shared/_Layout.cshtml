  data-toast-error="@(TempData["ErrorMessage"])"
  data-toast-warning="@(TempData["WarningMessage"])"
  data-toast-info="@(TempData["InfoMessage"])"
  data-toast-error-detail="@(TempData["ErrorDetail"])"
  data-toast-error-id="@(TempData["ErrorId"])">
