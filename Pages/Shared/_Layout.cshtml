    }

    @* A-013: Skip link for keyboard navigation (WCAG 2.4.1) *@
    <a href="#main-content" class="skip-link">@Localizer["SkipToMainContent"]</a>

    @* B-015: Brand Loading Animation - Shows during initial page load *@
    <div class="page-loader page-loader--pending" id="pageLoader" role="status" loc-aria-label="Aria_LoadingPage">
        <div class="page-loader__brand">
            <div class="page-loader__logo">
                <img src="~/images/shifty-logo.svg" alt="" width="48" height="48" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                <span class="page-loader__logo-fallback" style="display:none; color: var(--primary-contrast);">S</span>
            </div>
            <span class="page-loader__name">SHIFTY</span>
        </div>
        <div class="page-loader__spinner" aria-hidden="true"></div>
        <span class="page-loader__text">@Localizer["Loading"]</span>
    </div>
    <script>
    // B-015: Smart page loader - shows only for slow page loads (>150ms)
    (function() {
        'use strict';
        var loader = document.getElementById('pageLoader');
        if (!loader) return;

        var isShowing = false;
        var showTimer = null;
        var SHOW_DELAY = 150; // Only show loader if page takes longer than this

        var showLoader = function() {
            if (!isShowing && loader.classList.contains('page-loader--pending')) {
                loader.classList.remove('page-loader--pending');
                isShowing = true;
            }
        };

        var hideLoader = function() {
            // Cancel any pending show timer
            if (showTimer) {
                clearTimeout(showTimer);
                showTimer = null;
            }

            // If never shown, just remove it immediately (fast page load)
            if (!isShowing) {
                if (loader.parentNode) {
                    loader.parentNode.removeChild(loader);
                }
                return;
            }

            // If already showing, fade out
            if (!loader.classList.contains('is-hidden')) {
                loader.classList.add('is-hidden');
                // Remove from DOM after transition completes
                setTimeout(function() {
                    if (loader.parentNode) {
                        loader.parentNode.removeChild(loader);
                    }
                }, 350);
            }
        };

        // Schedule showing the loader after SHOW_DELAY
        showTimer = setTimeout(showLoader, SHOW_DELAY);

        // Hide when DOM is interactive/complete
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', hideLoader);
        } else {
            // DOM already loaded (e.g., script deferred or async)
            hideLoader();
        }

        // Fallback timeout: 5 seconds max to prevent blocking
        setTimeout(hideLoader, 5000);
    })();
    </script>

