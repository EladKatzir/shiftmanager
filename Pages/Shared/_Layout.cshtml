    @* Dark-mode FOUC prevention — apply theme before any stylesheet paints *@
    <script>
    (function() {
        var theme = localStorage.getItem('theme');
        if (theme === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
        }
        // Per-user theme color (Shift+Click picker). Cookie is set by /Api/My/Theme.
        var m = document.cookie.match(/(?:^|;\s*)theme=([^;]+)/);
        if (m) {
            try {
                var t = JSON.parse(decodeURIComponent(m[1]));
                if (t && t.color) document.documentElement.setAttribute('data-theme-color', t.color);
                if (t && t.mode)  document.documentElement.setAttribute('data-theme-mode',  t.mode);
            } catch (_) { /* ignore malformed cookie */ }
        }
    })();
    </script>
