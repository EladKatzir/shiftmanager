            <div style="margin-bottom:0.75rem;line-height:1.5;">אפליקציה זו דורשת JavaScript כדי לפעול. אנא אפשר JavaScript בדפדפן שלך.</div>
            <div style="line-height:1.5;">This application requires JavaScript to function. Please enable JavaScript in your browser.</div>
        </div>
    </noscript>

    @* I-02: Context-switch confirmation toast *@
    @if (TempData["ContextSwitchMessage"] is string ctxMsg)
    {
        <div id="context-switch-toast" style="position:fixed;top:1rem;left:50%;transform:translateX(-50%);z-index:10000;background:var(--primary,#0d6efd);color:var(--primary-contrast,#fff);padding:0.5rem 1.5rem;border-radius:0.5rem;font-size:0.9rem;box-shadow:0 2px 8px rgba(0,0,0,0.2);opacity:1;transition:opacity 0.5s ease;">
            @ctxMsg
        </div>
