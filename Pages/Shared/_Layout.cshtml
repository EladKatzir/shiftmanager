@using System.Security.Claims
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using System.Globalization
@using ShiftManager.Services
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject IStringLocalizer<SharedResources> Localizer
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject IViewAsModeService ViewAsModeService
@{
    var user = HttpContextAccessor?.HttpContext?.User;
    var name = user?.FindFirst(ClaimTypes.Name)?.Value ?? "";
    var role = user?.FindFirst(ClaimTypes.Role)?.Value ?? "";
    var isAdmin = User.IsInRole("Owner") || User.IsInRole("Manager") || User.IsInRole("Director");
    var isDirector = User.IsInRole("Owner") || User.IsInRole("Director");
    var isOwner = User.IsInRole("Owner");
    var firstName = name.Split(' ').FirstOrDefault() ?? name;
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var isHebrew = currentCulture.StartsWith("he");
    var direction = isHebrew ? "rtl" : "ltr";
    var lang = isHebrew ? "he" : "en";
    var enableCompanySwitcher = Configuration.GetValue<bool>("Features:EnableCompanySwitcher", false);
    var isViewingAsManager = ViewAsModeService.IsViewingAsManager();
    var viewAsCompanyName = isViewingAsManager ? ViewAsModeService.GetViewAsCompanyNameAsync().Result : null;
    var currentPath = HttpContextAccessor?.HttpContext?.Request.Path.Value ?? "";
}
<!DOCTYPE html>
<html lang="@lang" dir="@direction" data-theme="light" class="@(isHebrew ? "hebrew" : "english")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(string.IsNullOrEmpty(firstName) ? (isHebrew ? "השיפטי שלך" : "your shifty") : (isHebrew ? $"השיפטי של {firstName}" : $"{firstName}'s shifty"))</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" />
    <link rel="manifest" href="~/site.webmanifest" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (isHebrew)
    {
        <link rel="stylesheet" href="~/css/rtl.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/css/shift-swap-game.css" asp-append-version="true" />
    @if (Context.Request.Cookies["language_edit_mode"] == "true")
    {
        <link rel="stylesheet" href="~/css/language-edit-mode.css" asp-append-version="true" />
    }
    @await RenderSectionAsync("Styles", required: false)
    @await Html.PartialAsync("_LocalizationScript")
    <script defer src="~/js/shift-swap-game.js" asp-append-version="true"></script>
    <script defer src="~/js/site.js"></script>
    @* Localization API - Load on all pages for attribute localization and JavaScript string access *@
    <script defer src="~/js/localization-api.js" asp-append-version="true"></script>
    <script defer src="~/js/localization-attributes.js" asp-append-version="true"></script>
    @* Only load session check on authenticated pages (prevents infinite redirect loop on login page) *@
    @if (User?.Identity?.IsAuthenticated ?? false)
    {
        <script defer src="~/js/session-check.js" asp-append-version="true"></script>
    }
    @if (isHebrew)
    {
        <script defer src="~/js/hebrew-audit.js"></script>
    }
    @if (Context.Request.Cookies["language_edit_mode"] == "true")
    {
        <script defer src="~/js/language-edit-mode.js" asp-append-version="true"></script>
    }
    @* Offline deployment diagnostic: Verify sidebar CSS loads correctly *@
    <script>
    (function() {
        window.addEventListener('DOMContentLoaded', function() {
            var sidebar = document.querySelector('.app-sidebar');
            if (sidebar) {
                var computed = window.getComputedStyle(sidebar);
                if (computed.display !== 'flex') {
                    console.error('[OFFLINE ERROR] Sidebar CSS not loaded!');
                    console.error('Expected display: flex, Got:', computed.display);
                    console.error('Check: 1) UNBLOCK_FILES.bat run? 2) Hard refresh browser (Ctrl+F5)');

                    // Show visual warning banner
                    var warning = document.createElement('div');
                    warning.style.cssText = 'position:fixed;top:0;left:0;right:0;background:#dc2626;color:white;padding:12px;text-align:center;z-index:9999;font-family:system-ui;font-size:14px';
                    warning.textContent = '⚠️ CSS Loading Issue - Press Ctrl+F5 to refresh. If issue persists, run UNBLOCK_FILES.bat';
                    document.body.insertBefore(warning, document.body.firstChild);
                } else {
                    console.log('[OK] Sidebar CSS loaded correctly (display: flex)');
                }
            }
        });
    })();
    </script>
</head>
<body>
    @* Language Edit Mode Banner (only shown when edit mode cookies are set) *@
    @await Component.InvokeAsync("LanguageEditModeBanner")

    <div class="app-shell">
        @* Sidebar Navigation *@
        <aside class="app-sidebar">
            @* Brand *@
            <div class="app-sidebar-brand brand">
                <span class="app-sidebar-brand-icon">📊</span>
                <span><loc key="ShiftManager" /></span>
            </div>

            @* Navigation *@
            <nav class="app-sidebar-nav">
                @if (isAdmin)
                {
                    @* ✅ PHASE 20: My Calendar Section *@
                    <div class="nav-section-header"><loc key="Calendar_MyCalendar" /></div>

                    @if (isOwner)
                    {
                        @* Owner uses old home page *@
                        <a href="/Home/Index" class="app-sidebar-nav-item @(currentPath.StartsWith("/Home") ? "active" : "")">
                            <span class="app-sidebar-nav-icon">🏠</span>
                            <span><loc key="Home" /></span>
                        </a>
                    }
                    else if (User.IsInRole("Director"))
                    {
                        @* Directors use Director Hub as home *@
                        <a href="/Director/Index" class="app-sidebar-nav-item @(currentPath.StartsWith("/Director") || currentPath == "/" ? "active" : "")">
                            <span class="app-sidebar-nav-icon">👔</span>
                            <span>Director Hub</span>
                        </a>
                    }
                    else
                    {
                        @* Managers use new redesigned home *@
                        <a href="/" class="app-sidebar-nav-item @(currentPath == "/" || currentPath.StartsWith("/Index") ? "active" : "")">
                            <span class="app-sidebar-nav-icon">🏠</span>
                            <span><loc key="Home" /></span>
                        </a>
                    }
                    <a href="/Calendar/Month" class="app-sidebar-nav-item @(currentPath.StartsWith("/Calendar") || currentPath.StartsWith("/Schedule") ? "active" : "")">
                        <span class="app-sidebar-nav-icon">📅</span>
                        <span><loc key="Schedule" /></span>
                    </a>
                    <a href="/Requests/Index" class="app-sidebar-nav-item @(currentPath.StartsWith("/Requests") ? "active" : "")">
                        <span class="app-sidebar-nav-icon">📝</span>
                        <span><loc key="Requests" /></span>
                    </a>
                    <a href="/Admin/Analytics" class="app-sidebar-nav-item @(currentPath.StartsWith("/Admin/Analytics") ? "active" : "")">
                        <span class="app-sidebar-nav-icon">📊</span>
                        <span><loc key="Analytics" /></span>
                    </a>
                    <a href="/Admin/AuditLog" class="app-sidebar-nav-item @(currentPath.StartsWith("/Admin/AuditLog") ? "active" : "")">
                        <span class="app-sidebar-nav-icon">🔍</span>
                        <span><loc key="AuditLog" /></span>
                    </a>

                    @* Phase 8.2.2: Show different People links based on role *@
                    @if (User.IsInRole("Manager"))
                    {
                        @* Managers see "My Team" (their own team) *@
                        <a href="/MyTeam/Index" class="app-sidebar-nav-item @(currentPath.StartsWith("/MyTeam") ? "active" : "")">
                            <span class="app-sidebar-nav-icon">👥</span>
                            <span><loc key="MyTeam" /></span>
                        </a>
                    }
                    else
                    {
                        @* Owners and Directors see "People" (all users) *@
                        <a href="/Admin/Users" class="app-sidebar-nav-item @(currentPath.StartsWith("/Admin/Users") ? "active" : "")">
                            <span class="app-sidebar-nav-icon">👥</span>
                            <span><loc key="People" /></span>
                        </a>
                    }

                    @if (isOwner)
                    {
                        <a href="/Admin/Companies" class="app-sidebar-nav-item @(currentPath.StartsWith("/Admin/Companies") ? "active" : "")">
                            <span class="app-sidebar-nav-icon">🏢</span>
                            <span><loc key="Companies" /></span>
                        </a>
                    }

                    <a href="/Admin/Index" class="app-sidebar-nav-item @(currentPath == "/Admin/Index" || currentPath == "/Admin" ? "active" : "")">
                        <span class="app-sidebar-nav-icon">🎛️</span>
                        <span>Admin Hub</span>
                    </a>

                    <a href="/Admin/Config" class="app-sidebar-nav-item @(currentPath.StartsWith("/Admin/Config") || currentPath.StartsWith("/Admin/ShiftTypes") ? "active" : "")">
                        <span class="app-sidebar-nav-icon">⚙️</span>
                        <span><loc key="Settings" /></span>
                    </a>

                    @* Owner Administration Panel *@
                    @if (isOwner)
                    {
                        <div class="nav-section-header">🔧 <loc key="Owner_AdminPanel" /></div>
                        <a href="/Owner/Index" class="app-sidebar-nav-item @(currentPath.StartsWith("/Owner") ? "active" : "")">
                            <span class="app-sidebar-nav-icon">🔧</span>
                            <span><loc key="Owner_AdminPanel" /></span>
                        </a>
                    }

                    @* ✅ PHASE 20: Management Section *@
                    <div class="nav-section-header">⚙️ <loc key="Calendar_Management" /></div>

                    <a href="/Calendar/Table" class="app-sidebar-nav-item @(currentPath.StartsWith("/Calendar/Table") ? "active" : "")">
                        <span class="app-sidebar-nav-icon">📊</span>
                        <span><loc key="Calendar_ShiftsManagement" /></span>
                    </a>
                    <a href="/Public/Chores" class="app-sidebar-nav-item @(currentPath.StartsWith("/Public/Chores") || currentPath.StartsWith("/Chores") ? "active" : "")">
                        <span class="app-sidebar-nav-icon">🗂️</span>
                        <span><loc key="Calendar_ChoresManagement" /></span>
                    </a>
                    <a href="/Public/OnDuty" class="app-sidebar-nav-item @(currentPath.StartsWith("/Public/OnDuty") ? "active" : "")">
                        <span class="app-sidebar-nav-icon">🎯</span>
                        <span><loc key="Calendar_OnDutyManagement" /></span>
                    </a>
                }
                else
                {
                    @* Employee/Trainee Navigation *@
                    <a href="/" class="app-sidebar-nav-item @(currentPath == "/" || currentPath.StartsWith("/Index") || currentPath.StartsWith("/My/Index") ? "active" : "")">
                        <span class="app-sidebar-nav-icon">🏠</span>
                        <span><loc key="Home" /></span>
                    </a>
                    <a href="/Calendar/Month" class="app-sidebar-nav-item @(currentPath.StartsWith("/Calendar") || currentPath.StartsWith("/Schedule") ? "active" : "")">
                        <span class="app-sidebar-nav-icon">📅</span>
                        <span><loc key="Schedule" /></span>
                    </a>
                    <a href="/My/Requests" class="app-sidebar-nav-item @(currentPath.StartsWith("/My/Requests") || currentPath.StartsWith("/Requests") ? "active" : "")">
                        <span class="app-sidebar-nav-icon">📝</span>
                        <span><loc key="Requests" /></span>
                    </a>
                    <a href="/MyTeam/Index" class="app-sidebar-nav-item @(currentPath.StartsWith("/MyTeam") ? "active" : "")">
                        <span class="app-sidebar-nav-icon">👥</span>
                        <span><loc key="MyTeam" /></span>
                    </a>

                    @* Divider *@
                    <div style="border-top: 1px solid var(--border); margin: 0.5rem 0;"></div>

                    <a href="/Public/Chores" class="app-sidebar-nav-item @(currentPath.StartsWith("/Public/Chores") || currentPath.StartsWith("/Chores") ? "active" : "")">
                        <span class="app-sidebar-nav-icon">🗂️</span>
                        <span><loc key="Chores" /></span>
                    </a>
                    <a href="/Public/OnDuty" class="app-sidebar-nav-item @(currentPath.StartsWith("/Public/OnDuty") ? "active" : "")">
                        <span class="app-sidebar-nav-icon">🎯</span>
                        <span><loc key="OnDuty" /></span>
                    </a>
                    <a href="/My/Profile" class="app-sidebar-nav-item @(currentPath.StartsWith("/My/Profile") ? "active" : "")">
                        <span class="app-sidebar-nav-icon">👤</span>
                        <span><loc key="MyProfile" /></span>
                    </a>
                    <a href="/My/Settings" class="app-sidebar-nav-item @(currentPath.StartsWith("/My/Settings") ? "active" : "")">
                        <span class="app-sidebar-nav-icon">⚙️</span>
                        <span><loc key="My_Settings" /></span>
                    </a>
                }
            </nav>

            @* Sidebar Footer *@
            <div class="app-sidebar-footer">
                @if (User?.Identity?.IsAuthenticated == true)
                {
                    <div class="user-menu">
                        <div class="user-avatar">@firstName.Substring(0, 1).ToUpper()</div>
                        <div class="user-details">
                            <div class="user-name">@firstName</div>
                            <div class="user-role">@role</div>
                        </div>
                    </div>

                    @* ✅ PHASE 18: Ctrl+K tooltip for command palette discovery *@
                    <div class="sidebar-footer-shortcut" loc-title="Sidebar_CtrlKTooltip">
                        <span class="shortcut-icon">⌨️</span>
                        <span class="shortcut-text"><loc key="Sidebar_CtrlKLabel" /></span>
                    </div>
                }
            </div>
        </aside>

        @* Main Content Area *@
        <div class="app-main">
            @* Header *@
            <header class="app-header">
                <div class="app-header-main">
                    <div class="app-header-left">
                        <h1 class="page-title">@ViewData["Title"]</h1>
                        @* Breadcrumbs will be rendered by individual pages here *@
                    </div>

                    <div class="app-header-right">
                        @* Decision Ribbon - EXCLUDE from Owner routes (Phase 1 Enhancement) *@
                        @if (!currentPath.StartsWith("/Owner"))
                        {
                            @await Component.InvokeAsync("DecisionRibbon")
                        }

                        @* Notifications *@
                        <a href="/My/NotificationCenter" class="action-btn" style="position: relative;">
                            <span>🔔</span>
                            @await Component.InvokeAsync("UnreadNotificationCount")
                        </a>

                        @* Language Toggle *@
                        @await Component.InvokeAsync("LanguageToggle")

                        @* Theme Toggle *@
                        <button class="action-btn" id="themeToggle" loc-aria-label="ToggleDarkMode">
                            <span>🌓</span>
                        </button>

                        @* Logout *@
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <form method="post" asp-page="/Auth/Logout" style="display:inline; margin: 0;">
                                @Html.AntiForgeryToken()
                                <button class="action-btn" type="submit" style="background: var(--danger); color: white;">
                                    <span>🚪</span>
                                    <span><loc key="Logout" /></span>
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </header>

            @* View As Manager Warning *@
            @if (isViewingAsManager && viewAsCompanyName != null)
            {
                <div style="background: var(--warning); color: var(--warning-text); padding: 0.75rem 1.5rem; text-align: center; font-weight: 600; border-bottom: 2px solid #d97706;">
                    ⚠️ Viewing as Manager of <strong>@viewAsCompanyName</strong> —
                    <a href="/Director/ViewAsMode" style="color: inherit; text-decoration: underline; margin-left: 1rem;">Exit View Mode</a>
                </div>
            }

            @* Employee Welcome (Optional - can be moved to Home page) *@
            @if (!isAdmin && currentPath.StartsWith("/Home"))
            {
                <div class="employee-welcome" style="background: var(--surface-soft); padding: 2rem 1.5rem; border-bottom: 1px solid var(--border);">
                    <div class="welcome-content">
                        <h2 class="text-display" style="margin: 0 0 0.5rem 0;">
                            @Localizer[DateTime.Now.Hour < 12 ? "GoodMorning" : DateTime.Now.Hour < 18 ? "GoodAfternoon" : "GoodEvening", firstName]
                        </h2>
                        <p class="text-subtle" style="margin: 0;"><loc key="ScheduleSubtitle" /></p>
                    </div>
                </div>
            }

            @* Main Content *@
            <main class="app-content">
                @RenderBody()
            </main>
        </div>
    </div>

    @* Command Palette *@
    <div id="commandPalette" class="command-palette" style="display: none;">
        <div class="command-palette-backdrop" onclick="closeCommandPalette()"></div>
        <div class="command-palette-content">
            <div class="command-palette-search">
                <span class="command-palette-icon">🔍</span>
                <input type="text" id="commandPaletteInput" loc-placeholder="CommandPaletteSearch" autocomplete="off" />
                <span class="command-palette-hint">Ctrl+K</span>
            </div>
            <div id="commandPaletteResults" class="command-palette-results">
                @* Results will be populated by JavaScript *@
            </div>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
