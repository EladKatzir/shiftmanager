    </script>

    @* Sidebar & Mobile Navigation Scripts (A-002: Enhanced with state persistence) *@
    <script>
    (function() {
        'use strict';
        var SIDEBAR_COLLAPSED_KEY = 'shifty_sidebar_collapsed';
        var sidebar = document.getElementById('appSidebar');
        var sidebarToggle = document.getElementById('sidebarToggle');
        var mobileToggle = document.getElementById('mobileNavToggle');
        var mobileOverlay = document.getElementById('mobileNavOverlay');

        if (!sidebar) return;

        // A-002: Apply collapsed state from pre-render (set on <html> element in <head>)
        // This prevents flash of wrong state since CSS applies immediately
        var isCollapsed = document.documentElement.classList.contains('sidebar-initially-collapsed');
        if (isCollapsed) {
            sidebar.classList.add('is-collapsed');
            document.documentElement.classList.remove('sidebar-initially-collapsed');
        }

        // Update toggle button ARIA state to match current collapsed state
        function updateToggleAriaState() {
            if (sidebarToggle) {
                var expanded = !sidebar.classList.contains('is-collapsed');
                sidebarToggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
            }
        }

        // Initialize ARIA state
        updateToggleAriaState();

        // Desktop sidebar toggle with localStorage persistence
        if (sidebarToggle) {
            sidebarToggle.addEventListener('click', function() {
                sidebar.classList.toggle('is-collapsed');
                var collapsed = sidebar.classList.contains('is-collapsed');
                localStorage.setItem(SIDEBAR_COLLAPSED_KEY, collapsed);
                updateToggleAriaState();

                // Announce state change to screen readers
                var announcement = collapsed ? (window.AppLocalizer?.Sidebar_Collapsed || 'Sidebar collapsed') : (window.AppLocalizer?.Sidebar_Expanded || 'Sidebar expanded');
                announceToScreenReader(announcement);
            });

            // Keyboard support - Enter and Space already work for buttons,
            // but let's also support Ctrl+B as a common sidebar toggle shortcut
            document.addEventListener('keydown', function(e) {
                // Ctrl+B (or Cmd+B on Mac) to toggle sidebar
                if ((e.ctrlKey || e.metaKey) && e.key === 'b') {
                    e.preventDefault();
                    sidebarToggle.click();
                }
            });
        }

        // Helper function for screen reader announcements
        function announceToScreenReader(message) {
            var announcement = document.createElement('div');
            announcement.setAttribute('role', 'status');
            announcement.setAttribute('aria-live', 'polite');
            announcement.setAttribute('aria-atomic', 'true');
            announcement.style.cssText = 'position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0;';
            announcement.textContent = message;
            document.body.appendChild(announcement);
            
            // Remove after announcement is read
            setTimeout(function() {
                if (announcement.parentNode) {
                    announcement.parentNode.removeChild(announcement);
                }
            }, 1000);
        }

        // Mobile navigation toggle
        if (mobileToggle && mobileOverlay) {
            mobileToggle.addEventListener('click', function() {
                sidebar.classList.add('is-mobile-open');
                mobileOverlay.classList.add('is-visible');
                document.body.style.overflow = 'hidden';
                mobileToggle.classList.add('is-open');
                mobileToggle.setAttribute('aria-expanded', 'true');
            });

            function closeMobileNav() {
                sidebar.classList.remove('is-mobile-open');
                mobileOverlay.classList.remove('is-visible');
                document.body.style.overflow = '';
                mobileToggle.classList.remove('is-open');
                mobileToggle.setAttribute('aria-expanded', 'false');
            }

            mobileOverlay.addEventListener('click', closeMobileNav);

            // Close on escape
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && sidebar.classList.contains('is-mobile-open')) {
                    closeMobileNav();
                    mobileToggle.focus(); // Return focus to toggle button
                }
            });
        }

        // Collapsible nav categories
        var categoryHeaders = document.querySelectorAll('.nav-category__header');
        categoryHeaders.forEach(function(header) {
            header.addEventListener('click', function() {
                var category = this.closest('.nav-category');
                if (category) {
                    category.classList.toggle('is-collapsed');
                    var isExpanded = !category.classList.contains('is-collapsed');
                    this.setAttribute('aria-expanded', isExpanded);
                    
                    // Save preference
                    var categoryId = category.dataset.categoryId;
                    if (categoryId) {
                        var prefs = JSON.parse(localStorage.getItem('shifty_nav_prefs') || '{}');
                        prefs[categoryId] = !isExpanded;
                        localStorage.setItem('shifty_nav_prefs', JSON.stringify(prefs));
                    }
                }
            });

            // Keyboard support
            header.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    this.click();
                }
            });
        });

        // Restore category collapsed states
        var navPrefs = JSON.parse(localStorage.getItem('shifty_nav_prefs') || '{}');
        document.querySelectorAll('.nav-category[data-category-id]').forEach(function(category) {
            var categoryId = category.dataset.categoryId;
            if (navPrefs[categoryId]) {
                category.classList.add('is-collapsed');
                var header = category.querySelector('.nav-category__header');
                if (header) header.setAttribute('aria-expanded', 'false');
            }
        });
    })();
    </script>

    @* Bottom Dock Toggle Script — three-state: full | collapsed | mini *@
    <script>
    (function() {
        'use strict';

        var STATE_KEY  = 'shifty_bottom_dock_state';
        var PREV_KEY   = 'shifty_bottom_dock_prev_state';
        var LEGACY_KEY = 'shifty_bottom_dock_collapsed';
        var POS_KEY    = 'shifty_bottom_dock_position';

        var dock     = document.getElementById('bottomDock');
        var toggle   = document.getElementById('bottomDockToggle');
        var minimize = document.getElementById('bottomDockMinimize');
        var pill     = document.getElementById('bottomDockPill');
        if (!dock || !toggle || !minimize || !pill) return;

        // Re-anchor the dock to its CSS default (bottom-right) by clearing any
        // inline left/top/right/bottom left behind by the drag IIFE, and also
        // wiping the persisted drag position so the snap is permanent until
        // the user drags again. Used by the toggle only — minimize/pill keep
        // the dragged position intentionally (Mini is a "tuck away").
        function resetDockAnchor() {
            dock.style.left = '';
            dock.style.top = '';
            dock.style.right = '';
            dock.style.bottom = '';
            localStorage.removeItem(POS_KEY);
        }

        // Migration from legacy boolean key (pre-mini-mode)
        var legacy = localStorage.getItem(LEGACY_KEY);
        if (legacy !== null && localStorage.getItem(STATE_KEY) === null) {
            localStorage.setItem(STATE_KEY, legacy === 'false' ? 'full' : 'collapsed');
            localStorage.removeItem(LEGACY_KEY);
        }

        var state = localStorage.getItem(STATE_KEY) || 'collapsed';
        applyState(state);

        function applyState(next) {
            dock.classList.remove('is-collapsed', 'is-mini');
            pill.hidden = true;

            if (next === 'collapsed') {
                dock.classList.add('is-collapsed');
                toggle.setAttribute('aria-expanded', 'false');
                dock.removeAttribute('aria-hidden');
            } else if (next === 'mini') {
                dock.classList.add('is-mini');
                pill.hidden = false;
                dock.setAttribute('aria-hidden', 'true');
            } else {
                toggle.setAttribute('aria-expanded', 'true');
                dock.removeAttribute('aria-hidden');
            }

            state = next;
            localStorage.setItem(STATE_KEY, next);
        }

        // Toggle: Full <-> Collapsed (no-op in Mini; button is not focusable there)
        // Also re-anchors the dock to its CSS default bottom-right: prevents
        // expanded content from overflowing below the viewport when the user
        // had dragged the dock low, and gives a consistent "home" position on
        // collapse.
        toggle.addEventListener('click', function() {
            if (state === 'mini') return;
            resetDockAnchor();
            applyState(state === 'collapsed' ? 'full' : 'collapsed');
        });

        // Minimize: enter Mini, remember prior state for restore
        minimize.addEventListener('click', function() {
            if (state === 'mini') return;
            localStorage.setItem(PREV_KEY, state);
            applyState('mini');
        });

        // Pill: exit Mini back to previous state
        pill.addEventListener('click', function() {
            var prev = localStorage.getItem(PREV_KEY);
            if (prev !== 'full' && prev !== 'collapsed') prev = 'collapsed';
            applyState(prev);
        });

        // Escape closes Full -> Collapsed (unchanged from prior behaviour); no-op in Mini
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && state === 'full') applyState('collapsed');
        });
    })();

    // Bottom dock drag-to-move
    (function() {
        'use strict';
        var DOCK_POS_KEY = 'shifty_bottom_dock_position';
        var dock = document.getElementById('bottomDock');
        var handle = document.getElementById('bottomDockDragHandle');
        if (!dock || !handle) return;

        // Clamp a position to stay within the visible viewport
        function clamp(x, y) {
            return {
                x: Math.max(0, Math.min(x, window.innerWidth - 100)),
                y: Math.max(0, Math.min(y, window.innerHeight - 44))
            };
        }

        // Restore saved position (with viewport bounds check)
        try {
            var saved = JSON.parse(localStorage.getItem(DOCK_POS_KEY));
            if (saved && typeof saved.x === 'number' && typeof saved.y === 'number') {
                var pos = clamp(saved.x, saved.y);
                dock.style.right = 'auto';
                dock.style.bottom = 'auto';
                dock.style.left = pos.x + 'px';
                dock.style.top = pos.y + 'px';
            }
        } catch(e) {
            localStorage.removeItem(DOCK_POS_KEY);
        }

        var startX, startY, startLeft, startTop, dragging = false;

        function onPointerDown(e) {
            e.preventDefault();
            handle.setPointerCapture(e.pointerId);
            dragging = true;
            dock.classList.add('is-dragging');
            var rect = dock.getBoundingClientRect();
            startX = e.clientX;
            startY = e.clientY;
            startLeft = rect.left;
            startTop = rect.top;
        }

        function onPointerMove(e) {
            if (!dragging) return;
            var dx = e.clientX - startX;
            var dy = e.clientY - startY;
            var pos = clamp(startLeft + dx, startTop + dy);
            dock.style.right = 'auto';
            dock.style.bottom = 'auto';
            dock.style.left = pos.x + 'px';
            dock.style.top = pos.y + 'px';
        }

        function onPointerUp(e) {
            if (!dragging) return;
            dragging = false;
            dock.classList.remove('is-dragging');
            handle.releasePointerCapture(e.pointerId);
            try {
                localStorage.setItem(DOCK_POS_KEY, JSON.stringify({
                    x: parseInt(dock.style.left),
                    y: parseInt(dock.style.top)
                }));
            } catch(e) {}
        }

        // Pointer capture routes all pointer events to the handle element,
        // so we listen on handle (not document) for move/up
        handle.addEventListener('pointerdown', onPointerDown);
        handle.addEventListener('pointermove', onPointerMove);
        handle.addEventListener('pointerup', onPointerUp);
    })();
    </script>
    @* Feedback Consolidation: TempData → acknowledgment modal. Runs after DOMContentLoaded so deferred feedback-modal.js has executed.
       Errors additionally honor data-toast-error-detail and data-toast-error-id, which expand the modal with a
       collapsible detail panel and a copyable correlation ID respectively. *@
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof FeedbackModal === 'undefined') return;
        var b = document.body;
        var e = b.dataset.toastError;
        var w = b.dataset.toastWarning;
        var s = b.dataset.toastSuccess;
        var i = b.dataset.toastInfo;
        var errDetail = b.dataset.toastErrorDetail;
        var errId = b.dataset.toastErrorId;
        if (e) {
            var opts = {};
            if (errDetail) opts.detail = errDetail;
            if (errId) opts.errorId = errId;
            FeedbackModal.show('error', e, opts);
        }
        else if (w) FeedbackModal.show('warning', w);
        else if (s) FeedbackModal.show('success', s);
        else if (i) FeedbackModal.show('info', i);
    });
    </script>
</body>
</html>
