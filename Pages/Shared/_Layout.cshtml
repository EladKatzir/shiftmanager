        @* Main Content Area *@
        <div class="app-main">
            @* Header *@
            <header class="app-header">
                <div class="app-header-main">
                    <div class="app-header-left">
                        <h1 class="page-title">@ViewData["Title"]</h1>
                        @* Breadcrumbs will be rendered by individual pages here *@
                    </div>

                    <div class="app-header-right">
                        @* Decision Ribbon - EXCLUDE from Owner routes (Phase 1 Enhancement) *@
                        @if (!currentPath.StartsWith("/Owner"))
                        {
                            @await Component.InvokeAsync("DecisionRibbon")
                        }

                        @* Notifications *@
                        <a href="/My/NotificationCenter" class="action-btn" style="position: relative;">
                            <span>🔔</span>
                            @await Component.InvokeAsync("UnreadNotificationCount")
                        </a>

                        @* Language Toggle *@
                        @await Component.InvokeAsync("LanguageToggle")

                        @* Theme Toggle *@
                        <button class="action-btn" id="themeToggle" loc-aria-label="ToggleDarkMode">
                            <span>🌓</span>
                        </button>

                        @* Logout *@
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <form method="post" asp-page="/Auth/Logout" style="display:inline; margin: 0;">
                                @Html.AntiForgeryToken()
                                <button class="action-btn" type="submit" style="background: var(--danger); color: white;">
                                    <span>🚪</span>
                                    <span><loc key="Logout" /></span>
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </header>

            @* View As Manager Warning *@
            @if (isViewingAsManager && viewAsCompanyName != null)
            {
                <div style="background: var(--warning); color: var(--warning-text); padding: 0.75rem 1.5rem; text-align: center; font-weight: 600; border-bottom: 2px solid var(--warning-hover);">
                    ⚠️ Viewing as Manager of <strong>@viewAsCompanyName</strong> —
                    <a href="/Director/ViewAsMode" style="color: inherit; text-decoration: underline; margin-left: 1rem;">Exit View Mode</a>
                </div>
            }

            @* Employee Welcome (Optional - can be moved to Home page) *@
            @if (!isAdmin && currentPath.StartsWith("/Home"))
            {
                <div class="employee-welcome" style="background: var(--surface-soft); padding: 2rem 1.5rem; border-bottom: 1px solid var(--border);">
                    <div class="welcome-content">
                        <h2 class="text-display" style="margin: 0 0 0.5rem 0;">
                            @Localizer[DateTime.Now.Hour < 12 ? "GoodMorning" : DateTime.Now.Hour < 18 ? "GoodAfternoon" : "GoodEvening", firstName]
                        </h2>
                        <p class="text-subtle" style="margin: 0;"><loc key="ScheduleSubtitle" /></p>
                    </div>
                </div>
            }

            @* Main Content *@
            <main class="app-content" id="main-content" tabindex="-1">
                @RenderBody()
            </main>
        </div>
    </div>

    @* Command Palette *@
    <div id="commandPalette" class="command-palette" style="display: none;">
        <div class="command-palette-backdrop" onclick="closeCommandPalette()"></div>
        <div class="command-palette-content">
            <div class="command-palette-search">
                <span class="command-palette-icon">🔍</span>
                <input type="text" id="commandPaletteInput" loc-placeholder="CommandPaletteSearch" autocomplete="off" loc-aria-label="Aria_SearchCommands" />
                <span class="command-palette-hint">Ctrl+K</span>
            </div>
            <div id="commandPaletteResults" class="command-palette-results">
                @* Results will be populated by JavaScript *@
            </div>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
    @* Page-specific deferred scripts (B-030) - Loads after main scripts for code splitting *@
    @await RenderSectionAsync("PageScripts", required: false)

    @* Initialize Lucide icons *@
    <script>
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
        // Re-initialize icons after any dynamic content updates
        document.addEventListener('htmx:afterSwap', function() {
            lucide.createIcons();
        });
    }
    </script>

    @* Sidebar & Mobile Navigation Scripts (A-002: Enhanced with state persistence) *@
    <script>
    (function() {
        'use strict';
        var SIDEBAR_COLLAPSED_KEY = 'shifty_sidebar_collapsed';
        var sidebar = document.getElementById('appSidebar');
        var sidebarToggle = document.getElementById('sidebarToggle');
        var mobileToggle = document.getElementById('mobileNavToggle');
        var mobileOverlay = document.getElementById('mobileNavOverlay');

        if (!sidebar) return;

        // A-002: Apply collapsed state from pre-render (set on <html> element in <head>)
        // This prevents flash of wrong state since CSS applies immediately
        var isCollapsed = document.documentElement.classList.contains('sidebar-initially-collapsed');
        if (isCollapsed) {
            sidebar.classList.add('is-collapsed');
        }

        // Update toggle button ARIA state to match current collapsed state
        function updateToggleAriaState() {
            if (sidebarToggle) {
                var expanded = !sidebar.classList.contains('is-collapsed');
                sidebarToggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
            }
        }

        // Initialize ARIA state
        updateToggleAriaState();

        // Desktop sidebar toggle with localStorage persistence
        if (sidebarToggle) {
            sidebarToggle.addEventListener('click', function() {
                sidebar.classList.toggle('is-collapsed');
                var collapsed = sidebar.classList.contains('is-collapsed');
                localStorage.setItem(SIDEBAR_COLLAPSED_KEY, collapsed);
                updateToggleAriaState();
                
                // Announce state change to screen readers
                var announcement = collapsed ? 'Sidebar collapsed' : 'Sidebar expanded';
                announceToScreenReader(announcement);
            });

            // Keyboard support - Enter and Space already work for buttons,
            // but let's also support Ctrl+B as a common sidebar toggle shortcut
            document.addEventListener('keydown', function(e) {
                // Ctrl+B (or Cmd+B on Mac) to toggle sidebar
                if ((e.ctrlKey || e.metaKey) && e.key === 'b') {
                    e.preventDefault();
                    sidebarToggle.click();
                }
            });
        }

        // Helper function for screen reader announcements
        function announceToScreenReader(message) {
            var announcement = document.createElement('div');
            announcement.setAttribute('role', 'status');
            announcement.setAttribute('aria-live', 'polite');
            announcement.setAttribute('aria-atomic', 'true');
            announcement.style.cssText = 'position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0;';
            announcement.textContent = message;
            document.body.appendChild(announcement);
            
            // Remove after announcement is read
            setTimeout(function() {
                if (announcement.parentNode) {
                    announcement.parentNode.removeChild(announcement);
                }
            }, 1000);
        }

        // Mobile navigation toggle
        if (mobileToggle && mobileOverlay) {
            mobileToggle.addEventListener('click', function() {
                sidebar.classList.add('is-mobile-open');
                mobileOverlay.classList.add('is-visible');
                document.body.style.overflow = 'hidden';
                mobileToggle.classList.add('is-open');
                mobileToggle.setAttribute('aria-expanded', 'true');
            });

            function closeMobileNav() {
                sidebar.classList.remove('is-mobile-open');
                mobileOverlay.classList.remove('is-visible');
                document.body.style.overflow = '';
                mobileToggle.classList.remove('is-open');
                mobileToggle.setAttribute('aria-expanded', 'false');
            }

            mobileOverlay.addEventListener('click', closeMobileNav);

            // Close on escape
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && sidebar.classList.contains('is-mobile-open')) {
                    closeMobileNav();
                    mobileToggle.focus(); // Return focus to toggle button
                }
            });
        }

        // Collapsible nav categories
        var categoryHeaders = document.querySelectorAll('.nav-category__header');
        categoryHeaders.forEach(function(header) {
            header.addEventListener('click', function() {
                var category = this.closest('.nav-category');
                if (category) {
                    category.classList.toggle('is-collapsed');
                    var isExpanded = !category.classList.contains('is-collapsed');
                    this.setAttribute('aria-expanded', isExpanded);
                    
                    // Save preference
                    var categoryId = category.dataset.categoryId;
                    if (categoryId) {
                        var prefs = JSON.parse(localStorage.getItem('shifty_nav_prefs') || '{}');
                        prefs[categoryId] = !isExpanded;
                        localStorage.setItem('shifty_nav_prefs', JSON.stringify(prefs));
                    }
                }
            });

            // Keyboard support
            header.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    this.click();
                }
            });
        });

        // Restore category collapsed states
        var navPrefs = JSON.parse(localStorage.getItem('shifty_nav_prefs') || '{}');
        document.querySelectorAll('.nav-category[data-category-id]').forEach(function(category) {
            var categoryId = category.dataset.categoryId;
            if (navPrefs[categoryId]) {
                category.classList.add('is-collapsed');
                var header = category.querySelector('.nav-category__header');
                if (header) header.setAttribute('aria-expanded', 'false');
            }
        });
    })();
    </script>
</body>
</html>
