@page
@model ShiftManager.Pages.Home.IndexModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@inject ShiftManager.Services.ILocalizationService Localization
@{
    ViewData["Title"] = Localizer["Home"];
    Layout = "_Layout";
    var firstName = Model.FirstName;
}

@* ✅ Breadcrumb *@
@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Home"], IsActive = true }
})

@* Page Header *@
<div class="page-header">
    <h1 class="page-title">
        @Localizer[DateTime.Now.Hour < 12 ? "GoodMorning" : DateTime.Now.Hour < 18 ? "GoodAfternoon" : "GoodEvening", firstName]
    </h1>
    <p class="page-subtitle"><loc key="ScheduleSubtitle" /></p>
</div>

<style>
    .card-link {
        display: block;
        text-decoration: none;
        color: inherit;
        border-radius: inherit;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .card-link:hover, .card-link:focus-visible {
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(0,0,0,.1);
    }
    .card-link:active { transform: translateY(0); }
    .card-link .card { margin: 0; }
</style>

<div class="home-dashboard">

    @* Schedule spine — "Home is the schedule-spine for everyone": the signed-in user's own upcoming
       week is the page; role widgets below stack around it. A manager/director is still an employee
       with their own shifts. *@
    @await Component.InvokeAsync("PersonalSpine")

    @* Who Is On Shift widget — self-gated to EditArea / AdminAccess holders; renders empty for others *@
    <div class="home-dashboard__who-on-shift">
        @await Component.InvokeAsync("WhoIsOnShift")
    </div>

    @* Quick Actions *@
    <div style="display: flex; gap: var(--space-3); margin-bottom: var(--space-4);">
        <a href="/Calendar/Shifts" class="btn btn--primary btn--md">
            @Localizer["GoToCalendar"]
        </a>
        <a href="/Calendar/Shifts?Mode=user" class="btn btn--outline btn--md">
            @Localizer["ViewByPeople"]
        </a>
    </div>

    @* Common Cards (All Users) *@
    <div class="dashboard-grid" style="margin-bottom: 2rem;">
        @* Next Shift Card *@
        <a href="/Calendar/Shifts" class="card-link">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><loc key="NextShift" /></h3>
            </div>
            <div class="card-body">
                @if (Model.NextShift != null && Model.NextShift.ShiftInstance != null)
                {
                    <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                        <div>
                            <div class="text-subtle" style="font-size: 0.875rem;"><loc key="Date" /></div>
                            <div class="text-body" style="font-weight: 500;">@Localization.FormatLongDate(Model.NextShift.ShiftInstance.WorkDate)</div>
                        </div>
                        <div>
                            <div class="text-subtle" style="font-size: 0.875rem;"><loc key="Time" /></div>
                            <div class="text-body" style="font-weight: 500;">
                                @if (Model.NextShift.ShiftInstance.ShiftType != null)
                                {
                                    <text>@Localization.FormatTime(Model.NextShift.ShiftInstance.ShiftType.Start) - @Localization.FormatTime(Model.NextShift.ShiftInstance.ShiftType.End)</text>
                                }
                            </div>
                        </div>
                        @if (Model.NextShift.ShiftInstance.ShiftType != null)
                        {
                            <div>
                                <span class="badge" style="background: var(--primary-soft); color: var(--primary); padding: 0.25rem 0.75rem; border-radius: 12px; font-size: 0.875rem;">
                                    @Model.NextShift.ShiftInstance.ShiftType.Name
                                </span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-subtle" style="margin: 0;"><loc key="NoUpcomingShifts" /></p>
                }
            </div>
        </div>
        </a>

        @* Weekly Summary Card *@
        <a href="/Calendar/Month" class="card-link">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><loc key="ThisWeek" /></h3>
            </div>
            <div class="card-body">
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span class="text-subtle"><loc key="ShiftCount" /></span>
                        <span class="text-title" style="color: var(--primary);">@Model.ShiftsThisWeek</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span class="text-subtle"><loc key="DaysWithShifts" /></span>
                        <span class="text-body" style="font-weight: 500;">@Model.DaysWithShiftsThisWeek</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span class="text-subtle"><loc key="DaysOffline" /></span>
                        <span class="text-body" style="font-weight: 500;">@Model.OfflineDaysThisWeek</span>
                    </div>
                    @if (Model.VacationDaysThisWeek > 0)
                    {
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span class="text-subtle"><loc key="VacationDays" /></span>
                            <span class="text-body" style="font-weight: 500;">@Model.VacationDaysThisWeek</span>
                        </div>
                    }
                </div>
                <span class="btn" style="margin-top: 1rem; display: inline-block; text-align: center; width: 100%;">
                    @Localizer["ViewFullSchedule"]
                </span>
            </div>
        </div>
        </a>

        @* Notifications Card *@
        <a href="/My/NotificationCenter" class="card-link">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><loc key="Notifications" /></h3>
                @if (Model.UnreadNotificationsCount > 0)
                {
                    <span class="badge" style="background: var(--danger); color: var(--danger-text); padding: 0.25rem 0.5rem; border-radius: 12px; font-size: 0.75rem; margin-inline-start: 0.5rem;">
                        @Model.UnreadNotificationsCount @Localizer["Unread"]
                    </span>
                }
            </div>
            <div class="card-body">
                @if (Model.RecentNotifications.Any())
                {
                    <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                        @foreach (var notification in Model.RecentNotifications.Take(3))
                        {
                            <div style="padding: 0.5rem; background: var(--surface-soft); border-radius: 6px; @(notification.IsRead ? "" : "border-left: 3px solid var(--primary);")">
                                <div class="text-body" style="font-size: 0.875rem; margin-bottom: 0.25rem;">@notification.Message</div>
                                <div class="text-caption" style="color: var(--text-muted);">@Localization.FormatShortDate(notification.CreatedAt) @Localization.FormatTime(notification.CreatedAt)</div>
                            </div>
                        }
                    </div>
                    <span class="btn" style="margin-top: 1rem; display: inline-block; text-align: center; width: 100%;">
                        @Localizer["ViewAllNotifications"]
                    </span>
                }
                else
                {
                    <p class="text-subtle" style="margin: 0;"><loc key="NoNotifications" /></p>
                }
            </div>
        </div>
        </a>
    </div>

    @* Employee-Specific Cards *@
    @if (!Model.IsAdmin)
    {
        <div class="dashboard-section" style="margin-bottom: 2rem;">
            <h3 class="text-title" style="margin: 0 0 1rem 0;"><loc key="MyRequests" /></h3>
            <div class="dashboard-grid" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
                <a href="/My/Requests" class="card-link">
                <div class="card card--metric card--status-warning">
                    <div class="card-body" style="text-align: center;">
                        <div class="text-title" style="font-size: 2.5rem; margin-bottom: 0.5rem;">@Model.PendingRequestsCount</div>
                        <div class="text-body"><loc key="PendingRequests" /></div>
                    </div>
                </div>
                </a>
                <a href="/My/Requests" class="card-link">
                <div class="card card--metric card--status-success">
                    <div class="card-body" style="text-align: center;">
                        <div class="text-title" style="font-size: 2.5rem; margin-bottom: 0.5rem;">@Model.ApprovedRequestsCount</div>
                        <div class="text-body"><loc key="ApprovedRequests" /></div>
                    </div>
                </div>
                </a>
                <a href="/My/Requests" class="card-link">
                <div class="card card--metric card--status-danger">
                    <div class="card-body" style="text-align: center;">
                        <div class="text-title" style="font-size: 2.5rem; margin-bottom: 0.5rem;">@Model.DeclinedRequestsCount</div>
                        <div class="text-body"><loc key="DeclinedRequests" /></div>
                    </div>
                </div>
                </a>
            </div>
        </div>
    }

    @* Manager-Specific Cards *@
    @if (Model.IsAdmin && !Model.IsDirector)
    {
        <div class="dashboard-section" style="margin-bottom: 2rem;">
            <h3 class="text-title" style="margin: 0 0 1rem 0;"><loc key="StaffingOverview" /></h3>
            <div class="dashboard-grid" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
                <a href="/Calendar/Month" class="card-link">
                <div class="card card--metric card--status-warning">
                    <div class="card-body" style="text-align: center;">
                        <div class="text-title" style="font-size: 2.5rem; margin-bottom: 0.5rem;">@Model.UnassignedShiftsCount</div>
                        <div class="text-body"><loc key="UnassignedShifts" /></div>
                    </div>
                </div>
                </a>
                <a href="/Calendar/Month" class="card-link">
                <div class="card card--metric card--status-danger">
                    <div class="card-body" style="text-align: center;">
                        <div class="text-title" style="font-size: 2.5rem; margin-bottom: 0.5rem;">@Model.UnderstaffedDaysCount</div>
                        <div class="text-body"><loc key="UnderstaffedDays" /></div>
                    </div>
                </div>
                </a>
            </div>
        </div>

        <div class="dashboard-section" style="margin-bottom: 2rem;">
            <h3 class="text-title" style="margin: 0 0 1rem 0;"><loc key="Approvals" /></h3>
            <div class="dashboard-grid" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
                <a href="/Requests/Index" class="card-link">
                <div class="card card--metric">
                    <div class="card-body" style="text-align: center;">
                        <div class="text-title" style="font-size: 2.5rem; margin-bottom: 0.5rem;">@Model.PendingTimeOffCount</div>
                        <div class="text-body"><loc key="PendingTimeOff" /></div>
                    </div>
                </div>
                </a>
                <a href="/Requests/Index" class="card-link">
                <div class="card card--metric">
                    <div class="card-body" style="text-align: center;">
                        <div class="text-title" style="font-size: 2.5rem; margin-bottom: 0.5rem;">@Model.PendingSwapsCount</div>
                        <div class="text-body"><loc key="PendingSwaps" /></div>
                    </div>
                </div>
                </a>
            </div>
        </div>
    }

    @* Director/Owner-Specific Cards *@
    @if (Model.IsDirector)
    {
        <div class="dashboard-section" style="margin-bottom: 2rem;">
            <h3 class="text-title" style="margin: 0 0 1rem 0;"><loc key="StaffingOverview" /></h3>
            <div class="dashboard-grid" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
                <a href="/Calendar/Month" class="card-link">
                <div class="card card--metric card--status-warning">
                    <div class="card-body" style="text-align: center;">
                        <div class="text-title" style="font-size: 2.5rem; margin-bottom: 0.5rem;">@Model.UnassignedShiftsCount</div>
                        <div class="text-body"><loc key="UnassignedShifts" /></div>
                    </div>
                </div>
                </a>
                <a href="/Calendar/Month" class="card-link">
                <div class="card card--metric card--status-danger">
                    <div class="card-body" style="text-align: center;">
                        <div class="text-title" style="font-size: 2.5rem; margin-bottom: 0.5rem;">@Model.UnderstaffedDaysCount</div>
                        <div class="text-body"><loc key="UnderstaffedDays" /></div>
                    </div>
                </div>
                </a>
            </div>
        </div>

        <div class="dashboard-section" style="margin-bottom: 2rem;">
            <h3 class="text-title" style="margin: 0 0 1rem 0;"><loc key="Approvals" /></h3>
            <div class="dashboard-grid" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
                <a href="/Requests/Index" class="card-link">
                <div class="card card--metric">
                    <div class="card-body" style="text-align: center;">
                        <div class="text-title" style="font-size: 2.5rem; margin-bottom: 0.5rem;">@Model.PendingTimeOffCount</div>
                        <div class="text-body"><loc key="PendingTimeOff" /></div>
                    </div>
                </div>
                </a>
                <a href="/Requests/Index" class="card-link">
                <div class="card card--metric">
                    <div class="card-body" style="text-align: center;">
                        <div class="text-title" style="font-size: 2.5rem; margin-bottom: 0.5rem;">@Model.PendingSwapsCount</div>
                        <div class="text-body"><loc key="PendingSwaps" /></div>
                    </div>
                </div>
                </a>
            </div>
        </div>

        <div class="dashboard-section" style="margin-bottom: 2rem;">
            <h3 class="text-title" style="margin: 0 0 1rem 0;"><loc key="CompaniesOverview" /></h3>
            <div class="dashboard-grid" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
                @if (Model.TotalCompaniesCount == Model.ActiveCompaniesCount)
                {
                    <a href="/Admin/Companies" class="card-link">
                    <div class="card card--metric card--status-success">
                        <div class="card-body" style="text-align: center;">
                            <div class="text-title" style="font-size: 2.5rem; margin-bottom: 0.5rem;">@Model.TotalCompaniesCount</div>
                            <div class="text-body"><loc key="TotalCompanies" /></div>
                        </div>
                    </div>
                    </a>
                }
                else
                {
                    <a href="/Admin/Companies" class="card-link">
                    <div class="card card--metric">
                        <div class="card-body" style="text-align: center;">
                            <div class="text-title" style="font-size: 2.5rem; margin-bottom: 0.5rem;">@Model.TotalCompaniesCount</div>
                            <div class="text-body"><loc key="TotalCompanies" /></div>
                        </div>
                    </div>
                    </a>
                    <a href="/Admin/Companies" class="card-link">
                    <div class="card card--metric card--status-success">
                        <div class="card-body" style="text-align: center;">
                            <div class="text-title" style="font-size: 2.5rem; margin-bottom: 0.5rem;">@Model.ActiveCompaniesCount</div>
                            <div class="text-body"><loc key="ActiveCompanies" /></div>
                        </div>
                    </div>
                    </a>
                }
            </div>
        </div>

        @* ✅ PHASE 18: Owner-specific sections *@
        @if (Model.IsOwner)
        {
            @* Analytics Summary Section *@
            <div class="dashboard-section" style="margin-bottom: 2rem;">
                <h3 class="text-title" style="margin: 0 0 1rem 0;"><loc key="AnalyticsSummary" /></h3>
                <div class="dashboard-grid" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
                    <a href="/Admin/Analytics" class="card-link">
                    <div class="card card--metric">
                        <div class="card-body" style="text-align: center;">
                            <div class="text-title" style="font-size: 2.5rem; margin-bottom: 0.5rem;">@Model.TotalUsersCount</div>
                            <div class="text-body"><loc key="TotalActiveUsers" /></div>
                        </div>
                    </div>
                    </a>
                    <a href="/Admin/Analytics" class="card-link">
                    <div class="card card--metric">
                        <div class="card-body" style="text-align: center;">
                            <div class="text-title" style="font-size: 2.5rem; margin-bottom: 0.5rem;">@Model.TotalShiftsThisMonth</div>
                            <div class="text-body"><loc key="ShiftsThisMonth" /></div>
                        </div>
                    </div>
                    </a>
                    <a href="/Admin/Analytics" class="card-link">
                    <div class="card card--metric @(Model.AverageStaffingRate >= 90 ? "card--status-success" : Model.AverageStaffingRate >= 75 ? "card--status-warning" : "card--status-danger")">
                        <div class="card-body" style="text-align: center;">
                            <div class="text-title" style="font-size: 2.5rem; margin-bottom: 0.5rem;">
                                @Model.AverageStaffingRate.ToString("F1")%
                            </div>
                            <div class="text-body"><loc key="AverageStaffingRate" /></div>
                        </div>
                    </div>
                    </a>
                </div>
            </div>

            @* System Health Section *@
            <div class="dashboard-section" style="margin-bottom: 2rem;">
                <h3 class="text-title" style="margin: 0 0 1rem 0;"><loc key="SystemHealth" /></h3>
                <a href="/Diagnostic" class="card-link">
                <div class="card">
                    <div class="card-body" style="display: flex; align-items: center; gap: 1.5rem;">
                        <div style="flex: 1;">
                            <div class="text-title" style="margin-bottom: 0.5rem;"><loc key="DiagnosticsAndMonitoring" /></div>
                            <p class="text-subtle" style="margin: 0;"><loc key="ViewSystemStatusAndLogs" /></p>
                        </div>
                        <div>
                            <span class="btn btn-secondary">
                                @Localizer["OpenDiagnostics"] →
                            </span>
                        </div>
                    </div>
                </div>
                </a>
            </div>
        }
    }

    @* Company Announcements — preserved from the legacy "/" landing so the consolidated Home keeps them. *@
    <div class="dashboard-section" style="margin-bottom: 2rem;">
        <h3 class="text-title" style="margin: 0 0 1rem 0;"><loc key="Dashboard_Announcements" /></h3>
        <div class="card">
            <div class="card-body">
                @if (Model.RecentAnnouncements.Any())
                {
                    <div style="display: flex; flex-direction: column; gap: 1rem;">
                        @foreach (var announcement in Model.RecentAnnouncements.Take(5))
                        {
                            <div style="padding: 0.75rem; background: var(--surface-soft, var(--bg)); border-radius: 8px; @(announcement.IsPinned ? "border-inline-start: 3px solid var(--primary);" : "")">
                                <div class="text-body" style="font-weight: 600; display: flex; align-items: center; gap: 0.4rem;">
                                    @if (announcement.IsPinned)
                                    {
                                        <icon name="pin" />
                                    }
                                    @announcement.Title
                                </div>
                                <div class="text-caption" style="color: var(--text-muted); margin: 0.15rem 0 0.4rem;">
                                    @announcement.Creator?.DisplayName • @Localization.FormatShortDate(announcement.CreatedAt)
                                </div>
                                <div class="text-body" style="font-size: 0.9rem;">@announcement.Content</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-subtle" style="margin: 0;"><loc key="Dashboard_NoAnnouncements" /></p>
                }
            </div>
        </div>
    </div>
</div>
