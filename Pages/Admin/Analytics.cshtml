@page
@model ShiftManager.Pages.Admin.AnalyticsModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.Models.Support
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@{
    ViewData["Title"] = Localizer["AnalyticsDashboard"];
}

<div class="analytics-modern-page">
    <!-- Header with breadcrumb and theme toggle -->
    <div class="analytics-header">
        <div class="analytics-breadcrumb">
            <a href="/Admin/Users" class="breadcrumb-link">
                <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M6.5 14.5v-3.505c0-.245.25-.495.5-.495h2c.25 0 .5.25.5.5v3.5a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5z"/>
                </svg>
                @Localizer["Admin"]
            </a>
            <svg class="breadcrumb-separator" width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
            </svg>
            <span class="breadcrumb-current">@Localizer["Analytics"]</span>
        </div>
        <button class="theme-toggle-btn" onclick="toggleAnalyticsTheme()" type="button" aria-label="Toggle dark mode">
            <svg class="sun-icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"/>
            </svg>
            <svg class="moon-icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/>
            </svg>
        </button>
    </div>

    <h1 class="page-title">
        <svg class="title-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="20" x2="12" y2="10"></line>
            <line x1="18" y1="20" x2="18" y2="4"></line>
            <line x1="6" y1="20" x2="6" y2="16"></line>
        </svg>
        @Localizer["AnalyticsDashboard"]
    </h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null || TempData["Error"] != null)
    {
        <div class="alert alert-error">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
            </svg>
            @(TempData["ErrorMessage"] ?? TempData["Error"])
        </div>
    }

    <!-- Date Range Filter -->
    <div class="modern-card">
        <div class="card-header">
            <h3>@Localizer["DateRange"]</h3>
        </div>
        <form method="get" class="filter-form">
            <div class="form-group">
                <label>@Localizer["SelectPeriod"]</label>
                <select class="form-select" name="dateRange" onchange="this.form.submit()">
                    <option value="7" selected="@(Model.DateRange == 7)">@Localizer["Last7Days"]</option>
                    <option value="30" selected="@(Model.DateRange == 30)">@Localizer["Last30Days"]</option>
                    <option value="90" selected="@(Model.DateRange == 90)">@Localizer["Last90Days"]</option>
                    <option value="365" selected="@(Model.DateRange == 365)">@Localizer["LastYear"]</option>
                </select>
            </div>
            <a asp-page-handler="ExportCsv" asp-route-dateRange="@Model.DateRange" class="btn-export">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                @Localizer["ExportReport"]
            </a>
        </form>
    </div>

    <!-- Summary Stats -->
    <div class="stats-grid">
        <div class="stat-card stat-blue">
            <div class="stat-icon">
                <svg width="32" height="32" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
                </svg>
            </div>
            <div class="stat-content">
                <div class="stat-label">@Localizer["CoverageRate"]</div>
                <div class="stat-value">@Model.CoverageRate.ToString("F1")%</div>
                <div class="stat-subtitle">@Localizer["ShiftCoverage"]</div>
            </div>
        </div>

        <div class="stat-card stat-green">
            <div class="stat-icon">
                <svg width="32" height="32" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M8 2a1 1 0 000 2h2a1 1 0 100-2H8z"/>
                    <path d="M3 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v6h-4.586l1.293-1.293a1 1 0 00-1.414-1.414l-3 3a1 1 0 000 1.414l3 3a1 1 0 001.414-1.414L10.414 13H15v3a2 2 0 01-2 2H5a2 2 0 01-2-2V5zM15 11h2a1 1 0 110 2h-2v-2z"/>
                </svg>
            </div>
            <div class="stat-content">
                <div class="stat-label">@Localizer["SwapRequests"]</div>
                <div class="stat-value">@Model.SwapStats.TotalRequests</div>
                <div class="stat-subtitle">@Model.SwapStats.ApprovalRate.ToString("F1")% @Localizer["ApprovalRate"]</div>
            </div>
        </div>

        <div class="stat-card stat-purple">
            <div class="stat-icon">
                <svg width="32" height="32" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                </svg>
            </div>
            <div class="stat-content">
                <div class="stat-label">@Localizer["TimeOffRequests"]</div>
                <div class="stat-value">@Model.TimeOffStats.TotalRequests</div>
                <div class="stat-subtitle">@Model.TimeOffStats.ApprovalRate.ToString("F1")% @Localizer["ApprovalRate"]</div>
            </div>
        </div>

        <div class="stat-card stat-orange">
            <div class="stat-icon">
                <svg width="32" height="32" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                </svg>
            </div>
            <div class="stat-content">
                <div class="stat-label">@Localizer["BackToBackShifts"]</div>
                <div class="stat-value">@Model.BackToBackShifts.Count</div>
                <div class="stat-subtitle">@Localizer["BackToBackShiftWarnings"]</div>
            </div>
        </div>
    </div>

    <!-- Employee Hours -->
    <div class="modern-card">
        <div class="card-header">
            <h3>@Localizer["EmployeeHours"]</h3>
        </div>
        @if (Model.EmployeeHours.Any())
        {
            <div class="table-container">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>@Localizer["Employee"]</th>
                            <th class="text-right">@Localizer["TotalHours"]</th>
                            <th class="text-right">@Localizer["AverageHoursPerWeek"]</th>
                            <th class="text-right">@Localizer["ShiftCount"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in Model.EmployeeHours)
                        {
                            <tr>
                                <td class="font-medium">@emp.EmployeeName</td>
                                <td class="text-right">@emp.TotalHours.ToString("F1")</td>
                                <td class="text-right">@emp.AverageHoursPerWeek.ToString("F1")</td>
                                <td class="text-right">
                                    <span class="badge">@emp.ShiftCount</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
                </svg>
                <p>@Localizer["NoDataAvailable"]</p>
            </div>
        }
    </div>

    <!-- Two Column Layout for Upcoming Shifts and Back-to-Back -->
    <div class="grid-2-col">
        <!-- Upcoming Shifts -->
        <div class="modern-card">
            <div class="card-header">
                <h3>@Localizer["UpcomingShifts"]</h3>
                <span class="badge-info">@Localizer["Next7Days"]</span>
            </div>
            @if (Model.UpcomingShifts.Any())
            {
                <div class="table-container">
                    <table class="modern-table">
                        <thead>
                            <tr>
                                <th>@Localizer["Employee"]</th>
                                <th class="text-right">@Localizer["ShiftCount"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var emp in Model.UpcomingShifts)
                            {
                                <tr>
                                    <td class="font-medium">@emp.EmployeeName</td>
                                    <td class="text-right">
                                        <span class="badge badge-blue">@emp.UpcomingShiftCount</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-small">
                    <p>@Localizer["NoDataAvailable"]</p>
                </div>
            }
        </div>

        <!-- Hours by Role -->
        <div class="modern-card">
            <div class="card-header">
                <h3>@Localizer["HoursByRole"]</h3>
            </div>
            @if (Model.HoursByRole.Any())
            {
                <div class="table-container">
                    <table class="modern-table">
                        <thead>
                            <tr>
                                <th>@Localizer["Role"]</th>
                                <th class="text-right">@Localizer["TotalHours"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var role in Model.HoursByRole)
                            {
                                <tr>
                                    <td class="font-medium">@role.Key</td>
                                    <td class="text-right">@role.Value.ToString("F1")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-small">
                    <p>@Localizer["NoDataAvailable"]</p>
                </div>
            }
        </div>
    </div>

    <!-- Back-to-Back Shift Warnings -->
    <div class="modern-card">
        <div class="card-header">
            <h3>@Localizer["BackToBackShiftWarnings"]</h3>
        </div>
        @if (Model.BackToBackShifts.Any())
        {
            <div class="table-container">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>@Localizer["Employee"]</th>
                            <th>@Localizer["Date"]</th>
                            <th>@Localizer["FirstShift"]</th>
                            <th>@Localizer["SecondShift"]</th>
                            <th class="text-right">@Localizer["RestHours"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.BackToBackShifts)
                        {
                            <tr class="warning-row">
                                <td class="font-medium">@item.EmployeeName</td>
                                <td>@item.FirstShiftDate.ToString("yyyy-MM-dd")</td>
                                <td>@item.FirstShiftType</td>
                                <td>@item.SecondShiftType</td>
                                <td class="text-right">
                                    <span class="badge badge-warning">@item.RestHours.ToString("F1")h</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state-success">
                <svg width="48" height="48" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <p>@Localizer["NoBackToBackIssues"]</p>
            </div>
        }
    </div>

    <!-- Staffing Issues Grid -->
    <div class="grid-2-col">
        <!-- Understaffing -->
        <div class="modern-card">
            <div class="card-header">
                <h3>@Localizer["UnderstaffingIssues"]</h3>
            </div>
            @if (Model.UnderstaffingReport.Any())
            {
                <div class="table-container">
                    <table class="modern-table">
                        <thead>
                            <tr>
                                <th>@Localizer["Date"]</th>
                                <th>@Localizer["Shift"]</th>
                                <th class="text-center">@Localizer["Assigned"]</th>
                                <th class="text-center">@Localizer["Required"]</th>
                                <th class="text-center">@Localizer["Deficit"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var issue in Model.UnderstaffingReport)
                            {
                                <tr class="danger-row">
                                    <td>@issue.WorkDate.ToString("yyyy-MM-dd")</td>
                                    <td class="font-medium">@issue.ShiftType</td>
                                    <td class="text-center">@issue.AssignedCount</td>
                                    <td class="text-center">@issue.RequiredCount</td>
                                    <td class="text-center">
                                        <span class="badge badge-danger">-@issue.Difference</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-success">
                    <svg width="40" height="40" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    <p>@Localizer["NoUnderstaffingIssues"]</p>
                </div>
            }
        </div>

        <!-- Overstaffing -->
        <div class="modern-card">
            <div class="card-header">
                <h3>@Localizer["OverstaffingIssues"]</h3>
            </div>
            @if (Model.OverstaffingReport.Any())
            {
                <div class="table-container">
                    <table class="modern-table">
                        <thead>
                            <tr>
                                <th>@Localizer["Date"]</th>
                                <th>@Localizer["Shift"]</th>
                                <th class="text-center">@Localizer["Assigned"]</th>
                                <th class="text-center">@Localizer["Required"]</th>
                                <th class="text-center">@Localizer["Surplus"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var issue in Model.OverstaffingReport)
                            {
                                <tr class="warning-row">
                                    <td>@issue.WorkDate.ToString("yyyy-MM-dd")</td>
                                    <td class="font-medium">@issue.ShiftType</td>
                                    <td class="text-center">@issue.AssignedCount</td>
                                    <td class="text-center">@issue.RequiredCount</td>
                                    <td class="text-center">
                                        <span class="badge badge-warning">+@issue.Difference</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-success">
                    <svg width="40" height="40" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    <p>@Localizer["NoOverstaffingIssues"]</p>
                </div>
            }
        </div>
    </div>

    <!-- Statistics Grid -->
    <div class="grid-2-col">
        <!-- Swap Statistics -->
        <div class="modern-card">
            <div class="card-header">
                <h3>@Localizer["SwapStatistics"]</h3>
            </div>
            <div class="stats-list">
                <div class="stat-item">
                    <span class="stat-item-label">@Localizer["TotalRequests"]</span>
                    <span class="stat-item-value">@Model.SwapStats.TotalRequests</span>
                </div>
                <div class="stat-item">
                    <span class="stat-item-label">@Localizer["Approved"]</span>
                    <span class="stat-item-value stat-success">@Model.SwapStats.ApprovedCount</span>
                </div>
                <div class="stat-item">
                    <span class="stat-item-label">@Localizer["Declined"]</span>
                    <span class="stat-item-value stat-danger">@Model.SwapStats.DeclinedCount</span>
                </div>
                <div class="stat-item">
                    <span class="stat-item-label">@Localizer["Pending"]</span>
                    <span class="stat-item-value stat-warning">@Model.SwapStats.PendingCount</span>
                </div>
                <div class="stat-item">
                    <span class="stat-item-label">@Localizer["ApprovalRate"]</span>
                    <span class="stat-item-value stat-primary">@Model.SwapStats.ApprovalRate.ToString("F1")%</span>
                </div>
                <div class="stat-item">
                    <span class="stat-item-label">@Localizer["AverageApprovalTime"]</span>
                    <span class="stat-item-value">@Model.AverageSwapApprovalTime.TotalHours.ToString("F1")h</span>
                </div>
            </div>
        </div>

        <!-- Top Swap Requesters -->
        <div class="modern-card">
            <div class="card-header">
                <h3>@Localizer["TopSwapRequesters"]</h3>
            </div>
            @if (Model.TopSwappers.Any())
            {
                <div class="table-container">
                    <table class="modern-table">
                        <thead>
                            <tr>
                                <th>@Localizer["Employee"]</th>
                                <th class="text-right">@Localizer["RequestCount"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var swapper in Model.TopSwappers)
                            {
                                <tr>
                                    <td class="font-medium">@swapper.EmployeeName</td>
                                    <td class="text-right">
                                        <span class="badge badge-blue">@swapper.SwapRequestCount</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-small">
                    <p>@Localizer["NoDataAvailable"]</p>
                </div>
            }
        </div>
    </div>

    <!-- Time Off Statistics Grid -->
    <div class="grid-2-col">
        <!-- Time Off Statistics -->
        <div class="modern-card">
            <div class="card-header">
                <h3>@Localizer["TimeOffStatistics"]</h3>
            </div>
            <div class="stats-list">
                <div class="stat-item">
                    <span class="stat-item-label">@Localizer["TotalRequests"]</span>
                    <span class="stat-item-value">@Model.TimeOffStats.TotalRequests</span>
                </div>
                <div class="stat-item">
                    <span class="stat-item-label">@Localizer["Approved"]</span>
                    <span class="stat-item-value stat-success">@Model.TimeOffStats.ApprovedCount</span>
                </div>
                <div class="stat-item">
                    <span class="stat-item-label">@Localizer["Declined"]</span>
                    <span class="stat-item-value stat-danger">@Model.TimeOffStats.DeclinedCount</span>
                </div>
                <div class="stat-item">
                    <span class="stat-item-label">@Localizer["Pending"]</span>
                    <span class="stat-item-value stat-warning">@Model.TimeOffStats.PendingCount</span>
                </div>
                <div class="stat-item">
                    <span class="stat-item-label">@Localizer["ApprovalRate"]</span>
                    <span class="stat-item-value stat-primary">@Model.TimeOffStats.ApprovalRate.ToString("F1")%</span>
                </div>
                <div class="stat-item">
                    <span class="stat-item-label">@Localizer["AverageDaysOff"]</span>
                    <span class="stat-item-value">@Model.AverageDaysOffPerEmployee.ToString("F1")</span>
                </div>
            </div>
        </div>

        <!-- Time Off Trend -->
        <div class="modern-card">
            <div class="card-header">
                <h3>@Localizer["TimeOffTrend"]</h3>
                <span class="badge-info">@Localizer["Last12Months"]</span>
            </div>
            @if (Model.TimeOffByMonth.Any())
            {
                <div class="table-container">
                    <table class="modern-table">
                        <thead>
                            <tr>
                                <th>@Localizer["Month"]</th>
                                <th class="text-right">@Localizer["Days"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var month in Model.TimeOffByMonth)
                            {
                                <tr>
                                    <td class="font-medium">@month.Key</td>
                                    <td class="text-right">@month.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
