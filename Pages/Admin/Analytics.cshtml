@page
@model ShiftManager.Pages.Admin.AnalyticsModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.Models.Support
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@{
    ViewData["Title"] = Localizer["AnalyticsDashboard"];
    Layout = "_Layout";
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Admin"], Url = "/Admin/Users" },
    new BreadcrumbItem { Label = Localizer["Analytics"], IsActive = true }
})

<h2>📊 @Localizer["AnalyticsDashboard"]</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="card" style="background-color: var(--success); color: var(--success-text); margin-bottom: 1rem;">
        ✓ @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null || TempData["Error"] != null)
{
    <div class="card" style="background-color: var(--danger); color: var(--danger-text); margin-bottom: 1rem;">
        ✗ @(TempData["ErrorMessage"] ?? TempData["Error"])
    </div>
}

<!-- Date Range Filter -->
<div class="card">
    <h3 style="margin-top:0">@Localizer["DateRange"]</h3>
    <form method="get" style="display:grid; grid-template-columns: 1fr auto; gap:.75rem; align-items:end">
        <label>
            @Localizer["SelectPeriod"]<br />
            <select class="input" name="dateRange" onchange="this.form.submit()">
                <option value="7" selected="@(Model.DateRange == 7)">@Localizer["Last7Days"]</option>
                <option value="30" selected="@(Model.DateRange == 30)">@Localizer["Last30Days"]</option>
                <option value="90" selected="@(Model.DateRange == 90)">@Localizer["Last90Days"]</option>
                <option value="365" selected="@(Model.DateRange == 365)">@Localizer["LastYear"]</option>
            </select>
        </label>
        <a asp-page-handler="ExportCsv" asp-route-dateRange="@Model.DateRange" class="btn" style="align-self: end;">
            📥 @Localizer["ExportReport"]
        </a>
    </form>
</div>

<!-- Summary Stats -->
<div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap:1rem; margin-bottom:1.5rem">
    <div class="card" style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); color: white; padding: 1.5rem;">
        <div style="font-size: 0.875rem; margin-bottom: 0.5rem; opacity: 0.9;">@Localizer["CoverageRate"]</div>
        <div style="font-size: 2rem; font-weight: bold; margin-bottom: 0.25rem;">@Model.CoverageRate.ToString("F1")%</div>
        <div style="font-size: 0.75rem; opacity: 0.8;">@Localizer["ShiftCoverage"]</div>
    </div>

    <div class="card" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; padding: 1.5rem;">
        <div style="font-size: 0.875rem; margin-bottom: 0.5rem; opacity: 0.9;">@Localizer["TimeOffRate"]</div>
        <div style="font-size: 2rem; font-weight: bold; margin-bottom: 0.25rem;">@Model.TimeOffStats.ApprovalRate.ToString("F1")%</div>
        <div style="font-size: 0.75rem; opacity: 0.8;">@Localizer["TimeOffApproval"]</div>
    </div>

    <div class="card" style="background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); color: white; padding: 1.5rem;">
        <div style="font-size: 0.875rem; margin-bottom: 0.5rem; opacity: 0.9;">@Localizer["SwapRate"]</div>
        <div style="font-size: 2rem; font-weight: bold; margin-bottom: 0.25rem;">@Model.SwapStats.ApprovalRate.ToString("F1")%</div>
        <div style="font-size: 0.75rem; opacity: 0.8;">@Localizer["ShiftSwaps"]</div>
    </div>

    <div class="card" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white; padding: 1.5rem;">
        <div style="font-size: 0.875rem; margin-bottom: 0.5rem; opacity: 0.9;">@Localizer["AverageDaysOff"]</div>
        <div style="font-size: 2rem; font-weight: bold; margin-bottom: 0.25rem;">@Model.AverageDaysOffPerEmployee.ToString("F1")</div>
        <div style="font-size: 0.75rem; opacity: 0.8;">@Localizer["PerEmployee"]</div>
    </div>
</div>

<!-- Employee Hours -->
<div class="card">
    <h3 style="margin-top:0">@Localizer["EmployeeHours"]</h3>
    @if (Model.EmployeeHours.Any())
    {
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="border-bottom: 2px solid var(--border); text-align: left;">
                        <th style="padding: 0.75rem;">@Localizer["Employee"]</th>
                        <th style="padding: 0.75rem;">@Localizer["TotalHours"]</th>
                        <th style="padding: 0.75rem;">@Localizer["AvgHoursPerWeek"]</th>
                        <th style="padding: 0.75rem;">@Localizer["ShiftCount"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.EmployeeHours)
                    {
                        <tr style="border-bottom: 1px solid var(--border);">
                            <td style="padding: 0.75rem; font-weight: 500;">@item.EmployeeName</td>
                            <td style="padding: 0.75rem;">@item.TotalHours.ToString("F1")</td>
                            <td style="padding: 0.75rem;">@item.AverageHoursPerWeek.ToString("F1")</td>
                            <td style="padding: 0.75rem;">@item.ShiftCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p style="color: var(--text-muted); text-align: center; padding: 2rem;">@Localizer["NoDataAvailable"]</p>
    }
</div>

<!-- Understaffing Report -->
<div class="card">
    <h3 style="margin-top:0">@Localizer["UnderstaffingReport"]</h3>
    @if (Model.UnderstaffingReport.Any())
    {
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="border-bottom: 2px solid var(--border); text-align: left;">
                        <th style="padding: 0.75rem;">@Localizer["Date"]</th>
                        <th style="padding: 0.75rem;">@Localizer["ShiftType"]</th>
                        <th style="padding: 0.75rem;">@Localizer["Assigned"]</th>
                        <th style="padding: 0.75rem;">@Localizer["Required"]</th>
                        <th style="padding: 0.75rem;">@Localizer["Deficit"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var issue in Model.UnderstaffingReport)
                    {
                        var deficitStyle = Math.Abs(issue.Difference) > 2 ? "color: var(--danger); font-weight: 600;" : "color: var(--warning); font-weight: 600;";
                        <tr style="border-bottom: 1px solid var(--border);">
                            <td style="padding: 0.75rem; font-weight: 500;">@issue.WorkDate.ToString("dddd, MMM dd, yyyy")</td>
                            <td style="padding: 0.75rem;">@Localizer[issue.ShiftType]</td>
                            <td style="padding: 0.75rem;">@issue.AssignedCount</td>
                            <td style="padding: 0.75rem;">@issue.RequiredCount</td>
                            <td style="padding: 0.75rem; @deficitStyle">@Math.Abs(issue.Difference)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p style="color: var(--success); text-align: center; padding: 2rem;">✓ @Localizer["NoUnderstaffingIssues"]</p>
    }
</div>

<!-- Top Swappers -->
<div class="card">
    <h3 style="margin-top:0">@Localizer["MostActiveSwappers"]</h3>
    @if (Model.TopSwappers.Any())
    {
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="border-bottom: 2px solid var(--border); text-align: left;">
                        <th style="padding: 0.75rem;">@Localizer["Employee"]</th>
                        <th style="padding: 0.75rem;">@Localizer["TotalRequests"]</th>
                        <th style="padding: 0.75rem;">@Localizer["Approved"]</th>
                        <th style="padding: 0.75rem;">@Localizer["Declined"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var swapper in Model.TopSwappers)
                    {
                        <tr style="border-bottom: 1px solid var(--border);">
                            <td style="padding: 0.75rem; font-weight: 500;">@swapper.EmployeeName</td>
                            <td style="padding: 0.75rem;">@swapper.SwapRequestCount</td>
                            <td style="padding: 0.75rem; color: var(--success);">@swapper.ApprovedCount</td>
                            <td style="padding: 0.75rem; color: var(--danger);">@swapper.DeclinedCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p style="color: var(--text-muted); text-align: center; padding: 2rem;">@Localizer["NoDataAvailable"]</p>
    }
</div>

<!-- Swap Statistics -->
<div class="card">
    <h3 style="margin-top:0">@Localizer["SwapStatistics"]</h3>
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap:1rem;">
        <div style="padding: 1rem; background: var(--bg); border-radius: 0.5rem;">
            <div style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.5rem;">@Localizer["TotalRequests"]</div>
            <div style="font-size: 1.5rem; font-weight: bold;">@Model.SwapStats.TotalRequests</div>
        </div>
        <div style="padding: 1rem; background: var(--bg); border-radius: 0.5rem;">
            <div style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.5rem;">@Localizer["Approved"]</div>
            <div style="font-size: 1.5rem; font-weight: bold; color: var(--success);">@Model.SwapStats.ApprovedCount</div>
        </div>
        <div style="padding: 1rem; background: var(--bg); border-radius: 0.5rem;">
            <div style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.5rem;">@Localizer["Declined"]</div>
            <div style="font-size: 1.5rem; font-weight: bold; color: var(--danger);">@Model.SwapStats.DeclinedCount</div>
        </div>
        <div style="padding: 1rem; background: var(--bg); border-radius: 0.5rem;">
            <div style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.5rem;">@Localizer["Pending"]</div>
            <div style="font-size: 1.5rem; font-weight: bold; color: var(--warning);">@Model.SwapStats.PendingCount</div>
        </div>
    </div>
</div>

<!-- Time-Off Statistics -->
<div class="card">
    <h3 style="margin-top:0">@Localizer["TimeOffStatistics"]</h3>
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap:1rem;">
        <div style="padding: 1rem; background: var(--bg); border-radius: 0.5rem;">
            <div style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.5rem;">@Localizer["TotalRequests"]</div>
            <div style="font-size: 1.5rem; font-weight: bold;">@Model.TimeOffStats.TotalRequests</div>
        </div>
        <div style="padding: 1rem; background: var(--bg); border-radius: 0.5rem;">
            <div style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.5rem;">@Localizer["Approved"]</div>
            <div style="font-size: 1.5rem; font-weight: bold; color: var(--success);">@Model.TimeOffStats.ApprovedCount</div>
        </div>
        <div style="padding: 1rem; background: var(--bg); border-radius: 0.5rem;">
            <div style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.5rem;">@Localizer["Declined"]</div>
            <div style="font-size: 1.5rem; font-weight: bold; color: var(--danger);">@Model.TimeOffStats.DeclinedCount</div>
        </div>
        <div style="padding: 1rem; background: var(--bg); border-radius: 0.5rem;">
            <div style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.5rem;">@Localizer["Pending"]</div>
            <div style="font-size: 1.5rem; font-weight: bold; color: var(--warning);">@Model.TimeOffStats.PendingCount</div>
        </div>
    </div>
</div>
