@page
@model ShiftManager.Pages.Admin.AnalyticsModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Models
@using ShiftManager.Models.Support
@using ShiftManager.Resources
@using ShiftManager.Services
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@{
    ViewData["Title"] = Localizer["Justice_PageTitle"];
    Layout = "_Layout";
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Admin"], Url = "/Admin/Users" },
    new BreadcrumbItem { Label = Localizer["Justice_PageTitle"], IsActive = true }
})

@section Styles {
    <link rel="stylesheet" href="~/css/justice.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/justice.js" asp-append-version="true" defer></script>
}

<div class="justice-page" data-page="justice">
    <header class="page-header justice-header">
        <div>
            <h1 class="page-title"><loc key="Justice_PageTitle" /></h1>
            <p class="page-subtitle"><loc key="Justice_Subtitle" /></p>
        </div>
        <div class="justice-header-actions">
            <require-grant key="EditJusticeTargets">
                <button type="button" class="btn btn--secondary" disabled title="@Localizer["Justice_Targets_ComingPhase2"]">
                    <icon name="settings" size="sm" />
                    <span><loc key="Justice_Targets" /></span>
                </button>
            </require-grant>
            <a class="btn btn--primary" asp-page-handler="ExportCsv"
               asp-route-scope="@Model.Scope"
               asp-route-scopeId="@Model.ScopeId"
               asp-route-level="@Model.Level"
               asp-route-workType="@Model.WorkType"
               asp-route-excludeExempt="@Model.ExcludeExemptShifts"
               asp-route-from="@Model.EffectivePeriodStart.ToString("yyyy-MM-dd")"
               asp-route-to="@Model.EffectivePeriodEnd.ToString("yyyy-MM-dd")">
                <icon name="download" size="sm" />
                <span><loc key="Justice_ExportCsv" /></span>
            </a>
        </div>
    </header>

    @* ========== Scope strip ========== *@
    <form method="get" class="justice-filter-card section-card" id="justice-filter-form">
        <div class="filter-row">
            <label class="filter-field">
                <span class="filter-field__label"><loc key="Justice_Level" /></span>
                <select name="level" class="form-select" data-justice-onchange>
                    <option value="@JusticeLevel.UsersInCompany" selected="@(Model.Level == JusticeLevel.UsersInCompany)">@Localizer["Justice_Level_UsersInCompany"]</option>
                    <option value="@JusticeLevel.CompaniesInMolecule" selected="@(Model.Level == JusticeLevel.CompaniesInMolecule)">@Localizer["Justice_Level_CompaniesInMolecule"]</option>
                    <option value="@JusticeLevel.MoleculesInArea" selected="@(Model.Level == JusticeLevel.MoleculesInArea)">@Localizer["Justice_Level_MoleculesInArea"]</option>
                </select>
            </label>

            @{
                var pickerLabel = Model.Level switch
                {
                    JusticeLevel.UsersInCompany => Localizer["Justice_Pick_Company"].Value,
                    JusticeLevel.CompaniesInMolecule => Localizer["Justice_Pick_Molecule"].Value,
                    JusticeLevel.MoleculesInArea => Localizer["Justice_Pick_Area"].Value,
                    _ => ""
                };
                IEnumerable<AnalyticsModel.ScopeOption> options = Model.Level switch
                {
                    JusticeLevel.UsersInCompany => Model.CompanyOptions,
                    JusticeLevel.CompaniesInMolecule => Model.MoleculeOptions,
                    JusticeLevel.MoleculesInArea => Model.AreaOptions,
                    _ => Enumerable.Empty<AnalyticsModel.ScopeOption>()
                };
            }
            <label class="filter-field">
                <span class="filter-field__label">@pickerLabel</span>
                <select name="scopeId" class="form-select" data-justice-onchange>
                    @if (!options.Any())
                    {
                        <option value=""><loc key="Justice_Pick_None" /></option>
                    }
                    else
                    {
                        foreach (var opt in options)
                        {
                            <option value="@opt.Id" selected="@(Model.ScopeId == opt.Id)">@opt.Name</option>
                        }
                    }
                </select>
            </label>

            <label class="filter-field">
                <span class="filter-field__label"><loc key="Justice_PeriodStart" /></span>
                <input type="date" name="from" class="form-input" value="@Model.EffectivePeriodStart.ToString("yyyy-MM-dd")" data-justice-onchange />
            </label>
            <label class="filter-field">
                <span class="filter-field__label"><loc key="Justice_PeriodEnd" /></span>
                <input type="date" name="to" class="form-input" value="@Model.EffectivePeriodEnd.ToString("yyyy-MM-dd")" data-justice-onchange />
            </label>

            <label class="filter-field">
                <span class="filter-field__label"><loc key="Justice_WorkType" /></span>
                <select name="workType" class="form-select" data-justice-onchange>
                    <option value="@JusticeWorkType.All" selected="@(Model.WorkType == JusticeWorkType.All)">@Localizer["Justice_WorkType_All"]</option>
                    <option value="@JusticeWorkType.Shift" selected="@(Model.WorkType == JusticeWorkType.Shift)">@Localizer["Justice_WorkType_Shift"]</option>
                    <option value="@JusticeWorkType.Chore" selected="@(Model.WorkType == JusticeWorkType.Chore)">@Localizer["Justice_WorkType_Chore"]</option>
                    <option value="@JusticeWorkType.OnDuty" selected="@(Model.WorkType == JusticeWorkType.OnDuty)">@Localizer["Justice_WorkType_OnDuty"]</option>
                </select>
            </label>

            <label class="filter-toggle">
                <input type="checkbox" name="excludeExempt" value="true" @(Model.ExcludeExemptShifts ? "checked" : "") data-justice-onchange />
                <span><loc key="Justice_ExcludeExempt" /></span>
            </label>

            <noscript>
                <button type="submit" class="btn btn--secondary"><loc key="Justice_Apply" /></button>
            </noscript>
        </div>
    </form>

    @if (Model.View is null)
    {
        <div class="empty-state section-card">
            <div class="empty-state-icon"><icon name="bar-chart-3" size="lg" /></div>
            <h2><loc key="Justice_Empty_PickScope" /></h2>
            <p class="text-subtle"><loc key="Justice_Empty_PickScope_Hint" /></p>
        </div>
    }
    else
    {
        var v = Model.View;

        @* ========== Verdict strip ========== *@
        <section class="justice-verdict section-card" aria-labelledby="verdict-heading">
            <div class="verdict-line">
                <h2 id="verdict-heading" class="verdict-heading">
                    <icon name="sliders" size="sm" />
                    <loc key="Justice_Verdict_Heading" />
                </h2>
                <span class="verdict-spread-pill" data-severity="@v.SpreadSeverity" dir="ltr">
                    <span class="verdict-spread-number">@v.SpreadIndex.ToString("F2")</span>
                    <span class="verdict-spread-glyph" aria-hidden="true">
                        @for (int i = 0; i < 5; i++)
                        {
                            <span class="dot @(i <= v.SpreadSeverity ? "dot--filled" : "")"></span>
                        }
                    </span>
                    <span class="verdict-spread-label">@Localizer[v.SpreadLabelKey]</span>
                </span>
            </div>

            @if (v.Rows.Any())
            {
                <div class="equity-ribbon" role="img" aria-label="@Localizer["Justice_EquityRibbon_Aria"]">
                    @foreach (var row in v.Rows.OrderBy(r => r.Name))
                    {
                        var weight = row.Actual <= 0 ? 1m : row.Actual;
                        <span class="equity-segment dev-band-@row.Band.ToString().ToLowerInvariant()"
                              style="flex: @weight.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                              title="@row.Name @row.Actual.ToString("F0")">
                        </span>
                    }
                </div>
            }

            <div class="verdict-callouts">
                <div class="callout callout--over">
                    <span class="callout-label"><loc key="Justice_MostOver" /></span>
                    <span class="callout-value">
                        @if (v.MostOver is not null)
                        {
                            @v.MostOver.Name <span dir="ltr">(@FormatDeviation(v.MostOver.DeviationPercent))</span>
                        }
                        else
                        {
                            <span class="text-subtle"><loc key="Justice_None" /></span>
                        }
                    </span>
                </div>
                <div class="callout callout--under">
                    <span class="callout-label"><loc key="Justice_MostUnder" /></span>
                    <span class="callout-value">
                        @if (v.MostUnder is not null)
                        {
                            @v.MostUnder.Name <span dir="ltr">(@FormatDeviation(v.MostUnder.DeviationPercent))</span>
                        }
                        else
                        {
                            <span class="text-subtle"><loc key="Justice_None" /></span>
                        }
                    </span>
                </div>
            </div>
        </section>

        @* ========== Justice Table ========== *@
        <section class="section-card">
            <div class="section-header">
                <h2 class="section-title"><loc key="Justice_Table_Heading" /></h2>
                <span class="text-subtle">@v.Rows.Count <loc key="Justice_Rows" /></span>
            </div>

            @if (v.Rows.Count == 0)
            {
                <div class="success-state">
                    <icon name="check-circle" size="md" />
                    <p><loc key="Justice_NothingToBalance" /></p>
                </div>
            }
            else
            {
                <div class="table-wrapper">
                    <table class="data-table justice-table">
                        <thead>
                            <tr>
                                <th><loc key="Justice_Col_Name" /></th>
                                <th class="num"><loc key="Justice_Col_Actual" /></th>
                                <th class="num"><loc key="Justice_Col_Expected" /></th>
                                <th class="num"><loc key="Justice_Col_Deviation" /></th>
                                <th><loc key="Justice_Col_Bar" /></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in v.Rows)
                            {
                                <tr>
                                    <td>
                                        <div class="row-name">
                                            @if (!string.IsNullOrEmpty(row.AvatarUrl))
                                            {
                                                <img src="@row.AvatarUrl" alt="" class="row-avatar" loading="lazy"
                                                     onerror="this.onerror=null;this.style.display='none';this.nextElementSibling?.classList.add('row-avatar-fallback--visible');" />
                                                <span class="row-avatar-fallback">@GetInitials(row.Name)</span>
                                            }
                                            else if (Model.Level == JusticeLevel.UsersInCompany)
                                            {
                                                <span class="row-avatar-fallback row-avatar-fallback--visible">@GetInitials(row.Name)</span>
                                            }
                                            <span class="row-name-text">@row.Name</span>
                                        </div>
                                    </td>
                                    <td class="num" dir="ltr">@row.Actual.ToString("F0")</td>
                                    <td class="num" dir="ltr">@row.Expected.ToString("F1")</td>
                                    <td class="num">
                                        <span class="dev-pill dev-band-@row.Band.ToString().ToLowerInvariant()" dir="ltr">
                                            @FormatDeviation(row.DeviationPercent)
                                        </span>
                                    </td>
                                    <td>
                                        @if (row.DeviationPercent.HasValue)
                                        {
                                            var dev = row.DeviationPercent.Value;
                                            var clamped = Math.Max(-100m, Math.Min(100m, dev));
                                            // Map -100..0..+100 to 0..50..100 percent on the bar.
                                            var barPos = (50m + clamped / 2m).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
                                            <span class="dev-bar" dir="ltr" aria-hidden="true">
                                                <span class="dev-bar-zero"></span>
                                                <span class="dev-bar-marker dev-band-@row.Band.ToString().ToLowerInvariant()" style="left: @(barPos)%"></span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-subtle"><loc key="Justice_NoTarget" /></span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</div>

@functions {
    string FormatDeviation(decimal? pct)
    {
        if (!pct.HasValue) return "—";
        var sign = pct.Value > 0 ? "+" : "";
        return $"{sign}{pct.Value:F0}%";
    }

    string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }
}
