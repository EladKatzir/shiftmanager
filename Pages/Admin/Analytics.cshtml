<script>
function toggleAnalyticsTheme() {
    const isDark = document.body.classList.toggle('analytics-dark-mode');
    localStorage.setItem('analytics-theme', isDark ? 'dark' : 'light');
}

// Load saved theme on page load
document.addEventListener('DOMContentLoaded', function() {
    const savedTheme = localStorage.getItem('analytics-theme');
    if (savedTheme === 'dark') {
        document.body.classList.add('analytics-dark-mode');
    }
});
</script>
