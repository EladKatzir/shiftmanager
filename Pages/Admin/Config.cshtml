@page
@model ShiftManager.Pages.Admin.ConfigModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["Config"];
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Admin"], Url = "/Admin/Users" },
    new BreadcrumbItem { Label = Localizer["Config"], IsActive = true }
})

@section Styles {
    <style>
        /* Page Header */
        .page-header {
            margin-bottom: 2rem;
        }

        .page-title {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text);
            margin: 0 0 0.5rem 0;
            line-height: 1.2;
        }

        .page-subtitle {
            font-size: 1rem;
            color: var(--text-muted);
            margin: 0;
            line-height: 1.5;
        }

        /* Alerts */
        .alert-success {
            padding: 1rem 1.25rem;
            border-radius: 10px;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 0.9375rem;
            font-weight: 500;
            background: var(--success);
            color: var(--success-text);
            border: 1px solid rgba(var(--success-rgb, 16, 185, 129), 0.3);
        }

        .alert-error {
            padding: 1rem 1.25rem;
            border-radius: 10px;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 0.9375rem;
            font-weight: 500;
            background: var(--danger);
            color: var(--danger-text);
            border: 1px solid rgba(var(--danger-rgb, 244, 67, 54), 0.3);
        }

        /* Section */
        .config-section {
            margin-bottom: 2rem;
        }

        .section-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: var(--shadow-sm);
        }

        .section-header {
            font-size: 1.125rem;
            font-weight: 600;
            color: var(--text);
            margin: 0 0 1rem 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .section-description {
            font-size: 0.875rem;
            color: var(--text-muted);
            margin-bottom: 1.5rem;
            line-height: 1.5;
        }

        /* Form Elements */
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr auto;
            gap: 1rem;
            align-items: end;
        }

        .form-group {
            margin-bottom: 1rem;
        }

        .form-label {
            display: block;
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--text-muted);
            margin-bottom: 0.5rem;
        }

        .form-input {
            width: 100%;
            padding: 0.625rem 0.875rem;
            font-size: 0.9375rem;
            color: var(--text);
            background: var(--surface-soft);
            border: 1px solid var(--border);
            border-radius: 8px;
            transition: all 0.15s ease;
        }

        .form-input:hover {
            border-color: var(--primary);
            background: var(--surface);
        }

        .form-input:focus {
            outline: none;
            border-color: var(--primary);
            background: var(--surface);
            box-shadow: 0 0 0 3px rgba(var(--primary-rgb, 59, 130, 246), 0.1);
        }

        .form-hint {
            display: block;
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-top: 0.25rem;
        }

        .form-checkbox {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            cursor: pointer;
            padding: 0.75rem;
            border-radius: 8px;
            transition: background-color 0.15s ease;
        }

        .form-checkbox:hover {
            background: var(--surface-soft);
        }

        .form-checkbox input[type="checkbox"] {
            width: auto;
            cursor: pointer;
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            padding: 0.625rem 1.25rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.15s ease;
            text-decoration: none;
            white-space: nowrap;
        }

        .btn-primary {
            background: var(--primary);
            color: var(--primary-contrast);
            border-color: var(--primary);
        }

        .btn-primary:hover {
            background: var(--primary-hover);
            border-color: var(--primary-hover);
            transform: translateY(-1px);
            box-shadow: var(--shadow-md);
        }

        .btn-success {
            background: var(--success);
            color: var(--success-text);
            border-color: var(--success);
        }

        .btn-success:hover {
            background: var(--success-hover);
            border-color: var(--success-hover);
            transform: translateY(-1px);
            box-shadow: var(--shadow-md);
        }

        .btn-danger {
            background: var(--danger);
            color: var(--danger-text);
            border-color: var(--danger);
        }

        .btn-danger:hover {
            background: var(--danger-hover);
            border-color: var(--danger-hover);
            transform: translateY(-1px);
            box-shadow: var(--shadow-md);
        }

        .btn-ghost {
            background: transparent;
            color: var(--text);
            border-color: transparent;
        }

        .btn-ghost:hover {
            background: var(--surface-soft);
            border-color: var(--border);
        }

        /* Type Items */
        .type-list {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            margin-bottom: 1rem;
        }

        .type-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1rem;
            background: var(--surface-soft);
            border: 1px solid var(--border);
            border-radius: 8px;
            transition: all 0.15s ease;
        }

        .type-item:hover {
            background: var(--surface);
            box-shadow: var(--shadow-sm);
        }

        .type-info {
            display: flex;
            align-items: center;
            gap: 1rem;
            flex: 1;
        }

        .type-icon {
            font-size: 2rem;
            flex-shrink: 0;
        }

        .type-details {
            flex: 1;
        }

        .type-name {
            font-size: 0.9375rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 0.25rem;
        }

        .type-value {
            font-size: 0.8125rem;
            color: var(--text-muted);
        }

        .type-actions {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .type-badge {
            display: inline-flex;
            align-items: center;
            padding: 0.25rem 0.75rem;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.025em;
        }

        .type-badge-default {
            background: var(--accent-soft);
            color: var(--accent);
        }

        .type-badge-custom {
            background: var(--primary-soft);
            color: var(--primary);
        }

        /* Modal */
        #addTypeModal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(4px);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            animation: fadeIn 0.2s ease;
        }

        #addTypeModal.active {
            display: flex;
        }

        .modal-content {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 2rem;
            max-width: 500px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: var(--shadow-xl);
            animation: slideUp 0.3s ease;
        }

        .modal-header {
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 1.5rem;
        }

        .modal-footer {
            display: flex;
            gap: 0.5rem;
            justify-content: flex-end;
            margin-top: 1.5rem;
        }

        /* Info Box */
        .info-box {
            margin-top: 1.5rem;
            padding: 1rem;
            background: var(--surface-soft);
            border-left: 4px solid var(--primary);
            border-radius: 8px;
        }

        .info-box summary {
            cursor: pointer;
            font-weight: 600;
            color: var(--text);
            user-select: none;
        }

        .info-box summary:hover {
            color: var(--primary);
        }

        .info-box-content {
            margin-top: 0.75rem;
            padding-left: 1rem;
            color: var(--text-muted);
            font-size: 0.875rem;
            line-height: 1.6;
        }

        .info-box-content p {
            margin: 0.5rem 0;
        }

        /* Subsection Headers */
        .subsection-header {
            font-size: 0.9375rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 0.75rem;
            margin-top: 1.5rem;
        }

        .subsection-header:first-child {
            margin-top: 0;
        }

        /* Animations */
        @@keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .form-grid {
                grid-template-columns: 1fr;
            }

            .page-title {
                font-size: 1.75rem;
            }

            .section-card {
                padding: 1.25rem;
            }

            .type-item {
                flex-direction: column;
                align-items: flex-start;
                gap: 1rem;
            }

            .type-actions {
                width: 100%;
                justify-content: space-between;
            }
        }

        @@media (max-width: 480px) {
            .page-title {
                font-size: 1.5rem;
            }

            .modal-content {
                padding: 1.5rem;
            }
        }
    </style>
}

<!-- Page Header -->
<div class="page-header">
    <h1 class="page-title"><loc key="Config" /></h1>
    <p class="page-subtitle"><loc key="ConfigureSystemSettings" /></p>
</div>

<!-- Success Message -->
@if (!string.IsNullOrEmpty(Model.Success))
{
    <div class="alert-success">
        <span style="font-size: 1.25rem;"><icon name="check" /></span>
        <span>@Model.Success</span>
    </div>
}

<!-- Error Message -->
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert-error">
        <span style="font-size: 1.25rem;"><icon name="x" /></span>
        <span>@Model.Error</span>
    </div>
}

<!-- Company Settings Section -->
<div class="config-section">
    <div class="section-card" style="max-width: 800px;">
        <h3 class="section-header">
            <span><icon name="settings" /></span>
            <span><loc key="CompanySettings" /></span>
        </h3>
        <form method="post">
            @Html.AntiForgeryToken()
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label" for="RestHours"><loc key="RestHours" /></label>
                    <input class="form-input" asp-for="RestHours" type="number" min="0" id="RestHours" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="WeeklyCap"><loc key="WeeklyCap" /></label>
                    <input class="form-input" asp-for="WeeklyCap" type="number" min="0" id="WeeklyCap" />
                </div>
                <button class="btn btn-primary" type="submit">
                    <span><icon name="save" /></span>
                    <span><loc key="Save" /></span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Phase 8.6: Removed redundant Email Configuration section - users can access /Owner/EmailConfig directly -->

<!-- OnDuty Types Section -->
<div class="config-section">
    <div class="section-card">
        <h3 class="section-header">
            <span><icon name="file-text" /></span>
            <span><loc key="OnDutyTypes" /></span>
        </h3>
        <p class="section-description">
            @Localizer["OnDutyTypesDescription"]
        </p>

        <!-- Default Types (Read-only) -->
        <h4 class="subsection-header"><loc key="DefaultTypes" /></h4>
        <div class="type-list">
            <div class="type-item">
                <div class="type-info">
                    <span class="type-icon"><icon name="shield" /></span>
                    <div class="type-details">
                        <div class="type-name"><loc key="OnDutyHakam" /></div>
                        <div class="type-value"><loc key="ValueLabel" />: 0</div>
                    </div>
                </div>
                <div class="type-actions">
                    <span class="type-badge type-badge-default"><loc key="Default" /></span>
                </div>
            </div>
            <div class="type-item">
                <div class="type-info">
                    <span class="type-icon"><icon name="star" /></span>
                    <div class="type-details">
                        <div class="type-name"><loc key="OnDutyLead" /></div>
                        <div class="type-value"><loc key="ValueLabel" />: 1</div>
                    </div>
                </div>
                <div class="type-actions">
                    <span class="type-badge type-badge-default"><loc key="Default" /></span>
                </div>
            </div>
        </div>

        <!-- Custom Types -->
        @if (Model.OnDutyTypes.Any())
        {
            <h4 class="subsection-header"><loc key="CustomTypes" /></h4>
            <div class="type-list">
                @foreach (var type in Model.OnDutyTypes)
                {
                    <div class="type-item">
                        <div class="type-info">
                            <span class="type-icon" style="color: @type.Color;">
                                @if (!string.IsNullOrEmpty(type.Icon) && System.Text.RegularExpressions.Regex.IsMatch(type.Icon, "^[a-z][a-z0-9-]*$"))
                                {
                                    <icon name="@type.Icon" size="lg" />
                                }
                                else
                                {
                                    @* Legacy emoji value from before Lucide migration — render as-is *@
                                    @type.Icon
                                }
                            </span>
                            <div class="type-details">
                                <div class="type-name">@type.NameEn / @type.NameHe</div>
                                <div class="type-value"><loc key="ValueLabel" />: @type.TypeValue</div>
                            </div>
                        </div>
                        <div class="type-actions">
                            <span class="type-badge type-badge-custom" style="background: @type.Color; color: var(--primary-contrast);">
                                @Localizer["Custom"]
                            </span>
                            <form method="post" asp-page-handler="DeleteOnDutyType" style="display: inline;"
                                  data-confirm-modal
                                  data-confirm-title="@Localizer["ConfirmDeleteOnDutyType_Title"]"
                                  data-confirm-message="@string.Format(Localizer["ConfirmDeleteOnDutyType"].Value, type.NameEn)"
                                  data-confirm-action="@Localizer["Delete"]"
                                  data-confirm-level="danger">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="typeId" value="@type.Id" />
                                <button type="submit" class="btn btn-danger">
                                    <span><icon name="trash" /></span>
                                    <span><loc key="Delete" /></span>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Add New Type Button -->
        <button class="btn btn-success" style="margin-top: 1.5rem;" onclick="openAddTypeModal()">
            <span><icon name="plus" /></span>
            <span><loc key="AddNewOnDutyType" /></span>
        </button>
    </div>
</div>

<!-- Add OnDuty Type Modal -->
<div id="addTypeModal">
    <div class="modal-content">
        <h3 class="modal-header"><loc key="AddNewOnDutyType" /></h3>
        <form method="post" asp-page-handler="AddOnDutyType">
            @Html.AntiForgeryToken()

            @* ✅ PHASE 18: TypeValue is now auto-generated, no manual input needed *@

            <div class="form-group">
                <label class="form-label" for="onDutyTypeNameEn"><loc key="NameEnglish" /></label>
                <input type="text" name="NameEn" id="onDutyTypeNameEn" class="form-input" maxlength="100" required />
            </div>

            <div class="form-group">
                <label class="form-label" for="onDutyTypeNameHe"><loc key="NameHebrew" /></label>
                <input type="text" name="NameHe" id="onDutyTypeNameHe" class="form-input" maxlength="100" required />
            </div>

            <div class="form-group">
                <label class="form-label" for="onDutyTypeIcon"><loc key="Icon" /></label>
                @* Lucide icon picker. The Icon column stores a Lucide name (e.g. "shield", "pin") — rendered via <icon> everywhere it appears. *@
                <input type="hidden" name="Icon" id="onDutyTypeIcon" value="pin" maxlength="32" />
                <div class="icon-picker" id="onDutyTypeIconPicker" role="radiogroup" aria-label="@Localizer["Icon"]">
                    @foreach (var iconName in new[] {
                        "shield", "shield-check", "star", "pin", "target", "bell", "siren",
                        "flag", "alert-triangle", "user", "users", "users-round", "key", "lock",
                        "radio", "phone", "mail", "hammer", "briefcase", "medal", "zap",
                        "heart", "home", "eye", "search", "sparkles", "sun", "moon", "globe",
                        "calendar", "calendar-check", "clock", "file-text", "clipboard-list",
                        "building", "building-2", "landmark", "map-pin", "tag"
                    })
                    {
                        <button type="button" class="icon-picker__option" data-icon="@iconName"
                                role="radio" aria-label="@iconName" title="@iconName">
                            <icon name="@iconName" size="md" />
                        </button>
                    }
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" for="onDutyTypeColor"><loc key="Color" /> (@Localizer["HexColor"])</label>
                <input type="color" name="Color" id="onDutyTypeColor" class="form-input" value="#6366f1" />
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" onclick="closeAddTypeModal()">@Localizer["Cancel"]</button>
                <button type="submit" class="btn btn-primary">
                    <span><icon name="plus" /></span>
                    <span><loc key="Add" /></span>
                </button>
            </div>
        </form>
    </div>
</div>

<style>
.icon-picker {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(42px, 1fr));
    gap: 0.5rem;
    padding: 0.5rem;
    background: var(--surface-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    max-height: 220px;
    overflow-y: auto;
}
.icon-picker__option {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    padding: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    cursor: pointer;
    transition: all 0.15s ease;
}
.icon-picker__option:hover {
    border-color: var(--primary);
    background: var(--primary-soft);
}
.icon-picker__option.is-selected {
    border-color: var(--primary);
    background: var(--primary-soft);
    color: var(--primary);
    box-shadow: 0 0 0 2px rgba(var(--primary-rgb), 0.25);
}
.icon-picker__option:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
}
</style>

<script>
function openAddTypeModal() {
    document.getElementById('addTypeModal').classList.add('active');
}

function closeAddTypeModal() {
    document.getElementById('addTypeModal').classList.remove('active');
}

// Icon picker — clicking an option stores its name in the hidden input and marks it selected.
(function () {
    var picker = document.getElementById('onDutyTypeIconPicker');
    var hidden = document.getElementById('onDutyTypeIcon');
    if (!picker || !hidden) return;

    function select(opt) {
        picker.querySelectorAll('.icon-picker__option').forEach(function (el) {
            el.classList.toggle('is-selected', el === opt);
            el.setAttribute('aria-checked', el === opt ? 'true' : 'false');
        });
        hidden.value = opt.dataset.icon;
    }

    // Preselect matching the hidden input's current value.
    var initial = picker.querySelector('.icon-picker__option[data-icon="' + hidden.value + '"]')
        || picker.querySelector('.icon-picker__option');
    if (initial) select(initial);

    picker.addEventListener('click', function (e) {
        var opt = e.target.closest('.icon-picker__option');
        if (opt) select(opt);
    });
})();

// Close modal on backdrop click
document.getElementById('addTypeModal').addEventListener('click', (e) => {
    if (e.target.id === 'addTypeModal') {
        closeAddTypeModal();
    }
});
</script>
