@page
@model ShiftManager.Pages.Admin.EditProfileModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.Helpers
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["EditProfile_Title"];
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Admin"], Url = "/Admin/Users" },
    new BreadcrumbItem { Label = Localizer["EditProfile_Title"], IsActive = true }
})

<div class="profile-edit-container">
    <div class="profile-edit-header">
        <h1 class="profile-edit-title">@Localizer["EditProfile_Title"]</h1>
        <p class="profile-edit-subtitle">@Localizer["EditingProfile"]: <strong>@Model.DisplayName</strong></p>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">
            <span class="alert-icon">✓</span>
            <span>@Model.SuccessMessage</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error">
            <span class="alert-icon">✗</span>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <form method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="UserId" />

        <div class="profile-cards-grid">
            <!-- Row 1: Personal Info + Account Settings -->
            <div class="profile-card">
                <div class="profile-card__header">
                    <span class="profile-card__icon">👤</span>
                    <h2 class="profile-card__title">@Localizer["EditProfile_PersonalInfo"]</h2>
                </div>
                <div class="profile-card__body">
                    <!-- Avatar -->
                    <div class="avatar-section">
                        @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                        {
                            <img src="@Model.AvatarUrl" alt="Avatar" class="avatar-preview" loading="lazy" decoding="async" />
                        }
                        else
                        {
                            <div class="avatar-placeholder">@Model.InitialsForAvatar</div>
                        }
                        <div class="avatar-upload">
                            <label class="form-label form-label--sm">@Localizer["EditProfile_UploadAvatar"]</label>
                            <input type="file" name="AvatarFile" accept=".jpg,.jpeg,.png" class="form-input form-input--file" />
                            @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                            {
                                <button type="submit" asp-page-handler="DeleteAvatar" class="btn btn-sm btn-danger" style="margin-top: 0.5rem;">
                                    @Localizer["EditProfile_DeleteAvatar"]
                                </button>
                            }
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">@Localizer["Label_DisplayName"] *</label>
                            <input type="text" asp-for="DisplayName" class="form-input" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">@Localizer["Label_PreferredName"]</label>
                            <input type="text" asp-for="PreferredName" class="form-input" loc-placeholder="Placeholder_PreferredName" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">@Localizer["Label_Phone"]</label>
                            <input type="tel" asp-for="Phone" class="form-input" loc-placeholder="Placeholder_Phone" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">@Localizer["Label_DateOfBirth"]</label>
                            <input type="date" asp-for="DateOfBirth" class="form-input" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">@Localizer["Label_City"]</label>
                        <input type="text" asp-for="City" class="form-input" loc-placeholder="Placeholder_City" />
                    </div>
                </div>
            </div>

            <div class="profile-card">
                <div class="profile-card__header">
                    <span class="profile-card__icon">🔐</span>
                    <h2 class="profile-card__title">@Localizer["EditProfile_AccountSettings"]</h2>
                </div>
                <div class="profile-card__body">
                    <div class="form-group">
                        <label class="form-label">@Localizer["Label_Email"] *</label>
                        <input type="email" asp-for="Email" class="form-input" required />
                    </div>

                    <div class="form-group">
                        <label class="form-label">@Localizer["Label_Role"] *</label>
                        <select asp-for="RoleTemplateId" class="form-input" required>
                            @foreach (var rt in Model.AvailableRoleTemplates)
                            {
                                <option value="@rt.Id" selected="@(rt.Id == Model.RoleTemplateId)">
                                    @RoleDisplayHelper.GetRoleDisplayName(Localizer, rt)
                                </option>
                            }
                        </select>
                        <input type="hidden" asp-for="Role" />
                    </div>

                    <div class="form-group">
                        <label class="form-checkbox">
                            <input type="checkbox" asp-for="IsActive" />
                            <span class="form-checkbox__label">@Localizer["EditProfile_ActiveAccount"]</span>
                        </label>
                    </div>

                    <div class="grants-summary">
                        <span class="grants-summary__label">@Localizer["Grants"]:</span>
                        <span class="grants-summary__badge">@Model.GrantsCount</span>
                        @if (Model.GrantsCount > 0)
                        {
                            <a href="/Admin/Organization/Grants?FilterUserId=@Model.UserId" class="grants-summary__link">@Localizer["ManageGrants"] →</a>
                        }
                    </div>
                </div>
            </div>

            <!-- Row 2: Emergency Contact + Professional -->
            <div class="profile-card">
                <div class="profile-card__header">
                    <span class="profile-card__icon">📞</span>
                    <h2 class="profile-card__title">@Localizer["EditProfile_EmergencyContact"]</h2>
                </div>
                <div class="profile-card__body">
                    <div class="form-group">
                        <label class="form-label">@Localizer["Label_EmergencyContactName"]</label>
                        <input type="text" asp-for="EmergencyContactName" class="form-input" loc-placeholder="Placeholder_EmergencyContactName" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">@Localizer["Label_EmergencyContactPhone"]</label>
                        <input type="tel" asp-for="EmergencyContactPhone" class="form-input" loc-placeholder="Placeholder_Phone" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">@Localizer["Label_Relationship"]</label>
                        <input type="text" asp-for="EmergencyContactRelation" class="form-input" loc-placeholder="Placeholder_EmergencyContactRelation" />
                    </div>
                </div>
            </div>

            <div class="profile-card">
                <div class="profile-card__header">
                    <span class="profile-card__icon">💼</span>
                    <h2 class="profile-card__title">@Localizer["EditProfile_ProfessionalInfo"]</h2>
                </div>
                <div class="profile-card__body">
                    @if ((Model.IsWorkforceMolecule || Model.IsTechMolecule) && Model.AvailableJobTypes.Any())
                    {
                        <div class="form-group">
                            <label class="form-label">@Localizer["JobType"]</label>
                            <select asp-for="JobTypeId" class="form-input">
                                <option value="">-- @Localizer["NoJobType"] --</option>
                                @foreach (var jt in Model.AvailableJobTypes)
                                {
                                    <option value="@jt.Id">@jt.Name</option>
                                }
                            </select>
                            <span class="form-hint">@Localizer["JobTypeDescription"]</span>
                        </div>
                    }

                    <div class="form-group">
                        <label class="form-label">@Localizer["Profile_Rank"]</label>
                        <select asp-for="Rank" class="form-input" asp-items="Model.RankOptions"></select>
                        <span class="form-hint">@Localizer["Profile_Rank_Help"]</span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">@Localizer["Molecule"]</label>
                        <input type="text" value="@Model.MoleculeName" class="form-input" readonly />
                    </div>

                    <div class="form-group">
                        <label class="form-label">@Localizer["JobTitle"]</label>
                        <input type="text" value="@Model.ComputedJobTitle" class="form-input" readonly />
                    </div>

                    <div class="form-group">
                        <label class="form-label">@Localizer["Label_HireDate"]</label>
                        <input type="date" asp-for="HireDate" class="form-input" />
                    </div>
                </div>
            </div>

            <!-- Row 3: Skills & Certifications (full width) -->
            <div class="profile-card profile-card--full">
                <div class="profile-card__header">
                    <span class="profile-card__icon">🎯</span>
                    <h2 class="profile-card__title">@Localizer["EditProfile_SkillsCertifications"]</h2>
                </div>
                <div class="profile-card__body">
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">@Localizer["Label_Skills"]</label>
                            <input type="text" asp-for="Skills" class="form-input" loc-placeholder="Placeholder_Skills" />
                            <span class="form-hint">@Localizer["SkillsHint"]</span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">@Localizer["Label_Certifications"]</label>
                            <input type="text" asp-for="Certifications" class="form-input" loc-placeholder="Placeholder_Certifications" />
                            <span class="form-hint">@Localizer["CertificationsHint"]</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="profile-actions">
            <button type="submit" class="btn btn-primary btn-lg">
                @Localizer["Button_SaveChanges"]
            </button>
            <a href="/Admin/Users" class="btn btn-secondary btn-lg">
                @Localizer["Button_Cancel"]
            </a>
        </div>
    </form>

    @if (Model.RecentChanges.Any())
    {
        <div class="profile-card profile-card--history">
            <div class="profile-card__header">
                <span class="profile-card__icon">📋</span>
                <h2 class="profile-card__title">@Localizer["EditProfile_RecentChanges"]</h2>
            </div>
            <div class="profile-card__body">
                <table class="history-table">
                    <thead>
                        <tr>
                            <th>@Localizer["Table_Date"]</th>
                            <th>@Localizer["Table_Field"]</th>
                            <th>@Localizer["Table_OldValue"]</th>
                            <th>@Localizer["Table_NewValue"]</th>
                            <th>@Localizer["Table_ChangedBy"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var change in Model.RecentChanges)
                        {
                            <tr>
                                <td>@change.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
                                <td><strong>@change.FieldName</strong></td>
                                <td class="history-table__old">@(change.OldValue ?? "(empty)")</td>
                                <td class="history-table__new">@(change.NewValue ?? "(empty)")</td>
                                <td>@(change.ChangedByUser?.DisplayName ?? "Unknown")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<style>
.profile-edit-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem;
}

.profile-edit-header {
    margin-bottom: 1.5rem;
}

.profile-edit-title {
    font-size: 1.75rem;
    font-weight: 700;
    margin: 0 0 0.25rem 0;
    color: var(--text);
}

.profile-edit-subtitle {
    color: var(--text-muted);
    margin: 0;
}

/* Alerts */
.alert {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-radius: 10px;
    margin-bottom: 1.5rem;
    font-weight: 500;
}

.alert-success {
    background: var(--success-soft);
    color: var(--success);
}

.alert-error {
    background: var(--danger-soft);
    color: var(--danger);
}

.alert-icon {
    font-size: 1.25rem;
}

/* Cards Grid */
.profile-cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 1.5rem;
}

.profile-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
}

.profile-card--full {
    grid-column: 1 / -1;
}

.profile-card--history {
    margin-top: 2rem;
}

.profile-card__header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: var(--surface-soft);
    border-bottom: 1px solid var(--border);
}

.profile-card__icon {
    font-size: 1.25rem;
}

.profile-card__title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    color: var(--text);
}

.profile-card__body {
    padding: 1.25rem;
}

/* Avatar Section */
.avatar-section {
    display: flex;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
}

.avatar-preview,
.avatar-placeholder {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    flex-shrink: 0;
}

.avatar-preview {
    object-fit: cover;
}

.avatar-placeholder {
    background: var(--primary);
    color: var(--primary-contrast);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 700;
}

.avatar-upload {
    flex: 1;
}

/* Form Elements */
.form-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
}

.form-group {
    margin-bottom: 1rem;
}

.form-group:last-child {
    margin-bottom: 0;
}

.form-label {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 0.375rem;
}

.form-label--sm {
    font-size: 0.8125rem;
}

.form-input {
    width: 100%;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
    font-size: 0.875rem;
    transition: border-color 0.15s, box-shadow 0.15s;
}

.form-input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-bg);
}

.form-input--file {
    padding: 0.5rem;
    font-size: 0.8125rem;
}

.form-hint {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
}

.form-checkbox {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
}

.form-checkbox input {
    width: auto;
    margin: 0;
}

.form-checkbox__label {
    font-size: 0.875rem;
    font-weight: 500;
}

/* Grants Summary */
.grants-summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem;
    background: var(--surface-soft);
    border-radius: 8px;
    margin-top: 1rem;
}

.grants-summary__label {
    font-weight: 600;
    font-size: 0.875rem;
}

.grants-summary__badge {
    background: var(--primary-bg);
    color: var(--primary);
    padding: 0.25rem 0.75rem;
    border-radius: 12px;
    font-weight: 700;
    font-size: 0.875rem;
}

.grants-summary__link {
    color: var(--primary);
    font-size: 0.8125rem;
    margin-left: auto;
}

/* Buttons */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
    text-decoration: none;
}

.btn-lg {
    padding: 0.75rem 1.5rem;
    font-size: 0.9375rem;
}

.btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
}

.btn-primary {
    background: var(--primary);
    color: var(--primary-contrast);
    border-color: var(--primary);
}

.btn-primary:hover {
    background: var(--primary-hover);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
}

.btn-secondary {
    background: var(--surface);
    color: var(--text);
}

.btn-secondary:hover {
    background: var(--surface-elevated);
    transform: translateY(-1px);
}

.btn-danger {
    background: var(--danger);
    color: var(--danger-text);
    border-color: var(--danger);
}

.profile-actions {
    display: flex;
    gap: 0.75rem;
    padding-top: 0.5rem;
}

/* History Table */
.history-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
}

.history-table th,
.history-table td {
    padding: 0.75rem;
    text-align: start;
    border-bottom: 1px solid var(--border);
}

.history-table th {
    font-weight: 600;
    color: var(--text);
    background: var(--surface-soft);
}

.history-table__old {
    color: var(--text-muted);
}

.history-table__new {
    font-weight: 600;
    color: var(--success);
}

/* Responsive */
@@media (max-width: 768px) {
    .profile-edit-container {
        padding: 1rem;
    }

    .profile-cards-grid {
        grid-template-columns: 1fr;
    }

    .form-row {
        grid-template-columns: 1fr;
    }

    .avatar-section {
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .profile-actions {
        flex-direction: column;
    }

    .profile-actions .btn {
        width: 100%;
    }

    .history-table {
        font-size: 0.75rem;
    }

    .history-table th,
    .history-table td {
        padding: 0.5rem;
    }
}
</style>
