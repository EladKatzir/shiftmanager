@page
@model ShiftManager.Pages.Admin.AuditLogModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@{
    ViewData["Title"] = Localizer["AuditLog"];
    Layout = "_Layout";
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Admin"], Url = "/Admin/Users" },
    new BreadcrumbItem { Label = Localizer["AuditLog"], IsActive = true }
})

<h2>📋 @Localizer["AuditLog"]</h2>

<p style="color: var(--text-muted); margin-bottom: 1.5rem;">@Localizer["AuditLogDescription", Model.TotalRecords]</p>

<!-- Filters -->
<div class="card">
    <h3 style="margin-top:0">@Localizer["Filters"]</h3>
    <form method="get" style="margin-bottom: 1rem;">
        <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap:.75rem;">
            <label>
                @Localizer["StartDate"]<br />
                <input type="date" name="StartDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="input" />
            </label>

            <label>
                @Localizer["EndDate"]<br />
                <input type="date" name="EndDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="input" />
            </label>

            <label>
                @Localizer["User"]<br />
                <select name="UserId" class="input">
                    <option value="">@Localizer["AllUsers"]</option>
                    @foreach (var user in Model.Users)
                    {
                        <option value="@user.Id" selected="@(Model.UserId == user.Id)">@user.DisplayName</option>
                    }
                </select>
            </label>

            <label>
                @Localizer["Action"]<br />
                <select name="Action" class="input">
                    <option value="">@Localizer["AllActions"]</option>
                    @foreach (var action in Model.Actions)
                    {
                        <option value="@action" selected="@(Model.Action == action)">@action</option>
                    }
                </select>
            </label>

            <label>
                @Localizer["EntityType"]<br />
                <select name="EntityType" class="input">
                    <option value="">@Localizer["AllEntityTypes"]</option>
                    @foreach (var entityType in Model.EntityTypes)
                    {
                        <option value="@entityType" selected="@(Model.EntityType == entityType)">@entityType</option>
                    }
                </select>
            </label>

            <label>
                @Localizer["Search"]<br />
                <input type="text" name="SearchTerm" value="@Model.SearchTerm" placeholder="@Localizer["SearchPlaceholder"]" class="input" />
            </label>
        </div>

        <div style="display:flex; gap:.75rem; margin-top:1rem; flex-wrap:wrap;">
            <button type="submit" class="btn">@Localizer["ApplyFilters"]</button>
            <a href="/Admin/AuditLog" class="btn btn-ghost">@Localizer["ClearFilters"]</a>
            <a href="?handler=ExportCsv&StartDate=@Model.StartDate?.ToString("yyyy-MM-dd")&EndDate=@Model.EndDate?.ToString("yyyy-MM-dd")&UserId=@Model.UserId&Action=@Model.Action&EntityType=@Model.EntityType&SearchTerm=@Model.SearchTerm" class="btn" style="margin-left: auto;">
                📥 @Localizer["ExportCSV"]
            </a>
        </div>
    </form>
</div>

<!-- Results Summary -->
@if (Model.TotalRecords > 0)
{
    <p style="color: var(--text-muted); margin-bottom: 1rem;">
        @Localizer["ShowingResults", (Model.CurrentPage - 1) * Model.PageSize + 1, Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords), Model.TotalRecords]
    </p>
}

<!-- Audit Log Table -->
@if (Model.AuditLogs.Any())
{
    <div class="card">
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="border-bottom: 2px solid var(--border); text-align: left;">
                        <th style="padding: 0.75rem;">@Localizer["Timestamp"]</th>
                        <th style="padding: 0.75rem;">@Localizer["User"]</th>
                        <th style="padding: 0.75rem;">@Localizer["Action"]</th>
                        <th style="padding: 0.75rem;">@Localizer["EntityType"]</th>
                        <th style="padding: 0.75rem;">@Localizer["Description"]</th>
                        <th style="padding: 0.75rem;">@Localizer["IPAddress"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.AuditLogs)
                    {
                        <tr style="border-bottom: 1px solid var(--border);" onclick="toggleDetails@(log.Id)()" style="cursor: pointer;">
                            <td style="padding: 0.75rem;">
                                <div style="font-weight: 500;">@log.Timestamp.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                <div style="font-size: 0.85rem; color: var(--text-muted);">@log.Timestamp.ToLocalTime().ToString("HH:mm:ss")</div>
                            </td>
                            <td style="padding: 0.75rem;">
                                <div style="font-weight: 500;">@log.UserDisplayName</div>
                                <div style="font-size: 0.85rem; color: var(--text-muted);">@log.UserEmail</div>
                            </td>
                            <td style="padding: 0.75rem;">
                                <span style="background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); color: white; padding: 0.25rem 0.75rem; border-radius: 0.5rem; font-size: 0.85rem; font-weight: 600; white-space: nowrap;">
                                    @log.Action
                                </span>
                            </td>
                            <td style="padding: 0.75rem;">
                                <div style="font-weight: 500;">@log.EntityType</div>
                                @if (log.EntityId.HasValue)
                                {
                                    <div style="font-size: 0.85rem; color: var(--text-muted);">#@log.EntityId</div>
                                }
                            </td>
                            <td style="padding: 0.75rem;">@log.Description</td>
                            <td style="padding: 0.75rem;">
                                <code style="background: var(--bg); padding: 0.25rem 0.5rem; border-radius: 0.25rem; font-size: 0.85rem;">@log.IpAddress</code>
                            </td>
                        </tr>
                        @if (!string.IsNullOrWhiteSpace(log.Details) || !string.IsNullOrWhiteSpace(log.UserAgent))
                        {
                            <tr id="details@(log.Id)" style="display: none; background: var(--bg); border-bottom: 1px solid var(--border);">
                                <td colspan="6" style="padding: 1rem;">
                                    @if (!string.IsNullOrWhiteSpace(log.Details))
                                    {
                                        <div style="margin-bottom: 1rem;">
                                            <strong>@Localizer["AdditionalDetails"]:</strong>
                                            <pre style="background: white; border: 1px solid var(--border); border-radius: 0.5rem; padding: 1rem; margin-top: 0.5rem; overflow-x: auto; font-size: 0.85rem;">@log.Details</pre>
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(log.UserAgent))
                                    {
                                        <div style="font-size: 0.85rem;">
                                            <strong>@Localizer["UserAgent"]:</strong> @log.UserAgent
                                        </div>
                                    }
                                </td>
                            </tr>
                            <script>
                                function toggleDetails@(log.Id)() {
                                    var detailsRow = document.getElementById('details@(log.Id)');
                                    if (detailsRow.style.display === 'none') {
                                        detailsRow.style.display = 'table-row';
                                    } else {
                                        detailsRow.style.display = 'none';
                                    }
                                }
                            </script>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card" style="margin-top: 1.5rem;">
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
                <div style="color: var(--text-muted);">
                    @Localizer["Page"] @Model.CurrentPage @Localizer["Of"] @Model.TotalPages
                </div>
                <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                    @if (Model.CurrentPage > 1)
                    {
                        <a href="?PageNumber=1&StartDate=@Model.StartDate?.ToString("yyyy-MM-dd")&EndDate=@Model.EndDate?.ToString("yyyy-MM-dd")&UserId=@Model.UserId&Action=@Model.Action&EntityType=@Model.EntityType&SearchTerm=@Model.SearchTerm" class="btn btn-ghost">
                            @Localizer["First"]
                        </a>
                        <a href="?PageNumber=@(Model.CurrentPage - 1)&StartDate=@Model.StartDate?.ToString("yyyy-MM-dd")&EndDate=@Model.EndDate?.ToString("yyyy-MM-dd")&UserId=@Model.UserId&Action=@Model.Action&EntityType=@Model.EntityType&SearchTerm=@Model.SearchTerm" class="btn btn-ghost">
                            @Localizer["Previous"]
                        </a>
                    }

                    @{
                        var startPage = Math.Max(1, Model.CurrentPage - 2);
                        var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                    }

                    @for (var i = startPage; i <= endPage; i++)
                    {
                        var pageNum = i;
                        @if (pageNum == Model.CurrentPage)
                        {
                            <span class="btn" style="background: var(--primary); color: var(--primary-text);">@pageNum</span>
                        }
                        else
                        {
                            <a href="?PageNumber=@pageNum&StartDate=@Model.StartDate?.ToString("yyyy-MM-dd")&EndDate=@Model.EndDate?.ToString("yyyy-MM-dd")&UserId=@Model.UserId&Action=@Model.Action&EntityType=@Model.EntityType&SearchTerm=@Model.SearchTerm" class="btn btn-ghost">@pageNum</a>
                        }
                    }

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a href="?PageNumber=@(Model.CurrentPage + 1)&StartDate=@Model.StartDate?.ToString("yyyy-MM-dd")&EndDate=@Model.EndDate?.ToString("yyyy-MM-dd")&UserId=@Model.UserId&Action=@Model.Action&EntityType=@Model.EntityType&SearchTerm=@Model.SearchTerm" class="btn btn-ghost">
                            @Localizer["Next"]
                        </a>
                        <a href="?PageNumber=@Model.TotalPages&StartDate=@Model.StartDate?.ToString("yyyy-MM-dd")&EndDate=@Model.EndDate?.ToString("yyyy-MM-dd")&UserId=@Model.UserId&Action=@Model.Action&EntityType=@Model.EntityType&SearchTerm=@Model.SearchTerm" class="btn btn-ghost">
                            @Localizer["Last"]
                        </a>
                    }
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="card" style="text-align: center; padding: 3rem;">
        <div style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.3;">📋</div>
        <h3 style="margin-bottom: 0.5rem;">@Localizer["NoAuditLogs"]</h3>
        <p style="color: var(--text-muted); margin-bottom: 1.5rem;">@Localizer["NoAuditLogsMessage"]</p>
        <a href="/Admin/AuditLog" class="btn">@Localizer["ClearFilters"]</a>
    </div>
}
