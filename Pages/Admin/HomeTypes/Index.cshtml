@page
@model ShiftManager.Pages.Admin.HomeTypes.IndexModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@inject IStringLocalizer<SharedResources> Localizer
@using ShiftManager.ViewComponents
@{
    ViewData["Title"] = Localizer["HomeTypes"];
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Organization"], Url = "/Admin/Organization" },
    new BreadcrumbItem { Label = Localizer["HomeTypes"], IsActive = true }
})

@section Styles {
    <link rel="stylesheet" href="~/css/home-types.css" asp-append-version="true" />
}

<div class="page-header">
    <h1><loc key="HomeTypes" /></h1>
    <p style="color: var(--text-muted);"><loc key="HomeTypes_Description" /></p>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert--success">@Model.SuccessMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert--danger">@Model.ErrorMessage</div>
}

@* Regenerate banners (Task 26) *@
@foreach (var b in Model.Banners.Where(b => b.NeedsRegen))
{
    <div class="alert alert--warning regen-banner" style="display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap;">
        <span style="flex: 1;">
            &#9888; <strong>@b.Name</strong> &mdash; @b.UserCount <loc key="Users" />.
            <loc key="HomeType_BannerNeedsRegen" />
            @if (b.LastGeneratedAt.HasValue)
            {
                <span style="color: var(--text-muted); font-size: 0.85em; margin-left: var(--space-2);">
                    @($"Last generated: {b.LastGeneratedAt.Value:yyyy-MM-dd HH:mm}")
                </span>
            }
            else
            {
                <span style="color: var(--text-muted); font-size: 0.85em; margin-left: var(--space-2);">
                    <loc key="HomeType_NeverGenerated" />
                </span>
            }
        </span>
        <button type="button" class="btn btn--sm btn--primary"
                onclick="showGenerateDialog(@b.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(b.Name))')">
            <loc key="Regenerate" />
        </button>
    </div>
}

<!-- Molecule selector -->
<form method="get" class="filter-bar">
    <label><loc key="Molecule" /></label>
    <select name="MoleculeId" class="form-input" onchange="this.form.submit()">
        @foreach (var m in Model.AvailableMolecules)
        {
            <option value="@m.Id" selected="@(Model.MoleculeId == m.Id)">@m.Name</option>
        }
    </select>
</form>

<!-- Home Types List -->
@if (Model.HomeTypes.Any())
{
    <table class="data-table">
        <thead>
            <tr>
                <th><loc key="Name" /></th>
                <th><loc key="Users" /></th>
                <th><loc key="Pattern" /></th>
                <th><loc key="Status" /></th>
                <th><loc key="Actions" /></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var ht in Model.HomeTypes)
        {
            var assignedUsers = Model.AssignedUsersPerHomeType.GetValueOrDefault(ht.Id, new());
            <tr>
                <td>
                    <strong>@ht.Name</strong>
                    @if (!string.IsNullOrEmpty(ht.NameHe))
                    {
                        <br/><span style="color: var(--text-muted); font-size: 0.85em;">@ht.NameHe</span>
                    }
                </td>
                <td>
                    <button type="button" class="btn btn--sm btn--outline"
                            onclick="toggleUserSection(@ht.Id)">
                        @ht.UserCount <loc key="Users" />
                    </button>
                </td>
                <td style="font-size: 0.85em; color: var(--text-muted);">@ht.CycleDescription</td>
                <td>
                    @if (ht.IsActive)
                    {
                        <span class="badge badge--success"><loc key="Active" /></span>
                    }
                    else
                    {
                        <span class="badge badge--muted"><loc key="Inactive" /></span>
                    }
                </td>
                <td>
                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                        <form method="post" asp-page-handler="ToggleActive" style="display: inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@ht.Id" />
                            <button type="submit" class="btn btn--sm btn--outline">
                                @(ht.IsActive ? Localizer["Deactivate"] : Localizer["Activate"])
                            </button>
                        </form>
                        <button type="button" class="btn btn--sm btn--primary"
                                onclick="showGenerateDialog(@ht.Id, '@ht.Name')">
                            <loc key="Generate" />
                        </button>
                        <form method="post" asp-page-handler="Delete" style="display: inline;"
                              data-confirm-modal
                              data-confirm-title="@Localizer["Confirm_DeleteHomeType_Title"]"
                              data-confirm-message="@Localizer["Confirm_DeleteHomeType"]"
                              data-confirm-action="@Localizer["Delete"]"
                              data-confirm-level="danger">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@ht.Id" />
                            <button type="submit" class="btn btn--sm btn--danger"><loc key="Delete" /></button>
                        </form>
                    </div>
                </td>
            </tr>
            <!-- User assignment expandable row -->
            <tr id="user-section-@ht.Id" style="display: none;">
                <td colspan="5">
                    <div class="card" style="margin: var(--space-2) 0; padding: var(--space-4);">
                        <h4 style="margin-bottom: var(--space-3);">@Localizer["AssignedUsers"] — @ht.Name</h4>

                        @if (assignedUsers.Any())
                        {
                            <ul style="list-style: none; padding: 0; margin: 0 0 var(--space-3) 0;">
                                @foreach (var user in assignedUsers)
                                {
                                    <li style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-2) 0; border-bottom: 1px solid var(--border); gap: var(--space-2);">
                                        <span>@user.DisplayName</span>
                                        <div style="display: flex; gap: var(--space-2);">
                                            <button type="button" class="btn btn--sm btn--outline"
                                                    onclick="openOverrideEditor(@user.UserId, @ht.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(user.DisplayName))')">
                                                <loc key="EditOverridePattern" />
                                            </button>
                                            <form method="post" asp-page-handler="UnassignUser" style="margin: 0;"
                                                  data-confirm-modal
                                                  data-confirm-title="@Localizer["Confirm_UnassignUser_Title"]"
                                                  data-confirm-message="@Localizer["Confirm_UnassignUser"]"
                                                  data-confirm-action="@Localizer["Remove"]"
                                                  data-confirm-level="danger">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="UnassignHomeTypeId" value="@ht.Id" />
                                                <input type="hidden" name="UnassignUserId" value="@user.UserId" />
                                                <button type="submit" class="btn btn--sm btn--danger">
                                                    <loc key="Remove" />
                                                </button>
                                            </form>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p style="color: var(--text-muted); margin-bottom: var(--space-3);"><loc key="NoUsersAssigned" /></p>
                        }

                        <!-- Add user form -->
                        <form method="post" asp-page-handler="AssignUsers" style="display: flex; gap: var(--space-2); align-items: center;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="AssignHomeTypeId" value="@ht.Id" />
                            <select name="AssignUserIds" class="form-input" style="flex: 1;" required>
                                <option value="">— @Localizer["SelectUser"] —</option>
                                @foreach (var user in Model.AvailableUsersInMolecule.Where(u => !assignedUsers.Any(a => a.UserId == u.UserId)))
                                {
                                    var label = user.DisplayName;
                                    if (user.CurrentHomeTypeId.HasValue && user.CurrentHomeTypeName != null)
                                    {
                                        label = $"{user.DisplayName} ({user.CurrentHomeTypeName})";
                                    }
                                    <option value="@user.UserId">@label</option>
                                }
                            </select>
                            <button type="submit" class="btn btn--sm btn--success"><loc key="Add" /></button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else if (Model.MoleculeId.HasValue)
{
    <div class="empty-state">
        <p><loc key="NoHomeTypes" /></p>
    </div>
}

<!-- Create Form (rule-first editor — Task 25) -->
@if (Model.MoleculeId.HasValue)
{
    <div class="card" style="margin-top: var(--space-6);">
        <h3><loc key="CreateHomeType" /></h3>
        <form method="post" asp-page-handler="Create">
            @Html.AntiForgeryToken()
            <input type="hidden" name="CreateMoleculeId" value="@Model.MoleculeId" />

            <div class="form-group">
                <label><loc key="Name" /></label>
                <input type="text" name="Name" class="form-input" required placeholder="@Localizer["HomeType_NamePlaceholder"]" />
            </div>
            <div class="form-group">
                <label><loc key="HebrewName" /></label>
                <input type="text" name="NameHe" class="form-input" placeholder="@Localizer["HomeType_HeNamePlaceholder"]" />
            </div>

            <div class="rule-editor">
                <div class="form-group">
                    <label asp-for="RuleCycleWeeks"><loc key="HomeType_CycleWeeks" /></label>
                    <input asp-for="RuleCycleWeeks" type="number" min="1" max="12" class="form-input" />
                </div>

                <div class="form-group">
                    <label><loc key="HomeType_HomeDays" /></label>
                    <div class="day-checkboxes" style="display: flex; flex-wrap: wrap; gap: var(--space-3);">
                        @foreach (var d in Enum.GetValues<DayOfWeek>())
                        {
                            <label class="checkbox-inline" style="display: inline-flex; align-items: center; gap: var(--space-1);">
                                <input type="checkbox" name="RuleHomeDays" value="@((int)d)"
                                       @(Model.RuleHomeDays.Contains(d) ? "checked=\"checked\"" : "") />
                                @Localizer[d.ToString()]
                            </label>
                        }
                    </div>
                </div>

                <div class="form-group">
                    <label><loc key="HomeType_WeekOffsets" /></label>
                    <div class="week-offset-checkboxes" id="week-offset-checkboxes" style="display: flex; flex-wrap: wrap; gap: var(--space-3);">
                        @for (int i = 0; i < Math.Max(1, Math.Min(12, Model.RuleCycleWeeks)); i++)
                        {
                            <label class="checkbox-inline" style="display: inline-flex; align-items: center; gap: var(--space-1);">
                                <input type="checkbox" name="RuleWeekOffsets" value="@i"
                                       @(Model.RuleWeekOffsets.Contains(i) ? "checked=\"checked\"" : "") />
                                Week @(i + 1)
                            </label>
                        }
                    </div>
                    <small style="color: var(--text-muted);"><loc key="HomeType_WeekOffsets_Help" /></small>
                </div>

                <div class="form-group">
                    <label asp-for="RuleAnchor"><loc key="HomeType_Anchor" /></label>
                    <input asp-for="RuleAnchor" type="date" class="form-input" />
                    <small style="color: var(--text-muted);"><loc key="HomeType_Anchor_Help" /></small>
                </div>
            </div>

            <div class="rule-preview" style="margin-top: var(--space-4);">
                <h4><loc key="HomeType_Preview_Title" /></h4>
                <div id="rule-preview-calendar" class="rule-preview-calendar"></div>
            </div>

            <button type="submit" class="btn btn--primary" style="margin-top: var(--space-4);"><loc key="Create" /></button>
        </form>
    </div>
}

<!-- Generate Dialog (hidden, shown via JS) -->
<div id="generate-dialog" style="display: none; margin-top: var(--space-4);" class="card">
    <h3><loc key="GenerateHomeShifts" /></h3>
    <form method="post" asp-page-handler="Generate">
        @Html.AntiForgeryToken()
        <input type="hidden" name="GenerateHomeTypeId" id="generate-ht-id" />

        <div class="form-group">
            <label><loc key="StartDate" /></label>
            <input type="date" name="GenerateStartDate" class="form-input"
                   value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" />
        </div>
        <div class="form-group">
            <label><loc key="EndDate" /></label>
            <input type="date" name="GenerateEndDate" class="form-input"
                   value="@DateOnly.FromDateTime(DateTime.Today.AddYears(1)).ToString("yyyy-MM-dd")" />
        </div>
        <div class="form-group">
            <label><loc key="Mode" /></label>
            <select name="GenerateMode" class="form-input">
                <option value="keep">@Localizer["HomeType_ModeKeep"]</option>
                <option value="overwrite">@Localizer["HomeType_ModeOverwrite"]</option>
            </select>
        </div>
        <button type="submit" class="btn btn--primary"><loc key="Generate" /></button>
        <button type="button" class="btn btn--outline" onclick="hideGenerateDialog()"><loc key="Cancel" /></button>
    </form>
</div>

<!-- Per-user override editor (Task 27) -->
<div id="override-editor" class="modal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.4); align-items: center; justify-content: center; z-index: 1000;">
    <div class="modal-content card" style="max-width: 520px; width: 90%; padding: var(--space-4);">
        <h5><loc key="OverrideForUser" /> <span id="override-user-name"></span></h5>
        <p style="color: var(--text-muted);"><loc key="OverrideHelp" /></p>
        <textarea id="override-dates" rows="6" class="form-input" placeholder="2026-05-17, 2026-05-24, ..."></textarea>
        <div class="modal-actions" style="display: flex; gap: var(--space-2); justify-content: flex-end; margin-top: var(--space-3);">
            <button type="button" class="btn btn--outline" onclick="closeOverrideEditor()"><loc key="Cancel" /></button>
            <button type="button" class="btn btn--primary" onclick="saveOverride()"><loc key="Save" /></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/home-type-calendar.js" asp-append-version="true"></script>
    <script>
        function showGenerateDialog(htId, htName) {
            document.getElementById('generate-ht-id').value = htId;
            var dialog = document.getElementById('generate-dialog');
            dialog.style.display = 'block';
            dialog.scrollIntoView({ behavior: 'smooth' });
        }
        function hideGenerateDialog() {
            document.getElementById('generate-dialog').style.display = 'none';
        }
        function toggleUserSection(htId) {
            var section = document.getElementById('user-section-' + htId);
            if (section) {
                section.style.display = section.style.display === 'none' ? '' : 'none';
            }
        }

        // Per-user override editor (Task 27)
        async function openOverrideEditor(userId, homeTypeId, displayName) {
            var nameSpan = document.getElementById('override-user-name');
            if (nameSpan) nameSpan.textContent = displayName || '';
            try {
                var r = await fetch('/Admin/HomeTypes?handler=GetOverride&userId=' + encodeURIComponent(userId) + '&homeTypeId=' + encodeURIComponent(homeTypeId), {
                    credentials: 'same-origin'
                });
                if (r.ok) {
                    var data = await r.json();
                    document.getElementById('override-dates').value = (data.dates || []).join(', ');
                } else {
                    document.getElementById('override-dates').value = '';
                }
            } catch (e) {
                document.getElementById('override-dates').value = '';
            }
            var editor = document.getElementById('override-editor');
            editor.dataset.userId = userId;
            editor.dataset.homeTypeId = homeTypeId;
            editor.style.display = 'flex';
        }

        function closeOverrideEditor() {
            document.getElementById('override-editor').style.display = 'none';
        }

        async function saveOverride() {
            var editor = document.getElementById('override-editor');
            var datesRaw = document.getElementById('override-dates').value || '';
            var dates = datesRaw.split(',').map(function (s) { return s.trim(); }).filter(Boolean);
            var token = document.querySelector('input[name=__RequestVerificationToken]')?.value;
            try {
                var r = await fetch('/Admin/HomeTypes?handler=SaveOverride', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token || ''
                    },
                    credentials: 'same-origin',
                    body: JSON.stringify({
                        userId: parseInt(editor.dataset.userId, 10),
                        homeTypeId: parseInt(editor.dataset.homeTypeId, 10),
                        dates: dates
                    })
                });
                if (!r.ok) {
                    alert('Failed to save override (HTTP ' + r.status + ')');
                    return;
                }
                location.reload();
            } catch (e) {
                alert('Failed to save override: ' + e.message);
            }
        }
    </script>
}
