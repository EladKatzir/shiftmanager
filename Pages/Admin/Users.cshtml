@page
@model ShiftManager.Pages.Admin.UsersModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.Models.Support
@using ShiftManager.Helpers
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@inject ShiftManager.Services.ILocalizationService Localization
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["UserManagement"];
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Admin"], IsActive = true }
})

@section Styles {
    <style>
        /* Page Header */
        .page-header {
            margin-bottom: 2rem;
        }

        .page-title {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text);
            margin: 0 0 0.5rem 0;
            line-height: 1.2;
        }

        .page-subtitle {
            font-size: 1rem;
            color: var(--text-muted);
            margin: 0;
            line-height: 1.5;
        }

        /* Alert Messages */
        .alert {
            padding: 1rem 1.25rem;
            border-radius: 10px;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 0.9375rem;
            font-weight: 500;
        }

        .alert-success {
            background: var(--success);
            color: var(--success-text);
            border: 1px solid rgba(76, 175, 80, 0.3);
        }

        .alert-error {
            background: var(--danger);
            color: var(--danger-text);
            border: 1px solid rgba(244, 67, 54, 0.3);
        }

        /* Section Card */
        .section-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1.75rem;
            margin-bottom: 2rem;
            box-shadow: var(--shadow-sm);
        }

        .section-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--text);
            margin: 0 0 1.5rem 0;
        }

        /* Filters */
        .filters-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 0.75rem;
            margin-bottom: 1.5rem;
            align-items: end;
        }

        .filter-group label {
            display: block;
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--text);
            margin-bottom: 0.375rem;
        }

        .filter-input, .filter-select {
            width: 100%;
            padding: 0.625rem 0.875rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: var(--bg);
            color: var(--text);
            font-size: 0.875rem;
            transition: all 0.15s ease;
        }

        .filter-select:focus, .filter-input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--primary-bg);
        }

        /* Batch Selection Bar */
        .batch-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.875rem 1.25rem;
            background: var(--primary-bg);
            border: 1px solid var(--primary);
            border-radius: 8px;
            margin-bottom: 1rem;
        }

        .batch-bar-left {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .batch-checkbox-label {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin: 0;
            font-weight: 600;
            cursor: pointer;
        }

        .batch-count {
            color: var(--text-muted);
            font-size: 0.875rem;
        }

        /* Table Styles */
        .data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.875rem;
        }

        .data-table thead {
            background: var(--surface-soft);
        }

        .data-table th {
            padding: 0.875rem;
            text-align: start;
            font-weight: 600;
            color: var(--text);
            border-bottom: 2px solid var(--border);
        }

        .data-table td {
            padding: 0.875rem;
            border-bottom: 1px solid var(--border);
        }

        .data-table tbody tr:hover {
            background: var(--surface-soft);
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.375rem;
            padding: 0.5rem 1rem;
            border: 1px solid var(--border);
            border-radius: 6px;
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.15s ease;
            text-decoration: none;
            white-space: nowrap;
            background: var(--surface-soft);
            color: var(--text);
        }

        .btn:hover {
            background: var(--surface-elevated);
            transform: translateY(-1px);
            box-shadow: var(--shadow-sm);
        }

        .btn-primary {
            background: var(--primary);
            color: var(--primary-contrast);
            border-color: var(--primary);
        }

        .btn-primary:hover {
            background: var(--primary-hover);
            border-color: var(--primary-hover);
            box-shadow: var(--shadow-md);
        }

        .btn-success {
            background: var(--success);
            color: var(--success-text);
            border-color: var(--success);
        }

        .btn-success:hover {
            background: var(--success-hover);
        }

        .btn-danger {
            background: var(--danger);
            color: var(--danger-text);
            border-color: var(--danger);
        }

        .btn-danger:hover {
            background: var(--danger-hover);
        }

        .btn:focus {
            outline: 2px solid var(--primary);
            outline-offset: 2px;
        }

        .btn:focus:not(:focus-visible) {
            outline: none;
        }

        .btn:focus-visible {
            outline: 2px solid var(--primary);
            outline-offset: 2px;
        }

        .btn-sm {
            padding: 0.3rem 0.6rem;
            font-size: 0.8125rem;
        }

        .btn-group {
            display: flex;
            gap: 0.5rem;
        }

        /* Editable Cell */
        .editable-cell {
            position: relative;
        }

        .cell-display {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        /* Participates-in-Shifts cell */
        .does-shifts-cell { min-width: 130px; }
        .does-shifts-toggle {
            display: inline-flex; align-items: center; gap: 0.4rem; cursor: pointer; user-select: none;
        }
        .does-shifts-toggle input[type="checkbox"] { width: 16px; height: 16px; cursor: pointer; }
        .does-shifts-toggle__text { font-size: 0.85rem; color: var(--text-muted); }
        .does-shifts-cell__categories {
            display: flex; align-items: center; gap: 0.4rem; margin-top: 0.35rem; flex-wrap: wrap;
        }
        .does-shifts-cell__categories .js-cat-names {
            font-size: 0.8rem; color: var(--text-muted); max-width: 150px; overflow: hidden;
            text-overflow: ellipsis; white-space: nowrap;
        }
        .btn-xs {
            padding: 0.15rem 0.4rem; font-size: 0.75rem; line-height: 1.2;
        }

        .cell-display__value {
            font-weight: 500;
        }

        .cell-display__edit-btn {
            width: 24px;
            height: 24px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            border: 1px solid transparent;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.75rem;
            opacity: 0.5;
            transition: all 0.15s ease;
        }

        .editable-cell:hover .cell-display__edit-btn,
        .cell-display__edit-btn:focus {
            opacity: 1;
            background: var(--surface-soft);
            border-color: var(--border);
        }

        .cell-edit {
            display: none;
            align-items: center;
            gap: 0.375rem;
        }

        .cell-edit.is-active {
            display: flex;
        }

        .cell-display.is-hidden {
            display: none;
        }

        .cell-edit__select {
            min-width: 100px;
            padding: 0.375rem 0.5rem;
            font-size: 0.8125rem;
        }

        .cell-edit__btn {
            width: 26px;
            height: 26px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 4px;
            font-size: 0.875rem;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .cell-edit__btn--save {
            background: var(--success);
            color: var(--success-text);
            border: 1px solid var(--success);
        }

        .cell-edit__btn--save:hover {
            background: var(--success-hover);
        }

        .cell-edit__btn--cancel {
            background: var(--surface-soft);
            color: var(--text-muted);
            border: 1px solid var(--border);
        }

        .cell-edit__btn--cancel:hover {
            background: var(--surface-elevated);
        }

        /* Form Elements */
        .form-input {
            padding: 0.625rem 0.875rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: var(--bg);
            color: var(--text);
            font-size: 0.875rem;
            min-width: 0;
        }

        .form-input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--primary-bg);
        }

        /* Warning Box */
        .warning-box {
            margin-top: 1.5rem;
            padding: 1.25rem;
            background: var(--surface-soft);
            border-left: 4px solid var(--danger);
            border-radius: 8px;
        }

        .warning-title {
            color: var(--danger);
            font-weight: 600;
            font-size: 0.875rem;
            margin-bottom: 0.5rem;
        }

        .warning-text {
            color: var(--text-muted);
            font-size: 0.8125rem;
            line-height: 1.6;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 3rem 2rem;
            color: var(--text-muted);
        }

        /* Status Badge */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            padding: 0.25rem 0.625rem;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .status-approved {
            background: var(--success);
            color: var(--success-text);
        }

        .status-rejected {
            background: var(--danger);
            color: var(--danger-text);
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .page-title {
                font-size: 1.75rem;
            }

            .filters-grid {
                grid-template-columns: 1fr;
            }

            .data-table {
                font-size: 0.8125rem;
            }

            .data-table th,
            .data-table td {
                padding: 0.625rem 0.5rem;
            }

            .btn-group {
                flex-direction: column;
            }

            .batch-bar {
                flex-direction: column;
                gap: 0.75rem;
                align-items: stretch;
            }
        }
    </style>
}

<!-- Page Header -->
<div class="page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div>
        <h1 class="page-title">@Localizer["UserManagement"]</h1>
        <p class="page-subtitle">@Localizer["ManageUsersJoinRequestsAndPermissions"]</p>
    </div>
    <div>
        <a asp-page-handler="ExportCsv"
           asp-route-UserFilterCompanyId="@Model.UserFilterCompanyId"
           asp-route-UserFilterRole="@Model.UserFilterRole"
           asp-route-UserFilterMoleculeId="@Model.UserFilterMoleculeId"
           asp-route-UserFilterJobTypeId="@Model.UserFilterJobTypeId"
           class="btn btn-primary">
            <icon name="pie-chart" /> @Localizer["ExportCSV"]
        </a>
    </div>
</div>

<!-- Join Requests Section -->
<div class="section-card">
    <h2 class="section-title">@Localizer["JoinRequests"]</h2>

    <!-- Filters -->
    <form method="get">
        <div class="filters-grid">
            <div class="filter-group">
                <label for="filterStatus">@Localizer["Status"]</label>
                <select class="filter-select" name="FilterStatus" id="filterStatus" onchange="this.form.submit()">
                    <option value="0" selected="@(Model.FilterStatus == JoinRequestStatus.Pending)">@Localizer["Pending"]</option>
                    <option value="1" selected="@(Model.FilterStatus == JoinRequestStatus.Approved)">@Localizer["Approved"]</option>
                    <option value="2" selected="@(Model.FilterStatus == JoinRequestStatus.Rejected)">@Localizer["Rejected"]</option>
                </select>
            </div>

            <div class="filter-group">
                <label for="filterCompanyId">@Localizer["Company"]</label>
                <select class="filter-select" name="FilterCompanyId" id="filterCompanyId" onchange="this.form.submit()">
                    <option value="">@Localizer["AllCompanies"]</option>
                    @foreach (var company in Model.AvailableCompanies)
                    {
                        <option value="@company.Id" selected="@(Model.FilterCompanyId == company.Id)">@company.LocalizedName</option>
                    }
                </select>
            </div>

            <div class="filter-group">
                <label for="filterRole">@Localizer["Role"]</label>
                <select class="filter-select" name="FilterRole" id="filterRole" onchange="this.form.submit()">
                    <option value="">@Localizer["AllRoles"]</option>
                    @foreach (var role in Enum.GetValues<UserRole>())
                    {
                        <option value="@((int)role)" selected="@(Model.FilterRole == role)">@Localizer[role.ToString()]</option>
                    }
                </select>
            </div>

            @if (Model.FilterCompanyId.HasValue || Model.FilterRole.HasValue || Model.FilterStatus != JoinRequestStatus.Pending)
            {
                <div class="filter-group" style="display: flex; align-items: end;">
                    <a href="/Admin/Users" class="btn">@Localizer["ClearFilters"]</a>
                </div>
            }
        </div>
    </form>

    @if (Model.JoinRequests.Any())
    {
        @if (Model.FilterStatus == JoinRequestStatus.Pending)
        {
            <!-- Batch Approval Bar -->
            <div class="batch-bar" role="toolbar" aria-label="@Localizer["BatchActions"]">
                <div class="batch-bar-left">
                    <label class="batch-checkbox-label" for="selectAllRequests">
                        <input type="checkbox" id="selectAllRequests" onclick="toggleAllRequests(this)" aria-describedby="selectedCount" />
                        <strong>@Localizer["SelectAll"]</strong>
                    </label>
                    <span id="selectedCount" class="batch-count" aria-live="polite"></span>
                </div>
                <form method="post" asp-page-handler="BatchApproveJoinRequests" id="batchApprovalForm" style="margin: 0;"
                      data-confirm-modal
                      data-confirm-title="@Localizer["ConfirmBatchApproval_Title"]"
                      data-confirm-message="@Localizer["ConfirmBatchApproval"]"
                      data-confirm-action="@Localizer["Approve"]"
                      data-confirm-level="danger">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary" id="batchApproveBtn" disabled>
                        <icon name="check" /> @Localizer["ApproveSelected"]
                    </button>
                </form>
            </div>

            <form method="post" asp-page-handler="BatchApproveJoinRequests" id="batchDataForm">
                @Html.AntiForgeryToken()
                <table class="data-table">
                    <thead>
                        <tr>
                            <th style="width:1%"></th>
                            <th>@Localizer["Submitted"]</th>
                            <th>@Localizer["Name"]</th>
                            <th>@Localizer["Email"]</th>
                            <th>@Localizer["Company"]</th>
                            <th>@Localizer["RequestedRole"]</th>
                            <th>@Localizer["JobType"]</th>
                            <th>@Localizer["AssignRole"]</th>
                            <th style="width:1%">@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var request in Model.JoinRequests)
                    {
                        <tr class="request-row">
                            <td>
                                <input type="checkbox" name="SelectedRequests" value="@request.Id"
                                       class="request-checkbox" onchange="updateSelectedCount()" />
                            </td>
                            <td>@request.CreatedAt.ToLocalTime().ToString("MM/dd/yy HH:mm")</td>
                            <td>@request.DisplayName</td>
                            <td>
                                @request.Email
                                @if (request.AuthMethod == "Griffin")
                                {
                                    <span class="badge badge--info" style="font-size: var(--text-tiny); margin-inline-start: var(--space-1);" title="ADFS SSO">ADFS</span>
                                }
                            </td>
                            <td>@request.CompanyName</td>
                            @{
                                var reqTemplate = request.RequestedRoleTemplateId.HasValue
                                    ? Model.AssignableRoleTemplates.FirstOrDefault(rt => rt.Id == request.RequestedRoleTemplateId.Value)
                                    : null;
                            }
                            <td style="color: var(--text-muted);">@(reqTemplate != null
                                ? RoleDisplayHelper.GetRoleDisplayName(Localizer, reqTemplate, request.JobTypeKey)
                                : RoleDisplayHelper.GetRoleDisplayName(Localizer, request.RequestedRole, request.JobTypeKey))</td>
                            <td>@(request.JobTypeName ?? "-")</td>
                            <td>
                                <select name="RequestTemplateIds[@request.Id]" class="form-input" style="min-width: 120px;">
                                    @foreach (var rt in Model.AssignableRoleTemplates)
                                    {
                                        var isSelected = request.RequestedRoleTemplateId.HasValue
                                            ? rt.Id == request.RequestedRoleTemplateId.Value
                                            : rt.DerivedUserRole.HasValue && rt.DerivedUserRole.Value.ToString() == request.RequestedRole;
                                        <option value="@rt.Id" data-derived-role="@rt.DerivedUserRole" selected="@isSelected">
                                            @RoleDisplayHelper.GetRoleDisplayName(Localizer, rt)
                                        </option>
                                    }
                                </select>
                            </td>
                            <td>
                                <div class="btn-group" role="group" aria-label="@Localizer["Actions"]">
                                    <button class="btn btn-success btn-sm" type="button"
                                            onclick="approveSingleRequest(@request.Id)"
                                            aria-label="@Localizer["Approve"] @request.DisplayName">
                                        <icon name="check" />
                                    </button>
                                    <button class="btn btn-danger btn-sm" type="button"
                                            data-display-name="@request.DisplayName"
                                            onclick="rejectSingleRequest(@request.Id, this.dataset.displayName)"
                                            aria-label="@Localizer["Reject"] @request.DisplayName">
                                        <icon name="x" />
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </form>
        }
        else
        {
            <!-- Non-Pending Requests -->
            <table class="data-table">
                <thead>
                    <tr>
                        <th>@Localizer["Submitted"]</th>
                        <th>@Localizer["Name"]</th>
                        <th>@Localizer["Email"]</th>
                        <th>@Localizer["Company"]</th>
                        <th>@Localizer["RequestedRole"]</th>
                        <th>@Localizer["JobType"]</th>
                        <th>@Localizer["Status"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var request in Model.JoinRequests)
                {
                    <tr>
                        <td>@request.CreatedAt.ToLocalTime().ToString("MM/dd/yy HH:mm")</td>
                        <td>@request.DisplayName</td>
                        <td>
                            @request.Email
                            @if (request.AuthMethod == "Griffin")
                            {
                                <span class="badge badge--info" style="font-size: var(--text-tiny); margin-inline-start: var(--space-1);" title="ADFS SSO">ADFS</span>
                            }
                        </td>
                        <td>@request.CompanyName</td>
                        @{
                            var histTemplate = request.RequestedRoleTemplateId.HasValue
                                ? Model.AssignableRoleTemplates.FirstOrDefault(rt => rt.Id == request.RequestedRoleTemplateId.Value)
                                : null;
                        }
                        <td>@(histTemplate != null
                            ? RoleDisplayHelper.GetRoleDisplayName(Localizer, histTemplate, request.JobTypeKey)
                            : RoleDisplayHelper.GetRoleDisplayName(Localizer, request.RequestedRole, request.JobTypeKey))</td>
                        <td>@(request.JobTypeName ?? "-")</td>
                        <td>
                            @if (request.Status == JoinRequestStatus.Approved)
                            {
                                <span class="status-badge status-approved"><icon name="check" /> @Localizer["Approved"]</span>
                            }
                            else
                            {
                                <span class="status-badge status-rejected"><icon name="x" /> @Localizer["Rejected"]</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }

        @* Pagination controls for join requests *@
        @if (Model.TotalJoinRequestsPages > 1)
        {
            <div style="display: flex; justify-content: center; align-items: center; gap: 1rem; margin-top: 1.5rem; padding: 1rem;">
                @if (Model.JoinRequestsPage > 1)
                {
                    <a href="?JoinRequestsPage=@(Model.JoinRequestsPage - 1)&FilterStatus=@((int)Model.FilterStatus)@(Model.FilterCompanyId.HasValue ? $"&FilterCompanyId={Model.FilterCompanyId}" : "")@(Model.FilterRole.HasValue ? $"&FilterRole={Model.FilterRole}" : "")"
                       class="btn btn-secondary">← @Localizer["Pagination_Previous"]</a>
                }
                else
                {
                    <button class="btn btn-secondary" disabled>← @Localizer["Pagination_Previous"]</button>
                }

                <span style="font-weight: 600; color: var(--text);">
                    @Localizer["Pagination_PageXofY", Model.JoinRequestsPage, Model.TotalJoinRequestsPages] (@Model.TotalJoinRequests)
                </span>

                @if (Model.JoinRequestsPage < Model.TotalJoinRequestsPages)
                {
                    <a href="?JoinRequestsPage=@(Model.JoinRequestsPage + 1)&FilterStatus=@((int)Model.FilterStatus)@(Model.FilterCompanyId.HasValue ? $"&FilterCompanyId={Model.FilterCompanyId}" : "")@(Model.FilterRole.HasValue ? $"&FilterRole={Model.FilterRole}" : "")"
                       class="btn btn-secondary">@Localizer["Pagination_Next"] →</a>
                }
                else
                {
                    <button class="btn btn-secondary" disabled>@Localizer["Pagination_Next"] →</button>
                }
            </div>
        }
    }
    else
    {
        <p class="empty-state">@Localizer["NoJoinRequestsFound"]</p>
    }
</div>

<!-- Existing Users Section -->
<div class="section-card">
    <h2 class="section-title">@Localizer["ExistingUsers"]</h2>

    <!-- Add User Form (moved above table for quick access) -->
    <div style="margin-bottom: var(--space-4); padding: var(--space-3); background: var(--surface-soft); border-radius: var(--radius-md);">
        <h3 class="section-title" style="margin-bottom: var(--space-2);">@Localizer["AddUser"]</h3>
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="alert alert-error" style="margin-bottom: 1rem;">
                <span><icon name="x" /></span>
                <span>@Model.Error</span>
            </div>
        }
        <form method="post" asp-page-handler="Add">
            <div class="filters-grid">
                <div class="filter-group">
                    <label>@Localizer["Email"]</label>
                    <input class="form-input" asp-for="NewEmail" type="email" autocomplete="email" required />
                </div>
                <div class="filter-group">
                    <label>@Localizer["DisplayName"]</label>
                    <input class="form-input" asp-for="NewDisplayName" autocomplete="name" required />
                </div>
                <div class="filter-group">
                    <label>@Localizer["Role"]</label>
                    <select class="form-input" asp-for="NewRoleTemplateId">
                        @foreach (var rt in Model.AssignableRoleTemplates)
                        {
                            <option value="@rt.Id" data-derived-role="@rt.DerivedUserRole">@RoleDisplayHelper.GetRoleDisplayName(Localizer, rt)</option>
                        }
                    </select>
                </div>
                @if (Model.Companies.Count > 0)
                {
                    <div class="filter-group" id="addUserCompanyField">
                        <label>@Localizer["Company"]</label>
                        <select asp-for="NewUserCompanyId" class="form-input" required>
                            @if (Model.Companies.Count > 1)
                            {
                                <option value="">-- @Localizer["SelectCompany"] --</option>
                            }
                            @foreach (var company in Model.Companies)
                            {
                                <option value="@company.Id">@company.LocalizedName</option>
                            }
                        </select>
                    </div>
                }
                @if (Model.IsOwner)
                {
                    <div class="filter-group" id="addUserMoleculeField" style="display:none;">
                        <label>@Localizer["Molecule"]</label>
                        <select asp-for="NewMoleculeId" class="form-input">
                            <option value="">-- @Localizer["SelectMolecule"] --</option>
                            @foreach (var mol in Model.AvailableMolecules)
                            {
                                <option value="@mol.Id">@mol.Name</option>
                            }
                        </select>
                    </div>
                }
                <div class="filter-group">
                    <label>@Localizer["JobType"]</label>
                    <select asp-for="NewJobTypeId" class="form-input" id="addUserJobType">
                        <option value="">-- @Localizer["SelectJobType"] --</option>
                        @foreach (var jobType in Model.AvailableJobTypes)
                        {
                            <option value="@jobType.Id" data-key="@jobType.Key">@jobType.AreaName - @jobType.Name</option>
                        }
                    </select>
                </div>
                <div class="filter-group">
                    <label>@Localizer["Password"]</label>
                    <input class="form-input" asp-for="NewPassword" type="password" autocomplete="new-password" minlength="6" required />
                </div>
                <div class="filter-group" style="display: flex; align-items: end;">
                    <button class="btn btn-primary" type="submit" style="width: 100%;">
                        <span>+</span>
                        <span>@Localizer["Add"]</span>
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Filters -->
    <form method="get">
        <input type="hidden" name="FilterStatus" value="@((int)Model.FilterStatus)" />
        @if (Model.FilterCompanyId.HasValue)
        {
            <input type="hidden" name="FilterCompanyId" value="@Model.FilterCompanyId" />
        }
        @if (Model.FilterRole.HasValue)
        {
            <input type="hidden" name="FilterRole" value="@((int)Model.FilterRole.Value)" />
        }

        <div class="filters-grid">
            <div class="filter-group">
                <label>@Localizer["Company"]</label>
                <select class="filter-select" name="UserFilterCompanyId" onchange="this.form.submit()">
                    <option value="">@Localizer["AllCompanies"]</option>
                    @foreach (var company in Model.AvailableCompanies)
                    {
                        <option value="@company.Id" selected="@(Model.UserFilterCompanyId == company.Id)">@company.LocalizedName</option>
                    }
                </select>
            </div>

            <div class="filter-group">
                <label>@Localizer["Role"]</label>
                <select class="filter-select" name="UserFilterRole" onchange="this.form.submit()">
                    <option value="">@Localizer["AllRoles"]</option>
                    @foreach (var role in Enum.GetValues<UserRole>())
                    {
                        <option value="@((int)role)" selected="@(Model.UserFilterRole == role)">@Localizer[role.ToString()]</option>
                    }
                </select>
            </div>

            <div class="filter-group">
                <label>@Localizer["Molecule"]</label>
                <select class="filter-select" name="UserFilterMoleculeId" onchange="this.form.submit()">
                    <option value="">@Localizer["AllMolecules"]</option>
                    @foreach (var molecule in Model.AvailableMolecules)
                    {
                        <option value="@molecule.Id" selected="@(Model.UserFilterMoleculeId == molecule.Id)">@molecule.AreaName - @molecule.Name</option>
                    }
                </select>
            </div>

            <div class="filter-group">
                <label>@Localizer["JobType"]</label>
                <select class="filter-select" name="UserFilterJobTypeId" onchange="this.form.submit()">
                    <option value="">@Localizer["AllJobTypes"]</option>
                    @foreach (var jobType in Model.AvailableJobTypes)
                    {
                        <option value="@jobType.Id" selected="@(Model.UserFilterJobTypeId == jobType.Id)">@jobType.AreaName - @jobType.Name</option>
                    }
                </select>
            </div>

            @if (Model.UserFilterCompanyId.HasValue || Model.UserFilterRole.HasValue || Model.UserFilterMoleculeId.HasValue || Model.UserFilterJobTypeId.HasValue)
            {
                <div class="filter-group" style="display: flex; align-items: end;">
                    <a href="/Admin/Users" class="btn">@Localizer["ClearUserFilters"]</a>
                </div>
            }
        </div>
    </form>

    <div style="margin-bottom: var(--space-3);">
        <label class="sr-only" for="userSearch">@Localizer["SearchUser"]</label>
        <input type="text" id="userSearch" class="form-input"
               placeholder="@Localizer["SearchUserPlaceholder"]"
               oninput="filterUserTable(this.value)"
               style="max-width: 300px;" />
    </div>

    <div style="overflow-x: clip; overflow-y: visible;">
    <table id="usersTable" class="data-table data-table--sticky-header data-table--sticky-col" style="min-width: 900px;">
        <thead>
            <tr>
                <th>@Localizer["Name"]</th>
                <th>@Localizer["Email"]</th>
                <th>@Localizer["Company"]</th>
                <th>@Localizer["JobType"]</th>
                <th>@Localizer["Department"]</th>
                <th><loc key="Users_Participates" /></th>
                <th>@Localizer["Role"]</th>
                <th>@Localizer["Grants"]</th>
                <th>@Localizer["Status"]</th>
                <th style="white-space: nowrap;">@Localizer["Password"]</th>
                <th style="white-space: nowrap;">@Localizer["Actions"]</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var u in Model.Users)
        {
            <tr>
                <td>
                    @u.DisplayName
                    @if (u.IsLocked)
                    {
                        var lockoutTime = u.LockoutEnd.HasValue ? Localization.FormatTime(u.LockoutEnd.Value.ToLocalTime()) : "";
                        <span style="color: var(--danger); margin-inline-start: 0.5rem;" title="@Localizer["LockedUntil", lockoutTime]"><icon name="lock" /></span>
                    }
                </td>
                <td>@u.Email</td>
                @{
                    var hasDirTooltip = Model.DirectorCompanyNames.TryGetValue(u.Id, out var dirCompanyNames);
                    var hasMemberships = u.Memberships != null && u.Memberships.Count > 1;
                }
                <td title="@(hasDirTooltip ? string.Join(", ", dirCompanyNames!) : "")">
                    @if (hasMemberships)
                    {
                        @* Multi-company: primary in bold + chip per extra membership + expander toggle *@
                        <strong>@u.CompanyName</strong>
                        @foreach (var m in u.Memberships!.Where(m => !m.IsPrimary))
                        {
                            <span class="badge badge-secondary" style="margin-inline-start:0.35rem; font-size:0.75rem;">@m.CompanyName</span>
                        }
                        <button type="button"
                                class="btn btn-xs js-memberships-toggle"
                                style="margin-inline-start:0.35rem; padding:0.1rem 0.3rem;"
                                data-user-id="@u.Id"
                                aria-expanded="false"
                                title="@Localizer["Users_Companies"]">
                            ▾
                        </button>
                    }
                    else
                    {
                        @* Single-company: unchanged *@
                        @u.CompanyName
                    }
                </td>
                <td class="editable-cell" data-cell-type="jobtype" data-user-id="@u.Id">
                    <div class="cell-display">
                        <span class="cell-display__value">@(u.JobTypeName ?? "-")</span>
                        <button type="button" class="cell-display__edit-btn" onclick="enterEditMode(this)" title="@Localizer["EditJobType"]" aria-label="@Localizer["EditJobType"]">
                            <icon name="settings" />
                        </button>
                    </div>
                    <div class="cell-edit">
                        <form method="post" asp-page-handler="JobType" style="display:inline; margin: 0;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@u.Id" />
                            <select class="form-input cell-edit__select" name="jobTypeId" data-original-value="@(u.JobTypeId?.ToString() ?? "")" loc-aria-label="Admin_EditJobType">
                                <option value="" selected="@(!u.JobTypeId.HasValue)">-</option>
                                @foreach (var jt in Model.AvailableJobTypes)
                                {
                                    <option value="@jt.Id" selected="@(u.JobTypeId == jt.Id)">@jt.Name</option>
                                }
                            </select>
                            <button type="submit" class="cell-edit__btn cell-edit__btn--save" title="@Localizer["Save"]" aria-label="@Localizer["Save"]"><icon name="check" /></button>
                            <button type="button" class="cell-edit__btn cell-edit__btn--cancel" onclick="exitEditMode(this)" title="@Localizer["Cancel"]" aria-label="@Localizer["Cancel"]"><icon name="x" /></button>
                        </form>
                    </div>
                </td>
                <td>@(u.DepartmentName ?? "-")</td>
                <td class="does-shifts-cell" data-user-id="@u.Id" data-user-molecule-id="@(u.MoleculeId?.ToString() ?? "")">
                    <label class="does-shifts-toggle" title="@Localizer["Users_ParticipatesHint"]">
                        <input type="checkbox" class="js-does-shifts" data-user-id="@u.Id"
                               data-user-name="@u.DisplayName" @(u.DoesShifts ? "checked" : "") />
                        <span class="does-shifts-toggle__text">@Localizer[u.DoesShifts ? "On" : "Off"]</span>
                    </label>
                    <div class="does-shifts-cell__categories" style="@(u.DoesShifts ? "" : "display:none;")">
                        <span class="js-cat-names">@(string.IsNullOrEmpty(u.ShiftCategoryNames) ? Localizer["Users_NoCategories"].Value : u.ShiftCategoryNames)</span>
                        <button type="button" class="btn btn-xs btn-secondary js-edit-cats"
                                data-user-id="@u.Id"
                                data-molecule-id="@(u.MoleculeId?.ToString() ?? "")"
                                data-user-name="@u.DisplayName"
                                data-selected="@string.Join(",", u.ShiftCategoryIds)">
                            <icon name="settings" /> @Localizer["Edit"]
                        </button>
                    </div>
                    @* Hidden form to POST the DoesShifts toggle (driven by JS so OFF can prompt about future shifts). *@
                    <form method="post" asp-page-handler="DoesShifts" class="js-does-shifts-form" style="display:none;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@u.Id" />
                        <input type="hidden" name="doesShifts" class="js-does-shifts-value" value="" />
                        <input type="hidden" name="deleteFutureShifts" class="js-delete-future" value="false" />
                    </form>
                </td>
                <td class="editable-cell" data-cell-type="role" data-user-id="@u.Id">
                    <div class="cell-display">
                        @{
                            var userRoleTemplate = u.RoleTemplateId.HasValue
                                ? Model.AssignableRoleTemplates.FirstOrDefault(rt => rt.Id == u.RoleTemplateId.Value)
                                : null;
                        }
                        <span class="cell-display__value">@(userRoleTemplate != null
                            ? RoleDisplayHelper.GetRoleDisplayName(Localizer, userRoleTemplate, u.JobTypeKey)
                            : RoleDisplayHelper.GetRoleDisplayName(Localizer, u.Role, u.JobTypeKey))</span>
                        <button type="button" class="cell-display__edit-btn" onclick="enterEditMode(this)" title="@Localizer["EditRole"]" aria-label="@Localizer["EditRole"]">
                            <icon name="settings" />
                        </button>
                    </div>
                    <div class="cell-edit">
                        <form method="post" asp-page-handler="Role" style="display:inline; margin: 0;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@u.Id" />
                            <select class="form-input cell-edit__select" name="roleTemplateId" data-original-value="@(u.RoleTemplateId?.ToString() ?? "")" loc-aria-label="Admin_EditRole">
                                @if (!u.RoleTemplateId.HasValue)
                                {
                                    <option value="" selected>-</option>
                                }
                                @foreach (var rt in Model.AssignableRoleTemplates)
                                {
                                    <option value="@rt.Id" data-derived-role="@rt.DerivedUserRole" selected="@(u.RoleTemplateId == rt.Id)">@RoleDisplayHelper.GetRoleDisplayName(Localizer, rt)</option>
                                }
                            </select>
                            <button type="submit" class="cell-edit__btn cell-edit__btn--save" title="@Localizer["Save"]" aria-label="@Localizer["Save"]"><icon name="check" /></button>
                            <button type="button" class="cell-edit__btn cell-edit__btn--cancel" onclick="exitEditMode(this)" title="@Localizer["Cancel"]" aria-label="@Localizer["Cancel"]"><icon name="x" /></button>
                        </form>
                    </div>
                </td>
                <td>
                    @if (u.GrantsCount > 0)
                    {
                        <span class="status-badge" style="background: var(--primary-bg); color: var(--primary);">@u.GrantsCount</span>
                    }
                    else
                    {
                        <span style="color: var(--text-muted);">0</span>
                    }
                </td>
                <td>
                   <form method="post" asp-page-handler="Toggle" style="display:inline; margin: 0;">
                   @Html.AntiForgeryToken()
                   <input type="hidden" name="id" value="@u.Id" />
                   <button class="btn btn-sm">@((u.IsActive) ? Localizer["Active"] : Localizer["Inactive"])</button>
                   </form>
                </td>
                <td>
                    <form method="post" asp-page-handler="ResetPassword" style="display:inline; margin: 0;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@u.Id" />
                    <div style="display: flex; gap: 0.5rem; align-items: center;">
                        <input class="form-input" type="password" name="newPassword" placeholder="@Localizer["NewPassword"]"
                               autocomplete="new-password" minlength="6" style="min-width: 100px;" loc-aria-label="Admin_ResetPassword" />
                        <button class="btn btn-sm">@Localizer["Set"]</button>
                    </div>
                    </form>
                </td>
                <td>
                    <div class="btn-group">
                        @if (u.IsLocked)
                        {
                            <form method="post" asp-page-handler="UnlockAccount" style="display:inline; margin: 0;"
                                  data-confirm-modal
                                  data-confirm-title="@Localizer["ConfirmUnlockAccount_Title"]"
                                  data-confirm-message="@string.Format(Localizer["ConfirmUnlockAccount"].Value, u.DisplayName)"
                                  data-confirm-action="@Localizer["UnlockAccount"]"
                                  data-confirm-level="warning">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@u.Id" />
                                <button type="submit" class="btn btn-warning btn-sm" title="@Localizer["UnlockAccount"]">
                                    <icon name="unlock" size="sm" />
                                </button>
                            </form>
                        }
                        <a href="/Admin/EditProfile?UserId=@u.Id" class="btn btn-sm">
                            <icon name="pencil" />
                        </a>
                        <form method="post" asp-page-handler="DeleteUser" style="display:inline; margin: 0;"
                              data-confirm-modal
                              data-confirm-title="@Localizer["ConfirmDeleteUser_Title"]"
                              data-confirm-message="@string.Format(Localizer["ConfirmDeleteUser"].Value, u.DisplayName)"
                              data-confirm-action="@Localizer["Delete"]"
                              data-confirm-level="danger">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@u.Id" />
                            <button type="submit" class="btn btn-danger btn-sm">
                                <icon name="trash" />
                            </button>
                        </form>
                        <button type="button" class="btn btn-sm js-move-user"
                                data-user-id="@u.Id" data-user-name="@u.DisplayName" data-user-company="@u.CompanyName"
                                data-user-molecule-id="@(u.MoleculeId?.ToString() ?? "")"
                                title="@Localizer["Users_MoveTitle"]">
                            @Localizer["Users_Move"]
                        </button>
                        <button type="button" class="btn btn-sm js-add-membership"
                                data-user-id="@u.Id"
                                data-user-name="@u.DisplayName"
                                data-current-company-ids="@string.Join(",", (u.Memberships ?? (IReadOnlyList<UsersModel.UserMembershipVM>)new List<UsersModel.UserMembershipVM>()).Select(m => m.CompanyId).DefaultIfEmpty(u.CompanyId))"
                                title="@Localizer["Users_Membership_AddTitle"]">
                            ➕ @Localizer["Users_Membership_Add"]
                        </button>
                    </div>
                </td>
            </tr>
            @* Membership expander row — hidden by default; toggled by the ▾ button above (AuditLog pattern) *@
            @if (hasMemberships)
            {
                var colSpan = 11; @* match the number of <th> columns in the users table header *@
                <tr id="memberships-@u.Id" class="details-row" style="display:none;">
                    <td colspan="@colSpan" style="padding:0.75rem 1rem; background:var(--surface-soft);">
                        <table style="width:100%; border-collapse:collapse; font-size:0.875rem;">
                            <thead>
                                <tr style="text-align:start; color:var(--text-muted);">
                                    <th style="padding:0.25rem 0.5rem; font-weight:600;">@Localizer["Users_Membership_Company"]</th>
                                    <th style="padding:0.25rem 0.5rem; font-weight:600;">@Localizer["Users_Membership_Role"]</th>
                                    <th style="padding:0.25rem 0.5rem; font-weight:600;">@Localizer["JobType"]</th>
                                    <th style="padding:0.25rem 0.5rem; font-weight:600;"><loc key="Users_Participates" /></th>
                                    <th style="padding:0.25rem 0.5rem; font-weight:600;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in u.Memberships!)
                                {
                                    <tr>
                                        <td style="padding:0.25rem 0.5rem;">
                                            @m.CompanyName
                                            @if (m.IsPrimary)
                                            {
                                                <span class="badge badge-primary" style="margin-inline-start:0.35rem; font-size:0.7rem;">@Localizer["Users_Membership_Primary"]</span>
                                            }
                                        </td>
                                        <td style="padding:0.25rem 0.5rem;">@(m.RoleName ?? "-")</td>
                                        <td style="padding:0.25rem 0.5rem;">@(m.JobTypeName ?? "-")</td>
                                        <td style="padding:0.25rem 0.5rem;">@Localizer[m.DoesShifts ? "On" : "Off"]</td>
                                        <td style="padding:0.25rem 0.5rem;">
                                            <div class="btn-group">
                                                @if (!m.IsPrimary)
                                                {
                                                    @* Make primary *@
                                                    <form method="post" asp-page-handler="SetPrimaryMembership" style="display:inline; margin:0;">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="userId" value="@u.Id" />
                                                        <input type="hidden" name="companyId" value="@m.CompanyId" />
                                                        <button type="submit" class="btn btn-xs btn-secondary"
                                                                title="@Localizer["Users_Membership_MakePrimary"]">
                                                            @Localizer["Users_Membership_MakePrimary"]
                                                        </button>
                                                    </form>
                                                    @* Remove membership *@
                                                    <button type="button"
                                                            class="btn btn-xs btn-danger js-remove-membership"
                                                            data-user-id="@u.Id"
                                                            data-user-name="@u.DisplayName"
                                                            data-company-id="@m.CompanyId"
                                                            data-company-name="@m.CompanyName"
                                                            title="@Localizer["Users_Membership_Remove"]">
                                                        @Localizer["Users_Membership_Remove"]
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @* Add membership button *@
                        <div style="margin-top:0.5rem; text-align:end;">
                            <button type="button"
                                    class="btn btn-xs btn-primary js-add-membership"
                                    data-user-id="@u.Id"
                                    data-user-name="@u.DisplayName"
                                    data-current-company-ids="@string.Join(",", u.Memberships!.Select(m => m.CompanyId))">
                                ➕ @Localizer["Users_Membership_Add"]
                            </button>
                        </div>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
    </div>

    @* Pagination controls for users *@
    @if (Model.TotalPages > 1)
    {
        <div style="display: flex; justify-content: center; align-items: center; gap: 1rem; margin-top: 1.5rem; padding: 1rem;">
            @if (Model.CurrentPage > 1)
            {
                <a href="?CurrentPage=@(Model.CurrentPage - 1)@(Model.UserFilterCompanyId.HasValue ? $"&UserFilterCompanyId={Model.UserFilterCompanyId}" : "")@(Model.UserFilterRole.HasValue ? $"&UserFilterRole={(int)Model.UserFilterRole}" : "")@(Model.UserFilterMoleculeId.HasValue ? $"&UserFilterMoleculeId={Model.UserFilterMoleculeId}" : "")@(Model.UserFilterJobTypeId.HasValue ? $"&UserFilterJobTypeId={Model.UserFilterJobTypeId}" : "")"
                   class="btn btn-secondary">← @Localizer["Pagination_Previous"]</a>
            }
            else
            {
                <button class="btn btn-secondary" disabled>← @Localizer["Pagination_Previous"]</button>
            }

            <span style="font-weight: 600; color: var(--text);">
                @Localizer["Pagination_PageXofY", Model.CurrentPage, Model.TotalPages] (@Model.TotalUsers)
            </span>

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a href="?CurrentPage=@(Model.CurrentPage + 1)@(Model.UserFilterCompanyId.HasValue ? $"&UserFilterCompanyId={Model.UserFilterCompanyId}" : "")@(Model.UserFilterRole.HasValue ? $"&UserFilterRole={(int)Model.UserFilterRole}" : "")@(Model.UserFilterMoleculeId.HasValue ? $"&UserFilterMoleculeId={Model.UserFilterMoleculeId}" : "")@(Model.UserFilterJobTypeId.HasValue ? $"&UserFilterJobTypeId={Model.UserFilterJobTypeId}" : "")"
                   class="btn btn-secondary">@Localizer["Pagination_Next"] →</a>
            }
            else
            {
                <button class="btn btn-secondary" disabled>@Localizer["Pagination_Next"] →</button>
            }
        </div>
    }

    <div class="warning-box">
        <div class="warning-title">
            <icon name="alert-triangle" /> @Localizer["UserDeletionWarning"]
        </div>
        <div class="warning-text">
            @Localizer["DeletingUserWillRemove"]:<br/>
            • @Localizer["AllTheirShiftAssignments"]<br/>
            • @Localizer["AllTheirTimeOffRequests"]<br/>
            • @Localizer["AllTheirSwapRequests"]<br/>
            • @Localizer["TheUserAccountItself"]<br/><br/>
            <strong>@Localizer["ActionCannotBeUndone"]</strong>
        </div>
    </div>
</div>


@* I-07: Bulk user import from CSV *@
<div class="section-card" style="margin-top: 1rem;">
    <h2 class="section-title"><loc key="BulkImport" /> (CSV)</h2>
    <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 0.75rem;">
        CSV format: <code>Email,DisplayName,Password,Role,Phone</code> (first row = header, max 500 rows).
        All imported users will be required to change their password on first login.
    </p>
    @if (!string.IsNullOrEmpty(Model.BulkImportResult))
    {
        <div class="alert" style="background: var(--surface-soft); padding: 0.75rem; border-radius: 0.5rem; margin-bottom: 0.75rem; white-space: pre-line; font-size: 0.85rem;">
            @Model.BulkImportResult
        </div>
    }
    <form method="post" asp-page-handler="BulkImport" enctype="multipart/form-data"
          data-confirm-modal
          data-confirm-title="@Localizer["BulkImport_Confirm_Title"]"
          data-confirm-message="@Localizer["BulkImport_Confirm"]"
          data-confirm-action="@Localizer["Import"]"
          data-confirm-level="warning">
        <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
            <input type="file" name="BulkImportFile" accept=".csv" class="form-input" style="max-width: 300px;" required loc-aria-label="Admin_BulkImportFile" />
            <button type="submit" class="btn btn-primary">
                <loc key="Import" />
            </button>
        </div>
    </form>
</div>

@* Move user between companies — destination picker + impact preview *@
<dialog id="moveUserDialog" style="border:none; border-radius:0.75rem; padding:0; max-width:480px; width:90%; background:var(--surface); color:var(--text); box-shadow:0 10px 40px rgba(0,0,0,0.35);">
    <form method="post" asp-page-handler="MoveUser" id="moveUserForm" style="margin:0; padding:1.5rem;">
        @Html.AntiForgeryToken()
        <h2 class="section-title" style="margin-top:0;">@Localizer["Users_MoveTitle"]</h2>
        <p id="moveUserName" style="font-weight:600; margin:0.25rem 0 1rem; color:var(--text);"></p>
        <input type="hidden" name="userId" id="moveUserId" />

        <label for="moveDestCompany" style="display:block; margin-bottom:0.35rem;">@Localizer["Users_MoveDestination"]</label>
        <select id="moveDestCompany" name="destCompanyId" class="form-input" style="width:100%; margin-bottom:1rem;" required>
            <option value="">@Localizer["Users_MoveSelectCompany"]</option>
            @foreach (var company in Model.AvailableCompanies)
            {
                <option value="@company.Id" data-molecule-id="@(company.MoleculeId?.ToString() ?? "")">@company.LocalizedName</option>
            }
        </select>

        <div id="moveImpact" aria-live="polite" style="background:var(--surface-soft); padding:0.75rem; border-radius:0.5rem; margin-bottom:1rem; font-size:0.85rem; min-height:1.5rem; color:var(--text); white-space:pre-line;"></div>

        <div style="display:flex; gap:0.5rem; justify-content:flex-end;">
            <button type="button" class="btn" id="moveCancelBtn">@Localizer["Button_Cancel"]</button>
            <button type="submit" class="btn btn-danger" id="moveConfirmBtn" disabled>@Localizer["Users_MoveConfirm"]</button>
        </div>
    </form>
</dialog>

@* Add membership dialog *@
<dialog id="addMembershipDialog" style="border:none; border-radius:0.75rem; padding:0; max-width:480px; width:90%; background:var(--surface); color:var(--text); box-shadow:0 10px 40px rgba(0,0,0,0.35);">
    <form method="post" asp-page-handler="AddMembership" id="addMembershipForm" style="margin:0; padding:1.5rem;">
        @Html.AntiForgeryToken()
        <h2 class="section-title" style="margin-top:0;">@Localizer["Users_Membership_AddTitle"]</h2>
        <p id="addMembershipUserName" style="font-weight:600; margin:0.25rem 0 1rem; color:var(--text);"></p>
        <input type="hidden" name="userId" id="addMembershipUserId" />

        <label for="addMembershipCompany" style="display:block; margin-bottom:0.35rem;">@Localizer["Users_Membership_Company"]</label>
        <select id="addMembershipCompany" name="companyId" class="form-input" style="width:100%; margin-bottom:1rem;" required>
            <option value="">@Localizer["Users_Membership_SelectCompany"]</option>
            @foreach (var company in Model.AvailableCompanies)
            {
                <option value="@company.Id">@company.LocalizedName</option>
            }
        </select>

        <label for="addMembershipRole" style="display:block; margin-bottom:0.35rem;">@Localizer["Users_Membership_Role"]</label>
        <select id="addMembershipRole" name="roleTemplateId" class="form-input" style="width:100%; margin-bottom:1rem;">
            <option value="">@Localizer["Users_Membership_SelectRole"]</option>
            @foreach (var rt in Model.AssignableRoleTemplates)
            {
                <option value="@rt.Id">@RoleDisplayHelper.GetRoleDisplayName(Localizer, rt)</option>
            }
        </select>

        <label for="addMembershipJobType" style="display:block; margin-bottom:0.35rem;">@Localizer["JobType"]</label>
        <select id="addMembershipJobType" name="jobTypeId" class="form-input" style="width:100%; margin-bottom:1rem;">
            <option value="">@Localizer["Users_Membership_SelectJobType"]</option>
            @foreach (var jt in Model.AvailableJobTypes)
            {
                <option value="@jt.Id">@jt.Name</option>
            }
        </select>

        <label style="display:flex; align-items:center; gap:0.5rem; margin-bottom:1rem; cursor:pointer;">
            <input type="checkbox" name="doesShifts" value="true" id="addMembershipDoesShifts" />
            <span>@Localizer["Users_Membership_DoesShifts"]</span>
        </label>

        <div style="display:flex; gap:0.5rem; justify-content:flex-end;">
            <button type="button" class="btn" id="addMembershipCancelBtn">@Localizer["Button_Cancel"]</button>
            <button type="submit" class="btn btn-primary">@Localizer["Users_Membership_Add"]</button>
        </div>
    </form>
</dialog>

@* Remove membership dialog — mirrors Move dialog: fetch impact → show summary → confirm POST *@
<dialog id="removeMembershipDialog" data-error-text="@Localizer["Error_Generic"].Value" style="border:none; border-radius:0.75rem; padding:0; max-width:480px; width:90%; background:var(--surface); color:var(--text); box-shadow:0 10px 40px rgba(0,0,0,0.35);">
    <form method="post" asp-page-handler="RemoveMembership" id="removeMembershipForm" style="margin:0; padding:1.5rem;">
        @Html.AntiForgeryToken()
        <h2 class="section-title" style="margin-top:0;">@Localizer["Users_Membership_RemoveTitle"]</h2>
        <p id="removeMembershipUserName" style="font-weight:600; margin:0.25rem 0 1rem; color:var(--text);"></p>
        <input type="hidden" name="userId" id="removeMembershipUserId" />
        <input type="hidden" name="companyId" id="removeMembershipCompanyId" />

        <div id="removeMembershipImpact" aria-live="polite" style="background:var(--surface-soft); padding:0.75rem; border-radius:0.5rem; margin-bottom:1rem; font-size:0.85rem; min-height:1.5rem; color:var(--text); white-space:pre-line;"></div>

        <div style="display:flex; gap:0.5rem; justify-content:flex-end;">
            <button type="button" class="btn" id="removeMembershipCancelBtn">@Localizer["Button_Cancel"]</button>
            <button type="submit" class="btn btn-danger" id="removeMembershipConfirmBtn" disabled>@Localizer["Users_Membership_RemoveConfirm"]</button>
        </div>
    </form>
</dialog>

@* DoesShifts OFF confirm: delete future shifts or keep them *@
<dialog id="doesShiftsConfirmDialog" style="border:none; border-radius:0.75rem; padding:0; max-width:460px; width:90%; background:var(--surface); color:var(--text); box-shadow:0 10px 40px rgba(0,0,0,0.35);">
    <div style="margin:0; padding:1.5rem;">
        <h2 class="section-title" style="margin-top:0;">@Localizer["Users_DoesShiftsOffTitle"]</h2>
        <p id="doesShiftsConfirmMsg" style="margin:0.25rem 0 1rem; color:var(--text);"></p>
        <div style="display:flex; gap:0.5rem; justify-content:flex-end; flex-wrap:wrap;">
            <button type="button" class="btn" id="doesShiftsCancelBtn">@Localizer["Button_Cancel"]</button>
            <button type="button" class="btn btn-secondary" id="doesShiftsKeepBtn">@Localizer["Users_KeepShifts"]</button>
            <button type="button" class="btn btn-danger" id="doesShiftsDeleteBtn">@Localizer["Users_DeleteShifts"]</button>
        </div>
    </div>
</dialog>

@* Per-user shift-category multi-select *@
<dialog id="userCategoriesDialog" style="border:none; border-radius:0.75rem; padding:0; max-width:440px; width:90%; background:var(--surface); color:var(--text); box-shadow:0 10px 40px rgba(0,0,0,0.35);">
    <div style="margin:0; padding:1.5rem;">
        <h2 class="section-title" style="margin-top:0;">@Localizer["Users_CategoriesTitle"]</h2>
        <p id="userCategoriesUserName" style="font-weight:600; margin:0.25rem 0 1rem; color:var(--text);"></p>
        <div id="userCategoriesList" style="max-height:320px; overflow-y:auto; display:flex; flex-direction:column; gap:0.125rem; margin-bottom:1rem;"></div>
        <div style="display:flex; gap:0.5rem; justify-content:flex-end;">
            <button type="button" class="btn" id="userCategoriesCancelBtn">@Localizer["Button_Cancel"]</button>
            <button type="button" class="btn btn-primary" id="userCategoriesSaveBtn">@Localizer["Button_Save"]</button>
        </div>
    </div>
</dialog>

@* Category options per molecule for the multi-select (keys are molecule IDs as strings). *@
<script>window.__categoriesByMolecule = @Json.Serialize(Model.AvailableCategoriesByMolecule);</script>

@section Scripts {
    <script>
        const selectedText = '@(Localizer["Selected"].Value.Trim())';

        // --- Move user between companies (destination picker + impact preview) ---
        (function () {
            const dlg = document.getElementById('moveUserDialog');
            if (!dlg) return;
            const idField = document.getElementById('moveUserId');
            const nameLabel = document.getElementById('moveUserName');
            const destSelect = document.getElementById('moveDestCompany');
            const impactBox = document.getElementById('moveImpact');
            const confirmBtn = document.getElementById('moveConfirmBtn');
            let currentUserId = null;

            document.querySelectorAll('.js-move-user').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    currentUserId = btn.dataset.userId;
                    idField.value = currentUserId;
                    nameLabel.textContent = btn.dataset.userName + (btn.dataset.userCompany ? ' — ' + btn.dataset.userCompany : '');
                    // Same-molecule guard (Epic 5): only offer destination companies in the user's own molecule.
                    var molId = btn.dataset.userMoleculeId || '';
                    Array.from(destSelect.options).forEach(function (opt) {
                        if (!opt.value) { opt.hidden = false; return; } // keep the placeholder
                        opt.hidden = (opt.dataset.moleculeId || '') !== molId;
                    });
                    destSelect.value = '';
                    impactBox.textContent = '';
                    confirmBtn.disabled = true;
                    dlg.showModal();
                });
            });

            const cancelBtn = document.getElementById('moveCancelBtn');
            if (cancelBtn) cancelBtn.addEventListener('click', function () { dlg.close(); });

            destSelect.addEventListener('change', async function () {
                const dest = destSelect.value;
                confirmBtn.disabled = true;
                if (!dest) { impactBox.textContent = ''; return; }
                impactBox.textContent = '…';
                try {
                    const resp = await fetch('?handler=MoveImpact&userId=' + encodeURIComponent(currentUserId) + '&destCompanyId=' + encodeURIComponent(dest));
                    const data = await resp.json();
                    if (!data.ok) { impactBox.textContent = data.error || 'Error'; return; }
                    impactBox.textContent = data.summary || '';
                    confirmBtn.disabled = false;
                } catch (e) {
                    impactBox.textContent = 'Error';
                }
            });
        })();

        // --- Membership expander toggle ---
        (function () {
            document.querySelectorAll('.js-memberships-toggle').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var userId = btn.dataset.userId;
                    var row = document.getElementById('memberships-' + userId);
                    if (!row) return;
                    var isOpen = row.style.display !== 'none';
                    row.style.display = isOpen ? 'none' : 'table-row';
                    btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
                    btn.textContent = isOpen ? '▾' : '▴';
                });
            });
        })();

        // --- Add membership dialog ---
        (function () {
            var dlg = document.getElementById('addMembershipDialog');
            if (!dlg) return;
            var userIdField = document.getElementById('addMembershipUserId');
            var userNameLabel = document.getElementById('addMembershipUserName');
            var companySelect = document.getElementById('addMembershipCompany');

            document.querySelectorAll('.js-add-membership').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var userId = btn.dataset.userId;
                    var userName = btn.dataset.userName;
                    var currentIds = (btn.dataset.currentCompanyIds || '').split(',').filter(Boolean);
                    userIdField.value = userId;
                    userNameLabel.textContent = userName;
                    // Hide companies the user is already in
                    Array.from(companySelect.options).forEach(function (opt) {
                        if (!opt.value) { opt.hidden = false; return; }
                        opt.hidden = currentIds.indexOf(opt.value) !== -1;
                    });
                    companySelect.value = '';
                    dlg.showModal();
                });
            });

            var cancelBtn = document.getElementById('addMembershipCancelBtn');
            if (cancelBtn) cancelBtn.addEventListener('click', function () { dlg.close(); });
        })();

        // --- Remove membership dialog (mirrors Move dialog: fetch impact → confirm POST) ---
        (function () {
            var dlg = document.getElementById('removeMembershipDialog');
            if (!dlg) return;
            var userIdField = document.getElementById('removeMembershipUserId');
            var companyIdField = document.getElementById('removeMembershipCompanyId');
            var userNameLabel = document.getElementById('removeMembershipUserName');
            var impactBox = document.getElementById('removeMembershipImpact');
            var confirmBtn = document.getElementById('removeMembershipConfirmBtn');

            var errText = dlg.dataset.errorText || 'Error';
            document.querySelectorAll('.js-remove-membership').forEach(function (btn) {
                btn.addEventListener('click', async function () {
                    var userId = btn.dataset.userId;
                    var companyId = btn.dataset.companyId;
                    var userName = btn.dataset.userName;
                    var companyName = btn.dataset.companyName;
                    userIdField.value = userId;
                    companyIdField.value = companyId;
                    userNameLabel.textContent = userName + (companyName ? ' — ' + companyName : '');
                    impactBox.textContent = '…';
                    confirmBtn.disabled = true;
                    dlg.showModal();
                    try {
                        var resp = await fetch('?handler=RemoveMembershipImpact&userId=' + encodeURIComponent(userId) + '&companyId=' + encodeURIComponent(companyId));
                        var data = await resp.json();
                        if (!data.ok) { impactBox.textContent = data.error || errText; return; }
                        impactBox.textContent = data.summary || '';
                        confirmBtn.disabled = false;
                    } catch (e) {
                        impactBox.textContent = errText;
                    }
                });
            });

            var cancelBtn = document.getElementById('removeMembershipCancelBtn');
            if (cancelBtn) cancelBtn.addEventListener('click', function () { dlg.close(); });
        })();

        // --- Participates-in-Shifts toggle + per-user shift categories ---
        (function () {
            var catData = window.__categoriesByMolecule || {};
            function token() {
                var t = document.querySelector('input[name="__RequestVerificationToken"]');
                return t ? t.value : '';
            }

            function submitDoesShifts(checkbox, value, deleteFuture) {
                var cell = checkbox.closest('.does-shifts-cell');
                var form = cell.querySelector('.js-does-shifts-form');
                form.querySelector('.js-does-shifts-value').value = value ? 'true' : 'false';
                form.querySelector('.js-delete-future').value = deleteFuture ? 'true' : 'false';
                form.submit();
            }

            var pendingToggle = null;
            var confirmDlg = document.getElementById('doesShiftsConfirmDialog');

            document.querySelectorAll('.js-does-shifts').forEach(function (cb) {
                cb.addEventListener('change', async function () {
                    var userId = cb.dataset.userId;
                    var name = cb.dataset.userName || '';
                    if (cb.checked) { submitDoesShifts(cb, true, false); return; }
                    try {
                        var resp = await fetch('?handler=DoesShiftsImpact&id=' + encodeURIComponent(userId));
                        var data = await resp.json();
                        if (data.ok && data.futureShifts > 0) {
                            pendingToggle = cb;
                            document.getElementById('doesShiftsConfirmMsg').textContent =
                                '@(Localizer["Users_DoesShiftsOffPrompt"].Value.Trim())'
                                    .replace('{0}', name).replace('{1}', data.futureShifts);
                            confirmDlg.showModal();
                            return;
                        }
                    } catch (e) { console.error('impact check failed', e); }
                    submitDoesShifts(cb, false, false);
                });
            });

            if (confirmDlg) {
                document.getElementById('doesShiftsCancelBtn').addEventListener('click', function () {
                    if (pendingToggle) pendingToggle.checked = true; // revert visual
                    pendingToggle = null; confirmDlg.close();
                });
                document.getElementById('doesShiftsKeepBtn').addEventListener('click', function () {
                    if (pendingToggle) submitDoesShifts(pendingToggle, false, false);
                    confirmDlg.close();
                });
                document.getElementById('doesShiftsDeleteBtn').addEventListener('click', function () {
                    if (pendingToggle) submitDoesShifts(pendingToggle, false, true);
                    confirmDlg.close();
                });
            }

            // Categories multi-select modal
            var catDlg = document.getElementById('userCategoriesDialog');
            var catList = document.getElementById('userCategoriesList');
            var catUserName = document.getElementById('userCategoriesUserName');
            var catSaveBtn = document.getElementById('userCategoriesSaveBtn');
            var catCancelBtn = document.getElementById('userCategoriesCancelBtn');
            var catCurrentUserId = null;

            document.querySelectorAll('.js-edit-cats').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    catCurrentUserId = btn.dataset.userId;
                    catUserName.textContent = btn.dataset.userName || '';
                    var molId = btn.dataset.moleculeId || '';
                    var selected = (btn.dataset.selected || '').split(',').filter(Boolean).map(Number);
                    var cats = catData[molId] || [];
                    catList.innerHTML = '';
                    if (cats.length === 0) {
                        var p = document.createElement('p');
                        p.className = 'cal-filter-empty';
                        p.textContent = '@(Localizer["Users_NoCategoriesAvailable"].Value.Trim())';
                        catList.appendChild(p);
                    } else {
                        cats.forEach(function (c) {
                            var id = (c.id != null) ? c.id : c.Id;
                            var nm = (c.name != null) ? c.name : c.Name;
                            var label = document.createElement('label');
                            label.style.cssText = 'display:flex; align-items:center; gap:0.5rem; padding:0.4rem 0.5rem; border-radius:6px; cursor:pointer;';
                            var cb = document.createElement('input');
                            cb.type = 'checkbox'; cb.value = id; cb.checked = selected.indexOf(id) !== -1;
                            var span = document.createElement('span'); span.textContent = nm;
                            label.appendChild(cb); label.appendChild(span);
                            catList.appendChild(label);
                        });
                    }
                    catDlg.showModal();
                });
            });

            if (catCancelBtn) catCancelBtn.addEventListener('click', function () { catDlg.close(); });

            if (catSaveBtn) catSaveBtn.addEventListener('click', async function () {
                var ids = Array.from(catList.querySelectorAll('input[type="checkbox"]:checked'))
                    .map(function (cb) { return parseInt(cb.value, 10); });
                catSaveBtn.disabled = true;
                try {
                    var resp = await fetch('?handler=UserCategories', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
                        body: JSON.stringify({ userId: parseInt(catCurrentUserId, 10), categoryIds: ids })
                    });
                    var data = await resp.json();
                    if (resp.ok && data.success) { catDlg.close(); location.reload(); return; }
                    window.FeedbackModal.show('error', (data && data.error) || '@(Localizer["Error_FailedToUpdate"].Value.Trim())');
                } catch (e) {
                    window.FeedbackModal.show('error', '@(Localizer["Error_FailedToUpdate"].Value.Trim())');
                } finally {
                    catSaveBtn.disabled = false;
                }
            });
        })();

        // Client-side user table search filter
        function filterUserTable(query) {
            var rows = document.querySelectorAll('#usersTable tbody tr');
            var q = query.toLowerCase();
            rows.forEach(function(row) {
                var text = row.textContent.toLowerCase();
                row.style.display = text.includes(q) ? '' : 'none';
            });
        }

        function toggleAllRequests(selectAllCheckbox) {
            const checkboxes = document.querySelectorAll('.request-checkbox');
            checkboxes.forEach(cb => {
                cb.checked = selectAllCheckbox.checked;
            });
            updateSelectedCount();
        }

        function updateSelectedCount() {
            const checkboxes = document.querySelectorAll('.request-checkbox:checked');
            const count = checkboxes.length;
            const countElement = document.getElementById('selectedCount');
            const batchApproveBtn = document.getElementById('batchApproveBtn');
            const selectAllCheckbox = document.getElementById('selectAllRequests');

            if (countElement) countElement.textContent = count > 0 ? `(${count} ${selectedText})` : '';
            if (batchApproveBtn) batchApproveBtn.disabled = count === 0;

            // Update select all checkbox state
            const totalCheckboxes = document.querySelectorAll('.request-checkbox').length;
            if (selectAllCheckbox) {
                selectAllCheckbox.checked = count > 0 && count === totalCheckboxes;
                selectAllCheckbox.indeterminate = count > 0 && count < totalCheckboxes;
            }
        }

        function approveSingleRequest(requestId) {
            const form = document.createElement('form');
            form.method = 'post';
            form.action = '/Admin/Users?handler=ApproveJoinRequest';

            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]').cloneNode();
            const idInput = document.createElement('input');
            idInput.type = 'hidden';
            idInput.name = 'id';
            idInput.value = requestId;

            form.appendChild(tokenInput);
            form.appendChild(idInput);

            // Pass the admin-selected template ID from the row's dropdown
            var templateSelect = document.querySelector('select[name="RequestTemplateIds[' + requestId + ']"]');
            if (templateSelect && templateSelect.value) {
                var templateInput = document.createElement('input');
                templateInput.type = 'hidden';
                templateInput.name = 'roleTemplateId';
                templateInput.value = templateSelect.value;
                form.appendChild(templateInput);
            }

            document.body.appendChild(form);
            form.submit();
        }

        function rejectSingleRequest(requestId, displayName) {
            const confirmMsg = '@(Localizer["ConfirmRejectJoinRequest"].Value.Trim())'.replace('{0}', displayName);
            if (!confirm(confirmMsg)) return;

            const form = document.createElement('form');
            form.method = 'post';
            form.action = '/Admin/Users?handler=RejectJoinRequest';

            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]').cloneNode();
            const idInput = document.createElement('input');
            idInput.type = 'hidden';
            idInput.name = 'id';
            idInput.value = requestId;

            form.appendChild(tokenInput);
            form.appendChild(idInput);
            document.body.appendChild(form);
            form.submit();
        }

        // Sync batch form submission with checkboxes
        const batchForm = document.getElementById('batchApprovalForm');
        if (batchForm) {
            batchForm.addEventListener('submit', function(e) {
                e.preventDefault();
                const batchDataForm = document.getElementById('batchDataForm');
                batchDataForm.submit();
            });
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            updateSelectedCount();
        });

        // Editable cell functions
        function enterEditMode(button) {
            const cell = button.closest('.editable-cell');
            const display = cell.querySelector('.cell-display');
            const edit = cell.querySelector('.cell-edit');

            display.classList.add('is-hidden');
            edit.classList.add('is-active');

            // Focus the select
            const select = edit.querySelector('select');
            if (select) select.focus();
        }

        function enterPstEditMode(button) {
            const cell = button.closest('.editable-cell');
            const userMoleculeId = cell.getAttribute('data-user-molecule-id');
            const select = cell.querySelector('select[name="primaryShiftTypeId"]');

            // Filter options to show only shift types from the user's molecule
            if (select && userMoleculeId) {
                for (var i = 0; i < select.options.length; i++) {
                    var opt = select.options[i];
                    var optMoleculeId = opt.getAttribute('data-molecule-id');
                    // Always show the blank option; hide options from other molecules
                    opt.hidden = optMoleculeId && optMoleculeId !== userMoleculeId;
                }
            }

            enterEditMode(button);
        }

        function exitEditMode(button) {
            const cell = button.closest('.editable-cell');
            const display = cell.querySelector('.cell-display');
            const edit = cell.querySelector('.cell-edit');

            // Revert select to original value
            const select = edit.querySelector('select');
            if (select) {
                const originalValue = select.getAttribute('data-original-value');
                select.value = originalValue;
            }

            display.classList.remove('is-hidden');
            edit.classList.remove('is-active');
        }

        // Close edit mode on Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                const activeEdit = document.querySelector('.cell-edit.is-active');
                if (activeEdit) {
                    const cancelBtn = activeEdit.querySelector('.cell-edit__btn--cancel');
                    if (cancelBtn) cancelBtn.click();
                }
            }
        });

        // NOTE: roleLabelMap was removed — each RoleTemplate has its own unique display name
        // (via RoleDisplayHelper / DisplayNameEN/HE), so renaming by DerivedUserRole+JobType
        // would incorrectly overwrite all Manager-derived or Director-derived templates
        // with the same label (the "mapotz" bug).

        // Director/AreaAdmin-aware company/molecule toggle for Add User form
        (function() {
            const addUserRoleSelect = document.querySelector('[name="NewRoleTemplateId"]');
            const addUserCompanyField = document.getElementById('addUserCompanyField');
            const addUserMoleculeField = document.getElementById('addUserMoleculeField');

            if (addUserRoleSelect) {
                function updateFieldVisibility() {
                    const selectedOpt = addUserRoleSelect.options[addUserRoleSelect.selectedIndex];
                    const derivedRole = selectedOpt ? selectedOpt.dataset.derivedRole : '';
                    const isDirectorOrAreaAdmin = (derivedRole === 'Director' || derivedRole === 'AreaAdmin');
                    if (addUserCompanyField) addUserCompanyField.style.display = isDirectorOrAreaAdmin ? 'none' : '';
                    if (addUserMoleculeField) addUserMoleculeField.style.display = isDirectorOrAreaAdmin ? '' : 'none';
                    // Toggle required attributes
                    const companySelect = addUserCompanyField ? addUserCompanyField.querySelector('select') : null;
                    const moleculeSelect = addUserMoleculeField ? addUserMoleculeField.querySelector('select') : null;
                    if (companySelect) companySelect.required = !isDirectorOrAreaAdmin;
                    if (moleculeSelect) moleculeSelect.required = isDirectorOrAreaAdmin;
                }
                addUserRoleSelect.addEventListener('change', updateFieldVisibility);
                // Sync initial state on page load (handles post-back after validation error)
                updateFieldVisibility();
            }
        })();

        // Dynamic job type filtering based on selected company's molecule
        (function() {
            var jobTypeMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.JobTypesByCompany));
            var companySelect = document.querySelector('[name="NewUserCompanyId"]');
            var jobTypeSelect = document.getElementById('addUserJobType');
            if (!companySelect || !jobTypeSelect || !Object.keys(jobTypeMap).length) return;

            // Cache original options (excluding the placeholder)
            var allOptions = [];
            for (var i = 0; i < jobTypeSelect.options.length; i++) {
                var opt = jobTypeSelect.options[i];
                if (opt.value) allOptions.push({ value: opt.value, text: opt.text, key: opt.dataset.key });
            }
            var placeholder = jobTypeSelect.options[0]; // "-- Select Job Type --"

            function filterJobTypes() {
                var companyId = companySelect.value;
                var validIds = companyId && jobTypeMap[companyId] ? jobTypeMap[companyId] : null;
                var currentValue = jobTypeSelect.value;

                // Clear all options except placeholder
                jobTypeSelect.length = 1;

                // Re-add valid options
                allOptions.forEach(function(opt) {
                    if (!validIds || validIds.indexOf(parseInt(opt.value, 10)) !== -1) {
                        var newOpt = document.createElement('option');
                        newOpt.value = opt.value;
                        newOpt.textContent = opt.text;
                        if (opt.key) newOpt.dataset.key = opt.key;
                        if (opt.value === currentValue) newOpt.selected = true;
                        jobTypeSelect.appendChild(newOpt);
                    }
                });

                // If previously selected value is no longer valid, reset to placeholder
                if (currentValue && !jobTypeSelect.querySelector('option[value="' + currentValue + '"]')) {
                    jobTypeSelect.value = '';
                }
            }

            companySelect.addEventListener('change', filterJobTypes);
            // Apply initial filtering on page load
            filterJobTypes();
        })();
    </script>
}
