@page
@model ShiftManager.Pages.Admin.AnnouncementsModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.Models
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["Announcements"];
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Admin"], Url = "/Admin" },
    new BreadcrumbItem { Label = Localizer["Announcements"], IsActive = true }
})

@section Styles {
    <style>
        /* Page Header */
        .page-header {
            margin-bottom: 2rem;
        }

        .page-title {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text);
            margin: 0 0 0.5rem 0;
            line-height: 1.2;
        }

        .page-subtitle {
            font-size: 1rem;
            color: var(--text-muted);
            margin: 0;
            line-height: 1.5;
        }

        /* Alert Messages */
        .alert {
            padding: 1rem 1.25rem;
            border-radius: 10px;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 0.9375rem;
            font-weight: 500;
        }

        .alert-success {
            background: var(--success);
            color: var(--success-text);
            border: 1px solid rgba(76, 175, 80, 0.3);
        }

        .alert-error {
            background: var(--danger);
            color: var(--danger-text);
            border: 1px solid rgba(244, 67, 54, 0.3);
        }

        /* Section Card */
        .section-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1.75rem;
            margin-bottom: 2rem;
            box-shadow: var(--shadow-sm);
        }

        .section-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--text);
            margin: 0 0 1.5rem 0;
        }

        /* Form Grid */
        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.375rem;
        }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        .form-group label {
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--text);
        }

        .form-input, .form-select, .form-textarea {
            width: 100%;
            padding: 0.625rem 0.875rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: var(--bg);
            color: var(--text);
            font-size: 0.875rem;
            transition: all 0.15s ease;
        }

        .form-textarea {
            min-height: 100px;
            resize: vertical;
            font-family: inherit;
        }

        .form-input:focus, .form-select:focus, .form-textarea:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--primary-bg);
        }

        .form-checkbox-group {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding-top: 1.5rem;
        }

        .form-checkbox-group input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

        .form-checkbox-group label {
            cursor: pointer;
        }

        /* Table Styles */
        .data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.875rem;
        }

        .data-table thead {
            background: var(--surface-soft);
        }

        .data-table th {
            padding: 0.875rem;
            text-align: left;
            font-weight: 600;
            color: var(--text);
            border-bottom: 2px solid var(--border);
        }

        .data-table td {
            padding: 0.875rem;
            border-bottom: 1px solid var(--border);
            vertical-align: top;
        }

        .data-table tbody tr:hover {
            background: var(--surface-soft);
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.375rem;
            padding: 0.5rem 1rem;
            border: 1px solid var(--border);
            border-radius: 6px;
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.15s ease;
            text-decoration: none;
            white-space: nowrap;
            background: var(--surface-soft);
            color: var(--text);
        }

        .btn:hover {
            background: var(--surface-elevated);
            transform: translateY(-1px);
            box-shadow: var(--shadow-sm);
        }

        .btn-primary {
            background: var(--primary);
            color: var(--primary-contrast);
            border-color: var(--primary);
        }

        .btn-primary:hover {
            background: var(--primary-hover);
            border-color: var(--primary-hover);
            box-shadow: var(--shadow-md);
        }

        .btn-danger {
            background: var(--danger);
            color: var(--danger-text);
            border-color: var(--danger);
        }

        .btn-danger:hover {
            background: var(--danger-hover);
        }

        .btn-sm {
            padding: 0.3rem 0.6rem;
            font-size: 0.8125rem;
        }

        .btn-group {
            display: flex;
            gap: 0.5rem;
        }

        /* Status Badges */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            padding: 0.25rem 0.625rem;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .status-active {
            background: var(--success);
            color: var(--success-text);
        }

        .status-inactive {
            background: var(--surface-soft);
            color: var(--text-muted);
        }

        .status-expired {
            background: var(--danger);
            color: var(--danger-text);
        }

        .status-pinned {
            background: var(--primary-bg);
            color: var(--primary);
        }

        /* Scope Badges */
        .scope-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            padding: 0.25rem 0.5rem;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 500;
            background: var(--surface-soft);
            color: var(--text-muted);
        }

        .scope-all {
            background: var(--primary-bg);
            color: var(--primary);
        }

        .scope-department {
            background: rgba(156, 39, 176, 0.1);
            color: #9c27b0;
        }

        .scope-role {
            background: rgba(255, 152, 0, 0.1);
            color: #f57c00;
        }

        /* Announcement Content Preview */
        .content-preview {
            max-width: 300px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: var(--text-muted);
            font-size: 0.8125rem;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 3rem 2rem;
            color: var(--text-muted);
        }

        /* Conditional Field Visibility */
        .conditional-field {
            display: none;
        }

        .conditional-field.visible {
            display: flex;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .page-title {
                font-size: 1.75rem;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .data-table {
                font-size: 0.8125rem;
            }

            .data-table th,
            .data-table td {
                padding: 0.625rem 0.5rem;
            }

            .btn-group {
                flex-direction: column;
            }
        }
    </style>
}

<!-- Page Header -->
<div class="page-header">
    <h1 class="page-title">@Localizer["AnnouncementManagement"]</h1>
    <p class="page-subtitle">@Localizer["ManageCompanyAnnouncements"]</p>
</div>

<!-- Success/Error Messages -->
@if (!string.IsNullOrEmpty(Model.Success))
{
    <div class="alert alert-success">
        <span style="font-size: 1.25rem;"></span>
        <span>@Model.Success</span>
    </div>
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-error">
        <span style="font-size: 1.25rem;"></span>
        <span>@Model.Error</span>
    </div>
}

<!-- Create Announcement Section -->
<div class="section-card">
    <h2 class="section-title">@Localizer["CreateAnnouncement"]</h2>

    <form method="post" asp-page-handler="Create">
        <div class="form-grid">
            <div class="form-group full-width">
                <label for="title">@Localizer["Title"]</label>
                <input type="text" id="title" name="Title" class="form-input" required
                       placeholder="@Localizer["EnterAnnouncementTitle"]" />
            </div>

            <div class="form-group full-width">
                <label for="announcementContent">@Localizer["Content"]</label>
                <textarea id="announcementContent" name="AnnouncementContent" class="form-textarea" required
                          placeholder="@Localizer["EnterAnnouncementContent"]"></textarea>
            </div>

            <div class="form-group">
                <label for="scope">@Localizer["Scope"]</label>
                <select id="scope" name="Scope" class="form-select" onchange="updateScopeFields()">
                    @foreach (var scope in Model.Scopes)
                    {
                        <option value="@scope.Value">@scope.Text</option>
                    }
                </select>
            </div>

            <div class="form-group conditional-field" id="departmentField">
                <label for="targetDepartmentId">@Localizer["Department"]</label>
                <select id="targetDepartmentId" name="TargetDepartmentId" class="form-select">
                    <option value="">-- @Localizer["SelectDepartment"] --</option>
                    @foreach (var dept in Model.Departments)
                    {
                        <option value="@dept.Id">@dept.MoleculeName - @dept.Name</option>
                    }
                </select>
            </div>

            <div class="form-group conditional-field" id="roleField">
                <label for="targetRole">@Localizer["Role"]</label>
                <select id="targetRole" name="TargetRole" class="form-select">
                    <option value="">-- @Localizer["SelectRole"] --</option>
                    @foreach (var role in Model.Roles)
                    {
                        <option value="@role.Value">@role.Text</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label for="expiresAt">@Localizer["ExpiresAt"]</label>
                <input type="datetime-local" id="expiresAt" name="ExpiresAt" class="form-input" />
            </div>

            <div class="form-checkbox-group">
                <input type="checkbox" id="isPinned" name="IsPinned" value="true" />
                <label for="isPinned">@Localizer["PinToTop"]</label>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">
            <span>+</span>
            <span>@Localizer["CreateAnnouncement"]</span>
        </button>
    </form>
</div>

<!-- Existing Announcements Section -->
<div class="section-card">
    <h2 class="section-title">@Localizer["ExistingAnnouncements"]</h2>

    @if (Model.Announcements.Any())
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>@Localizer["Title"]</th>
                    <th>@Localizer["Scope"]</th>
                    <th>@Localizer["CreatedBy"]</th>
                    <th>@Localizer["CreatedAt"]</th>
                    <th>@Localizer["ExpiresAt"]</th>
                    <th>@Localizer["Status"]</th>
                    <th style="width:1%">@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var announcement in Model.Announcements.OrderByDescending(a => a.IsPinned).ThenByDescending(a => a.CreatedAt))
            {
                <tr>
                    <td>
                        <div style="font-weight: 500;">@announcement.Title</div>
                        <div class="content-preview">@announcement.Content</div>
                    </td>
                    <td>
                        @if (announcement.Scope == AnnouncementScope.All)
                        {
                            <span class="scope-badge scope-all">@Localizer["AnnouncementScope_All"]</span>
                        }
                        else if (announcement.Scope == AnnouncementScope.Department)
                        {
                            <span class="scope-badge scope-department">
                                @Localizer["AnnouncementScope_Department"]: @(announcement.TargetDepartmentName ?? "-")
                            </span>
                        }
                        else if (announcement.Scope == AnnouncementScope.Role)
                        {
                            <span class="scope-badge scope-role">
                                @Localizer["AnnouncementScope_Role"]: @(announcement.TargetRole != null ? Localizer[announcement.TargetRole] : "-")
                            </span>
                        }
                    </td>
                    <td>@announcement.CreatorName</td>
                    <td>@announcement.CreatedAt.ToLocalTime().ToString("MM/dd/yy HH:mm")</td>
                    <td>
                        @if (announcement.ExpiresAt.HasValue)
                        {
                            <span style="color: @(announcement.IsExpired ? "var(--danger)" : "var(--text)")">
                                @announcement.ExpiresAt.Value.ToLocalTime().ToString("MM/dd/yy HH:mm")
                            </span>
                        }
                        else
                        {
                            <span style="color: var(--text-muted);">@Localizer["Never"]</span>
                        }
                    </td>
                    <td>
                        <div style="display: flex; flex-wrap: wrap; gap: 0.25rem;">
                            @if (announcement.IsPinned)
                            {
                                <span class="status-badge status-pinned">@Localizer["Pinned"]</span>
                            }
                            @if (announcement.IsExpired)
                            {
                                <span class="status-badge status-expired">@Localizer["Expired"]</span>
                            }
                            else if (announcement.IsActive)
                            {
                                <span class="status-badge status-active">@Localizer["Active"]</span>
                            }
                            else
                            {
                                <span class="status-badge status-inactive">@Localizer["Inactive"]</span>
                            }
                        </div>
                    </td>
                    <td>
                        <div class="btn-group">
                            <form method="post" asp-page-handler="ToggleActive" style="display:inline; margin: 0;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@announcement.Id" />
                                <button type="submit" class="btn btn-sm" title="@(announcement.IsActive ? Localizer["Deactivate"] : Localizer["Activate"])">
                                    @(announcement.IsActive ? Localizer["Deactivate"] : Localizer["Activate"])
                                </button>
                            </form>
                            <form method="post" asp-page-handler="Delete" style="display:inline; margin: 0;"
                                  onsubmit="return confirm('@Localizer["ConfirmDeleteAnnouncement"]');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@announcement.Id" />
                                <button type="submit" class="btn btn-danger btn-sm" title="@Localizer["Delete"]">
                                    @Localizer["Delete"]
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
    else
    {
        <p class="empty-state">@Localizer["NoAnnouncementsFound"]</p>
    }
</div>

@section Scripts {
    <script>
        function updateScopeFields() {
            const scopeSelect = document.getElementById('scope');
            const departmentField = document.getElementById('departmentField');
            const roleField = document.getElementById('roleField');
            const departmentSelect = document.getElementById('targetDepartmentId');
            const roleSelect = document.getElementById('targetRole');

            // Hide all conditional fields
            departmentField.classList.remove('visible');
            roleField.classList.remove('visible');

            // Show relevant field based on scope
            // 0 = All, 1 = Department, 2 = Role
            const scopeValue = parseInt(scopeSelect.value);

            if (scopeValue === 1) { // Department
                departmentField.classList.add('visible');
                roleSelect.value = '';
            } else if (scopeValue === 2) { // Role
                roleField.classList.add('visible');
                departmentSelect.value = '';
            } else {
                // All - clear both
                departmentSelect.value = '';
                roleSelect.value = '';
            }
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            updateScopeFields();
        });
    </script>
}
