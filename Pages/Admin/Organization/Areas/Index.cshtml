@page
@model ShiftManager.Pages.Admin.Organization.Areas.IndexModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@{ Layout = "_Layout"; ViewData["Title"] = Localizer["Areas"]; }

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Admin"], Url = "/Admin/Users" },
    new BreadcrumbItem { Label = Localizer["Organization"], Url = "/Admin/Organization" },
    new BreadcrumbItem { Label = Localizer["Areas"], IsActive = true }
})

@section Styles {
    <style>
        .page-header { margin-bottom: 2rem; }
        .page-title { font-size: 2rem; font-weight: 700; color: var(--text); margin: 0 0 0.5rem 0; }
        .page-subtitle { font-size: 1rem; color: var(--text-muted); margin: 0; }
        .section-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; box-shadow: var(--shadow-sm); margin-bottom: 2rem; }
        .section-header { font-size: 1.125rem; font-weight: 600; color: var(--text); margin: 0 0 1.25rem 0; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border); }
        .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1rem; }
        .form-group { margin-bottom: 0; }
        .form-label { display: block; font-size: 0.875rem; font-weight: 500; color: var(--text-muted); margin-bottom: 0.5rem; }
        .form-label-required { color: var(--danger); }
        .form-input, .form-select { width: 100%; padding: 0.625rem 0.875rem; font-size: 0.9375rem; color: var(--text); background-color: var(--surface-soft); border: 1px solid var(--border); border-radius: 8px; }
        .btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.625rem 1.25rem; border: 1px solid var(--border); border-radius: 8px; font-size: 0.875rem; font-weight: 500; cursor: pointer; transition: all 0.15s ease; }
        .btn-primary { background: var(--primary); color: var(--primary-contrast); border-color: var(--primary); }
        .btn-danger { background: var(--danger); color: var(--danger-text); border-color: var(--danger); font-size: 0.8125rem; padding: 0.5rem 1rem; }
        .btn-ghost { background: transparent; color: var(--text); border-color: transparent; font-size: 0.8125rem; padding: 0.5rem 1rem; }
        .data-table { width: 100%; border-collapse: collapse; }
        .data-table th, .data-table td { padding: 0.875rem; text-align: start; }
        .data-table thead tr { border-bottom: 2px solid var(--border); }
        .data-table th { font-size: 0.8125rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; }
        .data-table tbody tr { border-bottom: 1px solid var(--border); }
        .data-table tbody tr:hover { background: var(--surface-soft); }
        .table-actions { display: flex; gap: 0.5rem; }
        .badge { display: inline-flex; padding: 0.25rem 0.5rem; border-radius: 9999px; font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; }
        .badge-active { background: var(--success-soft); color: var(--success) !important; }
        .badge-inactive { background: var(--surface-soft); color: var(--text-muted) !important; }
        .empty-state { text-align: center; padding: 3rem; color: var(--text-muted); }
    </style>
}

<div class="page-header">
    <h1 class="page-title"><loc key="ManageAreas" /></h1>
    <p class="page-subtitle"><loc key="CreateAndManageAreas" /></p>
</div>


<div class="section-card">
    <h3 class="section-header"><loc key="CreateNewArea" /></h3>
    @if (Model.AvailableProjects.Any())
    {
        <form method="post" asp-page-handler="Create">
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">@Localizer["Project"] <span class="form-label-required">*</span></label>
                    <select class="form-select" asp-for="SelectedProjectId" required>
                        <option value="">@Localizer["SelectProject"]</option>
                        @foreach (var p in Model.AvailableProjects) { <option value="@p.Id">@p.Name</option> }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">@Localizer["Name"] <span class="form-label-required">*</span></label>
                    <input class="form-input" asp-for="AreaName" loc-placeholder="Placeholder_AreaKey" required />
                </div>
                <div class="form-group">
                    <label class="form-label">@Localizer["DisplayName"]</label>
                    <input class="form-input" asp-for="AreaDisplayName" placeholder="@Localizer["Placeholder_AreaName"]" />
                </div>
            </div>
            <button class="btn btn-primary" type="submit"><loc key="CreateArea" /></button>
        </form>
    }
    else { <p class="empty-state"><loc key="NoProjectsAvailable" /></p> }
</div>

<div class="section-card">
    <h3 class="section-header"><loc key="AllAreas" /> (@Model.Areas.Count)</h3>
    @if (Model.Areas.Any())
    {
        <table class="data-table">
            <thead><tr><th><loc key="Project" /></th><th><loc key="Name" /></th><th><loc key="Molecules" /></th><th><loc key="JobTypes" /></th><th><loc key="Status" /></th><th style="width:1%"><loc key="Actions" /></th></tr></thead>
            <tbody>
            @foreach (var a in Model.Areas)
            {
                <tr>
                    <td>@(a.ProjectName)</td>
                    <td><strong>@(a.DisplayName)</strong><br /><small style="color: var(--text-muted);">@(a.Name)</small></td>
                    <td>@a.MoleculeCount</td>
                    <td>@a.JobTypeCount</td>
                    <td>@if (a.IsActive) { <span class="badge badge-active"><loc key="Active" /></span> } else { <span class="badge badge-inactive"><loc key="Inactive" /></span> }</td>
                    <td>
                        <div class="table-actions">
                            <button type="button" class="btn btn-ghost"
                                    onclick="openRenameModal(@a.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(a.Name))', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(a.DisplayName))')">
                                @Localizer["Edit"]
                            </button>
                            <form method="post" asp-page-handler="ToggleActive" style="display:inline"><input type="hidden" name="id" value="@a.Id" /><button type="submit" class="btn btn-ghost">@(a.IsActive ? Localizer["Deactivate"] : Localizer["Activate"])</button></form>
                            @if (a.MoleculeCount == 0 && a.JobTypeCount == 0) { <form method="post" asp-page-handler="Delete" style="display:inline" data-confirm-modal data-confirm-title="@Localizer["ConfirmDeleteArea_Title"]" data-confirm-message="@Localizer["ConfirmDeleteArea"]" data-confirm-action="@Localizer["Delete"]" data-confirm-level="danger"><input type="hidden" name="id" value="@a.Id" /><button type="submit" class="btn btn-danger"><loc key="Delete" /></button></form> }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
    else { <p class="empty-state"><loc key="NoAreasYet" /></p> }
</div>

<!-- Rename Modal -->
<div id="renameOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.4); z-index:1000; align-items:flex-start; justify-content:center; padding-top:15vh;"
     onclick="if(event.target===this) closeRenameModal()">
    <div class="section-card" style="max-width:480px; width:100%; margin:0 1rem;">
        <h3 class="section-header"><loc key="RenameArea" /></h3>
        <form method="post" asp-page-handler="Rename">
            <input type="hidden" asp-for="EditId" id="renameId" />
            <div class="form-group" style="margin-bottom:1rem;">
                <label class="form-label">@Localizer["Name"] <span class="form-label-required">*</span></label>
                <input class="form-input" asp-for="EditName" id="renameName" required />
            </div>
            <div class="form-group" style="margin-bottom:1rem;">
                <label class="form-label">@Localizer["DisplayName"]</label>
                <input class="form-input" asp-for="EditDisplayName" id="renameDisplayName" />
            </div>
            <div style="display:flex; gap:0.5rem; justify-content:flex-end;">
                <button type="button" class="btn btn-ghost" onclick="closeRenameModal()">@Localizer["Cancel"]</button>
                <button type="submit" class="btn btn-primary">@Localizer["Save"]</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
function openRenameModal(id, name, displayName) {
    document.getElementById('renameId').value = id;
    document.getElementById('renameName').value = name;
    document.getElementById('renameDisplayName').value = displayName;
    var overlay = document.getElementById('renameOverlay');
    overlay.style.display = 'flex';
    document.getElementById('renameName').focus();
}
function closeRenameModal() {
    document.getElementById('renameOverlay').style.display = 'none';
}
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeRenameModal();
});
</script>
}
