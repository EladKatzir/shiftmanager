@page
@model ShiftManager.Pages.Admin.Organization.Stores.IndexModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["ManageStores"];
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Admin"], Url = "/Admin/Users" },
    new BreadcrumbItem { Label = Localizer["Organization"], Url = "/Admin/Organization" },
    new BreadcrumbItem { Label = Localizer["ManageStores"], IsActive = true }
})

<div class="page-header">
    <h1 class="page-title"><loc key="ManageStores" /></h1>
</div>

@if (!string.IsNullOrEmpty(Model.Success))
{
    <div class="alert-success"><span>&#10003;</span><span>@(Model.Success)</span></div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert-error"><span>&#10007;</span><span>@(Model.Error)</span></div>
}

@if (Model.AvailableAreas.Any())
{
    <div class="section-card">
        <h3 class="section-header"><loc key="CreateNewStore" /></h3>

        <form method="post" asp-page-handler="Create">
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">@Localizer["StoreNameEn"] <span class="form-label-required">*</span></label>
                    <input class="form-input" asp-for="NewStoreName" placeholder="@Localizer["StoreNameEn"]" required maxlength="100" />
                </div>
                <div class="form-group">
                    <label class="form-label">@Localizer["StoreNameHe"]</label>
                    <input class="form-input" asp-for="NewStoreNameHe" placeholder="@Localizer["StoreNameHe"]" maxlength="100" dir="rtl" />
                </div>
                <div class="form-group">
                    <label class="form-label">@Localizer["StoreArea"] <span class="form-label-required">*</span></label>
                    <select class="form-select" asp-for="NewStoreAreaId" required>
                        <option value="">--</option>
                        @foreach (var area in Model.AvailableAreas)
                        {
                            <option value="@area.Id">@area.Name</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">@Localizer["SortOrder"]</label>
                    <input class="form-input" type="number" asp-for="NewStoreSortOrder" value="0" min="0" />
                </div>
            </div>
            <button class="btn btn-primary" type="submit"><loc key="CreateNewStore" /></button>
        </form>
    </div>
}
else
{
    <div class="section-card">
        <p class="empty-state"><loc key="NoStoresFound" /></p>
    </div>
}

<div class="section-card">
    <h3 class="section-header"><loc key="AllStores" /> (@Model.Stores.Count)</h3>
    @if (Model.Stores.Any())
    {
        <div style="overflow-x: auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th><loc key="StoreNameEn" /></th>
                        <th><loc key="StoreNameHe" /></th>
                        <th><loc key="StoreArea" /></th>
                        <th><loc key="SortOrder" /></th>
                        <th><loc key="Status" /></th>
                        <th><loc key="StoreHours" /></th>
                        <th style="width:1%"><loc key="Actions" /></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var store in Model.Stores)
                {
                    <tr id="row-@store.Id">
                        <td><strong>@store.NameEn</strong></td>
                        <td dir="rtl">@(store.NameHe ?? "-")</td>
                        <td>@store.AreaName</td>
                        <td>@store.SortOrder</td>
                        <td>
                            @if (store.IsActive)
                            {
                                <span class="badge badge-active"><loc key="Active" /></span>
                            }
                            else
                            {
                                <span class="badge badge-inactive"><loc key="Inactive" /></span>
                            }
                        </td>
                        <td>
                            @{
                                var totalWindows = store.HoursByDay.Sum(d => d.Entries.Count);
                                var daysWithHours = store.HoursByDay.Count(d => d.Entries.Any());
                            }
                            @if (totalWindows > 0)
                            {
                                <span class="hours-summary">@totalWindows windows / @daysWithHours days</span>
                            }
                            else
                            {
                                <span class="hours-summary" style="color: var(--text-muted);">-</span>
                            }
                        </td>
                        <td>
                            <div class="table-actions">
                                <button type="button" class="btn btn-ghost js-edit-toggle" data-target="edit-@store.Id">
                                    @Localizer["Edit"]
                                </button>
                                <button type="button" class="btn btn-ghost js-hours-toggle" data-target="hours-@store.Id">
                                    @Localizer["StoreHours"]
                                </button>
                                <form method="post" asp-page-handler="Delete" style="display:inline">
                                    <input type="hidden" name="storeId" value="@store.Id" />
                                    <button type="submit" class="btn btn-danger"
                                            onclick="return confirm('@Localizer["Confirm"].Value');">
                                        @Localizer["Delete"]
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    <!-- Edit row -->
                    <tr class="edit-row" id="edit-@store.Id">
                        <td colspan="7">
                            <form method="post" asp-page-handler="Update">
                                <input type="hidden" name="storeId" value="@store.Id" />
                                <div class="edit-form-grid">
                                    <div class="form-group">
                                        <label class="form-label">@Localizer["StoreNameEn"]</label>
                                        <input class="form-input" name="nameEn" value="@store.NameEn" required maxlength="100" />
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">@Localizer["StoreNameHe"]</label>
                                        <input class="form-input" name="nameHe" value="@store.NameHe" maxlength="100" dir="rtl" />
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">@Localizer["SortOrder"]</label>
                                        <input class="form-input" type="number" name="sortOrder" value="@store.SortOrder" min="0" />
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">@Localizer["Status"]</label>
                                        <select class="form-select" name="isActive">
                                            <option value="true" selected="@store.IsActive">@Localizer["Active"]</option>
                                            <option value="false" selected="@(!store.IsActive)">@Localizer["Inactive"]</option>
                                        </select>
                                    </div>
                                    <div class="form-group" style="align-self: end;">
                                        <button type="submit" class="btn btn-primary">@Localizer["Save"]</button>
                                        <button type="button" class="btn btn-ghost js-edit-cancel" data-target="edit-@store.Id">@Localizer["Cancel"]</button>
                                    </div>
                                </div>
                            </form>
                        </td>
                    </tr>
                    <!-- Hours editor row -->
                    <tr class="hours-row" id="hours-@store.Id">
                        <td colspan="7">
                            <div class="hours-editor">
                                <div class="hours-day-tabs">
                                    @for (int d = 0; d < 7; d++)
                                    {
                                        var dayGroup = store.HoursByDay[d];
                                        var hasEntries = dayGroup.Entries.Any();
                                        <button type="button"
                                                class="hours-day-tab @(d == 0 ? "active" : "")"
                                                data-store="@store.Id"
                                                data-day="@d"
                                                onclick="selectDay(@store.Id, @d)">
                                            @dayGroup.DayName.Substring(0, 3)
                                            @if (hasEntries)
                                            {
                                                <span class="day-dot"></span>
                                            }
                                        </button>
                                    }
                                </div>

                                @for (int d = 0; d < 7; d++)
                                {
                                    var dayGroup = store.HoursByDay[d];
                                    <div class="hours-day-panel" id="day-panel-@store.Id-@d" style="display: @(d == 0 ? "block" : "none");">
                                        <div class="time-windows" id="windows-@store.Id-@d">
                                            @if (dayGroup.Entries.Any())
                                            {
                                                @foreach (var entry in dayGroup.Entries)
                                                {
                                                    <div class="time-window">
                                                        <input type="time" class="form-input tw-open" value="@entry.OpenTime" />
                                                        <span class="tw-separator">-</span>
                                                        <input type="time" class="form-input tw-close" value="@entry.CloseTime" />
                                                        <button type="button" class="btn btn-ghost btn-remove-window" onclick="removeTimeWindow(this)">&#10005;</button>
                                                    </div>
                                                }
                                            }
                                        </div>
                                        <button type="button" class="btn btn-ghost btn-add-window" onclick="addTimeWindow(@store.Id, @d)">
                                            + @Localizer["AddTimeWindow"]
                                        </button>
                                    </div>
                                }

                                <div class="hours-actions">
                                    <form method="post" asp-page-handler="SetHours" style="display:inline">
                                        <input type="hidden" name="storeId" value="@store.Id" />
                                        <input type="hidden" name="hoursJson" id="hoursJson-@store.Id" value="[]" />
                                        <button type="submit" class="btn btn-primary" onclick="return prepareHoursSubmit(@store.Id);">
                                            @Localizer["Save"] @Localizer["StoreHours"]
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-ghost js-hours-cancel" data-target="hours-@store.Id">@Localizer["Cancel"]</button>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="empty-state"><loc key="NoStoresFound" /></p>
    }
</div>

@section Styles {
    <style>
        .page-header { margin-bottom: 2rem; }
        .page-title { font-size: 2rem; font-weight: 700; color: var(--text); margin: 0 0 0.5rem 0; }

        .alert-success, .alert-error {
            padding: 1rem 1.25rem; border-radius: 10px; margin-bottom: 1.5rem;
            display: flex; align-items: center; gap: 0.75rem; font-size: 0.9375rem; font-weight: 500;
        }
        .alert-success { background: var(--success); color: var(--success-text); border: 1px solid rgba(16, 185, 129, 0.3); }
        .alert-error { background: var(--danger); color: var(--danger-text); border: 1px solid rgba(244, 67, 54, 0.3); }

        .section-card {
            background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
            padding: 1.5rem; box-shadow: var(--shadow-sm); margin-bottom: 2rem;
        }
        .section-header { font-size: 1.125rem; font-weight: 600; color: var(--text);
            margin: 0 0 1.25rem 0; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border); }

        .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 1rem; }
        .form-group { margin-bottom: 0; }
        .form-label { display: block; font-size: 0.875rem; font-weight: 500; color: var(--text-muted); margin-bottom: 0.5rem; }
        .form-label-required { color: var(--danger); }
        .form-input, .form-select {
            width: 100%; padding: 0.625rem 0.875rem; font-size: 0.9375rem; color: var(--text);
            background-color: var(--surface-soft); border: 1px solid var(--border); border-radius: 8px; transition: all 0.15s ease;
        }
        .form-input:focus, .form-select:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1); }

        .btn {
            display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
            padding: 0.625rem 1.25rem; border: 1px solid var(--border); border-radius: 8px;
            font-size: 0.875rem; font-weight: 500; cursor: pointer; transition: all 0.15s ease; text-decoration: none;
        }
        .btn-primary { background: var(--primary); color: var(--primary-contrast) !important; border-color: var(--primary); }
        .btn-primary:hover { background: var(--primary-hover); transform: translateY(-1px); }
        .btn-danger { background: var(--danger); color: var(--danger-text); border-color: var(--danger); font-size: 0.8125rem; padding: 0.5rem 1rem; }
        .btn-ghost { background: transparent; color: var(--text); border-color: transparent; font-size: 0.8125rem; padding: 0.5rem 1rem; }
        .btn-ghost:hover { background: var(--surface-soft); border-color: var(--border); }

        .data-table { width: 100%; border-collapse: collapse; }
        .data-table thead tr { border-bottom: 2px solid var(--border); }
        .data-table th { padding: 0.875rem; text-align: start; font-size: 0.8125rem; font-weight: 600;
            color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.025em; }
        .data-table tbody tr { border-bottom: 1px solid var(--border); transition: background-color 0.15s ease; }
        .data-table tbody tr:hover { background: var(--surface-soft); }
        .data-table td { padding: 1rem 0.875rem; font-size: 0.9375rem; color: var(--text); }
        .table-actions { display: flex; gap: 0.5rem; white-space: nowrap; }

        .badge {
            display: inline-flex; align-items: center; padding: 0.25rem 0.5rem; border-radius: 9999px;
            font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.025em;
        }
        .badge-inactive { background: var(--surface-soft); color: var(--text-muted); }
        .badge-active { background: var(--success-soft); color: var(--success); }

        .empty-state { text-align: center; padding: 3rem 2rem; color: var(--text-muted); }

        .edit-row { display: none; }
        .edit-row.active { display: table-row; }
        .edit-row td { background: var(--surface-soft); }
        .edit-form-grid { display: flex; gap: 0.75rem; align-items: end; flex-wrap: wrap; }
        .edit-form-grid .form-group { margin-bottom: 0; min-width: 140px; }
        .edit-form-grid .form-input, .edit-form-grid .form-select { padding: 0.5rem 0.75rem; font-size: 0.875rem; }

        /* Hours editor styles */
        .hours-row { display: none; }
        .hours-row.active { display: table-row; }
        .hours-row td { background: var(--surface-soft); }

        .hours-editor { padding: 0.5rem 0; }

        .hours-day-tabs { display: flex; gap: 0.25rem; margin-bottom: 1rem; flex-wrap: wrap; }
        .hours-day-tab {
            position: relative; padding: 0.5rem 0.875rem; border: 1px solid var(--border); border-radius: 8px;
            background: var(--surface); color: var(--text); font-size: 0.8125rem; font-weight: 500;
            cursor: pointer; transition: all 0.15s ease;
        }
        .hours-day-tab:hover { background: var(--surface-soft); }
        .hours-day-tab.active { background: var(--primary); color: var(--primary-contrast) !important; border-color: var(--primary); }
        .day-dot {
            position: absolute; top: 4px; right: 4px; width: 6px; height: 6px;
            background: var(--success); border-radius: 50%;
        }
        .hours-day-tab.active .day-dot { background: var(--primary-contrast); }

        .hours-day-panel { padding: 0.5rem 0; }

        .time-windows { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 0.75rem; }
        .time-window {
            display: flex; align-items: center; gap: 0.5rem;
        }
        .time-window .form-input { width: auto; min-width: 120px; max-width: 150px; padding: 0.5rem 0.75rem; font-size: 0.875rem; }
        .tw-separator { color: var(--text-muted); font-weight: 500; }
        .btn-remove-window { color: var(--danger); padding: 0.375rem 0.625rem; font-size: 0.875rem; }
        .btn-add-window { color: var(--primary); font-size: 0.8125rem; }

        .hours-actions { margin-top: 1rem; display: flex; gap: 0.75rem; align-items: center;
            padding-top: 0.75rem; border-top: 1px solid var(--border); }

        .hours-summary { font-size: 0.8125rem; color: var(--text-muted); }

        @@media (max-width: 768px) {
            .page-title { font-size: 1.75rem; }
            .form-grid { grid-template-columns: 1fr; }
            .table-actions { flex-direction: column; }
            .edit-form-grid { flex-direction: column; }
            .hours-day-tabs { gap: 0.125rem; }
            .hours-day-tab { padding: 0.375rem 0.5rem; font-size: 0.75rem; }
            .time-window .form-input { min-width: 100px; }
        }
    </style>
}

@section Scripts {
    <script>
    (function() {
        'use strict';

        // Toggle edit row
        document.addEventListener('click', function(e) {
            var toggleBtn = e.target.closest('.js-edit-toggle');
            if (toggleBtn) {
                var targetId = toggleBtn.getAttribute('data-target');
                var editRow = document.getElementById(targetId);
                if (editRow) {
                    editRow.classList.toggle('active');
                }
                return;
            }

            var cancelBtn = e.target.closest('.js-edit-cancel');
            if (cancelBtn) {
                var targetId = cancelBtn.getAttribute('data-target');
                var editRow = document.getElementById(targetId);
                if (editRow) {
                    editRow.classList.remove('active');
                }
                return;
            }

            // Toggle hours editor row
            var hoursToggle = e.target.closest('.js-hours-toggle');
            if (hoursToggle) {
                var targetId = hoursToggle.getAttribute('data-target');
                var hoursRow = document.getElementById(targetId);
                if (hoursRow) {
                    hoursRow.classList.toggle('active');
                }
                return;
            }

            var hoursCancel = e.target.closest('.js-hours-cancel');
            if (hoursCancel) {
                var targetId = hoursCancel.getAttribute('data-target');
                var hoursRow = document.getElementById(targetId);
                if (hoursRow) {
                    hoursRow.classList.remove('active');
                }
                return;
            }
        });

        // Day tab selection — exposed globally for onclick
        window.selectDay = function(storeId, day) {
            // Update tab active state
            var tabs = document.querySelectorAll('.hours-day-tab[data-store="' + storeId + '"]');
            tabs.forEach(function(tab) {
                tab.classList.toggle('active', parseInt(tab.getAttribute('data-day')) === day);
            });

            // Show/hide day panels
            for (var d = 0; d < 7; d++) {
                var panel = document.getElementById('day-panel-' + storeId + '-' + d);
                if (panel) {
                    panel.style.display = (d === day) ? 'block' : 'none';
                }
            }
        };

        // Add time window — exposed globally for onclick
        window.addTimeWindow = function(storeId, dayOfWeek) {
            var container = document.getElementById('windows-' + storeId + '-' + dayOfWeek);
            if (!container) return;

            var row = document.createElement('div');
            row.className = 'time-window';
            row.innerHTML =
                '<input type="time" class="form-input tw-open" value="08:00" />' +
                '<span class="tw-separator">-</span>' +
                '<input type="time" class="form-input tw-close" value="17:00" />' +
                '<button type="button" class="btn btn-ghost btn-remove-window" onclick="removeTimeWindow(this)">&#10005;</button>';
            container.appendChild(row);

            // Update the dot indicator on the tab
            updateDayDot(storeId, dayOfWeek);
        };

        // Remove time window — exposed globally for onclick
        window.removeTimeWindow = function(btn) {
            var windowEl = btn.closest('.time-window');
            if (!windowEl) return;

            var container = windowEl.parentElement;
            windowEl.remove();

            // Parse storeId and day from container id (format: windows-{storeId}-{day})
            var parts = container.id.split('-');
            if (parts.length >= 3) {
                var storeId = parseInt(parts[1]);
                var day = parseInt(parts[2]);
                updateDayDot(storeId, day);
            }
        };

        // Prepare hours JSON for form submission — exposed globally for onclick
        window.prepareHoursSubmit = function(storeId) {
            var entries = [];

            for (var d = 0; d < 7; d++) {
                var container = document.getElementById('windows-' + storeId + '-' + d);
                if (!container) continue;

                var windows = container.querySelectorAll('.time-window');
                windows.forEach(function(win) {
                    var openInput = win.querySelector('.tw-open');
                    var closeInput = win.querySelector('.tw-close');
                    if (openInput && closeInput && openInput.value && closeInput.value) {
                        entries.push({
                            dayOfWeek: d,
                            openTime: openInput.value,
                            closeTime: closeInput.value,
                            isActive: true
                        });
                    }
                });
            }

            var hiddenInput = document.getElementById('hoursJson-' + storeId);
            if (hiddenInput) {
                hiddenInput.value = JSON.stringify(entries);
            }

            return true; // Allow form submission
        };

        function updateDayDot(storeId, day) {
            var container = document.getElementById('windows-' + storeId + '-' + day);
            var tab = document.querySelector('.hours-day-tab[data-store="' + storeId + '"][data-day="' + day + '"]');
            if (!container || !tab) return;

            var hasWindows = container.querySelectorAll('.time-window').length > 0;
            var dot = tab.querySelector('.day-dot');

            if (hasWindows && !dot) {
                dot = document.createElement('span');
                dot.className = 'day-dot';
                tab.appendChild(dot);
            } else if (!hasWindows && dot) {
                dot.remove();
            }
        }
    })();
    </script>
}
