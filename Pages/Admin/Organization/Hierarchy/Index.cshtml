@page
@model ShiftManager.Pages.Admin.Organization.Hierarchy.IndexModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@using ShiftManager.Models
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["Owner_Hierarchy"];
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Admin"], Url = "/Admin/Users" },
    new BreadcrumbItem { Label = Localizer["Organization"], Url = "/Admin/Organization" },
    new BreadcrumbItem { Label = Localizer["Hierarchy"], IsActive = true }
})

<div class="hierarchy-container">
    <div class="page-header">
        <div class="page-header__main">
            <h1>
                <span class="page-icon">🏛️</span>
                <loc key="Owner_Hierarchy" />
            </h1>
            <p class="page-subtitle"><loc key="Owner_Hierarchy_Desc" /></p>
        </div>
        <div class="page-header__actions">
            @* Expand/Collapse now handled by HierarchyTree component toolbar *@
        </div>
    </div>

    <!-- Stats Summary -->
    <div class="stats-bar">
        <div class="stat-pill">
            <span class="stat-pill__icon">📁</span>
            <span class="stat-pill__value">@Model.TotalProjects</span>
            <span class="stat-pill__label"><loc key="Projects" /></span>
        </div>
        <div class="stat-pill">
            <span class="stat-pill__icon">🗂️</span>
            <span class="stat-pill__value">@Model.TotalAreas</span>
            <span class="stat-pill__label"><loc key="Areas" /></span>
        </div>
        <div class="stat-pill">
            <span class="stat-pill__icon">⚛️</span>
            <span class="stat-pill__value">@Model.TotalMolecules</span>
            <span class="stat-pill__label"><loc key="Molecules" /></span>
        </div>
        <div class="stat-pill">
            <span class="stat-pill__icon">🏢</span>
            <span class="stat-pill__value">@Model.TotalCompanies</span>
            <span class="stat-pill__label"><loc key="Companies" /></span>
        </div>
    </div>

    <!-- Quick Links -->
    <div class="quick-links">
        <a href="/Admin/Organization/Projects" class="quick-link">
            <span>📁</span> <loc key="ManageProjects" />
        </a>
        <a href="/Admin/Organization/Areas" class="quick-link">
            <span>🗂️</span> <loc key="ManageAreas" />
        </a>
        <a href="/Admin/Organization/Molecules" class="quick-link">
            <span>⚛️</span> <loc key="ManageMolecules" />
        </a>
        <a href="/Admin/Companies" class="quick-link">
            <span>🏢</span> <loc key="ManageCompanies" />
        </a>
    </div>

    <!-- Hierarchy Tree Component (with drag-drop) -->
    <div class="section-card">
        <div class="section-header">
            <h2><loc key="HierarchyTree" /></h2>
        </div>

        @await Component.InvokeAsync("HierarchyTree", new { mode = "full", expandedByDefault = true })
    </div>

    <!-- Legacy Quick Links -->
    <div class="section-card">
        <div class="section-header">
            <h2><loc key="ManageEntities" /></h2>
        </div>
        <div class="quick-links">
            <a href="/Admin/Organization/Projects" class="quick-link">
                <span>P</span> <loc key="ManageProjects" />
            </a>
            <a href="/Admin/Organization/Areas" class="quick-link">
                <span>A</span> <loc key="ManageAreas" />
            </a>
            <a href="/Admin/Organization/Molecules" class="quick-link">
                <span>M</span> <loc key="ManageMolecules" />
            </a>
            <a href="/Admin/Companies" class="quick-link">
                <span>C</span> <loc key="ManageCompanies" />
            </a>
        </div>
    </div>
</div>

@* Toggle script moved to HierarchyTree component *@

<style>
.hierarchy-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
}

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
}

.page-header h1 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.5rem 0;
    font-size: 2rem;
}

.page-icon {
    font-size: 2.5rem;
}

.page-subtitle {
    color: var(--text-muted);
    margin: 0;
}

.stats-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
}

.stat-pill {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 9999px;
}

.stat-pill__icon {
    font-size: 1rem;
}

.stat-pill__value {
    font-weight: 700;
    color: var(--primary);
}

.stat-pill__label {
    color: var(--text-muted);
    font-size: 0.875rem;
}

.quick-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
}

.quick-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--primary-soft);
    color: var(--primary);
    border-radius: 8px;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.2s;
}

.quick-link:hover {
    background: var(--primary);
    color: var(--primary-contrast);
}

.section-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
}

.section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--border);
}

.section-header h2 {
    margin: 0;
    font-size: 1.125rem;
}

.btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
    border: 1px solid var(--border);
}

.btn-primary {
    background: var(--primary);
    color: var(--primary-contrast);
    border-color: var(--primary);
}

.btn-secondary {
    background: var(--surface);
    color: var(--text);
}

.btn:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
}

/* Tree styles moved to HierarchyTree component */
.section-card + .section-card {
    margin-top: 1.5rem;
}

@@media (max-width: 768px) {
    .hierarchy-container {
        padding: 1rem;
    }

    .page-header {
        flex-direction: column;
    }

    .page-header h1 {
        font-size: 1.5rem;
    }

    .stats-bar {
        flex-wrap: wrap;
    }
}
</style>
