@page
@model ShiftManager.Pages.Admin.Organization.ShiftGroupings.IndexModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["ShiftGroupings"];
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Admin"], Url = "/Admin/Users" },
    new BreadcrumbItem { Label = Localizer["Organization"], Url = "/Admin/Organization" },
    new BreadcrumbItem { Label = Localizer["ShiftGroupings"], IsActive = true }
})

@section Styles {
    <style>
        .page-header { margin-bottom: 2rem; }
        .page-title { font-size: 2rem; font-weight: 700; color: var(--text); margin: 0 0 0.5rem 0; }
        .page-subtitle { font-size: 1rem; color: var(--text-muted); margin: 0; }

        .section-card {
            background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
            padding: 1.5rem; box-shadow: var(--shadow-sm); margin-bottom: 2rem;
        }
        .section-header { font-size: 1.125rem; font-weight: 600; color: var(--text);
            margin: 0 0 1.25rem 0; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border); }

        .info-box { padding: 1rem; background: var(--surface-soft); border-left: 4px solid var(--primary);
            border-radius: 8px; margin-bottom: 1.5rem; font-size: 0.875rem; color: var(--text-muted); }

        .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1rem; }
        .form-group { margin-bottom: 1rem; }
        .form-label { display: block; font-size: 0.875rem; font-weight: 500; color: var(--text-muted); margin-bottom: 0.5rem; }
        .form-label-required { color: var(--danger); }
        .form-input, .form-select {
            width: 100%; padding: 0.625rem 0.875rem; font-size: 0.9375rem; color: var(--text);
            background-color: var(--surface-soft); border: 1px solid var(--border); border-radius: 8px; transition: all 0.15s ease;
        }
        .form-input:focus, .form-select:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1); }
        .form-select[multiple] { height: auto; min-height: 100px; }
        .form-hint { font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem; }

        .btn {
            display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
            padding: 0.625rem 1.25rem; border: 1px solid var(--border); border-radius: 8px;
            font-size: 0.875rem; font-weight: 500; cursor: pointer; transition: all 0.15s ease; text-decoration: none;
        }
        .btn-primary { background: var(--primary); color: var(--primary-contrast); border-color: var(--primary); }
        .btn-primary:hover { background: var(--primary-hover); transform: translateY(-1px); }
        .btn-danger { background: var(--danger); color: var(--danger-text); border-color: var(--danger); font-size: 0.8125rem; padding: 0.5rem 1rem; }
        .btn-ghost { background: transparent; color: var(--text); border-color: transparent; font-size: 0.8125rem; padding: 0.5rem 1rem; }
        .btn-ghost:hover { background: var(--surface-soft); border-color: var(--border); }

        .data-table { width: 100%; border-collapse: collapse; }
        .data-table thead tr { border-bottom: 2px solid var(--border); }
        .data-table th { padding: 0.875rem; text-align: start; font-size: 0.8125rem; font-weight: 600;
            color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.025em; }
        .data-table tbody tr { border-bottom: 1px solid var(--border); transition: background-color 0.15s ease; }
        .data-table tbody tr:hover { background: var(--surface-soft); }
        .data-table td { padding: 1rem 0.875rem; font-size: 0.9375rem; color: var(--text); }
        .table-actions { display: flex; gap: 0.5rem; white-space: nowrap; }

        .badge {
            display: inline-flex; align-items: center; padding: 0.25rem 0.5rem; border-radius: 9999px;
            font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.025em;
        }
        .badge-inactive { background: var(--surface-soft); color: var(--text-muted) !important; }
        .badge-active { background: var(--success-soft); color: var(--success) !important; }
        .badge-count { background: var(--primary-soft); color: var(--primary) !important; }

        .empty-state { text-align: center; padding: 3rem 2rem; color: var(--text-muted); }

        @@media (max-width: 768px) {
            .page-title { font-size: 1.75rem; }
            .form-grid { grid-template-columns: 1fr; }
            .table-actions { flex-direction: column; }
        }
    </style>
}

<div class="page-header">
    <h1 class="page-title"><loc key="ManageShiftGroupings" /></h1>
    <p class="page-subtitle"><loc key="CreateAndManageShiftGroupings" /></p>
</div>


<div class="section-card">
    <h3 class="section-header"><loc key="CreateNewShiftGrouping" /></h3>

    <div class="info-box">
        <loc key="ShiftGroupingsCombineCompaniesAndJobTypes" />
    </div>

    @if (Model.AvailableMolecules.Any())
    {
        <form method="post" asp-page-handler="Create">
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">@Localizer["Molecule"] <span class="form-label-required">*</span></label>
                    <select class="form-select" asp-for="SelectedMoleculeId" required>
                        <option value="">@Localizer["SelectMolecule"]</option>
                        @foreach (var m in Model.AvailableMolecules)
                        {
                            <option value="@m.Id">@m.AreaName - @m.Name</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">@Localizer["Name"] <span class="form-label-required">*</span></label>
                    <input class="form-input" asp-for="GroupingName" placeholder="grouping-key" required />
                </div>
                <div class="form-group">
                    <label class="form-label">@Localizer["DisplayName"]</label>
                    <input class="form-input" asp-for="GroupingDisplayName" placeholder="@Localizer["Placeholder_GroupingName"]" />
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">@Localizer["Companies"]</label>
                    <select class="form-select" asp-for="SelectedCompanyIds" multiple>
                        @foreach (var c in Model.AvailableCompanies)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                    <span class="form-hint"><loc key="HoldCtrlToSelectMultiple" /></span>
                </div>
                <div class="form-group">
                    <label class="form-label">@Localizer["JobTypes"]</label>
                    <select class="form-select" asp-for="SelectedJobTypeIds" multiple>
                        @foreach (var jt in Model.AvailableJobTypes)
                        {
                            <option value="@jt.Id">@jt.AreaName - @jt.Name</option>
                        }
                    </select>
                    <span class="form-hint"><loc key="HoldCtrlToSelectMultiple" /></span>
                </div>
            </div>

            <button class="btn btn-primary" type="submit"><loc key="CreateShiftGrouping" /></button>
        </form>
    }
    else
    {
        <p class="empty-state"><loc key="NoMoleculesAvailable" /></p>
    }
</div>

<div class="section-card">
    <h3 class="section-header"><loc key="AllShiftGroupings" /> (@Model.ShiftGroupings.Count)</h3>
    @if (Model.ShiftGroupings.Any())
    {
        <div style="overflow-x: auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th><loc key="Molecule" /></th>
                        <th><loc key="Grouping" /></th>
                        <th><loc key="Companies" /></th>
                        <th><loc key="JobTypes" /></th>
                        <th><loc key="Status" /></th>
                        <th style="width:1%"><loc key="Actions" /></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var sg in Model.ShiftGroupings)
                {
                    <tr>
                        <td>@(sg.MoleculeName)</td>
                        <td><strong>@(sg.DisplayName)</strong><br /><small style="color: var(--text-muted);">@(sg.Name)</small></td>
                        <td><span class="badge badge-count">@sg.CompanyCount</span></td>
                        <td><span class="badge badge-count">@sg.JobTypeCount</span></td>
                        <td>
                            @if (sg.IsActive)
                            {
                                <span class="badge badge-active"><loc key="Active" /></span>
                            }
                            else
                            {
                                <span class="badge badge-inactive"><loc key="Inactive" /></span>
                            }
                        </td>
                        <td>
                            <div class="table-actions">
                                <button type="button" class="btn btn-ghost"
                                        data-id="@sg.Id"
                                        data-name="@System.Web.HttpUtility.HtmlAttributeEncode(sg.Name)"
                                        data-display-name="@System.Web.HttpUtility.HtmlAttributeEncode(sg.DisplayName)"
                                        data-company-ids="@Json.Serialize(sg.CompanyIds)"
                                        data-jobtype-ids="@Json.Serialize(sg.JobTypeIds)"
                                        onclick="openEditModal(this)">
                                    @Localizer["Edit"]
                                </button>
                                <form method="post" asp-page-handler="ToggleActive" style="display:inline">
                                    <input type="hidden" name="id" value="@sg.Id" />
                                    <button type="submit" class="btn btn-ghost">
                                        @(sg.IsActive ? Localizer["Deactivate"] : Localizer["Activate"])
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="Delete" style="display:inline"
                                      data-confirm-modal
                                      data-confirm-title="@Localizer["ConfirmDeleteGrouping_Title"]"
                                      data-confirm-message="@Localizer["ConfirmDeleteGrouping"]"
                                      data-confirm-action="@Localizer["Delete"]"
                                      data-confirm-level="danger">
                                    <input type="hidden" name="id" value="@sg.Id" />
                                    <button type="submit" class="btn btn-danger"><loc key="Delete" /></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="empty-state"><loc key="NoShiftGroupingsYet" /></p>
    }
</div>

<!-- Edit Modal -->
<div id="editOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.4); z-index:1000; align-items:flex-start; justify-content:center; padding-top:10vh; overflow-y:auto;"
     onclick="if(event.target===this) closeEditModal()">
    <div class="section-card" style="max-width:520px; width:100%; margin:0 1rem 2rem;">
        <h3 class="section-header"><loc key="EditShiftGrouping" /></h3>
        <form method="post" asp-page-handler="Edit">
            <input type="hidden" asp-for="EditId" id="editId" />
            <div class="form-group" style="margin-bottom:1rem;">
                <label class="form-label">@Localizer["Name"] <span class="form-label-required">*</span></label>
                <input class="form-input" asp-for="EditName" id="editName" required />
            </div>
            <div class="form-group" style="margin-bottom:1rem;">
                <label class="form-label">@Localizer["DisplayName"]</label>
                <input class="form-input" asp-for="EditDisplayName" id="editDisplayName" />
            </div>
            <div class="form-group" style="margin-bottom:1rem;">
                <label class="form-label">@Localizer["Companies"]</label>
                <select class="form-select" name="EditCompanyIds" id="editCompanyIds" multiple>
                    @foreach (var c in Model.AvailableCompanies)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
                <span class="form-hint"><loc key="HoldCtrlToSelectMultiple" /></span>
            </div>
            <div class="form-group" style="margin-bottom:1rem;">
                <label class="form-label">@Localizer["JobTypes"]</label>
                <select class="form-select" name="EditJobTypeIds" id="editJobTypeIds" multiple>
                    @foreach (var jt in Model.AvailableJobTypes)
                    {
                        <option value="@jt.Id">@jt.AreaName - @jt.Name</option>
                    }
                </select>
                <span class="form-hint"><loc key="HoldCtrlToSelectMultiple" /></span>
            </div>
            <div style="display:flex; gap:0.5rem; justify-content:flex-end;">
                <button type="button" class="btn btn-ghost" onclick="closeEditModal()">@Localizer["Cancel"]</button>
                <button type="submit" class="btn btn-primary">@Localizer["Save"]</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
function openEditModal(btn) {
    document.getElementById('editId').value = btn.getAttribute('data-id');
    document.getElementById('editName').value = btn.getAttribute('data-name');
    document.getElementById('editDisplayName').value = btn.getAttribute('data-display-name');

    var companyIds = JSON.parse(btn.getAttribute('data-company-ids') || '[]');
    var jobTypeIds = JSON.parse(btn.getAttribute('data-jobtype-ids') || '[]');

    preselectOptions('editCompanyIds', companyIds);
    preselectOptions('editJobTypeIds', jobTypeIds);

    document.getElementById('editOverlay').style.display = 'flex';
    document.getElementById('editName').focus();
}

function preselectOptions(selectId, ids) {
    var select = document.getElementById(selectId);
    for (var i = 0; i < select.options.length; i++) {
        select.options[i].selected = ids.indexOf(parseInt(select.options[i].value)) !== -1;
    }
}

function closeEditModal() {
    document.getElementById('editOverlay').style.display = 'none';
}

document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeEditModal();
});
</script>
}
