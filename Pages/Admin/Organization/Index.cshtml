@page
@model ShiftManager.Pages.Admin.Organization.IndexModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@using ShiftManager.Models.Support
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["Organization"];
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Admin"], Url = "/Admin/Users" },
    new BreadcrumbItem { Label = Localizer["Organization"], IsActive = true }
})

@section Styles {
    <style>
        /* Page Header */
        .page-header {
            margin-bottom: 2rem;
        }

        .page-title {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text);
            margin: 0 0 0.5rem 0;
            line-height: 1.2;
        }

        .page-subtitle {
            font-size: 1rem;
            color: var(--text-muted);
            margin: 0;
            line-height: 1.5;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1.25rem;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            background: var(--primary-soft);
            color: var(--primary);
        }

        .stat-content {
            flex: 1;
        }

        .stat-value {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text);
            line-height: 1.2;
        }

        .stat-label {
            font-size: 0.875rem;
            color: var(--text-muted);
        }

        /* Section Card */
        .section-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: var(--shadow-sm);
            margin-bottom: 2rem;
        }

        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.25rem;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid var(--border);
        }

        .section-title {
            font-size: 1.125rem;
            font-weight: 600;
            color: var(--text);
            margin: 0;
        }

        /* Tree View */
        .hierarchy-tree {
            font-size: 0.9375rem;
        }

        .tree-node {
            position: relative;
            padding-left: 1.5rem;
        }

        .tree-node::before {
            content: '';
            position: absolute;
            left: 0.5rem;
            top: 0;
            bottom: 0;
            width: 1px;
            background: var(--border);
        }

        .tree-node:last-child::before {
            height: 1.25rem;
        }

        .tree-item {
            position: relative;
            padding: 0.5rem 0;
            padding-left: 1rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .tree-item::before {
            content: '';
            position: absolute;
            left: -1rem;
            top: 50%;
            width: 1rem;
            height: 1px;
            background: var(--border);
        }

        .tree-expand {
            width: 24px;
            height: 24px;
            border-radius: 4px;
            border: 1px solid var(--border);
            background: var(--surface);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.875rem;
            transition: all 0.15s ease;
        }

        .tree-expand:hover {
            background: var(--surface-soft);
            border-color: var(--primary);
        }

        .tree-expand.expanded {
            transform: rotate(90deg);
        }

        .tree-icon {
            width: 28px;
            height: 28px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
        }

        .tree-icon-project {
            background: var(--primary-soft);
            color: var(--primary);
        }

        .tree-icon-area {
            background: var(--success-soft);
            color: var(--success);
        }

        .tree-icon-molecule {
            background: var(--accent-soft);
            color: var(--accent);
        }

        .tree-icon-company {
            background: var(--warning-soft);
            color: var(--warning);
        }

        .tree-icon-department {
            background: var(--danger-soft);
            color: var(--danger);
        }

        .tree-label {
            font-weight: 500;
            color: var(--text);
        }

        .tree-meta {
            font-size: 0.8125rem;
            color: var(--text-muted);
        }

        .tree-children {
            display: none;
            margin-left: 1rem;
        }

        .tree-children.expanded {
            display: block;
        }

        /* Badge */
        .badge {
            display: inline-flex;
            align-items: center;
            padding: 0.25rem 0.5rem;
            border-radius: 9999px;
            font-size: 0.6875rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.025em;
        }

        .badge-workforce {
            background: var(--primary-soft);
            color: var(--primary);
        }

        .badge-tech {
            background: var(--accent-soft);
            color: var(--accent);
        }

        .badge-helper {
            background: var(--warning-soft);
            color: var(--warning);
        }

        .badge-inactive {
            background: var(--surface-soft);
            color: var(--text-muted);
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.15s ease;
            text-decoration: none;
            white-space: nowrap;
        }

        .btn-primary {
            background: var(--primary);
            color: var(--primary-contrast);
            border-color: var(--primary);
        }

        .btn-primary:hover {
            background: var(--primary-hover);
            border-color: var(--primary-hover);
            transform: translateY(-1px);
        }

        .btn-sm {
            padding: 0.375rem 0.75rem;
            font-size: 0.8125rem;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 3rem 2rem;
            color: var(--text-muted);
        }

        .empty-state-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

        .empty-state-text {
            font-size: 1rem;
            margin-bottom: 1.5rem;
        }

        /* Quick Actions */
        .quick-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        /* Unassigned Section */
        .unassigned-section {
            margin-top: var(--space-8);
            padding-top: var(--space-6);
            border-top: 1px solid var(--border);
        }

        .unassigned-section__header {
            font-size: var(--text-body);
            font-weight: var(--font-semibold);
            color: var(--text-muted);
            margin-bottom: var(--space-4);
        }

        .tree-node--root {
            padding-left: 0;
        }

        .tree-item--root {
            padding-left: 0;
        }

        .tree-spacer {
            display: inline-block;
            width: 24px;
        }

        /* Message Banner */
        .message-banner {
            padding: 0.75rem 1rem;
            border-radius: 8px;
            font-size: 0.875rem;
            font-weight: 500;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .message-banner--success {
            background: var(--success-soft);
            color: var(--success);
            border: 1px solid var(--success);
        }

        .message-banner--error {
            background: var(--danger-soft);
            color: var(--danger);
            border: 1px solid var(--danger);
        }

        .message-banner__close {
            margin-inline-start: auto;
            background: none;
            border: none;
            cursor: pointer;
            font-size: 1.125rem;
            line-height: 1;
            color: inherit;
            opacity: 0.7;
            padding: 0.25rem;
        }

        .message-banner__close:hover {
            opacity: 1;
        }

        /* Tree Item Action Buttons */
        .tree-item-actions {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            margin-inline-start: auto;
            opacity: 0;
            transition: opacity 0.15s ease;
        }

        .tree-item:hover .tree-item-actions {
            opacity: 1;
        }

        .tree-action-btn {
            width: 28px;
            height: 28px;
            border-radius: 6px;
            border: 1px solid transparent;
            background: transparent;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8125rem;
            color: var(--text-muted);
            transition: all 0.15s ease;
            padding: 0;
        }

        .tree-action-btn:hover {
            background: var(--surface-soft);
            border-color: var(--border);
            color: var(--text);
        }

        .tree-action-btn--danger:hover {
            background: var(--danger-soft);
            border-color: var(--danger);
            color: var(--danger);
        }

        .tree-action-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        .tree-action-btn:disabled:hover {
            background: transparent;
            border-color: transparent;
            color: var(--text-muted);
        }

        /* Add Entity Button (inline in tree) */
        .tree-add-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.25rem 0.625rem;
            margin-top: 0.25rem;
            margin-inline-start: 2.5rem;
            border: 1px dashed var(--border);
            border-radius: 6px;
            background: transparent;
            cursor: pointer;
            font-size: 0.8125rem;
            font-weight: 500;
            color: var(--text-muted);
            transition: all 0.15s ease;
        }

        .tree-add-btn:hover {
            border-color: var(--primary);
            color: var(--primary);
            background: var(--primary-soft);
        }

        /* Modal Overlay */
        .org-modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.4);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .org-modal-overlay.visible {
            display: flex;
        }

        .org-modal {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: var(--shadow-lg);
            width: 100%;
            max-width: 480px;
            margin: 1rem;
            animation: orgModalIn 0.15s ease;
        }

        @@keyframes orgModalIn {
            from {
                opacity: 0;
                transform: translateY(-8px) scale(0.98);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .org-modal__header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid var(--border);
        }

        .org-modal__title {
            font-size: 1.125rem;
            font-weight: 600;
            color: var(--text);
            margin: 0;
        }

        .org-modal__close {
            width: 32px;
            height: 32px;
            border-radius: 6px;
            border: none;
            background: transparent;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            color: var(--text-muted);
            transition: all 0.15s ease;
        }

        .org-modal__close:hover {
            background: var(--surface-soft);
            color: var(--text);
        }

        .org-modal__body {
            padding: 1.5rem;
        }

        .org-modal__body .form-group {
            margin-bottom: 1rem;
        }

        .org-modal__body .form-group:last-child {
            margin-bottom: 0;
        }

        .org-modal__body label {
            display: block;
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--text);
            margin-bottom: 0.375rem;
        }

        .org-modal__body input[type="text"] {
            width: 100%;
            padding: 0.5rem 0.75rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 0.9375rem;
            color: var(--text);
            background: var(--surface);
            transition: border-color 0.15s ease;
            box-sizing: border-box;
        }

        .org-modal__body input[type="text"]:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--primary-soft);
        }

        .org-modal__footer {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 0.5rem;
            padding: 1rem 1.5rem;
            border-top: 1px solid var(--border);
        }

        .btn-ghost {
            background: transparent;
            color: var(--text-muted);
            border-color: var(--border);
        }

        .btn-ghost:hover {
            background: var(--surface-soft);
            color: var(--text);
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .page-title {
                font-size: 1.75rem;
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .section-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 1rem;
            }

            .tree-item-actions {
                opacity: 1;
            }
        }
    </style>
}

<!-- Page Header -->
<div class="page-header">
    <h1 class="page-title"><loc key="OrganizationStructure" /></h1>
    <p class="page-subtitle"><loc key="ManageHierarchyProjectsAreasMolecules" /></p>
</div>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="message-banner message-banner--success">
        <span>@TempData["SuccessMessage"]</span>
        <button class="message-banner__close" onclick="this.parentElement.remove()" loc-aria-label="Close">&times;</button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="message-banner message-banner--error">
        <span>@TempData["ErrorMessage"]</span>
        <button class="message-banner__close" onclick="this.parentElement.remove()" loc-aria-label="Close">&times;</button>
    </div>
}

<!-- Stats Grid -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon">@Model.TotalUsers</div>
        <div class="stat-content">
            <div class="stat-value">@Model.TotalUsers</div>
            <div class="stat-label"><loc key="TotalUsers" /></div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon">@Model.TotalActiveProjects</div>
        <div class="stat-content">
            <div class="stat-value">@Model.TotalActiveProjects</div>
            <div class="stat-label"><loc key="ActiveProjects" /></div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon">@Model.TotalActiveAreas</div>
        <div class="stat-content">
            <div class="stat-value">@Model.TotalActiveAreas</div>
            <div class="stat-label"><loc key="ActiveAreas" /></div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon">@Model.TotalActiveMolecules</div>
        <div class="stat-content">
            <div class="stat-value">@Model.TotalActiveMolecules</div>
            <div class="stat-label"><loc key="ActiveMolecules" /></div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="section-card">
    <div class="section-header">
        <h2 class="section-title"><loc key="QuickActions" /></h2>
    </div>
    <div class="quick-actions">
        <a href="/Admin/Organization/Projects" class="btn btn-primary btn-sm">
            <loc key="ManageProjects" />
        </a>
        <a href="/Admin/Organization/Areas" class="btn btn-primary btn-sm">
            <loc key="ManageAreas" />
        </a>
        <a href="/Admin/Organization/Molecules" class="btn btn-primary btn-sm">
            <loc key="ManageMolecules" />
        </a>
        <a href="/Admin/Companies" class="btn btn-primary btn-sm">
            <loc key="ManageCompanies" />
        </a>
        <a href="/Admin/Organization/Departments" class="btn btn-primary btn-sm">
            <loc key="ManageDepartments" />
        </a>
        <a href="/Admin/Organization/JobTypes" class="btn btn-primary btn-sm">
            <loc key="ManageJobTypes" />
        </a>
    </div>
</div>

<!-- Hierarchy Tree -->
<div class="section-card">
    <div class="section-header">
        <h2 class="section-title"><loc key="HierarchyTree" /></h2>
        <button class="btn btn-sm" onclick="toggleAllNodes()">
            <loc key="ExpandCollapseAll" />
        </button>
    </div>

    @if (Model.Projects.Any())
    {
        <div class="hierarchy-tree">
            @foreach (var project in Model.Projects)
            {
                var projectAreas = Model.Areas.Where(a => a.ProjectId == project.Id).ToList();
                <div class="tree-node">
                    <div class="tree-item">
                        @if (projectAreas.Any())
                        {
                            <button class="tree-expand" onclick="toggleNode(this)">&#9654;</button>
                        }
                        else
                        {
                            <span class="tree-spacer"></span>
                        }
                        <span class="tree-icon tree-icon-project">P</span>
                        <span class="tree-label">@(project.DisplayName)</span>
                        <span class="tree-meta">(@project.AreaCount <loc key="Areas" />)</span>
                        @if (!project.IsActive)
                        {
                            <span class="badge badge-inactive"><loc key="Inactive" /></span>
                        }
                    </div>

                    @if (projectAreas.Any())
                    {
                        <div class="tree-children">
                            @foreach (var area in projectAreas)
                            {
                                var areaMolecules = Model.Molecules.Where(m => m.AreaId == area.Id).ToList();
                                <div class="tree-node">
                                    <div class="tree-item">
                                        @if (areaMolecules.Any())
                                        {
                                            <button class="tree-expand" onclick="toggleNode(this)">&#9654;</button>
                                        }
                                        else
                                        {
                                            <span class="tree-spacer"></span>
                                        }
                                        <span class="tree-icon tree-icon-area">A</span>
                                        <span class="tree-label">@(area.DisplayName)</span>
                                        <span class="tree-meta">(@area.MoleculeCount <loc key="Molecules" />, @area.JobTypeCount <loc key="JobTypes" />)</span>
                                        @if (!area.IsActive)
                                        {
                                            <span class="badge badge-inactive"><loc key="Inactive" /></span>
                                        }
                                    </div>

                                    @if (areaMolecules.Any())
                                    {
                                        <div class="tree-children">
                                            @foreach (var molecule in areaMolecules)
                                            {
                                                var moleculeCompanies = Model.Companies.Where(c => c.MoleculeId == molecule.Id).ToList();
                                                var moleculeDepts = Model.Departments.Where(d => d.MoleculeId == molecule.Id).ToList();
                                                var hasChildren = moleculeCompanies.Any() || moleculeDepts.Any();

                                                <div class="tree-node">
                                                    @{
                                                        var moleculeExpandable = hasChildren
                                                            || molecule.Type == MoleculeType.Workforce
                                                            || molecule.Type == MoleculeType.Helper
                                                            || molecule.Type == MoleculeType.Tech;
                                                    }
                                                    <div class="tree-item">
                                                        @if (moleculeExpandable)
                                                        {
                                                            <button class="tree-expand" onclick="toggleNode(this)">&#9654;</button>
                                                        }
                                                        else
                                                        {
                                                            <span class="tree-spacer"></span>
                                                        }
                                                        <span class="tree-icon tree-icon-molecule">M</span>
                                                        <span class="tree-label">@(molecule.DisplayName)</span>
                                                        <span class="badge @IndexModel.GetMoleculeTypeBadgeClass(molecule.Type)">@Model.GetMoleculeTypeDisplay(molecule.Type)</span>
                                                        @if (!molecule.IsActive)
                                                        {
                                                            <span class="badge badge-inactive"><loc key="Inactive" /></span>
                                                        }
                                                    </div>

                                                    @{
                                                        var showAddCompany = (molecule.Type == MoleculeType.Workforce || molecule.Type == MoleculeType.Helper);
                                                        var showAddDepartment = (molecule.Type == MoleculeType.Tech);
                                                        var showChildren = hasChildren || showAddCompany || showAddDepartment;
                                                    }
                                                    @if (showChildren)
                                                    {
                                                        <div class="tree-children">
                                                            @foreach (var company in moleculeCompanies)
                                                            {
                                                                <div class="tree-node">
                                                                    <div class="tree-item">
                                                                        <span class="tree-spacer"></span>
                                                                        <span class="tree-icon tree-icon-company">C</span>
                                                                        <span class="tree-label">@(company.DisplayName ?? company.Name)</span>
                                                                        <span class="tree-meta">(@company.UserCount <loc key="Users" />)</span>
                                                                        <span class="tree-item-actions">
                                                                            <button class="tree-action-btn"
                                                                                    loc-title="Rename"
                                                                                    loc-aria-label="RenameCompany"
                                                                                    onclick="openModal('RenameCompany', @company.Id, '@Html.Raw(company.Name.Replace("'", "\\'"))', '@Html.Raw((company.DisplayName ?? "").Replace("'", "\\'"))')">&#9998;</button>
                                                                            @if (company.UserCount > 0)
                                                                            {
                                                                                <button class="tree-action-btn tree-action-btn--danger"
                                                                                        disabled
                                                                                        loc-title="Error_CannotDeleteCompanyWithOwners"
                                                                                        loc-aria-label="DeleteCompany">&#128465;</button>
                                                                            }
                                                                            else
                                                                            {
                                                                                <button class="tree-action-btn tree-action-btn--danger"
                                                                                        loc-title="Delete"
                                                                                        loc-aria-label="DeleteCompany"
                                                                                        onclick="confirmDelete('DeleteCompany', @company.Id, '@Html.Raw((company.DisplayName ?? company.Name).Replace("'", "\\'"))')">&#128465;</button>
                                                                            }
                                                                        </span>
                                                                    </div>
                                                                </div>
                                                            }
                                                            @foreach (var dept in moleculeDepts)
                                                            {
                                                                <div class="tree-node">
                                                                    <div class="tree-item">
                                                                        <span class="tree-spacer"></span>
                                                                        <span class="tree-icon tree-icon-department">D</span>
                                                                        <span class="tree-label">@(dept.DisplayName)</span>
                                                                        <span class="tree-meta">(@dept.UserCount <loc key="Users" />)</span>
                                                                        @if (!dept.IsActive)
                                                                        {
                                                                            <span class="badge badge-inactive"><loc key="Inactive" /></span>
                                                                        }
                                                                        <span class="tree-item-actions">
                                                                            <button class="tree-action-btn"
                                                                                    loc-title="Rename"
                                                                                    loc-aria-label="RenameDepartment"
                                                                                    onclick="openModal('RenameDepartment', @dept.Id, '@Html.Raw(dept.Name.Replace("'", "\\'"))', '@Html.Raw(dept.DisplayName.Replace("'", "\\'"))')">&#9998;</button>
                                                                            @if (dept.UserCount > 0)
                                                                            {
                                                                                <button class="tree-action-btn tree-action-btn--danger"
                                                                                        disabled
                                                                                        loc-title="Error_CannotDeleteDepartmentWithUsers"
                                                                                        loc-aria-label="DeleteDepartment">&#128465;</button>
                                                                            }
                                                                            else
                                                                            {
                                                                                <button class="tree-action-btn tree-action-btn--danger"
                                                                                        loc-title="Delete"
                                                                                        loc-aria-label="DeleteDepartment"
                                                                                        onclick="confirmDelete('DeleteDepartment', @dept.Id, '@Html.Raw(dept.DisplayName.Replace("'", "\\'"))')">&#128465;</button>
                                                                            }
                                                                        </span>
                                                                    </div>
                                                                </div>
                                                            }
                                                            @if (showAddCompany)
                                                            {
                                                                <button type="button" class="tree-add-btn"
                                                                        onclick="openModal('AddCompany', 0, '', '', @molecule.Id)"
                                                                        loc-aria-label="AddCompany">
                                                                    + <loc key="AddCompany" />
                                                                </button>
                                                            }
                                                            @if (showAddDepartment)
                                                            {
                                                                <button type="button" class="tree-add-btn"
                                                                        onclick="openModal('AddDepartment', 0, '', '', @molecule.Id)"
                                                                        loc-aria-label="AddDepartment">
                                                                    + <loc key="AddDepartment" />
                                                                </button>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">&#128736;</div>
            <p class="empty-state-text"><loc key="NoProjectsYet" /></p>
            <a href="/Admin/Organization/Projects" class="btn btn-primary">
                <loc key="CreateFirstProject" />
            </a>
        </div>
    }

    @* Unassigned Companies Section *@
    @{
        var unassignedCompanies = Model.Companies.Where(c => !c.MoleculeId.HasValue).ToList();
    }
    @if (unassignedCompanies.Any())
    {
        <div class="unassigned-section">
            <h3 class="unassigned-section__header">
                <loc key="UnassignedCompanies" /> (@unassignedCompanies.Count)
            </h3>
            <div class="hierarchy-tree">
                @foreach (var company in unassignedCompanies)
                {
                    <div class="tree-node tree-node--root">
                        <div class="tree-item tree-item--root">
                            <span class="tree-spacer"></span>
                            <span class="tree-icon tree-icon-company">C</span>
                            <span class="tree-label">@(company.DisplayName ?? company.Name)</span>
                            <span class="tree-meta">(@company.UserCount <loc key="Users" />)</span>
                            <span class="badge badge-inactive"><loc key="NeedsAssignment" /></span>
                            <span class="tree-item-actions">
                                <button class="tree-action-btn"
                                        loc-title="Rename"
                                        loc-aria-label="RenameCompany"
                                        onclick="openModal('RenameCompany', @company.Id, '@Html.Raw(company.Name.Replace("'", "\\'"))', '@Html.Raw((company.DisplayName ?? "").Replace("'", "\\'"))')">&#9998;</button>
                                @if (company.UserCount > 0)
                                {
                                    <button class="tree-action-btn tree-action-btn--danger"
                                            disabled
                                            loc-title="Error_CannotDeleteCompanyWithOwners"
                                            loc-aria-label="DeleteCompany">&#128465;</button>
                                }
                                else
                                {
                                    <button class="tree-action-btn tree-action-btn--danger"
                                            loc-title="Delete"
                                            loc-aria-label="DeleteCompany"
                                            onclick="confirmDelete('DeleteCompany', @company.Id, '@Html.Raw((company.DisplayName ?? company.Name).Replace("'", "\\'"))')">&#128465;</button>
                                }
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Entity Modal (reused for Add / Rename of Company and Department) -->
<div id="orgModal" class="org-modal-overlay" role="dialog" aria-modal="true">
    <div class="org-modal">
        <div class="org-modal__header">
            <h3 id="orgModalTitle" class="org-modal__title"></h3>
            <button class="org-modal__close" onclick="closeModal()" loc-aria-label="Close">&times;</button>
        </div>
        <form id="orgModalForm" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="EntityId" id="orgModalEntityId" />
            <input type="hidden" name="ParentMoleculeId" id="orgModalParentId" />
            <div class="org-modal__body">
                <div class="form-group">
                    <label for="orgModalName"><loc key="Name" /></label>
                    <input type="text" id="orgModalName" name="EntityName" required autocomplete="off" />
                </div>
                <div class="form-group">
                    <label for="orgModalDisplayName"><loc key="DisplayName" /></label>
                    <input type="text" id="orgModalDisplayName" name="EntityDisplayName" autocomplete="off" />
                </div>
            </div>
            <div class="org-modal__footer">
                <button type="button" class="btn btn-ghost" onclick="closeModal()"><loc key="Cancel" /></button>
                <button type="submit" class="btn btn-primary" id="orgModalSubmit"><loc key="Save" /></button>
            </div>
        </form>
    </div>
</div>

<!-- Delete confirmation form (hidden, submitted via JS) -->
<form id="deleteForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="EntityId" id="deleteEntityId" />
</form>

<script>
function toggleNode(button) {
    const treeItem = button.closest('.tree-item');
    const treeNode = treeItem.closest('.tree-node');
    const children = treeNode.querySelector('.tree-children');

    if (children) {
        const isExpanded = children.classList.contains('expanded');
        children.classList.toggle('expanded');
        button.classList.toggle('expanded', !isExpanded);
    }
}

function toggleAllNodes() {
    const allChildren = document.querySelectorAll('.tree-children');
    const allButtons = document.querySelectorAll('.tree-expand');

    // Check if most are expanded
    const expandedCount = document.querySelectorAll('.tree-children.expanded').length;
    const shouldExpand = expandedCount < allChildren.length / 2;

    allChildren.forEach(child => {
        child.classList.toggle('expanded', shouldExpand);
    });

    allButtons.forEach(btn => {
        btn.classList.toggle('expanded', shouldExpand);
    });
}

// Expand first level by default
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.hierarchy-tree > .tree-node > .tree-children').forEach(child => {
        child.classList.add('expanded');
    });
    document.querySelectorAll('.hierarchy-tree > .tree-node > .tree-item > .tree-expand').forEach(btn => {
        btn.classList.add('expanded');
    });
});

// ================================================================
// Modal management
// ================================================================

const modalTitles = {
    'AddCompany':        '@Html.Raw(Localizer["AddCompany"].Value.Replace("'", "\\'"))',
    'AddDepartment':     '@Html.Raw(Localizer["AddDepartment"].Value.Replace("'", "\\'"))',
    'RenameCompany':     '@Html.Raw(Localizer["RenameCompany"].Value.Replace("'", "\\'"))',
    'RenameDepartment':  '@Html.Raw(Localizer["RenameDepartment"].Value.Replace("'", "\\'"))'
};

/**
 * Opens the reusable modal for add/rename operations.
 * @@param {string} handler   - The page handler name (AddCompany, RenameCompany, etc.)
 * @@param {number} entityId  - Entity ID (0 for add operations)
 * @@param {string} name      - Current name (empty for add)
 * @@param {string} displayName - Current display name (empty for add)
 * @@param {number} [parentId]  - Parent molecule ID (for add operations)
 */
function openModal(handler, entityId, name, displayName, parentId) {
    const overlay = document.getElementById('orgModal');
    const form = document.getElementById('orgModalForm');
    const titleEl = document.getElementById('orgModalTitle');
    const nameInput = document.getElementById('orgModalName');
    const displayNameInput = document.getElementById('orgModalDisplayName');
    const entityIdInput = document.getElementById('orgModalEntityId');
    const parentIdInput = document.getElementById('orgModalParentId');

    // Set the form action to the correct handler
    form.action = '?handler=' + handler;

    // Set modal title
    titleEl.textContent = modalTitles[handler] || handler;

    // Populate fields
    entityIdInput.value = entityId || 0;
    parentIdInput.value = parentId || 0;
    nameInput.value = name || '';
    displayNameInput.value = displayName || '';

    // Show modal
    overlay.classList.add('visible');

    // Focus the name input
    setTimeout(function() { nameInput.focus(); }, 100);
}

function closeModal() {
    document.getElementById('orgModal').classList.remove('visible');
}

// Close modal on overlay click
document.getElementById('orgModal').addEventListener('click', function(e) {
    if (e.target === this) {
        closeModal();
    }
});

// Close modal on Escape key
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeModal();
    }
});

// ================================================================
// Delete confirmation
// ================================================================

const deleteConfirmText = '@Html.Raw(Localizer["Confirm_DeleteEntity"].Value.Replace("'", "\\'"))';

/**
 * Shows a browser confirm dialog and submits the delete form.
 * @@param {string} handler - DeleteCompany or DeleteDepartment
 * @@param {number} entityId - The entity ID to delete
 * @@param {string} entityLabel - The display name shown in the confirm dialog
 */
function confirmDelete(handler, entityId, entityLabel) {
    var message = deleteConfirmText.replace('{0}', entityLabel);
    if (!confirm(message)) {
        return;
    }

    var form = document.getElementById('deleteForm');
    form.action = '?handler=' + handler;
    document.getElementById('deleteEntityId').value = entityId;
    form.submit();
}
</script>
