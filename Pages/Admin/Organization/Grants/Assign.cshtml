@page
@model ShiftManager.Pages.Admin.Organization.Grants.AssignModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@{ Layout = "_Layout"; ViewData["Title"] = Localizer["AssignGrant"]; }

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Admin"], Url = "/Admin/Users" },
    new BreadcrumbItem { Label = Localizer["Organization"], Url = "/Admin/Organization" },
    new BreadcrumbItem { Label = Localizer["Grants"], Url = "/Admin/Organization/Grants" },
    new BreadcrumbItem { Label = Localizer["AssignGrant"], IsActive = true }
})

@section Styles {
    <style>
        .page-header { margin-bottom: 2rem; }
        .page-title { font-size: 2rem; font-weight: 700; color: var(--text); margin: 0 0 0.5rem 0; }
        .page-subtitle { font-size: 1rem; color: var(--text-muted); margin: 0; }
        .alert-success, .alert-error { padding: 1rem 1.25rem; border-radius: 10px; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem; font-size: 0.9375rem; font-weight: 500; }
        .alert-success { background: var(--success); color: var(--success-text); }
        .alert-error { background: var(--danger); color: var(--danger-text); }
        .section-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; box-shadow: var(--shadow-sm); margin-bottom: 2rem; }
        .section-header { font-size: 1.125rem; font-weight: 600; color: var(--text); margin: 0 0 1.25rem 0; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border); }
        .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem; }
        .form-group { margin-bottom: 1rem; }
        .form-label { display: block; font-size: 0.875rem; font-weight: 500; color: var(--text-muted); margin-bottom: 0.5rem; }
        .form-label-required { color: var(--danger); }
        .form-input, .form-select, .form-textarea { width: 100%; padding: 0.625rem 0.875rem; font-size: 0.9375rem; color: var(--text); background-color: var(--surface-soft); border: 1px solid var(--border); border-radius: 8px; }
        .form-hint { font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem; }
        .btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.625rem 1.25rem; border: 1px solid var(--border); border-radius: 8px; font-size: 0.875rem; font-weight: 500; cursor: pointer; transition: all 0.15s ease; text-decoration: none; }
        .btn-primary { background: var(--primary); color: var(--primary-contrast); border-color: var(--primary); }
        .btn-secondary { background: var(--surface-soft); color: var(--text); }
        .checkbox-group { display: flex; gap: 2rem; margin-top: 0.5rem; }
        .checkbox-label { display: flex; align-items: center; gap: 0.5rem; cursor: pointer; }
        .checkbox-label input { width: auto; margin: 0; }
        .scope-section { background: var(--surface-soft); padding: 1rem; border-radius: 8px; margin-top: 1rem; }
        .scope-section h4 { margin: 0 0 1rem 0; font-size: 0.9375rem; color: var(--text); }
        .user-selected { background: var(--primary-bg); padding: 0.75rem 1rem; border-radius: 8px; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; }
    </style>
}

<div class="page-header">
    <h1 class="page-title"><loc key="AssignGrant" /></h1>
    <p class="page-subtitle"><loc key="AssignGrantToUser" /></p>
</div>

@if (!string.IsNullOrEmpty(Model.Success)) { <div class="alert-success"><span>&#10003;</span><span>@(Model.Success)</span></div> }
@if (!string.IsNullOrEmpty(Model.Error)) { <div class="alert-error"><span>&#10007;</span><span>@(Model.Error)</span></div> }

<form method="post">
    <div class="section-card">
        <h3 class="section-header"><loc key="SelectUserAndGrant" /></h3>

        @if (!string.IsNullOrEmpty(Model.SelectedUserName))
        {
            <div class="user-selected">
                <strong>@Localizer["User"]:</strong> @Model.SelectedUserName
                <input type="hidden" asp-for="SelectedUserId" />
            </div>
        }
        else
        {
            <div class="form-group">
                <label class="form-label">@Localizer["User"] <span class="form-label-required">*</span></label>
                <select class="form-select" asp-for="SelectedUserId" required>
                    <option value="">@Localizer["SelectUser"]</option>
                    @foreach (var u in Model.AvailableUsers)
                    {
                        <option value="@u.Id">@u.DisplayName (@u.Email)</option>
                    }
                </select>
            </div>
        }

        <div class="form-group">
            <label class="form-label">@Localizer["GrantType"] <span class="form-label-required">*</span></label>
            <select class="form-select" asp-for="SelectedGrantTypeId" required>
                <option value="">@Localizer["SelectGrantType"]</option>
                @foreach (var gt in Model.AvailableGrantTypes)
                {
                    <option value="@gt.Id" title="@(gt.DescriptionKey != null ? Localizer[gt.DescriptionKey] : "")">[@gt.Category] @Localizer[gt.NameKey]</option>
                }
            </select>
            <span class="form-hint"><loc key="GrantTypeDescription" /></span>
            @* I-03: Show grant description below dropdown for discoverability *@
            <div id="grantDescriptionDisplay" style="margin-top: 0.5rem; padding: 0.5rem; background: var(--surface-soft); border-radius: 0.375rem; font-size: 0.85rem; color: var(--text-muted); display: none;"></div>
            <script>
            document.getElementById('SelectedGrantTypeId')?.addEventListener('change', function() {
                var opt = this.options[this.selectedIndex];
                var desc = opt?.getAttribute('title');
                var display = document.getElementById('grantDescriptionDisplay');
                if (desc && desc.trim()) {
                    display.textContent = desc;
                    display.style.display = 'block';
                } else {
                    display.style.display = 'none';
                }
            });
            </script>
        </div>

        <div class="form-group">
            <label class="form-label">@Localizer["Capabilities"]</label>
            <div class="checkbox-group">
                <label class="checkbox-label">
                    <input type="checkbox" asp-for="CanOwn" />
                    <span><loc key="CanOwn" /></span>
                </label>
                <label class="checkbox-label">
                    <input type="checkbox" asp-for="CanGive" />
                    <span><loc key="CanGive" /></span>
                </label>
            </div>
            <span class="form-hint"><loc key="CapabilitiesDescription" /></span>
        </div>
    </div>

    <div class="section-card">
        <h3 class="section-header"><loc key="Scope" /></h3>
        <p style="color: var(--text-muted); margin-bottom: 1rem;"><loc key="ScopeDescription" /></p>

        <div class="form-grid">
            <div class="form-group">
                <label class="form-label">@Localizer["Project"]</label>
                <select class="form-select" asp-for="ScopeProjectId">
                    <option value="">@Localizer["AllProjects"]</option>
                    @foreach (var p in Model.AvailableProjects)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">@Localizer["Area"]</label>
                <select class="form-select" asp-for="ScopeAreaId">
                    <option value="">@Localizer["AllAreas"]</option>
                    @foreach (var a in Model.AvailableAreas)
                    {
                        <option value="@a.Id">@a.Name</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">@Localizer["Molecule"]</label>
                <select class="form-select" asp-for="ScopeMoleculeId">
                    <option value="">@Localizer["AllMolecules"]</option>
                    @foreach (var m in Model.AvailableMolecules)
                    {
                        <option value="@m.Id">@m.Name</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">@Localizer["Company"]</label>
                <select class="form-select" asp-for="ScopeCompanyId">
                    <option value="">@Localizer["AllCompanies"]</option>
                    @foreach (var c in Model.AvailableCompanies)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">@Localizer["Department"]</label>
                <select class="form-select" asp-for="ScopeDepartmentId">
                    <option value="">@Localizer["AllDepartments"]</option>
                    @foreach (var d in Model.AvailableDepartments)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">@Localizer["JobType"]</label>
                <select class="form-select" asp-for="ScopeJobTypeId">
                    <option value="">@Localizer["AllJobTypes"]</option>
                    @foreach (var jt in Model.AvailableJobTypes)
                    {
                        <option value="@jt.Id">@jt.Name</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <div class="section-card">
        <h3 class="section-header"><loc key="Notes" /></h3>
        <div class="form-group">
            <label class="form-label">@Localizer["NotesOptional"]</label>
            <textarea class="form-textarea" asp-for="Notes" rows="3" placeholder="@Localizer["GrantNotesPlaceholder"]"></textarea>
        </div>
    </div>

    <div style="display: flex; gap: 0.5rem;">
        <button type="submit" class="btn btn-primary"><loc key="AssignGrant" /></button>
        <a href="/Admin/Organization/Grants" class="btn btn-secondary"><loc key="Cancel" /></a>
    </div>
</form>
