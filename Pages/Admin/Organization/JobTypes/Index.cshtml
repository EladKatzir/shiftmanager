@page
@model ShiftManager.Pages.Admin.Organization.JobTypes.IndexModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["JobTypes"];
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Admin"], Url = "/Admin/Users" },
    new BreadcrumbItem { Label = Localizer["Organization"], Url = "/Admin/Organization" },
    new BreadcrumbItem { Label = Localizer["JobTypes"], IsActive = true }
})

@section Styles {
    <style>
        .page-header { margin-bottom: 2rem; }
        .page-title { font-size: 2rem; font-weight: 700; color: var(--text); margin: 0 0 0.5rem 0; }
        .page-subtitle { font-size: 1rem; color: var(--text-muted); margin: 0; }

        .section-card {
            background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
            padding: 1.5rem; box-shadow: var(--shadow-sm); margin-bottom: 2rem;
        }
        .section-header { font-size: 1.125rem; font-weight: 600; color: var(--text);
            margin: 0 0 1.25rem 0; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border); }

        .info-box { padding: 1rem; background: var(--surface-soft); border-left: 4px solid var(--primary);
            border-radius: 8px; margin-bottom: 1.5rem; font-size: 0.875rem; color: var(--text-muted); }

        .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 1rem; }
        .form-group { margin-bottom: 0; }
        .form-label { display: block; font-size: 0.875rem; font-weight: 500; color: var(--text-muted); margin-bottom: 0.5rem; }
        .form-label-required { color: var(--danger); }
        .form-input, .form-select {
            width: 100%; padding: 0.625rem 0.875rem; font-size: 0.9375rem; color: var(--text);
            background-color: var(--surface-soft); border: 1px solid var(--border); border-radius: 8px; transition: all 0.15s ease;
        }
        .form-input:focus, .form-select:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1); }

        .btn {
            display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
            padding: 0.625rem 1.25rem; border: 1px solid var(--border); border-radius: 8px;
            font-size: 0.875rem; font-weight: 500; cursor: pointer; transition: all 0.15s ease; text-decoration: none;
        }
        .btn-primary { background: var(--primary); color: var(--primary-contrast); border-color: var(--primary); }
        .btn-primary:hover { background: var(--primary-hover); transform: translateY(-1px); }
        .btn-danger { background: var(--danger); color: var(--danger-text); border-color: var(--danger); font-size: 0.8125rem; padding: 0.5rem 1rem; }
        .btn-ghost { background: transparent; color: var(--text); border-color: transparent; font-size: 0.8125rem; padding: 0.5rem 1rem; }
        .btn-ghost:hover { background: var(--surface-soft); border-color: var(--border); }

        .data-table { width: 100%; border-collapse: collapse; }
        .data-table thead tr { border-bottom: 2px solid var(--border); }
        .data-table th { padding: 0.875rem; text-align: start; font-size: 0.8125rem; font-weight: 600;
            color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.025em; }
        .data-table tbody tr { border-bottom: 1px solid var(--border); transition: background-color 0.15s ease; }
        .data-table tbody tr:hover { background: var(--surface-soft); }
        .data-table td { padding: 1rem 0.875rem; font-size: 0.9375rem; color: var(--text); }
        .table-actions { display: flex; gap: 0.5rem; white-space: nowrap; }

        .badge {
            display: inline-flex; align-items: center; padding: 0.25rem 0.5rem; border-radius: 9999px;
            font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.025em;
        }
        .badge-inactive { background: var(--surface-soft); color: var(--text-muted) !important; }
        .badge-active { background: var(--success-soft); color: var(--success) !important; }

        .color-swatch {
            display: inline-block; width: 20px; height: 20px; border-radius: 4px;
            border: 1px solid var(--border); vertical-align: middle; margin-right: 0.5rem;
        }

        .empty-state { text-align: center; padding: 3rem 2rem; color: var(--text-muted); }

        @@media (max-width: 768px) {
            .page-title { font-size: 1.75rem; }
            .form-grid { grid-template-columns: 1fr; }
            .table-actions { flex-direction: column; }
        }
    </style>
}

<div class="page-header">
    <h1 class="page-title"><loc key="ManageJobTypes" /></h1>
    <p class="page-subtitle"><loc key="CreateAndManageJobTypes" /></p>
</div>


<div class="section-card">
    <h3 class="section-header"><loc key="CreateNewJobType" /></h3>

    <div class="info-box">
        <loc key="JobTypesAreAreaScoped" />
    </div>

    @if (Model.AvailableAreas.Any())
    {
        <form method="post" asp-page-handler="Create">
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">@Localizer["Area"] <span class="form-label-required">*</span></label>
                    <select class="form-select" asp-for="SelectedAreaId" id="areaSelect" required>
                        <option value="">@Localizer["SelectArea"]</option>
                        @foreach (var a in Model.AvailableAreas)
                        {
                            <option value="@a.Id">@a.ProjectName - @a.Name</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">@Localizer["Molecule"]</label>
                    <select class="form-select" asp-for="SelectedMoleculeId" id="moleculeSelect">
                        <option value="">@Localizer["AllMolecules_AreaWide"]</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">@Localizer["Name"] <span class="form-label-required">*</span></label>
                    <input class="form-input" asp-for="JobTypeName" placeholder="job-type-key" required />
                </div>
                <div class="form-group">
                    <label class="form-label">@Localizer["DisplayName"]</label>
                    <input class="form-input" asp-for="JobTypeDisplayName" placeholder="@Localizer["Placeholder_JobTypeName"]" />
                </div>
                <div class="form-group">
                    <label class="form-label">@Localizer["Color"]</label>
                    <input class="form-input" type="color" asp-for="JobTypeColor" value="#3b82f6" />
                </div>
                <div class="form-group">
                    <label class="form-label">@Localizer["SortOrder"]</label>
                    <input class="form-input" type="number" asp-for="SortOrder" value="0" min="0" />
                </div>
            </div>
            <button class="btn btn-primary" type="submit"><loc key="CreateJobType" /></button>
        </form>
    }
    else
    {
        <p class="empty-state"><loc key="NoAreasAvailable" /></p>
    }
</div>

<div class="section-card">
    <h3 class="section-header"><loc key="AllJobTypes" /> (@Model.JobTypes.Count)</h3>
    @if (Model.JobTypes.Any())
    {
        <div style="overflow-x: auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th><loc key="Project" /></th>
                        <th><loc key="Area" /></th>
                        <th><loc key="Molecule" /></th>
                        <th><loc key="JobType" /></th>
                        <th><loc key="Color" /></th>
                        <th><loc key="Order" /></th>
                        <th><loc key="Users" /></th>
                        <th><loc key="Status" /></th>
                        <th style="width:1%"><loc key="Actions" /></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var jt in Model.JobTypes)
                {
                    <tr>
                        <td>@(jt.ProjectName)</td>
                        <td>@(jt.AreaName)</td>
                        <td>@(jt.MoleculeName ?? Localizer["AllMolecules_AreaWide"])</td>
                        <td><strong>@(jt.DisplayName)</strong><br /><small style="color: var(--text-muted);">@(jt.Name)</small></td>
                        <td>
                            @if (!string.IsNullOrEmpty(jt.Color))
                            {
                                <span class="color-swatch" style="background-color: @jt.Color;"></span>
                                <code>@jt.Color</code>
                            }
                            else
                            {
                                <span style="color: var(--text-muted);">-</span>
                            }
                        </td>
                        <td>@jt.SortOrder</td>
                        <td>@jt.UserCount</td>
                        <td>
                            @if (jt.IsActive)
                            {
                                <span class="badge badge-active"><loc key="Active" /></span>
                            }
                            else
                            {
                                <span class="badge badge-inactive"><loc key="Inactive" /></span>
                            }
                        </td>
                        <td>
                            <div class="table-actions">
                                <form method="post" asp-page-handler="ToggleActive" style="display:inline">
                                    <input type="hidden" name="id" value="@jt.Id" />
                                    <button type="submit" class="btn btn-ghost">
                                        @(jt.IsActive ? Localizer["Deactivate"] : Localizer["Activate"])
                                    </button>
                                </form>
                                @if (jt.UserCount == 0)
                                {
                                    <form method="post" asp-page-handler="Delete" style="display:inline"
                                          data-confirm-modal
                                          data-confirm-title="@Localizer["ConfirmDeleteJobType_Title"]"
                                          data-confirm-message="@Localizer["ConfirmDeleteJobType"]"
                                          data-confirm-action="@Localizer["Delete"]"
                                          data-confirm-level="danger">
                                        <input type="hidden" name="id" value="@jt.Id" />
                                        <button type="submit" class="btn btn-danger"><loc key="Delete" /></button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="empty-state"><loc key="NoJobTypesYet" /></p>
    }
</div>

@section Scripts {
    <script>
    (function() {
        var areaSelect = document.getElementById('areaSelect');
        var moleculeSelect = document.getElementById('moleculeSelect');
        if (!areaSelect || !moleculeSelect) return;

        var allMolecules = @Json.Serialize(Model.AvailableMolecules);
        var areaWideLabel = @Json.Serialize(Localizer["AllMolecules_AreaWide"].Value);

        function updateMolecules() {
            var areaId = parseInt(areaSelect.value);
            moleculeSelect.innerHTML = '';

            var defaultOpt = document.createElement('option');
            defaultOpt.value = '';
            defaultOpt.textContent = areaWideLabel;
            moleculeSelect.appendChild(defaultOpt);

            if (!areaId) return;

            var filtered = allMolecules.filter(function(m) { return m.areaId === areaId; });
            filtered.forEach(function(m) {
                var opt = document.createElement('option');
                opt.value = m.id;
                opt.textContent = m.name;
                moleculeSelect.appendChild(opt);
            });
        }

        areaSelect.addEventListener('change', updateMolecules);
        updateMolecules();
    })();
    </script>
}
