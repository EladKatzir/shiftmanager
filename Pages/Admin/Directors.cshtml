@page
@model ShiftManager.Pages.Admin.DirectorsModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["DirectorAssignments"];
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Admin"], Url = "/Admin/Users" },
    new BreadcrumbItem { Label = Localizer["DirectorAssignments"], IsActive = true }
})

@section Styles {
    <style>
        /* Reusing the same design system from Companies page for consistency */
        .page-header { margin-bottom: 2rem; }
        .page-title { font-size: 2rem; font-weight: 700; color: var(--text); margin: 0 0 0.5rem 0; line-height: 1.2; }
        .page-subtitle { font-size: 1rem; color: var(--text-muted); margin: 0; line-height: 1.5; }

        .alert-success { padding: 1rem 1.25rem; border-radius: 10px; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem; font-size: 0.9375rem; font-weight: 500; background: var(--success); color: var(--success-text); border: 1px solid rgba(var(--success-rgb, 16, 185, 129), 0.3); }
        .alert-error { padding: 1rem 1.25rem; border-radius: 10px; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem; font-size: 0.9375rem; font-weight: 500; background: var(--danger); color: var(--danger-text); border: 1px solid rgba(var(--danger-rgb, 244, 67, 54), 0.3); }

        .section-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; box-shadow: var(--shadow-sm); margin-bottom: 2rem; }
        .section-header { font-size: 1.125rem; font-weight: 600; color: var(--text); margin: 0 0 1.25rem 0; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border); }

        .form-grid { display: grid; grid-template-columns: 1fr 1fr auto; gap: 1rem; align-items: end; }
        .form-label { display: block; font-size: 0.875rem; font-weight: 500; color: var(--text-muted); margin-bottom: 0.5rem; }
        .form-input { width: 100%; padding: 0.625rem 0.875rem; font-size: 0.9375rem; color: var(--text); background: var(--surface-soft); border: 1px solid var(--border); border-radius: 8px; transition: all 0.15s ease; }
        .form-input:hover { border-color: var(--primary); background: var(--surface); }
        .form-input:focus { outline: none; border-color: var(--primary); background: var(--surface); box-shadow: 0 0 0 3px rgba(var(--primary-rgb, 59, 130, 246), 0.1); }

        .btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.625rem 1.25rem; border: 1px solid var(--border); border-radius: 8px; font-size: 0.875rem; font-weight: 500; cursor: pointer; transition: all 0.15s ease; text-decoration: none; white-space: nowrap; }
        .btn-primary { background: var(--primary); color: var(--primary-contrast); border-color: var(--primary); }
        .btn-primary:hover { background: var(--primary-hover); border-color: var(--primary-hover); transform: translateY(-1px); box-shadow: var(--shadow-md); }
        .btn-danger { background: var(--danger); color: var(--danger-text); border-color: var(--danger); font-size: 0.8125rem; padding: 0.5rem 1rem; }
        .btn-danger:hover { background: var(--danger-hover); border-color: var(--danger-hover); transform: translateY(-1px); box-shadow: var(--shadow-md); }
        .btn-outline-primary { background: transparent; color: var(--primary); border-color: var(--primary); font-size: 0.8125rem; padding: 0.5rem 1rem; }
        .btn-outline-primary:hover { background: var(--primary); color: var(--primary-contrast); transform: translateY(-1px); box-shadow: var(--shadow-md); }

        .reassign-form { display: inline-flex; align-items: center; gap: 0.5rem; margin-inline-start: 0.5rem; }
        .reassign-select { padding: 0.375rem 0.5rem; font-size: 0.8125rem; border: 1px solid var(--border); border-radius: 6px; background: var(--surface); color: var(--text); max-width: 150px; }

        .directors-table { width: 100%; border-collapse: collapse; }
        .directors-table thead tr { border-bottom: 2px solid var(--border); }
        .directors-table th { padding: 0.875rem; text-align: start; font-size: 0.8125rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.025em; }
        .directors-table tbody tr { border-bottom: 1px solid var(--border); transition: background-color 0.15s ease; }
        .directors-table tbody tr:hover { background: var(--surface-soft); }
        .directors-table tbody tr:last-child { border-bottom: none; }
        .directors-table td { padding: 1rem 0.875rem; font-size: 0.9375rem; color: var(--text); }
        .directors-table td code { background: var(--surface-soft); padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.875rem; font-family: 'Courier New', monospace; }

        .info-box { margin-top: 1.5rem; padding: 1rem; background: var(--surface-soft); border-left: 4px solid var(--primary); border-radius: 8px; }
        .info-box-content { font-size: 0.875rem; color: var(--text-muted); line-height: 1.6; }
        .info-box-content strong { color: var(--text); }
        .info-box-list { margin: 0.5rem 0; padding-left: 1.5rem; }
        .info-box-list li { margin: 0.25rem 0; }

        .empty-state { text-align: center; padding: 3rem 2rem; color: var(--text-muted); }
        .table-wrapper { overflow-x: auto; margin: 0 -1.5rem; padding: 0 1.5rem; }

        @@media (max-width: 768px) {
            .page-title { font-size: 1.75rem; }
            .section-card { padding: 1.25rem; }
            .form-grid { grid-template-columns: 1fr; }
            .table-wrapper { margin: 0 -1.25rem; padding: 0 1.25rem; }
            .directors-table { font-size: 0.875rem; }
            .directors-table th, .directors-table td { padding: 0.75rem 0.5rem; }
        }

        @@media (max-width: 480px) {
            .page-title { font-size: 1.5rem; }
        }
    </style>
}

<!-- Page Header -->
<div class="page-header">
    <h1 class="page-title">@Localizer["DirectorAssignments"]</h1>
    <p class="page-subtitle">@Localizer["ManageDirectorAssignments"]</p>
</div>

<!-- Success Message -->
@if (!string.IsNullOrEmpty(Model.Success))
{
    <div class="alert-success">
        <span style="font-size: 1.25rem;">✓</span>
        <span>@Model.Success</span>
    </div>
}

<!-- Error Message -->
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert-error">
        <span style="font-size: 1.25rem;">✗</span>
        <span>@Model.Error</span>
    </div>
}

<!-- Assign Director Form -->
<div class="section-card">
    <h3 class="section-header">@Localizer["AssignDirectorToCompany"]</h3>
    <form method="post" asp-page-handler="Assign">
        @Html.AntiForgeryToken()
        <div class="form-grid">
            <div>
                <label class="form-label">@Localizer["Director"]</label>
                <select class="form-input" asp-for="DirectorUserId">
                    <option value="0">@Localizer["SelectDirector"]</option>
                    @foreach (var director in Model.AvailableDirectors)
                    {
                        <option value="@director.Id">@director.DisplayName (@director.Email)</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label">@Localizer["Company"]</label>
                <select class="form-input" asp-for="CompanyId">
                    <option value="0">@Localizer["SelectCompany"]</option>
                    @foreach (var company in Model.AvailableCompanies)
                    {
                        <option value="@company.Id">@company.LocalizedName (@company.Slug)</option>
                    }
                </select>
            </div>
            <button class="btn btn-primary" type="submit">
                <span>✓</span>
                <span>@Localizer["Assign"]</span>
            </button>
        </div>
    </form>
</div>

<!-- Current Director Assignments -->
<div class="section-card">
    <h3 class="section-header">@Localizer["CurrentDirectorAssignments"]</h3>
    @if (Model.Assignments.Any())
    {
        <div class="table-wrapper">
            <table class="directors-table">
                <thead>
                    <tr>
                        <th>@Localizer["Director"]</th>
                        <th>@Localizer["Email"]</th>
                        <th>@Localizer["Company"]</th>
                        <th>@Localizer["Slug"]</th>
                        <th>@Localizer["GrantedBy"]</th>
                        <th>@Localizer["GrantedAt"]</th>
                        <th style="width:1%">@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var assignment in Model.Assignments)
                    {
                        <tr>
                            <td><strong>@assignment.DirectorName</strong></td>
                            <td>@assignment.DirectorEmail</td>
                            <td>@assignment.CompanyName</td>
                            <td><code>@assignment.CompanySlug</code></td>
                            <td>@assignment.GrantedByName</td>
                            <td>@assignment.GrantedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <form method="post" asp-page-handler="Revoke" style="display:inline" data-director-name="@assignment.DirectorName" data-company-name="@assignment.CompanyName" data-confirm-msg="@Localizer["ConfirmRevokeDirectorAccess"].Value.Trim()"
                                      onsubmit="return confirm(this.dataset.confirmMsg.replace('{0}', this.dataset.directorName).replace('{1}', this.dataset.companyName));">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@assignment.Id" />
                                    <button type="submit" class="btn btn-danger">
                                        <span>✗</span>
                                        <span>@Localizer["Revoke"]</span>
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="Reassign" class="reassign-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@assignment.Id" />
                                    <select name="newCompanyId" class="reassign-select">
                                        @foreach (var company in Model.AvailableCompanies.Where(c => c.Id != assignment.CompanyId))
                                        {
                                            <option value="@company.Id">@company.LocalizedName</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-outline-primary">
                                        <span>@Localizer["Move"]</span>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="empty-state">@Localizer["NoDirectorAssignments"]</p>
    }
</div>

<!-- About Director Role Info Box -->
<div class="info-box">
    <div class="info-box-content">
        <strong>@Localizer["AboutDirectorRole"]</strong><br />
        @Localizer["DirectorsCanOversee"]
        <ul class="info-box-list">
            <li>@Localizer["DirectorPerm1"]</li>
            <li>@Localizer["DirectorPerm2"]</li>
            <li>@Localizer["DirectorPerm3"]</li>
            <li>@Localizer["DirectorPerm4"]</li>
        </ul>
        @Localizer["DirectorsCannot"]
    </div>
</div>
