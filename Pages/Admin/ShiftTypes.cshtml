@page
@model ShiftManager.Pages.Admin.ShiftTypesModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Admin"], Url = "/Admin/Users" },
    new BreadcrumbItem { Label = Localizer["ShiftTypes"], IsActive = true }
})

@section Styles {
    <style>
        /* Page Header */
        .page-header {
            margin-bottom: 2rem;
        }

        .page-title {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 0.5rem 0;
            line-height: 1.2;
        }

        .page-subtitle {
            font-size: 1rem;
            color: var(--text-secondary);
            margin: 0;
            line-height: 1.5;
        }

        /* Alerts */
        .alert-error {
            padding: 1rem 1.25rem;
            border-radius: 10px;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 0.9375rem;
            font-weight: 500;
            background: var(--danger);
            color: var(--danger-text);
            border: 1px solid rgba(var(--danger-rgb, 244, 67, 54), 0.3);
        }

        /* Section Card */
        .section-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: var(--shadow-sm);
        }

        /* Data Table */
        .shift-types-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 1.5rem;
        }

        .shift-types-table thead tr {
            border-bottom: 2px solid var(--border);
        }

        .shift-types-table th {
            padding: 0.875rem;
            text-align: left;
            font-size: 0.8125rem;
            font-weight: 600;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.025em;
        }

        .shift-types-table tbody tr {
            border-bottom: 1px solid var(--border);
            transition: background-color 0.15s ease;
        }

        .shift-types-table tbody tr:hover {
            background: var(--surface-soft);
        }

        .shift-types-table tbody tr:last-child {
            border-bottom: none;
        }

        .shift-types-table td {
            padding: 1rem 0.875rem;
            font-size: 0.9375rem;
            color: var(--text-primary);
        }

        .shift-types-table td.shift-key {
            font-weight: 600;
            color: var(--text-primary);
        }

        .shift-types-table td.shift-name {
            color: var(--text-secondary);
        }

        /* Form Input in Table */
        .table-input {
            width: 100%;
            padding: 0.5rem 0.75rem;
            font-size: 0.875rem;
            color: var(--text-primary);
            background: var(--surface-soft);
            border: 1px solid var(--border);
            border-radius: 6px;
            transition: all 0.15s ease;
        }

        .table-input:hover {
            border-color: var(--primary);
            background: var(--surface);
        }

        .table-input:focus {
            outline: none;
            border-color: var(--primary);
            background: var(--surface);
            box-shadow: 0 0 0 3px rgba(var(--primary-rgb, 59, 130, 246), 0.1);
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            padding: 0.625rem 1.25rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.15s ease;
            text-decoration: none;
            white-space: nowrap;
        }

        .btn-primary {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        .btn-primary:hover {
            background: var(--primary-hover);
            border-color: var(--primary-hover);
            transform: translateY(-1px);
            box-shadow: var(--shadow-md);
        }

        .btn-danger {
            background: var(--danger);
            color: white;
            border-color: var(--danger);
            font-size: 0.8125rem;
            padding: 0.5rem 1rem;
        }

        .btn-danger:hover {
            background: var(--danger-hover);
            border-color: var(--danger-hover);
            transform: translateY(-1px);
            box-shadow: var(--shadow-md);
        }

        /* Table Responsive Wrapper */
        .table-wrapper {
            overflow-x: auto;
            margin: 0 -1.5rem;
            padding: 0 1.5rem;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .page-title {
                font-size: 1.75rem;
            }

            .section-card {
                padding: 1.25rem;
            }

            .table-wrapper {
                margin: 0 -1.25rem;
                padding: 0 1.25rem;
            }

            .shift-types-table {
                font-size: 0.875rem;
            }

            .shift-types-table th,
            .shift-types-table td {
                padding: 0.75rem 0.5rem;
            }
        }

        @@media (max-width: 480px) {
            .page-title {
                font-size: 1.5rem;
            }
        }
    </style>
}

<!-- Page Header -->
<div class="page-header">
    <h1 class="page-title">@Localizer["ShiftTypes"]</h1>
    <p class="page-subtitle">@Localizer["ManageShiftTypesAndSchedules"]</p>
</div>

<!-- Error Message -->
@if (!string.IsNullOrEmpty(ViewData["ErrorMessage"]?.ToString()))
{
    <div class="alert-error">
        <span style="font-size: 1.25rem;">✗</span>
        <span>@ViewData["ErrorMessage"]</span>
    </div>
}

<!-- Shift Types Table -->
<div class="section-card">
    <form method="post" id="mainForm">
        <div class="table-wrapper">
            <table class="shift-types-table">
                <thead>
                    <tr>
                        <th>@Localizer["Key"]</th>
                        <th>@Localizer["Name"]</th>
                        <th>@Localizer["Start"]</th>
                        <th>@Localizer["End"]</th>
                        <th>@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                @for (int i = 0; i < Model.Items.Count; i++)
                {
                    <tr>
                        <td class="shift-key">
                            @(Model.Items[i].Key.StartsWith("CUSTOM_") ? "Custom" : Model.Items[i].Key)
                        </td>
                        <td class="shift-name">@Model.Items[i].Name</td>
                        <td>
                            <input class="table-input" name="items[@i].Start" type="time" value="@Model.Items[i].Start" />
                        </td>
                        <td>
                            <input class="table-input" name="items[@i].End" type="time" value="@Model.Items[i].End" />
                        </td>
                        <td>
                            <button type="button" class="btn btn-danger" onclick="deleteShiftType(@Model.Items[i].Id, '@Model.Items[i].Key')">
                                <span>🗑️</span>
                                <span>@Localizer["Delete"]</span>
                            </button>
                        </td>
                        <input type="hidden" name="items[@i].Id" value="@Model.Items[i].Id" />
                        <input type="hidden" name="items[@i].Key" value="@Model.Items[i].Key" />
                        <input type="hidden" name="items[@i].Name" value="@Model.Items[i].Name" />
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <button class="btn btn-primary" type="submit">
            <span>💾</span>
            <span>@Localizer["Save"]</span>
        </button>
    </form>
</div>

<!-- Separate delete form (hidden) -->
<form method="post" asp-page-handler="Delete" id="deleteForm" style="display: none;">
    <input type="hidden" name="id" id="deleteId" />
</form>

<script>
function deleteShiftType(id, key) {
    if (confirm('@Localizer["ConfirmDeleteShiftType"]')) {
        document.getElementById('deleteId').value = id;
        document.getElementById('deleteForm').submit();
    }
}
</script>
