@page
@model ShiftManager.Pages.Admin.ShiftTypesModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Admin"], Url = "/Admin/Users" },
    new BreadcrumbItem { Label = Localizer["ShiftTypes"], IsActive = true }
})

<h2>@Localizer["ShiftTypes"]</h2>

@if (!string.IsNullOrEmpty(ViewData["ErrorMessage"]?.ToString()))
{
    <div class="alert alert-danger" style="margin-bottom: 1rem; padding: 1rem; background: var(--danger); color: white; border-radius: 0.5rem;">
        @ViewData["ErrorMessage"]
    </div>
}

<div class="card">
    <form method="post" id="mainForm">
        <table>
            <thead><tr><th>@Localizer["Key"]</th><th>@Localizer["Name"]</th><th>@Localizer["Start"]</th><th>@Localizer["End"]</th><th>@Localizer["Actions"]</th></tr></thead>
            <tbody>
            @for (int i = 0; i < Model.Items.Count; i++)
            {
                <tr>
                    <td>@(Model.Items[i].Key.StartsWith("CUSTOM_") ? "Custom" : Model.Items[i].Key)</td>
                    <td>@Model.Items[i].Name</td>
                    <td><input class="input" name="items[@i].Start" type="time" value="@Model.Items[i].Start" /></td>
                    <td><input class="input" name="items[@i].End" type="time" value="@Model.Items[i].End" /></td>
                    <td>
                        <button type="button" class="btn btn-danger" onclick="deleteShiftType(@Model.Items[i].Id, '@Model.Items[i].Key')" style="background: var(--danger); color: white; border: none; padding: 0.5rem 1rem; border-radius: 0.5rem; cursor: pointer;">
                            🗑️ @Localizer["Delete"]
                        </button>
                    </td>
                    <input type="hidden" name="items[@i].Id" value="@Model.Items[i].Id" />
                    <input type="hidden" name="items[@i].Key" value="@Model.Items[i].Key" />
                    <input type="hidden" name="items[@i].Name" value="@Model.Items[i].Name" />
                </tr>
            }
            </tbody>
        </table>
        <button class="btn btn-primary" type="submit">@Localizer["Save"]</button>
    </form>
</div>

<!-- Separate delete form (hidden) -->
<form method="post" asp-page-handler="Delete" id="deleteForm" style="display: none;">
    <input type="hidden" name="id" id="deleteId" />
</form>

<script>
function deleteShiftType(id, key) {
    if (confirm('@Localizer["ConfirmDeleteShiftType"]')) {
        document.getElementById('deleteId').value = id;
        document.getElementById('deleteForm').submit();
    }
}
</script>
