@* MODIFIED FOR MODAL FIX *@
@page
@model ShiftManager.Pages.Admin.CompaniesModel
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["Companies"];
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["Admin"], Url = "/Admin/Users" },
    new BreadcrumbItem { Label = Localizer["Organization"], Url = "/Admin/Organization" },
    new BreadcrumbItem { Label = Localizer["Companies"], IsActive = true }
})

@section Styles {
    <style>
        /* Page Header */
        .page-header {
            margin-bottom: 2rem;
        }

        .page-title {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text);
            margin: 0 0 0.5rem 0;
            line-height: 1.2;
        }

        .page-subtitle {
            font-size: 1rem;
            color: var(--text-muted);
            margin: 0;
            line-height: 1.5;
        }

        /* Alerts */
        .alert-success {
            padding: 1rem 1.25rem;
            border-radius: 10px;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 0.9375rem;
            font-weight: 500;
            background: var(--success);
            color: var(--success-text);
            border: 1px solid rgba(var(--success-rgb, 16, 185, 129), 0.3);
        }

        .alert-error {
            padding: 1rem 1.25rem;
            border-radius: 10px;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 0.9375rem;
            font-weight: 500;
            background: var(--danger);
            color: var(--danger-text);
            border: 1px solid rgba(var(--danger-rgb, 244, 67, 54), 0.3);
        }

        /* Section Card */
        .section-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: var(--shadow-sm);
            margin-bottom: 2rem;
        }

        .section-header {
            font-size: 1.125rem;
            font-weight: 600;
            color: var(--text);
            margin: 0 0 1.25rem 0;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid var(--border);
        }

        /* Fieldset */
        .form-fieldset {
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 1.25rem;
            margin-bottom: 1.5rem;
        }

        .fieldset-legend {
            padding: 0 0.5rem;
            font-weight: 600;
            color: var(--text);
            font-size: 0.9375rem;
        }

        .fieldset-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
        }

        /* Form Elements */
        .form-group {
            margin-bottom: 0;
        }

        .form-label {
            display: block;
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--text-muted);
            margin-bottom: 0.5rem;
        }

        .form-label-required {
            color: var(--danger);
        }

        .form-label-hint {
            font-size: 0.75rem;
            font-weight: 400;
            color: var(--text-muted);
        }

        .form-input {
            width: 100%;
            padding: 0.625rem 0.875rem;
            font-size: 0.9375rem;
            color: var(--text);
            background: var(--surface-soft);
            border: 1px solid var(--border);
            border-radius: 8px;
            transition: all 0.15s ease;
        }

        .form-input:hover {
            border-color: var(--primary);
            background: var(--surface);
        }

        .form-input:focus {
            outline: none;
            border-color: var(--primary);
            background: var(--surface);
            box-shadow: 0 0 0 3px rgba(var(--primary-rgb, 59, 130, 246), 0.1);
        }

        .form-hint {
            display: block;
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-top: 0.25rem;
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            padding: 0.625rem 1.25rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.15s ease;
            text-decoration: none;
            white-space: nowrap;
        }

        .btn-primary {
            background: var(--primary);
            color: var(--primary-contrast);
            border-color: var(--primary);
        }

        .btn-primary:hover {
            background: var(--primary-hover);
            border-color: var(--primary-hover);
            transform: translateY(-1px);
            box-shadow: var(--shadow-md);
        }

        .btn-danger {
            background: var(--danger);
            color: var(--danger-text);
            border-color: var(--danger);
            font-size: 0.8125rem;
            padding: 0.5rem 1rem;
        }

        .btn-danger:hover {
            background: var(--danger-hover);
            border-color: var(--danger-hover);
            transform: translateY(-1px);
            box-shadow: var(--shadow-md);
        }

        .btn-ghost {
            background: transparent;
            color: var(--text);
            border-color: transparent;
            font-size: 0.8125rem;
            padding: 0.5rem 1rem;
        }

        .btn-ghost:hover {
            background: var(--surface-soft);
            border-color: var(--border);
        }

        /* Data Table */
        .companies-table {
            width: 100%;
            border-collapse: collapse;
        }

        .companies-table thead tr {
            border-bottom: 2px solid var(--border);
        }

        .companies-table th {
            padding: 0.875rem;
            text-align: start;
            font-size: 0.8125rem;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.025em;
        }

        .companies-table tbody tr {
            border-bottom: 1px solid var(--border);
            transition: background-color 0.15s ease;
        }

        .companies-table tbody tr:hover {
            background: var(--surface-soft);
        }

        .companies-table tbody tr:last-child {
            border-bottom: none;
        }

        .companies-table td {
            padding: 1rem 0.875rem;
            font-size: 0.9375rem;
            color: var(--text);
        }

        .companies-table td code {
            background: var(--surface-soft);
            padding: 0.25rem 0.5rem;
            border-radius: 4px;
            font-size: 0.875rem;
            font-family: 'Courier New', monospace;
        }

        .table-actions {
            display: flex;
            gap: 0.5rem;
            white-space: nowrap;
        }

        /* Info Box */
        .info-box {
            margin-top: 1.5rem;
            padding: 1rem;
            background: var(--surface-soft);
            border-left: 4px solid var(--primary);
            border-radius: 8px;
        }

        .info-box-content {
            font-size: 0.875rem;
            color: var(--text-muted);
            line-height: 1.6;
        }

        .info-box-content strong {
            color: var(--text);
        }

        .info-box-list {
            margin: 0.5rem 0;
            padding-left: 1.5rem;
        }

        .info-box-list li {
            margin: 0.25rem 0;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 3rem 2rem;
            color: var(--text-muted);
        }

        /* Modal */
        #renameModal,
        #moveMoleculeModal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(4px);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            animation: fadeIn 0.2s ease;
        }

        #renameModal.active,
        #moveMoleculeModal.active {
            display: flex;
        }

        .modal-content {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 2rem;
            max-width: 500px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: var(--shadow-xl);
            animation: slideUp 0.3s ease;
        }

        .modal-header {
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 1.5rem;
        }

        .modal-footer {
            display: flex;
            gap: 0.5rem;
            margin-top: 1.5rem;
        }

        /* Animations */
        @@keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Fieldset Dimming */
        .fieldset-dimmed {
            opacity: 0.5;
            transition: opacity 0.2s ease;
        }

        /* Table Responsive Wrapper */
        .table-wrapper {
            overflow-x: auto;
            margin: 0 -1.5rem;
            padding: 0 1.5rem;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .page-title {
                font-size: 1.75rem;
            }

            .section-card {
                padding: 1.25rem;
            }

            .fieldset-grid {
                grid-template-columns: 1fr;
            }

            .table-wrapper {
                margin: 0 -1.25rem;
                padding: 0 1.25rem;
            }

            .companies-table {
                font-size: 0.875rem;
            }

            .companies-table th,
            .companies-table td {
                padding: 0.75rem 0.5rem;
            }

            .table-actions {
                flex-direction: column;
            }
        }

        @@media (max-width: 480px) {
            .page-title {
                font-size: 1.5rem;
            }
        }
    </style>
}

<!-- Page Header -->
<div class="page-header">
    <h1 class="page-title">@Localizer["Companies"]</h1>
    <p class="page-subtitle">@Localizer["ManageCompaniesAndOrganizations"]</p>
</div>

<!-- Success Message -->
@if (!string.IsNullOrEmpty(Model.Success))
{
    <div class="alert-success">
        <span style="font-size: 1.25rem;"><icon name="check" /></span>
        <span>@Model.Success</span>
    </div>
}

<!-- Add New Company Form -->
<div class="section-card">
    <h3 class="section-header">@Localizer["AddNewCompany"]</h3>

    <!-- Error Message -->
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert-error">
            <span style="font-size: 1.25rem;"><icon name="x" /></span>
            <span>@Model.Error</span>
        </div>
    }

    <form method="post" asp-page-handler="AddCompany" accept-charset="UTF-8">
        <!-- Company Details Fieldset -->
        <fieldset class="form-fieldset">
            <legend class="fieldset-legend">@Localizer["CompanyDetails"]</legend>
            <div class="fieldset-grid">
                <div class="form-group">
                    <label class="form-label">
                        <loc key="Molecule" /> <span class="form-label-required">*</span>
                    </label>
                    <select class="form-input" asp-for="SelectedMoleculeId" data-searchable required>
                        <option value="">@Localizer["Auth_ChooseMolecule"]</option>
                        @foreach (var molecule in Model.AvailableMolecules)
                        {
                            <option value="@molecule.Id">@(molecule.DisplayName ?? molecule.Name)</option>
                        }
                    </select>
                    <span class="form-hint"><loc key="CompanyMoleculeHint">Which molecule this company belongs to</loc></span>
                </div>
                <div class="form-group">
                    <label class="form-label">
                        @Localizer["CompanyName"] <span class="form-label-required">*</span>
                    </label>
                    <input class="form-input" asp-for="CompanyName" placeholder="@Localizer["Placeholder_CompanyName"]" required />
                </div>
                <div class="form-group">
                    <label class="form-label">
                        @Localizer["HebrewName"]
                    </label>
                    <input class="form-input" asp-for="CompanyNameHe" dir="rtl" placeholder="@Localizer["Placeholder_CompanyNameHe"]" />
                </div>
                <div class="form-group">
                    <label class="form-label">
                        @Localizer["Slug"] <span class="form-label-required">*</span>
                        <span class="form-label-hint"><loc key="CompanySlugHint">(lowercase, letters, numbers, hyphens)</loc></span>
                    </label>
                    <input class="form-input" asp-for="CompanySlug" loc-placeholder="Placeholder_CompanySlug" pattern="[a-z0-9\-]+" loc-title="Hint_SlugValidation" required />
                </div>
                <div class="form-group">
                    <label class="form-label">@Localizer["DisplayName"]</label>
                    <input class="form-input" asp-for="CompanyDisplayName" placeholder="@Localizer["Placeholder_CompanyDisplayName"]" />
                </div>
            </div>
        </fieldset>

        <!-- Existing Director Fieldset -->
        <fieldset class="form-fieldset">
            <legend class="fieldset-legend">@Localizer["OrAssignExistingDirector"]</legend>
            <div class="form-group">
                <label class="form-label">@Localizer["ExistingDirector"]</label>
                <select class="form-input" asp-for="SelectedDirectorId" id="directorSelect" data-searchable>
                    <option value="">@Localizer["SelectExistingDirector"]</option>
                    @foreach (var director in Model.AvailableDirectors)
                    {
                        <option value="@director.Id">@director.DisplayName (@director.Email)</option>
                    }
                </select>
                <span class="form-hint">@Localizer["IfDirectorSelected"]</span>
            </div>
        </fieldset>

        <!-- Manager Account Fieldset -->
        <fieldset class="form-fieldset" id="managerFieldset">
            <legend class="fieldset-legend">@Localizer["ManagerAccount"]</legend>
            <div class="fieldset-grid">
                <div class="form-group">
                    <label class="form-label">
                        @Localizer["ManagerEmail"] <span class="form-label-required" id="managerEmailRequired">*</span>
                    </label>
                    <input class="form-input" asp-for="ManagerEmail" type="email" loc-placeholder="Placeholder_ManagerEmail" id="managerEmail" />
                </div>
                <div class="form-group">
                    <label class="form-label">
                        @Localizer["ManagerDisplayName"] <span class="form-label-required" id="managerDisplayRequired">*</span>
                    </label>
                    <input class="form-input" asp-for="ManagerDisplayName" placeholder="@Localizer["Placeholder_ManagerName"]" id="managerDisplayName" />
                </div>
                <div class="form-group">
                    <label class="form-label">
                        @Localizer["ManagerPassword"] <span class="form-label-required" id="managerPasswordRequired">*</span>
                    </label>
                    <input class="form-input" asp-for="ManagerPassword" type="password" placeholder="••••••••" id="managerPassword" />
                </div>
            </div>
        </fieldset>

        <button class="btn btn-primary" type="submit">
            <span><icon name="plus" /></span>
            <span>@Localizer["CreateCompanyManager"]</span>
        </button>
    </form>

    <div class="info-box">
        <div class="info-box-content">
            <strong>@Localizer["Note"]:</strong> @Localizer["CreatingCompanyWill"]
            <ul class="info-box-list">
                <li>@Localizer["CreateCompanyWithDetails"]</li>
                <li>@Localizer["CreateManagerAccount"]</li>
                <li>@Localizer["GenerateDefaultShiftTypes"]</li>
                <li>@Localizer["SetupDefaultConfig"]</li>
            </ul>
        </div>
    </div>
</div>

<!-- All Companies List -->
<div class="section-card">
    <h3 class="section-header">@Localizer["AllCompanies"]</h3>

    @if (Model.Companies.Any())
    {
        <div class="table-wrapper">
            <table class="companies-table">
                <thead>
                    <tr>
                        <th>@Localizer["Name"]</th>
                        <th><loc key="Molecule" /></th>
                        <th>@Localizer["Slug"]</th>
                        <th>@Localizer["DisplayName"]</th>
                        <th>@Localizer["Users"]</th>
                        <th style="width:1%">@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var c in Model.Companies)
                {
                    var englishName = c.DisplayName ?? c.Name;
                    var hebrewName = c.NameHe;
                    var isHebrewUI = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("he", StringComparison.OrdinalIgnoreCase);
                    var primaryName = isHebrewUI && !string.IsNullOrWhiteSpace(hebrewName) ? hebrewName : englishName;
                    var primaryDir = isHebrewUI && !string.IsNullOrWhiteSpace(hebrewName) ? "rtl" : "ltr";
                    string? sublineText = isHebrewUI
                        ? (!string.IsNullOrWhiteSpace(hebrewName) ? englishName : null)
                        : (!string.IsNullOrWhiteSpace(hebrewName) && hebrewName != englishName ? hebrewName : null);
                    var sublineDir = isHebrewUI ? "ltr" : "rtl";
                    <tr>
                        <td>
                            <strong dir="@primaryDir">@primaryName</strong>
                            @if (sublineText != null)
                            {
                                <br /><span style="color: var(--text-muted); font-size: 0.85em;" dir="@sublineDir">@sublineText</span>
                            }
                        </td>
                        <td>@(c.MoleculeName ?? "-")</td>
                        <td><code>@c.Slug</code></td>
                        <td>@(c.DisplayName ?? "-")</td>
                        <td>@c.UserCount</td>
                        <td>
                            <div class="table-actions">
                                <button type="button" class="btn btn-ghost"
                                        data-company-id="@c.Id"
                                        data-company-name="@System.Web.HttpUtility.HtmlAttributeEncode(c.DisplayName ?? c.Name)"
                                        data-company-name-he="@System.Web.HttpUtility.HtmlAttributeEncode(c.NameHe ?? string.Empty)"
                                        onclick="renameCompanyClick(this)">
                                    @Localizer["Rename"]
                                </button>
                                <button type="button" class="btn btn-ghost"
                                        data-company-id="@c.Id"
                                        data-company-name="@System.Web.HttpUtility.HtmlAttributeEncode(c.DisplayName ?? c.Name)"
                                        data-current-molecule-id="@(c.MoleculeId?.ToString() ?? "")"
                                        onclick="moveCompanyClick(this)">
                                    <span><icon name="git-branch" /></span>
                                    <span>@Localizer["Companies_MoveMolecule"]</span>
                                </button>
                                <form method="post" asp-page-handler="DeleteCompany" style="display:inline"
                                      data-confirm-modal
                                      data-confirm-title="@Localizer["ConfirmDeleteCompany_Title"]"
                                      data-confirm-message="@Localizer["ConfirmDeleteCompany"]"
                                      data-confirm-action="@Localizer["Delete"]"
                                      data-confirm-level="danger">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <button type="submit" class="btn btn-danger">
                                        <span><icon name="trash" /></span>
                                        <span>@Localizer["Delete"]</span>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="empty-state">@Localizer["NoCompaniesYet"]</p>
    }
</div>

<!-- Rename Company Modal -->
<div id="renameModal">
    <div class="modal-content">
        <h3 class="modal-header">@Localizer["RenameCompany"]</h3>
        <form method="post" asp-page-handler="RenameCompany">
            @Html.AntiForgeryToken()
            <input type="hidden" id="renameCompanyId" name="RenameCompanyId" />
            <div class="form-group">
                <label class="form-label">@Localizer["NewCompanyName"]</label>
                <input type="text" class="form-input" id="newCompanyName" name="NewCompanyName" required />
            </div>
            <div class="form-group" style="margin-top: 1rem;">
                <label class="form-label">@Localizer["HebrewName"]</label>
                <input type="text" class="form-input" id="newCompanyNameHe" name="NewCompanyNameHe" dir="rtl" placeholder="@Localizer["Placeholder_CompanyNameHe"]" />
                <span class="form-hint">@Localizer["CompanyNameHe_ClearHint"]</span>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-primary">
                    <span><icon name="save" /></span>
                    <span>@Localizer["Rename"]</span>
                </button>
                <button type="button" class="btn btn-ghost" onclick="closeRenameModal()">@Localizer["Cancel"]</button>
            </div>
        </form>
    </div>
</div>

<!-- Move Company to Molecule Modal -->
<div id="moveMoleculeModal">
    <div class="modal-content">
        <h3 class="modal-header">@Localizer["Companies_MoveMolecule"]</h3>
        <form method="post" asp-page-handler="MoveCompany"
              data-confirm-modal
              data-confirm-title="@Localizer["Companies_MoveConfirm_Title"]"
              data-confirm-message="@Localizer["Companies_MoveConfirm_Message"]"
              data-confirm-action="@Localizer["Companies_MoveMolecule"]"
              data-confirm-level="danger">
            @Html.AntiForgeryToken()
            <input type="hidden" id="moveCompanyId" name="MoveCompanyId" />
            <p id="moveCompanyLabel" style="font-weight:600; margin-bottom:1rem;"></p>
            <div class="form-group">
                <label class="form-label">@Localizer["Companies_TargetMolecule"]</label>
                <select class="form-input" id="moveTargetMolecule" name="MoveTargetMoleculeId" data-searchable required>
                    <option value="">@Localizer["SelectMolecule"]</option>
                    @foreach (var molecule in Model.AvailableMolecules)
                    {
                        <option value="@molecule.Id">@(molecule.DisplayName ?? molecule.Name)</option>
                    }
                </select>
            </div>
            <div id="moveImpactBox" class="info-box" style="display:none; margin-top:1rem;">
                <p><strong>@Localizer["Companies_MoveImpact_Title"]</strong></p>
                <ul id="moveImpactList" style="margin:0.5rem 0 0; padding-inline-start:1.2rem;"></ul>
                <p class="form-hint" style="margin-top:0.5rem;">@Localizer["Companies_MoveImpact_KeepsVacations"]</p>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-danger" id="moveSubmitBtn" disabled>
                    <span><icon name="git-branch" /></span>
                    <span>@Localizer["Companies_MoveMolecule"]</span>
                </button>
                <button type="button" class="btn btn-ghost" onclick="closeMoveModal()">@Localizer["Cancel"]</button>
            </div>
        </form>
    </div>
</div>

<script>
// Rename company using data attributes to avoid XSS and quote issues
function renameCompanyClick(button) {
    const id = button.getAttribute('data-company-id');
    const currentName = button.getAttribute('data-company-name');
    const currentNameHe = button.getAttribute('data-company-name-he') || '';
    renameCompany(id, currentName, currentNameHe);
}

function renameCompany(id, currentName, currentNameHe) {
    document.getElementById('renameCompanyId').value = id;
    document.getElementById('newCompanyName').value = currentName;
    document.getElementById('newCompanyNameHe').value = currentNameHe || '';
    document.getElementById('renameModal').classList.add('active');
}

function closeRenameModal() {
    document.getElementById('renameModal').classList.remove('active');
}

// Close modal when clicking outside
document.getElementById('renameModal').addEventListener('click', function(e) {
    if (e.target === this) {
        closeRenameModal();
    }
});

// --- Move company to another molecule ---
function moveCompanyClick(button) {
    const id = button.getAttribute('data-company-id');
    const name = button.getAttribute('data-company-name');
    const currentMoleculeId = button.getAttribute('data-current-molecule-id') || '';
    document.getElementById('moveCompanyId').value = id;
    document.getElementById('moveCompanyLabel').textContent = name;
    const sel = document.getElementById('moveTargetMolecule');
    sel.value = '';
    // Hide the company's current molecule from the target options.
    Array.from(sel.options).forEach(function(opt) {
        opt.hidden = opt.value !== '' && opt.value === currentMoleculeId;
    });
    document.getElementById('moveImpactBox').style.display = 'none';
    document.getElementById('moveSubmitBtn').disabled = true;
    document.getElementById('moveMoleculeModal').classList.add('active');
}

function closeMoveModal() {
    document.getElementById('moveMoleculeModal').classList.remove('active');
}

document.getElementById('moveMoleculeModal').addEventListener('click', function(e) {
    if (e.target === this) closeMoveModal();
});

document.getElementById('moveTargetMolecule').addEventListener('change', async function() {
    const companyId = document.getElementById('moveCompanyId').value;
    const targetId = this.value;
    const box = document.getElementById('moveImpactBox');
    const submitBtn = document.getElementById('moveSubmitBtn');
    if (!targetId) { box.style.display = 'none'; submitBtn.disabled = true; return; }
    try {
        const resp = await fetch(`/Admin/Companies?handler=MoveImpact&id=${encodeURIComponent(companyId)}&targetMoleculeId=${encodeURIComponent(targetId)}`, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }, credentials: 'same-origin'
        });
        const data = await resp.json();
        const list = document.getElementById('moveImpactList');
        list.innerHTML = '';
        const rows = [
            ['@Localizer["Companies_MoveImpact_Shifts"]', (data.shiftInstances || 0) + ' / ' + (data.shiftAssignments || 0)],
            ['@Localizer["Companies_MoveImpact_Programs"]', data.shiftPrograms || 0],
            ['@Localizer["Companies_MoveImpact_Chores"]', data.chores || 0],
            ['@Localizer["Companies_MoveImpact_Users"]', data.affectedUsers || 0]
        ];
        rows.forEach(function(r) {
            const li = document.createElement('li');
            li.textContent = r[0] + ': ' + r[1];
            list.appendChild(li);
        });
        box.style.display = 'block';
    } catch (e) {
        box.style.display = 'none';
    }
    submitBtn.disabled = false; // a chosen target is enough to proceed (server re-validates)
});

// Toggle manager fields based on director selection
document.addEventListener('DOMContentLoaded', function() {
    const directorSelect = document.getElementById('directorSelect');
    const managerEmail = document.getElementById('managerEmail');
    const managerDisplayName = document.getElementById('managerDisplayName');
    const managerPassword = document.getElementById('managerPassword');
    const managerFieldset = document.getElementById('managerFieldset');

    function toggleManagerFields() {
        const directorSelected = directorSelect.value && directorSelect.value !== '';

        if (directorSelected) {
            // Director selected - make manager fields optional and dim them
            managerEmail.removeAttribute('required');
            managerDisplayName.removeAttribute('required');
            managerPassword.removeAttribute('required');
            managerFieldset.classList.add('fieldset-dimmed');
            document.getElementById('managerEmailRequired').style.display = 'none';
            document.getElementById('managerDisplayRequired').style.display = 'none';
            document.getElementById('managerPasswordRequired').style.display = 'none';
        } else {
            // No director - make manager fields required and normal
            managerEmail.setAttribute('required', 'required');
            managerDisplayName.setAttribute('required', 'required');
            managerPassword.setAttribute('required', 'required');
            managerFieldset.classList.remove('fieldset-dimmed');
            document.getElementById('managerEmailRequired').style.display = 'inline';
            document.getElementById('managerDisplayRequired').style.display = 'inline';
            document.getElementById('managerPasswordRequired').style.display = 'inline';
        }
    }

    directorSelect.addEventListener('change', toggleManagerFields);
    toggleManagerFields(); // Initial state
});
</script>
