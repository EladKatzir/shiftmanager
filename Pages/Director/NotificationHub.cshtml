@page
@using Microsoft.Extensions.Localization
@using ShiftManager.Resources
@using ShiftManager.ViewComponents
@inject IStringLocalizer<SharedResources> Localizer
@model ShiftManager.Pages.Director.NotificationHubModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["NotificationHub"];
}

@await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
{
    new BreadcrumbItem { Label = Localizer["DirectorHub_Title"], Url = "/Director" },
    new BreadcrumbItem { Label = Localizer["NotificationHub"], IsActive = true }
})

<h2><loc key="NotificationHub" /></h2>
<p style="color: var(--muted); margin-bottom: 2rem;">
    @Localizer["NotificationHubDescription"]
</p>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 2rem;">
    <div class="card">
        <h3 style="margin-top:0"><loc key="PendingTimeOffRequests" /></h3>
        @if (Model.PendingTimeOffRequests.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th><loc key="Company" /></th>
                        <th><loc key="User" /></th>
                        <th><loc key="Details" /></th>
                        <th><loc key="Requested" /></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model.PendingTimeOffRequests)
                    {
                        <tr>
                            <td>
                                <span title="@request.CompanyName">
                                    <code>@request.CompanySlug</code>
                                </span>
                            </td>
                            <td>@request.UserName</td>
                            <td>@request.Details</td>
                            <td>@request.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p style="color: var(--muted); text-align: center; padding: 1rem;"><loc key="NoPendingTimeOffRequests" /></p>
        }
    </div>

    <div class="card">
        <h3 style="margin-top:0"><loc key="PendingSwapRequests" /></h3>
        @if (Model.PendingSwapRequests.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th><loc key="Company" /></th>
                        <th><loc key="User" /></th>
                        <th><loc key="Details" /></th>
                        <th><loc key="Requested" /></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model.PendingSwapRequests)
                    {
                        <tr>
                            <td>
                                <span title="@request.CompanyName">
                                    <code>@request.CompanySlug</code>
                                </span>
                            </td>
                            <td>@request.UserName</td>
                            <td>@request.Details</td>
                            <td>@request.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p style="color: var(--muted); text-align: center; padding: 1rem;"><loc key="NoPendingSwapRequests" /></p>
        }
    </div>
</div>

<div class="card">
    <h3 style="margin-top:0"><loc key="RecentNotificationsLast50" /></h3>
    @if (Model.RecentNotifications.Any())
    {
        <table>
            <thead>
                <tr>
                    <th><loc key="Company" /></th>
                    <th><loc key="Type" /></th>
                    <th><loc key="Message" /></th>
                    <th><loc key="Date" /></th>
                    <th><loc key="Status" /></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var notification in Model.RecentNotifications)
                {
                    <tr style="@(notification.IsRead ? "opacity: 0.6;" : "font-weight: 600;")">
                        <td>
                            <span title="@notification.CompanyName">
                                <code>@notification.CompanySlug</code>
                            </span>
                        </td>
                        <td>@notification.Type</td>
                        <td>@notification.Message</td>
                        <td>@notification.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@(notification.IsRead ? Localizer["Read"] : Localizer["Unread"])</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p style="color: var(--muted); text-align: center; padding: 2rem;"><loc key="NoNotificationsYet" /></p>
    }
</div>

<div style="margin-top: 1rem; padding: 1rem; background: var(--surface); border-inline-start: 4px solid var(--primary); border-radius: 0.5rem;">
    <small style="color: var(--muted);">
        <strong><loc key="Note" /></strong> @Localizer["NotificationHubInfo"]
    </small>
</div>
